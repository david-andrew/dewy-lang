  "source": "from p\"benchmark_harness.jo\" import clock\nfrom p\"reaction_model.dewy\" import fresh, paint, advance\nmain=()=>{\n    let data=[loop i in [0..49152) (i%127) as float32]\n    let m=reshape(data 192 256)\n    let out=m[[4..188) [3..250)]\n    let start=clock()\n    loop i in [0..1000) {out=m[[4..188) [i%8..i%8+240)]}\n    let slices=clock()-start\n    let checksum=0\n    loop i in 0.. and x in out.data {checksum+=(x as int64)*(i%31+1)}\n    let field=fresh(96 64)\n    paint(@field 48 32 7) paint(@field 24 20 3) paint(@field 71 43 4)\n    start=clock()\n    loop i in [0..256) advance(@field 0.035 0.062)\n    let simulation=clock()-start\n    let self=fill(42 65536) self.reserve(70000)\n    start=clock()\n    loop i in [0..1024) self.extend(self[0..1))\n    let self_time=clock()-start\n    assert(self.length =? 66560 and sum(self) =? 2795520)\n    printl\"{checksum} {slices} {simulation} {sum(field.b)} {self_time}\"\n}\n",
  "harness": "# Platform boundary for the Dewy application benchmarks. The original\n# harness uses compiler-specific raw syscalls; this uses the core's library.\nsize_argument = (values: str[], fallback: int) -> int:\n    if values.len() < 2: return fallback\n    text = values[1]\n    value = 0\n    loop byte in text:\n        if byte < 48 or byte > 57: return fallback\n        value = value * 10 + int(byte) - 48\n        if value > 1000000000: return fallback\n    value\n\nclock = () -> int:\n    ts: (int, int)\n    if syscall(228, 3, &ts) != 0: panic(\"thread CPU clock unavailable\")\n    ts.0 * 1000000000 + ts.1\nmix = (hash: int, value: int) -> int: __floor_mod(hash * 31 + value, 1000000007)\n",
  "model_sha256": "f10ac5be7cc8ee7df8afaf35e4e39d0b2fade569258e145a8ced784feac98d17",
  "limits": [
    "Native Linux x86-64, one CPU, default/release; no renderer, GPU or browser timing.",

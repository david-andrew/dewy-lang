  "source": "from p\"benchmark_harness.jo\" import clock, mix\nItem:type=[score:int64 id:int64 name:string]\nscore_key=(item:Item):>int64=>item.score\nname_key=(item:Item):>string=>item.name\nmain=():>void=>{\n    loop mode in [0..5) {\n        let source=[loop i in [0..20000) {\n            let score=if mode =? 1 i//4 else if mode =? 2 (20000-i)//4 else if mode =? 3 42 else (i*7919)%1009\n            Item[score i \"group{i%128}\"]\n        }]\n        let elapsed:int64=0\n        let hash:int64=0\n        loop repeat in [0..10) {\n            let start=clock()\n            let ordered=if mode =? 4 source.sorted_by(name_key) else source.sorted_by(score_key)\n            elapsed+=clock()-start\n            loop item in ordered {hash=mix(hash item.id)}\n        }\n        printl\"{mode} {hash} {elapsed}\"\n    }\n}\n",

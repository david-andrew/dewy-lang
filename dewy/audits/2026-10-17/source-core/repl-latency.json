  "script": "import hashlib,json,os,select,statistics,subprocess,time\nfrom pathlib import Path\nroot=Path.cwd()\nstate=json.loads((root/'__dewycache__/compact-core/current.json').read_text())\ncompiler=root/'__dewycache__/compact-core'/state['binary']\nreport={'compiler':str(compiler),'sha256':hashlib.sha256(compiler.read_bytes()).hexdigest(),\n        'source_identity':state['source_identity'],'load_start':os.getloadavg(),\n        'description':'Five fresh nonterminal sessions; startup through first displayed value, then 100 sequential mutable-block inputs per session. Each response checked before sending the next.',\n        'script':Path(__file__).read_text(),'runs':[]}\nfor _ in range(5):\n    start=time.perf_counter()\n    p=subprocess.Popen([compiler,'repl'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,\n                       text=True,bufsize=1,env={**os.environ,'TMPDIR':str(root/'__dewycache__/task-tmp')})\n    def line(text,expected):\n        p.stdin.write(text+'\\n');p.stdin.flush()\n        ready,_,_=select.select([p.stdout],[],[],10)\n        if not ready: raise RuntimeError('prompt timed out')\n        actual=p.stdout.readline()\n        if actual!=expected+'\\n': raise RuntimeError((expected,actual))\n    try:\n        line('let counter=0\\ncounter','0')\n        startup=time.perf_counter()-start\n        samples=[]\n        for i in range(1,101):\n            before=time.perf_counter()\n            line('{counter+=1 counter}',str(i))\n            samples.append(time.perf_counter()-before)\n        p.stdin.write(':quit\\n');p.stdin.flush()\n        p.wait(timeout=10)\n        error=p.stderr.read()\n        assert p.returncode==0 and not error,(p.returncode,error)\n        report['runs'].append({'startup_seconds':startup,'input_seconds':samples})\n    finally:\n        if p.poll() is None: p.kill();p.wait()\n        p.stdin.close();p.stdout.close();p.stderr.close()\nreport['median_startup_seconds']=statistics.median(r['startup_seconds'] for r in report['runs'])\nreport['median_input_seconds']=statistics.median(v for r in report['runs'] for v in r['input_seconds'])\nreport['load_end']=os.getloadavg()\n(root/'dewy/audits/2026-10-17/source-core/repl-latency.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint('median startup ms',report['median_startup_seconds']*1000,'median input ms',report['median_input_seconds']*1000)\n",

  "source": "from p\"benchmark_harness.jo\" import clock, mix\nItem:type=[score:int64 id:int64 name:string]\nscore_less=(a:Item b:Item):>bool=>a.score <? b.score\nname_less=(a:Item b:Item):>bool=>a.name <? b.name\nmain=():>void=>{\n    loop mode in [0..5) {\n        let source=[loop i in [0..20000) {\n            let score=if mode =? 1 i//4 else if mode =? 2 (20000-i)//4 else if mode =? 3 42 else (i*7919)%1009\n            Item[score i \"group{i%128}\"]\n        }]\n        let elapsed:int64=0\n        let hash:int64=0\n        loop repeat in [0..10) {\n            let start=clock()\n            let ordered=source\n            if mode =? 4 ordered.sort_with(name_less) else ordered.sort_with(score_less)\n            elapsed+=clock()-start\n            loop item in ordered {hash=mix(hash item.id)}\n        }\n        printl\"{mode} {hash} {elapsed}\"\n    }\n}\n",

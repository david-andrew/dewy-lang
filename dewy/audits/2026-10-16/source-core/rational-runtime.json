    "harness.jo": "# Platform boundary for the Dewy application benchmarks. The original\n# harness uses compiler-specific raw syscalls; this uses the core's library.\nsize_argument = (values: str[], fallback: int) -> int:\n    if values.len() < 2: return fallback\n    text = values[1]\n    value = 0\n    loop byte in text:\n        if byte < 48 or byte > 57: return fallback\n        value = value * 10 + int(byte) - 48\n        if value > 1000000000: return fallback\n    value\n\nclock = () -> int: time_ns()\nmix = (hash: int, value: int) -> int: __floor_mod(hash * 31 + value, 1000000007)\n",
    "harmonic100.dewy": "from rational import rational\nfrom bigint import bigint\nfrom p\"harness.jo\" import size_argument\nmain=():>void=>{\n    let count=size_argument(args() 2000)\n    let numerator=bigint(\"6703903964971298549787012499102923063739682910296196688861780721860882015036831384445555807181163499337520273047169660419209761687993013765220781067874361\")\n    let divisor=bigint(\"14474011154664524427946373126085988481658748083205070504932198000989141259313\")\n    let decimal=bigint(\"\")\n    let checksum:int64=0\n    let start=time_ns()\n    loop i in [0..count) {\n        let sum=rational(0)\n        loop n in [1..101) {sum+=rational(1 n)}\n        let word=((sum.numerator+sum.denominator)%1000000007).to_int64()\n        if word is? none panic(\"checksum conversion\")\n        checksum=(checksum+word)%1000000007\n    }\n    let elapsed=time_ns()-start\n    printl\"{checksum} {elapsed}\"\n}\n"

from p"/var/home/david/dev/dewy-lang/examples/sloppy_core/physics_scene.dewy" import fresh, advance
main=()=>{
    let scene=fresh()
    let started=time_ns()
    loop i in [0..1200) {advance(@scene 1.0/120.0)}
    let elapsed_ns=time_ns()-started
    let total:float64=0.0
    loop body in scene.world.bodies() {
        let p=scene.world.pos(body)
        total+=(p.x as float64)+(p.y as float64)
    }
    printl(elapsed_ns)
    printl(total)
}

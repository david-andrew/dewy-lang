# A loop condition may need statements (a call on a grapheme view): the
# lowering runs them before every test (`loop true { …; if not cond { break } … }`),
# and `continue` re-tests. A call result may be the iterable of a `loop`.
let is_space = (g:string):>bool => g =? " "
let main = ():>int64 => {
    let text:string = "   abc"
    let i:int64 = 0
    loop i <? text.length and is_space(text[i]) { i += 1 }
    let j:int64 = 0
    loop j <? text.length and is_space(text[j]) {
        j += 1
        if j =? 2 { continue }
    }
    let n:int64 = 0
    loop g in "xyz".split"" { n += g.length }
    loop line in "a\nbb\n".lines { n += line.length * 10 }
    return i * 10 + j + n - 24      # 33 + 33 - 24 = 42
}

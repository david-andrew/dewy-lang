# A warning renders on stderr and then leaves printing where it was: the
# `printl` after `warn` goes to stdout (it used to stay on stderr).
let main = ():>int64 => {
    let src = SrcFile("input" "let a = 1\rlet b = 2\n")
    Warning[srcfile=src title="Lone carriage return" pointers=[Pointer[span=Span[9 10] message="\\r without \\n"]]].warn
    printl"after the warning"
    return 42
}

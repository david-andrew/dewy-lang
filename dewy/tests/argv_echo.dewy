# `main` may take the command line as `array<string>`; each argument is a
# segmented string built in the arena, including the program path at index 0.
let main = (args:array<string>):>int64 => {
    printl"{args.length}"
    let i:int64 = 1
    loop i <? args.length {
        printl"{i}: {args[i]} ({args[i].length})"
        i += 1
    }
    return 0
}

# `a / b` on integers is an exact rational; decimal literals are exact too.
# Runtime rational arithmetic on int64 parts can overflow, so its result is
# `rational | Overflow` and the caller handles the branch; dividing by a
# rational needs it proven nonzero (`if q not=? 0`), like integer division.
let third = 1/3
let main = ():>int64 => {
    let half:rational = 2/4
    let sum_result = third + half
    if sum_result is? Overflow { return 1 }
    let sum = sum_result               # 5/6
    let scaled_result = sum * 12
    if scaled_result is? Overflow { return 2 }
    let scaled = scaled_result         # 10
    let diff_result = half - 9.8
    if diff_result is? Overflow { return 3 }
    let diff = diff_result             # -93/10
    if half =? 0 { return 4 }
    let quotient_result = third / half
    if quotient_result is? Overflow { return 5 }
    let quotient = quotient_result     # 2/3
    let neg = -quotient                # -2/3
    printl"{sum} {scaled} {diff} {quotient} {neg}"
    let checks:int64 = 0
    if third <? half { checks += 1 }
    if half =? 1/2 { checks += 2 }
    if sum not =? 1 { checks += 4 }
    if scaled =? 10 { checks += 8 }
    if 1/3 >=? third { checks += 16 }
    # -93/10 → numerator -93 denominator 10
    return checks + diff.denominator + scaled.numerator
}

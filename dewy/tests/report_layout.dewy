# `library/reporting.dewy` rendering a report the way `dewy/reporting.py`
# does: two pointers on one line (drawn above, since the next line is pointed
# at too), a pointer on the next line, a message line, notes, and help. The
# test compares the output with the compiler's renderer.
let main = ():>int64 => {
    let report = Report("error" "sample")
    report.describe("two pointers on one line")
    report.point(12 17 "first operand")
    report.point(20 25 "second operand")
    report.point(36 41 "next line")
    report.note("a note")
    report.note("another")
    report.help("hint")
    report.render(SrcFile("input" 1 "let total = price * count + tax\nlet other = 1"))
    return 42
}

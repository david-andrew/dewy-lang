# Units are values; juxtaposition multiplies; dimensions live in the type
# and unit scales fold at compile time.
const mass = 10kg                          # constants fold: `const` keeps them compile-time
const velocity = 30m/s
let energy = 1/2 * mass * velocity^2       # 4500 J, folded during checking
let force = 1000kg * 9.8(m/s^2)            # 9800 N

let main = ():>int64 => {
    let joules:rational = energy / J
    let newtons:rational = force / N
    printl"{joules} {newtons}"
    let distance = 120m
    let elapsed = 10s
    let speed = distance / elapsed           # 12 m/s, a runtime rational (big-integer parts)
    let checks:int64 = 0
    if speed =? 12m/s { checks += 1 }
    if 2km + 300m =? 2300m { checks += 2 }
    if 1km >? 999m { checks += 4 }
    if speed * 5s =? 60m { checks += 8 }
    if 1/2 * hour =? 30minute { checks += 16 }
    if joules =? 4500 and newtons =? 9800 { checks += 32 }
    return checks - 19                       # 63 - 19 = 44
}

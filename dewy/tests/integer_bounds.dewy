let main = ():>int64 => {
    let byte_min:uint8 = uint8.min
    let byte_max:uint8 = uint8.max
    let signed_min:int64 = int64.min
    let unsigned_max:uint64 = uint64.max

    if byte_min not =? 0 { return 1 }
    if byte_max not =? 255 { return 2 }
    if signed_min not =? -9223372036854775808 { return 3 }
    if unsigned_max not =? 18446744073709551615 { return 4 }
    return 42
}

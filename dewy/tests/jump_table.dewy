let add_one = (value:int64):>int64 => value + 1
let double = (value:int64):>int64 => value * 2
let add_ten = (value:int64):>int64 => value + 10

const handlers = [@add_one @double @add_ten]
const program:array<uint8> = 0q"000000010002"

let main = ():>int64 => {
    let accumulator:int64 = 15
    let pc:int64 = 0
    loop pc <? program.length {
        let opcode:int64 = program[pc] transmute int64
        # TODO: support this kind of index range analysis + indexing syntax
        # if opcode <? 0 or opcode >=? handlers.length return 1
        # accumulator = handlers[opcode](accumulator)
        if opcode >=? 0 and opcode <? 3 {
            let handler = handlers[opcode]
            accumulator = handler(accumulator)
        } else {
            return 1
        }
        pc += 1
    }
    return accumulator
}

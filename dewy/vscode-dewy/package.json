{
  "name": "dewy",
  "displayName": "dewy",
  "description": "Dewy syntax highlighting, debugging, and optional compact-core diagnostics, hover and definitions",
  "version": "0.2.0",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:lldb",
    "onDebugResolve:cppdbg",
    "onLanguage:dewy"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/dewy_logo_128x128.png",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/dewy.tmLanguage.json",
    "images/dewy_logo_128x128.png",
    "images/dewy-file.png",
    "README.md",
    "LICENSE",
    "core-client.js",
    "THIRD_PARTY_NOTICES.md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dewy",
        "aliases": [
          "Dewy",
          "dewy"
        ],
        "extensions": [
          ".dewy"
        ],
        "icon": {
          "light": "./images/dewy-file.png",
          "dark": "./images/dewy-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dewy",
        "scopeName": "source.dewy",
        "path": "./syntaxes/dewy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator",
          "punctuation.separator.angle"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "dewy"
      }
    ],
    "debuggers": [
      {
        "type": "dewy",
        "label": "Dewy",
        "configurationSnippets": [
          {
            "label": "Dewy: debug current file",
            "description": "Build the active .dewy file with `dewy debug --build` and run it under CodeLLDB with Dewy values",
            "body": {
              "name": "Dewy: debug current file",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": [
                "command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"
              ],
              "sourceLanguages": [
                "c"
              ]
            }
          },
          {
            "label": "Dewy: debug current file with arguments",
            "description": "The same, asking for the command line each run",
            "body": {
              "name": "Dewy: debug current file with arguments",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": "^\"\\${command:dewy.programArguments}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": [
                "command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"
              ],
              "sourceLanguages": [
                "c"
              ]
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dewy.programArguments",
        "title": "Dewy: Program Arguments"
      },
      {
        "command": "dewy.core.restartServer",
        "title": "Dewy: Restart Core Language Server"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dewy.programArguments",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Dewy",
      "properties": {
        "dewy.core.path": {
          "type": "string",
          "default": "",
          "description": "Path to the experimental dewy-core executable. Empty disables compiler-backed editor features. The toolchain must include bin/dewy-parse and lib/.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/dewy-lang"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting is available; the optional core language server starts after workspace trust is granted.",
      "restrictedConfigurations": [
        "dewy.core.path"
      ]
    }
  }
}

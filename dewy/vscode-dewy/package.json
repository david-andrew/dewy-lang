{
  "name": "dewy",
  "displayName": "dewy",
  "description": "Syntax highlighting for the Dewy programming language",
  "version": "0.1.7",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/dewy_logo_128x128.png",
  "files": [
    "language-configuration.json",
    "syntaxes/dewy.tmLanguage.json",
    "images/dewy_logo_128x128.png",
    "images/dewy-file.png",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dewy",
        "aliases": [
          "Dewy",
          "dewy"
        ],
        "extensions": [
          ".dewy"
        ],
        "icon": {
          "light": "./images/dewy-file.png",
          "dark": "./images/dewy-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dewy",
        "scopeName": "source.dewy",
        "path": "./syntaxes/dewy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator",
          "punctuation.separator.angle"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "dewy"
      }
    ],
    "debuggers": [
      {
        "type": "dewy",
        "label": "Dewy",
        "configurationSnippets": [
          {
            "label": "Dewy: debug current file (lldb)",
            "description": "Build the active .dewy file with `dewy debug --build` and run it under CodeLLDB with Dewy values",
            "body": {
              "name": "Dewy: debug current file (lldb)",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": ["command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"],
              "sourceLanguages": ["c"]
            }
          },
          {
            "label": "Dewy: debug current file (gdb)",
            "description": "Build the active .dewy file with `dewy debug --build` and run it under gdb (C/C++ extension) with Dewy values",
            "body": {
              "name": "Dewy: debug current file (gdb)",
              "type": "cppdbg",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "MIMode": "gdb",
              "setupCommands": [
                { "text": "source ${1:~/.dewy/runtime/tools}/dewy_gdb.py", "description": "Dewy value printers", "ignoreFailures": false },
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
              ]
            }
          }
        ]
      }
    ]
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/dewy-lang"
  }
}

{
  "name": "dewy",
  "displayName": "dewy",
  "description": "Dewy syntax highlighting, debugging, and optional compact-core diagnostics, completion, hover and definitions",
  "version": "0.2.0",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:lldb",
    "onDebugResolve:cppdbg",
    "onLanguage:dewy",
    "onDebugResolve:dewy-core",
    "onDebugInitialConfigurations"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/dewy_logo_128x128.png",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/dewy.tmLanguage.json",
    "images/dewy_logo_128x128.png",
    "images/dewy-file.png",
    "README.md",
    "LICENSE",
    "core-client.js",
    "THIRD_PARTY_NOTICES.md",
    "core-debug.js",
    "core-test.js"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dewy",
        "aliases": [
          "Dewy",
          "dewy"
        ],
        "extensions": [
          ".dewy"
        ],
        "icon": {
          "light": "./images/dewy-file.png",
          "dark": "./images/dewy-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dewy",
        "scopeName": "source.dewy",
        "path": "./syntaxes/dewy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator",
          "punctuation.separator.angle"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "dewy"
      }
    ],
    "debuggers": [
      {
        "type": "dewy",
        "label": "Dewy",
        "configurationSnippets": [
          {
            "label": "Dewy: debug current file",
            "description": "Build the active .dewy file with `dewy debug --build` and run it under CodeLLDB with Dewy values",
            "body": {
              "name": "Dewy: debug current file",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": [
                "command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"
              ],
              "sourceLanguages": [
                "c"
              ]
            }
          },
          {
            "label": "Dewy: debug current file with arguments",
            "description": "The same, asking for the command line each run",
            "body": {
              "name": "Dewy: debug current file with arguments",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": "^\"\\${command:dewy.programArguments}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": [
                "command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"
              ],
              "sourceLanguages": [
                "c"
              ]
            }
          }
        ]
      },
      {
        "type": "dewy-core",
        "label": "Dewy compact core",
        "languages": [
          "dewy"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Dewy source file to compile with variable information.",
                "default": "${file}"
              },
              "args": {
                "type": [
                  "array",
                  "string"
                ],
                "description": "Program arguments as an array or a shell-style string.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Program working directory; defaults to the source directory."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "stopOnPanic": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "dewy-core",
            "request": "launch",
            "name": "Dewy core: current file",
            "program": "${file}",
            "args": []
          }
        ],
        "configurationSnippets": [
          {
            "label": "Dewy core: debug current file",
            "description": "Build with the configured compact core and launch CodeLLDB.",
            "body": {
              "type": "dewy-core",
              "request": "launch",
              "name": "Dewy core: current file",
              "program": "^\"\\${file}\"",
              "args": []
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dewy.programArguments",
        "title": "Dewy: Program Arguments"
      },
      {
        "command": "dewy.core.restartServer",
        "title": "Dewy: Restart Core Language Server"
      },
      {
        "command": "dewy.core.debug",
        "title": "Dewy: Debug Current File (Core)"
      },
      {
        "command": "dewy.core.test",
        "title": "Dewy: Test Current File (Core)"
      },
      {
        "command": "dewy.core.testRelease",
        "title": "Dewy: Test Current File in Release Mode (Core)"
      },
      {
        "command": "dewy.core.testWatch",
        "title": "Dewy: Watch Tests in Current File (Core)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dewy.programArguments",
          "when": "false"
        },
        {
          "command": "dewy.core.debug",
          "when": "editorLangId == dewy"
        },
        {
          "command": "dewy.core.test",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        },
        {
          "command": "dewy.core.testRelease",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        },
        {
          "command": "dewy.core.testWatch",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported"
        }
      ],
      "editor/context": [
        {
          "command": "dewy.core.test",
          "when": "editorLangId == dewy && resourceScheme == file && processExecutionSupported",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "Dewy",
      "properties": {
        "dewy.core.path": {
          "type": "string",
          "default": "",
          "description": "Path to a standalone dewy-core executable or a checkout's tools/dewy launcher. Empty disables compiler-backed editor features. The standalone toolchain needs its sibling lib/ directory.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/dewy-lang"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting is available; the optional core language server starts after workspace trust is granted.",
      "restrictedConfigurations": [
        "dewy.core.path"
      ]
    }
  }
}

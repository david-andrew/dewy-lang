{
  "name": "dewy",
  "displayName": "dewy",
  "description": "Syntax highlighting and debugging for the Dewy programming language",
  "version": "0.1.8",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onDebugResolve:lldb",
    "onDebugResolve:cppdbg"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/dewy_logo_128x128.png",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/dewy.tmLanguage.json",
    "images/dewy_logo_128x128.png",
    "images/dewy-file.png",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dewy",
        "aliases": [
          "Dewy",
          "dewy"
        ],
        "extensions": [
          ".dewy"
        ],
        "icon": {
          "light": "./images/dewy-file.png",
          "dark": "./images/dewy-file.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dewy",
        "scopeName": "source.dewy",
        "path": "./syntaxes/dewy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator",
          "punctuation.separator.angle"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "dewy"
      }
    ],
    "debuggers": [
      {
        "type": "dewy",
        "label": "Dewy",
        "configurationSnippets": [
          {
            "label": "Dewy: debug current file",
            "description": "Build the active .dewy file with `dewy debug --build` and run it under CodeLLDB with Dewy values",
            "body": {
              "name": "Dewy: debug current file",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": [
                "command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"
              ],
              "sourceLanguages": [
                "c"
              ]
            }
          },
          {
            "label": "Dewy: debug current file with arguments",
            "description": "The same, asking for the command line each run",
            "body": {
              "name": "Dewy: debug current file with arguments",
              "type": "lldb",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/__dewycache__/\\${relativeFileDirname}/\\${fileBasenameNoExtension}.debug\"",
              "args": "^\"\\${command:dewy.programArguments}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "preLaunchTask": "dewy: build debug",
              "initCommands": [
                "command script import ${1:~/.dewy/runtime/tools}/dewy_lldb.py"
              ],
              "sourceLanguages": [
                "c"
              ]
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dewy.programArguments",
        "title": "Dewy: Program Arguments"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dewy.programArguments",
          "when": "false"
        }
      ]
    }
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/dewy-lang"
  }
}

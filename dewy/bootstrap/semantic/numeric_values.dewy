from reporting import Span
import p"context.dewy" as contexts
import p"bindings.dewy" as bindings
import p"ty.dewy" as types
import p"hir.dewy" as hir

# Shared by source operator dispatch and late abstract-integer storage selection.
const bigint_binary:dict<string string>=[
    '__add__'->'_bigint_add' '__sub__'->'_bigint_sub' '__mul__'->'_bigint_mul'
    '__floordiv__'->'_bigint_floordiv' '__mod__'->'_bigint_mod'
    '__eq__'->'_bigint_eq' '__ne__'->'_bigint_ne' '__lt__'->'_bigint_lt'
    '__le__'->'_bigint_le' '__gt__'->'_bigint_gt' '__ge__'->'_bigint_ge'
]

# Runtime numeric types are prelude declarations, not duplicate compiler-owned
# records. Keep the binding identity supplied by the current lexical scope.
# The source spellings bigint/fixed/rational resolve to these same declarations.
family = (name:string context:contexts.Context session:contexts.Session):>addr? => {
    let id=bindings.lookup(session.scopes context.scope name)
    if id is? none return none
    let value=bindings.binding_at(session.registry id).type_value
    return if value is? addr value else none
}
object_member = (type:addr nodes:types.Table):>addr => {
    let node=types.node_at(nodes type)
    if node isnt? types.TypeOr return type
    let found:addr?=none
    loop id in node.items {
        if types.node_at(nodes id) isnt? types.ObjectType continue
        if found isnt? none return type
        found=id
    }
    return if found is? none type else found
}
is_family = (type:addr name:string context:contexts.Context session:contexts.Session):>bool => {
    let declared=family(name context session)
    if declared is? none return false
    let plain=types.strip_refinement(type session.types)
    if types.same_type(plain declared session.types) or types.same_type(plain object_member(declared session.types) session.types) return true
    # A prelude helper's result names the family's record structurally.
    let unfolded=types.unfold(plain session.types)
    return types.same_type(unfolded types.unfold(declared session.types) session.types) or types.same_type(unfolded types.unfold(object_member(declared session.types) session.types) session.types)
}
nonzero_form = (type:addr name:string context:contexts.Context session:contexts.Session):>bool => {
    let declared=family(name context session)
    if declared is? none return false
    let member=object_member(declared session.types)
    return member not=? declared and types.same_type(types.strip_refinement(type session.types) member session.types)
}

# Compile-time arithmetic uses exact integers; runtime BigInt uses little-endian
# base-2^32 limbs. Zero is the literal union alternative and has no sign/limbs.
# The mathematical payload is retained for subsequent proof and constant passes;
# merely constructing a similarly shaped user record never grants that fact.
bigint_literal = (value:bigint declared:addr loc:Span @session:contexts.Session):>addr => {
    if value =? 0 return hir.append_node(@session.hir hir.Integer[loc types.integer_literal(0 @session.types) '0d' 0])
    let magnitude=if value <? 0 (-value) else value
    let limbs:array<addr>=[]
    let word=types.primitive('uint64' @session.types)
    loop magnitude >? 0 {
        let limb=magnitude % 4294967296
        limbs.push(hir.append_node(@session.hir hir.Integer[loc word '0d' limb]))
        magnitude //= 4294967296
    }
    let sign:bigint=if value <? 0 (-1) else 1
    let sign_node=hir.append_node(@session.hir hir.Integer[loc types.integer_literal(sign @session.types) '0d' sign])
    let array=hir.append_node(@session.hir hir.ArrayLiteral[loc types.array_type(word limbs.length @session.types) limbs])
    return hir.append_node(@session.hir hir.ObjectLiteral[loc object_member(declared session.types) [hir.ObjectField[loc 'sign' sign_node] hir.ObjectField[loc 'limbs' array]] value])
}

# A normalized literal needs no runtime gcd. Its parts are constructed using
# the same prelude-owned layouts as ordinary calls. Keeping the nonzero record
# alternative explicit also preserves the proof needed by a later divisor.
rational_literal = (numerator:bigint denominator:bigint declared:addr big:addr? loc:Span @session:contexts.Session):>addr => {
    $runtime_assert denominator >? 0
    if big isnt? none and numerator =? 0 return hir.append_node(@session.hir hir.Integer[loc types.integer_literal(0 @session.types) '0d' 0])
    let top=if big is? none hir.append_node(@session.hir hir.Integer[loc types.integer_literal(numerator @session.types) '0d' numerator]) else bigint_literal(numerator big loc @session)
    let bottom=if big is? none hir.append_node(@session.hir hir.Integer[loc types.integer_literal(denominator @session.types) '0d' denominator]) else bigint_literal(denominator big loc @session)
    return hir.append_node(@session.hir hir.ObjectLiteral[loc object_member(declared session.types) [hir.ObjectField[loc 'numerator' top] hir.ObjectField[loc 'denominator' bottom]]])
}
const rational_binary:dict<string string>=[
    '__add__'->'add' '__sub__'->'sub' '__mul__'->'mul' '__truediv__'->'div'
    '__eq__'->'eq' '__ne__'->'ne' '__lt__'->'lt' '__le__'->'le' '__gt__'->'gt' '__ge__'->'ge'
]

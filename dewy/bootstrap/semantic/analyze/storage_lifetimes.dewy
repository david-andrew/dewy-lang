$explicit_copies

from reporting import SrcFile, Error, Pointer
import p"../context.dewy" as contexts
import p"../bindings.dewy" as bindings
import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"../effect_rows.dewy" as rows
import p"effects.dewy" as effects
import p"predicate_effects.dewy" as predicates
import p"place_contracts.dewy" as places

# Sort retains selected element addresses while invoking its key. Private
# owning values cannot be reached by an unrelated callback; borrowed,
# captured and exposed storage needs a call-graph or effect-row proof.
Visit:type=const [id:addr source:addr function:addr?=none]
Selection:type=const [id:addr source:addr argument:addr binding:addr?]
Candidate:type=const [id:addr source:addr function:addr? binding:addr?]
owner=(binding:addr? session:contexts.Session):>addr?=>{
    let seen:set<addr>=set[]
    loop binding isnt? none and binding not in? seen {
        seen.push(binding)
        let entry=bindings.find_binding(session.registry binding)
        if entry is? none or entry.declaration is? none break
        let declaration=hir.node_at(session.hir entry.declaration)
        if declaration isnt? hir.Declare or not declaration.view break
        let path=bindings.access_path(declaration.expr session.hir facts=true dictionaries=true)
        let root=hir.node_at(session.hir path.root)
        binding=if root is? hir.ExpressedIdentifier root.binding_id else none
    }
    return binding
}
root_of=(id:addr session:contexts.Session):>addr?=>{
    let path=bindings.access_path(id session.hir facts=true dictionaries=true)
    let root=hir.node_at(session.hir path.root)
    return if root is? hir.ExpressedIdentifier owner(root.binding_id session) else none
}
nonmutating=(id:addr session:contexts.Session):>bool=>{
    let signature=types.node_at(session.types types.unfold(types.strip_refinement(hir.node_at(session.hir id).value_type session.types) session.types))
    return signature is? types.FunctionType and rows.implies(signature.effects rows.Contract[excluded=[rows.Atom['mutates']]])
}
# Ask a boolean question of the existing set. A missing summary means the
# complete tracked set; neither case needs an owning optional/fallback set.
interferes=(changed:set<addr> binding:addr? borrowed:bool tracked:set<addr> session:contexts.Session):>bool=>{
    loop item in changed {
        let selected=owner(item session)
        if selected isnt? none and (if borrowed selected in? tracked else selected =? binding) return true
    }
    return false
}
select_entry=(id:addr visit:Visit session:contexts.Session @selections:array<Selection>):>void=>{
    let argument=hir.node_at(session.hir id)
    if argument isnt? hir.Place return void
    let path=bindings.access_path(argument.target session.hir facts=true dictionaries=true)
    loop step in path.steps {
        if hir.node_at(session.hir step) is? hir.DictLookup {
            selections.push(Selection[visit.id visit.source id root_of(argument.target session)])
            break
        }
    }
}
validate=(roots:array<places.Root> source_files:array<SrcFile> session:contexts.Session):>Error?=>{
    let candidates:array<Candidate>=[]
    let selections:array<Selection>=[]
    let private:dict<addr set<addr>>=[]
    let borrowed_parameters:set<addr>=set[]
    let captured:set<addr>=set[]
    let exposed:set<addr>=set[]
    let written:set<addr>=set[]
    let aliases:dict<addr addr>=[]
    let seen:set<addr>=set[]
    let pending:array<Visit>=[]
    let ids:array<addr>=[]
    loop root in roots {pending.push(Visit[root.id root.source]) ids.push(root.id)}
    loop pending.length>?0 {
        let item=pending.pop
        if item.id in? seen continue
        seen.push(item.id)
        let node=hir.node_at(session.hir item.id)
        let source=item.source
        let function=item.function
        if node is? hir.FunctionLiteral {
            function=item.id
            if node.source isnt? none {source=node.source}
            let owned:set<addr>=set[]
            let local:set<addr>=set[]
            let reads:set<addr>=set[]
            loop param in effects.literal_params(node) {
                if param.binding_id isnt? none {
                    local.push(param.binding_id)
                    if param.place {borrowed_parameters.push(param.binding_id)} else {owned.push(param.binding_id)}
                }
            }
            let body=hir.children(node)
            let visited:set<addr>=set[]
            loop body.length>?0 {
                let id=body.pop
                if id in? visited continue
                visited.push(id)
                let part=hir.node_at(session.hir id)
                if part is? hir.FunctionLiteral continue
                if part is? hir.Declare and part.binding_id isnt? none {
                    local.push(part.binding_id)
                    if not part.view {owned.push(part.binding_id)}
                }
                if part is? hir.IteratorExpression {
                    let target=hir.node_at(session.hir part.target)
                    if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {local.push(target.binding_id)}
                }
                if part is? hir.ExpressedIdentifier and part.binding_id isnt? none {reads.push(part.binding_id)}
                hir.push_children(part @body)
            }
            private[item.id]=owned
            loop binding in reads {
                if binding in? local continue
                let selected=owner(binding session)
                if selected isnt? none {captured.push(selected)}
            }
        }
        let target=predicates.write_target(node session.hir)
        if target isnt? none {
            let selected=root_of(target session)
            if selected isnt? none {written.push(selected)}
        }
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            let selected=owner(node.binding_id session)
            if selected isnt? none {aliases[node.binding_id]=selected}
        }
        if node is? hir.Place|hir.Transmute {
            let selected=root_of(if node is? hir.Place node.target else node.expr session)
            if selected isnt? none {exposed.push(selected)}
        }
        if node is? hir.FunctionCall {
            let method=hir.node_at(session.hir node.func)
            if method is? hir.ArrayMethod and method.name=?'sort' {candidates.push(Candidate[item.id source function root_of(method.array session)])}
        }
        if node is? hir.FunctionCall {
            let total=node.pos_args.length + node.kw_args.length
            if total >? 0 {
                loop argument in node.pos_args {select_entry(argument item session @selections)}
                loop [name argument] in node.kw_args {select_entry(argument item session @selections)}
            }
        }
        loop child in hir.children(node) {pending.push(Visit[child source function])}
    }
    if candidates.length=?0 and selections.length=?0 return none
    let tracked:set<addr>=set[]
    loop binding in captured {if binding in? written {tracked.push(binding)}}
    loop candidate in candidates {if candidate.binding isnt? none {tracked.push(candidate.binding)}}
    loop selection in selections {if selection.binding isnt? none {tracked.push(selection.binding)}}
    loop [alias target] in aliases {if target in? tracked {tracked.push(alias)}}
    let writes=effects.analyze_global_writes_in(ids session.hir tracked registry=session.registry)
    let readonly=effects.read_only_places_in(ids session.hir session.types)
    # Place selection is not a write; nested argument calls still execute
    # before entry use and cannot invalidate its containing dictionary.
    loop selections.length >? 0 {
        let selection=selections.pop
        let call=hir.node_at(session.hir selection.id)
        $runtime_assert call is? hir.FunctionCall
        let arguments=call.pos_args.copy()
        loop argument in call.kw_args.values {arguments.push(argument)}
        $runtime_assert selection.source <? source_files.length
        let borrowed=selection.binding isnt? none and selection.binding in? borrowed_parameters
        let conflict=if selection.id in? writes interferes(writes[selection.id] selection.binding borrowed tracked session) else interferes(tracked selection.binding borrowed tracked session)
        if not nonmutating(call.func session) and conflict {
            return Error[srcfile=source_files[selection.source] title='callee may invalidate a selected dictionary entry' pointers=[Pointer[hir.node_at(session.hir selection.argument).loc 'the entry owner must remain stable throughout the call']] hint='keep owner mutations outside the borrowed entry call']
        }
        let after=false
        loop id in arguments {
            if not after {after=id =? selection.argument continue}
            let argument=hir.node_at(session.hir id)
            let selected=if argument is? hir.Place argument.target else id
            if interferes(predicates.mutated_bindings(selected session.hir writes readonly) selection.binding borrowed tracked session) {
                return Error[srcfile=source_files[selection.source] title='later argument may invalidate a selected dictionary entry' pointers=[Pointer[hir.node_at(session.hir selection.argument).loc 'this place borrows the entry storage'] Pointer[argument.loc 'this argument may change its owner before the call']] hint='evaluate the changing argument before selecting the entry']
            }
        }
    }
    loop candidate in candidates {
        let call=hir.node_at(session.hir candidate.id)
        $runtime_assert call is? hir.FunctionCall
        let binding=candidate.binding
        let isolated=binding isnt? none and candidate.function isnt? none and candidate.function in? private and binding in? private[candidate.function] and binding not in? captured and binding not in? exposed
        let borrowed=binding isnt? none and binding in? borrowed_parameters
        let key=call.kw_args.get('key')
        $runtime_assert candidate.source <? source_files.length
        let method=hir.node_at(session.hir call.func)
        $runtime_assert method is? hir.ArrayMethod
        let callbacks_safe=(key is? none or nonmutating(key session)) and (method.key_copy is? none or nonmutating(method.key_copy session))
        if key isnt? none and not isolated and not callbacks_safe {
            let conflict=if candidate.id in? writes interferes(writes[candidate.id] binding borrowed tracked session) else interferes(tracked binding borrowed tracked session)
            if conflict {
                return Error[srcfile=source_files[candidate.source] title='sort key may change its receiver' pointers=[Pointer[hir.node_at(session.hir key).loc 'the array storage must stay stable throughout key evaluation']] hint='keep receiver mutations outside the sort, or provide a callback contract proving no mutation']
            }
        }
        # Extend an independent argument worklist; preserve the checked call.
        let arguments=call.pos_args.copy()
        loop arg in call.kw_args.values {arguments.push(arg)}
        loop argument in arguments {
            # Sparse contract overrides retain the original summary table.
            # Only calls proven nonmutating are omitted; their arguments still run.
            let readonly_calls:set<addr>=set[]
            let nodes:array<addr>=[argument]
            loop nodes.length>?0 {
                let id=nodes.pop
                let node=hir.node_at(session.hir id)
                if node is? hir.FunctionLiteral continue
                if node is? hir.FunctionCall and nonmutating(node.func session) {readonly_calls.push(id)}
                hir.push_children(node @nodes)
            }
            if interferes(predicates.mutated_bindings(argument session.hir writes readonly read_only_calls=readonly_calls) binding borrowed tracked session) {
                return Error[srcfile=source_files[candidate.source] title='sort option may change its receiver' pointers=[Pointer[hir.node_at(session.hir argument).loc 'this option changes the array while the sort is being prepared']] hint='evaluate the option before selecting the array to sort']
            }
        }
    }
    return none
}

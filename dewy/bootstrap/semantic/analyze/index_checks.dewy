$explicit_copies
from reporting import SrcFile, Error, Pointer
import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"../bindings.dewy" as bindings
import p"term_facts.dewy" as terms
import p"fact_state.dewy" as facts
import p"intervals.dewy" as ranges
import p"length_proofs.dewy" as proofs

doc"""
Index obligations after evaluating the sequence and the index.

Return the diagnostic to the driver, which decides whether a `$prototype`
site has a supported runtime check. Success may also establish a constant
index for lowering. The mathematical endpoint remains a bigint here; the
driver converts it to the target index representation when updating HIR.

An upper proof alone is insufficient: a negative index is below every
nonempty length. All successful runtime-index paths first prove zero as a
lower bound. Insertion alone permits the endpoint equal to the length.
"""

Proven:type = const [constant_index:bigint?=none]
known_interval = (interval:ranges.Interval?):>string => {
    if interval is? none return 'unknown'
    let lower = if interval.lower is? none '-∞' else _bigint_as_string(interval.lower)
    let upper = if interval.upper is? none '∞' else _bigint_as_string(interval.upper)
    return "{lower}..{upper}"
}
string_length = (id:addr nodes:types.Table):>addr? => {
    let node = types.node_at(nodes id)
    if node is? types.StringLiteralType return node.value.length
    if node is? types.StringType return node.length
    if types.is_primitive(node 'char') or types.is_primitive(node 'grapheme') return 1
    return none
}
constant = (interval:ranges.Interval):>Proven => Proven[
    # The result outlives the analysis interval that supplied its endpoint.
    if ranges.same_endpoint(interval.lower interval.upper) interval.lower.copy() else none
]

# Ask about the lower endpoint without constructing an owning optional
# interval or bigint. Missing length evidence has the usual lower bound zero.
below_minimum = (upper:bigint length:ranges.Interval?):>bool => {
    if length is? none or length.lower is? none return upper <? 0
    return upper <? length.lower
}
minimum_at_least = (length:ranges.Interval? offset:bigint):>bool => {
    if length is? none or length.lower is? none return 0 >=? offset
    return length.lower >=? offset
}

# `length_interval` includes the evaluated sequence's field/parameter
# invariants. A route's state entry alone need not contain those bounds.
check_index = (node:hir.Index|hir.StringIndex interval:ranges.Interval? length_interval:ranges.Interval? state:facts.State context:proofs.Context observed:dict<addr ranges.Interval> srcfile:SrcFile @registry:bindings.Registry symbolic:bool=true):>Proven|Error => {
    let sequence:addr = if node is? hir.Index node.array else node.string
    let sequence_type = hir.node_at(context.env.nodes sequence).value_type
    let length:addr? = none
    let kind = if node is? hir.Index 'array' else 'string'
    if node is? hir.Index {
        let type = types.node_at(context.env.types sequence_type)
        if type is? types.ArrayType { length = type.length }
    } else { length = string_length(sequence_type context.env.types) }
    let index = node.index
    let index_node = hir.node_at(context.env.nodes index)
    let nonnegative = interval isnt? none and interval.lower isnt? none and interval.lower >=? 0
    if length isnt? none and interval isnt? none and nonnegative and interval.upper isnt? none and interval.upper <? length return constant(interval)
    let array_id = terms.sequence_id(sequence context.env @registry)
    if array_id isnt? none and interval isnt? none and nonnegative {
        if interval.upper isnt? none and below_minimum(interval.upper length_interval) return constant(interval)
        if symbolic {
            let named = terms.binding_term(index context.env @registry)
            if named isnt? none and named.projection =? 'value' and facts.contains(state facts.index(named.binding_id array_id)) return Proven[]
            let offset = terms.length_offset(index array_id context.env @registry)
            if offset isnt? none and minimum_at_least(length_interval offset) return Proven[]
            if proofs.upper(index array_id 1 state context observed @registry) return Proven[]
        }
    }
    let notes:array<string> = []
    if length is? none { notes.push("nothing establishes the {kind}'s length here, so even a small index may be past the end") }
    let hint = "establish both a nonnegative lower bound and an upper bound below the {kind} length"
    if length is? none and interval isnt? none and nonnegative {
        let upper = if interval.upper is? none 'None' else _bigint_as_string(interval.upper)
        hint = "guard on the length first: `if xs.length >? {upper} \{ … }` proves a constant index, `i <? xs.length` a running one"
    }
    return Error[
        srcfile=srcfile title="{kind} index is not proven in bounds"
        pointers=[Pointer[span=index_node.loc message="the index interval here is `{known_interval(interval)}`"]]
        notes=notes hint=hint
    ]
}

check_method_index = (method:string index:addr interval:ranges.Interval? state:facts.State array_id:addr length:ranges.Interval allow_end:bool context:proofs.Context observed:dict<addr ranges.Interval> srcfile:SrcFile @registry:bindings.Registry symbolic:bool=true):>Error? => {
    if interval isnt? none and interval.lower isnt? none and interval.lower >=? 0 {
        if interval.upper isnt? none and (if allow_end minimum_at_least(length interval.upper) else below_minimum(interval.upper length)) return none
        if symbolic {
            let named = terms.binding_term(index context.env @registry)
            if named isnt? none and named.projection =? 'value' and facts.contains(state facts.index(named.binding_id array_id)) return none
            if proofs.upper(index array_id (if allow_end 0 else 1) state context observed @registry) return none
        }
    }
    let index_node = hir.node_at(context.env.nodes index)
    let relation = if allow_end 'at or below' else 'below'
    return Error[
        srcfile=srcfile title="`{method}` index is not proven in bounds"
        pointers=[Pointer[span=index_node.loc message="the index interval here is `{known_interval(interval)}`"]]
        hint="establish a nonnegative lower bound and an upper bound {relation} the array length (for example `if idx <? xs.length \{ ... }`)"
    ]
}

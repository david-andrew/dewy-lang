import p"fact_state.dewy" as facts
import p"intervals.dewy" as ranges

doc"""
Relational proofs and transfer, independent of HIR traversal.

An order fact records a guaranteed gap, `larger - smaller >= gap`.
A finite worklist follows established difference edges; not finding a
proof is unknown, not evidence that the relation is false. Copying facts
copies value evidence, not an alias between the two storage locations.
"""

Context:type = const [facts:facts.Context minimum_lengths:dict<addr bigint>=[]]
# Element routes allocated during validation join the vacuous-fact roots
# (the hosted rule reads the registry live). The context is immutable, so a
# changed root table rebuilds it.
with_element_roots = (context:Context roots:dict<addr addr>):>Context => {
    let updated=context.facts.copy
    updated.element_roots=roots
    return Context[updated context.minimum_lengths]
}
interval_of = (term:facts.Term state:facts.State context:Context):>ranges.Interval => {
    let known = facts.known(state term context.facts)
    if known isnt? none return known
    let width = context.facts.widths.get(term.binding_id)
    return if width is? none ranges.UNKNOWN else width
}
# One-hop reduction combines interval and difference evidence without a
# recursive solver or a new qualifier. It can prove a shifted term fits its
# word even when only the related counter was tested by the loop guard.
narrowed_interval = (term:facts.Term state:facts.State context:Context):>ranges.Interval => {
    let result=interval_of(term state context)
    loop entry in state.values {
        let fact=entry.fact
        let gap=entry.interval.lower
        if fact isnt? facts.Order or gap is? none continue
        if facts.same_term(fact.smaller term) and not facts.same_term(fact.larger term) {
            let other=interval_of(fact.larger state context)
            if other.upper isnt? none {result=ranges.intersect(result ranges.Interval[none other.upper-gap entry.interval.capped or other.capped])}
        } else if facts.same_term(fact.larger term) and not facts.same_term(fact.smaller term) {
            let other=interval_of(fact.smaller state context)
            if other.lower isnt? none {result=ranges.intersect(result ranges.Interval[other.lower+gap none entry.interval.capped or other.capped])}
        }
    }
    return result
}
# Fall back to the complete established difference graph when the cheap
# one-hop reduction cannot prove a machine update exact. Forward paths give
# upper bounds, reverse paths give lower bounds. Each bound has a concrete
# path and endpoint interval; the finite edge budget is not a convergence
# certificate and supplies no additional evidence.
order_interval = (term:facts.Term state:facts.State context:Context):>ranges.Interval => {
    let result=interval_of(term state context)
    loop upper in [true false] {
        let values:Edges=[] let lengths:Edges=[]
        let count:addr=0
        loop entry in state.values {
            let fact=entry.fact let gap=entry.interval.lower
            if fact isnt? facts.Order or gap is? none continue
            let origin=if upper fact.smaller else fact.larger
            let target=if upper fact.larger else fact.smaller
            let step=Step[target gap entry.interval.capped]
            if origin.projection =? 'value' {
                if origin.binding_id not in? values {values[origin.binding_id]=[]}
                let edges=@values[origin.binding_id]
                edges.push(step)
            } else {
                if origin.binding_id not in? lengths {lengths[origin.binding_id]=[]}
                let edges=@lengths[origin.binding_id]
                edges.push(step)
            }
            count+=1
        }
        let best_values:dict<addr ranges.Interval>=[] let best_lengths:dict<addr ranges.Interval>=[]
        if term.projection =? 'value' {best_values[term.binding_id]=ranges.Interval[0 none]}
        else {best_lengths[term.binding_id]=ranges.Interval[0 none]}
        let frontier:array<Step>=[Step[term 0]]
        # Both adjacency tables move here; each step reads one without a copy.
        let tables:array<Edges>=[values lengths]
        loop round in 0.. and round <? count {
            let following:array<Step>=[]
            loop reached in frontier {
                let edges=tables[if reached.term.projection =? 'value' 0 else 1].get(reached.term.binding_id [])
                loop edge in edges {
                    let target=edge.term
                    let candidate=reached.gap+edge.gap
                    let capped=reached.capped or edge.capped
                    let previous=if target.projection =? 'value' best_values.get(target.binding_id) else best_lengths.get(target.binding_id)
                    if previous isnt? none and previous.lower isnt? none and (previous.lower >? candidate or (previous.lower =? candidate and (not previous.capped or capped))) continue
                    let anchor=interval_of(target state context)
                    if upper and anchor.upper isnt? none {result=ranges.intersect(result ranges.Interval[none anchor.upper-candidate anchor.capped or capped])}
                    else if not upper and anchor.lower isnt? none {result=ranges.intersect(result ranges.Interval[anchor.lower+candidate none anchor.capped or capped])}
                    let evidence=ranges.Interval[candidate none capped]
                    if target.projection =? 'value' {best_values[target.binding_id]=evidence}
                    else {best_lengths[target.binding_id]=evidence}
                    following.push(Step[target candidate capped])
                }
            }
            if following.length =? 0 break
            frontier=following
        }
    }
    return result
}
minimum_length = (sequence:addr state:facts.State context:Context):>bigint => {
    let interval = facts.lookup(state facts.value(facts.Term[sequence 'length']))
    if interval isnt? none {
        let lower = interval.lower
        if lower isnt? none return lower
    }
    let declared = context.minimum_lengths.get(sequence)
    return if declared is? none 0 else declared
}
# Keep value and length identities separate instead of packing their ids.
Step:type = const [term:facts.Term gap:bigint capped:bool=false]
Edges:type = dict<addr array<Step>>
ordered = (smaller:facts.Term larger:facts.Term gap:bigint state:facts.State context:Context):>bool => {
    # The usual direct proof needs no constructed bound result.
    if ordered_direct(smaller larger gap state context) return true
    if search(smaller larger state context gap) isnt? none return true
    # Equality exclusion sharpens a non-strict integer order, regardless of
    # which condition established its evidence first. Keep ordinary successful
    # bounds queries on their existing allocation-free direct path.
    return gap =? 1 and facts.contains(state facts.distinct(smaller larger)) and ordered(smaller larger 0 state context)
}
# Arithmetic needs the strongest established difference, while a predicate
# can stop once it has enough evidence. Both consume the same finite graph.
bound = (smaller:facts.Term larger:facts.Term state:facts.State):>ranges.Interval? => search(smaller larger state none none)
search = (smaller:facts.Term larger:facts.Term state:facts.State context:Context? required:bigint?):>ranges.Interval? => {
    if facts.same_term(smaller larger) return if required is? none or required <=? 0 ranges.Interval[0 none] else none
    let outgoing=false
    loop entry in state.values {
        let fact=entry.fact
        if fact is? facts.Order and entry.interval.lower isnt? none and facts.same_term(fact.smaller smaller) {outgoing=true break}
    }
    if not outgoing return none
    let values:Edges=[]
    let lengths:Edges=[]
    let count:addr=0
    loop entry in state.values {
        let fact=entry.fact
        let weight=entry.interval.lower
        if fact isnt? facts.Order or weight is? none continue
        let step=Step[fact.larger weight entry.interval.capped]
        let key=fact.smaller.binding_id
        # Extend each adjacency list in place; a copy per edge made graph
        # construction quadratic in the facts leaving one term.
        if fact.smaller.projection =? 'value' {
            if key not in? values {values[key]=[]}
            let edges=@values[key]
            edges.push(step)
        } else {
            if key not in? lengths {lengths[key]=[]}
            let edges=@lengths[key]
            edges.push(step)
        }
        count+=1
    }
    let best_values:dict<addr ranges.Interval>=[]
    let best_lengths:dict<addr ranges.Interval>=[]
    if smaller.projection =? 'value' {best_values[smaller.binding_id]=ranges.Interval[0 none]}
    else {best_lengths[smaller.binding_id]=ranges.Interval[0 none]}
    let frontier:array<Step>=[Step[smaller 0]]
    # Both adjacency tables move here; each step reads one without a copy.
    let tables:array<Edges>=[values lengths]
    # At most one edge per round; every simple path fits this bound. A
    # contradictory positive cycle must not make proof search diverge.
    loop round in 0.. and round <? count {
        let following:array<Step>=[]
        loop reached in frontier {
            let outgoing=tables[if reached.term.projection =? 'value' 0 else 1].get(reached.term.binding_id [])
            loop edge in outgoing {
                let target=edge.term
                let candidate=reached.gap+edge.gap
                let capped=reached.capped or edge.capped
                let previous=if target.projection =? 'value' best_values.get(target.binding_id) else best_lengths.get(target.binding_id)
                if previous isnt? none and previous.lower isnt? none and (previous.lower >? candidate or (previous.lower =? candidate and (not previous.capped or capped))) continue
                if context isnt? none and required isnt? none and ordered_direct(target larger required-candidate state context) return ranges.Interval[required none capped]
                let evidence=ranges.Interval[candidate none capped]
                if target.projection =? 'value' {best_values[target.binding_id]=evidence}
                else {best_lengths[target.binding_id]=evidence}
                following.push(Step[target candidate capped])
            }
        }
        if following.length =? 0 break
        frontier=following
    }
    if required isnt? none return none
    return if larger.projection =? 'value' best_values.get(larger.binding_id) else best_lengths.get(larger.binding_id)
}
ordered_direct = (smaller:facts.Term larger:facts.Term gap:bigint state:facts.State context:Context):>bool => {
    if facts.same_term(smaller larger) return gap <=? 0
    let direct = facts.lookup(state facts.order(smaller larger))
    if direct isnt? none and direct.lower isnt? none and direct.lower >=? gap return true
    let left = interval_of(smaller state context)
    let right = interval_of(larger state context)
    if larger.projection =? 'length' {
        right = ranges.intersect(right ranges.Interval[minimum_length(larger.binding_id state context) none])
    }
    if left.upper isnt? none and right.lower isnt? none and right.lower - left.upper >=? gap return true
    if larger.projection =? 'length' {
        if smaller.projection =? 'value' and gap <=? 1 and facts.contains(state facts.index(smaller.binding_id larger.binding_id)) return true
        loop entry in state.values {
            let fact = entry.fact
            let lower = entry.interval.lower
            if fact is? facts.Remainder and lower isnt? none and facts.same_term(fact.subject smaller) and facts.same_term(fact.upper larger) and lower >=? gap return true
        }
    }
    return false
}

replace_term = (term:facts.Term source:facts.Term target:facts.Term):>facts.Term => if facts.same_term(term source) target else term
copy_relational = (@state:facts.State source:facts.Term target:facts.Term):>void => {
    if facts.same_term(source target) return
    # Derive from the unchanged input, then publish together. A whole-state
    # snapshot copied unrelated facts whenever publishing detached its array.
    # The pending entries also prevent new evidence feeding this same transfer.
    let entries:array<facts.Entry>=[]
    loop entry in state.values {
        let fact = entry.fact
        if not facts.mentions(fact source) continue
        if fact is? facts.Linear {
            let items:array<facts.Coefficient>=[]
            loop item in fact.coefficients {items.push(facts.Coefficient[replace_term(item.term source target) item.weight])}
            entries.push(facts.Entry[facts.linear(items) entry.interval])
        }
        else if fact is? facts.Order {
            entries.push(facts.Entry[facts.order(replace_term(fact.smaller source target) replace_term(fact.larger source target)) entry.interval])
        }
        else if fact is? facts.Distinct {
            entries.push(facts.Entry[facts.distinct(replace_term(fact.left source target) replace_term(fact.right source target)) entry.interval])
        }
        else if fact is? facts.Remainder {
            let offset = fact.offset
            if source.projection =? 'value' and target.projection =? 'value' and offset =? source.binding_id { offset = target.binding_id }
            entries.push(facts.Entry[facts.remainder(replace_term(fact.subject source target) replace_term(fact.upper source target) offset) entry.interval])
        }
        else if fact is? facts.Nonzero and target.projection =? 'value' { entries.push(facts.Entry[facts.nonzero(target.binding_id) entry.interval]) }
        else if fact is? facts.Index {
            if source.projection =? 'value' and target.projection =? 'value' {
                entries.push(facts.Entry[facts.index(target.binding_id fact.sequence) entry.interval])
            }
            else if source.projection =? 'length' and target.projection =? 'length' {
                entries.push(facts.Entry[facts.index(fact.index target.binding_id) entry.interval])
            }
            else if source.projection =? 'length' and target.projection =? 'value' {
                # `let n = xs.length`: an index bound against xs becomes an
                # order bound against n, not an imaginary sequence with n's id.
                entries.push(facts.Entry[facts.order(facts.Term[fact.index] target) ranges.Interval[1 none]])
            }
        }
    }
    loop entry in entries {facts.put(@state entry.fact entry.interval)}
}

subject_of = (fact:facts.Fact):>facts.Term? => {
    if fact is? facts.Value return fact.term
    if fact is? facts.Order return fact.smaller
    if fact is? facts.Remainder return fact.subject
    if fact is? facts.Nonzero return facts.Term[fact.subject]
    if fact is? facts.Index return facts.Term[fact.index]
    return none
}
# A value snapshot carries both its scalar and length identities. Rename every
# occurrence, including upper/offset/sequence positions, without changing the
# relation's direction or confusing a scalar with a sequence length.
map_term = (term:facts.Term source:addr target:addr):>facts.Term =>
    if term.binding_id =? source facts.Term[target term.projection] else term
mentions_binding = (fact:facts.Fact binding:addr):>bool => {
    if fact is? facts.Linear {
        loop item in fact.coefficients {if item.term.binding_id=?binding return true}
        return false
    }
    if fact is? facts.Value return fact.term.binding_id =? binding
    if fact is? facts.Distinct return fact.left.binding_id =? binding or fact.right.binding_id =? binding
    if fact is? facts.Order return fact.smaller.binding_id =? binding or fact.larger.binding_id =? binding
    if fact is? facts.Remainder return fact.subject.binding_id =? binding or fact.upper.binding_id =? binding or fact.offset =? binding
    if fact is? facts.Nonzero return fact.subject =? binding
    $runtime_assert fact is? facts.Index
    return fact.index =? binding or fact.sequence =? binding
}
map_binding = (fact:facts.Fact source:addr target:addr):>facts.Fact => {
    if fact is? facts.Linear {
        let items:array<facts.Coefficient>=[]
        loop item in fact.coefficients {items.push(facts.Coefficient[map_term(item.term source target) item.weight])}
        return facts.linear(items)
    }
    if fact is? facts.Value return facts.value(map_term(fact.term source target))
    if fact is? facts.Distinct return facts.distinct(map_term(fact.left source target) map_term(fact.right source target))
    if fact is? facts.Order return facts.order(map_term(fact.smaller source target) map_term(fact.larger source target))
    if fact is? facts.Remainder return facts.remainder(map_term(fact.subject source target) map_term(fact.upper source target) if fact.offset =? source target else fact.offset)
    if fact is? facts.Nonzero return facts.nonzero(if fact.subject =? source target else fact.subject)
    $runtime_assert fact is? facts.Index
    return facts.index(if fact.index =? source target else fact.index if fact.sequence =? source target else fact.sequence)
}
rekey = (fact:facts.Fact subject:facts.Term):>facts.Fact => {
    $runtime_assert subject.projection =? 'value'
    return map_binding(fact 0 subject.binding_id)
}
facts_of = (state:facts.State subject:facts.Term):>facts.State => {
    $runtime_assert subject.projection =? 'value'
    let output:facts.State = facts.State[]
    loop entry in state.values {
        if mentions_binding(entry.fact subject.binding_id) {
            facts.put(@output map_binding(entry.fact subject.binding_id 0) entry.interval)
        }
    }
    return output
}

        loop binding in selections {if binding not in? proven {invalid.push(binding)}}
        loop binding in invalid {ready.push(binding)}
        loop ready.length>?0 {
            let binding=ready.pop
            if binding in? dependencies {
                const needed=@dependencies[binding]
                loop neighbor in needed {if neighbor not in? invalid {invalid.push(neighbor) ready.push(neighbor)}}
            }
            if binding in? readers {
                const waiting=@readers[binding]
                loop neighbor in waiting {if neighbor not in? invalid {invalid.push(neighbor) ready.push(neighbor)}}
            }
        }
        loop binding in selections {
            if binding in? invalid continue
            flow_views.push(binding) local_views.push(binding)
            $runtime_assert binding in? selection_leaves
            const leaves=@selection_leaves[binding]
            loop leaf in leaves {
                let selected=hir.node_at(nodes leaf)
                if selected is? hir.ArrayLiteral {flow_literals.push(leaf)}
                if selected is? hir.ExpressedIdentifier {flow_sources.push(leaf)}
            }
        }
        let literal_bytes:addr=0
        loop item in body {
            let node=hir.node_at(nodes item)
            if node isnt? hir.FunctionCall continue
            let targets=effects.direct_targets(node analysis nodes)
            if targets is? none or targets.length =? 0 continue
            let allowed:set<addr>=set[]
            loop arg in node.pos_args {allowed.push(arg)}
            loop arg in node.kw_args.values {allowed.push(arg)}
            loop target in targets {
                let callee=hir.node_at(nodes target)
                $runtime_assert callee is? hir.FunctionLiteral
                let pairs=effects.pair_arguments(node callee)
                let current:set<addr>=set[]
                let rejected:set<addr>=set[]
                let wanted:dict<addr addr>=[]
                loop param in effects.literal_params(callee) {
                    if not param.place and param.binding_id isnt? none {wanted[param.binding_id]=param.value_type}
                }
                if pairs isnt? none {
                    loop pair in pairs {
                        let arg=hir.node_at(nodes pair.argument)
                        let expected=if pair.parameter is? none none else wanted.get(pair.parameter)
                        let loan=union_loan_source(pair.argument nodes table)
                        let path=bindings.access_path(if loan is? none pair.argument else loan nodes forwarding=common_array_field(arg nodes table))
                        let source=hir.node_at(nodes path.root)
                        let safe=false
                        if source is? hir.ExpressedIdentifier and source.binding_id isnt? none and pair.parameter isnt? none {
                            let own=parameters.get(source.binding_id)
                            let local=local_owners.get(source.binding_id)
                            if local is? none and id not in? blocked {local=constants.get(source.binding_id)}
                            let stable=source.binding_id in? local_views or (local isnt? none and ordinary(local table @eligible))
                            if not stable and own isnt? none and ordinary(own table @eligible) and source.binding_id in? summaries.by_param_binding {
                                const incoming=@summaries.by_param_binding[source.binding_id]
                                stable=stable_projection(incoming path nodes)
                            }
                            if not stable {stable=held_for_call(source.binding_id path node parameters call_owners captured summaries analysis nodes table @eligible)}
                            let same=false
                            if expected isnt? none {
                                same=arg.value_type =? expected or loan isnt? none
                                let actual_type=types.node_at(table arg.value_type)
                                let expected_type=types.node_at(table expected)
                                if actual_type is? types.ArrayType and expected_type is? types.ArrayType and actual_type.element =? expected_type.element and expected_type.length is? none {same=true}
                            }
                            if stable and expected isnt? none and ordinary(arg.value_type table @eligible) and same and pair.parameter in? summaries.by_param_binding {
                                const outgoing=@summaries.by_param_binding[pair.parameter]
                                safe=effects.read_only(outgoing)
                            }
                        }
                        if expected isnt? none and pair.parameter isnt? none and pair.parameter not in? unprojected_reads and pair.parameter in? summaries.by_param_binding and types.same_type(arg.value_type expected table) {
                            let fields=record_loan_fields(arg nodes table families constants @loan_sizes)
                            if fields isnt? none {
                                const outgoing=@summaries.by_param_binding[pair.parameter]
                                safe=effects.read_only(outgoing)
                                loop field in fields {if not stable_value(field parameters local_owners local_views constants (id not in? blocked) summaries nodes table @eligible) and not field_held_for_call(field node parameters call_owners captured summaries analysis nodes table @eligible) {safe=false}}
                            }
                        }
                        if safe {current.push(pair.argument)} else {rejected.push(pair.argument)}
                    }
                }
                # Filter the candidates once. Building two intermediate set
                # values copies three inputs before discarding those copies.
                let retained:set<addr>=set[]
                loop argument in allowed {
                    if argument in? current and argument not in? rejected {retained.push(argument)}
                }
                allowed=retained
            }
            let loans:set<addr>=set[]
            let accepted:set<addr>=set[]
            # Match source argument order and the hosted frame-root budget.
            let arguments:array<addr>=[]
            loop argument in node.pos_args {arguments.push(argument)}
            loop argument in node.kw_args.values {arguments.push(argument)}
            loop argument in arguments {
                if argument not in? allowed continue
                let value=hir.node_at(nodes argument)
                if value is? hir.ObjectLiteral {
                    let size=record_loan_size(value.value_type table families @loan_sizes)
                    if size is? none or size>?4096-literal_bytes continue
                    literal_bytes+=size loans.push(argument)
                }
                accepted.push(argument)
            }
            if loans.length>?0 {literal_arguments[item]=loans}
            if accepted.length>?0 {result[item]=accepted}
        }
    }
    let constant_bindings:set<addr>=set[]
    loop [binding type] in constants {constant_bindings.push(binding)}
    return Proofs[result local_views literal_arguments flow_views flow_literals flow_sources constant_bindings]
}

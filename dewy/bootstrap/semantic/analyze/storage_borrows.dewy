$explicit_copies

import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"effects.dewy" as effects
import p"predicate_effects.dewy" as local_effects
import p"../bindings.dewy" as bindings
import p"../type_queries.dewy" as views
import p"../subtyping.dewy" as subtyping

# A storage proof shared by allocation contracts and argument lowering.
# Read-only by-value parameters, stable fresh local owners and their projections
# stay stable, including later argument evaluation. Calls on their own bindings
# cannot change an incoming alias through nonlocal or raw storage. The shared
# proof permits outer array-length widening and exact union-member boxing.
# More precise lowerer proofs may still borrow other expressions.
const OPERATORS:set<string>=set['__add__' '__sub__' '__mul__' '__div__' '__floordiv__' '__mod__' '__unary_sub__' '__not__' '__eq__' '__ne__' '__lt__' '__le__' '__gt__' '__ge__' '__and__' '__or__' '__xor__' '__nand__' '__nor__' '__xnor__' '__lshift__' '__rshift__']
const ARRAY_METHODS:set<string>=set['push' 'pop' 'clear' 'reserve' 'insert' 'truncate' 'set_length' 'join']
# Native builtins carry stable identities. A source function with the same
# spelling must still contribute its ordinary call-graph effects.
primitive=(node:hir.AST registry:bindings.Registry):>bool=>{
    if node isnt? hir.ExpressedIdentifier or node.name not in? OPERATORS return false
    if node.binding_id is? none return true
    let binding=bindings.find_binding(registry node.binding_id)
    return binding isnt? none and binding.builtin
}
# Borrowing bytes must not skip logical resource copy/drop operations.
borrowable=(type:addr table:types.Table):>bool=>{
    let shape=views.structural_base(type table)
    let first=types.node_at(table shape)
    if first isnt? types.ArrayType|types.ObjectType|types.TypeOr|types.StringType|types.StringLiteralType and not views.string_valued(shape table) return false
    let pending:array<addr>=[shape] let seen:set<addr>=set[]
    loop pending.length>?0 {
        let id=views.structural_base(pending.pop table)
        if id in? seen continue
        seen.push(id)
        let item=types.node_at(table id)
        if item is? types.ObjectType {
            loop method in item.methods {if method.lifecycle isnt? none return false}
            loop field in item.fields {pending.push(field.value_type)}
        } else if item is? types.ArrayType {pending.push(item.element)}
        else if item is? types.TypeOr {loop member in item.items {pending.push(member)}}
    }
    return true
}

ordinary=(type:addr table:types.Table @known:dict<addr bool>):>bool=>{
    let found=known.get(type)
    if found isnt? none return found
    let result=borrowable(type table)
    known[type]=result
    return result
}
modeled_call=(node:hir.FunctionCall registry:bindings.Registry nodes:array<hir.AST> table:types.Table @known:dict<addr bool>):>bool=>{
    let func=hir.node_at(nodes effects.unwrap(node.func nodes))
    if primitive(func registry) return true
    # Builtin receiver/argument routes already belong to the effect summary;
    # they do not add an ambient write. Hooks and sort callbacks still need
    # the ordinary call-graph proof.
    return func is? hir.ArrayMethod and func.name in? ARRAY_METHODS and ordinary(hir.node_at(nodes func.array).value_type table @known)
}
stable_projection=(summary:effects.ParameterEffects path:bindings.AccessPath nodes:array<hir.AST>):>bool=>{
    if effects.read_only(summary) return true
    let steps:array<string>=[]
    loop step_id in path.steps {
        let step=hir.node_at(nodes step_id)
        if step is? hir.MemberAccess {steps.push(step.name)}
        else if step is? hir.ForwardingAccess {steps.push(step.field)}
        else {steps.push('[]')}
    }
    return effects.read_only_at(summary effects.Route[steps])
}
# Contextual boxing of a closed literal/default cannot expose existing
# caller storage. Casts of names and calls retain the conservative boundary.
independent_materialization=(id:addr nodes:array<hir.AST>):>bool=>{
    let pending:array<addr>=[id]
    loop pending.length>?0 {
        let node=hir.node_at(nodes pending.pop)
        if node isnt? hir.NoneValue|hir.Void|hir.Bool|hir.Integer|hir.String|hir.ArrayLiteral|hir.ObjectLiteral|hir.ValueCast|hir.RepresentationCast|hir.Obligation return false
        hir.push_children(node @pending)
    }
    return true
}
# Only fresh value boundaries seed private ownership. Conditional selection
# is lazy, but whichever branch returns supplies its own independent value.
private_origin=(id:addr nodes:array<hir.AST>):>bool=>{
    let pending:array<addr>=[id]
    loop pending.length>?0 {
        let item=hir.node_at(nodes pending.pop)
        if item is? hir.ObjectLiteral|hir.ArrayLiteral|hir.FunctionCall|hir.CopyValue|hir.NoneValue continue
        if item is? hir.Flow {
            if item.default is? none return false
            pending.push(item.default)
            loop id in item.arms {
                let arm=hir.node_at(nodes id)
                if arm isnt? hir.IfArm return false
                pending.push(arm.body)
            }
        } else if item is? hir.Block and item.items.length=?1 {pending.push(item.items[0])}
        else if item is? hir.ValueCast {pending.push(item.expr)}
        else {return false}
    }
    return true
}
# Classify only exact member injection/widening. The call proof below still
# supplies stability and read-only use; this is not permission by itself.
# Type normalization stays inside the representation query; only an input
# HIR identity crosses this boundary.
# Native `against` makes every union conversion explicit in checked HIR.
# Its cast already names the destination, including normalized keyword calls;
# reconstructing the formal signature here would repeat that work.
union_loan_source=(id:addr nodes:array<hir.AST> table:types.Table):>addr?=>{
    let node=hir.node_at(nodes id)
    if node isnt? hir.ValueCast|hir.RepresentationCast return none
    return if views.preserves_union_payload(hir.node_at(nodes node.expr).value_type node.value_type table) node.expr else none
}
# A common field can lend its existing dynamic-array descriptor, even when
# the record alternatives store it at different offsets. This is only a
# layout classification: prove still checks both owners and every callee.
common_array_field=(node:hir.AST nodes:array<hir.AST> table:types.Table):>bool=>{
    if node isnt? hir.ForwardingAccess or not types.is_primitive(types.node_at(table node.exception_type) 'never') return false
    let shape=views.structural_base(node.value_type table)
    let array=types.node_at(table shape)
    if array isnt? types.ArrayType or array.length isnt? none return false
    let path=bindings.access_path(node.value nodes)
    if hir.node_at(nodes path.root) isnt? hir.ExpressedIdentifier return false
    let receiver=types.node_at(table views.structural_base(hir.node_at(nodes node.value).value_type table))
    if receiver isnt? types.TypeOr or receiver.items.length=?0 return false
    loop member in receiver.items {
        let record=types.node_at(table views.structural_base(member table))
        if record isnt? types.ObjectType return false
        let field=types.object_field(record node.field)
        if field is? none or not types.same_type(views.structural_base(field.value_type table) shape table) return false
    }
    return true
}
# Include descendant layouts in the frame bound. Repeated fields count
# repeatedly; cycles/oversized families exhaust the finite budget. Summing
# alternatives is conservative and independent of backend padding choices.
LoanSizeItem:type=const [type:addr family:bool=true]
scalar_loan_cell=(type:addr table:types.Table):>bool=>{
    let shape=types.node_at(table views.structural_base(type table))
    if shape isnt? types.TypeOr or shape.items.length=?0 return false
    loop item in shape.items {
        let plain=views.structural_base(item table)
        let member=types.node_at(table plain)
        if member is? types.Primitive and member.name in? ['none' 'bool' 'true' 'false'] continue
        if views.fixed_integer_layout(plain table) is? none return false
    }
    return true
}
# Remove only scalar-to-cell packing. The call root is the cell's final
# storage, so both effects and lowering evaluate its operand directly.
scalar_cell_input=(id:addr nodes:array<hir.AST> table:types.Table):>addr=>{
    let node=hir.node_at(nodes id)
    if node is? hir.ValueCast|hir.RepresentationCast and scalar_loan_cell(node.value_type table) {
        let actual=views.structural_base(hir.node_at(nodes node.expr).value_type table)
        let shape=types.node_at(table actual)
        if shape is? types.IntegerLiteralType or views.fixed_integer_layout(actual table) isnt? none or (shape is? types.Primitive and shape.name in? ['none' 'bool' 'true' 'false']) return node.expr
    }
    return id
}
record_loan_size=(type:addr table:types.Table families:array<addr> @memo:dict<addr addr?>):>addr?=>{
    if type in? memo return memo[type]
    let pending:array<LoanSizeItem>=[LoanSizeItem[type]]
    let size:addr=0
    loop pending.length>?0 {
        if size>?4088 {memo[type]=none return none}
        let item=pending.pop
        let selected=views.structural_base(item.type table)
        let shape=types.node_at(table selected)
        if shape is? types.ObjectType {
            loop method in shape.methods {if method.lifecycle isnt? none {memo[type]=none return none}}
            loop field in shape.fields {pending.push(LoanSizeItem[field.value_type])}
            if item.family {
                loop id in families {
                    let child=types.node_at(table id)
                    $runtime_assert child is? types.ObjectType
                    if child.brand not=?shape.brand and (subtyping.brand_descends(child shape table) or subtyping.brand_carries(child shape table)) {
                        pending.push(LoanSizeItem[id false])
                    }
                }
            }
        } else if scalar_loan_cell(selected table) {
            if size>?4080 {memo[type]=none return none}
            size+=8
        } else if not (shape is? types.ArrayType and shape.length is? none) and not types.is_primitive(shape 'bool') and views.fixed_integer_layout(selected table) is? none {
            memo[type]=none return none
        }
        size+=8
    }
    memo[type]=size
    return size
}
# A bounded call root owns no fields: words, borrowed array handles, and
# inline records with those representations share the same lifetime proof.
record_loan_fields=(node:hir.AST nodes:array<hir.AST> table:types.Table families:array<addr> constants:dict<addr addr> @sizes:dict<addr addr?>):>array<addr>|none=>{
    if node isnt? hir.ObjectLiteral or not borrowable(node.value_type table) return none
    if record_loan_size(node.value_type table families @sizes) is? none return none
    let shape=types.node_at(table views.structural_base(node.value_type table))
    if shape isnt? types.ObjectType or shape.fields.length not=?node.fields.length return none
    let arrays:array<addr>=[]
    loop field in node.fields {
        let expected=types.object_field(shape field.name)
        if expected is? none return none
        let stored_id=views.structural_base(expected.value_type table)
        let actual_id=views.structural_base(hir.node_at(nodes field.value).value_type table)
        let stored=types.node_at(table stored_id)
        let actual=types.node_at(table actual_id)
        if stored is? types.ArrayType and stored.length is? none {
            if not types.same_type(actual_id stored_id table) {
                # Read length facts preserve a dynamic owner's descriptor.
                let value=hir.node_at(nodes field.value)
                if value isnt? hir.ExpressedIdentifier or value.binding_id is? none or value.binding_id not in? constants or not types.same_type(views.structural_base(constants[value.binding_id] table) stored_id table) return none
            }
            arrays.push(field.value)
        } else if stored is? types.ObjectType and types.same_type(actual_id stored_id table) {
            arrays.push(field.value)
        } else if scalar_loan_cell(stored_id table) and (types.same_type(actual_id stored_id table) or (actual is? types.Primitive and actual.name in? ['none' 'bool' 'true' 'false']) or views.fixed_integer_layout(actual_id table) isnt? none or actual is? types.IntegerLiteralType) {
            continue
        } else if types.is_primitive(stored 'bool') and actual is? types.Primitive and actual.name in? ['bool' 'true' 'false'] {
            continue
        } else {
            let bounds=views.fixed_integer_bounds(stored_id table)
            if bounds is? none return none
            if not types.same_type(actual_id stored_id table) {
                if actual isnt? types.IntegerLiteralType or actual.value<?bounds.minimum or actual.value>?bounds.maximum return none
            }
        }
    }
    return arrays
}
stable_value=(value:addr parameters:dict<addr addr> local_owners:dict<addr addr> local_views:set<addr> constants:dict<addr addr> allow_constants:bool summaries:effects.ProgramEffects nodes:array<hir.AST> table:types.Table @eligible:dict<addr bool> selections:set<addr>=set[]):>bool=>{
    let path=bindings.access_path(value nodes forwarding=common_array_field(hir.node_at(nodes value) nodes table))
    let source=hir.node_at(nodes path.root)
    if source isnt? hir.ExpressedIdentifier or source.binding_id is? none return false
    let own=parameters.get(source.binding_id)
    let local=local_owners.get(source.binding_id)
    if local is? none and allow_constants {local=constants.get(source.binding_id)}
    let stable=source.binding_id in? local_views or source.binding_id in? selections or (local isnt? none and ordinary(local table @eligible))
    if not stable and own isnt? none and ordinary(own table @eligible) and source.binding_id in? summaries.by_param_binding {
        const incoming=@summaries.by_param_binding[source.binding_id]
        stable=stable_projection(incoming path nodes)
    }
    if not stable return false
    loop id in path.steps {
        let step=hir.node_at(nodes id)
        if common_array_field(step nodes table) continue
        let stored:addr?=none
        if step is? hir.Index {
            let parent=types.node_at(table views.structural_base(hir.node_at(nodes step.array).value_type table))
            if parent is? types.ArrayType {stored=parent.element}
        } else if step is? hir.MemberAccess {
            let parent=types.node_at(table views.structural_base(hir.node_at(nodes step.value).value_type table))
            if parent is? types.ObjectType {
                let field=types.object_field(parent step.name)
                if field isnt? none {stored=field.value_type}
            }
        }
        if stored is? none or not types.same_type(views.structural_base(stored table) views.structural_base(step.value_type table) table) return false
    }
    return true
}
# Branch leaves share a descriptor without owning the selected source. Only
# bounded scalar literals add storage; the caller proves every source stable.
array_selection=(id:addr nodes:array<hir.AST> table:types.Table):>array<addr> | none =>{
    let node=hir.node_at(nodes id)
    let shape=types.node_at(table views.structural_base(node.value_type table))
    if node isnt? hir.Flow or shape isnt? types.ArrayType return none
    let leaves:array<addr>=[]
    let pending:array<addr>=[id]
    loop pending.length>?0 {
        let id=pending.pop
        let item=hir.node_at(nodes id)
        # Nested joins may still be a union of array lengths. Widening that
        # join does not change a leaf's element layout or create an owner.
        if item is? hir.Flow {
            if item.default is? none return none
            pending.push(item.default)
            loop arm_id in item.arms {
                let arm=hir.node_at(nodes arm_id)
                if arm isnt? hir.IfArm return none
                pending.push(arm.body)
            }
        } else if item is? hir.Block and item.items.length=?1 {pending.push(item.items[0])}
        else if item is? hir.ValueCast|hir.RepresentationCast {pending.push(item.expr)}
        else {
            let actual=types.node_at(table views.structural_base(item.value_type table))
            if actual isnt? types.ArrayType or not types.same_type(actual.element shape.element table) return none
            if item isnt? hir.ArrayLiteral|hir.ExpressedIdentifier|hir.MemberAccess|hir.Index and not common_array_field(item nodes table) return none
            if item is? hir.ArrayLiteral {
                if actual.length is? none or actual.length not=?item.items.length or item.items.length>?64 return none
                if item.items.length>?0 and not types.is_primitive(types.node_at(table actual.element) 'bool') and views.fixed_integer_layout(actual.element table) is? none return none
                loop value in item.items {if hir.node_at(nodes value) is? hir.Spread return none}
            }
            leaves.push(id)
        }
    }
    return leaves
}
# A selection whose result must become an owner keeps the existing move
# protocol. Otherwise borrowing it could turn a valid move into a later copy.
owning_array_reads=(body:array<addr> analysis:effects.Analysis summaries:effects.ProgramEffects nodes:array<hir.AST> selection_reads:set<addr>=set[]):>set<addr>=>{
    let owning:set<addr>=set[]
    loop id in body {
        let parent=hir.node_at(nodes id)
        let borrowed:set<addr>=set[]
        if parent is? hir.FunctionCall {
            let targets=effects.direct_targets(parent analysis nodes)
            let first=true
            if targets isnt? none {loop target in targets {
                let literal=hir.node_at(nodes target)
                $runtime_assert literal is? hir.FunctionLiteral
                let current:set<addr>=set[]
                let parameters:set<addr>=set[]
                loop param in effects.literal_params(literal) {
                    if not param.place and param.binding_id isnt? none {parameters.push(param.binding_id)}
                }
                let pairs=effects.pair_arguments(parent literal)
                if pairs isnt? none {
                    loop pair in pairs {
                        if pair.parameter isnt? none and pair.parameter in? parameters and pair.parameter in? summaries.by_param_binding {
                            const summary=@summaries.by_param_binding[pair.parameter]
                            if effects.read_only(summary) {current.push(pair.argument)}
                        }
                    }
                }
                if not first {current=borrowed & current}
                borrowed=current
                first=false
            }}
        }
        loop id in hir.children(parent) {
            let child=hir.node_at(nodes id)
            if child isnt? hir.ExpressedIdentifier or child.binding_id is? none continue
            let observed=id in? borrowed or id in? selection_reads
            if parent is? hir.Index|hir.ArrayLength and id=?parent.array {observed=true}
            if parent is? hir.MemberAccess and id=?parent.value {observed=true}
            if parent is? hir.IteratorExpression and id=?parent.iterable {observed=true}
            if parent is? hir.ArrayMethod and parent.name=?'join' and id=?parent.array {observed=true}
            if not observed {owning.push(child.binding_id)}
        }
    }
    return owning
}
Proofs:type = const [arguments:dict<addr set<addr>> local_views:set<addr> literal_arguments:dict<addr set<addr>>=[] flow_views:set<addr>=set[] flow_literals:set<addr>=set[] flow_sources:set<addr>=set[] constants:set<addr>=set[]]
prove=(analysis:effects.Analysis summaries:effects.ProgramEffects nodes:array<hir.AST> table:types.Table registry:bindings.Registry):>Proofs=>{
    let loan_sizes:dict<addr addr?>=[]
    let families:array<addr>=[]
    let known:set<string>=set[]
    loop i in 0.. and i<?table.entries.length {
        let type=types.node_at(table i)
        if type is? types.ObjectType and type.minted and type.brand isnt? none and type.brand not in? known {
            known.push(type.brand) families.push(i)
        }
    }
    let eligible:dict<addr bool>=[]
    let bodies:dict<addr array<addr>>=[]
    let stable_locals:dict<addr dict<addr addr>>=[]
    let writes:dict<addr set<addr>>=[]
    let captured:set<addr>=set[]
    let edges:dict<addr set<addr>>=[]
    let blocked:set<addr>=set[]
    let constants:dict<addr addr>=[]
    let ambient_reads:dict<addr set<addr>>=[]
    # Immutable startup owners include ordinary factory results and explicit
    # copies: their value boundary separates them from initializer inputs.
    # Later raw/unknown calls still block the ambient-storage loan proof.
    # Remove function-local declarations before resolving ambient readers.
    loop [binding id] in analysis.declares {
        let node=hir.node_at(nodes id)
        if node is? hir.Declare and node.decltype=?'const' and not node.view and (independent_materialization(node.expr nodes) or private_origin(node.expr nodes)) {
            constants[binding]=if node.annotation is? none hir.node_at(nodes node.expr).value_type else node.annotation
        }
    }
    loop id in analysis.literals {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let locals:set<addr>=set[]
        loop param in effects.literal_params(literal) {if param.binding_id isnt? none {locals.push(param.binding_id)}}
        let body:array<addr>=[]
        let pending:array<addr>=[literal.body]
        loop param in effects.literal_params(literal) {if param is? hir.BoundParam {pending.push(param.value)}}
        let seen:set<addr>=set[]
        loop pending.length >? 0 {
            let item=pending.pop
            let node=hir.node_at(nodes item)
            if item in? seen or node is? hir.FunctionLiteral continue
            seen.push(item) body.push(item)
            # Installed report helpers cannot alias source owners. Traverse
            # the user message, including its calls/writes, rather than the
            # generated reporting body. This matches source-level borrowing;
            # the ordinary effects solver still checks reporting effects.
            if node is? hir.RuntimeFailure {
                if node.message isnt? none {pending.push(node.message)}
                continue
            }
            if node is? hir.Declare and node.binding_id isnt? none {locals.push(node.binding_id) constants.pop(node.binding_id default=0);}
            # Constructor field names are private locals, including names
            # used by a later default. They do not expose ambient storage.
            if node is? hir.ObjectLiteral {
                loop field in node.fields {if field.binding_id isnt? none {locals.push(field.binding_id)}}
            }
            if node is? hir.IteratorExpression {
                let target=hir.node_at(nodes node.target)
                if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {locals.push(target.binding_id)}
            }
            hir.push_children(node @pending)
        }
        # Reuse the unique body inventory, including defaults. A local owner
        # must not be written or exposed through a place anywhere in this scope.
        let written:set<addr>=set[]
        let candidates:dict<addr addr>=[]
        loop item in body {
            let node=hir.node_at(nodes item)
            let target=if node is? hir.IteratorExpression node.target else local_effects.write_target(node nodes)
            if target isnt? none {
                let path=bindings.access_path(target nodes facts=true)
                let root=hir.node_at(nodes path.root)
                if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {written.push(root.binding_id)}
            }
            # Private locals cannot alias ambient state, provided their
            # storage never crosses a raw/unmodelled boundary here. Ordinary
            # resolved value calls supply their own independent argument.
            let exposed:array<addr>=[]
            if node is? hir.Transmute|hir.RepresentationCast {
                if union_loan_source(item nodes table) is? none {exposed.push(node.expr)}
            } else if node is? hir.FunctionCall and effects.direct_targets(node analysis nodes) is? none {
                let func=hir.node_at(nodes effects.unwrap(node.func nodes))
                if not modeled_call(node registry nodes table @eligible) {
                    loop arg in node.pos_args {exposed.push(arg)}
                    loop arg in node.kw_args.values {exposed.push(arg)}
                    if func is? hir.ArrayMethod {exposed.push(func.array)}
                }
            }
            loop value in exposed {
                let path=bindings.access_path(value nodes facts=true)
                let root=hir.node_at(nodes path.root)
                if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {written.push(root.binding_id)}
            }
            if node is? hir.Declare and node.binding_id isnt? none and not node.view {
                let value=hir.node_at(nodes node.expr)
                # Ordinary calls return independent values; the call graph
                # below still rules out unknown/raw effects and captures.
                if private_origin(node.expr nodes) {candidates[node.binding_id]=value.value_type}
            }
        }
        loop binding in written {candidates.pop(binding default=0);}
        stable_locals[id]=candidates
        writes[id]=written
        loop item in body {
            let node=hir.node_at(nodes item)
            if node is? hir.RepresentationCast and not independent_materialization(node.expr nodes) and union_loan_source(item nodes table) is? none {blocked.push(id)}
            else if node is? hir.ExpressedIdentifier {
                let local=node.binding_id isnt? none and node.binding_id in? locals
                if not local and node.binding_id isnt? none {captured.push(node.binding_id)}
                let operation=primitive(node registry)
                if not local and not operation and effects.flatten_callable(item set[] analysis nodes) is? none {
                    if node.binding_id is? none {blocked.push(id)}
                    else if id in? ambient_reads {let reads=@ambient_reads[id] reads.push(node.binding_id)}
                    else {ambient_reads[id]=set[node.binding_id]}
                }
            } else if node is? hir.FunctionCall {
                let targets=effects.direct_targets(node analysis nodes)
                if targets is? none {
                    if not modeled_call(node registry nodes table @eligible) {blocked.push(id)}
                } else {
                    loop target in targets {
                        # Extend the live adjacency set, rather than copying
                        # it out and replacing the dictionary entry per edge.
                        if target in? edges {let callers=@edges[target] callers.push(id)}
                        else {edges[target]=set[id]}
                    }
                }
            }
        }
        # Retain the inventory only after its final local read, allowing a move.
        bodies[id]=body
    }
    loop [id reads] in ambient_reads {
        loop binding in reads {if binding not in? constants {blocked.push(id) break}}
    }
    let pending:array<addr>=[]
    loop id in blocked {pending.push(id)}
    loop pending.length >? 0 {
        let target=pending.pop
        if target not in? edges continue
        const callers=@edges[target]
        loop caller in callers {
            if caller not in? blocked {blocked.push(caller) pending.push(caller)}
        }
    }
    let result:dict<addr set<addr>>=[]
    let local_views:set<addr>=set[]
    let flow_views:set<addr>=set[]
    let flow_literals:set<addr>=set[]
    let flow_sources:set<addr>=set[]
    let literal_arguments:dict<addr set<addr>>=[]
    # Propagate ownership requirements back through known read-only
    # forwarding calls. Projection-only cycles introduce no owning use.
    let unprojected_reads:set<addr>=set[]
    let forwarders:dict<addr set<addr>>=[]
    loop id in analysis.literals {
        if id not in? bodies continue
        let parents:array<addr>=[id]
        loop item in bodies[id] {parents.push(item)}
        loop item in parents {
            let parent=hir.node_at(nodes item)
            let forwarded:dict<addr set<addr>>=[]
            let common:set<addr>=set[]
            if parent is? hir.FunctionCall {
                let targets=effects.direct_targets(parent analysis nodes)
                let first=true
                if targets isnt? none {loop target in targets {
                    let callee=hir.node_at(nodes target)
                    $runtime_assert callee is? hir.FunctionLiteral
                    let readonly:set<addr>=set[]
                    loop param in effects.literal_params(callee) {
                        if not param.place and param.binding_id isnt? none and param.binding_id in? summaries.by_param_binding {
                            const summary=@summaries.by_param_binding[param.binding_id]
                            if effects.read_only(summary) {readonly.push(param.binding_id)}
                        }
                    }
                    let current:set<addr>=set[]
                    let pairs=effects.pair_arguments(parent callee)
                    if pairs isnt? none {loop pair in pairs {
                        if pair.parameter isnt? none and pair.parameter in? readonly {
                            current.push(pair.argument)
                            if pair.argument in? forwarded {let parameters=@forwarded[pair.argument] parameters.push(pair.parameter)}
                            else {forwarded[pair.argument]=set[pair.parameter]}
                        }
                    }}
                    if first {common=current} else {common=common & current}
                    first=false
                }}
            }
            loop child in hir.children(parent) {
                let value=hir.node_at(nodes child)
                if value isnt? hir.ExpressedIdentifier or value.binding_id is? none continue
                if parent is? hir.MemberAccess and child=?parent.value continue
                if child in? common and child in? forwarded {
                    loop parameter in forwarded[child] {
                        if parameter in? forwarders {let callers=@forwarders[parameter] callers.push(value.binding_id)}
                        else {forwarders[parameter]=set[value.binding_id]}
                    }
                } else {unprojected_reads.push(value.binding_id)}
            }
        }
    }
    let rejected:array<addr>=[]
    loop binding in unprojected_reads {rejected.push(binding)}
    loop rejected.length>?0 {
        let target=rejected.pop
        if target not in? forwarders continue
        loop caller in forwarders[target] {
            if caller not in? unprojected_reads {unprojected_reads.push(caller) rejected.push(caller)}
        }
    }
    loop id in analysis.literals {
        if id not in? bodies or id not in? stable_locals or id not in? writes continue
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let parameters:dict<addr addr>=[]
        let local_owners:dict<addr addr>=[]
        loop [binding type] in stable_locals[id] {if binding not in? captured {local_owners[binding]=type}}
        # Keep the whole-call-graph alias guard for incoming storage. Private
        # fresh owners cannot be reached through another caller/global name.
        # A single place has no second place formal that could alias it.
        # Route effects still reject overlapping writes or exposed storage.
        let params=effects.literal_params(literal)
        let place_count:addr=0
        loop param in params {if param.place {place_count+=1}}
        if id not in? blocked {loop param in params {
            if (not param.place or place_count=?1) and param.binding_id isnt? none {parameters[param.binding_id]=param.value_type}
        }}
        const body=@bodies[id]
        # Whole-function local views share the allocation-contract proof.
        # Restrict this boundary to identical stored representations; scoped
        # views and retagging keep their separate lowerer obligations.
        const written=@writes[id]
        let pending_views:array<addr>=[]
        loop item in body {if hir.node_at(nodes item) is? hir.Declare {pending_views.push(item)}}
        let waiting_views:dict<addr array<addr>>=[]
        loop pending_views.length>?0 {
            let item=pending_views.pop
            let node=hir.node_at(nodes item)
            if node isnt? hir.Declare or node.binding_id is? none or node.binding_id in? written or node.binding_id in? captured continue
            let value=hir.node_at(nodes node.expr)
            if value isnt? hir.Index|hir.MemberAccess or not ordinary(value.value_type table @eligible) continue
            let path=bindings.access_path(node.expr nodes)
            let source=hir.node_at(nodes path.root)
            if source isnt? hir.ExpressedIdentifier or source.binding_id is? none continue
            if source.binding_id in? parameters {
                if source.binding_id not in? summaries.by_param_binding continue
                let owner=parameters[source.binding_id]
                const incoming=@summaries.by_param_binding[source.binding_id]
                # Keep the direct-forwarding rule when naming a projection:
                # sibling writes preserve its bytes, overlapping writes do not.
                if not ordinary(owner table @eligible) or not stable_projection(incoming path nodes) continue
            } else if source.binding_id not in? local_views and (source.binding_id not in? local_owners or not ordinary(local_owners[source.binding_id] table @eligible)) and not (id not in? blocked and source.binding_id in? constants and ordinary(constants[source.binding_id] table @eligible)) {
                # One dependency per candidate. Only a proved owner wakes its
                # readers; cycles or unknown owners cannot establish a loan.
                if source.binding_id in? waiting_views {let readers=@waiting_views[source.binding_id] readers.push(item)}
                else {waiting_views[source.binding_id]=[item]}
                continue
            }
            let stored:addr?=none
            if value is? hir.Index {
                let array=types.node_at(table views.structural_base(hir.node_at(nodes value.array).value_type table))
                if array is? types.ArrayType {stored=array.element}
            } else {
                $runtime_assert value is? hir.MemberAccess
                let record=types.node_at(table views.structural_base(hir.node_at(nodes value.value).value_type table))
                if record is? types.ObjectType {
                    let field=types.object_field(record value.name)
                    if field isnt? none {stored=field.value_type}
                }
            }
            if stored is? none or not types.same_type(views.structural_base(stored table) views.structural_base(value.value_type table) table) continue
            if node.annotation isnt? none and not types.same_type(views.structural_base(node.annotation table) views.structural_base(value.value_type table) table) continue
            local_views.push(node.binding_id)
            if node.binding_id in? waiting_views {
                const readers=@waiting_views[node.binding_id]
                loop reader in readers {pending_views.push(reader)}
            }
        }
        let flow_bytes:addr=0
        let selections:set<addr>=set[]
        let selection_leaves:dict<addr array<addr>>=[]
        let selection_reads:set<addr>=set[]
        loop item in body {
            let node=hir.node_at(nodes item)
            if node isnt? hir.Declare or node.binding_id is? none or node.view or node.binding_id in? written or node.binding_id in? captured continue
            let value=hir.node_at(nodes node.expr)
            if value isnt? hir.Flow or not ordinary(value.value_type table @eligible) continue
            let leaves=array_selection(node.expr nodes table)
            if leaves is? none continue
            if node.annotation isnt? none and not types.same_type(views.structural_base(node.annotation table) views.structural_base(value.value_type table) table) continue
            let size:addr=0
            loop leaf in leaves {
                let selected=hir.node_at(nodes leaf)
                if selected is? hir.ArrayLiteral {
                    if selected.items.length>?64 or size>?4096 {size=4097 break}
                    size+=64+8*selected.items.length
                }
            }
            if flow_bytes+size>?4096 continue
            flow_bytes+=size
            selections.push(node.binding_id)
            loop leaf in leaves {if hir.node_at(nodes leaf) is? hir.ExpressedIdentifier {selection_reads.push(leaf)}}
            selection_leaves[node.binding_id]=leaves
        }
        # Prove sources from independent roots, then revoke connected loans
        # if any reader needs an owner. A cycle or failed reader supplies no
        # evidence. Worklists visit each dependency a bounded number of times.
        let owning_reads:set<addr>=if selections.length>?0 owning_array_reads(body analysis summaries nodes selection_reads=selection_reads) else set[]
        let dependencies:dict<addr set<addr>>=[]
        let readers:dict<addr set<addr>>=[]
        let invalid:set<addr>=set[]
        let counts:dict<addr addr>=[]
        let ready:array<addr>=[]
        loop binding in selections {
            $runtime_assert binding in? selection_leaves
            const leaves=@selection_leaves[binding]
            let needed:set<addr>=set[]
            if binding in? owning_reads {invalid.push(binding)}
            loop leaf in leaves {
                if hir.node_at(nodes leaf) is? hir.ArrayLiteral continue
                if not stable_value(leaf parameters local_owners local_views constants (id not in? blocked) summaries nodes table @eligible selections=selections) {invalid.push(binding) continue}
                let source=hir.node_at(nodes bindings.access_path(leaf nodes forwarding=common_array_field(hir.node_at(nodes leaf) nodes table)).root)
                if source is? hir.ExpressedIdentifier and source.binding_id isnt? none and source.binding_id in? selections {
                    needed.push(source.binding_id)
                    if source.binding_id in? readers {let waiting=@readers[source.binding_id] waiting.push(binding)}
                    else {readers[source.binding_id]=set[binding]}
                }
            }
            counts[binding]=needed.length
            if needed.length=?0 and binding not in? invalid {ready.push(binding)}
            dependencies[binding]=needed
        }
        let proven:set<addr>=set[]
        loop ready.length>?0 {
            let binding=ready.pop
            proven.push(binding)
            if binding not in? readers continue
            const waiting=@readers[binding]
            loop reader in waiting {
                $runtime_assert reader in? counts
                let count=counts[reader]
                $runtime_assert count>?0
                counts[reader]=count-1
                if count=?1 and reader not in? invalid {ready.push(reader)}
            }
        }
        loop binding in selections {if binding not in? proven {invalid.push(binding)}}
        loop binding in invalid {ready.push(binding)}
        loop ready.length>?0 {
            let binding=ready.pop
            if binding in? dependencies {
                const needed=@dependencies[binding]
                loop neighbor in needed {if neighbor not in? invalid {invalid.push(neighbor) ready.push(neighbor)}}
            }
            if binding in? readers {
                const waiting=@readers[binding]
                loop neighbor in waiting {if neighbor not in? invalid {invalid.push(neighbor) ready.push(neighbor)}}
            }
        }
        loop binding in selections {
            if binding in? invalid continue
            flow_views.push(binding) local_views.push(binding)
            $runtime_assert binding in? selection_leaves
            const leaves=@selection_leaves[binding]
            loop leaf in leaves {
                let selected=hir.node_at(nodes leaf)
                if selected is? hir.ArrayLiteral {flow_literals.push(leaf)}
                if selected is? hir.ExpressedIdentifier {flow_sources.push(leaf)}
            }
        }
        let literal_bytes:addr=0
        loop item in body {
            let node=hir.node_at(nodes item)
            if node isnt? hir.FunctionCall continue
            let targets=effects.direct_targets(node analysis nodes)
            if targets is? none or targets.length =? 0 continue
            let allowed:set<addr>=set[]
            loop arg in node.pos_args {allowed.push(arg)}
            loop arg in node.kw_args.values {allowed.push(arg)}
            loop target in targets {
                let callee=hir.node_at(nodes target)
                $runtime_assert callee is? hir.FunctionLiteral
                let pairs=effects.pair_arguments(node callee)
                let current:set<addr>=set[]
                let rejected:set<addr>=set[]
                let wanted:dict<addr addr>=[]
                loop param in effects.literal_params(callee) {
                    if not param.place and param.binding_id isnt? none {wanted[param.binding_id]=param.value_type}
                }
                if pairs isnt? none {
                    loop pair in pairs {
                        let arg=hir.node_at(nodes pair.argument)
                        let expected=if pair.parameter is? none none else wanted.get(pair.parameter)
                        let loan=union_loan_source(pair.argument nodes table)
                        let path=bindings.access_path(if loan is? none pair.argument else loan nodes forwarding=common_array_field(arg nodes table))
                        let source=hir.node_at(nodes path.root)
                        let safe=false
                        if source is? hir.ExpressedIdentifier and source.binding_id isnt? none and pair.parameter isnt? none {
                            let own=parameters.get(source.binding_id)
                            let local=local_owners.get(source.binding_id)
                            if local is? none and id not in? blocked {local=constants.get(source.binding_id)}
                            let stable=source.binding_id in? local_views or (local isnt? none and ordinary(local table @eligible))
                            if not stable and own isnt? none and ordinary(own table @eligible) and source.binding_id in? summaries.by_param_binding {
                                const incoming=@summaries.by_param_binding[source.binding_id]
                                stable=stable_projection(incoming path nodes)
                            }
                            let same=false
                            if expected isnt? none {
                                same=arg.value_type =? expected or loan isnt? none
                                let actual_type=types.node_at(table arg.value_type)
                                let expected_type=types.node_at(table expected)
                                if actual_type is? types.ArrayType and expected_type is? types.ArrayType and actual_type.element =? expected_type.element and expected_type.length is? none {same=true}
                            }
                            if stable and expected isnt? none and ordinary(arg.value_type table @eligible) and same and pair.parameter in? summaries.by_param_binding {
                                const outgoing=@summaries.by_param_binding[pair.parameter]
                                safe=effects.read_only(outgoing)
                            }
                        }
                        if expected isnt? none and pair.parameter isnt? none and pair.parameter not in? unprojected_reads and pair.parameter in? summaries.by_param_binding and types.same_type(arg.value_type expected table) {
                            let fields=record_loan_fields(arg nodes table families constants @loan_sizes)
                            if fields isnt? none {
                                const outgoing=@summaries.by_param_binding[pair.parameter]
                                safe=effects.read_only(outgoing)
                                loop field in fields {if not stable_value(field parameters local_owners local_views constants (id not in? blocked) summaries nodes table @eligible) {safe=false}}
                            }
                        }
                        if safe {current.push(pair.argument)} else {rejected.push(pair.argument)}
                    }
                }
                # Filter the candidates once. Building two intermediate set
                # values copies three inputs before discarding those copies.
                let retained:set<addr>=set[]
                loop argument in allowed {
                    if argument in? current and argument not in? rejected {retained.push(argument)}
                }
                allowed=retained
            }
            let loans:set<addr>=set[]
            let accepted:set<addr>=set[]
            # Match source argument order and the hosted frame-root budget.
            let arguments:array<addr>=[]
            loop argument in node.pos_args {arguments.push(argument)}
            loop argument in node.kw_args.values {arguments.push(argument)}
            loop argument in arguments {
                if argument not in? allowed continue
                let value=hir.node_at(nodes argument)
                if value is? hir.ObjectLiteral {
                    let size=record_loan_size(value.value_type table families @loan_sizes)
                    if size is? none or size>?4096-literal_bytes continue
                    literal_bytes+=size loans.push(argument)
                }
                accepted.push(argument)
            }
            if loans.length>?0 {literal_arguments[item]=loans}
            if accepted.length>?0 {result[item]=accepted}
        }
    }
    let constant_bindings:set<addr>=set[]
    loop [binding type] in constants {constant_bindings.push(binding)}
    return Proofs[result local_views literal_arguments flow_views flow_literals flow_sources constant_bindings]
}

Proofs:type = const [arguments:dict<addr set<addr>> local_views:set<addr> literal_arguments:dict<addr set<addr>>=[] flow_views:set<addr>=set[] flow_literals:set<addr>=set[] flow_sources:set<addr>=set[] constants:set<addr>=set[]]
# Outside storage a write or exposure can change: not a `const` binding, a
# string or a binary literal, which are immutable, and not a scalar.
mutable_state=(binding:addr analysis:effects.Analysis nodes:array<hir.AST> table:types.Table):>bool=>{
    let declared=analysis.declares.get(binding)
    if declared is? none return true
    let node=hir.node_at(nodes declared)
    if node isnt? hir.Declare return true
    if node.decltype =? 'const' return false
    let type=if node.annotation is? none hir.node_at(nodes node.expr).value_type else node.annotation
    if types.node_at(table types.strip_refinement(type table)) is? types.BinaryLiteralType return false
    # A scalar has no storage an argument could share.
    let shape=types.node_at(table views.structural_base(type table))
    if shape is? types.Primitive and shape.name in? ['bool' 'true' 'false'] return false
    if views.fixed_integer_layout(type table) isnt? none return false
    return not views.string_valued(type table)
}
# Functions whose place parameter some caller may fill with storage a global
# names: a place argument rooted outside the caller's own locals (module
# state, or a capture), or at a place parameter of such a function. A
# function used as a value, or never bound, has unknown callers.
global_placed=(analysis:effects.Analysis bodies:dict<addr array<addr>> locals_by:dict<addr set<addr>> nodes:array<hir.AST>):>set<addr>=>{
    let functions:dict<addr addr>=[]
    let named:set<addr>=set[]
    loop [binding declared] in analysis.declares {
        let node=hir.node_at(nodes declared)
        if node is? hir.Declare and hir.node_at(nodes node.expr) is? hir.FunctionLiteral {functions[binding]=node.expr named.push(node.expr)}
    }
    let aliased:set<addr>=set[]
    loop id in analysis.literals {if id not in? named {aliased.push(id)}}
    let places:dict<addr addr>=[]
    loop id in analysis.literals {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        loop param in effects.literal_params(literal) {if param.place and param.binding_id isnt? none {places[param.binding_id]=id}}
    }
    let site_callers:array<addr>=[]
    let site_roots:array<addr?>=[]
    let site_targets:array<addr>=[]
    loop id in analysis.literals {
        if id not in? bodies continue
        let called:set<addr>=set[]
        loop item in bodies[id] {
            let node=hir.node_at(nodes item)
            if node isnt? hir.FunctionCall continue
            let func=effects.unwrap(node.func nodes)
            if hir.node_at(nodes func) is? hir.ExpressedIdentifier {called.push(func)}
            let targets=effects.direct_targets(node analysis nodes)
            if targets is? none continue
            loop target in targets {
                let callee=hir.node_at(nodes target)
                $runtime_assert callee is? hir.FunctionLiteral
                let pairs=effects.pair_arguments(node callee)
                if pairs is? none continue
                loop pair in pairs {
                    let argument=hir.node_at(nodes pair.argument)
                    if argument isnt? hir.Place or pair.parameter is? none or pair.parameter not in? places continue
                    let root=hir.node_at(nodes bindings.access_path(argument.target nodes).root)
                    site_callers.push(id) site_targets.push(target)
                    site_roots.push(if root is? hir.ExpressedIdentifier root.binding_id else none)
                }
            }
        }
        loop item in bodies[id] {
            let node=hir.node_at(nodes item)
            if node is? hir.ExpressedIdentifier and node.binding_id isnt? none and node.binding_id in? functions and item not in? called {aliased.push(functions[node.binding_id])}
        }
    }
    let changed=true
    loop changed {
        changed=false
        let index:addr=0
        loop index <? site_targets.length and index <? site_callers.length and index <? site_roots.length {
            let target=site_targets[index]
            let caller=site_callers[index]
            let root=site_roots[index]
            index+=1
            if target in? aliased continue
            let outside=root is? none or caller not in? locals_by or root not in? locals_by[caller]
            let forwarded=root isnt? none and root in? places and places[root] in? aliased
            if outside or forwarded {aliased.push(target) changed=true}
        }
    }
    return aliased
}
prove=(analysis:effects.Analysis summaries:effects.ProgramEffects nodes:array<hir.AST> table:types.Table registry:bindings.Registry):>Proofs=>{
    let loan_sizes:dict<addr addr?>=[]
    let families:array<addr>=[]
    let known:set<string>=set[]
    loop i in 0.. and i<?table.entries.length {
        let type=types.node_at(table i)
        if type is? types.ObjectType and type.minted and type.brand isnt? none and type.brand not in? known {
            known.push(type.brand) families.push(i)
        }
    }
    let eligible:dict<addr bool>=[]
    let bodies:dict<addr array<addr>>=[]
    let stable_locals:dict<addr dict<addr addr>>=[]
    let call_locals:dict<addr dict<addr addr>>=[]
    let writes:dict<addr set<addr>>=[]
    let captured:set<addr>=set[]
    let edges:dict<addr set<addr>>=[]
    let blocked:set<addr>=set[]
    let opaque:set<addr>=set[]
    let locals_by:dict<addr set<addr>>=[]
    let constants:dict<addr addr>=[]
    # Immutable startup owners include ordinary factory results and explicit
    # copies: their value boundary separates them from initializer inputs.
    # Later raw/unknown calls still block the ambient-storage loan proof.
    # Remove function-local declarations before resolving ambient readers.
    loop [binding id] in analysis.declares {
        let node=hir.node_at(nodes id)

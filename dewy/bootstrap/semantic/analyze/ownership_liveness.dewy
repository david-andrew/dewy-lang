$explicit_copies
import p"../bindings.dewy" as bindings
import p"../hir.dewy" as hir
import p"../lifecycle.dewy" as lifecycle
import p"predicate_effects.dewy" as predicate_effects
import p"../ty.dewy" as types

# Logical ownership liveness, independent of physical storage lowering.
# Branches join future reads; loop backedges retain outer owners, while
# assignments kill the old value and iteration locals are born anew. A view keeps its source alive until its
# birth is crossed walking backwards; a return has no advancing edge.
# Liveness is kept per field route, so a component can leave its owner while
# a sibling is still read. A `store` entry needs the enclosing storage of a
# field assignment, but not the component's old value.
Selector:type=const [binding:addr]
Distinct:type=const [left:int64|Selector right:int64|Selector]
Requirements:type=array<array<Distinct>>
Entry:type=const [binding:addr path:array<string|int64>=[] store:bool=false measure:bool=false selectors:dict<addr addr>=[]]
Live:type=dict<string Entry>
Analysis:type=[
    owners:set<addr>
    selectors:set<addr>=set[]
    selector_scopes:dict<addr set<addr>>=[]
    obligations:dict<addr Requirements>=[]
    required_views:dict<addr addr>=[]
    view_conflicts:dict<addr addr>=[]
    call_writes:dict<addr set<addr>>=[]
    read_only_places:set<addr>=set[]
    aliases:dict<addr addr>=[]
    captured:set<addr>=set[]
    occurrences:dict<addr addr>=[]
    candidates:set<addr>=set[]
    consumes:dict<addr addr>=[]
    # component consumptions: the field path below the consumed owner
    paths:dict<addr array<string|int64>>=[]
    declarations:dict<addr addr>=[]
    # Live on leaving the function: the caller reads each place parameter
    # whole.
    exit:Live=[]
]
SelectorLocals:type=[declarations:dict<addr addr>=[] scopes:dict<addr set<addr>>=[]]
# Once-initialized scalar locals have stable identities only after their
# declaration, on the lexical path where it ran. A declaration in a loop is
# a different value on each iteration and retains a wildcard identity.
selector_locals=(body:addr inputs:set<addr> nodes:array<hir.AST> table:types.Table):>SelectorLocals=>{
    let result=SelectorLocals[]
    visit_selector_locals(body inputs.copy() false nodes table @result)
    return result
}
visit_selector_locals=(id:addr visible:set<addr> repeated:bool nodes:array<hir.AST> table:types.Table @result:SelectorLocals):>void=>{
    if id in? result.scopes {result.scopes[id]=result.scopes[id] & visible}
    else {result.scopes[id]=visible.copy()}
    let node=hir.node_at(nodes id)
    if node is? hir.FunctionLiteral return
    if node is? hir.Block {
        loop child in node.items {
            visit_selector_locals(child visible.copy repeated nodes table @result)
            let declaration=hir.node_at(nodes child)
            if not repeated and declaration is? hir.Declare and not declaration.view and declaration.binding_id isnt? none {
                let type=if declaration.annotation is? none hir.node_at(nodes declaration.expr).value_type else declaration.annotation
                if types.is_primitive(types.node_at(table types.strip_refinement(type table)) 'int64') {
                    result.declarations[declaration.binding_id]=child
                    visible.push(declaration.binding_id)
                }
            }
        }
        return
    }
    loop child in hir.children(node) {visit_selector_locals(child visible.copy() (repeated or node is? hir.LoopArm) nodes table @result)}
}
entry_key=(entry:Entry):>string=>{
    let key="{entry.binding}{if entry.store '!' else if entry.measure '?' else ':'}"
    loop name in entry.path {key+=if name is? string "f{name.length}:{name}" else "i{name};"}
    loop i in [0..entry.path.length) {
        let binding=entry.selectors.get(i)
        if binding isnt? none {key+="s{i}:{binding};"}
    }
    return key
}
add_entry=(@live:Live entry:Entry):>void=>{live[entry_key(entry)]=entry}
merge=(@live:Live other:Live):>void=>{loop [key entry] in other {live[key]=entry}}
under=(path:array<string|int64> prefix:array<string|int64>):>bool=>{
    if path.length <? prefix.length return false
    loop i in [0..prefix.length) {if path[i] not=? prefix[i] return false}
    return true
}
# The checked slot identity, independent of the selector's spelling.
fixed_index=(node:hir.Index nodes:array<hir.AST>):>int64?=>{
    if node.constant_index isnt? none and node.constant_index<=?9223372036854775807 return node.constant_index as int64
    let index=hir.node_at(nodes node.index)
    if index is? hir.Integer and index.value>=?0 and index.value<=?9223372036854775807 return index.value as int64
    return none
}
# A stable route, or conservatively its prefix before an unknown slot.
field_route=(id:addr nodes:array<hir.AST> allow_prefix:bool=false wildcards:bool=false selectors:set<addr>=set[]):>Entry?=>{
    let reverse:array<string|int64>=[]
    let reverse_selectors:array<addr?>=[]
    let node=hir.node_at(nodes id)
    loop node is? hir.MemberAccess|hir.Index {
        if node is? hir.MemberAccess {reverse.push(node.name) reverse_selectors.push(none) node=hir.node_at(nodes node.value)}
        else {
            let index=fixed_index(node nodes)
            if index is? none {
                if wildcards {
                    reverse.push(-1)
                    let selected=hir.node_at(nodes node.index)
                    reverse_selectors.push(if selected is? hir.ExpressedIdentifier and selected.binding_id isnt? none and selected.binding_id in? selectors selected.binding_id else none)
                }
                else if not allow_prefix {return none}
                else {reverse.clear reverse_selectors.clear}
            } else {reverse.push(index) reverse_selectors.push(none)}
            node=hir.node_at(nodes node.array)
        }
    }
    if node isnt? hir.ExpressedIdentifier or node.binding_id is? none return none
    let path:array<string|int64>=[]
    let selected:dict<addr addr>=[]
    loop reverse.length >? 0 {
        $runtime_assert reverse_selectors.length>?0
        let binding=reverse_selectors.pop
        if binding isnt? none {selected[path.length]=binding}
        path.push(reverse.pop)
    }
    return Entry[node.binding_id path selectors=selected]
}
roots=(binding:addr aliases:dict<addr addr>):>set<addr>=>{
    let result:set<addr>=set[]
    let current:addr?=binding
    loop current isnt? none and current not in? result {
        result.push(current)
        current=aliases.get(current)
    }
    return result
}
read_roots=(id:addr aliases:dict<addr addr> nodes:array<hir.AST>):>set<addr>=>{
    let result:set<addr>=set[]
    let pending:array<addr>=[id]
    loop pending.length >? 0 {
        let node=hir.node_at(nodes pending.pop)
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            loop binding in roots(node.binding_id aliases) {result.push(binding)}
        }
        hir.push_children(node @pending)
    }
    return result
}
# Wildcards describe all valid slots, retaining disjoint fields below them.
# `under` above remains exact: a write to one selected slot cannot kill the
# liveness of every slot in this footprint.
overlaps=(left:array<string|int64> right:array<string|int64>):>bool=>{
    loop i in 0.. and i<?left.length and i<?right.length {
        let a=left[i] let b=right[i]
        if a=?b continue
        if a is? int64 and b is? int64 and (a=?-1 or b=?-1) continue
        return false
    }
    return true
}
# Prove that other operands cannot observe a transferred component.
disjoint_inputs=(scope:addr selected:addr route:Entry aliases:dict<addr addr> nodes:array<hir.AST>):>bool=>{
    # Collapse maximal routes, retaining selector reads. An alias still has
    # a whole-owner footprint; a direct sibling route can remain live.
    let pending:array<addr>=[scope]
    loop pending.length>?0 {
        let id=pending.pop
        if id=?selected continue
        let access=field_route(id nodes wildcards=true)
        let node=hir.node_at(nodes id)
        if access isnt? none {
            if route.binding in? roots(access.binding aliases) and (access.binding not=?route.binding or overlaps(route.path access.path)) return false
            loop node is? hir.MemberAccess|hir.Index {
                if node is? hir.Index {pending.push(node.index) node=hir.node_at(nodes node.array)}
                else {node=hir.node_at(nodes node.value)}
            }
        } else {hir.push_children(node @pending)}
    }
    return true
}
# Whether a live entry needs the value a consumption of `path` takes.
needed=(route:Entry live:Live aliases:dict<addr addr> propose:bool available:set<addr>):>Requirements?=>{
    let clauses:Requirements=[]
    loop entry in live.values {
        if route.binding not in? roots(entry.binding aliases) continue
        if entry.binding not=?route.binding return none
        if not overlaps(route.path entry.path) continue
        if entry.measure and route.path.length>?entry.path.length continue
        if entry.store {
            # Selected stores still require their old-value cleanup proof.
            loop i in 0.. and i<?route.path.length and i<?entry.path.length {
                if route.path[i]=?-1 or entry.path[i]=?-1 return none
            }
            if route.path.length>=?entry.path.length continue
            return none
        }
        let alternatives:array<Distinct>=[]
        if propose {
            loop i in 0.. and i<?route.path.length and i<?entry.path.length {
                let a=route.path[i] let b=entry.path[i]
                if a isnt? int64 or b isnt? int64 continue
                let left=route.selectors.get(i) let right=entry.selectors.get(i)
                if (a=?-1 and left is? none) or (b=?-1 and right is? none) continue
                if left=?right continue
                if (left isnt? none and left not in? available) or (right isnt? none and right not in? available) continue
                alternatives.push(Distinct[if left is? none a else Selector[left] if right is? none b else Selector[right]])
            }
        }
        if alternatives.length=?0 return none
        clauses.push(alternatives)
    }
    return clauses
}
LoopExit:type=const [after:Live repeated:Live]
consume=(id:addr route:Entry saved_path:array<string|int64> live:Live enabled:set<addr> @analysis:Analysis nodes:array<hir.AST> table:types.Table):>void=>{
    let clauses:Requirements?=none
    if route.binding in? enabled and id in? analysis.candidates {
        let available=if analysis.selector_scopes.length=?0 analysis.selectors.copy() else analysis.selector_scopes.get(id set[]).copy()
        clauses=needed(route live analysis.aliases lifecycle.copy_blocker(hir.node_at(nodes id).value_type table) isnt? none available)
    }
    if clauses isnt? none {
        analysis.consumes[id]=route.binding
        analysis.obligations[id]=clauses
        if saved_path.length >? 0 {analysis.paths[id]=saved_path.copy()}
        else {analysis.paths.pop(id default=[]);}
    } else {
        analysis.consumes.pop(id default=0);
        analysis.paths.pop(id default=[]);
        analysis.obligations.pop(id default=[]);
    }
}
# Keep fields above the first selection. A write through any array slot may
# detach its container; dictionary operations similarly retain the owner.
storage_route=(id:addr nodes:array<hir.AST>):>Entry?=>{
    let path=bindings.access_path(id nodes dictionaries=true)
    let root=hir.node_at(nodes path.root)
    if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return none
    let prefix:array<string|int64>=[]
    loop id in path.steps {
        let step=hir.node_at(nodes id)
        if step isnt? hir.MemberAccess break
        prefix.push(step.name)
    }
    return Entry[root.binding_id prefix]
}
check_view_writes=(id:addr live:Live @analysis:Analysis nodes:array<hir.AST>):>void=>{
    if analysis.required_views.length=?0 return
    let node=hir.node_at(nodes id)
    let changed:array<Entry>=[]
    let target=predicate_effects.write_target(node nodes)
    if node is? hir.Place and id in? analysis.read_only_places {target=none}
    if node is? hir.DictStore|hir.DictRemove and target isnt? none {
        let member=hir.node_at(nodes target)
        if member is? hir.MemberAccess {target=member.value}
    }
    if target isnt? none {
        let route=storage_route(target nodes)
        if route isnt? none {changed.push(route)}
    }
    if node is? hir.FunctionCall {
        loop binding in analysis.call_writes.get(id set[]) {changed.push(Entry[binding])}
    }
    if changed.length=?0 return
    loop entry in live.values {
        loop alias in roots(entry.binding analysis.aliases) {
            let view=analysis.required_views.get(alias)
            if view is? none continue
            let declaration=hir.node_at(nodes view)
            $runtime_assert declaration is? hir.Declare
            let borrowed=storage_route(declaration.expr nodes)
            if borrowed is? none continue
            loop write in changed {
                if borrowed.binding in? roots(write.binding analysis.aliases) and (under(borrowed.path write.path) or under(write.path borrowed.path)) {analysis.view_conflicts[id]=view}
            }
        }
    }
}
# A known index does not erase its evaluation. Visit selectors backwards
# without treating a component read as a read of the whole owner.
visit_selectors=(id:addr after:Live enabled:set<addr> @analysis:Analysis nodes:array<hir.AST> exits:array<LoopExit> table:types.Table):>Live=>{
    let node=hir.node_at(nodes id)
    let live=after
    loop node is? hir.MemberAccess|hir.Index {
        if node is? hir.Index {
            live=visit(node.index live enabled @analysis nodes table exits)
            node=hir.node_at(nodes node.array)
        } else {node=hir.node_at(nodes node.value)}
    }
    return live
}
visit=(id:addr after:Live enabled:set<addr> @analysis:Analysis nodes:array<hir.AST> table:types.Table exits:array<LoopExit>=[]):>Live=>{
    let node=hir.node_at(nodes id)
    let live=after
    check_view_writes(id live @analysis nodes)
    if node is? hir.ExpressedIdentifier {
        if node.binding_id isnt? none {
            consume(id Entry[node.binding_id] [] live enabled @analysis nodes table)
            add_entry(@live Entry[node.binding_id])
        }
        return live
    }
    if node is? hir.MemberAccess|hir.Index {
        let route=field_route(id nodes wildcards=true selectors=analysis.selectors)
        if route isnt? none {
            let region=field_route(id nodes allow_prefix=true)
            $runtime_assert region isnt? none
            consume(id route region.path live enabled @analysis nodes table)
            add_entry(@live route)
            return visit_selectors(id live.copy() enabled @analysis nodes exits table)
        }
    }
    if node is? hir.ArrayLength {
        let route=field_route(node.array nodes wildcards=true selectors=analysis.selectors)
        if route isnt? none {add_entry(@live Entry[route.binding route.path measure=true selectors=route.selectors]) return visit_selectors(node.array live.copy() enabled @analysis nodes exits table)}
    }
    if node is? hir.FunctionLiteral {
        loop binding in read_roots(id analysis.aliases nodes) {add_entry(@live Entry[binding])}
        return live
    }
    if node is? hir.Break|hir.Continue and node.loop_levels <? exits.length {
        let selected=exits.length-node.loop_levels-1
        $runtime_assert selected >=? 0 and selected <? exits.length
        let continuation=exits[selected]
        return if node is? hir.Break continuation.after.copy() else continuation.repeated.copy()
    }
    if node is? hir.Return {return if node.item is? none analysis.exit.copy else visit(node.item analysis.exit.copy analysis.owners.copy() @analysis nodes table exits)}
    if node is? hir.Flow {
        let following=if node.default is? none live.copy() else visit(node.default live.copy enabled @analysis nodes table exits)
        let index=node.arms.length
        loop index >? 0 {
            index-=1
            let arm=hir.node_at(nodes node.arms[index])
            $runtime_assert arm is? hir.IfArm|hir.LoopArm
            if arm is? hir.LoopArm {
                # Every advancing edge contributes to the condition's live
                # set. Reassignment supplies a new owner; a skipped assignment
                # through continue leaves the old one live on that backedge.
                let head=following.copy()
                loop true {
                    let nested=exits.copy
                    nested.push(LoopExit[live.copy() head.copy()])
                    let entering=visit(arm.body head.copy enabled @analysis nodes table nested)
                    merge(@entering following)
                    let next=visit(arm.condition entering enabled @analysis nodes table nested)
                    let before=head.length
                    merge(@head next)
                    if head.length=?before break
                }
                following=head
            } else {
                let taken=visit(arm.body live.copy enabled @analysis nodes table exits)
                merge(@following taken)
                following=visit(arm.condition following.copy() enabled @analysis nodes table exits)
            }
        }
        return following
    }
    if node is? hir.Assign and node.op=?'=' {
        let target=hir.node_at(nodes node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            let kept:Live=[]
            loop [key entry] in live {if entry.binding not=? target.binding_id {kept[key]=entry}}
            return visit(node.value kept enabled @analysis nodes table exits)
        }
    }
    if node is? hir.MemberAssign|hir.IndexAssign {
        let route=field_route(node.target nodes wildcards=true selectors=analysis.selectors)
        if route isnt? none {
            # The old component is dead; the store needs only its ancestors.
            let fixed=true
            loop step in route.path {if step=?-1 {fixed=false}}
            let kept:Live=[]
            loop [key entry] in live {if not fixed or entry.binding not=? route.binding or not under(entry.path route.path) {kept[key]=entry}}
            if fixed {kept=renew_siblings(kept node.target route nodes table)}
            add_entry(@kept Entry[route.binding route.path true selectors=route.selectors])
            let before=visit(node.value kept.copy enabled @analysis nodes table exits)
            return visit_selectors(node.target before enabled @analysis nodes exits table)
        }
    }
    if node is? hir.Declare and node.binding_id isnt? none {
        let kept:Live=[]
        loop [key entry] in live {if entry.binding not=? node.binding_id {kept[key]=entry}}
        live=kept
    }
    let children=hir.children(node)
    loop children.length >? 0 {live=visit(children.pop live.copy() enabled @analysis nodes table exits)}
    return live
}
# After a store to a fixed field path, a later whole read of an ancestor
# reads the new value there. Before the store it needs every other field on
# the way down, but not the replaced component's old value.
renew_siblings=(live:Live target:addr route:Entry nodes:array<hir.AST> table:types.Table):>Live=>{
    let inner:array<addr>=[]
    let step=target
    loop true {
        let current=hir.node_at(nodes step)
        if current isnt? hir.MemberAccess break
        inner.push(hir.node_at(nodes current.value).value_type)
        step=current.value
    }
    # An indexed step keeps the whole read.
    if inner.length not=? route.path.length return live.copy()
    # Owner types from the root down, matching the path.
    let owners:array<addr>=[]
    let index=inner.length
    loop index >? 0 {
        index-=1
        owners.push(inner[index])
    }
    let result:Live=[]
    loop [key entry] in live {
        if entry.binding not=? route.binding or entry.store or entry.measure or entry.path.length >=? route.path.length or not under(route.path entry.path) {result[key]=entry continue}
        let expanded:array<Entry>=[]
        let complete=true
        let level=entry.path.length
        loop level <? route.path.length and level <? owners.length {
            let record=types.node_at(table types.unfold(types.strip_refinement(owners[level] table) table))
            if record isnt? types.ObjectType {complete=false break}
            loop field in record.fields {
                if field.name =? route.path[level] continue
                let path:array<string|int64>=[]
                loop i in 0.. and i <? level {path.push(route.path[i])}
                path.push(field.name)
                expanded.push(Entry[route.binding path])
            }
            level+=1
        }
        if not complete {result[key]=entry continue}
        loop item in expanded {add_entry(@result item)}
    }
    return result
}
# `outliving` names place parameters among the owners: their components may
# transfer, and the caller reads each one whole when the function returns.
consumptions=(body:addr owners:set<addr> nodes:array<hir.AST> table:types.Table required_views:dict<addr addr>=[] call_writes:dict<addr set<addr>>=[] read_only_places:set<addr>=set[] selector_inputs:set<addr>=set[] selector_scopes:dict<addr set<addr>>=[] outliving:set<addr>=set[]):>Analysis=>{
    let analysis=Analysis[owners.copy() required_views=required_views.copy() call_writes=call_writes.copy() read_only_places=read_only_places.copy() selector_scopes=selector_scopes.copy()]
    loop binding in outliving {add_entry(@analysis.exit Entry[binding])}
    let order:array<addr>=[]
    let pending:array<addr>=[body]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(nodes id)
        order.push(id)
        if node is? hir.FunctionLiteral {
            loop binding in read_roots(id [] nodes) {analysis.captured.push(binding)}
            continue
        }
        if node is? hir.ExpressedIdentifier {analysis.occurrences[id]=analysis.occurrences.get(id 0)+1}
        if node is? hir.Declare and node.binding_id isnt? none and (node.binding_id in? owners or node.view) {
            let value=hir.node_at(nodes if node.view bindings.access_path(node.expr nodes dictionaries=true).root else node.expr)
            if value is? hir.ExpressedIdentifier and value.binding_id isnt? none {analysis.aliases[node.binding_id]=value.binding_id}
        }
        hir.push_children(node @pending)
    }
    let captured=analysis.captured.copy
    loop binding in captured {loop root in roots(binding analysis.aliases) {analysis.captured.push(root)}}
    let changed=predicate_effects.mutated_bindings(body nodes call_writes=call_writes)
    loop binding in selector_inputs {
        if binding not in? analysis.captured and binding not in? changed {analysis.selectors.push(binding)}
    }
    loop id in order {
        let node=hir.node_at(nodes id)
        let inputs:array<addr>=[]
        let scope=id
        if node is? hir.FunctionCall {
            inputs=node.pos_args.copy
            loop item in node.kw_args.values {inputs.push(item)}
        } else if node is? hir.ObjectLiteral {loop field in node.fields {inputs.push(field.value)}}
        else if node is? hir.ArrayLiteral {inputs=node.items.copy}
        else if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign {inputs.push(node.value)}
        else if node is? hir.DictStore and node.value isnt? none {inputs.push(node.value)}
        else if node is? hir.Declare {
            inputs.push(node.expr)
            if hir.node_at(nodes node.expr) is? hir.ExpressedIdentifier {analysis.declarations[node.expr]=id}
        } else if node is? hir.IfArm {inputs.push(node.body) scope=node.body}
        else if node is? hir.Flow and node.default isnt? none {inputs.push(node.default) scope=node.default}
        else if node is? hir.Block and not types.is_primitive(types.node_at(table node.value_type) 'void') {inputs=node.items.copy()}
        if inputs.length =? 0 continue
        let counts:dict<addr addr>=[]
        let reads:array<addr>=[scope]
        loop reads.length >? 0 {
            let read=hir.node_at(nodes reads.pop)
            if read is? hir.ExpressedIdentifier and read.binding_id isnt? none {
                loop root in roots(read.binding_id analysis.aliases) {counts[root]=counts.get(root 0)+1}
            }
            hir.push_children(read @reads)
        }
        loop input in inputs {
            let selected=input
            let value=hir.node_at(nodes selected)
            loop true {
                if value is? hir.ValueCast|hir.RepresentationCast {selected=value.expr}
                else if value is? hir.Obligation {selected=value.value}
                else {break}
                value=hir.node_at(nodes selected)
            }
            if value is? hir.ExpressedIdentifier and value.binding_id isnt? none and value.binding_id in? owners and value.binding_id not in? analysis.captured and analysis.occurrences.get(selected 0) =? 1 and counts.get(value.binding_id 0) =? 1 {analysis.candidates.push(selected)}
            if value is? hir.MemberAccess|hir.Index {
                # A field route of an owner; the caller decides which
                # component types may leave it.
                let route=field_route(selected nodes allow_prefix=true)
                let root=selected
                loop hir.node_at(nodes root) is? hir.MemberAccess|hir.Index {
                    let member=hir.node_at(nodes root)
                    $runtime_assert member is? hir.MemberAccess|hir.Index
                    root=if member is? hir.MemberAccess member.value else member.array
                }
                if route isnt? none and route.binding in? owners and route.binding not in? analysis.captured and analysis.occurrences.get(root 0) =? 1 {
                    # A selector may read siblings before this transfer.
                    # Overlapping operands still prevent a donation.
                    let own_reads:addr=0
                    let pending_reads:array<addr>=[selected]
                    loop pending_reads.length>?0 {
                        let read=hir.node_at(nodes pending_reads.pop)
                        if read is? hir.ExpressedIdentifier and read.binding_id isnt? none and route.binding in? roots(read.binding_id analysis.aliases) {own_reads+=1}
                        hir.push_children(read @pending_reads)
                    }
                    if counts.get(route.binding 0) =? own_reads or disjoint_inputs(scope selected route analysis.aliases nodes) {analysis.candidates.push(selected)}
                }
            }
        }
    }
    visit(body analysis.exit.copy owners @analysis nodes table);
    return analysis
}

from reporting import SrcFile, Error, Pointer
import p"../context.dewy" as contexts
import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"../type_queries.dewy" as views
import p"../bindings.dewy" as bindings
import p"../effect_rows.dewy" as rows
import p"../effect_inference.dewy" as inference
import p"../effect_boundaries.dewy" as effect_boundaries
import p"effects.dewy" as access
import p"../placement.dewy" as placement
import p"storage_borrows.dewy" as storage_borrows

# Public checking separates storage permissions from external reads/writes.
# Operations without a checked allocation or call model stay unknown.
# Recursion may be pure without terminating: $proof checks termination itself.
const SCALAR_OPERATIONS:set<string>=set['__add__' '__sub__' '__mul__' '__div__' '__floordiv__' '__mod__' '__unary_sub__' '__not__' '__eq__' '__ne__' '__lt__' '__le__' '__gt__' '__ge__' '__and__' '__or__' '__xor__' '__nand__' '__nor__' '__xnor__' '__lshift__' '__rshift__']
scalar = (id:addr nodes:types.Table):>bool => {
    let node=types.node_at(nodes types.strip_refinement(id nodes))
    if node is? types.IntegerLiteralType return node.value >=? -9223372036854775808 and node.value <? 18446744073709551616
    return node is? types.Primitive and node.name in? ['void' 'never' 'none' 'bool' 'true' 'false' 'int8' 'int16' 'int32' 'int64' 'uint8' 'uint16' 'uint32' 'uint64' 'float32' 'float64']
}
Input:type = const [nodes:array<hir.AST> types:types.Table registry:bindings.Registry analysis:access.Analysis storage_effects:access.ProgramEffects word_iterators:set<addr>=set[] borrowed_arguments:dict<addr set<addr>>=[]]
Call:type = const [source:rows.Contract subjects:dict<string rows.Subject?>]
Scan:type = [private:set<addr>=set[] places:dict<addr string>=[] summary:rows.Contract=rows.Contract[rows.Row[]] calls:array<Call>=[] words:set<addr>=set[] value_parameters:set<addr>=set[] frame_values:set<addr>=set[] frame_literals:set<addr>=set[]]
Location:type = const [known:bool subject:rows.Subject?=none]
word_iterator = (id:addr node:hir.IteratorExpression input:Input):>bool => {
    if hir.node_at(input.nodes node.iterable) isnt? hir.Range return false
    let target=hir.node_at(input.nodes node.target)
    let type=types.node_at(input.types types.strip_refinement(target.value_type input.types))
    if type isnt? types.Primitive or type.name not in? ['int' 'uint' 'int64' 'uint64'] return false
    if id in? input.word_iterators return true
    if node.count is? none return false
    let values:array<bigint>=[node.first node.step node.count]
    if node.last isnt? none {values.push(node.last)}
    loop value in values {if value <? -9223372036854775808 or value >? 9223372036854775807 return false}
    return true
}
word_value = (node:hir.AST input:Input scan:Scan):>bool => {
    if scalar(node.value_type input.types) return true
    if node isnt? hir.ExpressedIdentifier or node.binding_id is? none or node.binding_id not in? scan.words return false
    let type=types.node_at(input.types types.strip_refinement(node.value_type input.types))
    return type is? types.Primitive and type.name in? ['int' 'uint']
}
location = (id:addr input:Input scan:Scan):>Location => {
    let path=bindings.access_path(access.unwrap(id input.nodes) input.nodes dictionaries=true)
    loop step in path.steps {
        let node=hir.node_at(input.nodes step)
        if node is? hir.DictLookup {
            # Key lookup reads its dictionary, not merely a hidden values
            # field. Use that public receiver as the conservative subject.
            let keys=hir.node_at(input.nodes node.keys)
            return if keys is? hir.MemberAccess location(keys.value input scan) else Location[false]
        }
    }
    let root=hir.node_at(input.nodes path.root)
    if root is? hir.FunctionCall|hir.ObjectLiteral|hir.ArrayLiteral|hir.CopyValue|hir.Block|hir.Flow return Location[true]
    if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return Location[false]
    if root.binding_id in? scan.places {
        let fields:array<string>=[]
        loop step in path.steps {
            let node=hir.node_at(input.nodes step)
            if node is? hir.MemberAccess {fields.push(node.name)} else {fields.push('[]')}
        }
        return Location[true rows.Subject['parameter' scan.places[root.binding_id] fields]]
    }
    return Location[root.binding_id in? scan.private]
}
contribute = (contract:rows.Contract @scan:Scan):>void => {scan.summary=rows.join(scan.summary contract)}
unknown = (@scan:Scan):>void => {contribute(rows.Contract[] @scan)}
# Logical storage work includes copies even when COW defers the actual copy.
# Without placement/move evidence, aggregate boundaries need permission.
storage = (@scan:Scan):>void => {contribute(rows.Contract[rows.Row[[rows.Atom['allocates']]]] @scan)}
# A projected store and a mutating place call have the same storage demand.
projected_storage = (id:addr input:Input scan:Scan):>bool => {
    let path=bindings.access_path(access.unwrap(id input.nodes) input.nodes dictionaries=true)
    let root=hir.node_at(input.nodes path.root)
    if root is? hir.ExpressedIdentifier and root.binding_id isnt? none and root.binding_id in? scan.frame_values return false
    loop step in path.steps {if hir.node_at(input.nodes step) is? hir.Index|hir.DictLookup return true}
    return path.steps.length >? 0 and root is? hir.ExpressedIdentifier and root.binding_id isnt? none and root.binding_id in? scan.value_parameters
}
# Taking an array address evaluates selectors without reading its payload.
# Dictionary selection also reads keys and may prepare/detach entry storage.
# The callee supplies the effects of using the resulting address.
indices = (id:addr input:Input @scan:Scan):>void => {
    let path=bindings.access_path(access.unwrap(id input.nodes) input.nodes dictionaries=true)
    loop step in path.steps {
        let node=hir.node_at(input.nodes step)
        if node is? hir.Index {visit(node.index input @scan)}
        else if node is? hir.DictLookup {
            let keys=hir.node_at(input.nodes node.keys)
            if keys is? hir.MemberAccess {record_access(keys.value 'reads' input @scan)} else {unknown(@scan)}
            visit(node.key input @scan) storage(@scan)
        }
    }
}
record_access = (id:addr family:string input:Input @scan:Scan):>void => {
    let target=location(id input scan)
    if not target.known {unknown(@scan)}
    else if target.subject isnt? none {contribute(rows.Contract[rows.Row[[rows.Atom[family target.subject]]]] @scan)}
    indices(id input @scan)
    let path=bindings.access_path(access.unwrap(id input.nodes) input.nodes dictionaries=true)
    if hir.node_at(input.nodes path.root) isnt? hir.ExpressedIdentifier {visit(path.root input @scan)}
}
call_subjects = (call:hir.FunctionCall signature:types.FunctionType input:Input scan:Scan):>dict<string rows.Subject?> | none => {
    let supplied:dict<string rows.Subject?>=[]
    let params=signature.pos_or_kw
    loop parameter in signature.kw_only {params.push(types.PosOrKwArg[parameter.name parameter.value_type parameter.required parameter.place])}
    loop index in 0.. and index <? params.length {
        let parameter=params[index]
        if not parameter.place continue
        let argument:addr?=none
        if index <? call.pos_args.length {argument=call.pos_args[index]}
        else if parameter.name isnt? none {argument=call.kw_args.get(parameter.name)}
        if argument is? none return none
        let value=hir.node_at(input.nodes argument)
        if value isnt? hir.Place return none
        let target=location(value.target input scan)
        if not target.known return none
        supplied["{index}"]=target.subject
    }
    return supplied
}
# A sort key is called, not just evaluated as a function handle. Known
# bodies share ordinary call equations; an indirect key retains its written
# or inferred row. Sort passes a value, so no place-slot rebinding is needed.
callback=(id:addr input:Input @scan:Scan):>void=>{
    let targets=access.value_targets(id none input.analysis input.nodes)
    if targets isnt? none {
        loop target in targets {
            let literal=hir.node_at(input.nodes target)
            $runtime_assert literal is? hir.FunctionLiteral
            let places=false
            loop param in access.literal_params(literal) {if param.place {places=true}}
            if places {unknown(@scan)}
            else {contribute(rows.Contract[rows.Row[variables=[body_name(target)]]] @scan)}
        }
        return
    }
    let signature=types.node_at(input.types hir.node_at(input.nodes id).value_type)
    if signature is? types.FunctionType {
        loop param in signature.pos_or_kw {if param.place {unknown(@scan) return}}
        loop param in signature.kw_only {if param.place {unknown(@scan) return}}
        contribute(if signature.effects is? none rows.Contract[] else signature.effects @scan)
    } else {unknown(@scan)}
}
visit = (id:addr input:Input @scan:Scan):>void => {
    let node=hir.node_at(input.nodes id)
    if node is? hir.ValueCast and node.effect_target isnt? none {visit(node.expr input @scan) return}
    if node is? hir.FunctionLiteral return
    if node is? hir.Void|hir.NoneValue|hir.Bool|hir.Integer|hir.String|hir.Break|hir.Continue|hir.ScopeMetatag|hir.TypeValue return
    if node is? hir.ExpressedIdentifier and access.value_targets(id none input.analysis input.nodes) isnt? none return
    if node is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index {record_access(id 'reads' input @scan) return}
    if node is? hir.Assert and not node.runtime and not node.expect return
    if node is? hir.FunctionCall {
        if node.proof return
        let method=hir.node_at(input.nodes node.func)
        if method is? hir.ArrayMethod and method.name in? ['push' 'pop' 'insert' 'truncate' 'clear' 'reserve' 'join' 'sort'] {
            # Storage permission includes logical copies and COW detachments.
            # Sort callbacks contribute their distinct call boundary.
            record_access(method.array 'reads' input @scan)
            if method.name not=? 'join' {record_access(method.array 'mutates' input @scan)}
            storage(@scan)
            let key=node.kw_args.get('key')
            if method.name =? 'sort' and key isnt? none {callback(key input @scan)}
            loop arg in node.pos_args {visit(arg input @scan)}
            loop arg in node.kw_args.values {visit(arg input @scan)}
            return
        }
        let targets=access.direct_targets(node input.analysis input.nodes)
        let callee=hir.node_at(input.nodes node.func)
        let signature=types.node_at(input.types callee.value_type)
        let builtin=false
        if callee is? hir.ExpressedIdentifier {
            builtin=callee.binding_id is? none
            if callee.binding_id isnt? none {
                let binding=bindings.find_binding(input.registry callee.binding_id)
                builtin=binding isnt? none and binding.builtin
            }
        }
        let scalar_operation=callee is? hir.ExpressedIdentifier and builtin and callee.name in? SCALAR_OPERATIONS and scalar(node.value_type input.types)
        loop arg in node.pos_args {if not word_value(hir.node_at(input.nodes arg) input scan) {scalar_operation=false}}
        if targets isnt? none {
            # Known targets do not erase effects of evaluating the selector.
            visit(node.func input @scan)
            loop target in targets {
                let value=hir.node_at(input.nodes target)
                let shape=types.node_at(input.types value.value_type)
                if shape isnt? types.FunctionType {unknown(@scan) continue}
                let supplied=call_subjects(node shape input scan)
                if supplied is? none {unknown(@scan)}
                else {scan.calls.push(Call[rows.Contract[rows.Row[variables=[body_name(target)]]] supplied])}
            }
        }
        else if scalar_operation {}
        else if signature is? types.FunctionType {
            let supplied=call_subjects(node signature input scan)
            if supplied is? none {unknown(@scan)}
            else {scan.calls.push(Call[if signature.effects is? none rows.Contract[] else signature.effects supplied])}
            visit(node.func input @scan)
        }
        else {unknown(@scan)}
        let arguments=node.pos_args
        loop arg in node.kw_args.values {arguments.push(arg)}
        loop arg in arguments {
            let value=hir.node_at(input.nodes arg)
            if value is? hir.Place {
                indices(value.target input @scan)
                let target=location(value.target input scan)
                if target.known and target.subject is? none and scalar(hir.node_at(input.nodes value.target).value_type input.types) {
                    # Match lowering's escape proof for a private frame slot.
                    # Public callback permissions alone do not yet supply it.
                    let safe=targets isnt? none and targets.length >? 0
                    let writes=false
                    if targets isnt? none {
                        loop target_id in targets {
                            let target_node=hir.node_at(input.nodes target_id)
                            $runtime_assert target_node is? hir.FunctionLiteral
                            let pairs=access.pair_arguments(node target_node)
                            let summary:access.ParameterEffects?=none
                            if pairs isnt? none {
                                loop pair in pairs {
                                    if pair.argument =? arg and pair.parameter isnt? none {summary=input.storage_effects.by_param_binding.get(pair.parameter)}
                                }
                            }
                            if summary is? none or summary.escapes.length >? 0 {safe=false}
                            if summary isnt? none and access.writes(summary) {writes=true}
                        }
                    }
                    if not safe or (writes and projected_storage(value.target input scan)) {storage(@scan)}
                }
            }
            else {
                visit(arg input @scan)
                if not word_value(value input scan) and types.node_at(input.types value.value_type) isnt? types.CallableType and arg not in? input.borrowed_arguments.get(id set[]) {storage(@scan)}
            }
        }
        return
    }
    if node is? hir.DictLookup|hir.DictContains|hir.DictStore|hir.DictRemove {
        let keys=hir.node_at(input.nodes node.keys)
        if keys isnt? hir.MemberAccess {unknown(@scan) return}
        # One logical receiver; hidden keys/values are not two evaluations.
        record_access(keys.value 'reads' input @scan)
        if node is? hir.DictStore|hir.DictRemove {record_access(keys.value 'mutates' input @scan)}
        # Reads may rebuild the index; copies can invalidate cached positions.
        storage(@scan)
        if node is? hir.DictRemove {if node.key isnt? none {visit(node.key input @scan)}}
        else {visit(node.key input @scan)}
        if node is? hir.DictStore and node.value isnt? none {visit(node.value input @scan)}
        if node is? hir.DictLookup|hir.DictRemove {let fallback=node.default if fallback isnt? none {visit(fallback input @scan)}}
        return
    }
    if node is? hir.DictView|hir.DictEntries {
        record_access(node.dictionary 'reads' input @scan) storage(@scan) return
    }
    if node is? hir.SetAlgebra {
        visit(node.left input @scan) visit(node.right input @scan) storage(@scan) return
    }
    if node is? hir.Declare {
        let value=hir.node_at(input.nodes node.expr)
        # A required view has no copy fallback: lowering proves or rejects it.
        if not node.view and (node.binding_id is? none or node.binding_id not in? scan.frame_values) and not scalar(value.value_type input.types) and value isnt? hir.String|hir.FunctionLiteral and types.node_at(input.types value.value_type) isnt? types.FunctionType|types.OverloadType {storage(@scan)}
        visit(node.expr input @scan)
        return
    }
    if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign {
        let target=hir.node_at(input.nodes node.target)
        if (not scalar(target.value_type input.types) and types.node_at(input.types target.value_type) isnt? types.FunctionType|types.OverloadType) or projected_storage(node.target input scan) {storage(@scan)}
        record_access(node.target 'mutates' input @scan)
        if node is? hir.Assign and node.op not=? '=' {record_access(node.target 'reads' input @scan)}
        visit(node.value input @scan)
        return
    }
    if node is? hir.CopyValue|hir.ArrayLiteral|hir.ObjectLiteral {
        if id not in? scan.frame_literals and not scalar(node.value_type input.types) {storage(@scan)}
        loop child in hir.children(node) {visit(child input @scan)}
        return
    }
    if node is? hir.ValueCast|hir.RepresentationCast and views.string_valued(node.value_type input.types) and views.string_valued(hir.node_at(input.nodes node.expr).value_type input.types) {
        # Widening a stored string/literal preserves the text. Independent
        # value boundaries retain their ordinary storage permission.
        visit(node.expr input @scan) return
    }
    if node is? hir.ValueCast and types.same_type(views.structural_base(node.value_type input.types) views.structural_base(hir.node_at(input.nodes node.expr).value_type input.types) input.types) {
        # A proved refinement changes facts, not storage. Owning boundaries
        # still account for their copy/allocation demands.
        visit(node.expr input @scan) return
    }
    if node is? hir.ValueCast|hir.RepresentationCast and types.is_primitive(types.node_at(input.types views.structural_base(hir.node_at(input.nodes node.expr).value_type input.types)) 'none') {
        # The absent union arm has no payload. Lowering uses its shared static
        # tag cell; evaluating the source still contributes its own effects.
        visit(node.expr input @scan) return
    }
    if node is? hir.ValueCast|hir.RepresentationCast and not scalar(node.value_type input.types) {unknown(@scan) return}
    if node is? hir.IteratorExpression {
        if word_iterator(id node input) {
            loop child in hir.children(hir.node_at(input.nodes node.iterable)) {visit(child input @scan)}
        } else {
            let iterable=hir.node_at(input.nodes node.iterable)
            if types.node_at(input.types types.strip_refinement(iterable.value_type input.types)) is? types.ArrayType {storage(@scan)}
            else {unknown(@scan)}
            visit(node.iterable input @scan)
        }
        return
    }
    if node is? hir.Block|hir.Suppress|hir.Return|hir.Flow|hir.IfArm|hir.LoopArm|hir.OverloadedFunction|hir.ShortCircuit|hir.Obligation|hir.TypeTest|hir.ArrayLength|hir.StringLength|hir.ValueCast|hir.RepresentationCast|hir.Spread|hir.MultiIteratorExpression {
        loop child in hir.children(node) {visit(child input @scan)}
        return
    }
    unknown(@scan)
}
# The behavior inventory is independent of whether a source contract exists.
# Validation and omitted-row inference share this same checked call graph.
Inventory:type = const [bodies:dict<addr rows.Contract> projections:dict<string inference.Projection>]
body_name=(id:addr):>string=>"{inference.PREFIX}body:{id}"
inventory = (roots:array<addr> session:contexts.Session word_iterators:set<addr>=set[]):>Inventory => {
    let analysis=access.collect_roots(roots session.hir)
    let access_summaries=access.analyze_collected(analysis session.hir session.types)
    let frame_places=access.place_loans(analysis access_summaries session.hir session.types)
    let borrowed=storage_borrows.forwarded_values(analysis access_summaries session.hir session.types session.registry)
    let input=Input[session.hir session.types session.registry analysis access_summaries word_iterators borrowed]
    let local:dict<addr rows.Contract>=[]
    let projections:dict<string inference.Projection>=[]
    loop id in analysis.literals {
        let node=hir.node_at(session.hir id)
        $runtime_assert node is? hir.FunctionLiteral
        let scan=Scan[]
        loop [binding declaration_id] in placement.local_values(node session.hir session.types frame_places.nonescaping frame_places.fixed_storage borrowed) {
            let declaration=hir.node_at(session.hir declaration_id)
            $runtime_assert declaration is? hir.Declare
            scan.frame_values.add(binding)
            loop literal in placement.literal_storage(declaration.expr session.hir session.types) {scan.frame_literals.add(literal)}
        }
        if not scalar(node.rettype session.types) and types.node_at(session.types node.rettype) isnt? types.FunctionType|types.OverloadType {storage(@scan)}
        let params=access.literal_params(node)
        loop index in 0.. and index <? params.length {
            let param=params[index]
            if param.binding_id is? none continue
            if not param.place {scan.value_parameters.add(param.binding_id)}
            # The internal receiver place is the operated-on value, not an
            # external public-effect subject. Access summaries still track
            # its physical storage for ownership and alias checking.
            if param.place and not (index =? 0 and node.lifecycle isnt? none) {scan.places[param.binding_id]="{index}"}
            else {scan.private.add(param.binding_id)}
        }
        let pending:array<addr>=[node.body]
        loop pending.length >? 0 {
            let child=pending.pop
            let body=hir.node_at(session.hir child)
            if body is? hir.FunctionLiteral continue
            if body is? hir.Declare and body.binding_id isnt? none {scan.private.add(body.binding_id)}
            if body is? hir.IteratorExpression {
                let target=hir.node_at(session.hir body.target)
                if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
                    scan.private.add(target.binding_id)
                    if word_iterator(child body input) {scan.words.add(target.binding_id)}
                }
            }
            loop child in hir.children(body) {pending.push(child)}
        }
        visit(node.body input @scan)
        loop param in params {if param is? hir.BoundParam {visit(param.value input @scan)}}
        loop call in scan.calls {
            if call.subjects.length =? 0 {contribute(call.source @scan)}
            else {
                let name="{inference.PREFIX}call:{projections.length}"
                projections[name]=inference.Projection[call.source call.subjects]
                contribute(rows.Contract[rows.Row[variables=[name]]] @scan)
            }
        }
        local[id]=scan.summary
    }
    return Inventory[local projections]
}
summarize = (roots:array<addr> session:contexts.Session word_iterators:set<addr>=set[]):>dict<addr rows.Contract> => {
    let graph=inventory(roots session word_iterators)
    let definitions:dict<string rows.Contract>=[]
    loop [id body] in graph.bodies {definitions[body_name(id)]=body}
    let solutions=inference.solve_contracts(definitions projections=graph.projections)
    let summaries:dict<addr rows.Contract>=[]
    loop [id body] in graph.bodies {
        let name=body_name(id)
        $runtime_assert name in? solutions
        summaries[id]=solutions[name]
    }
    return summaries
}

validate = (roots:array<addr> source:SrcFile session:contexts.Session word_iterators:set<addr>=set[]):>Error? => {
    if not session.types.effect_contracts return none
    let constrained:array<addr>=[]
    let pending=roots
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=hir.node_at(session.hir id)
        loop child in hir.children(node) {pending.push(child)}
        if node is? hir.FunctionLiteral {
            let signature=types.node_at(session.types node.value_type)
            if signature is? types.FunctionType and signature.effects isnt? none {constrained.push(id)}
        }
    }
    if constrained.length =? 0 return none
    let written=false
    loop id in constrained {
        let signature=types.node_at(session.types hir.node_at(session.hir id).value_type)
        if signature is? types.FunctionType and signature.inferred_effect is? none {written=true}
    }
    let definitions:dict<string rows.Contract>=[]
    let bodies:array<addr>=[]
    let constraints:array<inference.Constraint>=[]
    let sites:array<addr>=[]
    loop id in seen {
        let node=hir.node_at(session.hir id)
        if node is? hir.FunctionLiteral {
            let signature=types.node_at(session.types node.value_type)
            if signature is? types.FunctionType and signature.inferred_effect isnt? none {
                bodies.push(id)
            }
        } else if node is? hir.ValueCast {
            let target=if node.effect_target is? none node.value_type else node.effect_target
            let signature=types.node_at(session.types target)
            if node.effect_target isnt? none and signature is? types.FunctionType and signature.effects isnt? none and signature.effects.allowed isnt? none {
                loop name in signature.effects.allowed.variables {
                    if name.startswith(inference.BINDING_PREFIX) and name not in? definitions {definitions[name]=rows.Contract[rows.Row[]]}
                }
            }
            loop edge in effect_boundaries.constraints(hir.node_at(session.hir node.expr).value_type target session.types) {
                constraints.push(edge) sites.push(id)
            }
        }
    }
    let required=false
    loop edge in constraints {
        if edge.required isnt? none and not rows.implies(none edge.required) and (not inference.pending(edge.required) or edge.required.excluded.length >? 0) {required=true}
    }
    if not written and not required return none
    let graph=inventory(roots session word_iterators)
    let summaries=graph.bodies
    loop [id body] in summaries {definitions[body_name(id)]=body}
    loop id in bodies {
        let signature=types.node_at(session.types hir.node_at(session.hir id).value_type)
        $runtime_assert signature is? types.FunctionType and signature.inferred_effect isnt? none and id in? summaries
        let name=signature.inferred_effect
        let body=rows.Contract[rows.Row[variables=[body_name(id)]]]
        definitions[name]=if name in? definitions rows.join(definitions[name] body) else body
    }
    # Written exclusions select candidates; they never become assignments to
    # a source callable's row. Their actual obligations are checked below.
    loop id in constrained {
        let signature=types.node_at(session.types hir.node_at(session.hir id).value_type)
        if signature is? types.FunctionType and signature.effects isnt? none and signature.effects.excluded.length >? 0 {
            constraints.push(inference.Constraint[none rows.Contract[excluded=signature.effects.excluded]])
        }
    }
    let solutions=inference.solve_contracts(definitions constraints graph.projections)
    loop i in 0.. and i <? constraints.length and i <? sites.length {
        if not inference.satisfied_contracts(constraints[i] solutions) {
            let node=hir.node_at(session.hir sites[i])
            return Error[srcfile=source title='callable does not satisfy its effect contract' pointers=[Pointer[span=node.loc message='the inferred callable behavior exceeds its destination contract']]]
        }
    }
    loop id in constrained {
        let node=hir.node_at(session.hir id)
        $runtime_assert node is? hir.FunctionLiteral
        let signature=types.node_at(session.types node.value_type)
        $runtime_assert signature is? types.FunctionType and signature.effects isnt? none
        $runtime_assert id in? summaries
        let name=body_name(id)
        $runtime_assert name in? solutions
        if not rows.implies(solutions[name] inference.resolve_contracts(signature.effects solutions)) {
            let src=source
            if node.source isnt? none {
                $runtime_assert node.source <? session.sources.length
                src=session.sources[node.source].srcfile
            }
            return Error[srcfile=src title='function does not satisfy its effect contract' pointers=[Pointer[span=node.loc message='an operation or callee may exceed the permitted effects or violate an exclusion']] hint='omit the row to infer conservatively, or remove the operation requiring effects']
        }
    }
    return none
}

from reporting import SrcFile, Error, Pointer, Warning, Span
import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"../bindings.dewy" as bindings
import p"../propositions.dewy" as propositions
import p"../type_queries.dewy" as views
import p"hir_facts.dewy" as expressions
import p"value_bounds.dewy" as values
import p"expression_intervals.dewy" as intervals
import p"predicate_facts.dewy" as predicates
import p"comparison_facts.dewy" as comparisons
import p"predicate_paths.dewy" as paths
import p"predicate_effects.dewy" as predicate_effects
import p"refinement_facts.dewy" as refinements
import p"binding_facts.dewy" as stores
import p"element_facts.dewy" as elements
import p"length_facts.dewy" as lengths
import p"length_proofs.dewy" as proofs
import p"term_facts.dewy" as terms
import p"fact_state.dewy" as facts
import p"relations.dewy" as relations
import p"intervals.dewy" as ranges
import p"obligations.dewy" as obligations
import p"index_checks.dewy" as indices
import p"slice_checks.dewy" as slices
import p"effects.dewy" as effects
import p"prototype_checks.dewy" as prototype
import p"../../timing.dewy" as timing

# The visitor owns evaluation order; the smaller modules own individual
# transfer and proof rules. Loop iterations compute evidence without issuing
# diagnostics, then the stabilized body is checked once. Neither successful
# typechecking nor an exploratory transfer discharges an obligation.
Unfit:type = const [interval:ranges.Interval? word:string]
Exit:type = const [levels:addr state:facts.State]
Transfer:type = [normal:facts.State? breaks:array<Exit>=[] continues:array<Exit>=[]]
Checker:type = [
    data:predicates.Data srcfile:SrcFile word_type:addr
    # `--timings`: report functions whose checking takes 20 ms or more.
    timings:bool=false
    source_files:array<SrcFile>=[]
    # The HIR/type environment and default word do not change during this
    # module's validation. Build their refinement view once, not per binding
    # or function; only current facts and the route registry evolve.
    refinement_context:refinements.Context=refinements.Context[data.env word_type]
    path_context:paths.Context=paths.Context[data.env.nodes data.relations.facts]
    proof_context:proofs.Context=proofs.Context[data.env data.relations]
    declared:refinements.Declared=[] assigned:set<addr>=set[]
    mutable_globals:set<addr>=set[] call_writes:dict<addr set<addr>>=[] checked:set<addr>=set[]
    root_items:set<addr>=set[] deferred:array<addr>=[]
    read_only_places:set<addr>=set[]
    element_intervals:values.ElementIntervals=[]
    unfit:dict<addr Unfit>=[] constant_indices:dict<addr bigint>=[] checked_indices:set<addr>=set[] problem:Error?=none
    warnings:array<Warning>=[] word_iterators:set<addr>=set[]
    # `$prototype`: unproven sites become runtime checks instead of errors.
    prototype:bool=false deferred_sites:dict<addr prototype.Deferred>=[]
    result_obligations:dict<addr array<addr>>=[]
    # Nested finite-loop exploration shares a budget. On exhaustion the
    # ordinary widening path remains sound, though less precise.
    finite_loop_budget:bigint=64
    loop_qualifier_pairs:dict<addr array<facts.TermPair>>=[]
    container_receivers:set<addr>=set[]
]
# Construct the same declared-width environment for every invocation. Tests
# and module drivers must not quietly use different loop-widening contracts.
# Immutable declaration facts belong to the program, not to a module's flow
# state. The driver prepares these once while the checked graph is frozen.
prepare = (env:values.Environment):>facts.Context => {
    let context=facts.Context[env.cap element_roots=elements.roots(env.registry)]
    loop [page_id page] in env.registry.binding_pages {
        loop id in page.keys {
            let interval=values.type_interval(id env)
            if interval isnt? none {context.widths[id]=interval}
        }
    }
    loop id in env.registry.current_bindings.keys {
        let interval=values.type_interval(id env)
        if interval isnt? none {context.widths[id]=interval}
    }
    return context
}
configure = (@checker:Checker prepared:facts.Context?=none):>void => {
    let context=if prepared is? none prepare(checker.data.env) else prepared
    checker.data.relations=relations.Context[context]
    checker.path_context=paths.Context[checker.data.env.nodes context]
    checker.proof_context=proofs.Context[checker.data.env checker.data.relations]
}
node_at = (id:addr checker:Checker):>hir.AST => hir.node_at(checker.data.env.nodes id)
# Element routes allocated during validation join the vacuous-fact roots
# (the hosted rule reads the registry live), including the path context's copy.
note_element_routes = (array:addr @checker:Checker):>void => {
    let known=checker.data.relations.facts.element_roots
    let before=known.length
    elements.note_roots(array @known checker.data.registry)
    if known.length =? before return
    checker.data.relations=relations.with_element_roots(checker.data.relations known)
    checker.path_context=paths.Context[checker.data.env.nodes checker.data.relations.facts checker.call_writes]
}
fail = (id:addr title:string message:string @checker:Checker hint:string=''):>void => {
    if checker.problem isnt? none return
    checker.problem=Error[srcfile=checker.srcfile title=title pointers=[Pointer[span=node_at(id checker).loc message=message]] hint=hint]
}
record = (id:addr @state:facts.State @checker:Checker):>void => {
    let exact=intervals.exact_length(node_at(id checker).value_type checker.data.env)
    if exact isnt? none {
        let sequence=terms.sequence_id(id checker.data.env @checker.data.registry)
        if sequence isnt? none {facts.set_value(@state facts.Term[sequence 'length'] ranges.exact(exact))}
    }
    intervals.record(@checker.data.snapshot id state checker.data.env @checker.data.registry)
    let node=node_at(id checker)
    if node isnt? hir.FunctionCall or not types.is_primitive(types.node_at(checker.data.env.types node.value_type) 'bool') return
    let function=node_at(node.func checker)
    if function isnt? hir.ExpressedIdentifier return
    if function.binding_id isnt? none and not bindings.builtin_binding(checker.data.registry function.binding_id) return
    # The snapshot keeps observed values and only still-live term identities.
    # Do not replay argument evaluation merely to decide the result value.
    let decided:bool?=none
    if function.name in? predicates.operators and node.pos_args.length=?2 {
        const op=predicates.operators[function.name]
        let left=predicates.operand(node.pos_args[0] state checker.data)
        let right=predicates.operand(node.pos_args[1] state checker.data)
        decided=ranges.decide(op left.interval right.interval)
        if decided is? none {decided=comparisons.decide_order(op left right state checker.data.relations)}
    } else if function.name=?'__not__' and node.pos_args.length=?1 {
        let value=checker.data.snapshot.numbers.get(node.pos_args[0])
        if value isnt? none and value.lower isnt? none and ranges.same_endpoint(value.lower value.upper) and (value.lower=?0 or value.lower=?1) {decided=value.lower=?0}
    }
    if decided isnt? none {checker.data.snapshot.numbers[id]=ranges.exact(if decided 1 else 0)}
}
refine = (state:facts.State id:addr truth:bool @checker:Checker):>facts.State? => predicates.refine_with_context(state id truth checker.path_context @checker.data)
joined = (states:array<facts.State> checker:Checker):>facts.State? => {
    if states.length =? 0 return none
    return facts.join(states checker.data.relations.facts)
}
append_exits = (@target:Transfer source:Transfer):>void => {
    loop exit in source.breaks {target.breaks.push(exit)}
    loop exit in source.continues {target.continues.push(exit)}
}
install = (@state:facts.State subject:addr value:addr annotation:addr? loc:Span @checker:Checker):>void => {
    stores.install(@state subject value annotation checker.word_type loc @checker.declared @checker.data context=checker.refinement_context)
    if obligations.nonzero(value checker.data.snapshot.numbers.get(value) state checker.data) {facts.put(@state facts.nonzero(subject) ranges.exact(1))}
}

# A child write changes the containing value's mathematical meaning (a BigInt
# is no longer the same integer after writing a limb), while unrelated field
# and length evidence remains useful.
forget_value = (id:addr @state:facts.State @checker:Checker keep_length:addr?=none):>void => {
    let path=bindings.access_path(id checker.data.env.nodes facts=true dictionaries=true)
    let root=node_at(path.root checker)
    if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {
        # Any component write may replace/move an indexed child. Keep pure
        # field routes, but discard indexed descendants and their evidence.
        loop route in checker.data.registry.routes_by_root.get(root.binding_id []) {
            let indexed=false
            loop part in route.path {if part.startswith('[') {indexed=true break}}
            if indexed {stores.forget(@state route.id @checker.data keep_length=keep_length)}
        }
    }
    let ids:array<addr>=[path.root]
    loop step in path.steps {
        ids.push(step)
        let node=node_at(step checker)
        if node is? hir.Index {
            let array=terms.sequence_id(node.array checker.data.env @checker.data.registry)
            if array isnt? none {stores.forget(@state array @checker.data prefix=['*'])}
        }
    }
    loop value in ids {
        let term=terms.binding_term(value checker.data.env @checker.data.registry)
        if term isnt? none {facts.forget(@state term)}
    }
}
forget_place = (id:addr @state:facts.State @checker:Checker):>void => {
    # Mutation reaches the endpoint, not the whole containing record.
    # Retain parent lengths and sibling fields, but discard element facts.
    forget_value(id @state @checker)
    let access=bindings.access_path(id checker.data.env.nodes facts=true dictionaries=true)
    loop step in access.steps {
        let node=node_at(step checker)
        if node is? hir.Index {
            let array=terms.sequence_id(node.array checker.data.env @checker.data.registry)
            if array isnt? none {
                loop route in checker.data.registry.routes_by_root.get(array []) {stores.forget(@state route.id @checker.data)}
            }
        }
    }
    let endpoint=bindings.array_route_id(id checker.data.env.nodes @checker.data.registry)
    if endpoint isnt? none {
        let route=bindings.route_at(checker.data.registry endpoint)
        let root=node_at(access.root checker)
        if route isnt? none and root is? hir.ExpressedIdentifier and root.binding_id isnt? none {stores.forget(@state root.binding_id @checker.data prefix=route.path)}
        stores.forget(@state endpoint @checker.data)
    }
}

validate_assert = (id:addr node:hir.Assert state:facts.State @checker:Checker):>void => {
    if refine(state node.condition false @checker) is? none return
    let refuted=refine(state node.condition true @checker) is? none
    if (node.runtime or node.unsafe) and not refuted return
    let message=if node.message isnt? none node.message else if refuted 'this condition is false for every value the analysis admits' else 'no compile-time fact establishes this condition (neither proven nor refuted)'
    if node.expect {
        checker.warnings.push(Warning[srcfile=checker.srcfile title='expectation refuted at compile time' pointers=[Pointer[span=node_at(node.condition checker).loc message=message]] hint='the test will fail when it runs'])
        return
    }
    fail(node.condition (if refuted 'assertion refuted' else 'cannot prove assertion') message @checker hint=if refuted '' else 'check it at runtime with `$runtime_assert`, or establish the fact with a guard')
}

# Expression-valued branches bind their result on each live path before the
# join. This retains `let n = if p 1 else 2` and relations common to both
# values, without inventing an expression that re-executes either branch.
value_body = (id:addr @state:facts.State @checker:Checker validate:bool):>void => {
    let node=node_at(id checker)
    if node is? hir.Block {
        loop index in 0.. and index <? node.items.length {
            let item=node.items[index]
            let required:array<addr>=if index+1 =? node.items.length checker.result_obligations.get(id []) else []
            let transfer=analyze_result(item state required @checker validate)
            if transfer.normal is? none return
            state=transfer.normal
        }
        if node.items.length >? 0 {
            let last=node.items[node.items.length-1]
            let interval=checker.data.snapshot.numbers.get(last)
            let length=checker.data.snapshot.lengths.get(last)
            if interval isnt? none {checker.data.snapshot.numbers[id]=interval}
            if length isnt? none {checker.data.snapshot.lengths[id]=length}
        }
        return
    }
    evaluate(id @state @checker validate)
}

analyze = (id:addr state:facts.State @checker:Checker validate:bool):>Transfer => {
    let node=node_at(id checker)
    let current=state
    if node is? hir.Block {
        let output=Transfer[current]
        let locals:set<addr>=set[]
        loop index in 0.. and index <? node.items.length {
            let item=node.items[index]
            if output.normal is? none break
            let declared=node_at(item checker)
            if declared is? hir.Declare and declared.binding_id isnt? none {locals.add(declared.binding_id)}
            let required:array<addr>=if index+1 =? node.items.length checker.result_obligations.get(id []) else []
            let transfer=analyze_result(item output.normal required @checker validate)
            output.normal=transfer.normal
            append_exits(@output transfer)
        }
        if node.scoped and output.normal isnt? none {
            let remaining=output.normal
            loop local in locals {stores.forget(@remaining local @checker.data)}
            output.normal=remaining
        }
        if node.scoped {
            let breaks:array<Exit>=[]
            let continues:array<Exit>=[]
            loop exit in output.breaks {
                let remaining=exit.state
                loop local in locals {stores.forget(@remaining local @checker.data)}
                breaks.push(Exit[exit.levels remaining])
            }
            loop exit in output.continues {
                let remaining=exit.state
                loop local in locals {stores.forget(@remaining local @checker.data)}
                continues.push(Exit[exit.levels remaining])
            }
            output.breaks=breaks output.continues=continues
        }
        return output
    }
    if node is? hir.Break return Transfer[none breaks=[Exit[node.loop_levels current]]]
    if node is? hir.Continue return Transfer[none continues=[Exit[node.loop_levels current]]]
    if node is? hir.Flow return flow(id node current @checker validate)
    if node is? hir.Declare {
        let value=node_at(node.expr checker)
        if id in? checker.root_items and value is? hir.FunctionLiteral|hir.OverloadedFunction {
            if value is? hir.FunctionLiteral {checker.deferred.push(node.expr)}
            else {loop alternate in value.alternates {if node_at(alternate checker) is? hir.FunctionLiteral {checker.deferred.push(alternate)}}}
            return Transfer[current]
        }
        let flow_id=value_flow_of(node.expr checker)
        if flow_id isnt? none and node.binding_id isnt? none return bind_conditional(id flow_id current @checker validate)
        evaluate(node.expr @current @checker validate)
        declare_value(node node.expr @current @checker)
        return Transfer[current]
    }
    if node is? hir.Assign {
        let target=node_at(node.target checker)
        $runtime_assert target is? hir.ExpressedIdentifier
        let flow_id=if node.op =? '=' value_flow_of(node.value checker) else none
        if flow_id isnt? none and target.binding_id isnt? none return bind_conditional(id flow_id current @checker validate)
        evaluate(node.value @current @checker validate)
        assign_value(node node.value @current @checker)
        return Transfer[current]
    }
    if node is? hir.Assert {
        evaluate(node.condition @current @checker validate)
        if validate {validate_assert(id node current @checker)}
        if not node.runtime {
            let held=refine(current node.condition true @checker)
            if held isnt? none {current=held}
        }
        return Transfer[current]
    }
    if node is? hir.Return {
        if node.item isnt? none {evaluate(node.item @current @checker validate)}
        return Transfer[none]
    }
    evaluate(id @current @checker validate)
    if types.is_primitive(types.node_at(checker.data.env.types node.value_type) 'never') return Transfer[none]
    return Transfer[current]
}

function_body = (id:addr node:hir.FunctionLiteral state:facts.State @checker:Checker validate:bool):>void => {
    if id in? checker.checked return
    # Exploratory loop passes must not mark a body validated.
    if validate {checker.checked.add(id)}
    let prototype=checker.prototype
    if node.proof {checker.prototype=false}
    let enclosing=state
    let globals=checker.mutable_globals
    loop global in globals {stores.forget(@enclosing global @checker.data)}
    let saved=checker.data.snapshot
    checker.data.snapshot=intervals.Snapshot[]
    let source=checker.srcfile
    if node.source isnt? none {checker.srcfile=hir.source_at(node.source checker.source_files)}
    let parameters=node.pos_or_kw_args
    loop parameter in node.kw_only_args {parameters.push(parameter)}
    if node.rest_args isnt? none {parameters.push(node.rest_args)}
    loop parameter in parameters {if parameter is? hir.BoundParam {evaluate(parameter.value @enclosing @checker validate)}}
    refinements.seed_parameters(@enclosing @checker.declared node checker.refinement_context @checker.data.registry)
    analyze(node.body enclosing @checker validate);
    checker.srcfile=source
    checker.data.snapshot=saved
    checker.prototype=prototype
}

array_call = (id:addr call:hir.FunctionCall method:hir.ArrayMethod @state:facts.State @checker:Checker validate:bool):>void => {
    evaluate(method.array @state @checker validate)
    loop argument in call.pos_args {evaluate(argument @state @checker validate)}
    loop argument in call.kw_args.values {evaluate(argument @state @checker validate)}
    let sequence=terms.sequence_id(method.array checker.data.env @checker.data.registry)
    if sequence is? none return
    let index:addr?=none
    if method.name in? ['pop' 'truncate'] {
        index=if call.pos_args.length >? 0 call.pos_args[0] else call.kw_args.get(if method.name =? 'pop' 'idx' else 'count')
    } else if method.name =? 'insert' {index=if call.pos_args.length >? 1 call.pos_args[1] else call.kw_args.get('idx')}
    let count:ranges.Interval?=none
    if index isnt? none {count=checker.data.snapshot.numbers.get(index)}
    let previous=facts.lookup(state facts.value(facts.Term[sequence 'length']))
    let before=if previous is? none values.length_default(checker.data.env.cap) else previous
    if validate and method.name =? 'pop' and index is? none and (before.lower is? none or before.lower <? 1) {
        fail(id 'cannot prove the array is non-empty' '`pop` needs a proven positive length on every reachable iteration' @checker)
        return
    }
    if validate and index isnt? none and method.name in? ['pop' 'insert'] {
        let error=indices.check_method_index(method.name index count state sequence before method.name =? 'insert' checker.proof_context checker.data.snapshot.numbers checker.srcfile @checker.data.registry symbolic=intervals.stable(index checker.data.snapshot checker.data.env.nodes))
        if error isnt? none {checker.problem=error}
    }
    # min(old_length, count) has a relational result even when both
    # values are dynamic. Capture the evidence before changing length.
    let cap_term:facts.Term?=none
    let fits=false
    let unchanged=false
    let length=facts.Term[sequence 'length']
    if method.name =? 'truncate' and index isnt? none {
        cap_term=terms.binding_term(index checker.data.env @checker.data.registry)
        if cap_term isnt? none {
            fits=relations.ordered(cap_term length 0 state checker.data.relations)
            unchanged=relations.ordered(length cap_term 0 state checker.data.relations)
        }
        if count isnt? none {
            fits=fits or (count.upper isnt? none and before.lower isnt? none and count.upper <=? before.lower)
            unchanged=unchanged or (count.lower isnt? none and before.upper isnt? none and before.upper <=? count.lower)
        }
    }
    if validate and method.name =? 'truncate' and not unchanged and (count is? none or count.lower is? none or count.lower <? 0) {fail(id 'truncate length is not proven nonnegative' 'the count may be negative' @checker)}
    if method.name in? ['push' 'insert'] {
        let value=if call.pos_args.length >? 0 call.pos_args[0] else call.kw_args.get('value')
        if value isnt? none {elements.store(@state sequence value checker.word_type call.loc checker.data.env @checker.data.registry) note_element_routes(sequence @checker)}
    }
    if method.name in? ['push' 'insert' 'pop' 'truncate' 'clear'] {
        let name:lengths.Method=if method.name =? 'push' 'push' else if method.name =? 'insert' 'insert' else if method.name =? 'pop' 'pop' else if method.name =? 'truncate' 'truncate' else 'clear'
        intervals.forget(@checker.data.snapshot sequence)
        let after=lengths.apply(@state sequence name count checker.data.env.cap unchanged=unchanged fits=fits)
        if cap_term isnt? none and not facts.same_term(cap_term length) {
            facts.put(@state facts.order(length cap_term) ranges.Interval[0 none])
            if fits {facts.put(@state facts.order(cap_term length) ranges.Interval[0 none])}
        }
        checker.data.snapshot.lengths[method.array]=after
        if validate {length_contract(id method array=sequence after=after state=state @checker)}
    }
    if method.name in? ['push' 'insert' 'pop' 'truncate' 'clear' 'sort' 'reverse'] {forget_value(method.array @state @checker keep_length=sequence)}
}
length_contract = (id:addr method:hir.ArrayMethod array:addr after:ranges.Interval state:facts.State @checker:Checker):>void => {
    let conditions=expressions.member_invariant(method.array checker.data.env.nodes checker.data.env.types)
    let declared=checker.declared.get(array)
    if declared isnt? none {loop p in declared.propositions {conditions.push(p)}}
    # Selecting an optional array payload preserves its storage contract.
    let binding=bindings.find_binding(checker.data.registry array)
    if binding isnt? none and binding.store_type isnt? none {
        let storage=types.node_at(checker.data.env.types binding.store_type)
        if storage is? types.TypeOr {
            loop member in storage.items {
                let alternative=types.node_at(checker.data.env.types member)
                if alternative is? types.RefinedType and types.node_at(checker.data.env.types alternative.base) is? types.ArrayType {
                    loop p in alternative.propositions {conditions.push(p)}
                }
            }
        }
    }
    loop p in conditions {
        if p.subject not=? 'length' continue
        if obligations.verdict(p method.array state checker.assigned @checker.data) not=? true {
            fail(id 'cannot prove the array keeps its declared length' "`{method.name}` may leave a length that does not satisfy `{obligations.describe(p)}`" @checker hint='guard the operation or declare storage without that length fact')
            return
        }
    }
}

# A contract on an expression-valued branch belongs to each live result,
# before joining away its guard. For `min(a b)`, each branch proves both
# inequalities with its own returned operand. No condition or body is replayed.
attach_result_obligation = (id:addr refined:addr @checker:Checker):>void => {
    let node=node_at(id checker)
    if types.is_primitive(types.node_at(checker.data.env.types node.value_type) 'never') return
    let required=checker.result_obligations.get(id [])
    if refined not in? required {required.push(refined)}
    checker.result_obligations[id]=required
}
# Install only around evaluation of the selected result, not its condition
# or preceding statements. Shared HIR leaves may also occur in those places.
analyze_result = (id:addr state:facts.State required:array<addr> @checker:Checker validate:bool):>Transfer => {
    if not validate or required.length =? 0 return analyze(id state @checker validate)
    let previous=checker.result_obligations
    loop refined in required {attach_result_obligation(id refined @checker)}
    let result=analyze(id state @checker validate)
    checker.result_obligations=previous
    return result
}
# Hidden key/value arrays share one receiver evaluation. Mutating operations
# need that selected place to survive every selector and later argument.
dictionary_children=(node:hir.DictLookup|hir.DictContains|hir.DictStore|hir.DictRemove @checker:Checker validate:bool):>array<addr>=>{
    let keys=node_at(node.keys checker)
    if keys isnt? hir.MemberAccess return hir.children(node)
    let arguments:array<addr>=[]
    let key=node.key
    if key isnt? none {arguments.push(key)}
    if node is? hir.DictStore {let value=node.value if value isnt? none {arguments.push(value)}}
    if node is? hir.DictLookup|hir.DictRemove {let fallback=node.default if fallback isnt? none {arguments.push(fallback)}}
    if validate and node is? hir.DictStore|hir.DictRemove {
        let access=bindings.access_path(keys.value checker.data.env.nodes dictionaries=true)
        let root=node_at(access.root checker)
        let indexed=false
        loop step in access.steps {if node_at(step checker) is? hir.Index|hir.DictLookup {indexed=true}}
        if indexed and root is? hir.ExpressedIdentifier and root.binding_id isnt? none {
            let selected=arguments
            loop step in access.steps {
                let selector=node_at(step checker)
                if selector is? hir.Index {selected.push(selector.index)}
                else if selector is? hir.DictLookup {selected.push(selector.key)}
            }
            loop value in selected {
                if root.binding_id in? predicate_effects.mutated_bindings(value checker.data.env.nodes checker.call_writes checker.read_only_places) {
                    fail(value 'container receiver changes during evaluation' 'the selected storage must survive its selectors and arguments' @checker)
                    break
                }
            }
        }
    }
    return [keys.value arguments...]
}
evaluate = (id:addr @state:facts.State @checker:Checker validate:bool):>void => {
    let node=node_at(id checker)
    let prototype=checker.prototype
    if node is? hir.FunctionCall and node.proof {checker.prototype=false}
    evaluate_checked(id @state @checker validate)
    checker.prototype=prototype
}
evaluate_checked = (id:addr @state:facts.State @checker:Checker validate:bool):>void => {
    let node=node_at(id checker)
    if node is? hir.Obligation {
        let previous=checker.result_obligations
        if validate {
            attach_result_obligation(node.value node.refined @checker)
            loop required in previous.get(id []) {attach_result_obligation(node.value required @checker)}
        }
        evaluate(node.value @state @checker validate)
        record(id @state @checker)
        checker.result_obligations=previous
    } else {evaluate_inner(id @state @checker validate)}
    if not validate or checker.problem isnt? none or node is? hir.Block|hir.Flow|hir.Obligation return
    let required=checker.result_obligations.get(id [])
    loop refined in required {
        let obligation=hir.Obligation[node.loc node.value_type id refined 'result contract']
        let error=obligations.check(obligation state checker.assigned checker.srcfile checker.path_context @checker.data)
        if error isnt? none {
            if checker.prototype and id not in? checker.deferred_sites {checker.deferred_sites[id]=prototype.Deferred['obligation' error refined] continue}
            checker.problem=error return
        }
    }
}

# A declaration's binding takes an (already evaluated) value with its facts.
declare_value = (node:hir.Declare value:addr @current:facts.State @checker:Checker):>void => {
    if node.binding_id is? none return
    # Save the observed value before removing last iteration's slot.
    stores.forget(@current node.binding_id @checker.data)
    install(@current node.binding_id value node.annotation node.loc @checker)
    if node.binding_id not in? checker.assigned {values.record_elements(@checker.element_intervals node.binding_id value checker.data.env)}
}
assign_value = (node:hir.Assign value:addr @current:facts.State @checker:Checker):>void => {
    let target=node_at(node.target checker)
    $runtime_assert target is? hir.ExpressedIdentifier
    if target.binding_id is? none return
    let subject=target.binding_id
    let interval=checker.data.snapshot.numbers.get(value)
    let rebound=hir.Assign[node.loc node.value_type node.target node.op value]
    let shift=terms.assignment_shift(rebound checker.data.env @checker.data.registry)
    let shifted:facts.State=facts.State[]
    if shift isnt? none {
        # Preserve affine facts only if the update cannot roll over, including
        # a narrow arithmetic expression widened into a wider destination.
        let before=relations.narrowed_interval(facts.Term[subject] current checker.data.relations)
        let mathematical=ranges.add(before ranges.exact(shift))
        let exact=ranges.fits(mathematical values.fixed_bounds(target.value_type checker.data.env.types)) isnt? none
        if node.op =? '=' {
            let operation=node_at(expressions.strip_casts(value checker.data.env.nodes) checker)
            exact=exact and ranges.fits(mathematical values.fixed_bounds(operation.value_type checker.data.env.types)) isnt? none
        }
        if exact {shifted=facts.shifted(current facts.Term[subject] shift)}
    }
    if node.op in? ['+=' '-='] {interval=values.binary(if node.op =? '+=' '__add__' else '__sub__' facts.lookup(current facts.value(facts.Term[subject])) interval target.value_type checker.data.env.types)}
    else if node.op not=? '=' {interval=none}
    stores.forget(@current subject @checker.data)
    facts.set_value(@current facts.Term[subject] interval)
    loop entry in shifted.values {facts.put(@current entry.fact entry.interval)}
    if node.op =? '=' {
        let length=checker.data.snapshot.lengths.get(value)
        if length isnt? none {facts.set_value(@current facts.Term[subject 'length'] length)}
        if shift is? none {stores.seed(@current subject value checker.word_type node.loc @checker.data)}
    }
    let declared=checker.declared.get(subject)
    if declared isnt? none {refinements.seed_binding(@current @checker.declared subject declared checker.refinement_context node.loc @checker.data.registry)}
}
# A value conditional an expression is (through casts and a wrapping
# block): `if p a else b` with a value type and no loop arms.
value_flow_of = (id:addr checker:Checker):>addr? => {
    let current=expressions.strip_casts(id checker.data.env.nodes)
    loop true {
        let node=node_at(current checker)
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=expressions.strip_casts(node.items[0] checker.data.env.nodes) continue}
        if node isnt? hir.Flow return none
        let type=types.node_at(checker.data.env.types node.value_type)
        if types.is_primitive(type 'void') or types.is_primitive(type 'never') return none
        loop arm_id in node.arms {if node_at(arm_id checker) is? hir.LoopArm return none}
        return current
    }
}
# `let c = if p a else b` (or `c = ...`) analyzed as the statement form
# `if p { c = a } else { c = b }`, as the hosted `_bind_conditional`: under
# each arm's condition the binding takes that arm's value *with its facts*
# (`c = src.length` copies the length's, `c = k` under a failed
# `src.length <? k` keeps `c <=? src.length`), and the arms join as states;
# a value conditional evaluated as an expression would keep only the union
# of the arms' intervals.
bind_conditional = (id:addr flow_id:addr state:facts.State @checker:Checker validate:bool):>Transfer => {
    let flow=node_at(flow_id checker)
    $runtime_assert flow is? hir.Flow
    let remaining:facts.State?=state
    let exits:array<facts.State>=[]
    let output=Transfer[none]
    loop arm_id in flow.arms {
        if remaining is? none break
        let arm=node_at(arm_id checker)
        $runtime_assert arm is? hir.IfArm
        let current=remaining
        evaluate(arm.condition @current @checker validate)
        let positive=refine(current arm.condition true @checker)
        remaining=refine(current arm.condition false @checker)
        if positive isnt? none {
            let bound=bind_arm(id arm.body positive @checker validate)
            append_exits(@output bound)
            if bound.normal isnt? none {exits.push(bound.normal)}
        }
    }
    if remaining isnt? none {
        if flow.default isnt? none {
            let bound=bind_arm(id flow.default remaining @checker validate)
            append_exits(@output bound)
            if bound.normal isnt? none {exits.push(bound.normal)}
        } else {exits.push(remaining)}
    }
    output.normal=if exits.length =? 0 state else joined(exits checker)
    return output
}
bind_arm = (id:addr body_id:addr arm_state:facts.State @checker:Checker validate:bool):>Transfer => {
    let output=Transfer[arm_state]
    let value=body_id
    let locals:set<addr>=set[]
    let body=node_at(body_id checker)
    if body is? hir.Block and body.items.length >? 0 {
        loop index in 0.. and index <? body.items.length {
            if index + 1 =? body.items.length break
            let item=body.items[index]
            let declared=node_at(item checker)
            if declared is? hir.Declare and declared.binding_id isnt? none {locals.add(declared.binding_id)}
            let current=output.normal
            if current is? none break
            let transfer=analyze(item current @checker validate)
            output.normal=transfer.normal
            append_exits(@output transfer)
        }
        value=body.items[body.items.length - 1]
    }
    let reached=output.normal
    if reached is? none return output
    let current:facts.State=reached
    let value_type=types.node_at(checker.data.env.types node_at(value checker).value_type)
    if types.is_primitive(value_type 'never') {
        let transfer=analyze(value current @checker validate)
        output.normal=transfer.normal
        append_exits(@output transfer)
        return output
    }
    evaluate(value @current @checker validate)
    let node=node_at(id checker)
    if node is? hir.Declare {declare_value(node value @current @checker)}
    else if node is? hir.Assign {assign_value(node value @current @checker)}
    loop local in locals {stores.forget(@current local @checker.data)}
    output.normal=current
    return output
}

# All children execute in source order. Short circuits, functions and flows
# have their own paths, so the generic child walk must not visit their bodies.
evaluate_inner = (id:addr @state:facts.State @checker:Checker validate:bool):>void => {
    if checker.problem isnt? none and validate return
    let node=node_at(id checker)
    if node is? hir.Block {value_body(id @state @checker validate) return}
    if node is? hir.Flow {
        let output=flow(id node state @checker validate)
        if output.normal isnt? none {state=output.normal}
        return
    }
    if node is? hir.FunctionLiteral {function_body(id node state @checker validate) return}
    if node is? hir.OverloadedFunction {
        loop alternate in node.alternates {evaluate(alternate @state @checker validate)}
        return
    }
    if node is? hir.ShortCircuit {
        evaluate(node.left @state @checker validate)
        let truth=node.op in? ['and' 'nand']
        let right=refine(state node.left truth @checker)
        let shortcut=refine(state node.left not truth @checker)
        let paths:array<facts.State>=[]
        if shortcut isnt? none {paths.push(shortcut)}
        if right isnt? none {
            let continuing=right
            evaluate(node.right @continuing @checker validate)
            paths.push(continuing)
        }
        let merged=joined(paths checker)
        if merged isnt? none {state=merged}
        record(id @state @checker)
        return
    }
    if node is? hir.Place {
        evaluate(node.target @state @checker validate)
        forget_place(node.target @state @checker)
        return
    }
    if node is? hir.FunctionCall {
        let function=node_at(node.func checker)
        if function is? hir.ExpressedIdentifier and (function.name.startswith('_capture_push') or function.name.startswith('_capture_add')) and node.pos_args.length =? 2 {
            let target=node_at(node.pos_args[0] checker)
            if target is? hir.Place {
                evaluate(node.pos_args[1] @state @checker validate)
                let sequence=terms.sequence_id(target.target checker.data.env @checker.data.registry)
                if sequence isnt? none {
                    elements.store(@state sequence node.pos_args[1] checker.word_type node.loc checker.data.env @checker.data.registry)
                    note_element_routes(sequence @checker)
                    intervals.forget(@checker.data.snapshot sequence)
                    lengths.apply(@state sequence 'push' none checker.data.env.cap);
                }
                return
            }
        }
        if function is? hir.ArrayMethod {array_call(id node function @state @checker validate) record(id @state @checker) return}
        evaluate(node.func @state @checker validate)
        # The call can write borrowed endpoints only after all arguments
        # have been evaluated and their entry preconditions checked.
        let arguments=node.pos_args
        loop argument in node.kw_args.values {arguments.push(argument)}
        let places:array<addr>=[]
        loop argument in arguments {if node_at(argument checker) is? hir.Place {places.push(argument)}}
        let observed:dict<addr facts.State>=[]
        loop argument in arguments {
            let value=node_at(argument checker)
            evaluate(if value is? hir.Place value.target else argument @state @checker validate)
            if validate and places.length >? 0 and value is? hir.Obligation {observed[argument]=state}
        }
        loop [argument entry] in observed {
            let obligation=node_at(argument checker)
            $runtime_assert obligation is? hir.Obligation
            let common=facts.join([entry state] checker.data.relations.facts)
            let error=obligations.check(obligation common checker.assigned checker.srcfile checker.path_context @checker.data)
            if error isnt? none {
                if checker.prototype and argument not in? checker.deferred_sites {checker.deferred_sites[argument]=prototype.Deferred['obligation' error obligation.refined]}
                else {checker.problem=error}
            }
        }
        loop place in places {
            let argument=node_at(place checker)
            $runtime_assert argument is? hir.Place
            if place not in? checker.read_only_places {forget_place(argument.target @state @checker)}
        }
        loop global in checker.call_writes.get(id checker.mutable_globals) {
            stores.forget(@state global @checker.data)
        }
        let applied=predicates.apply_call(state id none @checker.data)
        if applied isnt? none {state=applied}
        record(id @state @checker)
        let name=if node.integer_operation isnt? none node.integer_operation else if function is? hir.ExpressedIdentifier function.name else ''
        if validate and name in? ['__floordiv__' '__mod__'] and node.integer_operation is? none and node.pos_args.length =? 2 {
            let divisor=node.pos_args[1]
            if not obligations.nonzero(divisor checker.data.snapshot.numbers.get(divisor) state checker.data) {fail(divisor 'cannot prove the divisor is nonzero' 'establish that the divisor cannot be zero' @checker)}
        }
        # `narrow` is also an ordinary user function name. Only the checked
        # operation tag identifies an integer narrowing conversion.
        let narrowing=node.integer_operation =? 'narrow'
        if validate and (narrowing or name in? ['__add__' '__sub__' '__mul__' '__floordiv__' '__mod__' '__lshift__' '__unary_sub__']) {
            let type=types.node_at(checker.data.env.types node.value_type)
            if types.is_primitive(type 'int') or types.is_primitive(type 'uint') or narrowing {
                let known=checker.data.snapshot.numbers.get(id)
                let word=if narrowing and type is? types.Primitive type.name else if types.is_primitive(type 'uint') 'uint64' else 'int64'
                let width=if narrowing values.result_width(node.value_type checker.data.env.types) else if word =? 'uint64' ranges.Interval[0 18446744073709551615] else ranges.Interval[(-9223372036854775808) 9223372036854775807]
                if ranges.fits(known width) is? none {checker.unfit[id]=Unfit[known word]}
            }
        }
        return
    }
    if node is? hir.ObjectLiteral {
        let object=expressions.object_of(node.value_type checker.data.env.types)
        loop field in node.fields {
            evaluate(field.value @state @checker validate)
            if field.binding_id isnt? none {
                install(@state field.binding_id field.value none field.loc @checker)
                let declaration=if object is? none none else types.object_field(object field.name)
                if declaration isnt? none and declaration.refinement.length >? 0 {
                    let refined=types.RefinedType[key="field-contract:{field.binding_id}" base=declaration.value_type propositions=declaration.refinement]
                    refinements.seed_binding(@state @checker.declared field.binding_id refined checker.refinement_context field.loc @checker.data.registry)
                }
            }
        }
        record(id @state @checker)
        return
    }
    if node is? hir.Assign|hir.Declare|hir.Assert|hir.Return|hir.Break|hir.Continue {
        let output=analyze(id state @checker validate)
        if output.normal isnt? none {state=output.normal}
        return
    }
    let children=if node is? hir.DictLookup|hir.DictContains|hir.DictStore|hir.DictRemove dictionary_children(node @checker validate) else hir.children(node)
    loop child in children {evaluate(child @state @checker validate)}
    if node is? hir.MemberAccess {refinements.seed_siblings(@state node checker.data.env @checker.data.registry)}
    if node is? hir.MemberAssign {
        let target=node_at(node.target checker)
        $runtime_assert target is? hir.MemberAccess
        forget_value(target.value @state @checker)
        let access=bindings.access_path(node.target checker.data.env.nodes facts=true)
        let root=node_at(access.root checker)
        let path=bindings.member_fields(access checker.data.env.nodes)
        if root is? hir.ExpressedIdentifier and root.binding_id isnt? none and path isnt? none {
            stores.forget(@state root.binding_id @checker.data prefix=path)
            let route=bindings.route_id(@checker.data.registry root.binding_id path target.value_type target.loc)
            install(@state route node.value none node.loc @checker)
        }
    }
    if node is? hir.IndexAssign {
        let target=node_at(node.target checker)
        $runtime_assert target is? hir.Index
        let number=checker.data.snapshot.numbers.get(node.value)
        let nonzero=obligations.nonzero(node.value number state checker.data)
        let stable=intervals.stable(node.target checker.data.snapshot checker.data.env.nodes)
        forget_value(target.array @state @checker)
        let route=if stable bindings.array_route_id(node.target checker.data.env.nodes @checker.data.registry) else none
        if route isnt? none {
            if number isnt? none {facts.set_value(@state facts.Term[route] number)}
            if nonzero {facts.put(@state facts.nonzero(route) ranges.exact(1))}
        }
        let array=terms.sequence_id(target.array checker.data.env @checker.data.registry)
        if array isnt? none {elements.store(@state array node.value checker.word_type node.loc checker.data.env @checker.data.registry) note_element_routes(array @checker)}
    }
    if node is? hir.DictStore|hir.DictRemove {
        # Public dictionary length is its live count. Backing arrays may
        # include tombstones, so their length facts cannot stand in for it.
        let keys=node_at(node.keys checker)
        if keys is? hir.MemberAccess {
            forget_value(keys.value @state @checker)
            # These are compiler-owned fields of an opaque dictionary,
            # so the public field-route resolver deliberately excludes them.
            # Derive the sibling route from the already checked keys route.
            let key_id=bindings.array_route_id(node.keys checker.data.env.nodes @checker.data.registry)
            let owner_type=types.node_at(checker.data.env.types views.structural_base(node_at(keys.value checker).value_type checker.data.env.types))
            if key_id isnt? none and owner_type is? types.ObjectType {
                let route=bindings.route_at(checker.data.registry key_id)
                let field=types.object_field(owner_type 'live')
                if route isnt? none and field isnt? none and route.path.length>?0 {
                    let path=route.path
                    path.pop;
                    path.push('live')
                    let live=bindings.route_id(@checker.data.registry route.root path field.value_type keys.loc)
                    stores.forget(@state live @checker.data)
                    if node is? hir.DictRemove and node.key is? none {facts.set_value(@state facts.Term[live] ranges.exact(0))}
                }
            }
        }
        let arrays:array<addr>=[node.keys]
        let payload=node.values
        if payload isnt? none {arrays.push(payload)}
        loop array in arrays {
            let sequence=terms.sequence_id(array checker.data.env @checker.data.registry)
            if sequence isnt? none {
                facts.forget(@state facts.Term[sequence 'length'])
                intervals.forget(@checker.data.snapshot sequence)
                if node is? hir.DictRemove and node.key is? none {facts.set_value(@state facts.Term[sequence 'length'] ranges.exact(0))}
            }
        }
    }
    record(id @state @checker)
    if not validate return
    if node is? hir.Index|hir.StringIndex {
        let sequence=if node is? hir.Index node.array else node.string
        let checked=indices.check_index(node checker.data.snapshot.numbers.get(node.index) checker.data.snapshot.lengths.get(sequence) state checker.proof_context checker.data.snapshot.numbers checker.srcfile @checker.data.registry symbolic=intervals.stable(node.index checker.data.snapshot checker.data.env.nodes))
        if checked is? Error {
            if checker.prototype {checker.deferred_sites[id]=prototype.Deferred['index' checked]}
            else {checker.problem=checked}
        }
        else {
            # Shared HIR routes need the same constant at every occurrence.
            # A disagreement (including a dynamic occurrence) is permanent.
            if id in? checker.checked_indices {
                let previous=checker.constant_indices.get(id)
                if checked.constant_index is? none or previous is? none or previous not=?checked.constant_index {checker.constant_indices.pop(id default=0);}
            } else {
                checker.checked_indices.add(id)
                if checked.constant_index isnt? none {checker.constant_indices[id]=checked.constant_index}
            }
        }
    }
    if node is? hir.StringSlice {
        let error=slices.check(node state checker.srcfile @checker.data)
        if error isnt? none {checker.problem=error}
    }
    if node is? hir.ValueCast {
        # A typed read contributes its representation's range even when no
        # narrower flow interval was recorded (for example a uint8 element).
        # This is the same evidence used by the cast's interval transfer.
        let source=intervals.meet(checker.data.snapshot.numbers.get(node.expr) values.fixed_bounds(node_at(node.expr checker).value_type checker.data.env.types))
        let width=values.fixed_bounds(node.value_type checker.data.env.types)
        let target=types.node_at(checker.data.env.types types.strip_refinement(node.value_type checker.data.env.types))
        if width isnt? none and ranges.fits(source width) is? none and target is? types.Primitive {
            # `$prototype`: a fixed-width narrowing becomes a runtime range check
            if checker.prototype and views.fixed_integer_layout(types.strip_refinement(node_at(node.expr checker).value_type checker.data.env.types) checker.data.env.types) isnt? none {
                let report=Error[srcfile=checker.srcfile title="cannot prove this integer fits `{target.name}`" pointers=[Pointer[span=node.loc message="the value's range is not proven inside `{target.name}`"]] hint='narrow the value with a comparison to prove it']
                checker.deferred_sites[id]=prototype.Deferred['cast' report]
            } else {checker.unfit[id]=Unfit[source target.name]}
        }
    }
}

last_value = (id:addr checker:Checker):>addr => {
    let current=id
    loop true {
        let node=node_at(current checker)
        if node is? hir.Block and node.items.length >? 0 {current=node.items[node.items.length-1] continue}
        return current
    }
}
flow = (id:addr node:hir.Flow state:facts.State @checker:Checker validate:bool):>Transfer => {
    if node.arms.length =? 1 {
        let arm=node_at(node.arms[0] checker)
        if arm is? hir.LoopArm return loop_body(arm state @checker validate)
    }
    let remaining:facts.State?=state
    let exits:array<facts.State>=[]
    let output=Transfer[none]
    let results:array<addr>=[]
    loop arm_id in node.arms {
        if remaining is? none break
        let arm=node_at(arm_id checker)
        $runtime_assert arm is? hir.IfArm|hir.LoopArm
        let current=remaining
        evaluate(arm.condition @current @checker validate)
        let positive=refine(current arm.condition true @checker)
        remaining=refine(current arm.condition false @checker)
        if positive isnt? none {
            let body=analyze_result(arm.body positive checker.result_obligations.get(id []) @checker validate)
            append_exits(@output body)
            if body.normal isnt? none {exits.push(body.normal) results.push(last_value(arm.body checker))}
        }
    }
    if remaining isnt? none {
        if node.default isnt? none {
            let body=analyze_result(node.default remaining checker.result_obligations.get(id []) @checker validate)
            append_exits(@output body)
            if body.normal isnt? none {exits.push(body.normal) results.push(last_value(node.default checker))}
        } else {exits.push(remaining)}
    }
    output.normal=joined(exits checker)
    let numeric:ranges.Interval?=none
    let length:ranges.Interval?=none
    let numbers_complete=true
    let lengths_complete=true
    loop result in results {
        let known=checker.data.snapshot.numbers.get(result)
        let measured=checker.data.snapshot.lengths.get(result)
        if known is? none {numbers_complete=false}
        else {numeric=if numeric is? none known else ranges.union(numeric known)}
        if measured is? none {lengths_complete=false}
        else {length=if length is? none measured else ranges.union(length measured)}
    }
    if numeric isnt? none and numbers_complete {checker.data.snapshot.numbers[id]=numeric}
    if length isnt? none and lengths_complete {checker.data.snapshot.lengths[id]=length}
    return output
}

same_state = (left:facts.State right:facts.State):>bool => {
    if left.values.length not=? right.values.length return false
    loop entry in left.values {
        let other=facts.lookup(right entry.fact)
        if other is? none or not ranges.same_bounds(entry.interval other) return false
    }
    return true
}
iterators_of = (id:addr checker:Checker):>array<addr> => {
    let node=node_at(id checker)
    if node is? hir.IteratorExpression return [id]
    if node is? hir.MultiIteratorExpression return node.iterators
    return []
}
enter_iterators = (iterators:array<addr> state:facts.State @checker:Checker word_candidates:bool=true):>facts.State => {
    let current=state
    loop id in iterators {
        let node=node_at(id checker)
        $runtime_assert node is? hir.IteratorExpression
        if node.count =? 0 continue
        let target=node_at(node.target checker)
        $runtime_assert target is? hir.ExpressedIdentifier
        if target.binding_id is? none continue
        facts.set_value(@current facts.Term[target.binding_id] values.loop_counter_interval(node checker.element_intervals checker.data.env word_candidates))
        let sequence=terms.sequence_id(node.iterable checker.data.env @checker.data.registry)
        if sequence isnt? none {elements.read(@current sequence target.binding_id checker.word_type node.loc @checker.data.registry) note_element_routes(sequence @checker)}
        # `loop x in xs` over an `array<nat64>`: the element type's promise
        # holds of `x`. The read may carry a narrower element type (a literal's),
        # so the iterable binding's declared type is consulted as well, as the
        # hosted `_read_element` does.
        let candidates:array<addr>=[node_at(node.iterable checker).value_type]
        if sequence isnt? none and bindings.has_binding(checker.data.registry sequence) {
            let binding=bindings.binding_at(checker.data.registry sequence)
            if binding.store_type isnt? none {candidates.push(binding.store_type)}
            else if binding.value_type isnt? none {candidates.push(binding.value_type)}
        }
        loop candidate in candidates {
            let iterable=types.node_at(checker.data.env.types types.unfold(types.strip_refinement(candidate checker.data.env.types) checker.data.env.types))
            if iterable isnt? types.ArrayType continue
            let element=types.node_at(checker.data.env.types types.unfold(iterable.element checker.data.env.types))
            if element is? types.RefinedType {refinements.seed_binding(@current @checker.declared target.binding_id element checker.refinement_context node.loc @checker.data.registry)}
        }
    }
    return current
}
remove_targets = (@state:facts.State iterators:array<addr> @checker:Checker):>void => {
    loop id in iterators {
        let node=node_at(id checker)
        $runtime_assert node is? hir.IteratorExpression
        let target=node_at(node.target checker)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {stores.forget(@state target.binding_id @checker.data)}
    }
}
finite_iterator_loop = (arm:hir.LoopArm iterator:hir.IteratorExpression iterators:array<addr> count:bigint state:facts.State @checker:Checker validate:bool):>Transfer => {
    checker.finite_loop_budget-=count
    let current:facts.State?=state
    let entries:array<facts.State>=[]
    let exits:array<facts.State>=[]
    let output=Transfer[none]
    let step:bigint=0
    loop step <? count and current isnt? none {
        checker.data.snapshot=intervals.Snapshot[]
        let entry=enter_iterators(iterators current @checker)
        let target=node_at(iterator.target checker)
        if node_at(iterator.iterable checker) is? hir.Range and target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            facts.set_value(@entry facts.Term[target.binding_id] ranges.exact(iterator.first+step*iterator.step))
        }
        entries.push(entry)
        let body=analyze(arm.body entry @checker false)
        let backedges:array<facts.State>=[]
        if body.normal isnt? none {backedges.push(body.normal)}
        loop exit in body.breaks {
            if exit.levels >? 0 {output.breaks.push(Exit[exit.levels-1 exit.state])}
            else {exits.push(exit.state)}
        }
        loop exit in body.continues {
            if exit.levels >? 0 {output.continues.push(Exit[exit.levels-1 exit.state])}
            else {backedges.push(exit.state)}
        }
        current=joined(backedges checker)
        if current isnt? none {
            let next=current
            remove_targets(@next iterators @checker)
            current=next
        }
        step+=1
    }
    if current isnt? none {exits.push(current)}
    # Prove the body once from every reachable entry, never just iteration 0.
    checker.data.snapshot=intervals.Snapshot[]
    let entry=joined(entries checker)
    if entry isnt? none {analyze(arm.body entry @checker validate);}
    loop i in 0.. and i <? exits.length {
        let exit=exits[i]
        remove_targets(@exit iterators @checker)
        exits[i]=exit
    }
    output.normal=joined(exits checker)
    return output
}
# Word storage is an inductive invariant, not an assumption from the target's
# abstract integer type. Every normal or continue edge advances the iterator;
# breaks/returns do not. Unknown evidence requires arbitrary-precision lowering.
iterator_steps_fit = (iterators:array<addr> transfer:Transfer checker:Checker):>bool => {
    let backedges:array<facts.State>=[]
    if transfer.normal isnt? none {backedges.push(transfer.normal)}
    loop exit in transfer.continues {if exit.levels =? 0 {backedges.push(exit.state)}}
    loop id in iterators {
        let iterator=node_at(id checker)
        $runtime_assert iterator is? hir.IteratorExpression
        if node_at(iterator.iterable checker) isnt? hir.Range or iterator.count isnt? none continue
        let target=node_at(iterator.target checker)
        $runtime_assert target is? hir.ExpressedIdentifier
        let valid=target.binding_id isnt? none and iterator.step not=? 0 and iterator.first >=? -9223372036854775808 and iterator.first <=? 9223372036854775807 and iterator.step >=? -9223372036854775808 and iterator.step <=? 9223372036854775807
        loop state in backedges {
            if not valid {break}
            $runtime_assert target.binding_id isnt? none
            let interval=values.binding_interval(facts.Term[target.binding_id] state checker.data.env)
            valid=interval.lower isnt? none and interval.upper isnt? none and interval.lower+iterator.step >=? -9223372036854775808 and interval.upper+iterator.step <=? 9223372036854775807
        }
        if not valid return false
    }
    return true
}

# Cache a bounded vocabulary from each loop body. A relation mentioned in
# source only identifies a pair; entry intervals and backedges prove it.
mentioned_loop_pairs=(body:addr @checker:Checker):>array<facts.TermPair>=>{
    let cached=checker.loop_qualifier_pairs.get(body)
    if cached isnt? none return cached
    let pairs:array<facts.TermPair>=[] let pending:array<addr>=[body] let seen:set<addr>=set[]
    loop pending.length>?0 and pairs.length<?64 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=node_at(id checker)
        if node is? hir.FunctionLiteral continue
        let function=if node is? hir.FunctionCall node_at(node.func checker) else none
        if node is? hir.FunctionCall and node.pos_args.length=?2 and function is? hir.ExpressedIdentifier and function.name in? set['__lt__' '__le__' '__gt__' '__ge__' '__eq__' '__ne__' '__sub__'] {
            let left=terms.offset_term(node.pos_args[0] checker.data.env @checker.data.registry)
            let right=terms.offset_term(node.pos_args[1] checker.data.env @checker.data.registry)
            if left isnt? none and right isnt? none and not facts.same_term(left.term right.term) {
                let found=false
                loop pair in pairs {
                    if facts.same_term(pair.left left.term) and facts.same_term(pair.right right.term) or facts.same_term(pair.left right.term) and facts.same_term(pair.right left.term) {found=true break}
                }
                if not found {pairs.push(facts.TermPair[left.term right.term])}
            }
        }
        let children=hir.children(node)
        let cursor=children.length
        loop cursor>?0 {cursor-=1 pending.push(children[cursor])}
    }
    checker.loop_qualifier_pairs[body]=pairs
    return pairs
}
loop_body = (arm:hir.LoopArm state:facts.State @checker:Checker validate:bool word_candidates:bool=true):>Transfer => {
    let iterators=iterators_of(arm.condition checker)
    let incoming=state
    loop id in iterators {
        let iterator=node_at(id checker)
        $runtime_assert iterator is? hir.IteratorExpression
        evaluate(iterator.iterable @incoming @checker validate)
        if iterators.length =? 1 and iterator.count =? 0 return Transfer[incoming]
    }
    if iterators.length =? 1 {
        let iterator=node_at(iterators[0] checker)
        $runtime_assert iterator is? hir.IteratorExpression
        let count=iterator.count
        let iterable=node_at(iterator.iterable checker)
        let type=types.node_at(checker.data.env.types types.strip_refinement(iterable.value_type checker.data.env.types))
        if type is? types.ArrayType {
            let sequence=terms.sequence_id(iterator.iterable checker.data.env @checker.data.registry)
            if sequence isnt? none and sequence not in? checker.assigned {
                let length=intervals.length(iterator.iterable incoming checker.data.snapshot checker.data.env @checker.data.registry)
                count=if length isnt? none and ranges.same_endpoint(length.lower length.upper) length.lower else none
            } else if iterable isnt? hir.ArrayLiteral {count=none}
        }
        if count =? 0 return Transfer[incoming]
        if count isnt? none and count >? 0 and count <=? 8 and count <=? checker.finite_loop_budget {
            return finite_iterator_loop(arm iterator iterators count incoming @checker validate)
        }
    }
    let changing:set<addr>=set[]
    loop entry in incoming.values {
        let fact=entry.fact
        if fact isnt? facts.Value continue
        let route=bindings.route_at(checker.data.registry fact.term.binding_id)
        let root=if route is? none fact.term.binding_id else route.root
        if root in? checker.assigned {changing.push(fact.term.binding_id)}
    }
    let mentioned=mentioned_loop_pairs(arm.body @checker)
    incoming=facts.seed_loop_relations(incoming changing mentioned)
    let head=incoming
    # Widening prevents an accumulator from retaining the entry interval
    # forever. Narrowing then recovers bounds imposed by a while guard.
    let pass:addr=0
    loop pass <? 11 {
        if pass >=? 8 and iterators.length >? 0 break
        checker.data.snapshot=intervals.Snapshot[]
        let current=if iterators.length >? 0 enter_iterators(iterators head @checker word_candidates) else head
        let positive:facts.State?=current
        if iterators.length =? 0 {
            evaluate(arm.condition @current @checker false)
            positive=refine(current arm.condition true @checker)
        }
        if positive is? none break
        let body=analyze(arm.body positive @checker false)
        let candidates:array<facts.State>=[incoming]
        if body.normal isnt? none {
            let next=body.normal
            remove_targets(@next iterators @checker)
            candidates.push(next)
        }
        loop exit in body.continues {
            if exit.levels =? 0 {
                let next=exit.state
                remove_targets(@next iterators @checker)
                candidates.push(next)
            }
        }
        let candidate=facts.join(candidates checker.data.relations.facts)
        let next=if pass <? 8 facts.widen(head candidate checker.data.relations.facts) else facts.narrow(head candidate checker.data.relations.facts)
        if same_state(head next) {
            if pass <? 8 and iterators.length =? 0 {pass=8 continue}
            break
        }
        head=next
        pass += 1
    }
    checker.data.snapshot=intervals.Snapshot[]
    let current=if iterators.length >? 0 enter_iterators(iterators head @checker word_candidates) else head
    let positive:facts.State?=current
    let negative:facts.State?=none
    if iterators.length =? 0 {
        evaluate(arm.condition @current @checker validate)
        positive=refine(current arm.condition true @checker)
        negative=refine(current arm.condition false @checker)
    }
    let exits:array<facts.State>=[]
    let output=Transfer[none]
    if iterators.length >? 0 {exits.push(incoming)}
    if negative isnt? none {exits.push(negative)}
    if positive isnt? none {
        let unbounded:array<addr>=[]
        loop id in iterators {
            let iterator=node_at(id checker)
            $runtime_assert iterator is? hir.IteratorExpression
            if iterator.count is? none and node_at(iterator.iterable checker) is? hir.Range {unbounded.push(id)}
        }
        let body:Transfer=Transfer[none]
        if unbounded.length >? 0 {
            body=analyze(arm.body positive @checker false)
            let proved=word_candidates and iterator_steps_fit(unbounded body checker)
            if word_candidates and not proved return loop_body(arm state @checker validate false)
            if validate {
                if proved {loop id in unbounded {checker.word_iterators.add(id)}}
                body=analyze(arm.body positive @checker true)
            }
        } else {body=analyze(arm.body positive @checker validate)}
        if iterators.length >? 0 and body.normal isnt? none {exits.push(body.normal)}
        loop exit in body.breaks {
            if exit.levels >? 0 {output.breaks.push(Exit[exit.levels-1 exit.state])}
            else {exits.push(exit.state)}
        }
        loop exit in body.continues {if exit.levels >? 0 {output.continues.push(Exit[exit.levels-1 exit.state])}}
    }
    loop i in 0.. and i <? exits.length {
        let exit=exits[i]
        remove_targets(@exit iterators @checker)
        exits[i]=exit
    }
    output.normal=joined(exits checker)
    return output
}

collect = (root:addr @checker:Checker):>void => {
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=node_at(id checker)
        let target:addr?=none
        if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign|hir.Place {target=node.target}
        else if node is? hir.DictStore|hir.DictRemove {
            target=node.keys
            let path=bindings.access_path(node.keys checker.data.env.nodes dictionaries=true)
            let owner=node_at(path.root checker)
            let indexed=false
            loop step in path.steps {if node_at(step checker) is? hir.Index|hir.DictLookup {indexed=true}}
            if indexed and owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none {checker.container_receivers.add(owner.binding_id)}
        }
        else if node is? hir.FunctionCall {
            let method=node_at(node.func checker)
            if method is? hir.ArrayMethod and method.name not=? 'join' {target=method.array}
        }
        if target isnt? none {
            let access=bindings.access_path(target checker.data.env.nodes facts=true)
            let owner=node_at(access.root checker)
            if owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none {checker.assigned.add(owner.binding_id)}
        }
        hir.push_children(node @pending)
    }
    let node=node_at(root checker)
    $runtime_assert node is? hir.Block
    loop id in node.items {
        checker.root_items.add(id)
        let item=node_at(id checker)
        if item is? hir.Declare and item.decltype =? 'let' and item.binding_id isnt? none and item.binding_id in? checker.assigned {checker.mutable_globals.add(item.binding_id)}
    }
}
validate = (root:addr @checker:Checker read_only:set<addr> | none=none):>void => {
    collect(root @checker)
    let tracked=checker.mutable_globals
    if checker.container_receivers.length>?0 {
        loop binding in effects.nonlocal_bindings(root checker.data.env.nodes) {
            if binding in? checker.container_receivers {tracked.add(binding)}
        }
    }
    checker.call_writes=effects.analyze_global_writes(root checker.data.env.nodes tracked checker.data.env.registry)
    checker.read_only_places=if read_only isnt? none read_only else effects.read_only_places(root checker.data.env.nodes checker.data.env.types)
    checker.path_context=paths.Context[checker.data.env.nodes checker.data.relations.facts checker.call_writes]
    let node=node_at(root checker)
    $runtime_assert node is? hir.Block
    let state:facts.State=facts.State[]
    loop item in node.items {
        let result=analyze(item state @checker true)
        if checker.problem isnt? none return
        if result.normal is? none break
        state=result.normal
    }
    let deferred=checker.deferred
    checker.deferred.clear
    checker.root_items.clear
    loop id in deferred {
        let function=node_at(id checker)
        $runtime_assert function is? hir.FunctionLiteral
        let started=timing.start(checker.timings)
        function_body(id function state @checker true)
        timing.finish_slow("bounds.function:{checker.srcfile.path}@{function.loc.start}#{id}" started 20000000)
        if checker.problem isnt? none return
    }
}

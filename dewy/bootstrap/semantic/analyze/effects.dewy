import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"../type_queries.dewy" as views
import p"../bindings.dewy" as bindings
import p"predicate_effects.dewy" as local_effects

doc"""
Transitive effects on aggregate parameters, corresponding to analyze/effects.py.

An effect names a field/index route into a parameter. A stored prefix covers
everything below it. Value arguments read caller storage: mutation by the
callee happens on its own value. Only place arguments carry the callee's
writes and escapes back into the caller. Unknown callees conservatively do
everything to each place argument.

The finite route depth makes recursive calls converge. Absence of an effect
is a guarantee; presence says only that it may happen. Lowering can use a
read-only summary to borrow a value at a call boundary instead of copying it.
"""

const MAX_ROUTE_DEPTH:addr = 8
Effect:type = 'read' | 'mutate' | 'rebind' | 'escape'
Route:type = const [steps:array<string>]
ParameterEffects:type = [
    reads:array<Route>=[] mutates:array<Route>=[]
    rebinds:array<Route>=[] escapes:array<Route>=[]
]
FunctionEffects:type = [literal:addr params:dict<addr ParameterEffects>]
ProgramEffects:type = [by_literal:dict<addr FunctionEffects> by_param_binding:dict<addr ParameterEffects>]
EffectTransfer:type = const [caller:addr caller_parameter:addr callee_parameter:addr prefix:Route]
Analysis:type = [
    literals:array<addr>=[] declares:dict<addr addr>=[]
    # Staging for child visits (see `visit_children`).
    child_stack:array<addr>=[]
    calls:array<addr>=[]
    reassigned:set<addr>=set[] param_ids:set<addr>=set[]
    effects:dict<addr FunctionEffects>=[]
    callback_targets:dict<addr array<addr>>=[]
    value_casts_escape:bool=true
    current_literal:addr=0
    transfers:dict<addr array<EffectTransfer>>=[]
]
ResolvedRoute:type = [binding_id:addr route:Route inner:array<addr>]
ArgumentPair:type = const [argument:addr parameter:addr?]
Pairing:type = [target:addr pairs:array<ArgumentPair>]

writes = (summary:ParameterEffects):>bool => summary.mutates.length >? 0 or summary.rebinds.length >? 0
read_only = (summary:ParameterEffects):>bool => not writes(summary) and summary.escapes.length =? 0
# A projection must be stable above and below its route. Sibling record
# fields are independent; the shared [] step never proves indices disjoint.
disjoint_routes = (routes:array<Route> route:Route):>bool => {
    loop other in routes {
        if bindings.path_starts_with(route.steps other.steps) or bindings.path_starts_with(other.steps route.steps) return false
    }
    return true
}
read_only_at = (summary:ParameterEffects route:Route):>bool => {
    return disjoint_routes(summary.mutates route) and disjoint_routes(summary.rebinds route) and disjoint_routes(summary.escapes route)
}
# A word carries no storage: passing it to a raw operation exposes nothing.
word_type = (id:addr type_nodes:types.Table):>bool => {
    let type=types.node_at(type_nodes types.unfold(types.strip_refinement(id type_nodes) type_nodes))
    if type is? types.IntegerLiteralType return type.value >=? -9223372036854775808 and type.value <=? 18446744073709551615
    return type is? types.Primitive and type.name in? ['int' 'uint' 'int8' 'int16' 'int32' 'int64' 'uint8' 'uint16' 'uint32' 'uint64' 'float32' 'float64' 'bool' 'true' 'false' 'none']
}
# Raw memory operations and system calls may read or write through any
# storage they receive, and have no prologue of their own to copy it. An
# aggregate handed to one escapes: its summary then says so, and a caller
# borrowing against that summary sees the exposure at this boundary rather
# than through a whole-call-graph bit. Every other callee, resolved or not,
# is a value boundary that decides for itself.
raw_callee = (call:hir.FunctionCall nodes:array<hir.AST>):>bool => {
    let function = hir.node_at(nodes unwrap(call.func nodes))
    if function isnt? hir.ExpressedIdentifier or function.binding_id isnt? none return false
    return function.name.startswith('__load_') or function.name.startswith('__store_') or function.name.startswith('__syscall') or function.name in? ['__load__' '__store__']
}

add_route = (@routes:array<Route> route:Route):>bool => {
    let steps = route.steps
    if steps.length >? MAX_ROUTE_DEPTH { steps.truncate(MAX_ROUTE_DEPTH) }
    loop stored in routes { if bindings.path_starts_with(steps stored.steps) return false }
    let remaining:array<Route> = []
    loop stored in routes {
        if not bindings.path_starts_with(stored.steps steps) { remaining.push(stored) }
    }
    remaining.push(Route[steps])
    routes = remaining
    return true
}
record = (binding_id:addr kind:Effect route:Route @params:dict<addr ParameterEffects>):>bool => {
    if binding_id not in? params return false
    let summary = params[binding_id]
    let changed:bool = false
    if kind =? 'read' { changed = add_route(@summary.reads route) }
    else if kind =? 'mutate' { changed = add_route(@summary.mutates route) }
    else if kind =? 'rebind' { changed = add_route(@summary.rebinds route) }
    else { changed = add_route(@summary.escapes route) }
    if changed { params[binding_id] = summary }
    return changed
}
opaque = (binding_id:addr route:Route @params:dict<addr ParameterEffects>):>bool => {
    let changed:bool = false
    let kinds:array<Effect> = ['read' 'mutate' 'rebind' 'escape']
    loop kind in kinds { if record(binding_id kind route @params) { changed = true } }
    return changed
}
translated = (binding_id:addr summary:ParameterEffects prefix:Route @params:dict<addr ParameterEffects>):>bool => {
    let changed:bool = false
    let kinds:array<Effect> = ['read' 'mutate' 'rebind' 'escape']
    loop kind in kinds {
        let routes = summary.reads
        if kind =? 'mutate' { routes = summary.mutates }
        else if kind =? 'rebind' { routes = summary.rebinds }
        else if kind =? 'escape' { routes = summary.escapes }
        loop route in routes {
            let steps = prefix.steps
            loop step in route.steps { steps.push(step) }
            if record(binding_id kind Route[steps] @params) { changed = true }
        }
    }
    return changed
}

literal_params = (literal:hir.FunctionLiteral):>array<hir.Param> => {
    let params:array<hir.Param> = []
    loop p in literal.pos_or_kw_args { params.push(p) }
    loop p in literal.kw_only_args { params.push(p) }
    if literal.rest_args isnt? none { params.push(literal.rest_args) }
    return params
}
unwrap = (id:addr nodes:array<hir.AST>):>addr => {
    let current:addr = id
    loop true {
        let node = hir.node_at(nodes current)
        if node isnt? hir.Block or node.scoped or node.items.length not=? 1 return current
        current = node.items[0]
    }
}

collect = (root:addr nodes:array<hir.AST>):>Analysis => {
    return collect_roots([root] nodes)
}
collect_roots = (roots:array<addr> nodes:array<hir.AST>):>Analysis => {
    let analysis = Analysis[]
    let pending=roots
    let seen:set<addr> = set[]
    loop pending.length >? 0 {
        let id = pending.pop
        if id in? seen continue
        seen.push(id)
        let node = hir.node_at(nodes id)
        if node is? hir.FunctionLiteral {
            analysis.literals.push(id)
            let params:dict<addr ParameterEffects> = []
            let declared = literal_params(node)
            loop param in declared {
                if param.binding_id is? none continue
                analysis.param_ids.push(param.binding_id)
                params[param.binding_id] = ParameterEffects[]
            }
            analysis.effects[id] = FunctionEffects[id params]
        }
        else if node is? hir.FunctionCall {analysis.calls.push(id)}
        else if node is? hir.Declare and node.binding_id isnt? none { analysis.declares[node.binding_id] = id }
        else if node is? hir.Assign {
            let target = hir.node_at(nodes node.target)
            $runtime_assert target is? hir.ExpressedIdentifier
            if target.binding_id isnt? none { analysis.reassigned.push(target.binding_id) }
        }
        # Reverse for the stack so traversal retains source declaration order.
        hir.push_children_reversed(node @pending)
    }
    return analysis
}

flatten_callable = (id:addr seen:set<addr> analysis:Analysis nodes:array<hir.AST>):>array<addr> | none => {
    let current = unwrap(id nodes)
    let node = hir.node_at(nodes current)
    if node is? hir.FunctionLiteral return [current]
    if node is? hir.OverloadedFunction {
        let result:array<addr> = []
        loop alternate in node.alternates {
            let resolved = flatten_callable(alternate seen analysis nodes)
            if resolved is? none return none
            loop target in resolved { result.push(target) }
        }
        return result
    }
    if node isnt? hir.ExpressedIdentifier or node.binding_id is? none return none
    let binding_id = node.binding_id
    if binding_id in? seen or binding_id in? analysis.param_ids or binding_id in? analysis.reassigned return none
    if binding_id not in? analysis.declares return none
    let declared = hir.node_at(nodes analysis.declares[binding_id])
    $runtime_assert declared is? hir.Declare
    seen.push(binding_id)
    return flatten_callable(declared.expr seen analysis nodes)
}
# Runtime alternatives are separate from the dispatch order inside one value.
# An overload index selects within every arm; it must not select just one arm.
select_targets = (targets:array<addr> selected:addr?):>array<addr> | none => {
    if selected isnt? none {
        if selected >=? targets.length return none
        return [targets[selected]]
    }
    return if targets.length >? 0 targets else none
}
TargetVisit:type = const [id:addr leaving:bool=false]
value_targets = (id:addr selected:addr? analysis:Analysis nodes:array<hir.AST>):>array<addr> | none => {
    let targets=flatten_callable(id set[] analysis nodes)
    if targets isnt? none return select_targets(targets selected)
    # Intrinsics and unresolved ingress are common; they need no search state.
    let origin=hir.node_at(nodes unwrap(id nodes))
    if origin is? hir.ExpressedIdentifier {
        let binding=origin.binding_id
        if binding is? none or binding in? analysis.param_ids or binding in? analysis.reassigned or binding not in? analysis.declares return none
    } else if origin isnt? hir.ValueCast|hir.Flow return none
    # Visit the graph, not all paths through shared conditional aliases.
    # Active nodes detect unresolved cycles; completed nodes need no revisit.
    let pending:array<TargetVisit>=[TargetVisit[id]]
    let active:set<addr>=set[] let done:set<addr>=set[]
    let result:array<addr>=[] let included:set<addr>=set[]
    loop pending.length >? 0 {
        let step=pending.pop
        let current=unwrap(step.id nodes)
        if step.leaving {active.pop(current default=current); done.push(current) continue}
        if current in? active return none
        if current in? done continue
        active.push(current) pending.push(TargetVisit[current true])
        let node=hir.node_at(nodes current)
        if node is? hir.FunctionLiteral|hir.OverloadedFunction {
            let choices=flatten_callable(current set[] analysis nodes)
            if choices is? none return none
            let selected_choices=select_targets(choices selected)
            if selected_choices is? none return none
            loop choice in selected_choices {if choice not in? included {included.push(choice) result.push(choice)}}
        } else if node is? hir.ValueCast {pending.push(TargetVisit[node.expr])}
        else if node is? hir.ExpressedIdentifier {
            if node.binding_id is? none return none
            let binding=node.binding_id
            if binding in? analysis.param_ids or binding in? analysis.reassigned or binding not in? analysis.declares return none
            let declaration=hir.node_at(nodes analysis.declares[binding])
            $runtime_assert declaration is? hir.Declare
            pending.push(TargetVisit[declaration.expr])
        } else if node is? hir.Flow and node.default isnt? none {
            pending.push(TargetVisit[node.default])
            let position=node.arms.length
            loop position >? 0 {
                position-=1
                $runtime_assert position <? node.arms.length
                let arm=hir.node_at(nodes node.arms[position])
                if arm isnt? hir.IfArm return none
                pending.push(TargetVisit[arm.body])
            }
        } else return none
    }
    return if result.length >? 0 result else none
}
direct_targets = (call:hir.FunctionCall analysis:Analysis nodes:array<hir.AST>):>array<addr> | none => {
    let callback=analysis.callback_targets.get(call.func)
    if callback isnt? none return callback
    return value_targets(call.func call.selected_method_index analysis nodes)
}
pair_arguments = (call:hir.FunctionCall literal:hir.FunctionLiteral):>array<ArgumentPair> | none => {
    let named:dict<string hir.Param> = []
    let positional:array<hir.Param> = []
    loop p in literal.pos_or_kw_args {
        named[p.name] = p
        if p.name not in? call.kw_args { positional.push(p) }
    }
    loop p in literal.kw_only_args { named[p.name] = p }
    let pairs:array<ArgumentPair> = []
    loop i in 0.. and i <? call.pos_args.length {
        let parameter:addr? = none
        if i <? positional.length { parameter = positional[i].binding_id }
        else if literal.rest_args is? none return none
        pairs.push(ArgumentPair[call.pos_args[i] parameter])
    }
    loop name in call.kw_args.keys {
        if name not in? named return none
        if name not in? call.kw_args return none
        let parameter = named[name]
        pairs.push(ArgumentPair[call.kw_args[name] parameter.binding_id])
    }
    return pairs
}

resolve_route = (id:addr params:dict<addr ParameterEffects> nodes:array<hir.AST>):>ResolvedRoute | none => {
    let current:addr = id
    let reverse_steps:array<string> = []
    let inner:array<addr> = []
    loop true {
        current = unwrap(current nodes)
        let node = hir.node_at(nodes current)
        if node is? hir.MemberAccess { reverse_steps.push(node.name) current = node.value continue }
        if node is? hir.Index { reverse_steps.push('[]') inner.push(node.index) current = node.array continue }
        if node isnt? hir.ExpressedIdentifier or node.binding_id is? none or node.binding_id not in? params return none
        let steps:array<string> = []
        loop reverse_steps.length >? 0 { steps.push(reverse_steps.pop) }
        return ResolvedRoute[node.binding_id Route[steps] inner]
    }
}

# A node's children, staged on a shared stack segment above the caller's
# instead of in a fresh array per visited node.
visit_children = (node:hir.AST @params:dict<addr ParameterEffects> @analysis:Analysis nodes:array<hir.AST> type_nodes:types.Table):>bool => {
    let base=analysis.child_stack.length
    hir.push_children(node @analysis.child_stack)
    let stop=analysis.child_stack.length
    let changed:bool=false
    let cursor=base
    loop cursor <? stop {
        $runtime_assert cursor <? analysis.child_stack.length
        let child=analysis.child_stack[cursor]
        if visit(child @params @analysis nodes type_nodes) {changed=true}
        cursor+=1
    }
    loop analysis.child_stack.length >? base {analysis.child_stack.pop;}
    return changed
}
visit_all = (ids:array<addr> @params:dict<addr ParameterEffects> @analysis:Analysis nodes:array<hir.AST> type_nodes:types.Table):>bool => {
    let changed:bool = false
    loop id in ids { if visit(id @params @analysis nodes type_nodes) { changed = true } }
    return changed
}
visit_route = (id:addr kind:Effect suffix:array<string> @params:dict<addr ParameterEffects> @analysis:Analysis nodes:array<hir.AST> type_nodes:types.Table):>bool => {
    let resolved = resolve_route(id params nodes)
    if resolved is? none return visit(id @params @analysis nodes type_nodes)
    let steps = resolved.route.steps
    loop step in suffix { steps.push(step) }
    let changed = record(resolved.binding_id kind Route[steps] @params)
    if visit_all(resolved.inner @params @analysis nodes type_nodes) { changed = true }
    return changed
}

visit = (id:addr @params:dict<addr ParameterEffects> @analysis:Analysis nodes:array<hir.AST> type_nodes:types.Table):>bool => {
    if params.length =? 0 return false
    let node = hir.node_at(nodes id)
    if node is? hir.FunctionCall return visit_call(node @params @analysis nodes type_nodes)
    if node is? hir.IndexAssign | hir.MemberAssign {
        let target = hir.node_at(nodes node.target)
        let changed:bool = false
        if target is? hir.Index {
            changed = visit_route(target.array 'mutate' ['[]'] @params @analysis nodes type_nodes)
            if visit(target.index @params @analysis nodes type_nodes) { changed = true }
        }
        else {
            $runtime_assert target is? hir.MemberAccess
            changed = visit_route(target.value 'mutate' [target.name] @params @analysis nodes type_nodes)
        }
        if visit(node.value @params @analysis nodes type_nodes) { changed = true }
        return changed
    }
    if node is? hir.Assign | hir.IteratorExpression {
        let target = hir.node_at(nodes node.target)
        $runtime_assert target is? hir.ExpressedIdentifier
        let changed:bool = false
        if target.binding_id isnt? none { changed = record(target.binding_id 'rebind' Route[[]] @params) }
        let value = if node is? hir.Assign node.value else node.iterable
        if visit(value @params @analysis nodes type_nodes) { changed = true }
        return changed
    }
    if node is? hir.MemberAccess {
        let value_type = types.node_at(type_nodes node.value_type)
        if value_type is? types.CallableType {
            # A runtime function-valued field captures its receiver. Reading
            # it may expose sibling fields to mutation through that capture.
            let resolved = resolve_route(node.value params nodes)
            if resolved is? none return visit(node.value @params @analysis nodes type_nodes)
            let changed = opaque(resolved.binding_id resolved.route @params)
            if visit_all(resolved.inner @params @analysis nodes type_nodes) { changed = true }
            return changed
        }
    }
    if node is? hir.Index | hir.MemberAccess {
        let resolved = resolve_route(id params nodes)
        if resolved is? none return visit_children(node @params @analysis nodes type_nodes)
        let changed = record(resolved.binding_id 'read' resolved.route @params)
        if visit_all(resolved.inner @params @analysis nodes type_nodes) { changed = true }
        return changed
    }
    if node is? hir.ArrayLength return visit_route(node.array 'read' [] @params @analysis nodes type_nodes)
    if node is? hir.DictStore | hir.DictRemove {
        let changed = visit_route(node.keys 'mutate' [] @params @analysis nodes type_nodes)
        let values = node.values
        if values isnt? none {
            if visit_route(values 'mutate' [] @params @analysis nodes type_nodes) { changed = true }
        }
        let key = node.key
        if key isnt? none { if visit(key @params @analysis nodes type_nodes) { changed = true } }
        if node is? hir.DictStore and node.value isnt? none {
            if visit(node.value @params @analysis nodes type_nodes) { changed = true }
        }
        if node is? hir.DictRemove and node.default isnt? none {
            if visit(node.default @params @analysis nodes type_nodes) { changed = true }
        }
        return changed
    }
    if node is? hir.RepresentationCast | hir.Place {
        let value = if node is? hir.Place node.target else node.expr
        let resolved = resolve_route(value params nodes)
        if resolved is? none {
            if node is? hir.Place return false
            return visit(value @params @analysis nodes type_nodes)
        }
        let changed:bool = false
        if node is? hir.Place { changed = opaque(resolved.binding_id resolved.route @params) }
        else {
            # General semantic consumers remain conservative about views.
            # Storage lowering can instead use its independent value-boundary
            # ownership rules; wrapping an optional does not expose a pointer.
            changed = record(resolved.binding_id 'read' resolved.route @params)
            if analysis.value_casts_escape and not views.preserves_union_payload(hir.node_at(nodes node.expr).value_type node.value_type type_nodes) and record(resolved.binding_id 'escape' resolved.route @params) { changed = true }
        }
        if visit_all(resolved.inner @params @analysis nodes type_nodes) { changed = true }
        return changed
    }
    if node is? hir.ExpressedIdentifier {
        if node.binding_id is? none return false
        return record(node.binding_id 'read' Route[[]] @params)
    }
    if node is? hir.Transmute {
        # Reinterpreting scalar bits exposes nothing. A pointer or aggregate
        # transmute hands the storage itself to whatever consumes the result.
        if word_type(node.value_type type_nodes) and word_type(hir.node_at(nodes node.expr).value_type type_nodes) return visit(node.expr @params @analysis nodes type_nodes)
        let resolved = resolve_route(node.expr params nodes)
        if resolved is? none return visit(node.expr @params @analysis nodes type_nodes)
        let changed = record(resolved.binding_id 'read' resolved.route @params)
        if record(resolved.binding_id 'escape' resolved.route @params) { changed = true }
        if visit_all(resolved.inner @params @analysis nodes type_nodes) { changed = true }
        return changed
    }
    return visit_children(node @params @analysis nodes type_nodes)
}

visit_call = (call:hir.FunctionCall @params:dict<addr ParameterEffects> @analysis:Analysis nodes:array<hir.AST> type_nodes:types.Table):>bool => {
    let function = hir.node_at(nodes call.func)
    let arguments = call.pos_args
    loop argument in call.kw_args.values { arguments.push(argument) }
    if function is? hir.ArrayMethod {
        # Joining reads its receiver. A separator or other argument can still
        # have effects, so retain the ordinary argument walk in either case.
        let kind:Effect = if function.name =? 'join' 'read' else 'mutate'
        let changed = visit_route(function.array kind [] @params @analysis nodes type_nodes)
        if visit_all(arguments @params @analysis nodes type_nodes) { changed = true }
        return changed
    }
    let changed = visit(call.func @params @analysis nodes type_nodes)
    let raw = raw_callee(call nodes)
    let pairings:array<Pairing> = []
    let known=false
    let paired=false
    loop argument in arguments {
        let node = hir.node_at(nodes argument)
        if node isnt? hir.Place {
            if visit_route(argument 'read' [] @params @analysis nodes type_nodes) { changed = true }
            if raw and not word_type(node.value_type type_nodes) {
                let resolved = resolve_route(argument params nodes)
                if resolved isnt? none and record(resolved.binding_id 'escape' resolved.route @params) { changed = true }
            }
            continue
        }
        # A value boundary only reads its argument. Resolve/pair the callee
        # once on the first place, where a transitive summary is relevant.
        if not paired {
            paired=true
            let targets=direct_targets(call analysis nodes)
            known=targets isnt? none
            if targets isnt? none {
                loop id in targets {
                    let target=hir.node_at(nodes id)
                    $runtime_assert target is? hir.FunctionLiteral
                    let pairs=pair_arguments(call target)
                    if pairs is? none {known=false break}
                    pairings.push(Pairing[id pairs])
                }
            }
        }
        let resolved = resolve_route(node.target params nodes)
        if resolved is? none {
            let target = hir.node_at(nodes node.target)
            if visit_children(target @params @analysis nodes type_nodes) { changed = true }
            continue
        }
        if visit_all(resolved.inner @params @analysis nodes type_nodes) { changed = true }
        if not known {
            if opaque(resolved.binding_id resolved.route @params) { changed = true }
            continue
        }
        loop pairing in pairings {
            let parameter:addr? = none
            loop pair in pairing.pairs { if pair.argument =? argument { parameter = pair.parameter break } }
            let summary:ParameterEffects? = none
            if parameter isnt? none and pairing.target in? analysis.effects {
                let callee = analysis.effects[pairing.target]
                summary = callee.params.get(parameter)
            }
            if summary is? none {
                if opaque(resolved.binding_id resolved.route @params) { changed = true }
            }
            else {
                $runtime_assert parameter isnt? none
                # The route and parameter pairing depend only on checked
                # syntax. Record the equation; solve it after all local scans.
                let transfers = analysis.transfers.get(pairing.target [])
                transfers.push(EffectTransfer[analysis.current_literal resolved.binding_id parameter resolved.route])
                analysis.transfers[pairing.target] = transfers
            }
        }
    }
    return changed
}

analyze_effects = (root:addr nodes:array<hir.AST> type_nodes:types.Table callback_targets:dict<addr array<addr>>=[] value_casts_escape:bool=true):>ProgramEffects => {
    return analyze_collected(collect(root nodes) nodes type_nodes callback_targets=callback_targets value_casts_escape=value_casts_escape)
}
analyze_collected = (analysis:Analysis nodes:array<hir.AST> type_nodes:types.Table callback_targets:dict<addr array<addr>>=[] value_casts_escape:bool=true):>ProgramEffects => {
    analysis.callback_targets=callback_targets
    analysis.value_casts_escape=value_casts_escape
    # Scan bodies/defaults once for local effects and place-call transfers.
    # Propagating summaries later never needs to revisit syntax or resolve a
    # callee again. Value boundaries contribute local reads, not transfers.
    loop id in analysis.literals {
        if id not in? analysis.effects continue
        analysis.current_literal=id
        let summary=analysis.effects[id]
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        visit(literal.body @summary.params @analysis nodes type_nodes);
        loop parameter in literal_params(literal) {
            if parameter is? hir.BoundParam {visit(parameter.value @summary.params @analysis nodes type_nodes);}
        }
        analysis.effects[id]=summary
    }
    # May-effects only add coverage. Prefix normalization and MAX_ROUTE_DEPTH
    # bound recursive routes. Value semantics give self-transfers a snapshot
    # of the source summary while the destination grows.
    let pending=analysis.literals
    let queued:set<addr>=set[]
    loop id in pending {queued.push(id)}
    loop pending.length >? 0 {
        let id=pending.pop
        queued.pop(id default=id);
        if id not in? analysis.effects continue
        let callee=analysis.effects[id]
        loop transfer in analysis.transfers.get(id []) {
            if transfer.callee_parameter not in? callee.params or transfer.caller not in? analysis.effects continue
            let caller=analysis.effects[transfer.caller]
            if translated(transfer.caller_parameter callee.params[transfer.callee_parameter] transfer.prefix @caller.params) {
                analysis.effects[transfer.caller]=caller
                if transfer.caller in? queued continue
                queued.push(transfer.caller)
                pending.push(transfer.caller)
            }
        }
    }
    let by_param:dict<addr ParameterEffects> = []
    loop summary in analysis.effects.values {
        loop binding_id in summary.params.keys {
            if binding_id in? summary.params { by_param[binding_id] = summary.params[binding_id] }
        }
    }
    return ProgramEffects[analysis.effects by_param]
}


# A scalar record may change fields without replacing its frame storage.
# Arrays qualify only when read-only: writes may detach or resize backing data.
# Placement separately excludes resource/aggregate fields and oversized owners.
preserves_storage = (summary:ParameterEffects type:addr table:types.Table):>bool => {
    if summary.escapes.length >? 0 return false
    if read_only(summary) return true
    if types.node_at(table views.structural_base(type table)) isnt? types.ObjectType return false
    loop route in summary.mutates {if route.steps.length =? 0 return false}
    loop route in summary.rebinds {if route.steps.length =? 0 return false}
    return true
}
PlaceLoans:type = const [nonescaping:set<addr> fixed_storage:set<addr>]
# Every target and repeated argument position must establish each guarantee.
# Collection already retains call sites, so this needs no extra HIR traversal.
place_loans = (analysis:Analysis summaries:ProgramEffects nodes:array<hir.AST> table:types.Table):>PlaceLoans => {
    let safe:set<addr>=set[] let unsafe:set<addr>=set[]
    let fixed:set<addr>=set[] let changed:set<addr>=set[]
    loop id in analysis.calls {
        let call=hir.node_at(nodes id)
        $runtime_assert call is? hir.FunctionCall
        let places:set<addr>=set[]
        loop arg in call.pos_args {if hir.node_at(nodes arg) is? hir.Place {places.push(arg)}}
        loop arg in call.kw_args.values {if hir.node_at(nodes arg) is? hir.Place {places.push(arg)}}
        if places.length =? 0 continue
        let targets=direct_targets(call analysis nodes)
        if targets is? none or targets.length =? 0 {
            loop place in places {unsafe.push(place)}
            continue
        }
        loop target in targets {
            let literal=hir.node_at(nodes target)
            $runtime_assert literal is? hir.FunctionLiteral
            let pairs=pair_arguments(call literal)
            let paired:set<addr>=set[]
            if pairs isnt? none {
                loop pair in pairs {
                    if pair.argument not in? places continue
                    paired.push(pair.argument)
                    let summary=if pair.parameter is? none none else summaries.by_param_binding.get(pair.parameter)
                    if summary isnt? none and summary.escapes.length =? 0 {
                        safe.push(pair.argument)
                        if preserves_storage(summary hir.node_at(nodes pair.argument).value_type table) {fixed.push(pair.argument)}
                        else {changed.push(pair.argument)}
                    } else {unsafe.push(pair.argument)}
                }
            }
            loop place in places {if place not in? paired {unsafe.push(place)}}
        }
    }
    loop place in unsafe {safe.pop(place default=place); fixed.pop(place default=place);}
    loop place in changed {fixed.pop(place default=place);}
    return PlaceLoans[safe fixed]
}

# Implicit global writes have no argument route. Share callable resolution
# with parameter effects, but solve this finite root set independently so
# bounds validation need not compute aggregate read/escape summaries.
analyze_global_writes = (root:addr nodes:array<hir.AST> globals:set<addr> registry:bindings.Registry=bindings.Registry[]):>dict<addr set<addr>> => {
    return analyze_global_writes_in([root] nodes globals registry=registry)
}
analyze_global_writes_in = (roots:array<addr> nodes:array<hir.AST> globals:set<addr> registry:bindings.Registry=bindings.Registry[]):>dict<addr set<addr>> => {
    let result:dict<addr set<addr>>=[]
    if globals.length =? 0 return result
    let analysis=collect_roots(roots nodes)
    let targets:dict<addr array<addr>>=[]
    let pending=roots
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.push(id)
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionCall {
            let function=hir.node_at(nodes node.func)
            # Native builtins have stable binding ids; hosted HIR adapters
            # may instead leave them unbound. Never infer this from spelling:
            # a user-defined __add__ can have ordinary global writes.
            let builtin_operation=false
            if function is? hir.ExpressedIdentifier {
                if function.binding_id is? none {builtin_operation=true}
                else {
                    let binding=bindings.find_binding(registry function.binding_id)
                    builtin_operation=binding isnt? none and binding.builtin
                }
            }
            let resolved:array<addr>|none=if builtin_operation or function is? hir.ArrayMethod [] else direct_targets(node analysis nodes)
            # Sorting invokes its key, including through wrappers. Those
            # ambient writes must cross the same graph as ordinary calls.
            if function is? hir.ArrayMethod and function.name =? 'sort' and 'key' in? node.kw_args {
                resolved=value_targets(node.kw_args['key'] none analysis nodes)
            }
            if resolved isnt? none {targets[id]=resolved}
            else {result[id]=globals}
        }
        hir.push_children(node @pending)
    }
    let summaries:dict<addr set<addr>>=[]
    let callers:dict<addr set<addr>>=[]
    loop id in analysis.literals {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let expressions:array<addr>=[literal.body]
        loop parameter in literal_params(literal) {
            if parameter is? hir.BoundParam {expressions.push(parameter.value)}
        }
        let writes:set<addr>=set[]
        loop expression in expressions {
            loop binding in local_effects.mutated_bindings(expression nodes) {
                if binding in? globals {writes.push(binding)}
            }
            pending=[expression]
            loop pending.length >? 0 {
                let child=pending.pop
                let node=hir.node_at(nodes child)
                # A literal's body is summarized under its own call boundary.
                if node is? hir.FunctionLiteral continue
                if node is? hir.FunctionCall {
                    if child not in? targets {writes=globals}
                    else {
                        loop callee in targets[child] {
                            let parents=callers.get(callee set[])
                            parents.push(id)
                            callers[callee]=parents
                        }
                    }
                }
                hir.push_children(node @pending)
            }
        }
        summaries[id]=writes
    }
    pending=analysis.literals
    let queued:set<addr>=set[]
    loop id in pending {queued.push(id)}
    loop pending.length >? 0 {
        let callee=pending.pop
        queued.pop(callee default=callee);
        if callee not in? summaries continue
        let incoming=summaries[callee]
        loop caller in callers.get(callee set[]) {
            if caller not in? summaries continue
            let writes=summaries[caller]
            let changed=false
            loop binding in incoming {
                if binding not in? writes {writes.push(binding) changed=true}
            }
            if not changed continue
            summaries[caller]=writes
            if caller not in? queued {queued.push(caller) pending.push(caller)}
        }
    }
    loop [call resolved] in targets {
        let writes:set<addr>=set[]
        loop callee in resolved {
            if callee not in? summaries {writes=globals break}
            loop binding in summaries[callee] {writes.push(binding)}
        }
        result[call]=writes
    }
    return result
}


# Reuse the borrow proof for fact preservation: no writes and no escape.
# Unknown callbacks and incomplete parameter pairing remain conservative.
read_only_places = (root:addr nodes:array<hir.AST> type_nodes:types.Table):>set<addr> => {
    return read_only_places_in([root] nodes type_nodes)
}
# Imported functions and generated helpers can live in different modules.
# Solve the frozen loaded graph once, then lend the result to every module.
read_only_places_in = (roots:array<addr> nodes:array<hir.AST> type_nodes:types.Table):>set<addr> => {
    let calls:array<addr>=[]
    let pending=roots
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.push(id)
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionCall {
            let has_place=false
            loop arg in node.pos_args {if hir.node_at(nodes arg) is? hir.Place {has_place=true}}
            loop arg in node.kw_args.values {if hir.node_at(nodes arg) is? hir.Place {has_place=true}}
            if has_place {calls.push(id)}
        }
        hir.push_children(node @pending)
    }
    let safe:set<addr>=set[]
    if calls.length =? 0 return safe
    let unsafe:set<addr>=set[]
    let analysis=collect_roots(roots nodes)
    let summaries=analyze_collected(analysis nodes type_nodes)
    loop id in calls {
        let call=hir.node_at(nodes id)
        $runtime_assert call is? hir.FunctionCall
        let targets=direct_targets(call analysis nodes)
        let arguments=call.pos_args
        loop arg in call.kw_args.values {arguments.push(arg)}
        loop arg in arguments {
            if hir.node_at(nodes arg) isnt? hir.Place continue
            let readonly=targets isnt? none
            if targets isnt? none {
                loop target in targets {
                    let literal=hir.node_at(nodes target)
                    $runtime_assert literal is? hir.FunctionLiteral
                    let pairs=pair_arguments(call literal)
                    let parameter:addr?=none
                    if pairs isnt? none {loop pair in pairs {if pair.argument =? arg {parameter=pair.parameter}}}
                    let summary=if parameter is? none none else summaries.by_param_binding.get(parameter)
                    if summary is? none or not read_only(summary) {readonly=false break}
                }
            }
            if readonly {safe.push(arg)} else {unsafe.push(arg)}
        }
    }
    loop arg in unsafe {safe.pop(arg default=arg);}
    return safe
}

# Captures/globals are distinct from a function's own activation. Include
# default expressions, but scan nested bodies in their own binding scope.
nonlocal_bindings=(root:addr nodes:array<hir.AST>):>set<addr>=>{
    let result:set<addr>=set[] let pending:array<addr>=[root] let seen:set<addr>=set[]
    loop pending.length>?0 {
        let id=pending.pop
        if id in? seen continue
        seen.push(id)
        let literal=hir.node_at(nodes id)
        hir.push_children(literal @pending)
        if literal isnt? hir.FunctionLiteral continue
        let local:set<addr>=set[] let reads:set<addr>=set[]
        let body:array<addr>=[literal.body] let visited:set<addr>=set[]
        loop parameter in literal_params(literal) {
            if parameter.binding_id isnt? none {local.push(parameter.binding_id)}
            if parameter is? hir.BoundParam {body.push(parameter.value)}
        }
        loop body.length>?0 {
            let item=body.pop
            if item in? visited continue
            visited.push(item)
            let node=hir.node_at(nodes item)
            if node is? hir.FunctionLiteral continue
            if node is? hir.Declare and node.binding_id isnt? none {local.push(node.binding_id)}
            else if node is? hir.IteratorExpression {
                let target=hir.node_at(nodes node.target)
                if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {local.push(target.binding_id)}
            } else if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {reads.push(node.binding_id)}
            hir.push_children(node @body)
        }
        loop binding in reads {if binding not in? local {result.push(binding)}}
    }
    return result
}

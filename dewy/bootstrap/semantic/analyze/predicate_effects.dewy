import p"../hir.dewy" as hir
import p"../bindings.dewy" as bindings

doc"""
A predicate describes the values it observed, not replacement values stored
later in a short-circuit chain. Match analyze/predicate_effects.py: collect
whole binding roots conservatively, then let the ordinary refinement visitor
extract facts only from predicates whose inputs have survived.

This is a local expression transfer, not the interprocedural effect summary.
A place argument may be written; a nested function body has not run simply
because its literal appeared. Projected writes invalidate their whole root.
"""

read_bindings = (root:addr nodes:array<hir.AST>):>set<addr> => {
    let result:set<addr> = set[]
    let pending:array<addr> = [root]
    loop pending.length >? 0 {
        let node = hir.node_at(nodes pending.pop)
        if node is? hir.FunctionLiteral continue
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none { result.push(node.binding_id) }
        hir.push_children(node @pending)
    }
    return result
}
# The same direct-write edge is useful to lifetime/storage proofs. Call-graph
# writes and proven read-only places are applied by each consuming analysis.
write_target = (node:hir.AST nodes:array<hir.AST>):>addr? => {
    if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign|hir.Place return node.target
    if node is? hir.DictStore|hir.DictRemove return node.keys
    if node is? hir.FunctionCall {
        let func=hir.node_at(nodes node.func)
        if func is? hir.ArrayMethod and func.name not=? 'join' return func.array
        if func is? hir.DictMethod and func.name in? ['add' 'clear' 'remove'] return func.dictionary
    }
    return none
}
mutated_bindings = (root:addr nodes:array<hir.AST> call_writes:dict<addr set<addr>>=[] read_only_places:set<addr>=set[]):>set<addr> => {
    let result:set<addr> = set[]
    let pending:array<addr> = [root]
    loop pending.length >? 0 {
        let id=pending.pop
        let node = hir.node_at(nodes id)
        if node is? hir.FunctionLiteral continue
        let target=write_target(node nodes)
        if node is? hir.Place and id in? read_only_places {target=none}
        if node is? hir.FunctionCall {
            loop binding in call_writes.get(id set[]) {result.push(binding)}
        }
        if target isnt? none {
            let path = bindings.access_path(target nodes facts=true dictionaries=true)
            let owner = hir.node_at(nodes path.root)
            if owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none { result.push(owner.binding_id) }
        }
        hir.push_children(node @pending)
    }
    return result
}

# A view/iterator can compact a container without changing logical members.
# Preserve membership through that operation, but do not resurrect a search
# slot observed by an earlier short-circuit operand.
compacted_bindings = (root:addr nodes:array<hir.AST>):>set<addr> => {
    let result:set<addr> = set[]
    let pending:array<addr> = [root]
    loop pending.length >? 0 {
        let node = hir.node_at(nodes pending.pop)
        if node is? hir.FunctionLiteral continue
        if node is? hir.DictView|hir.DictEntries {
            let path = bindings.access_path(node.dictionary nodes facts=true)
            let owner = hir.node_at(nodes path.root)
            if owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none { result.push(owner.binding_id) }
        }
        hir.push_children(node @pending)
    }
    return result
}

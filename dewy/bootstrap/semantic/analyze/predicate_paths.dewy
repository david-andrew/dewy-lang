$explicit_copies
import p"../hir.dewy" as hir
import p"fact_state.dewy" as facts
import p"predicate_effects.dewy" as effects

# Short-circuit proof paths, separate from evaluating a predicate's effects.
# The enclosing bounds traversal supplies the atomic transfer: comparisons,
# type tests, and function result contracts all participate through one rule.
# The callback carries its own typed analysis data by place (for route
# allocation and snapshots), without storing a function inside that record.
# Pass the existing path context to a leaf that recursively refines a
# predicate, so negation need not construct another source-arena snapshot.
# `none` means an impossible path; an empty state means no established facts.
Context:type = const [nodes:array<hir.AST> facts:facts.Context call_writes:dict<addr set<addr>>=[]]

merged_writes = (existing:set<addr> expression:addr context:Context):>set<addr> => {
    let result=existing
    loop id in effects.mutated_bindings(expression context.nodes context.call_writes) {result.push(id)}
    return result
}
join = (left:facts.State? right:facts.State? context:facts.Context):>facts.State? => {
    if left is? none return right.copy()
    if right is? none return left.copy()
    return facts.join([left.copy() right.copy()] context)
}

# On the path that reaches the right operand, the left one did not decide
# the chain. A write in the right operand makes the left predicate historical
# even though it ran first. Forget its evidence before using either proof.
let after = <Data>(state:facts.State left:addr right:addr truth:bool invalidated:set<addr> nodes:array<hir.AST> relation:facts.Context context:Context @data:Data leaf:<(state:facts.State condition:addr truth:bool context:Context @data:Data):>facts.State?>):>facts.State? => {
    let first=refine(state left not truth merged_writes(invalidated.copy right context) nodes relation context @data @leaf)
    if first is? none return none
    return refine(first right truth invalidated nodes relation context @data @leaf)
}
conjuncts = (left:addr right:addr nodes:array<hir.AST>):>array<addr> => {
    let pending:array<addr>=[right left]
    let result:array<addr>=[]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(nodes id)
        if node is? hir.ShortCircuit and node.op =? 'and' {pending.push(node.right) pending.push(node.left)}
        else {result.push(id)}
    }
    return result
}
let conjunction = <Data>(state:facts.State left:addr right:addr invalidated:set<addr> nodes:array<hir.AST> relation:facts.Context context:Context @data:Data leaf:<(state:facts.State condition:addr truth:bool context:Context @data:Data):>facts.State?>):>facts.State? => {
    let parts=conjuncts(left right nodes)
    let later:array<set<addr>>=[]
    let writes=invalidated
    let remaining=parts.length
    loop remaining >? 0 {
        remaining-=1
        $runtime_assert remaining <? parts.length
        later.push(writes.copy())
        writes=merged_writes(writes parts[remaining] context)
    }
    let current:facts.State?=state
    # A later conjunct can sharpen a bound used by an earlier one, e.g.
    # start <= last and last < text.length. Both passes describe the final
    # values; neither pass can resurrect facts invalidated by a later write.
    loop pass in 0..1 {
        let index:addr=0
        loop index <? parts.length {
            let reverse=parts.length-index-1
            $runtime_assert reverse <? later.length
            if current is? none return none
            current=refine(current parts[index] true later[reverse] nodes relation context @data @leaf)
            index+=1
        }
    }
    return current
}

# The `leaf` callback is not resolved by the storage proofs, so `state` and
# `context` count as exposed: each step passes or returns its own copy of the
# state. The node arena and fact context travel separately (`nodes`,
# `relation`, never given to `leaf`) so that they stay borrowed views.
let refine = <Data>(state:facts.State condition:addr truth:bool invalidated:set<addr> nodes:array<hir.AST> relation:facts.Context context:Context @data:Data leaf:<(state:facts.State condition:addr truth:bool context:Context @data:Data):>facts.State?>):>facts.State? => {
    let node=hir.node_at(nodes condition)
    if node is? hir.Block and not node.scoped and node.items.length =? 1 {
        return refine(state.copy() node.items[0] truth invalidated nodes relation context @data @leaf)
    }
    if node is? hir.ShortCircuit {
        if node.op =? 'and' or node.op =? 'nand' {
            let effective=if node.op =? 'and' truth else not truth
            if effective return conjunction(state.copy() node.left node.right invalidated.copy() nodes relation context @data @leaf)
            return join(refine(state.copy() node.left false invalidated nodes relation context @data @leaf) after(state.copy() node.left node.right false invalidated nodes relation context @data @leaf) relation)
        }
        if node.op =? 'or' or node.op =? 'nor' {
            let effective=if node.op =? 'or' truth else not truth
            if not effective {
                let first=refine(state.copy() node.left false merged_writes(invalidated.copy node.right context) nodes relation context @data @leaf)
                if first is? none return none
                return refine(first node.right false invalidated nodes relation context @data @leaf)
            }
            return join(refine(state.copy() node.left true invalidated nodes relation context @data @leaf) after(state.copy() node.left node.right true invalidated nodes relation context @data @leaf) relation)
        }
        # XOR/XNOR retain the hosted conservative treatment here. Their
        # evaluation is defined; deriving stronger proof paths is later work.
        return state.copy()
    }
    if invalidated.length >? 0 {
        loop binding in effects.read_bindings(condition nodes) {
            if binding in? invalidated return state.copy()
        }
    }
    if node is? hir.Bool return if node.value =? truth state.copy() else none
    return leaf(state.copy() condition truth context @data)
}

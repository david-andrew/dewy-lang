import p"intervals.dewy" as ranges
import p"../propositions.dewy" as propositions

doc"""
The bounds pass's relational fact store.

Facts keep their complete kind and terms. An integer hash selects a bucket;
structural equality decides identity, including collisions. No binding bits
are discarded and a value and its length remain distinct. Formatting a fact
is reserved for diagnostics, rather than allocating text for every lookup.

A missing entry means no evidence. Vacuous is different: every predicate
about an element of an empty array holds. It participates in joins as the
absence of a constraint, never as an unknown numeric range.
"""

Term:type = const [binding_id:addr projection:propositions.Projection='value']
Fact = $abstract type of [hash:uint64]
Value = type of Fact & [term:Term]
Index = type of Fact & [index:addr sequence:addr]
Nonzero = type of Fact & [subject:addr]
Order = type of Fact & [smaller:Term larger:Term]
Remainder = type of Fact & [subject:Term upper:Term offset:addr]
Entry:type = const [fact:Fact interval:ranges.Interval]
State:type = [values:array<Entry>=[] buckets:dict<uint64 array<addr>>=[]]
Vacuous = type of []
Evidence:type = ranges.Interval | Vacuous | none
Context:type = [
    cap:bigint
    # Declared scalar contracts constrain loop widening. An element route's
    # root records which array makes its predicates vacuous when empty.
    widths:dict<addr ranges.Interval>=[]
    element_roots:dict<addr addr>=[]
]
term_key = (term:Term):>string => "{term.projection}:{term.binding_id}"
same_term = (left:Term right:Term):>bool => left.binding_id =? right.binding_id and left.projection =? right.projection
mix = (left:uint64 right:uint64):>uint64 => (left xor right)*1099511628211
term_hash = (term:Term):>uint64 => mix((if term.projection =? 'value' 1 else 2) term.binding_id as uint64)
value = (term:Term):>Value => Value[mix(1 term_hash(term)) term]
index = (subject:addr sequence:addr):>Index => Index[mix(mix(2 subject as uint64) sequence as uint64) subject sequence]
nonzero = (subject:addr):>Nonzero => Nonzero[mix(3 subject as uint64) subject]
order = (smaller:Term larger:Term):>Order => Order[mix(mix(4 term_hash(smaller)) term_hash(larger)) smaller larger]
remainder = (subject:Term upper:Term offset:addr):>Remainder => Remainder[mix(mix(mix(5 term_hash(subject)) term_hash(upper)) offset as uint64) subject upper offset]

same = (left:Fact right:Fact):>bool => {
    if left is? Value and right is? Value return same_term(left.term right.term)
    if left is? Index and right is? Index return left.index =? right.index and left.sequence =? right.sequence
    if left is? Nonzero and right is? Nonzero return left.subject =? right.subject
    if left is? Order and right is? Order return same_term(left.smaller right.smaller) and same_term(left.larger right.larger)
    if left is? Remainder and right is? Remainder return same_term(left.subject right.subject) and same_term(left.upper right.upper) and left.offset =? right.offset
    return false
}
describe = (fact:Fact):>string => {
    if fact is? Value return "v:{term_key(fact.term)}"
    if fact is? Index return "i:{fact.index}:{fact.sequence}"
    if fact is? Nonzero return "n:{fact.subject}"
    if fact is? Order return "o:{term_key(fact.smaller)}:{term_key(fact.larger)}"
    if fact is? Remainder return "r:{term_key(fact.subject)}:{term_key(fact.upper)}:{fact.offset}"
    return '?'
}

# The dense entries support the solver's scans. Buckets store positions,
# which remain private to this state and are repaired when removal moves
# the last entry. Copies of a state keep both arrays and indexes together.
# Removal can reorder the entries; proof-state equality compares facts,
# never their positions. Construct facts through the factories above so
# equal descriptions always choose the same bucket.
find = (state:State fact:Fact):>addr? => {
    if fact.hash not in? state.buckets return none
    loop position in state.buckets[fact.hash] {
        $runtime_assert position <? state.values.length
        if same(state.values[position].fact fact) return position
    }
    return none
}
contains = (state:State fact:Fact):>bool => find(state fact) isnt? none

lookup = (state:State fact:Fact):>ranges.Interval? => {
    let position = find(state fact)
    if position is? none return none
    $runtime_assert position <? state.values.length
    return state.values[position].interval
}
put = (@state:State fact:Fact interval:ranges.Interval):>void => {
    let position=find(state fact)
    if position isnt? none {
        $runtime_assert position <? state.values.length
        state.values[position]=Entry[fact interval]
        return
    }
    let bucket=state.buckets.get(fact.hash default=[])
    bucket.push(state.values.length)
    state.values.push(Entry[fact interval])
    state.buckets[fact.hash]=bucket
}
remove = (@state:State fact:Fact):>void => {
    let position=find(state fact)
    if position is? none return
    $runtime_assert position <? state.values.length and fact.hash in? state.buckets
    let bucket=state.buckets[fact.hash]
    loop i in 0.. and i <? bucket.length {
        if bucket[i] =? position {bucket.pop(idx=i); break}
    }
    if bucket.length =? 0 {state.buckets.pop(fact.hash);}
    else {state.buckets[fact.hash]=bucket}
    $runtime_assert state.values.length >? 0
    let last=state.values.pop
    if position <? state.values.length {
        state.values[position]=last
        $runtime_assert last.fact.hash in? state.buckets
        let moved=state.buckets[last.fact.hash]
        loop i in 0.. and i <? moved.length {
            if moved[i] =? state.values.length {moved[i]=position break}
        }
        state.buckets[last.fact.hash]=moved
    }
}
set_value = (@state:State term:Term interval:ranges.Interval?):>void => {
    let fact = value(term)
    if interval is? none or ranges.same_bounds(interval ranges.UNKNOWN) {
        remove(@state fact)
    }
    else { put(@state fact interval) }
}
known = (state:State term:Term context:Context):>ranges.Interval? => {
    let found = lookup(state value(term))
    if found isnt? none return found
    if term.projection =? 'length' return ranges.Interval[0 context.cap true]
    return none
}

# Whole-value writes remove facts that mention that value; length changes
# remove relations to the sequence's length. Element writes may leave length
# alone. The caller selects the changed term from the storage route.
mentions = (fact:Fact term:Term):>bool => {
    if fact is? Value return same_term(fact.term term)
    if fact is? Nonzero return term.projection =? 'value' and fact.subject =? term.binding_id
    if fact is? Index {
        return (term.projection =? 'value' and fact.index =? term.binding_id) or (term.projection =? 'length' and fact.sequence =? term.binding_id)
    }
    if fact is? Order return same_term(fact.smaller term) or same_term(fact.larger term)
    if fact is? Remainder {
        return same_term(fact.subject term) or same_term(fact.upper term) or (term.projection =? 'value' and fact.offset =? term.binding_id)
    }
    return false
}
forget = (@state:State term:Term):>void => {
    let removed:array<Fact> = []
    loop entry in state.values { if mentions(entry.fact term) { removed.push(entry.fact) } }
    loop fact in removed { remove(@state fact) }
}

# The caller records the new length separately. Both order and remainder
# gaps describe `upper - subject`, with an unchanged scalar offset for a
# remainder. The lower bound on that gap changes by the least possible
# contribution of the sequence's length change.
change_length = (@state:State sequence:addr change:ranges.Interval):>void => {
    let term = Term[sequence 'length']
    let entries = state.values
    loop entry in entries {
        let fact = entry.fact
        if fact is? Index and fact.sequence =? sequence {
            if change.lower is? none or change.lower <? 0 {
                remove(@state fact)
            }
            continue
        }
        let subject:Term? = none
        let upper:Term? = none
        if fact is? Order { subject = fact.smaller upper = fact.larger }
        else if fact is? Remainder { subject = fact.subject upper = fact.upper }
        if subject is? none or upper is? none continue
        let subtract = same_term(subject term)
        let add = same_term(upper term)
        if subtract =? add continue  # absent from both, or cancels itself
        let adjustment:bigint? = none
        if add { adjustment = change.lower }
        else if change.upper isnt? none { adjustment = -change.upper }
        let lower = entry.interval.lower
        if lower is? none or adjustment is? none {
            remove(@state fact)
        } else { put(@state fact ranges.Interval[lower+adjustment none]) }
    }
}

vacuous = (state:State fact:Fact context:Context):>bool => {
    let subject:Term? = none
    if fact is? Remainder { subject = fact.subject }
    else if fact is? Order { subject = fact.smaller }
    else if fact is? Index { subject = Term[fact.index] }
    else if fact is? Nonzero { subject = Term[fact.subject] }
    if subject is? none or subject.projection not=? 'value' return false
    let root = context.element_roots.get(subject.binding_id)
    if root is? none return false
    let length = lookup(state value(Term[root 'length']))
    return length isnt? none and ranges.same_bounds(length ranges.exact(0))
}
implied = (state:State fact:Fact context:Context):>Evidence => {
    if vacuous(state fact context) return Vacuous
    if fact isnt? Order return none
    let smaller = known(state fact.smaller context)
    let larger = known(state fact.larger context)
    if smaller is? none or larger is? none or smaller.upper is? none or larger.lower is? none return none
    let gap = larger.lower - smaller.upper
    if gap <? 0 return none
    return ranges.Interval[gap none]
}
evidence = (state:State fact:Fact context:Context):>Evidence => {
    let found = lookup(state fact)
    if found isnt? none return found
    return implied(state fact context)
}

join = (states:array<State> context:Context):>State => {
    let candidates=State[]
    loop state in states { loop entry in state.values { put(@candidates entry.fact entry.interval) } }
    let result=State[]
    loop candidate in candidates.values {
        let combined:ranges.Interval? = none
        let present:bool = true
        loop state in states {
            let part = evidence(state candidate.fact context)
            if part is? none { present = false break }
            if part is? Vacuous continue
            if combined is? none { combined = part }
            else { combined = ranges.union(combined part) }
        }
        if present { put(@result candidate.fact if combined is? none candidate.interval else combined) }
    }
    return result
}
narrow = (head:State candidate:State context:Context):>State => {
    let result=State[]
    loop entry in head.values {
        let other = evidence(candidate entry.fact context)
        if other is? none continue
        if other is? Vacuous { put(@result entry.fact entry.interval) }
        else { put(@result entry.fact ranges.intersect(entry.interval other)) }
    }
    return result
}
widen = (previous:State current:State context:Context):>State => {
    let result=State[]
    loop entry in current.values {
        let old = lookup(previous entry.fact)
        if old is? none {
            let implicit = implied(previous entry.fact context)
            if implicit is? Vacuous { put(@result entry.fact entry.interval) }
            else if implicit isnt? none { put(@result entry.fact ranges.widen(implicit entry.interval)) }
            continue
        }
        let interval = ranges.widen(old entry.interval)
        let fact = entry.fact
        if fact is? Value {
            if fact.term.projection =? 'length' {
                let lower:bigint = 0
                let upper = context.cap
                if interval.lower isnt? none { lower = interval.lower }
                if interval.upper isnt? none { upper = interval.upper }
                interval = ranges.Interval[lower upper]
            }
            else {
                let width = context.widths.get(fact.term.binding_id)
                if width isnt? none { interval = ranges.intersect(interval width) }
            }
        }
        put(@result fact interval)
    }
    return result
}

# Preserve the same affine relations as the hosted pass. Other relations
# are forgotten by the assignment, then this set is restored. In particular,
# a weakening that makes the known gap negative supplies no bound to retain.
shifted = (state:State term:Term shift:bigint):>State => {
    let result=State[]
    loop entry in state.values {
        if entry.interval.lower is? none continue
        let fact = entry.fact
        let eligible:bool = false
        if fact is? Order { eligible = same_term(fact.smaller term) }
        if fact is? Remainder { eligible = term.projection =? 'value' and fact.offset =? term.binding_id }
        let gap = entry.interval.lower - shift
        if eligible and gap >=? 0 { put(@result fact ranges.Interval[gap none]) }
    }
    return result
}

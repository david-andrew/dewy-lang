from reporting import Span
import p"../hir.dewy" as hir
import p"../ty.dewy" as types
import p"../type_queries.dewy" as views
import p"../bindings.dewy" as bindings
import p"hir_facts.dewy" as expressions
import p"value_bounds.dewy" as values
import p"expression_intervals.dewy" as intervals
import p"predicate_facts.dewy" as predicates
import p"refinement_facts.dewy" as refinements
import p"element_facts.dewy" as elements
import p"term_facts.dewy" as terms
import p"fact_state.dewy" as facts
import p"relations.dewy" as relations
import p"intervals.dewy" as ranges

note_element_routes = (array:addr @data:predicates.Data):>void => {
    let known=data.relations.facts.element_roots
    let before=known.length
    elements.note_roots(array @known data.registry)
    if known.length not=? before {data.relations=relations.with_element_roots(data.relations known)}
}

doc"""
Transfer an evaluated value's evidence into named storage.

Assignments first discard the destination's old identity and projected
routes, then install the observed value and its surviving relationships.
The snapshot contains values already evaluated by the visitor: this module
never evaluates an initializer again to recover an interval.

A copied array or record owns its evidence too. Later replacement of the
source loses source relationships without erasing the copy's own promises.
"""

# Selection identity follows a mutable index only until that index changes.
# Keep this separate from the selector's own relational induction facts.
forget_selected = (@state:facts.State subject:addr @data:predicates.Data):>void => {
    loop dependent in data.registry.index_routes.get(subject set[]) {
        forget(@state dependent @data)
        let route=bindings.route_at(data.registry dependent)
        if route isnt? none {forget(@state route.root @data prefix=route.path)}
    }
}

forget = (@state:facts.State subject:addr @data:predicates.Data prefix:array<string>=[] keep_length:addr?=none):>void => {
    if prefix.length =? 0 {
        forget_selected(@state subject @data)
        facts.forget(@state facts.Term[subject])
        if subject not=? keep_length {facts.forget(@state facts.Term[subject 'length'])}
        intervals.forget(@data.snapshot subject)
        if subject in? data.member_calls {data.member_calls.pop(subject); }
    }
    loop route in data.registry.routes_by_root.get(subject []) {
        if bindings.path_starts_with(route.path prefix) {
            # Element evidence can itself be rooted at a projected sequence.
            # Invalidating its parent must remove that derived evidence too.
            forget(@state route.id @data keep_length=keep_length)
        }
    }
}

# A lexical scope can retire all its locals in one state scan. Follow both
# nested routes and routes selected by a retired index before removing any
# facts, matching repeated `forget` without cloning/scanning per binding.
forget_many = (@state:facts.State subjects:set<addr> @data:predicates.Data keep_lengths:set<addr>=set[]):>void => {
    if subjects.length =? 0 return
    let expired:set<addr>=set[]
    let pending:array<addr>=[]
    loop subject in subjects {pending.push(subject)}
    loop pending.length >? 0 {
        let subject=pending.pop
        if subject in? expired continue
        expired.push(subject)
        loop route in data.registry.routes_by_root.get(subject []) {pending.push(route.id)}
        loop dependent in data.registry.index_routes.get(subject set[]) {
            pending.push(dependent)
            let route=bindings.route_at(data.registry dependent)
            if route isnt? none {
                loop selected in bindings.routes_under(data.registry route.root route.path) {pending.push(selected)}
            }
        }
    }
    facts.forget_bindings(@state expired keep_lengths=keep_lengths)
    intervals.forget_many(@data.snapshot expired)
    loop subject in expired {data.member_calls.pop(subject default=0);}
}

# Bind a checked call result's concrete and symbolic promises. A mutated
# argument can still supply its saved interval, but never a current identity.
call_result = (@state:facts.State subject:addr value:addr @data:predicates.Data):>void => {
    loop result_id in expressions.call_result_refinements(value data.env.nodes data.env.types) {
        let result=types.node_at(data.env.types result_id)
        $runtime_assert result is? types.RefinedType
        loop p in result.propositions {
            if p.term is? none or p.subject not=? 'self' or p.term_projection not=? 'length' continue
            let argument=expressions.call_argument(value p.term data.env.nodes data.env.types)
            if argument is? none continue
            let length=data.snapshot.lengths.get(argument)
            if length is? none continue
            let bound=ranges.constraint(p.op length true)
            if bound isnt? none {
                facts.set_value(@state facts.Term[subject] intervals.meet(facts.lookup(state facts.value(facts.Term[subject])) bound))
            }
        }
    }
    if not intervals.stable(value data.snapshot data.env.nodes places=true) return
    # A disequality has no chosen direction. Only substitute arguments whose
    # identity survived evaluation, just as for ordinary ordered promises.
    loop result_id in expressions.call_result_refinements(value data.env.nodes data.env.types) {
        let result=types.node_at(data.env.types result_id)
        $runtime_assert result is? types.RefinedType
        loop p in result.propositions {
            if p.op not=? 'not=?' or p.term is? none or (p.subject not=? 'self' and p.subject not=? 'length') continue
            let supplied=expressions.call_argument(value p.term data.env.nodes data.env.types)
            if supplied is? none continue
            let argument=expressions.strip_casts(supplied data.env.nodes)
            let bound:facts.Term?=none
            if p.term_projection =? 'length' {
                let sequence=terms.sequence_id(argument data.env @data.registry)
                if sequence isnt? none {bound=facts.Term[sequence 'length']}
            } else {bound=terms.binding_term(argument data.env @data.registry)}
            if bound isnt? none {facts.put(@state facts.distinct(facts.Term[subject (if p.subject =? 'length' 'length' else 'value')] bound) ranges.exact(1))}
        }
    }
    terms.seed(@state facts.Term[subject] terms.value_facts(value state data.relations data.env @data.registry) data.relations)
    terms.seed(@state facts.Term[subject 'length'] terms.call_facts(value 'length' data.env @data.registry) data.relations)
}

seed = (@state:facts.State subject:addr value:addr word_type:addr loc:Span @data:predicates.Data):>void => {
    # A block's value is its last item (a loop capture's hidden array).
    value=expressions.value_leaf(value data.env.nodes)
    let copied=hir.node_at(data.env.nodes expressions.strip_casts(value data.env.nodes))
    if copied is? hir.CopyValue {
        seed(@state subject copied.value word_type loc @data)
        return
    }
    call_result(@state subject value @data)
    if copied is? hir.ArrayLiteral {
        elements.literal_lengths(@state subject copied word_type loc data.env @data.registry)
        note_element_routes(subject @data)
    }
    if not intervals.stable(value data.snapshot data.env.nodes) return
    if copied is? hir.FunctionCall {
        terms.seed_sum(@state subject value intervals.mathematical(value state data.snapshot data.env) data.env data.relations @data.registry)
    }
    let sum=intervals.checked_sum(value data.snapshot data.env @data.registry)
    if sum isnt? none and sum.left isnt? none and sum.right isnt? none and sum.left.binding_id not=? subject and sum.right.binding_id not=? subject {
        if sum.right.projection =? 'value' {facts.put(@state facts.remainder(sum.left facts.Term[subject] sum.right.binding_id) ranges.Interval[0 none])}
        else if sum.left.projection =? 'value' {facts.put(@state facts.remainder(sum.right facts.Term[subject] sum.left.binding_id) ranges.Interval[0 none])}
    }
    let id=expressions.strip_casts(value data.env.nodes)
    let node=hir.node_at(data.env.nodes id)
    let target=facts.Term[subject]
    if node is? hir.StringSlice {
        let source=data.snapshot.sequences.get(node.string)
        if source isnt? none {facts.put(@state facts.order(facts.Term[subject 'length'] facts.Term[source 'length']) ranges.Interval[0 none])}
        let range=hir.node_at(data.env.nodes node.range)
        $runtime_assert range is? hir.Range
        if range.left is? none and range.right isnt? none {
            let limit=data.snapshot.terms.get(range.right)
            if limit isnt? none and limit.term.projection =? 'value' and limit.shift =? 0 {
                let extra:bigint=if range.bounds is? none or range.bounds.endswith(']') 1 else 0
                facts.put(@state facts.order(limit.term facts.Term[subject 'length']) ranges.Interval[extra none])
                facts.put(@state facts.order(facts.Term[subject 'length'] limit.term) ranges.Interval[-extra none])
            }
        }
        return
    }
    let saved=data.snapshot.terms.get(value)
    if expressions.sequence_of(id data.env.nodes) isnt? none and saved isnt? none {
        if saved.shift =? 0 {relations.copy_relational(@state saved.term target)}
        facts.put(@state facts.order(target saved.term) ranges.Interval[-saved.shift none])
        facts.put(@state facts.order(saved.term target) ranges.Interval[saved.shift none])
        return
    }
    if node is? hir.ExpressedIdentifier|hir.MemberAccess and saved isnt? none and saved.shift =? 0 {
        relations.copy_relational(@state saved.term target)
        # A scalar snapshot equals the source until one endpoint changes.
        # Casts require their own representation proof; do not erase them here.
        let transparent=value
        loop true {
            let wrapper=hir.node_at(data.env.nodes transparent)
            if wrapper isnt? hir.Obligation break
            transparent=wrapper.value
        }
        if id =? transparent and views.fixed_integer_layout(types.strip_refinement(node.value_type data.env.types) data.env.types) isnt? none {
            facts.put(@state facts.order(saved.term target) ranges.Interval[0 none])
            facts.put(@state facts.order(target saved.term) ranges.Interval[0 none])
        }
        let sequence=data.snapshot.sequences.get(value)
        if sequence isnt? none {relations.copy_relational(@state facts.Term[sequence 'length'] facts.Term[subject 'length'])}
        if node is? hir.ExpressedIdentifier {
            elements.copy(@state saved.term.binding_id subject word_type loc @data.registry)
            note_element_routes(subject @data)
            # Snapshot the routes before allocating copies of them.
            let routes=data.registry.routes_by_root.get(saved.term.binding_id [])
            loop route in routes {
                if route.path.length >? 0 and route.path[0] not=? '*' {
                    let copied=bindings.route_id(@data.registry subject route.path word_type loc)
                    let number=facts.lookup(state facts.value(facts.Term[route.id]))
                    if number isnt? none {facts.set_value(@state facts.Term[copied] number)}
                    let length=facts.lookup(state facts.value(facts.Term[route.id 'length']))
                    if length isnt? none {facts.set_value(@state facts.Term[copied 'length'] length)}
                    relations.copy_relational(@state facts.Term[route.id] facts.Term[copied])
                    relations.copy_relational(@state facts.Term[route.id 'length'] facts.Term[copied 'length'])
                }
            }
        }
        return
    }
    let element=elements.route_of(id data.env @data.registry)
    if element isnt? none {relations.copy_relational(@state facts.Term[element] target)}
    if node is? hir.Index {
        let source=data.snapshot.sequences.get(node.array)
        if source isnt? none {elements.read(@state source subject word_type loc @data.registry) note_element_routes(source @data)}
    }
}

# Field defaults may depend on earlier fields. The visitor records those
# values in source order; here they become the completed record's routes.
fields = (@state:facts.State root:addr declared:types.ObjectType value:addr path:array<string> @data:predicates.Data):>void => {
    let literal=hir.node_at(data.env.nodes expressions.strip_casts(value data.env.nodes))
    if literal isnt? hir.ObjectLiteral return
    loop actual in literal.fields {
        let field=types.object_field(declared actual.name)
        if field is? none continue
        let route=path
        route.push(actual.name)
        let nested=expressions.object_of(field.value_type data.env.types)
        if nested isnt? none {
            let shape=types.node_at(data.env.types nested)
            $runtime_assert shape is? types.ObjectType
            fields(@state root shape actual.value route @data) continue
        }
        let scalar=data.snapshot.numbers.get(actual.value)
        let length=data.snapshot.lengths.get(actual.value)
        if scalar is? none and length is? none continue
        let subject=bindings.route_id(@data.registry root route field.value_type actual.loc)
        if scalar isnt? none {facts.set_value(@state facts.Term[subject] scalar)}
        if length isnt? none {facts.set_value(@state facts.Term[subject 'length'] length)}
    }
}

install = (@state:facts.State subject:addr value:addr annotation:addr? word_type:addr loc:Span @declared:refinements.Declared @data:predicates.Data context:refinements.Context):>void => {
    facts.set_value(@state facts.Term[subject] data.snapshot.numbers.get(value))
    let length=data.snapshot.lengths.get(value)
    if length isnt? none {
        let known=facts.lookup(state facts.value(facts.Term[subject 'length']))
        facts.set_value(@state facts.Term[subject 'length'] intervals.meet(known length))
    }
    if annotation isnt? none {
        let contract=types.node_at(data.env.types annotation)
        if contract is? types.RefinedType {
            refinements.seed_binding(@state @declared subject contract context loc @data.registry)
        }
    }
    let object=expressions.object_of(if annotation is? none hir.node_at(data.env.nodes value).value_type else annotation data.env.types)
    if object isnt? none {
        let shape=types.node_at(data.env.types object)
        $runtime_assert shape is? types.ObjectType
        fields(@state subject shape value [] @data)
    }
    seed(@state subject value word_type loc @data)
    let called=expressions.call_result_type(value data.env.nodes data.env.types)
    if called isnt? none and types.node_at(data.env.types called) is? types.TypeOr {data.member_calls[subject]=expressions.strip_casts(value data.env.nodes)}
}

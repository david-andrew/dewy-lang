import p"effect_rows.dewy" as effect_rows
import p"propositions.dewy" as facts

doc"""
Type expressions and their Boolean algebra, corresponding to semantic/ty.py.

Types describe values; void and untyped describe expression/checking states
and do not participate in the value-type hierarchy. In particular, noreturn
is a control-flow guarantee, not a may-effect or an alternative to never.

The table interns completed descriptions. References are stable indices, so
recursive aliases can later refer to a separately resolved binding without
constructing cyclic mutable objects. A key encodes structure, not subtyping:
union construction preserves order, while a semantic join may absorb members.
"""

# `key` identifies a stored description, including declaration metadata.
# `shape` overrides that key for structural equality. Defaults, method bodies,
# and resolved proof bindings must survive interning even though the hosted
# language deliberately excludes them from type equality.
# Both keys are local to a table: child shapes refer to canonical structural
# ids, so a shared child graph is not serialized again into every parent.
# Only intern assigns shape_id; it is not a stored-description index.
Type = $abstract type of [key:string shape:string?=none shape_id:addr=0]
Primitive = type of Type & [name:string]
TypeAnd = type of Type & [items:array<addr>]
TypeOr = type of Type & [items:array<addr>]
TypeNot = type of Type & [item:addr]
TypeParameterize = type of Type & [head:addr args:array<addr>]
TypeVariable = type of Type & [name:string bound:addr]
SequenceType = type of Type & [items:array<addr>]
ArrayType = type of Type & [element:addr length:addr?=none]
StringType = type of Type & [length:addr?=none]
# Literal values must span the full language integer domain even while the
# seed compiler cannot yet choose a bigint representation for an abstract-int
# object field. This explicit representation does not cap source literals.
IntegerLiteralType = type of Type & [value:bigint]
StringLiteralType = type of Type & [value:string]
BinaryLiteralType = type of Type & [value:array<uint8>]
RationalLiteralType = type of Type & [numerator:bigint denominator:bigint & ~0]

# Dimensions are compile-time data with no runtime representation. Zero
# exponents disappear and powers are sorted by name. A quantity keeps the
# chosen numeric representation separate from its dimension.
DimensionPower:type = const [name:string exponent:bigint]
DimensionType = type of Type & [powers:array<DimensionPower>]
QuantityType = type of Type & [number:addr dimension:addr]

# These slots describe a callable's accepted shape, not the parameters of a
# checked function body. A missing name means position-only; a default makes
# a slot optional. Place arguments must agree exactly on both sides of a
# callable relation, since the callee may write through them.
PosOrKwArg:type = const [name:string? value_type:addr required:bool=true place:bool=false]
KwOnlyArg:type = const [name:string value_type:addr required:bool place:bool=false]
GenericParam:type = const [name:string bound:addr kind:'type'|'effect'='type' identity:string='']
# An alias is a compile-time constructor, not an atom in the value-type
# hierarchy. Its body and bounds refer into the ordinary type arena.
GenericTypeAlias:type = const [params:array<GenericParam> body:addr]
TypeAliasValue:type = addr | GenericTypeAlias
FunctionType = type of Type & [
    pos_or_kw:array<PosOrKwArg>
    kw_only:array<KwOnlyArg>
    rest:string?
    ret:addr
    type_params:array<GenericParam>
    effects:effect_rows.Contract?=none
]
# Alternatives retain declaration order. Dispatch later records which one
# won, so lowering never has to infer a function's identity from its shape.
OverloadType = type of Type & [methods:array<addr>]
CallableType:type = FunctionType | OverloadType

ObjectField:type = const [
    name:string value_type:addr mutable:bool=true
    # Compilation SyntaxRef id, retaining source and lexical scope; evaluated
    # only when a constructor needs this default.
    default:addr?=none
    # Field invariants are proved on construction/store and assumed on read.
    refinement:array<facts.Proposition>=[]
]
MethodSpec:type = const [
    name:string literal:addr binding_id:addr?=none place_self:bool=false
    # An inherited method compiles once, for its declaring owner.
    owner:string?=none static:bool=false
    # Compiler-only lifecycle operation; not an ordinary callable member.
    lifecycle:string?=none
]
ObjectType = type of Type & [
    fields:array<ObjectField> brand:string?=none
    methods:array<MethodSpec>=[] constructors:array<addr>=[]
    # const records preserve sibling-field invariants for their lifetime.
    immutable:bool=false
    # Minting metadata belongs to this compilation, not process globals.
    # A root mint points at its unbranded source structure; child mints point
    # at their nominal parent. Compiler families such as dict are not mints.
    minted:bool=false parent:addr?=none abstract:bool=false
]
PathType = type of ObjectType
PathLiteralType = type of PathType & [value:string]
RefinedType = type of Type & [base:addr propositions:array<facts.Proposition>]
NamedType = type of Type & [name:string alias_id:addr target:addr?=none]
MetaType = type of Type & [family:addr]
ModuleField:type = const [name:string value_type:addr binding_id:addr type_value:TypeAliasValue?=none]
ModuleType = type of Type & [fields:array<ModuleField>]

# A clause is a conjunction of signed atoms; the outer list is a disjunction.
# No clauses means never. One empty clause means any. Negation stops at atoms:
# it must not turn array<T> into array<~T> or negate a function's parameters.
SignedAtom:type = [positive:bool item:addr]
Clause:type = [literals:array<SignedAtom>]

# The descriptions and their lookup index are one value. Forking or clearing
# an arena therefore forks or clears both; a process-global hint could refer
# to another arena and forced a full scan on every newly encountered type.
# Mutations go through intern, truncate, and resolve_alias (which preserves
# the key). Description ids remain stable for the retained prefix.
Table:type = [
    entries:array<Type>=[] positions:dict<string addr>=[]
    # Skip public-effect validation entirely until a source contract exists.
    effect_contracts:bool=false
    # Completed descriptions are stable: normalize each tree once per arena.
    # Alias resolution only changes the target of an atomic NamedType.
    normal_forms:dict<addr addr>=[]
    # These queries depend only on retained descriptions, never alias targets
    # or the inheritance graph. Drop their ids on speculative truncation.
    combinations:dict<string addr>=[]
    positional_functions:dict<string addr>=[]
    # Exact compact structural keys, never hash-only equality. Keep these ids
    # across truncation: retained keys can name discarded child descriptions,
    # and an id must never acquire a different meaning when entries are reused.
    # Forking a table forks this index with it; keys are not portable between
    # independent tables. Its lifetime is one compilation's type arena.
    shape_positions:dict<string addr>=[]
    # Primitive names already identify their descriptions. Avoid quoting and
    # assembling a storage key on the many scalar lookups during lowering.
    primitives:dict<string addr>=[]
]


node_at = (nodes:Table id:addr):>Type => {
    $runtime_assert id <? nodes.entries.length
    return nodes.entries[id]
}

shape_of = (id:addr nodes:Table):>string => {
    # Read only the identity fields. Returning a complete Type from node_at
    # would copy its potentially large argument/field tables for this query.
    $runtime_assert id <? nodes.entries.length
    let shape=nodes.entries[id].shape
    return if shape is? none nodes.entries[id].key else shape
}
# Canonical ids compare exact structure within this arena. Stored ids alone
# differ when defaults/method bodies/proof provenance need separate entries.
same_type = (a:addr b:addr nodes:Table):>bool => {
    if a =? b return true
    $runtime_assert a <? nodes.entries.length and b <? nodes.entries.length
    return nodes.entries[a].shape_id =? nodes.entries[b].shape_id
}
# A parent encodes each child once as an interned structural reference. Two
# fields pointing at the same child must not double a recursively serialized
# description at every level. Delimiters remain unambiguous for literal data.
component = (value:string):>string => "{value.length}:{value}"
shape_reference = (id:addr nodes:Table):>string => {
    $runtime_assert id <? nodes.entries.length
    return "{nodes.entries[id].shape_id}"
}
shapes_key = (items:array<addr> nodes:Table):>string => {
    let parts:array<string> = []
    loop id in items { parts.push(component(shape_reference(id nodes))) }
    return parts.join(',')
}
contains_type = (items:array<addr> id:addr nodes:Table):>bool => {
    loop other in items { if same_type(other id nodes) return true }
    return false
}


# Factories probe the storage key before constructing a shape or description.
# Even a compact shape needs field/parameter walks; producing it again on an
# intern hit turns cheap type queries into allocations and repeated work.
# The arena owns this index, so forks and truncation also govern factory hits.
# Keep declaration metadata in the key: structural equality alone cannot
# authorize reusing defaults, methods, or resolved proof bindings.
#
# Return evidence about the current table on both paths, including reuse.
intern = (@nodes:Table value:Type):>addr<i => i <? nodes.entries.length> => {
    let known=nodes.positions.get(value.key)
    if known isnt? none {
        $runtime_assert known <? nodes.entries.length
        return known
    }
    let shape=if value.shape is? none value.key else value.shape
    let found=nodes.shape_positions.get(shape)
    let structural=if found is? none nodes.shape_positions.length else found
    if found is? none {nodes.shape_positions[shape]=structural}
    value.shape_id=structural
    let id=nodes.entries.length
    nodes.entries.push(value)
    nodes.positions[value.key]=id
    return id
}

# Speculative checking discards a suffix. Remove only that suffix's index
# entries so subsequent insertion can reuse the positions without stale keys.
truncate = (@nodes:Table count:addr):>void => {
    $runtime_assert count <=? nodes.entries.length
    if count =? nodes.entries.length return
    let i=count
    loop i <? nodes.entries.length {
        nodes.positions.pop(nodes.entries[i].key default=0);
        i+=1
    }
    nodes.entries.truncate(count)
    # A retained description's normalized result can be in the discarded
    # suffix. Invalidate before those result ids can be reused. This scalar
    # dictionary releases its buffers without walking type descriptions.
    nodes.normal_forms=[]
    nodes.combinations=[]
    nodes.positional_functions=[]
    nodes.primitives=[]
}

primitive = (name:string @nodes:Table):>addr => {
    let cached=nodes.primitives.get(name)
    if cached isnt? none return cached
    let key="P{_quoted(name)}"
    let known=nodes.positions.get(key)
    let result=if known isnt? none known else intern(@nodes Primitive[key=key name=name])
    nodes.primitives[name]=result
    return result
}
integer_literal = (value:bigint @nodes:Table):>addr => {
    let key="I{_bigint_as_string(value)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes IntegerLiteralType[key=key value=value])
}
string_literal = (value:string @nodes:Table):>addr => {
    # This is a complete leaf key, not source text embedded in another key.
    # The distinct tag plus the exact contents is already injective. Parent
    # descriptions refer to interned ids, so escaping every character here
    # adds work without preventing any additional ambiguity.
    let key='S'+value
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes StringLiteralType[key=key value=value])
}
binary_literal = (value:array<uint8> @nodes:Table):>addr => {
    # Build one ASCII byte buffer, rather than format every byte into a
    # separately owned decimal string and join all those descriptors.
    let alphabet=0x"30313233343536373839616263646566" as array<uint8>
    let encoded:array<uint8>=[66] # the binary-literal tag B
    loop byte in value {
        encoded.push(alphabet[byte // 16])
        encoded.push(alphabet[byte % 16])
    }
    let key=encoded as string|none
    $runtime_assert key isnt? none
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes BinaryLiteralType[key=key value=value])
}
rational_literal = (numerator:bigint denominator:bigint & ~0 @nodes:Table):>addr => {
    let value = _bigrational_make(numerator denominator)
    let key = if value =? 0 'L0/1' else "L{_bigint_as_string(value.numerator)}/{_bigint_as_string(value.denominator)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    if value =? 0 return intern(@nodes RationalLiteralType[key=key numerator=0 denominator=1])
    return intern(@nodes RationalLiteralType[key=key numerator=value.numerator denominator=value.denominator])
}

# Canonical name order follows Unicode scalars, matching the hosted table.
# This is a compiler-internal ordering, not a new source comparison operator.
name_before = (left:string right:string):>bool => {
    let a = left as array<uint32>
    let b = right as array<uint32>
    loop i in 0.. and i <? a.length and i <? b.length {
        if a[i] <? b[i] return true
        if a[i] >? b[i] return false
    }
    return a.length <? b.length
}

dimension = (powers:array<DimensionPower> @nodes:Table):>addr => {
    let combined:dict<string bigint> = []
    let names:array<string> = []
    loop power in powers {
        if power.name in? combined { combined[power.name] += power.exponent }
        else {
            combined[power.name] = power.exponent
            let at:addr<i => i <=? names.length> = 0
            loop at <? names.length {
                if name_before(power.name names[at]) break
                at += 1
            }
            names.insert(power.name idx=at)
        }
    }
    let normalized:array<DimensionPower> = []
    let parts:array<string> = []
    loop name in names {
        let exponent = combined.get(name default=0)
        if exponent =? 0 continue
        normalized.push(DimensionPower[name exponent])
        parts.push("{_quoted(name)}:{_bigint_as_string(exponent)}")
    }
    let key="D{parts.join(';')}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes DimensionType[key=key powers=normalized])
}

dimension_at = (id:addr nodes:Table):>DimensionType => {
    let node = node_at(nodes id)
    $runtime_assert node is? DimensionType
    return node
}
multiply_dimensions = (left:addr right:addr @nodes:Table):>addr => {
    let powers = dimension_at(left nodes).powers
    let other = dimension_at(right nodes)
    loop power in other.powers { powers.push(power) }
    return dimension(powers @nodes)
}
divide_dimensions = (left:addr right:addr @nodes:Table):>addr => {
    let powers = dimension_at(left nodes).powers
    let other = dimension_at(right nodes)
    loop power in other.powers { powers.push(DimensionPower[power.name (-power.exponent)]) }
    return dimension(powers @nodes)
}
power_dimension = (base:addr exponent:bigint @nodes:Table):>addr => {
    let powers:array<DimensionPower> = []
    let original = dimension_at(base nodes)
    loop power in original.powers { powers.push(DimensionPower[power.name (power.exponent * exponent)]) }
    return dimension(powers @nodes)
}
quantity_type = (number:addr dim:addr @nodes:Table):>addr => {
    let key="U{number}:{dim}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes QuantityType[key=key shape="U{shapes_key([number dim] nodes)}" number=number dimension=dim])
}

items_key = (items:array<addr>):>string => {
    let pieces:array<string> = []
    loop id in items { pieces.push("{id}") }
    return pieces.join(',')
}

is_primitive = (node:Type name:string):>bool => node is? Primitive and node.name =? name

# Smart constructors flatten their own connective, discard duplicates, and
# apply identity/annihilator laws. They deliberately do not consult subtyping:
# int64 | int remains a syntactic union until a semantic join asks to simplify.
combine = (items:array<addr> conjunction:bool @nodes:Table):>addr => {
    let request="{conjunction}:{items_key(items)}"
    let known=nodes.combinations.get(request)
    if known isnt? none return known
    let result=combine_uncached(items conjunction @nodes)
    nodes.combinations[request]=result
    return result
}
combine_uncached = (items:array<addr> conjunction:bool @nodes:Table):>addr => {
    let identity = if conjunction 'any' else 'never'
    let annihilator = if conjunction 'never' else 'any'
    let flat:array<addr> = []
    loop id in items {
        let node = node_at(nodes id)
        if is_primitive(node identity) continue
        if is_primitive(node annihilator) return primitive(annihilator @nodes)
        let children:array<addr> = [id]
        if conjunction and node is? TypeAnd { children = node.items }
        if not conjunction and node is? TypeOr { children = node.items }
        loop child in children { if not contains_type(flat child nodes) { flat.push(child) } }
    }
    if flat.length =? 0 return primitive(identity @nodes)
    if flat.length =? 1 return flat[0]
    let prefix=if conjunction 'A' else 'O'
    let key="{prefix}{items_key(flat)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    let shape="{prefix}{shapes_key(flat nodes)}"
    if conjunction return intern(@nodes TypeAnd[key=key shape=shape items=flat])
    return intern(@nodes TypeOr[key=key shape=shape items=flat])
}
intersect = (items:array<addr> @nodes:Table):>addr => combine(items true @nodes)
union = (items:array<addr> @nodes:Table):>addr => combine(items false @nodes)

# Parentheses are nonsemantic for expressed values: (1 (2 3)) expresses three
# values. A generator value is one value, so only SequenceType is flattened.
sequence = (items:array<addr> @nodes:Table):>addr => {
    let flat:array<addr> = []
    loop id in items {
        let node = node_at(nodes id)
        if node is? SequenceType { loop child in node.items { flat.push(child) } }
        else { flat.push(id) }
    }
    if flat.length =? 0 return primitive('void' @nodes)
    if flat.length =? 1 return flat[0]
    let key="Q{items_key(flat)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes SequenceType[key=key shape="Q{shapes_key(flat nodes)}" items=flat])
}

array_type = (element:addr length:addr? @nodes:Table):>addr => {
    let key="R{element}:{length}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes ArrayType[key=key shape="R{shapes_key([element] nodes)}:{length}" element=element length=length])
}
string_type = (length:addr? @nodes:Table):>addr => {
    let key="T{length}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes StringType[key=key length=length])
}
parameterize = (head:addr args:array<addr> @nodes:Table):>addr => {
    let key="G{head}:{items_key(args)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes TypeParameterize[key=key shape="G{shapes_key([head] nodes)}:{shapes_key(args nodes)}" head=head args=args])
}

type_variable = (name:string bound:addr @nodes:Table):>addr => {
    let key="V{_quoted(name)}:{bound}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes TypeVariable[key=key shape="V{_quoted(name)}:{shapes_key([bound] nodes)}" name=name bound=bound])
}

function_type = (pos:array<PosOrKwArg> kw:array<KwOnlyArg> rest:string? ret:addr params:array<GenericParam> @nodes:Table effects:effect_rows.Contract?=none):>addr => {
    if effects isnt? none {nodes.effect_contracts=true}
    let slots:array<string> = []
    loop p in pos {
        let name = if p.name is? none 'none' else _quoted(p.name)
        slots.push("P{name}:{p.value_type}:{p.required}:{p.place}")
    }
    loop p in kw {
        slots.push("K{_quoted(p.name)}:{p.value_type}:{p.required}:{p.place}")
    }
    loop p in params {
        slots.push("G{_quoted(p.name)}:{p.bound}:{p.kind}:{_quoted(p.identity)}")
    }
    let rest_key = if rest is? none 'none' else _quoted(rest)
    let effect_key=effect_rows.identity(effects)
    let key = "F{slots.join(';')}:R{rest_key}:T{ret}:E{effect_key}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    let shapes:array<string> = []
    loop p in pos {
        let name = if p.name is? none 'none' else _quoted(p.name)
        shapes.push("P{name}:{shapes_key([p.value_type] nodes)}:{p.required}:{p.place}")
    }
    loop p in kw { shapes.push("K{_quoted(p.name)}:{shapes_key([p.value_type] nodes)}:{p.required}:{p.place}") }
    loop p in params { shapes.push("G{_quoted(p.name)}:{shapes_key([p.bound] nodes)}:{p.kind}:{_quoted(p.identity)}") }
    let shape = "F{shapes.join(';')}:R{rest_key}:T{shapes_key([ret] nodes)}:E{effect_key}"
    return intern(@nodes FunctionType[key=key shape=shape pos_or_kw=pos kw_only=kw rest=rest ret=ret type_params=params effects=effects])
}

# Lowered operations have required, unnamed value arguments. Keep that common
# signature query in terms of type ids, so an intern hit does not first build
# and destroy a record for every parameter. The general factory remains the
# authority for its identity and full description on a miss.
positional_function = (arguments:array<addr> ret:addr @nodes:Table):>addr => {
    let request="{items_key(arguments)}:{ret}"
    let known=nodes.positional_functions.get(request)
    if known isnt? none return known
    let slots:array<PosOrKwArg>=[]
    loop argument in arguments {slots.push(PosOrKwArg[none argument])}
    let result=function_type(slots [] none ret [] @nodes)
    nodes.positional_functions[request]=result
    return result
}
overload_type = (methods:array<addr> @nodes:Table):>addr => {
    let key="M{items_key(methods)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes OverloadType[key=key shape="M{shapes_key(methods nodes)}" methods=methods])
}

# Compare a single contract without allocating its serialized key. Resolved
# binding ids describe proof provenance, not contract identity; tested types
# use structural identity just as propositions_key(structural=true) does.
same_proposition = (a:facts.Proposition b:facts.Proposition nodes:Table):>bool => {
    if a.subject not=? b.subject or a.op not=? b.op or a.value not=? b.value return false
    if a.projection not=? b.projection or a.term_projection not=? b.term_projection return false
    if a.term is? none {
        if b.term isnt? none return false
    }
    else {
        if b.term is? none return false
        if a.term not=? b.term return false
    }
    if a.axiom is? none {
        if b.axiom isnt? none return false
    }
    else {
        if b.axiom is? none return false
        if a.axiom not=? b.axiom return false
    }
    if a.when is? none {
        if b.when isnt? none return false
    }
    else {
        if b.when is? none return false
        if a.when not=? b.when return false
    }
    if a.tested_type is? none return b.tested_type is? none
    if b.tested_type is? none return false
    return same_type(a.tested_type b.tested_type nodes)
}

same_propositions = (a:array<facts.Proposition> b:array<facts.Proposition> nodes:Table):>bool => {
    if a.length not=? b.length return false
    loop i in 0.. and i <? a.length {
        $runtime_assert i <? b.length
        if not same_proposition(a[i] b[i] nodes) return false
    }
    return true
}

propositions_key = (props:array<facts.Proposition> structural:bool nodes:Table):>string => {
    let parts:array<string> = []
    loop p in props {
        let key = if structural facts.identity_key(p) else facts.storage_key(p)
        # Resolved type indices may identify descriptions with different
        # defaults but the same shape. Replace that one field for equality.
        if structural and p.tested_type isnt? none {
            let scalar = facts.Proposition[p.subject p.op p.value p.projection p.term p.term_id p.term_projection none p.when p.subject_id p.axiom]
            key = "{facts.identity_key(scalar)}:{shapes_key([p.tested_type] nodes)}"
        }
        parts.push(component(key))
    }
    return parts.join(';')
}
refined_type = (base:addr propositions:array<facts.Proposition> @nodes:Table):>addr => {
    let key = "E{base}:{propositions_key(propositions false nodes)}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    let shape = "E{shapes_key([base] nodes)}:{propositions_key(propositions true nodes)}"
    return intern(@nodes RefinedType[key=key shape=shape base=base propositions=propositions])
}
strip_refinement = (id:addr nodes:Table):>addr => {
    let node = node_at(nodes id)
    return if node is? RefinedType node.base else id
}

# Object field order and mutability are structural. Constructor defaults,
# field proof bindings, methods, and constructor overload ids are retained
# in the stored description but do not make two layouts different types.
object_type = (fields:array<ObjectField> brand:string? immutable:bool methods:array<MethodSpec> constructors:array<addr> @nodes:Table minted:bool=false parent:addr?=none abstract:bool=false):>addr => {
    let parts:array<string> = []
    loop f in fields {
        parts.push("{_quoted(f.name)}:{f.value_type}:{f.mutable}:{f.default}:{propositions_key(f.refinement false nodes)}")
    }
    let method_keys:array<string> = []
    loop m in methods {
        let owner = if m.owner is? none 'none' else _quoted(m.owner)
        method_keys.push("{_quoted(m.name)}:{m.literal}:{m.binding_id}:{m.place_self}:{owner}:{m.static}:{m.lifecycle}")
    }
    let brand_key = if brand is? none 'none' else _quoted(brand)
    let key = "J{brand_key}:{immutable}:{parts.join(';')}:{method_keys.join(';')}:{items_key(constructors)}:{minted}:{parent}:{abstract}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    let shapes:array<string> = []
    loop f in fields { shapes.push("{_quoted(f.name)}:{shapes_key([f.value_type] nodes)}:{f.mutable}") }
    let shape = "J{brand_key}:{immutable}:{shapes.join(';')}"
    return intern(@nodes ObjectType[key=key shape=shape fields=fields brand=brand immutable=immutable methods=methods constructors=constructors minted=minted parent=parent abstract=abstract])
}
object_field = (node:ObjectType name:string):>ObjectField? => {
    loop f in node.fields { if f.name =? name return f }
    return none
}
object_method = (node:ObjectType name:string):>MethodSpec? => {
    loop m in node.methods { if m.name =? name return m }
    return none
}
object_invariants = (node:ObjectType):>array<facts.Proposition> => {
    let props:array<facts.Proposition> = []
    loop f in node.fields {
        loop p in f.refinement {
            if facts.parameter(p) isnt? none or p.tested_type isnt? none continue
            props.push(facts.Proposition[subject=".{f.name}" op=p.op value=p.value term=p.term term_id=p.term_id term_projection=p.term_projection axiom=p.axiom])
        }
    }
    return props
}

path_type = (value:string? methods:array<MethodSpec> @nodes:Table):>addr => {
    let element = if value is? none string_type(none @nodes) else string_literal(value @nodes)
    let base = object_type([ObjectField['path' element]] none false methods [] @nodes)
    let description = node_at(nodes base)
    $runtime_assert description is? ObjectType
    let key = "K{description.key}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    let shape = "K{component(shape_reference(base nodes))}"
    if value is? none return intern(@nodes PathType[key=key shape=shape fields=description.fields methods=methods])
    return intern(@nodes PathLiteralType[key=key shape=shape fields=description.fields methods=methods value=value])
}

named_type = (name:string alias_id:addr @nodes:Table):>addr => {
    let key="Y{alias_id}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes NamedType[key=key name=name alias_id=alias_id])
}
resolve_alias = (id:addr target:addr @nodes:Table):>void => {
    $runtime_assert id <? nodes.entries.length
    let node = nodes.entries[id]
    $runtime_assert node is? NamedType
    # Resolution changes the target, not the recursive reference's identity.
    nodes.entries[id] = NamedType[key=node.key shape_id=node.shape_id name=node.name alias_id=node.alias_id target=target]
}
unfold = (id:addr nodes:Table):>addr => {
    let node = node_at(nodes id)
    if node isnt? NamedType return id
    $runtime_assert node.target isnt? none
    return node.target
}
# Invariance permits an alias's resolved spelling, never a different subtype.
# Array nesting preserves both length and this same element contract.
same_array_element=(a:addr b:addr nodes:Table):>bool=>{
    let left=unfold(a nodes) let right=unfold(b nodes)
    if same_type(left right nodes) return true
    let x=node_at(nodes left) let y=node_at(nodes right)
    return x is? ArrayType and y is? ArrayType and x.length =? y.length and same_array_element(x.element y.element nodes)
}

meta_type = (family:addr @nodes:Table):>addr => {
    let key="H{family}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes MetaType[key=key shape="H{shapes_key([family] nodes)}" family=family])
}
alias_key = (value:TypeAliasValue nodes:Table structural:bool):>string => {
    if value is? addr return if structural shape_reference(value nodes) else "{value}"
    let params:array<string> = []
    loop param in value.params {
        let bound = if structural shape_reference(param.bound nodes) else "{param.bound}"
        params.push("{_quoted(param.name)}:{component(bound)}")
    }
    let body = if structural shape_reference(value.body nodes) else "{value.body}"
    return "alias[{params.join(';')}]:{component(body)}"
}
module_type = (fields:array<ModuleField> @nodes:Table):>addr => {
    let parts:array<string> = []
    loop f in fields {
        let stored = if f.type_value is? none 'none' else alias_key(f.type_value nodes false)
        parts.push("{_quoted(f.name)}:{f.value_type}:{f.binding_id}:{stored}")
    }
    let key="Z{parts.join(';')}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    let shapes:array<string> = []
    loop f in fields {
        let value = if f.type_value is? none 'none' else alias_key(f.type_value nodes true)
        shapes.push("{_quoted(f.name)}:{shapes_key([f.value_type] nodes)}:{f.binding_id}:{value}")
    }
    return intern(@nodes ModuleType[key=key shape="Z{shapes.join(';')}" fields=fields])
}
module_field = (node:ModuleType name:string):>ModuleField? => {
    loop f in node.fields { if f.name =? name return f }
    return none
}

# Substitute free names, respecting generic binders inside a nested callable.
# Instantiating the outer method is a separate operation: it removes that
# method's binder before substitution rather than accidentally shadowing it.
substitute = (id:addr bindings:dict<string addr> @nodes:Table effects:dict<string effect_rows.Row>=[]):>addr => {
    let node = node_at(nodes id)
    if node is? Primitive | TypeVariable return bindings.get(node.name default=id)
    if node is? TypeNot return negate(substitute(node.item bindings @nodes effects=effects) @nodes)
    if node is? RefinedType return refined_type(substitute(node.base bindings @nodes effects=effects) node.propositions @nodes)
    if node is? PathType return id
    if node is? ObjectType {
        let fields:array<ObjectField> = []
        loop f in node.fields { fields.push(ObjectField[f.name substitute(f.value_type bindings @nodes effects=effects) f.mutable f.default f.refinement]) }
        return object_type(fields node.brand node.immutable node.methods node.constructors @nodes minted=node.minted parent=node.parent abstract=node.abstract)
    }
    if node is? ArrayType return array_type(substitute(node.element bindings @nodes effects=effects) node.length @nodes)
    if node is? QuantityType return quantity_type(substitute(node.number bindings @nodes effects=effects) node.dimension @nodes)
    if node is? TypeAnd | TypeOr | SequenceType | OverloadType {
        let original = if node is? OverloadType node.methods else node.items
        let items:array<addr> = []
        loop child in original { items.push(substitute(child bindings @nodes effects=effects)) }
        if node is? TypeAnd return intersect(items @nodes)
        if node is? TypeOr return union(items @nodes)
        if node is? SequenceType return sequence(items @nodes)
        return overload_type(items @nodes)
    }
    if node is? TypeParameterize {
        let head = substitute(node.head bindings @nodes effects=effects)
        let args:array<addr> = []
        loop arg in node.args { args.push(substitute(arg bindings @nodes effects=effects)) }
        return parameterize(head args @nodes)
    }
    if node is? FunctionType return substitute_function(node bindings false @nodes effects=effects)
    return id
}

substitute_function = (node:FunctionType bindings:dict<string addr> instantiate:bool @nodes:Table effects:dict<string effect_rows.Row>=[]):>addr => {
    let inner = bindings
    let params = node.type_params
    if instantiate { params = [] }
    else {
        loop param in params {
            if param.name in? inner {inner.pop(param.name);}
            if param.kind =? 'effect' and param.identity in? effects {effects.pop(param.identity);}
        }
    }
    let pos:array<PosOrKwArg> = []
    let kw:array<KwOnlyArg> = []
    loop p in node.pos_or_kw { pos.push(PosOrKwArg[p.name substitute(p.value_type inner @nodes effects=effects) p.required p.place]) }
    loop p in node.kw_only { kw.push(KwOnlyArg[p.name substitute(p.value_type inner @nodes effects=effects) p.required p.place]) }
    let ret = substitute(node.ret inner @nodes effects=effects)
    return function_type(pos kw node.rest ret params @nodes effects=effect_rows.replace_variables(node.effects effects))
}

# De Morgan's laws put not only on atoms. A type constructor is itself an atom
# here; its arguments are normalized independently, never complemented merely
# because the outer constructor was complemented.
negate = (id:addr @nodes:Table):>addr => {
    let node = node_at(nodes id)
    if is_primitive(node 'any') return primitive('never' @nodes)
    if is_primitive(node 'never') return primitive('any' @nodes)
    if node is? TypeNot return to_nnf(node.item @nodes)
    if node is? TypeAnd | TypeOr {
        let items:array<addr> = []
        loop child in node.items { items.push(negate(child @nodes)) }
        return combine(items (node is? TypeOr) @nodes)
    }
    let key="N{id}"
    let known=nodes.positions.get(key)
    if known isnt? none return known
    return intern(@nodes TypeNot[key=key shape="N{shapes_key([id] nodes)}" item=id])
}

to_nnf = (id:addr @nodes:Table):>addr => {
    let known=nodes.normal_forms.get(id)
    if known isnt? none return known
    let result=to_nnf_uncached(id @nodes)
    nodes.normal_forms[id]=result
    return result
}

to_nnf_uncached = (id:addr @nodes:Table):>addr => {
    let node = node_at(nodes id)
    # Normalize an atom's children equally on both sides of a Boolean
    # difference. Complementing array<T> still leaves T positive.
    if node is? TypeNot return negate(to_nnf(node.item @nodes) @nodes)
    if node is? TypeAnd | TypeOr | SequenceType {
        let items:array<addr> = []
        loop child in node.items { items.push(to_nnf(child @nodes)) }
        if node is? SequenceType return sequence(items @nodes)
        return combine(items (node is? TypeAnd) @nodes)
    }
    if node is? ArrayType {
        let element=to_nnf(node.element @nodes)
        return if element =? node.element id else array_type(element node.length @nodes)
    }
    if node is? QuantityType {
        let number=to_nnf(node.number @nodes)
        return if number =? node.number id else quantity_type(number node.dimension @nodes)
    }
    if node is? PathType return id
    if node is? ObjectType {
        # Most queries revisit a constructor whose children are already in
        # normal form. Preserve its interned identity without reconstructing
        # large metadata/shape strings just to intern the same record again.
        let values:array<addr>=[]
        let changed=false
        loop f in node.fields {
            let value=to_nnf(f.value_type @nodes)
            values.push(value)
            if value not=? f.value_type {changed=true}
        }
        if not changed return id
        let fields:array<ObjectField> = []
        loop i in 0.. and i <? node.fields.length and i <? values.length {
            let f=node.fields[i]
            fields.push(ObjectField[f.name values[i] f.mutable f.default f.refinement])
        }
        return object_type(fields node.brand node.immutable node.methods node.constructors @nodes minted=node.minted parent=node.parent abstract=node.abstract)
    }
    if node is? TypeParameterize {
        let head = to_nnf(node.head @nodes)
        let args:array<addr> = []
        let changed=head not=? node.head
        loop arg in node.args {
            let value=to_nnf(arg @nodes)
            args.push(value)
            if value not=? arg {changed=true}
        }
        return if changed parameterize(head args @nodes) else id
    }
    return id
}

distribute = (left:array<Clause> right:array<Clause>):>array<Clause> => {
    let output:array<Clause> = []
    loop a in left {
        loop b in right {
            let literals = a.literals
            loop item in b.literals { literals.push(item) }
            output.push(Clause[literals=literals])
        }
    }
    return output
}

dnf = (id:addr nodes:Table):>array<Clause> => {
    let node = node_at(nodes id)
    if is_primitive(node 'never') return []
    if is_primitive(node 'any') return [Clause[literals=[]]]
    if node is? TypeNot return [Clause[literals=[SignedAtom[false node.item]]]]
    if node is? TypeOr {
        let clauses:array<Clause> = []
        loop child in node.items { loop clause in dnf(child nodes) { clauses.push(clause) } }
        return clauses
    }
    if node is? TypeAnd {
        let clauses:array<Clause> = [Clause[literals=[]]]
        loop child in node.items { clauses = distribute(clauses dnf(child nodes)) }
        return clauses
    }
    return [Clause[literals=[SignedAtom[true id]]]]
}

normalize = (id:addr @nodes:Table):>array<Clause> => {
    let normalized = to_nnf(id @nodes)
    return dnf(normalized nodes)
}

describe = (id:addr nodes:Table):>string => {
    let node = node_at(nodes id)
    if node is? Primitive return node.name
    if node is? NamedType return node.name
    if node is? RefinedType return "refined<{describe(node.base nodes)} {propositions_key(node.propositions true nodes)}>"
    if node is? MetaType return "type<{describe(node.family nodes)}>"
    if node is? PathLiteralType return "path({_quoted(node.value)})"
    if node is? PathType return 'path'
    if node is? ObjectType {
        let fields:array<string> = []
        loop f in node.fields {
            let mutable = if f.mutable '' else 'const '
            fields.push("{mutable}{f.name}:{describe(f.value_type nodes)}")
        }
        let brand = if node.brand is? none '' else "{node.brand} "
        let immutable = if node.immutable 'const ' else ''
        return "{brand}{immutable}[{fields.join(' ')}]"
    }
    if node is? ModuleType {
        let fields:array<string> = []
        loop f in node.fields { fields.push("{f.name}:{describe(f.value_type nodes)}@{f.binding_id}") }
        return "module[{fields.join(' ')}]"
    }
    if node is? IntegerLiteralType return _bigint_as_string(node.value)
    if node is? RationalLiteralType return "{_bigint_as_string(node.numerator)}/{_bigint_as_string(node.denominator)}"
    if node is? BinaryLiteralType {
        let bytes:array<string> = []
        loop byte in node.value { bytes.push("{byte}") }
        return "bytes[{bytes.join(',')}]"
    }
    if node is? DimensionType {
        let parts:array<string> = []
        loop power in node.powers { parts.push("{power.name}^{_bigint_as_string(power.exponent)}") }
        return "dimension[{parts.join(' ')}]"
    }
    if node is? QuantityType return "quantity<{describe(node.number nodes)} {describe(node.dimension nodes)}>"
    if node is? StringLiteralType return "{_quoted(node.value)}"
    if node is? StringType { if node.length is? none return 'string' return "string<length={node.length}>" }
    if node is? ArrayType {
        let element = describe(node.element nodes)
        if node.length is? none return "array<{element}>"
        return "array<{element} length={node.length}>"
    }
    if node is? TypeNot return "~({describe(node.item nodes)})"
    if node is? TypeAnd | TypeOr | SequenceType {
        let parts:array<string> = []
        loop child in node.items { parts.push(describe(child nodes)) }
        let separator = if node is? TypeAnd ' & ' else if node is? TypeOr ' | ' else ' '
        return "({parts.join(separator)})"
    }
    if node is? TypeParameterize {
        let args:array<string> = []
        loop arg in node.args { args.push(describe(arg nodes)) }
        return "{describe(node.head nodes)}<{args.join(' ')}>"
    }
    if node is? TypeVariable return node.name
    return node.key
}

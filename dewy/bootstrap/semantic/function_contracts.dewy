import p"ty.dewy" as types
import p"hir.dewy" as hir
import p"analyze/hir_facts.dewy" as expressions
import p"propositions.dewy" as facts
import p"type_queries.dewy" as views
import p"bindings.dewy" as bindings
import p"analyze/predicate_effects.dewy" as predicate_effects

doc"""
A function implementing a slot proves the slot's return promises. Parameter
names in that contract refer to corresponding parameters of the literal,
not to similarly named outer bindings. Once parameters have binding ids,
those identities replace the temporary names used during signature checking.
"""

rename = (id:addr names:dict<string string> @nodes:types.Table):>addr => {
    let node=types.node_at(nodes id)
    if node is? types.TypeOr {
        let members:array<addr>=[]
        loop item in node.items {members.push(rename(item names @nodes))}
        return types.union(members @nodes)
    }
    if node isnt? types.RefinedType return id
    let promises:array<facts.Proposition>=[]
    loop p in node.propositions {
        let subject=p.subject
        let parameter=facts.parameter(p)
        if parameter isnt? none {subject="@{names.get(parameter parameter)}"}
        let term=if p.term is? none none else facts.rename_term(p.term names)
        promises.push(facts.Proposition[subject p.op p.value p.projection term p.term_id p.term_projection p.tested_type p.when p.subject_id p.axiom])
    }
    return types.refined_type(node.base promises @nodes)
}
member = (id:addr contract:array<addr> @nodes:types.Table):>addr => {
    let node=types.node_at(nodes id)
    let base=types.strip_refinement(id nodes)
    loop candidate in contract {
        if not types.same_type(base types.strip_refinement(candidate nodes) nodes) continue
        let expected=types.node_at(nodes candidate)
        if node isnt? types.RefinedType return candidate
        if expected isnt? types.RefinedType return id
        let promises=expected.propositions
        loop p in node.propositions {if not views.has_proposition(promises p) {promises.push(p)}}
        return types.refined_type(node.base promises @nodes)
    }
    return id
}
adopt = (result:addr expected:types.FunctionType parameters:array<types.PosOrKwArg> @nodes:types.Table):>addr => {
    let promised=types.node_at(nodes expected.ret)
    let has_promises=promised is? types.RefinedType
    if promised is? types.TypeOr {
        loop item in promised.items {if types.node_at(nodes item) is? types.RefinedType {has_promises=true}}
    }
    if not has_promises return result
    let names:dict<string string>=[]
    loop i in 0.. and i <? expected.pos_or_kw.length and i <? parameters.length {
        let before=expected.pos_or_kw[i].name
        let after=parameters[i].name
        if before isnt? none and after isnt? none {names[before]=after}
    }
    let contract=rename(expected.ret names @nodes)
    let node=types.node_at(nodes result)
    if types.is_primitive(node 'untyped') return contract
    let desired=types.node_at(nodes contract)
    let members:array<addr>=if desired is? types.TypeOr desired.items else [contract]
    if node isnt? types.TypeOr return member(result members @nodes)
    let output:array<addr>=[]
    loop item in node.items {output.push(member(item members @nodes))}
    return types.union(output @nodes)
}
bind_parameters = (id:addr parameters:array<hir.Param> @nodes:types.Table @registry:bindings.Registry):>addr => {
    let node=types.node_at(nodes id)
    if node is? types.TypeOr {
        let members:array<addr>=[]
        loop item in node.items {members.push(bind_parameters(item parameters @nodes @registry))}
        return types.union(members @nodes)
    }
    if node isnt? types.RefinedType return id
    let promises:array<facts.Proposition>=[]
    loop p in node.propositions {
        let term_id=p.term_id
        let subject_id=p.subject_id
        loop param in parameters {
            if p.term isnt? none {
                let route=facts.named_route(p.term)
                if route.root =? param.name and param.binding_id isnt? none {
                    term_id=bindings.extend_route(param.binding_id route.fields nodes @registry)
                }
            }
            if facts.parameter(p) =? param.name {subject_id=param.binding_id}
        }
        promises.push(facts.Proposition[p.subject p.op p.value p.projection p.term term_id p.term_projection p.tested_type p.when subject_id p.axiom])
    }
    return types.refined_type(node.base promises @nodes)
}

unknown_parameter = (id:addr parameters:array<hir.Param> nodes:types.Table):>string? => {
    let node=types.node_at(nodes id)
    if node is? types.TypeOr {
        loop item in node.items {
            let unknown=unknown_parameter(item parameters nodes)
            if unknown isnt? none return unknown
        }
    }
    if node is? types.RefinedType {
        let names:set<string>=set[]
        loop param in parameters {names.add(param.name)}
        loop promise in node.propositions {
            if promise.term isnt? none {
                let route=facts.named_route(promise.term)
                if route.root not in? names return promise.term
                loop param in parameters {
                    if param.name =? route.root and bindings.field_route_type(param.value_type route.fields nodes) is? none return promise.term
                }
            }
            let subject=facts.parameter(promise)
            if subject isnt? none and subject not in? names return subject
        }
    }
    return none
}

# A parameter's dependent obligation names the actual supplied value. It
# cannot inherit the callee's binding id merely because the spelling agrees.
at_call = (id:addr arguments:dict<string addr> hir_nodes:array<hir.AST> @nodes:types.Table @registry:bindings.Registry):>addr => {
    let node=types.node_at(nodes id)
    if node is? types.TypeOr {
        let members:array<addr>=[]
        loop member in node.items {members.push(at_call(member arguments hir_nodes @nodes @registry))}
        return types.union(members @nodes)
    }
    if node isnt? types.RefinedType return id
    let promises:array<facts.Proposition>=[]
    loop p in node.propositions {
        let term_id=p.term_id
        if p.term isnt? none {
            term_id=none
            let route=facts.named_route(p.term)
            let argument=arguments.get(route.root)
            if argument isnt? none {
                let supplied=hir.node_at(hir_nodes expressions.strip_casts(argument hir_nodes))
                if supplied is? hir.Integer and route.fields.length =? 0 and p.term_projection =? 'value' {
                    promises.push(facts.Proposition[p.subject p.op supplied.value p.projection none none p.term_projection p.tested_type p.when p.subject_id p.axiom])
                    continue
                }
                let value=if supplied is? hir.Place supplied.target else argument
                let stable=true
                if supplied isnt? hir.Place {
                    let reads=predicate_effects.read_bindings(argument hir_nodes)
                    loop other in arguments.values {
                        let writes=predicate_effects.mutated_bindings(other hir_nodes)
                        loop root in reads {if root in? writes {stable=false}}
                    }
                }
                if stable {
                    let root=bindings.array_route_id(value hir_nodes @registry)
                    if root isnt? none {term_id=bindings.extend_route(root route.fields nodes @registry)}
                }
            }
        }
        promises.push(facts.Proposition[p.subject p.op p.value p.projection p.term term_id p.term_projection p.tested_type p.when p.subject_id p.axiom])
    }
    return types.refined_type(node.base promises @nodes)
}

$explicit_copies

from reporting import Warning
import p"analyze/intervals.dewy" as ranges
import p"analyze/prototype_checks.dewy" as prototype

# Decisions contain the evidence needed by later rewriting, without keeping
# a bounds checker or its temporary branch states alive.
Unfit:type = const [interval:ranges.Interval? word:string]
Decision:type = const [
    unfit:dict<addr Unfit>
    constants:dict<addr bigint>
    warnings:array<Warning>
    # `$prototype`: unproven sites the driver wraps in runtime checks.
    deferred:dict<addr prototype.Deferred>=[]
    word_iterators:set<addr>=set[]
]

# A prelude is a closed dependency graph before entry checking starts. Keep
# its decisions against the original HIR with its proof witnesses: checking may
# still rewrite an old node, in which case ordinary analysis must run again.
Prelude:type = const [
    roots:array<addr> nodes:addr edits:addr decisions:array<Decision>
]

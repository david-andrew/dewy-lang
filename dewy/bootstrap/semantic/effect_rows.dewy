# Public contracts are distinct from analyze/effects.dewy's internal access
# summaries. Keys below come from resolved nominal/generic/parameter identity,
# never a source spelling. A missing row is open; Row[] is explicitly empty.
Subject:type = const [kind:'resource'|'parameter' key:string route:array<string>=[]]
Atom:type = const [family:string subject:Subject?=none]
Row:type = const [atoms:array<Atom>=[] variables:array<string>=[] unknown:bool=false]
Contract:type = const [allowed:Row?=none excluded:array<Atom>=[]]

subject_covers = (wide:Subject narrow:Subject):>bool => {
    if wide.kind not=? narrow.kind or wide.key not=? narrow.key return false
    if wide.kind =? 'resource' and wide.route.length not=? narrow.route.length return false
    if wide.route.length >? narrow.route.length return false
    loop i in 0.. and i <? wide.route.length {
        $runtime_assert i <? narrow.route.length
        if wide.route[i] not=? narrow.route[i] return false
    }
    return true
}
covers = (wide:Atom narrow:Atom):>bool => {
    if wide.family not=? narrow.family return false
    if wide.subject is? none return narrow.subject is? none
    if narrow.subject is? none return false
    return subject_covers(wide.subject narrow.subject)
}
overlaps = (exclusion:Atom possible:Atom):>bool => {
    if exclusion.family not=? possible.family return false
    if exclusion.subject is? none return true
    if possible.subject is? none return false
    return subject_covers(exclusion.subject possible.subject) or subject_covers(possible.subject exclusion.subject)
}
# Rows are small. Normalize covered routes on insertion rather than relying
# on structural hashing or expanding a family into all its possible subjects.
add = (row:Row atom:Atom):>Row => {
    loop old in row.atoms {if covers(old atom) return row}
    let remaining:array<Atom>=[]
    loop old in row.atoms {if not covers(atom old) {remaining.push(old)}}
    remaining.push(atom)
    return Row[remaining row.variables row.unknown]
}
merge = (left:Row right:Row):>Row => {
    let result=left
    loop atom in right.atoms {result=add(result atom)}
    let variables=result.variables
    loop variable in right.variables {if variable not in? variables {variables.push(variable)}}
    return Row[result.atoms variables left.unknown or right.unknown]
}
subset = (actual:Row permitted:Row):>bool => {
    if permitted.unknown return true
    if actual.unknown return false
    loop variable in actual.variables {if variable not in? permitted.variables return false}
    loop atom in actual.atoms {
        let found=false
        loop bound in permitted.atoms {if covers(bound atom) {found=true break}}
        if not found return false
    }
    return true
}
satisfies = (actual:Row contract:Contract):>bool => {
    if contract.allowed isnt? none and not subset(actual contract.allowed) return false
    if contract.excluded.length >? 0 and (actual.unknown or actual.variables.length >? 0) return false
    loop excluded in contract.excluded {
        loop atom in actual.atoms {if overlaps(excluded atom) return false}
    }
    return true
}
substitute = (row:Row rows:dict<string Row> subjects:dict<string Subject?>=[]):>Row => {
    let output=Row[unknown=row.unknown]
    loop atom in row.atoms {
        let subject=atom.subject
        if subject isnt? none and subject.kind =? 'parameter' and subject.key in? subjects {
            let supplied=subjects[subject.key]
            if supplied is? none continue
            let route=supplied.route
            loop field in subject.route {route.push(field)}
            subject=Subject[supplied.kind supplied.key route]
        }
        output=add(output Atom[atom.family subject])
    }
    loop variable in row.variables {
        let replacement=rows.get(variable Row[variables=[variable]])
        output=merge(output replacement)
    }
    return output
}

implies = (actual:Contract? required:Contract?):>bool => {
    if required is? none return true
    let source=if actual is? none Contract[] else actual
    let admitted=if source.allowed is? none Row[unknown=true] else source.allowed
    if required.allowed isnt? none and not subset(admitted required.allowed) return false
    loop exclusion in required.excluded {
        let absent=not admitted.unknown and admitted.variables.length =? 0
        loop atom in admitted.atoms {if overlaps(exclusion atom) {absent=false}}
        if absent continue
        let excluded=false
        loop old in source.excluded {
            if old.family =? exclusion.family and (old.subject is? none or (exclusion.subject isnt? none and subject_covers(old.subject exclusion.subject))) {excluded=true}
        }
        if not excluded return false
    }
    return true
}
# Length-prefixed components avoid collisions from punctuation in minted
# identities/field names. Sorting makes interning independent of visit order.
quoted = (text:string):>string => "{text.length}:{text}"
atom_key = (atom:Atom):>string => {
    let text=quoted(atom.family)
    if atom.subject is? none return text + '-'
    let subject=atom.subject
    text+=quoted(subject.kind) + quoted(subject.key)
    loop field in subject.route {text+=quoted(field)}
    return text
}
identity = (contract:Contract?):>string => {
    if contract is? none return ''
    let allowed:string='*'
    if contract.allowed isnt? none {
        let row=merge(Row[] contract.allowed)
        let atoms:array<string>=[]
        loop atom in row.atoms {atoms.push(atom_key(atom))}
        atoms=sorted_keys(atoms)
        let variables=row.variables
        variables=sorted_keys(variables)
        allowed="{row.unknown}:"
        loop atom in atoms {allowed+=quoted(atom)}
        allowed+=';'
        loop variable in variables {allowed+=quoted(variable)}
    }
    let excluded:array<string>=[]
    loop atom in contract.excluded {
        let key=atom_key(atom)
        if key not in? excluded {excluded.push(key)}
    }
    excluded=sorted_keys(excluded)
    let text=quoted(allowed)
    loop key in excluded {text+=quoted(key)}
    return text
}

# Internal identity ordering, independent of the user-facing array sort API.
# UTF-8 byte order preserves Unicode scalar order.
key_before = (a:string b:string):>bool => {
    let left=a as array<uint8>
    let right=b as array<uint8>
    loop i in 0.. and i <? left.length and i <? right.length {
        if left[i] not=? right[i] return left[i] <? right[i]
    }
    return left.length <? right.length
}
sorted_keys = (values:array<string>):>array<string> => {
    let output:array<string>=[]
    loop value in values {
        let at:addr<i=>i<=?output.length>=0
        loop at <? output.length and key_before(output[at] value) {at+=1}
        output.insert(value idx=at)
    }
    return output
}

atom_display = (atom:Atom parameters:dict<string string>):>string => {
    if atom.subject is? none return atom.family
    let subject=atom.subject
    let name=if subject.kind =? 'parameter' parameters.get(subject.key "parameter#{subject.key}") else subject.key
    loop field in subject.route {name+=".{field}"}
    return "{atom.family}<{name}>"
}
display = (contract:Contract? parameters:dict<string string>):>string => {
    if contract is? none return ''
    let terms:array<string>=[]
    if contract.allowed isnt? none {
        let row=contract.allowed
        loop atom in row.atoms {terms.push(atom_display(atom parameters))}
        loop variable in row.variables {if not variable.startswith('inferred-effect:') {terms.push(variable)}}
        if row.unknown {terms.push('<unknown effects>')}
        if terms.length =? 0 and row.variables.length =? 0 {terms.push('no_effects')}
    }
    loop atom in contract.excluded {terms.push("no {atom_display(atom parameters)}")}
    return if terms.length =? 0 '' else ' & ' + terms.join(' & ')
}

# Sequence/branch union preserves only exclusions guaranteed by every part.
# In particular a negative-only callback remains open, with its guarantee.
join = (left:Contract right:Contract):>Contract => {
    let allowed:Row?=none
    if left.allowed isnt? none and right.allowed isnt? none {allowed=merge(left.allowed right.allowed)}
    let candidates=left.excluded
    loop atom in right.excluded {candidates.push(atom)}
    let excluded:array<Atom>=[]
    loop atom in candidates {
        let required=Contract[excluded=[atom]]
        if implies(left required) and implies(right required) and atom not in? excluded {excluded.push(atom)}
    }
    return Contract[allowed excluded]
}
instantiate = (contract:Contract subjects:dict<string Subject?>):>Contract => {
    let allowed:Row?=none
    if contract.allowed isnt? none {
        let supplied=substitute(contract.allowed [] subjects)
        let opaque=supplied.unknown
        if subjects.length >? 0 {
            loop name in supplied.variables {if name.startswith('inferred-effect:') {opaque=true}}
        }
        let widened=Row[variables=supplied.variables unknown=opaque]
        loop atom in supplied.atoms {
            let subject=atom.subject
            if subject isnt? none and subject.route.length >? 8 {
                let route=subject.route
                route.truncate(8)
                subject=Subject[subject.kind subject.key route]
            }
            widened=add(widened Atom[atom.family subject])
        }
        allowed=widened
    }
    let excluded:array<Atom>=[]
    loop atom in substitute(Row[contract.excluded] [] subjects).atoms {
        # Truncation strengthens an exclusion, unlike a positive permission.
        if atom.subject is? none or atom.subject.route.length <=? 8 {excluded.push(atom)}
    }
    return Contract[allowed excluded]
}

prepend_parameter = (contract:Contract? count:addr):>Contract? => {
    if contract is? none return none
    let subjects:dict<string Subject?>=[]
    loop i in 0.. and i <? count {subjects["{i}"]=Subject['parameter' "{i+1}"]}
    return instantiate(contract subjects)
}
bind_receiver = (contract:Contract? count:addr):>Contract? => {
    if contract is? none return none
    let subjects:dict<string Subject?>=['0' -> none]
    loop i in 1.. and i <? count {subjects["{i}"]=Subject['parameter' "{i-1}"]}
    let bound=instantiate(contract subjects)
    if contract.allowed isnt? none {
        loop atom in contract.allowed.atoms {
            if atom.subject isnt? none and atom.subject.kind =? 'parameter' and atom.subject.key =? '0' {
                $runtime_assert bound.allowed isnt? none
                return Contract[merge(bound.allowed Row[unknown=true]) bound.excluded]
            }
        }
    }
    return bound
}

replace_variables = (contract:Contract? arguments:dict<string Row>):>Contract? => {
    if contract is? none return none
    return Contract[if contract.allowed is? none none else substitute(contract.allowed arguments) contract.excluded]
}
infer = (formal:Contract? actual:Contract? variables:set<string> @arguments:dict<string Row>):>bool => {
    if formal is? none or formal.allowed is? none return implies(actual formal)
    let free:array<string>=[]
    let fixed:array<string>=[]
    loop key in formal.allowed.variables {
        if key in? variables {free.push(key)} else {fixed.push(key)}
    }
    if free.length =? 0 return implies(actual formal)
    # More than one free remainder has no unique decomposition.
    if free.length not=? 1 return false
    let supplied=if actual is? none or actual.allowed is? none Row[unknown=true] else actual.allowed
    let atoms:array<Atom>=[]
    loop atom in supplied.atoms {
        let covered=false
        loop old in formal.allowed.atoms {if covers(old atom) {covered=true break}}
        if not covered {atoms.push(atom)}
    }
    let remaining:array<string>=[]
    loop key in supplied.variables {if key not in? fixed {remaining.push(key)}}
    loop atom in atoms {
        if atom.subject isnt? none and atom.subject.kind =? 'parameter' return false
    }
    let key=free[0]
    arguments[key]=merge(arguments.get(key Row[]) Row[atoms remaining supplied.unknown])
    return true
}

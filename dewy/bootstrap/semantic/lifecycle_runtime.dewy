from reporting import SrcFile, Error, Pointer, Span
import p"context.dewy" as contexts
import p"hir.dewy" as hir
import p"ty.dewy" as types
import p"type_queries.dewy" as views
import p"bindings.dewy" as bindings

# Materialize operations before reachability and lowering. Fresh records and
# arrays own their nested resources. Factories, by-value parameters and results
# transfer fresh owners; checked @ parameters borrow. Same-scope bindings move
# at last use. Custom copy/move hooks remain checked calls, and drop precedes
# field/element storage cleanup. Conditional outer-owner consumption, field
# transfers, inferred copies and resource-container mutation remain gaps.
Hook:type = const [owner:addr binding:addr name:string signature:addr role:string]
# An expression can contain a block, branch, or early return. Carry its
# enclosing lexical lifetime explicitly through expression traversal.
Frame:type = const [
    owners:array<addr> loops:array<addr> allowed:set<addr>
    inherited:bool owning_result:bool composed_parent:addr?
]
Plan:type = [
    hooks:dict<addr Hook>=[]
    owners:dict<string Hook>=[]
    moves:dict<string Hook>=[]
    prepared:set<addr>=set[]
    transfer_sites:set<addr>=set[]
    view_sites:set<addr>=set[]
    view_bindings:set<addr>=set[]
    array_drops:dict<addr addr>=[]
    generated:array<addr>=[]
    function_source:addr?=none
    source:SrcFile
    problem:Error?=none
    result_type:addr?=none
]
put = (node:hir.AST @session:contexts.Session):>addr => hir.append_node(@session.hir node)
store = (id:addr node:hir.AST @session:contexts.Session):>void => {
    contexts.replace_hir(id node @session)
}
reject = (node:hir.AST detail:string @plan:Plan):>void => {
    if plan.problem is? none {plan.problem=Error[srcfile=plan.source title="not implemented: lifecycle ownership lowering: {detail}" pointers=[Pointer[node.loc 'this ownership operation is not implemented yet']]]}
}
resource = (id:addr nodes:types.Table):>addr? => {
    let pending:array<addr>=[id]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=views.structural_base(pending.pop nodes)
        if id in? seen {continue}
        seen.add(id)
        let type=types.node_at(nodes id)
        if type is? types.ObjectType {
            loop method in type.methods {if method.lifecycle isnt? none return id}
            loop field in type.fields {pending.push(field.value_type)}
        } else if type is? types.ArrayType {pending.push(type.element)}
        else if type is? types.TypeOr {loop member in type.items {pending.push(member)}}
    }
    return none
}
drop_value = (value:addr type_id:addr loc:Span ancestors:set<addr> @calls:array<addr> @plan:Plan @session:contexts.Session run_hook:bool=true):>void => {
    if plan.problem isnt? none or resource(type_id session.types) is? none return
    let owner=views.structural_base(type_id session.types)
    let type=types.node_at(session.types owner)
    if owner in? ancestors {reject(hir.node_at(session.hir value) 'recursive resource storage' @plan) return}
    if type is? types.ArrayType {
        let operation=plan.array_drops.get(owner)
        let empty=types.primitive('void' @session.types)
        if operation is? none {
            let name="__dewy_drop_array_{session.registry.next_id}"
            let binding_id=bindings.allocate(@session.registry none name 'value' loc)
            let parameter_id=bindings.allocate(@session.registry none '__items' 'param' loc)
            let parameter=bindings.binding_at(session.registry parameter_id)
            parameter.value_type=owner
            parameter.store_type=owner
            bindings.store_binding(@session.registry parameter_id parameter)
            let signature=types.function_type([types.PosOrKwArg['__items' owner place=true]] [] none empty [] @session.types)
            let receiver=put(hir.ExpressedIdentifier[loc owner '__items' parameter_id] @session)
            let word=types.primitive('int64' @session.types)
            let boolean=types.primitive('bool' @session.types)
            let length=put(hir.ArrayLength[loc word receiver] @session)
            let cursor=capture_result(length loc @session)
            let zero=put(hir.Integer[loc word '0d' 0] @session)
            let one=put(hir.Integer[loc word '0d' 1] @session)
            let comparison_type=types.function_type([types.PosOrKwArg[none word] types.PosOrKwArg[none word]] [] none boolean [] @session.types)
            let comparison=put(hir.ExpressedIdentifier[loc comparison_type '__gt__' none] @session)
            let condition=put(hir.FunctionCall[loc boolean comparison [cursor.value zero] []] @session)
            let body:array<addr>=[put(hir.Assign[loc empty cursor.value '-=' one] @session)]
            let element=put(hir.Index[loc type.element receiver cursor.value none] @session)
            let nested=ancestors
            nested.add(owner)
            drop_value(element type.element loc nested @body @plan @session)
            let block=put(hir.Block[loc empty body true] @session)
            let arm=put(hir.LoopArm[loc empty condition block] @session)
            let loop_body=put(hir.Flow[loc empty [arm] none] @session)
            let function_body=put(hir.Block[loc empty [cursor.declaration loop_body] true] @session)
            let function=put(hir.FunctionLiteral[loc signature [hir.Param['__items' owner parameter_id place=true]] [] none empty function_body source=plan.function_source] @session)
            let declaration=put(hir.Declare[loc empty 'const' name signature function binding_id] @session)
            let binding=bindings.binding_at(session.registry binding_id)
            binding.value_type=signature binding.function=function binding.declaration=declaration
            bindings.store_binding(@session.registry binding_id binding)
            operation=put(hir.ExpressedIdentifier[loc signature name binding_id] @session)
            plan.array_drops[owner]=operation
            plan.generated.push(declaration)
        }
        $runtime_assert operation isnt? none
        let place=put(hir.Place[loc owner value] @session)
        calls.push(put(hir.FunctionCall[loc empty operation [place] []] @session))
        return
    }
    if type is? types.TypeOr {
        let arms:array<addr>=[]
        let empty=types.primitive('void' @session.types)
        let boolean=types.primitive('bool' @session.types)
        let nested=ancestors
        nested.add(owner)
        loop member in type.items {
            if resource(member session.types) is? none continue
            if not run_hook {
                let member_type=types.node_at(session.types views.structural_base(member session.types))
                let moved=false
                if member_type is? types.ObjectType {loop method in member_type.methods {if method.lifecycle =? 'move' {moved=true}}}
                if not moved continue
            }
            let narrowed=hir.node_at(session.hir value)
            narrowed.value_type=member
            let selected=put(narrowed @session)
            let body:array<addr>=[]
            drop_value(selected member loc nested @body @plan @session run_hook=run_hook)
            let condition=put(hir.TypeTest[loc boolean value member false] @session)
            let block=put(hir.Block[loc empty body true] @session)
            arms.push(put(hir.IfArm[loc empty condition block] @session))
        }
        if arms.length >? 0 {calls.push(put(hir.Flow[loc empty arms none] @session))}
        return
    }
    if type isnt? types.ObjectType {reject(hir.node_at(session.hir value) 'unsupported resource storage' @plan) return}
    loop method in type.methods {
        if method.lifecycle not=? 'drop' or not run_hook continue
        if type.brand is? none {reject(hir.node_at(session.hir value) 'an unavailable drop operation' @plan) return}
        let hook=plan.owners.get(type.brand)
        if hook is? none {reject(hir.node_at(session.hir value) 'an unavailable drop operation' @plan) return}
        let function=put(hir.ExpressedIdentifier[loc hook.signature hook.name hook.binding] @session)
        let place=put(hir.Place[loc owner value] @session)
        let empty=types.primitive('void' @session.types)
        calls.push(put(hir.FunctionCall[loc empty function [place] []] @session))
    }
    # Parent body first, then fields in reverse declaration order. Backing
    # storage for the complete value is released by ordinary lowering later.
    let nested=ancestors
    nested.add(owner)
    let index=type.fields.length
    loop index >? 0 {
        index-=1
        let field=type.fields[index]
        if resource(field.value_type session.types) is? none continue
        let member=put(hir.MemberAccess[loc field.value_type value field.name] @session)
        drop_value(member field.value_type loc nested @calls @plan @session)
    }
}
cleanup = (owners:array<addr> loc:Span @plan:Plan @session:contexts.Session fields_only:addr?=none):>array<addr> => {
    let result:array<addr>=[]
    let index=owners.length
    loop index >? 0 {
        index-=1
        let declaration=hir.node_at(session.hir owners[index])
        $runtime_assert declaration is? hir.Declare and declaration.binding_id isnt? none
        let declared:hir.Declare=declaration
        let owner=if declared.annotation isnt? none declared.annotation else hir.node_at(session.hir declared.expr).value_type
        let value=put(hir.ExpressedIdentifier[loc owner declared.name declared.binding_id] @session)
        drop_value(value owner loc set[] @result @plan @session run_hook=fields_only is? none or owners[index] not=? fields_only)
    }
    return result
}
transfer = (id:addr expected:addr? @plan:Plan @session:contexts.Session):>addr => {
    let value=hir.node_at(session.hir id)
    let shape=views.structural_base(value.value_type session.types)
    let type=types.node_at(session.types shape)
    if type is? types.TypeOr {
        let arms:array<addr>=[]
        let boolean=types.primitive('bool' @session.types)
        loop member in type.items {
            let narrowed=value
            narrowed.value_type=member
            let selected=put(narrowed @session)
            let result=transfer(selected member @plan @session)
            if result not=? selected {
                let condition=put(hir.TypeTest[value.loc boolean id member false] @session)
                arms.push(put(hir.IfArm[value.loc hir.node_at(session.hir result).value_type condition result] @session))
            }
        }
        if arms.length =? 0 return id
        let result=put(hir.Flow[value.loc value.value_type arms id] @session)
        if expected isnt? none and types.node_at(session.types expected) is? types.RefinedType {
            result=put(hir.Obligation[value.loc value.value_type result expected 'the return contract after moving'] @session)
        }
        return result
    }
    if type isnt? types.ObjectType return id
    if type.brand is? none return id
    let hook=plan.moves.get(type.brand)
    if hook is? none return id
    let signature=types.node_at(session.types hook.signature)
    $runtime_assert signature is? types.FunctionType
    if not types.same_type(views.structural_base(signature.ret session.types) shape session.types) {reject(value 'an adapted move receiver without a checked composition' @plan) return id}
    let function=put(hir.ExpressedIdentifier[value.loc hook.signature hook.name hook.binding] @session)
    let place=put(hir.Place[value.loc shape id] @session)
    let result=put(hir.FunctionCall[value.loc signature.ret function [place] []] @session)
    if expected isnt? none and types.node_at(session.types expected) is? types.RefinedType {
        result=put(hir.Obligation[value.loc signature.ret result expected 'the return contract after moving'] @session)
    }
    return result
}
fresh = (id:addr allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session components:set<addr>=set[] frame:Frame?=none):>void => {
    # The checked custom-copy call carries its effects and result contract.
    let candidate=hir.node_at(session.hir id)
    if resource(candidate.value_type session.types) is? none {expression(id allowed inherited @plan @session frame=frame) return}
    if candidate is? hir.ValueCast|hir.RepresentationCast and types.node_at(session.types types.strip_refinement(candidate.value_type session.types)) is? types.TypeOr {
        fresh(candidate.expr allowed inherited @plan @session components=components frame=frame)
        return
    }
    if candidate is? hir.MemberAccess {
        let owner=hir.node_at(session.hir candidate.value)
        loop owner is? hir.MemberAccess {owner=hir.node_at(session.hir owner.value)}
        if owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none and owner.binding_id in? components {return}
    }
    if candidate is? hir.FunctionCall {
        let function=hir.node_at(session.hir candidate.func)
        if function is? hir.ExpressedIdentifier and function.binding_id isnt? none {
            let hook=plan.hooks.get(function.binding_id)
            if hook isnt? none and hook.role =? 'copy' {
                if candidate.pos_args.length not=? 1 or candidate.kw_args.length not=? 0 {reject(candidate 'an invalid copy receiver' @plan) return}
                let place=hir.node_at(session.hir candidate.pos_args[0])
                if place isnt? hir.Place {reject(candidate 'an invalid copy receiver' @plan) return}
                let receiver=hir.node_at(session.hir place.target)
                if receiver is? hir.FunctionCall|hir.ObjectLiteral {
                    fresh(place.target allowed inherited @plan @session frame=frame)
                    let owner=capture_result(place.target candidate.loc @session)
                    let copied:hir.FunctionCall=candidate
                    copied.pos_args=[put(hir.Place[place.loc place.value_type owner.value] @session)]
                    let result=capture_result(put(copied @session) candidate.loc @session)
                    let items:array<addr>=[owner.declaration result.declaration]
                    loop call in cleanup([owner.declaration] candidate.loc @plan @session) {items.push(call)}
                    items.push(result.value)
                    store(id hir.Block[candidate.loc candidate.value_type items false] @session)
                    return
                }
                loop receiver is? hir.MemberAccess {receiver=hir.node_at(session.hir receiver.value)}
                if receiver isnt? hir.ExpressedIdentifier or receiver.binding_id is? none or receiver.binding_id not in? allowed {reject(candidate 'an unavailable copy receiver' @plan)}
                return
            }
        }
        # Results are owned values, including through callbacks. Each checked
        # body owes this contract; arguments need their own ownership proof.
        expression(candidate.func allowed inherited @plan @session frame=frame)
        loop argument in candidate.pos_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        loop [name argument] in candidate.kw_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        return
    }
    let node=hir.node_at(session.hir id)
    let type=types.node_at(session.types views.structural_base(node.value_type session.types))
    if node is? hir.ArrayLiteral and type is? types.ArrayType {
        loop item in node.items {fresh(item allowed inherited @plan @session components=components frame=frame)}
        return
    }
    if node isnt? hir.ObjectLiteral or type isnt? types.ObjectType {reject(node 'a non-fresh resource field or resource container' @plan) return}
    loop method in type.methods {
        if method.lifecycle not=? 'drop' continue
        if type.brand is? none {reject(node 'an unavailable drop operation' @plan) return}
        let hook=plan.owners.get(type.brand)
        if hook is? none or not types.same_type(hook.owner node.value_type session.types) {reject(node 'an adapted drop receiver without a checked composition' @plan) return}
    }
    loop field in node.fields {
        if resource(hir.node_at(session.hir field.value).value_type session.types) isnt? none {fresh(field.value allowed inherited @plan @session components=components frame=frame)}
        else {expression(field.value allowed inherited @plan @session frame=frame)}
    }
}
Captured:type = const [declaration:addr value:addr]
capture_result = (id:addr loc:Span @session:contexts.Session):>Captured => {
    # Evaluate before cleanup; lowering transfers fresh aggregates and
    # snapshots borrowed fields that a subsequent drop might mutate.
    let type=hir.node_at(session.hir id).value_type
    let empty=types.primitive('void' @session.types)
    let name="__dewy_drop_result_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=type
    bindings.store_binding(@session.registry binding_id binding)
    let declaration=put(hir.Declare[loc empty 'let' name type id binding_id] @session)
    let value=put(hir.ExpressedIdentifier[loc type name binding_id] @session)
    return Captured[declaration value]
}
# Fresh arguments supply owners; a checked place argument only lends one.
owning_argument = (id:addr allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?=none):>void => {
    let node=hir.node_at(session.hir id)
    if node isnt? hir.Place and resource(node.value_type session.types) isnt? none {fresh(id allowed inherited @plan @session frame=frame)}
    else {expression(id allowed inherited @plan @session frame=frame)}
}
expression = (id:addr allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?=none):>void => {
    if plan.problem isnt? none return
    let node=hir.node_at(session.hir id)
    if frame isnt? none and node is? hir.Block|hir.Flow|hir.Return|hir.Break|hir.Continue {
        let active=frame.owners
        if node is? hir.Block and not node.scoped {node.scoped=true store(id node @session)}
        statement(id @active frame.loops frame.allowed frame.inherited frame.owning_result @plan @session composed_parent=frame.composed_parent)
        return
    }
    if node is? hir.FunctionLiteral {prepare_function(id @plan @session) return}
    if node is? hir.TypeValue or (node is? hir.FunctionCall and node.proof) or (node is? hir.Assert and not node.runtime and not node.expect) return
    if node is? hir.MemberAccess|hir.ForwardingAccess|hir.ArrayLength {
        let selected=if node is? hir.MemberAccess|hir.ForwardingAccess node.value else node.array
        if resource(hir.node_at(session.hir selected).value_type session.types) isnt? none {
        let owner=hir.node_at(session.hir selected)
        loop owner is? hir.MemberAccess|hir.Index {
            if owner is? hir.Index {expression(owner.index allowed inherited @plan @session frame=frame)}
            owner=hir.node_at(session.hir if owner is? hir.MemberAccess owner.value else owner.array)
        }
        if owner isnt? hir.ExpressedIdentifier or owner.binding_id is? none or owner.binding_id not in? allowed or resource(node.value_type session.types) isnt? none {reject(node 'an escaping or projected resource owner' @plan)}
        return
        }
    }
    if node is? hir.TypeTest and resource(hir.node_at(session.hir node.value).value_type session.types) isnt? none {
        let value=hir.node_at(session.hir node.value)
        let borrowed=put(hir.Place[node.loc value.value_type node.value] @session)
        expression(borrowed allowed inherited @plan @session frame=frame)
        return
    }
    if node is? hir.FunctionCall and inherited {
        let function=hir.node_at(session.hir node.func)
        if function is? hir.ExpressedIdentifier and function.binding_id isnt? none and function.binding_id in? plan.hooks {
            if node.pos_args.length not=? 1 {reject(node 'an invalid inherited drop receiver' @plan) return}
            let place=hir.node_at(session.hir node.pos_args[0])
            if place isnt? hir.Place {reject(node 'an invalid inherited drop receiver' @plan) return}
            let value=hir.node_at(session.hir place.target)
            if value isnt? hir.ExpressedIdentifier or value.binding_id is? none or value.binding_id not in? allowed {reject(node 'an escaping inherited drop receiver' @plan)}
            return
        }
    }
    if node is? hir.Place {
        let path=hir.node_at(session.hir node.target)
        loop path is? hir.MemberAccess|hir.Index {
            if path is? hir.Index {expression(path.index allowed inherited @plan @session frame=frame)}
            path=hir.node_at(session.hir if path is? hir.MemberAccess path.value else path.array)
        }
        if resource(path.value_type session.types) isnt? none {
            # Ordinary checked places lend storage, not resource ownership.
            if path isnt? hir.ExpressedIdentifier or path.binding_id is? none or path.binding_id not in? allowed {reject(node 'an unavailable resource borrow' @plan)}
            return
        }
    }
    if node is? hir.FunctionCall and resource(node.value_type session.types) is? none {
        expression(node.func allowed inherited @plan @session frame=frame)
        loop argument in node.pos_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        loop [name argument] in node.kw_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        return
    }
    if resource(node.value_type session.types) isnt? none {reject(node 'a resource copy, move, temporary, or escape' @plan) return}
    loop child in hir.children(node) {expression(child allowed inherited @plan @session frame=frame)}
}
scoped_body = (id:addr @session:contexts.Session):>addr => {
    let node=hir.node_at(session.hir id)
    if node is? hir.Block {
        if not node.scoped {node.scoped=true store(id node @session)}
        return id
    }
    return put(hir.Block[node.loc node.value_type [id] true] @session)
}
statement = (id:addr @owners:array<addr> loops:array<addr> allowed:set<addr> inherited:bool owning_result:bool @plan:Plan @session:contexts.Session composed_parent:addr?=none entry:bool=false):>void => {
    if plan.problem isnt? none return
    let node=hir.node_at(session.hir id)
    let frame=Frame[owners loops allowed inherited owning_result composed_parent]
    let live=allowed
    loop binding in plan.view_bindings {live.add(binding)}
    loop owner in owners {
        let declaration=hir.node_at(session.hir owner)
        $runtime_assert declaration is? hir.Declare and declaration.binding_id isnt? none
        live.add(declaration.binding_id)
    }
    if node is? hir.Block {
        let current:hir.Block=node
        let active=owners
        let start=if entry 0 else active.length
        loop item in current.items {statement(item @active loops allowed inherited owning_result @plan @session composed_parent=composed_parent)}
        if plan.problem isnt? none return
        if current.scoped and active.length >? start {
            let result:addr?=none
            if not types.is_primitive(types.node_at(session.types current.value_type) 'void') and not types.is_primitive(types.node_at(session.types current.value_type) 'never') {
                let expressed:array<addr>=[]
                loop index in 0.. and index <? current.items.length {
                    let item=hir.node_at(session.hir current.items[index])
                    if not types.is_primitive(types.node_at(session.types item.value_type) 'void') {expressed.push(index)}
                }
                if expressed.length not=? 1 {reject(current 'an implicit result without a unique value' @plan) return}
                let index=expressed[0]
                $runtime_assert index <? current.items.length
                let saved=capture_result(current.items[index] current.loc @session)
                current.items[index]=saved.declaration
                result=saved.value
            }
            let locals:array<addr>=[]
            let index:addr=start
            loop index <? active.length {locals.push(active[index]) index+=1}
            loop call in cleanup(locals current.loc @plan @session) {current.items.push(call)}
            if result isnt? none {current.items.push(result)}
            store(id current @session)
        }
        if not current.scoped {owners=active}
        return
    }
    if node is? hir.Declare and resource(hir.node_at(session.hir node.expr).value_type session.types) isnt? none {
        let declared:hir.Declare=node
        let value=hir.node_at(session.hir declared.expr)
        let same_array=false
        if declared.annotation isnt? none {
            let expected=types.node_at(session.types views.structural_base(declared.annotation session.types))
            let actual=types.node_at(session.types views.structural_base(value.value_type session.types))
            same_array=expected is? types.ArrayType and actual is? types.ArrayType and types.same_type(expected.element actual.element session.types)
        }
        if declared.binding_id is? none or (declared.annotation isnt? none and not types.same_type(declared.annotation value.value_type session.types) and not same_array) {reject(declared 'a non-fresh local owner' @plan) return}
        if id in? plan.transfer_sites and value is? hir.ExpressedIdentifier {
            let retained:array<addr>=[]
            let source:addr?=none
            loop owner in owners {
                let declaration=hir.node_at(session.hir owner)
                $runtime_assert declaration is? hir.Declare
                if declaration.binding_id =? value.binding_id {source=owner}
                else {retained.push(owner)}
            }
            if source isnt? none {
                let result=transfer(declared.expr value.value_type @plan @session)
                let moved=result not=? declared.expr
                declared.expr=result
                let calls:array<addr>=[]
                if moved {calls=cleanup([source] declared.loc @plan @session fields_only=source)}
                if calls.length >? 0 {
                    let declaration_id=put(declared @session)
                    retained.push(declaration_id)
                    let items:array<addr>=[declaration_id]
                    loop call in calls {items.push(call)}
                    store(id hir.Block[declared.loc declared.value_type items false] @session)
                } else {store(id declared @session) retained.push(id)}
                owners=retained
                return
            }
        }
        if id in? plan.view_sites and value is? hir.ExpressedIdentifier and value.binding_id isnt? none and value.binding_id in? live {
            plan.view_bindings.add(declared.binding_id)
            declared.view=true
            store(id declared @session)
            return
        }
        if declared.view {reject(declared 'a resource view without a stable lifetime' @plan) return}
        fresh(declared.expr live inherited @plan @session frame=frame)
        owners.push(id)
        return
    }
    if node is? hir.Return {
        let current:hir.Return=node
        let consumed:addr?=none
        let moved=false
        if current.item isnt? none {
            if owning_result and resource(hir.node_at(session.hir current.item).value_type session.types) isnt? none {
                # An explicit return ends this path. Only a local owner,
                # never a borrowed parameter, can transfer to the caller.
                let returned_id:addr=current.item
                let returned=hir.node_at(session.hir returned_id)
                if composed_parent isnt? none {
                    $runtime_assert returned is? hir.ObjectLiteral
                    fresh(returned_id live false @plan @session components=set[composed_parent] frame=frame)
                    loop owner in owners {
                        let declaration=hir.node_at(session.hir owner)
                        $runtime_assert declaration is? hir.Declare
                        if declaration.binding_id =? composed_parent {consumed=owner break}
                    }
                    $runtime_assert consumed isnt? none
                } else if returned is? hir.ExpressedIdentifier and returned.binding_id isnt? none {
                    loop owner in owners {
                        let declaration=hir.node_at(session.hir owner)
                        $runtime_assert declaration is? hir.Declare
                        if declaration.binding_id =? returned.binding_id {
                            consumed=owner
                            let result=transfer(returned_id plan.result_type @plan @session)
                            moved=result not=? returned_id
                            current.item=result
                            break
                        }
                    }
                }
                if consumed is? none {fresh(returned_id live false @plan @session frame=frame)}
            }
            else {expression(current.item live inherited @plan @session frame=frame)}
        }
        if plan.problem isnt? none or owners.length =? 0 return
        let items:array<addr>=[]
        if current.item isnt? none and hir.node_at(session.hir current.item) isnt? hir.NoneValue {
            let returned:addr=current.item
            let value=hir.node_at(session.hir returned)
            let saved=capture_result(returned current.loc @session)
            items.push(saved.declaration)
            current.item=saved.value
        }
        let released:array<addr>=[]
        loop owner in owners {if moved or consumed is? none or owner not=? consumed {released.push(owner)}}
        loop call in cleanup(released current.loc @plan @session fields_only=if moved consumed else none) {items.push(call)}
        items.push(put(current @session))
        store(id hir.Block[current.loc current.value_type items false] @session)
        return
    }
    if node is? hir.Break|hir.Continue {
        let current:hir.Break|hir.Continue=node
        if current.loop_levels >=? loops.length {reject(current 'an unresolved loop cleanup boundary' @plan) return}
        let selected=loops.length-1-current.loop_levels
        $runtime_assert selected >=? 0 and selected <? loops.length
        let boundary=loops[selected]
        let released:array<addr>=[]
        let index:addr=boundary
        loop index <? owners.length {released.push(owners[index]) index+=1}
        if released.length >? 0 {
            let items=cleanup(released current.loc @plan @session)
            items.push(put(current @session))
            store(id hir.Block[current.loc current.value_type items false] @session)
        }
        return
    }
    if node is? hir.Flow {
        let current:hir.Flow=node
        loop arm_id in current.arms {
            let arm=hir.node_at(session.hir arm_id)
            $runtime_assert arm is? hir.IfArm|hir.LoopArm
            let branch:hir.IfArm|hir.LoopArm=arm
            expression(branch.condition live inherited @plan @session frame=frame)
            let boundaries=loops
            if branch is? hir.LoopArm {boundaries.push(owners.length)}
            let body=scoped_body(branch.body @session)
            let active=owners
            statement(body @active boundaries allowed inherited owning_result @plan @session composed_parent=composed_parent)
            let rewritten=if branch is? hir.IfArm hir.IfArm[branch.loc branch.value_type branch.condition body] else hir.LoopArm[branch.loc branch.value_type branch.condition body]
            store(arm_id rewritten @session)
        }
        if current.default isnt? none {
            let body=scoped_body(current.default @session)
            let active=owners
            statement(body @active loops allowed inherited owning_result @plan @session composed_parent=composed_parent)
            current.default=body
        }
        store(id current @session)
        return
    }
    if owning_result and resource(node.value_type session.types) isnt? none {fresh(id live false @plan @session frame=frame)}
    else {expression(id live inherited @plan @session frame=frame)}
}
mentions_resource = (root:addr session:contexts.Session):>bool => {
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen {continue}
        seen.add(id)
        let node=hir.node_at(session.hir id)
        if resource(node.value_type session.types) isnt? none return true
        if node is? hir.FunctionLiteral {
            if resource(node.rettype session.types) isnt? none return true
            loop parameter in node.pos_or_kw_args {if resource(parameter.value_type session.types) isnt? none return true}
            loop parameter in node.kw_only_args {if resource(parameter.value_type session.types) isnt? none return true}
            if node.rest_args isnt? none and resource(node.rest_args.value_type session.types) isnt? none return true
        }
        hir.push_children(node @pending)
    }
    return false
}
# Before cleanup adds artificial reads, identify last uses transferring
# between declarations in one lexical block. Outer-owner conditional moves
# need lifetime joins and are deliberately excluded by the same-block rule.
local_transfers = (body:addr @plan:Plan session:contexts.Session):>void => {
    let last:dict<addr addr>=[]
    let occurrences:dict<addr int>=[]
    let captured:set<addr>=set[]
    let written:set<addr>=set[]
    let blocks:array<addr>=[]
    let pending:array<addr>=[body]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(session.hir id)
        if node is? hir.FunctionLiteral {
            let nested:array<addr>=[id]
            loop nested.length >? 0 {
                let child=hir.node_at(session.hir nested.pop)
                if child is? hir.ExpressedIdentifier and child.binding_id isnt? none {captured.add(child.binding_id)}
                hir.push_children(child @nested)
            }
            continue
        }
        let target:addr?=none
        if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign|hir.Place {target=node.target}
        else if node is? hir.ArrayMethod {target=node.array}
        else if node is? hir.Transmute {target=node.expr}
        if target isnt? none {
            let root=hir.node_at(session.hir target)
            loop root is? hir.MemberAccess|hir.Index {root=hir.node_at(session.hir if root is? hir.MemberAccess root.value else root.array)}
            if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {written.add(root.binding_id)}
        }
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            last[node.binding_id]=id
            occurrences[id]=occurrences.get(id 0)+1
        }
        if node is? hir.Block {blocks.push(id)}
        let children:array<addr>=[]
        hir.push_children(node @children)
        # Stack order must preserve the order of statements in each block.
        loop children.length >? 0 {pending.push(children.pop)}
    }
    loop id in blocks {
        let block=hir.node_at(session.hir id)
        $runtime_assert block is? hir.Block
        let locals:set<addr>=set[]
        loop item in block.items {
            let declaration=hir.node_at(session.hir item)
            if declaration isnt? hir.Declare continue
            let source=hir.node_at(session.hir declaration.expr)
            if source is? hir.ExpressedIdentifier and source.binding_id isnt? none and source.binding_id in? locals and source.binding_id not in? captured {
                if last.get(source.binding_id) =? declaration.expr and occurrences.get(declaration.expr 0) =? 1 {plan.transfer_sites.add(item)}
            }
            if declaration.binding_id isnt? none and source is? hir.ExpressedIdentifier and source.binding_id isnt? none and source.binding_id in? locals and source.binding_id not in? captured and declaration.binding_id not in? captured and source.binding_id not in? written and declaration.binding_id not in? written {plan.view_sites.add(item)}
            if declaration.binding_id isnt? none and resource(source.value_type session.types) isnt? none {locals.add(declaration.binding_id)}
        }
    }
}
# Make the result's ownership explicit while retaining its evaluation point.
# A value before trailing statements needs a saved owner, not an early return.
returnable_result = (id:addr session:contexts.Session):>bool => {
    let node=hir.node_at(session.hir id)
    if types.is_primitive(types.node_at(session.types node.value_type) 'never') return true
    if resource(node.value_type session.types) is? none return false
    if node is? hir.Block {
        let values:array<addr>=[]
        loop item in node.items {
            if not types.is_primitive(types.node_at(session.types hir.node_at(session.hir item).value_type) 'void') {values.push(item)}
        }
        if values.length not=? 1 return false
        return returnable_result(values[0] session)
    }
    if node is? hir.Flow {
        if node.default is? none or not returnable_result(node.default session) return false
        loop arm_id in node.arms {
            let arm=hir.node_at(session.hir arm_id)
            if arm isnt? hir.IfArm or not returnable_result(arm.body session) return false
        }
    }
    return true
}
return_result = (id:addr @session:contexts.Session):>addr => {
    let node=hir.node_at(session.hir id)
    if types.is_primitive(types.node_at(session.types node.value_type) 'never') return id
    let bottom=types.primitive('never' @session.types)
    if node is? hir.Block {
        let block:hir.Block=node
        $runtime_assert block.items.length >? 0
        let selected:addr?=none
        loop index in 0.. and index <? block.items.length {
            if not types.is_primitive(types.node_at(session.types hir.node_at(session.hir block.items[index]).value_type) 'void') {selected=index break}
        }
        $runtime_assert selected isnt? none and selected <? block.items.length
        let index:addr=selected
        if index =? block.items.length-1 {block.items[index]=return_result(block.items[index] @session)}
        else {
            let saved=capture_result(block.items[index] block.loc @session)
            block.items[index]=saved.declaration
            block.items.push(put(hir.Return[block.loc bottom saved.value] @session))
        }
        block.value_type=bottom
        store(id block @session)
        return id
    }
    if node is? hir.Flow {
        let flow:hir.Flow=node
        loop arm_id in flow.arms {
            let arm=hir.node_at(session.hir arm_id)
            $runtime_assert arm is? hir.IfArm
            let branch:hir.IfArm=arm
            branch.body=return_result(branch.body @session)
            branch.value_type=bottom
            store(arm_id branch @session)
        }
        $runtime_assert flow.default isnt? none
        flow.default=return_result(flow.default @session)
        flow.value_type=bottom
        store(id flow @session)
        return id
    }
    return put(hir.Return[node.loc bottom id] @session)
}
prepare_function = (id:addr @plan:Plan @session:contexts.Session):>void => {
    if id in? plan.prepared or plan.problem isnt? none return
    plan.prepared.add(id)
    let node=hir.node_at(session.hir id)
    $runtime_assert node is? hir.FunctionLiteral
    let function:hir.FunctionLiteral=node
    if function.proof return
    let previous=plan.source
    let previous_function_source=plan.function_source
    plan.function_source=function.source
    let previous_result=plan.result_type
    plan.result_type=function.rettype
    if function.source isnt? none {
        $runtime_assert function.source <? session.sources.length
        plan.source=session.sources[function.source].srcfile
    }
    let params=function.pos_or_kw_args
    loop parameter in function.kw_only_args {params.push(parameter)}
    if function.rest_args isnt? none {params.push(function.rest_args)}
    let allowed:set<addr>=set[]
    let parameter_owners:array<addr>=[]
    loop index in 0.. and index <? params.length {
        let parameter=params[index]
        if resource(parameter.value_type session.types) isnt? none {
            if parameter.binding_id is? none {reject(function 'unresolved owning parameter' @plan) return}
            if not parameter.place {
                let value=put(hir.ExpressedIdentifier[function.loc parameter.value_type parameter.name parameter.binding_id] @session)
                let empty=types.primitive('void' @session.types)
                parameter_owners.push(put(hir.Declare[function.loc empty 'let' parameter.name parameter.value_type value parameter.binding_id] @session))
            }
            allowed.add(parameter.binding_id)
        }
        if parameter is? hir.BoundParam {owning_argument(parameter.value allowed false @plan @session)}
    }
    # Leave ordinary helpers (especially the cached prelude) untouched.
    # Cleanup added inside another function is visible through its call edge.
    if function.lifecycle is? none and not mentions_resource(id session) {plan.source=previous plan.function_source=previous_function_source plan.result_type=previous_result return}
    if resource(function.rettype session.types) isnt? none and returnable_result(function.body session) {function.body=return_result(function.body @session)}
    function.body=scoped_body(function.body @session)
    local_transfers(function.body @plan session)
    let composed_parent:addr?=none
    if function.lifecycle_composition and function.lifecycle in? ['copy' 'move'] {
        let body=hir.node_at(session.hir function.body)
        $runtime_assert body is? hir.Block and body.items.length =? 2
        let parent=hir.node_at(session.hir body.items[0])
        $runtime_assert parent is? hir.Declare
        composed_parent=parent.binding_id
    }
    let owners=parameter_owners
    statement(function.body @owners [] allowed function.lifecycle =? 'drop' resource(function.rettype session.types) isnt? none @plan @session composed_parent=composed_parent entry=true)
    store(id function @session)
    plan.source=previous
    plan.function_source=previous_function_source
    plan.result_type=previous_result
}
prepare = (roots:array<addr> source:SrcFile @session:contexts.Session):>Error? => {
    let plan=Plan[source=source]
    # Hooks are hoisted module declarations. Unannotated programs need only
    # this small inventory scan, not another traversal of every function body.
    let items:array<addr>=[]
    loop root in roots {
        let block=hir.node_at(session.hir root)
        $runtime_assert block is? hir.Block
        loop item in block.items {items.push(item)}
    }
    loop id in items {
        let node=hir.node_at(session.hir id)
        if node isnt? hir.Declare or node.binding_id is? none {continue}
        let value=hir.node_at(session.hir node.expr)
        if value isnt? hir.FunctionLiteral or value.lifecycle is? none {continue}
        if value.source isnt? none {
            $runtime_assert value.source <? session.sources.length
            plan.source=session.sources[value.source].srcfile
        }
        if value.lifecycle not in? ['drop' 'copy' 'move'] or value.pos_or_kw_args.length =? 0 {reject(node 'an invalid lifecycle receiver' @plan) return plan.problem}
        let owner=views.structural_base(value.pos_or_kw_args[0].value_type session.types)
        let type=types.node_at(session.types owner)
        $runtime_assert type is? types.ObjectType and type.brand isnt? none
        let hook=Hook[owner node.binding_id node.name value.value_type value.lifecycle]
        plan.hooks[node.binding_id]=hook
        if value.lifecycle =? 'drop' {plan.owners[type.brand]=hook}
        if value.lifecycle =? 'move' {plan.moves[type.brand]=hook}
    }
    if plan.hooks.length =? 0 return none
    loop root in roots {
        let block=hir.node_at(session.hir root)
        $runtime_assert block is? hir.Block
        loop item in block.items {
            let node=hir.node_at(session.hir item)
            if node is? hir.Declare and hir.node_at(session.hir node.expr) is? hir.FunctionLiteral {prepare_function(node.expr @plan @session)}
            else {expression(item set[] false @plan @session)}
            if plan.problem isnt? none return plan.problem
        }
    }
    if plan.generated.length >? 0 {
        $runtime_assert roots.length >? 0
        let root=hir.node_at(session.hir roots[0])
        $runtime_assert root is? hir.Block
        let block:hir.Block=root
        loop declaration in plan.generated {block.items.push(declaration)}
        store(roots[0] block @session)
    }
    return none
}

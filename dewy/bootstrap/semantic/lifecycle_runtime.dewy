from reporting import SrcFile, Error, Pointer, Span
import p"context.dewy" as contexts
import p"hir.dewy" as hir
import p"lifecycle.dewy" as lifecycle
import p"ty.dewy" as types
import p"type_queries.dewy" as views
import p"bindings.dewy" as bindings
import p"propositions.dewy" as facts
import p"analyze/effects.dewy" as effects
import p"analyze/ownership_liveness.dewy" as ownership_liveness
import p"analyze/predicate_effects.dewy" as predicate_effects

# Materialize operations before reachability and lowering. Fresh records and
# arrays own their nested resources. Factories, by-value parameters and results
# transfer fresh owners; checked @ parameters borrow. Same-scope bindings move
# at last use. Custom copy/move hooks remain checked calls, and drop precedes
# field/element storage cleanup. Branch consumption uses last-use proofs and
# conditional cleanup. Replacements re-establish ownership across checked
# backedges. Last-use components transfer through synthesized wrappers; using
# remaining parts of a partially transferred owner still needs further analysis.
Extraction:type = const [binding:addr path:array<string|addr> moved:bool=false]
Hook:type = const [owner:addr binding:addr name:string signature:addr role:string]
# An expression can contain a block, branch, or early return. Carry its
# enclosing lexical lifetime explicitly through expression traversal.
Frame:type = const [
    owners:array<addr> loops:array<addr> allowed:set<addr>
    inherited:bool owning_result:bool composed_parent:addr?
]
Plan:type = [
    flags:dict<addr Captured>=[]
    extractions:dict<addr array<Extraction>>=[]
    hooks:dict<addr Hook>=[]
    composed_moves:dict<addr addr>=[]
    owners:dict<string Hook>=[]
    moves:dict<string Hook>=[]
    copies:dict<string Hook>=[]
    prepared:set<addr>=set[]
    transfer_sites:set<addr>=set[]
    consume_sites:set<addr>=set[]
    consumed_bindings:set<addr>=set[]
    iteration_loans:set<addr>=set[]
    view_sites:set<addr>=set[]
    view_bindings:set<addr>=set[]
    recursive_drops:dict<string addr>=[]
    array_drops:dict<addr addr>=[]
    array_clears:dict<addr addr>=[]
    array_suffixes:dict<addr addr>=[]
    argument_writes:dict<addr set<addr>>=[]
    readonly_arguments:set<addr>=set[]
    component_copies:dict<addr addr>=[]
    generated:array<addr>=[]
    function_source:addr?=none
    source:SrcFile
    problem:Error?=none
    result_type:addr?=none
]
put = (node:hir.AST @session:contexts.Session):>addr => hir.append_node(@session.hir node)
store = (id:addr node:hir.AST @session:contexts.Session):>void => {
    contexts.replace_hir(id node @session)
}
reject = (node:hir.AST detail:string @plan:Plan):>void => {
    if plan.problem is? none {plan.problem=Error[srcfile=plan.source title="not implemented: lifecycle ownership lowering: {detail}" pointers=[Pointer[node.loc 'this ownership operation is not implemented yet']]]}
}
resource = (id:addr nodes:types.Table):>addr? => {
    let pending:array<addr>=[id]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=views.structural_base(pending.pop nodes)
        if id in? seen {continue}
        seen.add(id)
        let type=types.node_at(nodes id)
        if type is? types.ObjectType {
            loop method in type.methods {if method.lifecycle isnt? none return id}
            loop field in type.fields {pending.push(field.value_type)}
        } else if type is? types.ArrayType {pending.push(type.element)}
        else if type is? types.TypeOr {loop member in type.items {pending.push(member)}}
    }
    return none
}
Suffix:type = const [first:addr before:addr]
# Added fields transfer through compiler-generated inherited moves. Follow
# the composition chain to find the original hook's leftover parent fields.
move_remainder=(shape:types.ObjectType plan:Plan session:contexts.Session):>array<types.ObjectField>=>{
    let current=shape
    loop current.brand isnt? none {
        let hook=plan.moves.get(current.brand)
        if hook is? none {break}
        let binding=bindings.binding_at(session.registry hook.binding)
        $runtime_assert binding.function isnt? none
        let operation=hir.node_at(session.hir binding.function)
        $runtime_assert operation is? hir.FunctionLiteral
        if not operation.lifecycle_composition {break}
        $runtime_assert current.parent isnt? none
        let parent=types.node_at(session.types views.structural_base(current.parent session.types))
        $runtime_assert parent is? types.ObjectType
        current=parent
    }
    return current.fields
}
drop_value = (value:addr type_id:addr loc:Span ancestors:set<addr> @calls:array<addr> @plan:Plan @session:contexts.Session run_hook:bool=true tail:Suffix?=none extraction:Extraction?=none additional:array<Extraction>=[] inline_array:bool=false):>void => {
    if extraction isnt? none and extraction.path.length=?0 {
        if not extraction.moved return
        run_hook=false
        extraction=none
        additional=[]
    }
    let routes=additional
    if extraction isnt? none {routes.push(extraction)}
    if plan.problem isnt? none or resource(type_id session.types) is? none return
    let owner=views.structural_base(type_id session.types)
    let type=types.node_at(session.types owner)
    if owner in? ancestors and routes.length=?0 {
        # Close recursive structural expansion with a checked borrowed helper.
        # Publish the callable before its body so recursive calls reuse it.
        let key="{owner}:{run_hook}"
        let operation=plan.recursive_drops.get(key)
        let empty=types.primitive('void' @session.types)
        if operation is? none {
            let name="__dewy_drop_recursive_{session.registry.next_id}"
            let binding_id=bindings.allocate(@session.registry none name 'value' loc)
            let parameter_id=bindings.allocate(@session.registry none '__source' 'param' loc)
            let parameter=bindings.binding_at(session.registry parameter_id)
            parameter.value_type=owner parameter.store_type=owner
            bindings.store_binding(@session.registry parameter_id parameter)
            let signature=types.function_type([types.PosOrKwArg['__source' owner place=true]] [] none empty [] @session.types)
            operation=put(hir.ExpressedIdentifier[loc signature name binding_id] @session)
            plan.recursive_drops[key]=operation
            let receiver=put(hir.ExpressedIdentifier[loc owner '__source' parameter_id] @session)
            let body:array<addr>=[]
            drop_value(receiver owner loc set[] @body @plan @session run_hook=run_hook)
            let block=put(hir.Block[loc empty body true] @session)
            let function=put(hir.FunctionLiteral[loc signature [hir.Param['__source' owner parameter_id place=true]] [] none empty block source=plan.function_source] @session)
            let declaration=put(hir.Declare[loc empty 'const' name signature function binding_id] @session)
            let binding=bindings.binding_at(session.registry binding_id)
            binding.value_type=signature binding.function=function binding.declaration=declaration
            bindings.store_binding(@session.registry binding_id binding)
            plan.generated.push(declaration)
        }
        $runtime_assert operation isnt? none
        let place=put(hir.Place[loc owner value] @session)
        calls.push(put(hir.FunctionCall[loc empty operation [place] []] @session))
        return
    }
    if type is? types.ArrayType and extraction isnt? none and not inline_array and hir.node_at(session.hir value) isnt? hir.ExpressedIdentifier {
        # An inner traversal needs its own borrowed identity: the caller's
        # outer cursor changes. Saved selector values become scalar arguments.
        let name="__dewy_drop_selected_{session.registry.next_id}"
        let binding_id=bindings.allocate(@session.registry none name 'value' loc)
        let parameter_id=bindings.allocate(@session.registry none '__items' 'param' loc)
        let parameter=bindings.binding_at(session.registry parameter_id)
        parameter.value_type=owner parameter.store_type=owner
        bindings.store_binding(@session.registry parameter_id parameter)
        let params:array<hir.Param>=[hir.Param['__items' owner parameter_id place=true]]
        let signature_params:array<types.PosOrKwArg>=[types.PosOrKwArg['__items' owner place=true]]
        let arguments:array<addr>=[put(hir.Place[loc owner value] @session)]
        let translated:array<Extraction>=[]
        let word=types.primitive('int64' @session.types)
        let empty=types.primitive('void' @session.types)
        loop route in routes {
            let path:array<string|addr>=[]
            loop selector in route.path {
                if selector is? string {path.push(selector) continue}
                if hir.node_at(session.hir selector) is? hir.Integer {path.push(selector) continue}
                let param_name="__index_{params.length}"
                let param_id=bindings.allocate(@session.registry none param_name 'param' loc)
                let param=bindings.binding_at(session.registry param_id)
                param.value_type=word param.store_type=word
                bindings.store_binding(@session.registry param_id param)
                params.push(hir.Param[param_name word param_id])
                signature_params.push(types.PosOrKwArg[param_name word])
                arguments.push(selector)
                path.push(put(hir.ExpressedIdentifier[loc word param_name param_id] @session))
            }
            translated.push(Extraction[route.binding path route.moved])
        }
        $runtime_assert translated.length>?0
        let first=translated.pop
        let signature=types.function_type(signature_params [] none empty [] @session.types)
        let receiver=put(hir.ExpressedIdentifier[loc owner '__items' parameter_id] @session)
        let body:array<addr>=[]
        drop_value(receiver owner loc set[] @body @plan @session extraction=first additional=translated inline_array=true)
        let block=put(hir.Block[loc empty body true] @session)
        let function=put(hir.FunctionLiteral[loc signature params [] none empty block source=plan.function_source] @session)
        let declaration=put(hir.Declare[loc empty 'const' name signature function binding_id] @session)
        let binding=bindings.binding_at(session.registry binding_id)
        binding.value_type=signature binding.function=function binding.declaration=declaration
        bindings.store_binding(@session.registry binding_id binding)
        plan.generated.push(declaration)
        let operation=put(hir.ExpressedIdentifier[loc signature name binding_id] @session)
        calls.push(put(hir.FunctionCall[loc empty operation arguments []] @session))
        return
    }
    if type is? types.ArrayType and extraction isnt? none {
        let empty=types.primitive('void' @session.types)
        let word=types.primitive('int64' @session.types)
        let boolean=types.primitive('bool' @session.types)
        let length=put(hir.ArrayLength[loc word value] @session)
        let cursor=capture_result(length loc @session)
        let zero=put(hir.Integer[loc word '0d' 0] @session)
        let one=put(hir.Integer[loc word '0d' 1] @session)
        let signature=types.function_type([types.PosOrKwArg[none word] types.PosOrKwArg[none word]] [] none boolean [] @session.types)
        let greater=put(hir.ExpressedIdentifier[loc signature '__gt__' none] @session)
        let equal=put(hir.ExpressedIdentifier[loc signature '__eq__' none] @session)
        let condition=put(hir.FunctionCall[loc boolean greater [cursor.value zero] []] @session)
        let element=put(hir.Index[loc type.element value cursor.value none] @session)
        let nested=ancestors
        nested.add(owner)
        # Equal literal selectors share one arm, so disjoint fields in the
        # same element retain all their transferred-component exclusions.
        let pending=routes
        let selected_arms:array<addr>=[]
        loop pending.length>?0 {
            let selected_route=pending.pop
            $runtime_assert selected_route.path.length>?0
            let selector=selected_route.path[0]
            $runtime_assert selector is? addr
            let selected_node=hir.node_at(session.hir selector)
            let matching:array<Extraction>=[selected_route]
            let rest:array<Extraction>=[]
            loop route in pending {
                $runtime_assert route.path.length>?0
                let other=route.path[0]
                $runtime_assert other is? addr
                let other_node=hir.node_at(session.hir other)
                if other=?selector or (selected_node is? hir.Integer and other_node is? hir.Integer and selected_node.value=?other_node.value) {matching.push(route)}
                else {rest.push(route)}
            }
            pending=rest
            let children:array<Extraction>=[]
            loop route in matching {
                let path:array<string|addr>=[]
                let i:addr=1
                loop i<?route.path.length {path.push(route.path[i]) i+=1}
                children.push(Extraction[route.binding path route.moved])
            }
            $runtime_assert children.length>?0
            let first=children.pop
            let selected_calls:array<addr>=[]
            drop_value(element type.element loc nested @selected_calls @plan @session extraction=first additional=children)
            let selected_condition=put(hir.FunctionCall[loc boolean equal [cursor.value selector] []] @session)
            let selected_body=put(hir.Block[loc empty selected_calls true] @session)
            selected_arms.push(put(hir.IfArm[loc empty selected_condition selected_body] @session))
        }
        let other_calls:array<addr>=[]
        drop_value(element type.element loc nested @other_calls @plan @session)
        let other_body=put(hir.Block[loc empty other_calls true] @session)
        let choice=put(hir.Flow[loc empty selected_arms other_body] @session)
        let decrement=put(hir.Assign[loc empty cursor.value '-=' one] @session)
        let body=put(hir.Block[loc empty [decrement choice] true] @session)
        let arm=put(hir.LoopArm[loc empty condition body] @session)
        calls.push(cursor.declaration)
        calls.push(put(hir.Flow[loc empty [arm] none] @session))
        return
    }
    if type is? types.ArrayType {
        let operation=if tail is? none plan.array_drops.get(owner) else plan.array_suffixes.get(owner)
        let empty=types.primitive('void' @session.types)
        if operation is? none {
            let name="__dewy_drop_array_{session.registry.next_id}"
            let binding_id=bindings.allocate(@session.registry none name 'value' loc)
            let parameter_id=bindings.allocate(@session.registry none '__items' 'param' loc)
            let parameter=bindings.binding_at(session.registry parameter_id)
            parameter.value_type=owner
            parameter.store_type=owner
            bindings.store_binding(@session.registry parameter_id parameter)
            let parameters:array<hir.Param>=[hir.Param['__items' owner parameter_id place=true]]
            let signature_parameters:array<types.PosOrKwArg>=[types.PosOrKwArg['__items' owner place=true]]
            let result=empty
            let limit:addr?=none
            if tail isnt? none {
                let word=types.primitive('int64' @session.types)
                let first_id=bindings.allocate(@session.registry none '__first' 'param' loc)
                let first_type=types.refined_type(word [facts.Proposition['self' '>=?' 0]] @session.types)
                let first=bindings.binding_at(session.registry first_id)
                first.value_type=first_type first.store_type=first_type
                bindings.store_binding(@session.registry first_id first)
                let before_id=bindings.allocate(@session.registry none '__before' 'param' loc)
                let before_type=types.refined_type(word [facts.Proposition['self' '=?' term='__items' term_id=parameter_id]] @session.types)
                let before=bindings.binding_at(session.registry before_id)
                before.value_type=before_type before.store_type=before_type
                bindings.store_binding(@session.registry before_id before)
                parameters.push(hir.Param['__first' first_type first_id])
                parameters.push(hir.Param['__before' before_type before_id])
                signature_parameters.push(types.PosOrKwArg['__first' first_type])
                signature_parameters.push(types.PosOrKwArg['__before' before_type])
                result=types.refined_type(empty [facts.Proposition['@__items' '=?' projection='length' subject_id=parameter_id term='__before' term_id=before_id term_projection='value']] @session.types)
                limit=put(hir.ExpressedIdentifier[loc first_type '__first' first_id] @session)
            }
            let signature=types.function_type(signature_parameters [] none result [] @session.types)
            let receiver=put(hir.ExpressedIdentifier[loc owner '__items' parameter_id] @session)
            let word=types.primitive('int64' @session.types)
            let boolean=types.primitive('bool' @session.types)
            let length=put(hir.ArrayLength[loc word receiver] @session)
            let cursor=capture_result(length loc @session)
            let zero=put(hir.Integer[loc word '0d' 0] @session)
            let one=put(hir.Integer[loc word '0d' 1] @session)
            let comparison_type=types.function_type([types.PosOrKwArg[none word] types.PosOrKwArg[none word]] [] none boolean [] @session.types)
            let comparison=put(hir.ExpressedIdentifier[loc comparison_type '__gt__' none] @session)
            let endpoint=if limit is? none zero else limit
            let condition=put(hir.FunctionCall[loc boolean comparison [cursor.value endpoint] []] @session)
            let body:array<addr>=[put(hir.Assign[loc empty cursor.value '-=' one] @session)]
            let element=put(hir.Index[loc type.element receiver cursor.value none] @session)
            let nested=ancestors
            nested.add(owner)
            drop_value(element type.element loc nested @body @plan @session)
            let block=put(hir.Block[loc empty body true] @session)
            let arm=put(hir.LoopArm[loc empty condition block] @session)
            let loop_body=put(hir.Flow[loc empty [arm] none] @session)
            let statements:array<addr>=[cursor.declaration loop_body]
            if tail isnt? none {
                let returned=put(hir.Void[loc empty] @session)
                statements.push(put(hir.Obligation[loc empty returned result 'the generated suffix cleanup preserves length'] @session))
            }
            let function_body=put(hir.Block[loc empty statements true] @session)
            let function=put(hir.FunctionLiteral[loc signature parameters [] none empty function_body source=plan.function_source] @session)
            let declaration=put(hir.Declare[loc empty 'const' name signature function binding_id] @session)
            let binding=bindings.binding_at(session.registry binding_id)
            binding.value_type=signature binding.function=function binding.declaration=declaration
            bindings.store_binding(@session.registry binding_id binding)
            operation=put(hir.ExpressedIdentifier[loc signature name binding_id] @session)
            if tail is? none {plan.array_drops[owner]=operation}
            else {plan.array_suffixes[owner]=operation}
            plan.generated.push(declaration)
        }
        $runtime_assert operation isnt? none
        let place=put(hir.Place[loc owner value] @session)
        let arguments:array<addr>=[place]
        if tail isnt? none {arguments.push(tail.first) arguments.push(tail.before)}
        calls.push(put(hir.FunctionCall[loc empty operation arguments []] @session))
        return
    }
    if type is? types.TypeOr {
        let arms:array<addr>=[]
        let empty=types.primitive('void' @session.types)
        let boolean=types.primitive('bool' @session.types)
        let nested=ancestors
        nested.add(owner)
        loop member in type.items {
            if resource(member session.types) is? none continue
            if not run_hook {
                let member_type=types.node_at(session.types views.structural_base(member session.types))
                let moved=false
                if member_type is? types.ObjectType {loop method in member_type.methods {if method.lifecycle =? 'move' {moved=true}}}
                if not moved continue
            }
            let narrowed=hir.node_at(session.hir value)
            narrowed.value_type=member
            let selected=put(narrowed @session)
            let body:array<addr>=[]
            drop_value(selected member loc nested @body @plan @session run_hook=run_hook extraction=extraction additional=additional)
            let condition=put(hir.TypeTest[loc boolean value member false] @session)
            let block=put(hir.Block[loc empty body true] @session)
            arms.push(put(hir.IfArm[loc empty condition block] @session))
        }
        if arms.length >? 0 {calls.push(put(hir.Flow[loc empty arms none] @session))}
        return
    }
    if type isnt? types.ObjectType {reject(hir.node_at(session.hir value) 'unsupported resource storage' @plan) return}
    if type.brand =? 'dict' {calls.push(compact_dictionary(value type loc @session))}
    loop method in type.methods {
        if method.lifecycle not=? 'drop' or not run_hook continue
        if type.brand is? none {reject(hir.node_at(session.hir value) 'an unavailable drop operation' @plan) return}
        let hook=plan.owners.get(type.brand)
        if hook is? none {reject(hir.node_at(session.hir value) 'an unavailable drop operation' @plan) return}
        let function=put(hir.ExpressedIdentifier[loc hook.signature hook.name hook.binding] @session)
        let place=put(hir.Place[loc owner value] @session)
        let empty=types.primitive('void' @session.types)
        calls.push(put(hir.FunctionCall[loc empty function [place] []] @session))
    }
    # Parent body first, then fields in reverse declaration order. Backing
    # storage for the complete value is released by ordinary lowering later.
    let nested=ancestors
    nested.add(owner)
    let fields=if run_hook type.fields else move_remainder(type plan session)
    let index=fields.length
    loop index >? 0 {
        index-=1
        let field=fields[index]
        if resource(field.value_type session.types) is? none continue
        let member=put(hir.MemberAccess[loc field.value_type value field.name] @session)
        let remaining:array<Extraction>=[]
        loop route in routes {
            if route.path.length>?0 and route.path[0] is? string and route.path[0]=?field.name {
                let path:array<string|addr>=[]
                let i:addr=1
                loop i<?route.path.length {path.push(route.path[i]) i+=1}
                remaining.push(Extraction[route.binding path route.moved])
            }
        }
        let first:Extraction?=none
        if remaining.length>?0 {first=remaining.pop}
        drop_value(member field.value_type loc nested @calls @plan @session extraction=first additional=remaining)
    }
}
cleanup = (owners:array<addr> loc:Span @plan:Plan @session:contexts.Session fields_only:addr?=none extracted:Extraction?=none):>array<addr> => {
    let result:array<addr>=[]
    let index=owners.length
    loop index >? 0 {
        index-=1
        let declaration=hir.node_at(session.hir owners[index])
        $runtime_assert declaration is? hir.Declare and declaration.binding_id isnt? none
        let declared:hir.Declare=declaration
        if declared.binding_id isnt? none and declared.binding_id in? plan.consumed_bindings and owners[index] not=? fields_only {continue}
        let owner=if declared.annotation isnt? none declared.annotation else hir.node_at(session.hir declared.expr).value_type
        let value=put(hir.ExpressedIdentifier[loc owner declared.name declared.binding_id] @session)
        let calls:array<addr>=[]
        $runtime_assert declared.binding_id isnt? none
        let routes=plan.extractions.get(declared.binding_id [])
        if extracted isnt? none and extracted.binding=?declared.binding_id {routes.push(extracted)}
        let first:Extraction?=none
        if routes.length>?0 {first=routes.pop}
        drop_value(value owner loc set[] @calls @plan @session run_hook=fields_only is? none or owners[index] not=? fields_only extraction=first additional=routes)
        let flag=plan.flags.get(declared.binding_id)
        if flag isnt? none and owners[index] not=? fields_only {
            let empty=types.primitive('void' @session.types)
            let body=put(hir.Block[loc empty calls true] @session)
            let arm=put(hir.IfArm[loc empty flag.value body] @session)
            result.push(put(hir.Flow[loc empty [arm] none] @session))
        } else {loop call in calls {result.push(call)}}
    }
    return result
}
# Only synthesized wrappers may become partially owned at an exit. A custom
# lifecycle operation still requires its complete receiver. Borrowed bindings
# and aliases never appear in the owning declaration list.
returning_projection=(id:addr owners:array<addr> session:contexts.Session):>Extraction?=>{
    let value=hir.node_at(session.hir id)
    loop value is? hir.Obligation|hir.ValueCast|hir.RepresentationCast {
        value=hir.node_at(session.hir if value is? hir.Obligation value.value else value.expr)
    }
    let reverse_path:array<string|addr>=[]
    loop value is? hir.MemberAccess|hir.Index {
        if value is? hir.MemberAccess {
            let shape=types.node_at(session.types views.structural_base(hir.node_at(session.hir value.value).value_type session.types))
            if shape isnt? types.ObjectType return none
            loop method in shape.methods {if method.lifecycle isnt? none return none}
            reverse_path.push(value.name)
            value=hir.node_at(session.hir value.value)
        } else {
            reverse_path.push(value.index)
            value=hir.node_at(session.hir value.array)
        }
    }
    if reverse_path.length=?0 or value isnt? hir.ExpressedIdentifier or value.binding_id is? none return none
    loop owner in owners {
        let declaration=hir.node_at(session.hir owner)
        $runtime_assert declaration is? hir.Declare
        if declaration.binding_id not=?value.binding_id continue
        let path:array<string|addr>=[]
        loop reverse_path.length>?0 {path.push(reverse_path.pop)}
        return Extraction[value.binding_id path]
    }
    return none
}
transfer = (id:addr expected:addr? @plan:Plan @session:contexts.Session):>addr => {
    let value=hir.node_at(session.hir id)
    let shape=views.structural_base(value.value_type session.types)
    let type=types.node_at(session.types shape)
    if type is? types.TypeOr {
        let arms:array<addr>=[]
        let boolean=types.primitive('bool' @session.types)
        loop member in type.items {
            let narrowed=value
            narrowed.value_type=member
            let selected=put(narrowed @session)
            let result=transfer(selected member @plan @session)
            if result not=? selected {
                let condition=put(hir.TypeTest[value.loc boolean id member false] @session)
                arms.push(put(hir.IfArm[value.loc hir.node_at(session.hir result).value_type condition result] @session))
            }
        }
        if arms.length =? 0 return id
        let result=put(hir.Flow[value.loc value.value_type arms id] @session)
        if expected isnt? none and types.node_at(session.types expected) is? types.RefinedType {
            result=put(hir.Obligation[value.loc value.value_type result expected 'the return contract after moving'] @session)
        }
        return result
    }
    if type isnt? types.ObjectType return id
    if type.brand is? none return id
    let hook=plan.moves.get(type.brand)
    if hook is? none return id
    let signature=types.node_at(session.types hook.signature)
    $runtime_assert signature is? types.FunctionType
    if not types.same_type(views.structural_base(signature.ret session.types) shape session.types) {reject(value 'an adapted move receiver without a checked composition' @plan) return id}
    let function=put(hir.ExpressedIdentifier[value.loc hook.signature hook.name hook.binding] @session)
    let place=put(hir.Place[value.loc shape id] @session)
    let result=put(hir.FunctionCall[value.loc signature.ret function [place] []] @session)
    if expected isnt? none and types.node_at(session.types expected) is? types.RefinedType {
        result=put(hir.Obligation[value.loc signature.ret result expected 'the return contract after moving'] @session)
    }
    return result
}
# Synthesize logical component copies before facts/effects are checked.
# Each helper borrows its receiver once and constructs an independent result.
copy_operation = (owner:addr loc:Span @plan:Plan @session:contexts.Session):>addr => {
    let type=types.node_at(session.types owner)
    if type is? types.ObjectType and type.brand isnt? none {
        let hook=plan.copies.get(type.brand)
        if hook isnt? none return put(hir.ExpressedIdentifier[loc hook.signature hook.name hook.binding] @session)
    }
    let operation=plan.component_copies.get(owner)
    if operation isnt? none return operation
    if type isnt? types.ObjectType|types.TypeOr|types.ArrayType {
        reject(hir.Void[loc types.primitive('void' @session.types)] 'synthesized copies of this resource container' @plan)
        return put(hir.Void[loc owner] @session)
    }
    let name="__dewy_copy_components_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' loc)
    let parameter_id=bindings.allocate(@session.registry none '__source' 'param' loc)
    let parameter=bindings.binding_at(session.registry parameter_id)
    parameter.value_type=owner parameter.store_type=owner
    bindings.store_binding(@session.registry parameter_id parameter)
    let result_type=if type is? types.ArrayType types.refined_type(owner [facts.Proposition['length' '=?' term='__source' term_id=parameter_id]] @session.types) else owner
    let signature=types.function_type([types.PosOrKwArg['__source' owner place=true]] [] none result_type [] @session.types)
    operation=put(hir.ExpressedIdentifier[loc signature name binding_id] @session)
    plan.component_copies[owner]=operation
    let receiver=put(hir.ExpressedIdentifier[loc owner '__source' parameter_id] @session)
    let prefix:array<addr>=[]
    let value=if type is? types.ArrayType {
        let dynamic=types.array_type(type.element none @session.types)
        let empty_type=types.array_type(type.element 0 @session.types)
        let output_id=bindings.allocate(@session.registry none '__result' 'value' loc)
        let output=bindings.binding_at(session.registry output_id)
        output.value_type=dynamic
        let empty=types.primitive('void' @session.types)
        let word=types.primitive('int64' @session.types)
        let boolean=types.primitive('bool' @session.types)
        let initial=put(hir.ArrayLiteral[loc empty_type []] @session)
        let declaration=put(hir.Declare[loc empty 'let' '__result' dynamic initial output_id] @session)
        output.declaration=declaration
        bindings.store_binding(@session.registry output_id output)
        let result=put(hir.ExpressedIdentifier[loc dynamic '__result' output_id] @session)
        let zero=put(hir.Integer[loc word '0d' 0] @session)
        let one=put(hir.Integer[loc word '0d' 1] @session)
        let cursor=capture_result(zero loc @session)
        let comparison_type=types.function_type([types.PosOrKwArg[none word] types.PosOrKwArg[none word]] [] none boolean [] @session.types)
        let comparison=put(hir.ExpressedIdentifier[loc comparison_type '__lt__' none] @session)
        let length=put(hir.ArrayLength[loc word receiver] @session)
        let condition=put(hir.FunctionCall[loc boolean comparison [cursor.value length] []] @session)
        let selected=put(hir.Index[loc type.element receiver cursor.value none] @session)
        let element=copy_component(selected false @plan @session)
        let push_type=types.function_type([types.PosOrKwArg['value' type.element]] [] none empty [] @session.types)
        let push=put(hir.ArrayMethod[loc push_type result 'push'] @session)
        let append=put(hir.FunctionCall[loc empty push [element] []] @session)
        let advance=put(hir.Assign[loc empty cursor.value '+=' one] @session)
        let body=put(hir.Block[loc empty [append advance] true] @session)
        let arm=put(hir.LoopArm[loc empty condition body] @session)
        let loop_body=put(hir.Flow[loc empty [arm] none] @session)
        prefix=[declaration cursor.declaration loop_body]
        put(hir.Obligation[loc owner result result_type 'the generated array copy return contract'] @session)
    } else if type is? types.ObjectType {
        if type.brand =? 'dict' {prefix.push(compact_dictionary(receiver type loc @session))}
        let fields:array<hir.ObjectField>=[]
        loop field in type.fields {
            let source=put(hir.MemberAccess[loc field.value_type receiver field.name] @session)
            fields.push(hir.ObjectField[loc field.name copy_component(source false @plan @session)])
        }
        put(hir.ObjectLiteral[loc owner fields] @session)
    } else {
        $runtime_assert type is? types.TypeOr
        let arms:array<addr>=[]
        let fallback:addr?=none
        let boolean=types.primitive('bool' @session.types)
        let index:addr=0
        loop member in type.items {
            let selected=put(hir.ExpressedIdentifier[loc member '__source' parameter_id] @session)
            let result=copy_component(selected false @plan @session)
            result=put(hir.ValueCast[loc owner result] @session)
            if index+1 =? type.items.length {fallback=result}
            else {
                let condition=put(hir.TypeTest[loc boolean receiver member false] @session)
                arms.push(put(hir.IfArm[loc owner condition result] @session))
            }
            index+=1
        }
        put(hir.Flow[loc owner arms fallback] @session)
    }
    let bottom=types.primitive('never' @session.types)
    let empty=types.primitive('void' @session.types)
    let returned=put(hir.Return[loc bottom value] @session)
    prefix.push(returned)
    let body=put(hir.Block[loc bottom prefix true] @session)
    let function=put(hir.FunctionLiteral[loc signature [hir.Param['__source' owner parameter_id place=true]] [] none owner body source=plan.function_source] @session)
    let declaration=put(hir.Declare[loc empty 'const' name signature function binding_id] @session)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=signature binding.function=function binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    plan.generated.push(declaration)
    return operation
}
copy_component = (id:addr implicit:bool @plan:Plan @session:contexts.Session):>addr => {
    let source_node=hir.node_at(session.hir id)
    let owner=views.structural_base(source_node.value_type session.types)
    if resource(source_node.value_type session.types) is? none {
        let shape=types.node_at(session.types owner)
        return if shape is? types.ArrayType|types.ObjectType|types.TypeOr or views.string_valued(owner session.types) put(hir.CopyValue[source_node.loc source_node.value_type id] @session) else id
    }
    if lifecycle.copy_blocker(source_node.value_type session.types) isnt? none {
        if plan.problem is? none {plan.problem=Error[srcfile=plan.source title='lifecycle ownership lowering requires an independent copy' pointers=[Pointer[source_node.loc 'this move-only value is still owned elsewhere; declare $__copy__ or use a proven borrow or last-use transfer']]]}
        return id
    }
    let operation=copy_operation(owner source_node.loc @plan @session)
    let signature=types.node_at(session.types hir.node_at(session.hir operation).value_type)
    if signature isnt? types.FunctionType return id
    let place=put(hir.Place[source_node.loc owner id] @session)
    let result=put(hir.FunctionCall[source_node.loc signature.ret operation [place] [] implicit_copy=implicit] @session)
    if types.node_at(session.types source_node.value_type) is? types.RefinedType {
        result=put(hir.Obligation[source_node.loc signature.ret result source_node.value_type 'the value contract after copying'] @session)
    }
    return result
}
fresh = (id:addr allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session components:set<addr>=set[] frame:Frame?=none):>void => {
    # The checked custom-copy call carries its effects and result contract.
    let candidate=hir.node_at(session.hir id)
    if resource(candidate.value_type session.types) is? none {expression(id allowed inherited @plan @session frame=frame) return}
    if candidate is? hir.DictView {
        dictionary_view(id candidate allowed inherited @plan @session frame)
        return
    }
    if candidate is? hir.DictLookup and not candidate.proven {
        dictionary_get(id candidate allowed inherited @plan @session frame)
        return
    }
    if candidate is? hir.DictRemove and candidate.key isnt? none {
        dictionary_pop(id candidate allowed inherited @plan @session frame)
        return
    }
    if candidate is? hir.MemberAccess|hir.Index and id in? plan.consume_sites and frame isnt? none {
        let projection=returning_projection(id frame.owners session)
        if projection isnt? none {
            let prefix:array<addr>=[]
            let selected=freeze_route(id candidate.loc projection.binding @prefix @plan @session)
            let frozen=returning_projection(selected frame.owners session)
            $runtime_assert frozen isnt? none
            let result=transfer(selected candidate.value_type @plan @session)
            let saved=capture_result(result candidate.loc @session)
            let routes=plan.extractions.get(frozen.binding [])
            routes.push(Extraction[frozen.binding frozen.path result not=?selected])
            plan.extractions[frozen.binding]=routes
            # Preserve the wrapper's lexical lifetime. Its cleanup skips this
            # transferred component but still visits the other fields/elements.
            prefix.push(saved.declaration) prefix.push(saved.value)
            store(id hir.Block[candidate.loc hir.node_at(session.hir saved.value).value_type prefix false] @session)
            return
        }
    }
    if candidate is? hir.ExpressedIdentifier and candidate.binding_id isnt? none and id in? plan.consume_sites and frame isnt? none {
        let source:addr?=none
        loop owner in frame.owners {
            let declaration=hir.node_at(session.hir owner)
            if declaration is? hir.Declare and declaration.binding_id =? candidate.binding_id {source=owner break}
        }
        if source isnt? none {
            let selected=put(candidate @session)
            let result=transfer(selected candidate.value_type @plan @session)
            if result not=? selected or candidate.binding_id in? plan.flags {
                let saved=capture_result(result candidate.loc @session)
                let items:array<addr>=[saved.declaration]
                if result not=? selected {loop call in cleanup([source] candidate.loc @plan @session fields_only=source) {items.push(call)}}
                loop call in deactivate(candidate.binding_id candidate.loc plan @session) {items.push(call)}
                items.push(saved.value)
                store(id hir.Block[candidate.loc hir.node_at(session.hir saved.value).value_type items false] @session)
            }
            if candidate.binding_id not in? plan.flags {plan.consumed_bindings.add(candidate.binding_id)}
            return
        }
    }
    if candidate is? hir.Block|hir.Flow and frame isnt? none {
        # Capture a fresh value on each branch before cleaning its locals.
        let active=frame.owners
        if candidate is? hir.Block {store(id hir.Block[candidate.loc candidate.value_type candidate.items true] @session)}
        statement(id @active frame.loops frame.allowed frame.inherited frame.owning_result @plan @session composed_parent=frame.composed_parent fresh_result=true)
        return
    }
    if candidate is? hir.Obligation {fresh(candidate.value allowed inherited @plan @session components=components frame=frame) return}
    if candidate is? hir.ValueCast|hir.RepresentationCast {
        let target=views.structural_base(candidate.value_type session.types)
        let source=views.structural_base(hir.node_at(session.hir candidate.expr).value_type session.types)
        # A recursive alias names the same stored object. Its transparent
        # cast does not turn a fresh constructor into a borrowed value.
        if types.node_at(session.types target) is? types.TypeOr or types.same_type(source target session.types) {
            fresh(candidate.expr allowed inherited @plan @session components=components frame=frame)
            return
        }
    }
    if candidate is? hir.MemberAccess {
        let owner=hir.node_at(session.hir candidate.value)
        loop owner is? hir.MemberAccess {owner=hir.node_at(session.hir owner.value)}
        if owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none and owner.binding_id in? components {return}
    }
    if candidate is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index or (candidate is? hir.DictLookup and candidate.proven) {
        let source=put(candidate @session)
        let receiver=put(hir.Place[candidate.loc candidate.value_type source] @session)
        expression(receiver allowed inherited @plan @session frame=frame)
        let copied=copy_component(source true @plan @session)
        store(id hir.node_at(session.hir copied) @session)
        return
    }
    if candidate is? hir.CopyValue {
        let source=hir.node_at(session.hir candidate.value)
        if source is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index or (source is? hir.DictLookup and source.proven) {
            let receiver=put(hir.Place[candidate.loc source.value_type candidate.value] @session)
            expression(receiver allowed inherited @plan @session frame=frame)
            let copied=copy_component(candidate.value false @plan @session)
            store(id hir.node_at(session.hir copied) @session)
        } else {
            fresh(candidate.value allowed inherited @plan @session frame=frame)
            let owner=capture_result(candidate.value candidate.loc @session)
            let copied=capture_result(copy_component(owner.value false @plan @session) candidate.loc @session)
            let body:array<addr>=[owner.declaration copied.declaration]
            let calls=cleanup([owner.declaration] candidate.loc @plan @session)
            loop call in calls {body.push(call)}
            body.push(copied.value)
            store(id hir.Block[candidate.loc candidate.value_type body false] @session)
        }
        return
    }
    if candidate is? hir.FunctionCall {
        let function=hir.node_at(session.hir candidate.func)
        if function is? hir.ArrayMethod and resource(hir.node_at(session.hir function.array).value_type session.types) isnt? none {
            array_operation(id candidate function allowed inherited @plan @session frame=frame)
            return
        }
        if function is? hir.ExpressedIdentifier and function.binding_id isnt? none {
            let hook=plan.hooks.get(function.binding_id)
            if hook isnt? none and hook.role =? 'copy' {
                if candidate.pos_args.length not=? 1 or candidate.kw_args.length not=? 0 {reject(candidate 'an invalid copy receiver' @plan) return}
                let place=hir.node_at(session.hir candidate.pos_args[0])
                if place isnt? hir.Place {reject(candidate 'an invalid copy receiver' @plan) return}
                let receiver=hir.node_at(session.hir place.target)
                if receiver is? hir.FunctionCall|hir.ObjectLiteral {
                    fresh(place.target allowed inherited @plan @session frame=frame)
                    let owner=capture_result(place.target candidate.loc @session)
                    let copied:hir.FunctionCall=candidate
                    copied.pos_args=[put(hir.Place[place.loc place.value_type owner.value] @session)]
                    let result=capture_result(put(copied @session) candidate.loc @session)
                    let items:array<addr>=[owner.declaration result.declaration]
                    loop call in cleanup([owner.declaration] candidate.loc @plan @session) {items.push(call)}
                    items.push(result.value)
                    store(id hir.Block[candidate.loc candidate.value_type items false] @session)
                    return
                }
                expression(candidate.pos_args[0] allowed inherited @plan @session frame=frame)
                return
            }
        }
        # Results are owned values, including through callbacks. Each checked
        # body owes this contract; arguments need their own ownership proof.
        expression(candidate.func allowed inherited @plan @session frame=frame)
        loop argument in candidate.pos_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        loop [name argument] in candidate.kw_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        return
    }
    let node=hir.node_at(session.hir id)
    let type=types.node_at(session.types views.structural_base(node.value_type session.types))
    if node is? hir.ArrayLiteral and type is? types.ArrayType {
        loop item in node.items {fresh(item allowed inherited @plan @session components=components frame=frame)}
        return
    }
    if node isnt? hir.ObjectLiteral or type isnt? types.ObjectType {reject(node 'a non-fresh resource field or resource container' @plan) return}
    loop method in type.methods {
        if method.lifecycle not=? 'drop' continue
        if type.brand is? none {reject(node 'an unavailable drop operation' @plan) return}
        let hook=plan.owners.get(type.brand)
        if hook is? none or not types.same_type(hook.owner node.value_type session.types) {reject(node 'an adapted drop receiver without a checked composition' @plan) return}
    }
    loop field in node.fields {
        if resource(hir.node_at(session.hir field.value).value_type session.types) isnt? none {fresh(field.value allowed inherited @plan @session components=components frame=frame)}
        else {expression(field.value allowed inherited @plan @session frame=frame)}
    }
}
Captured:type = const [declaration:addr value:addr]
capture_result = (id:addr loc:Span @session:contexts.Session):>Captured => {
    # Evaluate before cleanup; lowering transfers fresh aggregates and
    # snapshots borrowed fields that a subsequent drop might mutate.
    let type=hir.node_at(session.hir id).value_type
    let empty=types.primitive('void' @session.types)
    let name="__dewy_drop_result_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=type
    bindings.store_binding(@session.registry binding_id binding)
    let declaration=put(hir.Declare[loc empty 'let' name type id binding_id] @session)
    let value=put(hir.ExpressedIdentifier[loc type name binding_id] @session)
    return Captured[declaration value]
}
# Iteration reuses ordinary lexical ownership. Keep one source declaration
# alive for the loop, so the usual proof chooses borrow, move or copy. The
# loop target remains a read-only element loan; body value boundaries copy.
iterator_leaves=(id:addr nodes:array<hir.AST>):>array<addr>=>{
    let node=hir.node_at(nodes id)
    if node is? hir.IteratorExpression return [id]
    if node is? hir.MultiIteratorExpression return node.iterators
    return []
}
prepare_iterations=(id:addr @seen:set<addr> @plan:Plan @session:contexts.Session):>void=>{
    if id in? seen return
    seen.add(id)
    let node=hir.node_at(session.hir id)
    if node is? hir.FunctionLiteral and node.proof return
    let children:array<addr>=[]
    hir.push_children(node @children)
    loop child in children {prepare_iterations(child @seen @plan @session)}
    if node isnt? hir.Flow return
    let needed=false
    loop arm_id in node.arms {
        let arm=hir.node_at(session.hir arm_id)
        $runtime_assert arm is? hir.IfArm|hir.LoopArm
        loop iterator_id in iterator_leaves(arm.condition session.hir) {
            let iterator=hir.node_at(session.hir iterator_id)
            $runtime_assert iterator is? hir.IteratorExpression
            let source=hir.node_at(session.hir iterator.iterable)
            let source_id=if source is? hir.DictEntries source.dictionary else iterator.iterable
            if resource(hir.node_at(session.hir source_id).value_type session.types) isnt? none {needed=true}
        }
    }
    if not needed return
    let tail=node.default
    let changed=false
    let arms=node.arms
    loop arms.length >? 0 {
        let arm_id=arms.pop
        let arm=hir.node_at(session.hir arm_id)
        $runtime_assert arm is? hir.IfArm|hir.LoopArm
        let prefix:array<addr>=[]
        let dictionaries:dict<addr addr>=[]
        let iterators=iterator_leaves(arm.condition session.hir)
        let arm_needed=false
        loop iterator_id in iterators {
            let iterator=hir.node_at(session.hir iterator_id)
            $runtime_assert iterator is? hir.IteratorExpression
            let source=hir.node_at(session.hir iterator.iterable)
            let source_id=if source is? hir.DictEntries source.dictionary else iterator.iterable
            if resource(hir.node_at(session.hir source_id).value_type session.types) isnt? none {arm_needed=true}
        }
        loop iterator_id in iterators {
            let iterator=hir.node_at(session.hir iterator_id)
            $runtime_assert iterator is? hir.IteratorExpression
            let source=hir.node_at(session.hir iterator.iterable)
            # Source initialization remains left-to-right across ordinary
            # and resource iterators. Normalized ranges have no setup value.
            if not arm_needed or source is? hir.Range continue
            if source is? hir.DictEntries {
                let held=dictionaries.get(source.dictionary)
                if held is? none {
                    let saved=capture_result(source.dictionary source.loc @session)
                    prefix.push(saved.declaration)
                    held=saved.value
                    dictionaries[source.dictionary]=held
                }
                source.dictionary=held
                store(iterator.iterable source @session)
            } else {
                let saved=capture_result(iterator.iterable source.loc @session)
                prefix.push(saved.declaration)
                iterator.iterable=saved.value
                store(iterator_id iterator @session)
            }
            let target=hir.node_at(session.hir iterator.target)
            $runtime_assert target is? hir.ExpressedIdentifier and target.binding_id isnt? none
            if resource(target.value_type session.types) isnt? none {plan.iteration_loans.add(target.binding_id)}
        }
        let inner=put(hir.Flow[node.loc node.value_type [arm_id] tail] @session)
        if prefix.length >? 0 {
            changed=true
            prefix.push(inner)
            tail=put(hir.Block[node.loc node.value_type prefix true] @session)
        } else {tail=inner}
    }
    if changed {
        $runtime_assert tail isnt? none
        store(id hir.node_at(session.hir tail) @session)
    }
}
# Fresh arguments supply owners; a checked place argument only lends one.
owning_argument = (id:addr allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?=none):>void => {
    let node=hir.node_at(session.hir id)
    if node isnt? hir.Place and resource(node.value_type session.types) isnt? none {fresh(id allowed inherited @plan @session frame=frame)}
    else {expression(id allowed inherited @plan @session frame=frame)}
}
clear_operation = (owner:addr loc:Span @plan:Plan @session:contexts.Session):>addr => {
    let operation=plan.array_clears.get(owner)
    if operation isnt? none return operation
    let name="__dewy_clear_array_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' loc)
    let parameter_id=bindings.allocate(@session.registry none '__items' 'param' loc)
    let parameter=bindings.binding_at(session.registry parameter_id)
    parameter.value_type=owner parameter.store_type=owner
    bindings.store_binding(@session.registry parameter_id parameter)
    let empty=types.primitive('void' @session.types)
    # Preserve the builtin's length fact through an ordinary checked contract.
    let result=types.refined_type(empty [facts.Proposition['@__items' '=?' 0 projection='length' subject_id=parameter_id]] @session.types)
    let signature=types.function_type([types.PosOrKwArg['__items' owner place=true]] [] none result [] @session.types)
    let receiver=put(hir.ExpressedIdentifier[loc owner '__items' parameter_id] @session)
    let borrowed=put(hir.Declare[loc empty 'let' '__items' owner receiver parameter_id] @session)
    let body=cleanup([borrowed] loc @plan @session)
    let method_type=types.function_type([] [] none empty [] @session.types)
    let method=put(hir.ArrayMethod[loc method_type receiver 'clear'] @session)
    body.push(put(hir.FunctionCall[loc empty method [] []] @session))
    # This signature bypassed source checking, so install its return proof
    # obligation explicitly just as checking an ordinary procedure does.
    let returned=put(hir.Void[loc empty] @session)
    body.push(put(hir.Obligation[loc empty returned result 'the generated clear return contract'] @session))
    let block=put(hir.Block[loc empty body true] @session)
    let function=put(hir.FunctionLiteral[loc signature [hir.Param['__items' owner parameter_id place=true]] [] none empty block source=plan.function_source] @session)
    let declaration=put(hir.Declare[loc empty 'const' name signature function binding_id] @session)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=signature binding.function=function binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    operation=put(hir.ExpressedIdentifier[loc signature name binding_id] @session)
    plan.array_clears[owner]=operation
    plan.generated.push(declaration)
    return operation
}
# Hidden selectors are immutable: route facts refer to the selected element,
# and later cleanup/builtin calls do not evaluate a source index again.
freeze_value = (id:addr loc:Span @prefix:array<addr> @session:contexts.Session):>addr => {
    if hir.node_at(session.hir id) is? hir.Integer return id
    let held=capture_result(id loc @session)
    let node=hir.node_at(session.hir held.declaration)
    $runtime_assert node is? hir.Declare and node.binding_id isnt? none
    let declaration=hir.Declare[node.loc node.value_type 'const' node.name node.annotation node.expr node.binding_id]
    store(held.declaration declaration @session)
    let binding=bindings.binding_at(session.registry node.binding_id)
    binding.declaration=held.declaration
    bindings.store_binding(@session.registry node.binding_id binding)
    prefix.push(held.declaration)
    return held.value
}
receiver_root = (id:addr nodes:array<hir.AST>):>addr? => {
    let path=bindings.access_path(id nodes dictionaries=true)
    let node=hir.node_at(nodes path.root)
    return if node is? hir.ExpressedIdentifier node.binding_id else none
}
check_selection = (id:addr root:addr? @plan:Plan session:contexts.Session):>void => {
    if root isnt? none and root in? predicate_effects.mutated_bindings(id session.hir plan.argument_writes plan.readonly_arguments) {
        if plan.problem is? none {plan.problem=Error[srcfile=plan.source title='resource receiver changes during evaluation' pointers=[Pointer[hir.node_at(session.hir id).loc 'the selected storage must survive its selectors and arguments']]]}
    }
}
freeze_route = (id:addr loc:Span root:addr? @prefix:array<addr> @plan:Plan @session:contexts.Session):>addr => {
    let node=hir.node_at(session.hir id)
    if node is? hir.Obligation {
        node.value=freeze_route(node.value loc root @prefix @plan @session)
        return put(node @session)
    }
    if node is? hir.ValueCast {
        node.expr=freeze_route(node.expr loc root @prefix @plan @session)
        return put(node @session)
    }
    if node is? hir.RepresentationCast {
        node.expr=freeze_route(node.expr loc root @prefix @plan @session)
        return put(node @session)
    }
    if node is? hir.MemberAccess {
        let value=freeze_route(node.value loc root @prefix @plan @session)
        return put(hir.MemberAccess[node.loc node.value_type value node.name node.mutable] @session)
    }
    if node is? hir.Index {
        let array=freeze_route(node.array loc root @prefix @plan @session)
        check_selection(node.index root @plan session)
        let index=freeze_value(node.index loc @prefix @session)
        return put(hir.Index[node.loc node.value_type array index node.constant_index] @session)
    }
    if node is? hir.DictLookup and node.proven {
        # Reprobe the captured key: cleanup may compact the dictionary.
        let keys=hir.node_at(session.hir node.keys)
        let values=hir.node_at(session.hir node.values)
        $runtime_assert keys is? hir.MemberAccess and values is? hir.MemberAccess
        let owner=freeze_route(keys.value loc root @prefix @plan @session)
        check_selection(node.key root @plan session)
        let key=freeze_value(node.key loc @prefix @session)
        keys.value=owner values.value=owner
        node.keys=put(keys @session) node.values=put(values @session)
        node.key=key node.position=none node.static_position=none
        return put(node @session)
    }
    return id
}
array_operation = (id:addr node:hir.FunctionCall method:hir.ArrayMethod allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?=none):>void => {
    if method.name not in? ['push' 'insert' 'pop' 'reserve' 'clear' 'truncate'] {reject(node 'a resource array method without element lifetime handling' @plan) return}
    # Insertion introduces owners; pop transfers one; reserve only changes
    # capacity. Other methods need explicit handling for discarded elements.
    let receiver=hir.node_at(session.hir method.array)
    let place=put(hir.Place[receiver.loc receiver.value_type method.array] @session)
    expression(place allowed inherited @plan @session frame=frame)
    if method.name =? 'truncate' {
        let prefix:array<addr>=[]
        let root=receiver_root(method.array session.hir)
        let selected=freeze_route(method.array node.loc root @prefix @plan @session)
        let argument=if node.pos_args.length >? 0 node.pos_args[0] else node.kw_args.get('count')
        $runtime_assert argument isnt? none
        check_selection(argument root @plan session)
        expression(argument allowed inherited @plan @session frame=frame)
        let count=freeze_value(argument node.loc @prefix @session)
        let word=types.primitive('int64' @session.types)
        let length=put(hir.ArrayLength[node.loc word selected] @session)
        let before=freeze_value(length node.loc @prefix @session)
        drop_value(selected receiver.value_type node.loc set[] @prefix @plan @session tail=Suffix[count before])
        let truncated=put(hir.ArrayMethod[method.loc method.value_type selected 'truncate'] @session)
        prefix.push(put(hir.FunctionCall[node.loc node.value_type truncated [count] []] @session))
        store(id hir.Block[node.loc node.value_type prefix false] @session)
        return
    }
    if method.name =? 'clear' {
        let shape=views.structural_base(receiver.value_type session.types)
        let function=clear_operation(shape node.loc @plan @session)
        store(id hir.FunctionCall[node.loc node.value_type function [place] []] @session)
        return
    }
    loop argument in node.pos_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
    loop [name argument] in node.kw_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
}
compact_dictionary=(value:addr shape:types.ObjectType loc:Span @session:contexts.Session):>addr=>{
    # Existing entry materialization compacts tombstones and releases their
    # backing storage. Its suppressed descriptor is a borrow, not a new owner.
    let field=types.object_field(shape 'values')
    $runtime_assert field isnt? none
    let entries=put(hir.DictEntries[loc field.value_type value 'values'] @session)
    return put(hir.Suppress[loc types.primitive('void' @session.types) entries] @session)
}
dictionary_clear = (id:addr node:hir.DictRemove allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?):>void => {
    # Drop the logical elements before DictRemove releases their storage and
    # resets the hash table. Select the shared owner just once.
    let keys=hir.node_at(session.hir node.keys)
    $runtime_assert node.values isnt? none
    let values=hir.node_at(session.hir node.values)
    if keys isnt? hir.MemberAccess or values isnt? hir.MemberAccess {reject(node 'a dictionary clear without rooted storage' @plan) return}
    let owner=hir.node_at(session.hir keys.value)
    let borrowed=put(hir.Place[node.loc owner.value_type keys.value] @session)
    expression(borrowed allowed inherited @plan @session frame=frame)
    let prefix:array<addr>=[]
    let selected=freeze_route(keys.value node.loc receiver_root(keys.value session.hir) @prefix @plan @session)
    keys.value=selected values.value=selected
    let selected_keys=put(keys @session) let selected_values=put(values @session)
    drop_value(selected owner.value_type node.loc set[] @prefix @plan @session)
    node.keys=selected_keys node.values=selected_values
    prefix.push(put(node @session))
    store(id hir.Block[node.loc node.value_type prefix false] @session)
}
dictionary_view=(id:addr node:hir.DictView allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?):>void=>{
    let owner=hir.node_at(session.hir node.dictionary)
    let borrowed=put(hir.Place[node.loc owner.value_type node.dictionary] @session)
    expression(borrowed allowed inherited @plan @session frame=frame)
    let shape=types.node_at(session.types views.structural_base(owner.value_type session.types))
    $runtime_assert shape is? types.ObjectType
    let prefix:array<addr>=[]
    let selected=freeze_route(node.dictionary node.loc receiver_root(node.dictionary session.hir) @prefix @plan @session)
    if resource(node.value_type session.types) is? none {
        node.dictionary=selected
        prefix.push(put(node @session))
    } else {
        # Snapshot live values through logical component copies; dead slots
        # retain only backing storage and must never invoke copy hooks.
        let field=types.object_field(shape node.name)
        $runtime_assert field isnt? none
        let values=put(hir.MemberAccess[node.loc field.value_type selected field.name] @session)
        prefix.push(compact_dictionary(selected shape node.loc @session))
        prefix.push(copy_component(values true @plan @session))
    }
    store(id hir.Block[node.loc node.value_type prefix false] @session)
}
dictionary_pop=(id:addr node:hir.DictRemove allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?):>void=>{
    $runtime_assert node.values isnt? none and node.key isnt? none
    let keys=hir.node_at(session.hir node.keys) let values=hir.node_at(session.hir node.values)
    $runtime_assert keys is? hir.MemberAccess and values is? hir.MemberAccess
    let owner=hir.node_at(session.hir keys.value)
    let borrowed=put(hir.Place[node.loc owner.value_type keys.value] @session)
    expression(borrowed allowed inherited @plan @session frame=frame)
    let prefix:array<addr>=[]
    let root=receiver_root(keys.value session.hir)
    let selected=freeze_route(keys.value node.loc root @prefix @plan @session)
    check_selection(node.key root @plan session)
    expression(node.key allowed inherited @plan @session frame=frame)
    let key=freeze_value(node.key node.loc @prefix @session)
    let default_owner:addr?=none
    let fallback:addr?=none
    if node.default isnt? none {
        check_selection(node.default root @plan session)
        fresh(node.default allowed inherited @plan @session frame=frame)
        let saved=capture_result(node.default node.loc @session)
        prefix.push(saved.declaration) default_owner=saved.declaration fallback=saved.value
    }
    keys.value=selected values.value=selected
    let selected_keys=put(keys @session) let selected_values=put(values @session)
    let shape=types.node_at(session.types views.structural_base(values.value_type session.types))
    $runtime_assert shape is? types.ArrayType
    let removed=put(hir.DictRemove[node.loc shape.element selected_keys selected_values key] @session)
    let saved=capture_result(removed node.loc @session)
    let taken:array<addr>=[saved.declaration]
    if default_owner isnt? none {loop call in cleanup([default_owner] node.loc @plan @session) {taken.push(call)}}
    taken.push(put(hir.ValueCast[node.loc node.value_type saved.value] @session))
    let result=put(hir.Block[node.loc node.value_type taken false] @session)
    if fallback isnt? none {
        let condition=put(hir.DictContains[node.loc types.primitive('bool' @session.types) selected_keys key] @session)
        let arm=put(hir.IfArm[node.loc node.value_type condition result] @session)
        let absent=put(hir.ValueCast[node.loc node.value_type fallback] @session)
        result=put(hir.Flow[node.loc node.value_type [arm] absent] @session)
    }
    prefix.push(result)
    store(id hir.Block[node.loc node.value_type prefix false] @session)
}
dictionary_get=(id:addr node:hir.DictLookup allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?):>void=>{
    # Defaults evaluate eagerly. A found entry copies through its logical
    # hook and drops the unused default; a miss transfers that default.
    let keys=hir.node_at(session.hir node.keys) let values=hir.node_at(session.hir node.values)
    $runtime_assert keys is? hir.MemberAccess and values is? hir.MemberAccess
    let owner=hir.node_at(session.hir keys.value)
    let borrowed=put(hir.Place[node.loc owner.value_type keys.value] @session)
    expression(borrowed allowed inherited @plan @session frame=frame)
    let prefix:array<addr>=[]
    let root=receiver_root(keys.value session.hir)
    let selected=freeze_route(keys.value node.loc root @prefix @plan @session)
    check_selection(node.key root @plan session)
    expression(node.key allowed inherited @plan @session frame=frame)
    let key=freeze_value(node.key node.loc @prefix @session)
    let default_owner:addr?=none
    let fallback=put(hir.NoneValue[node.loc types.primitive('none' @session.types)] @session)
    if node.default isnt? none {
        check_selection(node.default root @plan session)
        fresh(node.default allowed inherited @plan @session frame=frame)
        let saved=capture_result(node.default node.loc @session)
        prefix.push(saved.declaration)
        default_owner=saved.declaration fallback=saved.value
    }
    keys.value=selected values.value=selected
    let selected_keys=put(keys @session) let selected_values=put(values @session)
    let shape=types.node_at(session.types views.structural_base(values.value_type session.types))
    $runtime_assert shape is? types.ArrayType
    let found=put(hir.DictLookup[node.loc shape.element selected_keys selected_values key proven=true] @session)
    let copied=capture_result(copy_component(found true @plan @session) node.loc @session)
    let taken:array<addr>=[copied.declaration]
    if default_owner isnt? none {loop call in cleanup([default_owner] node.loc @plan @session) {taken.push(call)}}
    taken.push(put(hir.ValueCast[node.loc node.value_type copied.value] @session))
    let condition=put(hir.DictContains[node.loc types.primitive('bool' @session.types) selected_keys key] @session)
    let body=put(hir.Block[node.loc node.value_type taken false] @session)
    let arm=put(hir.IfArm[node.loc node.value_type condition body] @session)
    let absent=put(hir.ValueCast[node.loc node.value_type fallback] @session)
    prefix.push(put(hir.Flow[node.loc node.value_type [arm] absent] @session))
    store(id hir.Block[node.loc node.value_type prefix false] @session)
}
dictionary_store=(id:addr node:hir.DictStore allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?):>void=>{
    # Snapshot selectors, key and replacement before dropping the old owner;
    # dictionary lowering retains hashing and physical storage management.
    let keys=hir.node_at(session.hir node.keys)
    $runtime_assert node.values isnt? none and node.value isnt? none
    let values=hir.node_at(session.hir node.values)
    $runtime_assert keys is? hir.MemberAccess and values is? hir.MemberAccess
    let owner=hir.node_at(session.hir keys.value)
    let borrowed=put(hir.Place[node.loc owner.value_type keys.value] @session)
    expression(borrowed allowed inherited @plan @session frame=frame)
    let prefix:array<addr>=[]
    let root=receiver_root(keys.value session.hir)
    let selected=freeze_route(keys.value node.loc root @prefix @plan @session)
    check_selection(node.key root @plan session)
    check_selection(node.value root @plan session)
    expression(node.key allowed inherited @plan @session frame=frame)
    let key=freeze_value(node.key node.loc @prefix @session)
    fresh(node.value allowed inherited @plan @session frame=frame)
    let replacement=freeze_value(node.value node.loc @prefix @session)
    keys.value=selected values.value=selected
    let selected_keys=put(keys @session) let selected_values=put(values @session)
    let shape=types.node_at(session.types views.structural_base(values.value_type session.types))
    $runtime_assert shape is? types.ArrayType
    let previous=put(hir.DictLookup[node.loc shape.element selected_keys selected_values key proven=true] @session)
    let calls:array<addr>=[]
    drop_value(previous shape.element node.loc set[] @calls @plan @session)
    let empty=types.primitive('void' @session.types)
    let condition=put(hir.DictContains[node.loc types.primitive('bool' @session.types) selected_keys key] @session)
    let body=put(hir.Block[node.loc empty calls true] @session)
    let arm=put(hir.IfArm[node.loc empty condition body] @session)
    prefix.push(put(hir.Flow[node.loc empty [arm] none] @session))
    node.keys=selected_keys node.values=selected_values node.key=key node.value=replacement
    prefix.push(put(node @session))
    store(id hir.Block[node.loc node.value_type prefix false] @session)
}
expression = (id:addr allowed:set<addr> inherited:bool @plan:Plan @session:contexts.Session frame:Frame?=none):>void => {
    if plan.problem isnt? none return
    let node=hir.node_at(session.hir id)
    if node is? hir.DictView and resource(hir.node_at(session.hir node.dictionary).value_type session.types) isnt? none {
        dictionary_view(id node allowed inherited @plan @session frame)
        return
    }
    if node is? hir.DictEntries and resource(hir.node_at(session.hir node.dictionary).value_type session.types) isnt? none {
        let source=hir.node_at(session.hir node.dictionary)
        let borrowed=put(hir.Place[node.loc source.value_type node.dictionary] @session)
        expression(borrowed allowed inherited @plan @session frame=frame)
        return
    }
    if node is? hir.IteratorExpression {
        let target=hir.node_at(session.hir node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none and target.binding_id in? plan.iteration_loans {
            let source=hir.node_at(session.hir node.iterable)
            if source is? hir.DictEntries {expression(node.iterable allowed inherited @plan @session frame=frame)}
            else {
                let borrowed=put(hir.Place[node.loc source.value_type node.iterable] @session)
                expression(borrowed allowed inherited @plan @session frame=frame)
            }
            return
        }
    }
    if node is? hir.DictStore and node.values isnt? none and resource(hir.node_at(session.hir node.values).value_type session.types) isnt? none {
        dictionary_store(id node allowed inherited @plan @session frame)
        return
    }
    if node is? hir.DictRemove and node.key is? none and node.values isnt? none and resource(hir.node_at(session.hir node.values).value_type session.types) isnt? none {
        dictionary_clear(id node allowed inherited @plan @session frame)
        return
    }
    if node is? hir.Suppress and resource(hir.node_at(session.hir node.item).value_type session.types) isnt? none {
        fresh(node.item allowed inherited @plan @session frame=frame)
        let owner=capture_result(node.item node.loc @session)
        let items:array<addr>=[owner.declaration]
        loop call in cleanup([owner.declaration] node.loc @plan @session) {items.push(call)}
        store(id hir.Block[node.loc node.value_type items false] @session)
        return
    }
    if node is? hir.FunctionCall {
        let method=hir.node_at(session.hir node.func)
        if method is? hir.ArrayMethod and resource(hir.node_at(session.hir method.array).value_type session.types) isnt? none {
            array_operation(id node method allowed inherited @plan @session frame=frame)
            return
        }
    }
    if frame isnt? none and node is? hir.Block|hir.Flow|hir.Return|hir.Break|hir.Continue {
        let active=frame.owners
        if node is? hir.Block and not node.scoped {node.scoped=true store(id node @session)}
        statement(id @active frame.loops frame.allowed frame.inherited frame.owning_result @plan @session composed_parent=frame.composed_parent)
        return
    }
    if node is? hir.FunctionLiteral {prepare_function(id @plan @session) return}
    if node is? hir.TypeValue or (node is? hir.FunctionCall and node.proof) or (node is? hir.Assert and not node.runtime and not node.expect) return
    if node is? hir.MemberAccess|hir.ForwardingAccess|hir.ArrayLength {
        let selected=if node is? hir.MemberAccess|hir.ForwardingAccess node.value else node.array
        if resource(hir.node_at(session.hir selected).value_type session.types) isnt? none {
        let owner=hir.node_at(session.hir selected)
        loop owner is? hir.MemberAccess|hir.Index|hir.DictLookup {
            if owner is? hir.DictLookup {
                if not owner.proven {reject(owner 'an unproven resource entry borrow' @plan) return}
                expression(owner.key allowed inherited @plan @session frame=frame)
                let keys=hir.node_at(session.hir owner.keys)
                $runtime_assert keys is? hir.MemberAccess
                owner=hir.node_at(session.hir keys.value)
                continue
            }
            if owner is? hir.Index {expression(owner.index allowed inherited @plan @session frame=frame)}
            owner=hir.node_at(session.hir if owner is? hir.MemberAccess owner.value else owner.array)
        }
        if owner isnt? hir.ExpressedIdentifier or owner.binding_id is? none or owner.binding_id not in? allowed or resource(node.value_type session.types) isnt? none {reject(node 'an escaping or projected resource owner' @plan)}
        return
        }
    }
    if node is? hir.TypeTest and resource(hir.node_at(session.hir node.value).value_type session.types) isnt? none {
        let value=hir.node_at(session.hir node.value)
        let borrowed=put(hir.Place[node.loc value.value_type node.value] @session)
        expression(borrowed allowed inherited @plan @session frame=frame)
        return
    }
    if node is? hir.FunctionCall and inherited {
        let function=hir.node_at(session.hir node.func)
        if function is? hir.ExpressedIdentifier and function.binding_id isnt? none and function.binding_id in? plan.hooks {
            if node.pos_args.length not=? 1 {reject(node 'an invalid inherited drop receiver' @plan) return}
            let place=hir.node_at(session.hir node.pos_args[0])
            if place isnt? hir.Place {reject(node 'an invalid inherited drop receiver' @plan) return}
            let value=hir.node_at(session.hir place.target)
            if value isnt? hir.ExpressedIdentifier or value.binding_id is? none or value.binding_id not in? allowed {reject(node 'an escaping inherited drop receiver' @plan)}
            return
        }
    }
    if node is? hir.Place {
        let path=hir.node_at(session.hir node.target)
        loop path is? hir.MemberAccess|hir.Index|hir.DictLookup {
            if path is? hir.DictLookup {
                if not path.proven {reject(path 'an unproven resource entry borrow' @plan) return}
                expression(path.key allowed inherited @plan @session frame=frame)
                let keys=hir.node_at(session.hir path.keys)
                $runtime_assert keys is? hir.MemberAccess
                path=hir.node_at(session.hir keys.value)
                continue
            }
            if path is? hir.Index {expression(path.index allowed inherited @plan @session frame=frame)}
            path=hir.node_at(session.hir if path is? hir.MemberAccess path.value else path.array)
        }
        if resource(path.value_type session.types) isnt? none {
            # Ordinary checked places lend storage, not resource ownership.
            if path isnt? hir.ExpressedIdentifier or path.binding_id is? none or path.binding_id not in? allowed {reject(node 'an unavailable resource borrow' @plan)}
            return
        }
    }
    if node is? hir.FunctionCall and resource(node.value_type session.types) is? none {
        expression(node.func allowed inherited @plan @session frame=frame)
        loop argument in node.pos_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        loop [name argument] in node.kw_args {owning_argument(argument allowed inherited @plan @session frame=frame)}
        return
    }
    if resource(node.value_type session.types) isnt? none {reject(node 'a resource copy, move, temporary, or escape' @plan) return}
    loop child in hir.children(node) {expression(child allowed inherited @plan @session frame=frame)}
}
scoped_body = (id:addr @session:contexts.Session):>addr => {
    let node=hir.node_at(session.hir id)
    if node is? hir.Block {
        if not node.scoped {node.scoped=true store(id node @session)}
        return id
    }
    return put(hir.Block[node.loc node.value_type [id] true] @session)
}
deactivate=(binding:addr loc:Span plan:Plan @session:contexts.Session):>array<addr>=>{
    let flag=plan.flags.get(binding)
    if flag is? none return []
    let boolean=types.primitive('bool' @session.types)
    let empty=types.primitive('void' @session.types)
    let value=put(hir.Bool[loc boolean false] @session)
    return [put(hir.Assign[loc empty flag.value '=' value] @session)]
}
statement = (id:addr @owners:array<addr> loops:array<addr> allowed:set<addr> inherited:bool owning_result:bool @plan:Plan @session:contexts.Session composed_parent:addr?=none entry:bool=false fresh_result:bool=false):>void => {
    if plan.problem isnt? none return
    let node=hir.node_at(session.hir id)
    let frame=Frame[owners loops allowed inherited owning_result composed_parent]
    let live=allowed
    loop binding in plan.view_bindings {live.add(binding)}
    loop owner in owners {
        let declaration=hir.node_at(session.hir owner)
        $runtime_assert declaration is? hir.Declare and declaration.binding_id isnt? none
        live.add(declaration.binding_id)
    }
    if node is? hir.Block {
        let current:hir.Block=node
        let active=owners
        let start=if entry 0 else active.length
        let items:array<addr>=[]
        loop item in current.items {
            let original=hir.node_at(session.hir item)
            statement(item @active loops allowed inherited owning_result @plan @session composed_parent=composed_parent fresh_result=fresh_result and resource(original.value_type session.types) isnt? none)
            items.push(item)
            if original is? hir.Declare and original.binding_id isnt? none {
                let flag=plan.flags.get(original.binding_id)
                if flag isnt? none {items.push(flag.declaration)}
            }
        }
        current.items=items
        if plan.problem isnt? none return
        if current.scoped and active.length >? start {
            let result:addr?=none
            if not types.is_primitive(types.node_at(session.types current.value_type) 'void') and not types.is_primitive(types.node_at(session.types current.value_type) 'never') {
                let expressed:array<addr>=[]
                loop index in 0.. and index <? current.items.length {
                    let item=hir.node_at(session.hir current.items[index])
                    if not types.is_primitive(types.node_at(session.types item.value_type) 'void') {expressed.push(index)}
                }
                if expressed.length not=? 1 {reject(current 'an implicit result without a unique value' @plan) return}
                let index=expressed[0]
                $runtime_assert index <? current.items.length
                let saved=capture_result(current.items[index] current.loc @session)
                current.items[index]=saved.declaration
                result=saved.value
            }
            let locals:array<addr>=[]
            let index:addr=start
            loop index <? active.length {locals.push(active[index]) index+=1}
            loop call in cleanup(locals current.loc @plan @session) {current.items.push(call)}
            if result isnt? none {current.items.push(result)}
            store(id current @session)
        }
        store(id current @session)
        if not current.scoped {owners=active}
        return
    }
    if node is? hir.Declare and resource((if node.annotation is? none hir.node_at(session.hir node.expr).value_type else node.annotation) session.types) isnt? none {
        let declared:hir.Declare=node
        let value=hir.node_at(session.hir declared.expr)
        let same_array=false
        let same_union=false
        let same_storage=declared.annotation is? none
        if declared.annotation isnt? none {
            # Source obligations retain their facts; ownership only needs the
            # storage representation beneath the checked top-level refinement.
            same_storage=types.same_type(views.structural_base(declared.annotation session.types) views.structural_base(value.value_type session.types) session.types)
            let expected=types.node_at(session.types views.structural_base(declared.annotation session.types))
            let actual=types.node_at(session.types views.structural_base(value.value_type session.types))
            same_array=expected is? types.ArrayType and actual is? types.ArrayType and types.same_type(expected.element actual.element session.types)
            if expected is? types.TypeOr {
                same_union=resource(value.value_type session.types) is? none
                loop member in expected.items {
                    if types.same_type(views.structural_base(member session.types) views.structural_base(value.value_type session.types) session.types) {same_union=true}
                }
            }
        }
        if declared.binding_id is? none or (not same_storage and not same_array and not same_union) {reject(declared 'a non-fresh local owner' @plan) return}
        if id in? plan.transfer_sites and not declared.view and value is? hir.ExpressedIdentifier {
            let retained:array<addr>=[]
            let source:addr?=none
            loop owner in owners {
                let declaration=hir.node_at(session.hir owner)
                $runtime_assert declaration is? hir.Declare
                if declaration.binding_id =? value.binding_id {
                    source=owner
                    if value.binding_id isnt? none and value.binding_id in? plan.flags {retained.push(owner)}
                } else {retained.push(owner)}
            }
            if source isnt? none {
                let result=transfer(declared.expr value.value_type @plan @session)
                let moved=result not=? declared.expr
                declared.expr=result
                let calls:array<addr>=[]
                if moved {calls=cleanup([source] declared.loc @plan @session fields_only=source)}
                if value.binding_id isnt? none {loop call in deactivate(value.binding_id declared.loc plan @session) {calls.push(call)}}
                if calls.length >? 0 {
                    let declaration_id=put(declared @session)
                    retained.push(declaration_id)
                    let items:array<addr>=[declaration_id]
                    loop call in calls {items.push(call)}
                    store(id hir.Block[declared.loc declared.value_type items false] @session)
                } else {store(id declared @session) retained.push(id)}
                owners=retained
                return
            }
        }
        if id in? plan.view_sites and value is? hir.ExpressedIdentifier and value.binding_id isnt? none and value.binding_id in? live {
            plan.view_bindings.add(declared.binding_id)
            declared.view=true
            store(id declared @session)
            return
        }
        if declared.view {reject(declared 'a resource view without a stable lifetime' @plan) return}
        fresh(declared.expr live inherited @plan @session frame=frame)
        owners.push(id)
        return
    }
    let assigned=if node is? hir.Assign hir.node_at(session.hir node.target) else node
    if node is? hir.Assign and (resource(assigned.value_type session.types) isnt? none or (assigned is? hir.ExpressedIdentifier and assigned.binding_id isnt? none and assigned.binding_id in? live)) {
        let target=assigned
        let source:addr?=none
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            loop owner in owners {
                let declaration=hir.node_at(session.hir owner)
                $runtime_assert declaration is? hir.Declare
                if declaration.binding_id =? target.binding_id {source=owner break}
            }
        }
        if source is? none or node.op not=? '=' {reject(node 'replacement without a local owning binding' @plan) return}
        # Capture first: the old drop may mutate fields used by the new value.
        fresh(node.value live false @plan @session frame=frame)
        let replacement=capture_result(node.value node.loc @session)
        let items:array<addr>=[replacement.declaration]
        loop call in cleanup([source] node.loc @plan @session) {items.push(call)}
        items.push(put(hir.Assign[node.loc node.value_type node.target node.op replacement.value] @session))
        $runtime_assert target is? hir.ExpressedIdentifier and target.binding_id isnt? none
        plan.extractions[target.binding_id]=[]
        let flag=plan.flags.get(target.binding_id)
        if flag isnt? none {
            let present=put(hir.Bool[node.loc types.primitive('bool' @session.types) true] @session)
            items.push(put(hir.Assign[node.loc types.primitive('void' @session.types) flag.value '=' present] @session))
        }
        store(id hir.Block[node.loc node.value_type items false] @session)
        return
    }
    if node is? hir.Return {
        let current:hir.Return=node
        let consumed:addr?=none
        let extracted:Extraction?=none
        let prefix:array<addr>=[]
        let moved=false
        if current.item isnt? none {
            if owning_result and resource(hir.node_at(session.hir current.item).value_type session.types) isnt? none {
                # An explicit return ends this path. Only a local owner,
                # never a borrowed parameter, can transfer to the caller.
                let returned_id:addr=current.item
                let returned=hir.node_at(session.hir returned_id)
                if composed_parent isnt? none {
                    $runtime_assert returned is? hir.ObjectLiteral
                    let components:set<addr>=set[composed_parent]
                    let receiver=plan.composed_moves.get(id)
                    if receiver isnt? none {components.add(receiver)}
                    fresh(returned_id live false @plan @session components=components frame=frame)
                    loop owner in owners {
                        let declaration=hir.node_at(session.hir owner)
                        $runtime_assert declaration is? hir.Declare
                        if declaration.binding_id =? composed_parent {consumed=owner break}
                    }
                    $runtime_assert consumed isnt? none
                } else if returned is? hir.ExpressedIdentifier and returned.binding_id isnt? none {
                    loop owner in owners {
                        let declaration=hir.node_at(session.hir owner)
                        $runtime_assert declaration is? hir.Declare
                        if declaration.binding_id =? returned.binding_id {
                            consumed=owner
                            let result=transfer(returned_id plan.result_type @plan @session)
                            moved=result not=? returned_id
                            current.item=result
                            break
                        }
                    }
                }
                if consumed is? none {
                    let projection=returning_projection(returned_id owners session)
                    if projection isnt? none {
                        let selected=freeze_route(returned_id current.loc projection.binding @prefix @plan @session)
                        let frozen=returning_projection(selected owners session)
                        $runtime_assert frozen isnt? none
                        let result=transfer(selected plan.result_type @plan @session)
                        extracted=Extraction[frozen.binding frozen.path result not=?selected]
                        current.item=result
                    } else {fresh(returned_id live false @plan @session frame=frame)}
                }
            }
            else {expression(current.item live inherited @plan @session frame=frame)}
        }
        if plan.problem isnt? none or owners.length =? 0 return
        let items=prefix
        if current.item isnt? none and hir.node_at(session.hir current.item) isnt? hir.NoneValue {
            let returned:addr=current.item
            let value=hir.node_at(session.hir returned)
            let saved=capture_result(returned current.loc @session)
            items.push(saved.declaration)
            current.item=saved.value
        }
        let released:array<addr>=[]
        loop owner in owners {if moved or consumed is? none or owner not=? consumed {released.push(owner)}}
        loop call in cleanup(released current.loc @plan @session fields_only=if moved consumed else none extracted=extracted) {items.push(call)}
        items.push(put(current @session))
        store(id hir.Block[current.loc current.value_type items false] @session)
        return
    }
    if node is? hir.Break|hir.Continue {
        let current:hir.Break|hir.Continue=node
        if current.loop_levels >=? loops.length {reject(current 'an unresolved loop cleanup boundary' @plan) return}
        let selected=loops.length-1-current.loop_levels
        $runtime_assert selected >=? 0 and selected <? loops.length
        let boundary=loops[selected]
        let released:array<addr>=[]
        let index:addr=boundary
        loop index <? owners.length {released.push(owners[index]) index+=1}
        if released.length >? 0 {
            let items=cleanup(released current.loc @plan @session)
            items.push(put(current @session))
            store(id hir.Block[current.loc current.value_type items false] @session)
        }
        return
    }
    if node is? hir.Flow {
        let current:hir.Flow=node
        loop arm_id in current.arms {
            let arm=hir.node_at(session.hir arm_id)
            $runtime_assert arm is? hir.IfArm|hir.LoopArm
            let branch:hir.IfArm|hir.LoopArm=arm
            let branch_allowed=allowed
            let branch_live=live
            loop iterator_id in iterator_leaves(branch.condition session.hir) {
                let iterator=hir.node_at(session.hir iterator_id)
                $runtime_assert iterator is? hir.IteratorExpression
                let target=hir.node_at(session.hir iterator.target)
                if target is? hir.ExpressedIdentifier and target.binding_id isnt? none and target.binding_id in? plan.iteration_loans {
                    branch_allowed.add(target.binding_id) branch_live.add(target.binding_id)
                }
            }
            expression(branch.condition branch_live inherited @plan @session frame=frame)
            let boundaries=loops
            if branch is? hir.LoopArm {boundaries.push(owners.length)}
            let body=scoped_body(branch.body @session)
            let active=owners
            statement(body @active boundaries branch_allowed inherited owning_result @plan @session composed_parent=composed_parent fresh_result=fresh_result)
            let rewritten=if branch is? hir.IfArm hir.IfArm[branch.loc branch.value_type branch.condition body] else hir.LoopArm[branch.loc branch.value_type branch.condition body]
            store(arm_id rewritten @session)
        }
        if current.default isnt? none {
            let body=scoped_body(current.default @session)
            let active=owners
            statement(body @active loops allowed inherited owning_result @plan @session composed_parent=composed_parent fresh_result=fresh_result)
            current.default=body
        }
        store(id current @session)
        return
    }
    if node is? hir.MemberAssign|hir.IndexAssign and resource(hir.node_at(session.hir node.target).value_type session.types) isnt? none {
        # Select once, construct the new owner, then end the old lifetime.
        # Keep a rooted route so mutable-place lowering handles COW before
        # dropping; a saved raw pointer could refer to the previous storage.
        let target=hir.node_at(session.hir node.target)
        let place=put(hir.Place[target.loc target.value_type node.target] @session)
        expression(place live inherited @plan @session frame=frame)
        let prefix:array<addr>=[]
        let root=receiver_root(node.target session.hir)
        let selected=freeze_route(node.target node.loc root @prefix @plan @session)
        check_selection(node.value root @plan session)
        fresh(node.value live false @plan @session frame=frame)
        let replacement=capture_result(node.value node.loc @session)
        prefix.push(replacement.declaration)
        # Preserve still-owned descendants, then retire the old route's
        # extraction metadata. Indexed replacements remain conservative.
        let part=hir.node_at(session.hir selected)
        let reverse_path:array<string>=[]
        loop part is? hir.MemberAccess {reverse_path.push(part.name) part=hir.node_at(session.hir part.value)}
        let removed:array<Extraction>=[]
        if part is? hir.ExpressedIdentifier and part.binding_id isnt? none {
            let path:array<string>=[]
            loop reverse_path.length>?0 {path.push(reverse_path.pop)}
            let retained:array<Extraction>=[]
            loop route in plan.extractions.get(part.binding_id []) {
                let inside=path.length<=?route.path.length
                let i:addr=0
                loop inside and i<?path.length and i<?route.path.length {
                    if route.path[i] isnt? string or route.path[i] not=?path[i] {inside=false}
                    i+=1
                }
                if inside {
                    let rest:array<string|addr>=[]
                    i=path.length
                    loop i<?route.path.length {rest.push(route.path[i]) i+=1}
                    removed.push(Extraction[route.binding rest route.moved])
                } else {retained.push(route)}
            }
            plan.extractions[part.binding_id]=retained
        }
        let first:Extraction?=none
        if removed.length>?0 {first=removed.pop}
        drop_value(selected target.value_type node.loc set[] @prefix @plan @session extraction=first additional=removed)
        let stored=if node is? hir.MemberAssign hir.MemberAssign[node.loc node.value_type selected replacement.value] else hir.IndexAssign[node.loc node.value_type selected replacement.value]
        prefix.push(put(stored @session))
        store(id hir.Block[node.loc node.value_type prefix false] @session)
        return
    }
    if (owning_result or fresh_result) and resource(node.value_type session.types) isnt? none {fresh(id live false @plan @session frame=frame)}
    else {expression(id live inherited @plan @session frame=frame)}
}
mentions_resource = (root:addr session:contexts.Session):>bool => {
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen {continue}
        seen.add(id)
        let node=hir.node_at(session.hir id)
        if resource(node.value_type session.types) isnt? none return true
        if node is? hir.FunctionLiteral {
            if resource(node.rettype session.types) isnt? none return true
            loop parameter in node.pos_or_kw_args {if resource(parameter.value_type session.types) isnt? none return true}
            loop parameter in node.kw_only_args {if resource(parameter.value_type session.types) isnt? none return true}
            if node.rest_args isnt? none and resource(node.rest_args.value_type session.types) isnt? none return true
        }
        hir.push_children(node @pending)
    }
    return false
}
# Ownership inputs share one last-use proof, independent of call/record/array
# spelling. A surviving read-only alias extends the source owner's lifetime.
owning_inputs=(node:hir.AST):>array<addr>=>{
    if node is? hir.Declare and not node.view return [node.expr]
    if node is? hir.FunctionCall {
        let items=node.pos_args
        loop [name value] in node.kw_args {items.push(value)}
        return items
    }
    if node is? hir.ObjectLiteral {
        let items:array<addr>=[]
        loop field in node.fields {items.push(field.value)}
        return items
    }
    if node is? hir.ArrayLiteral return node.items
    if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign return [node.value]
    if node is? hir.DictStore and node.value isnt? none return [node.value]
    return []
}
alias_alive=(binding:addr read:addr dependent:dict<addr set<addr>> born:dict<addr addr> last:dict<addr addr> positions:dict<addr addr>):>bool=>{
    let pending:array<addr>=[]
    loop alias in dependent.get(binding set[]) {pending.push(alias)}
    let seen:set<addr>=set[]
    let position=positions.get(read 0)
    loop pending.length >? 0 {
        let alias=pending.pop
        if alias in? seen or born.get(alias 0) >=? position continue
        seen.add(alias)
        let final=last.get(alias)
        if final isnt? none and positions.get(final 0) >? position return true
        loop child in dependent.get(alias set[]) {pending.push(child)}
    }
    return false
}
# Before cleanup adds artificial reads, identify last uses transferring
# between declarations in one lexical block. Outer-owner conditional moves
# need lifetime joins and are deliberately excluded by the same-block rule.
# A maximal member/constant-index route observes only that component.
# Dynamic indexing and calls/whole values still observe the containing root.
# Numeric steps here are literal indices, not HIR ids as in Extraction.
ReadRoute:type=const [id:addr path:array<string|int64>]
ReadRoutes:type=[paths:dict<addr array<string|int64>>=[] by_binding:dict<addr array<addr>>=[]]
route_overlaps=(left:array<string|int64> right:array<string|int64>):>bool=>{
    let i:addr=0
    loop i<?left.length and i<?right.length {
        if left[i] not=?right[i] return false
        i+=1
    }
    return true
}
literal_index=(id:addr nodes:array<hir.AST>):>int64?=>{
    let node=hir.node_at(nodes id)
    if node is? hir.Integer and node.value>=?-9223372036854775808 and node.value<=?9223372036854775807 return node.value as int64
    return none
}
read_routes=(body:addr nodes:array<hir.AST>):>ReadRoutes=>{
    let result=ReadRoutes[]
    let pending:array<ReadRoute>=[ReadRoute[body []]]
    loop pending.length>?0 {
        let selected=pending.pop
        let node=hir.node_at(nodes selected.id)
        if node is? hir.FunctionLiteral continue
        if node is? hir.MemberAccess {
            let path:array<string|int64>=[node.name]
            loop name in selected.path {path.push(name)}
            pending.push(ReadRoute[node.value path])
        } else if node is? hir.Index and literal_index(node.index nodes) isnt? none {
            let index=literal_index(node.index nodes)
            $runtime_assert index isnt? none
            let path:array<string|int64>=[index]
            loop step in selected.path {path.push(step)}
            pending.push(ReadRoute[node.array path])
        } else {
            if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
                if selected.id not in? result.paths {
                    if node.binding_id in? result.by_binding {
                        let reads=@result.by_binding[node.binding_id]
                        reads.push(selected.id)
                    } else {result.by_binding[node.binding_id]=[selected.id]}
                    result.paths[selected.id]=selected.path
                } else if result.paths[selected.id].length not=?selected.path.length or not route_overlaps(result.paths[selected.id] selected.path) {result.paths[selected.id]=[]}
            }
            loop child in hir.children(node) {pending.push(ReadRoute[child []])}
        }
    }
    return result
}
# Only direct same-block assignments can renew a component. All reads in
# their RHS precede the new lifetime, regardless of HIR child traversal order.
Renewal:type=const [target:addr path:array<string|int64> stop:addr]
block_renewals=(block:hir.Block positions:dict<addr addr> occurrences:dict<addr int> nodes:array<hir.AST>):>dict<addr array<Renewal>>=>{
    let result:dict<addr array<Renewal>>=[]
    loop item in block.items {
        let node=hir.node_at(nodes item)
        if node isnt? hir.Assign|hir.MemberAssign continue
        if node is? hir.Assign and node.op not=?'=' continue
        let target_id=node.target
        let target=hir.node_at(nodes target_id)
        let reverse_path:array<string|int64>=[]
        loop target is? hir.MemberAccess {
            reverse_path.push(target.name) target_id=target.value
            target=hir.node_at(nodes target_id)
        }
        if target isnt? hir.ExpressedIdentifier or target.binding_id is? none or occurrences.get(target_id 0) not=?1 continue
        let path:array<string|int64>=[]
        loop reverse_path.length>?0 {path.push(reverse_path.pop)}
        let stop:addr=0
        let pending:array<addr>=[item]
        loop pending.length>?0 {
            let id=pending.pop let read=hir.node_at(nodes id)
            if read is? hir.ExpressedIdentifier and positions.get(id 0)>?stop {stop=positions.get(id 0)}
            hir.push_children(read @pending)
        }
        let renewal=Renewal[target_id path stop]
        if target.binding_id in? result {
            let renewals=@result[target.binding_id]
            renewals.push(renewal)
        } else {result[target.binding_id]=[renewal]}
    }
    return result
}
last_component=(value:addr root:addr renewals:dict<addr array<Renewal>> last:dict<addr addr> positions:dict<addr addr> routes:ReadRoutes nodes:array<hir.AST>):>bool=>{
    let owner=hir.node_at(nodes root)
    $runtime_assert owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none
    let part=hir.node_at(nodes value)
    if part is? hir.ExpressedIdentifier return last.get(owner.binding_id)=?root
    loop part is? hir.MemberAccess|hir.Index {
        if part is? hir.Index {
            if literal_index(part.index nodes) is? none break
            part=hir.node_at(nodes part.array)
        } else {part=hir.node_at(nodes part.value)}
    }
    if part isnt? hir.ExpressedIdentifier return last.get(owner.binding_id)=?root
    $runtime_assert root in? routes.paths
    const path=@routes.paths[root]
    let renewal:Renewal?=none
    if owner.binding_id in? renewals {
        loop candidate in renewals[owner.binding_id] {
            if positions.get(candidate.target 0)>?positions.get(root 0) and candidate.path.length<=?path.length and route_overlaps(candidate.path path) {renewal=candidate break}
        }
    }
    if owner.binding_id in? routes.by_binding {
        loop read in routes.by_binding[owner.binding_id] {
            if renewal isnt? none and (read=?renewal.target or positions.get(read 0)>?renewal.stop) {continue}
            $runtime_assert read in? routes.paths
            if positions.get(read 0)>?positions.get(root 0) and route_overlaps(path routes.paths[read]) return false
        }
    }
    return true
}
local_transfers = (body:addr parameters:array<addr> borrowed:set<addr> @plan:Plan session:contexts.Session):>void => {
    let last:dict<addr addr>=[]
    let occurrences:dict<addr int>=[]
    let positions:dict<addr addr>=[]
    let captured:set<addr>=set[]
    let written:set<addr>=set[]
    let blocks:array<addr>=[]
    let lexical=borrowed
    loop loan in plan.iteration_loans {lexical.add(loan)}
    let pending:array<addr>=[body]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(session.hir id)
        if node is? hir.FunctionLiteral {
            let nested:array<addr>=[id]
            loop nested.length >? 0 {
                let child=hir.node_at(session.hir nested.pop)
                if child is? hir.ExpressedIdentifier and child.binding_id isnt? none {captured.add(child.binding_id)}
                hir.push_children(child @nested)
            }
            continue
        }
        let target:addr?=none
        if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign|hir.Place {target=node.target}
        else if node is? hir.DictStore|hir.DictRemove {target=node.keys}
        else if node is? hir.ArrayMethod {target=node.array}
        else if node is? hir.Transmute {target=node.expr}
        if target isnt? none {
            let root=hir.node_at(session.hir target)
            loop root is? hir.MemberAccess|hir.Index {root=hir.node_at(session.hir if root is? hir.MemberAccess root.value else root.array)}
            if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {written.add(root.binding_id)}
        }
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            last[node.binding_id]=id
            if id not in? positions {positions[id]=positions.length}
            occurrences[id]=occurrences.get(id 0)+1
        }
        if node is? hir.Block {blocks.push(id)}
        if node is? hir.Declare and node.binding_id isnt? none {lexical.add(node.binding_id)}
        let children:array<addr>=[]
        hir.push_children(node @children)
        # Stack order must preserve the order of statements in each block.
        loop children.length >? 0 {pending.push(children.pop)}
    }
    let routes=read_routes(body session.hir)
    let dependent:dict<addr set<addr>>=[]
    let born:dict<addr addr>=[]
    loop id in blocks {
        let block=hir.node_at(session.hir id)
        $runtime_assert block is? hir.Block
        loop item in block.items {
            let node=hir.node_at(session.hir item)
            if node isnt? hir.Declare or node.binding_id is? none continue
            let source=hir.node_at(session.hir node.expr)
            if source is? hir.ExpressedIdentifier and source.binding_id isnt? none and resource(source.value_type session.types) isnt? none and node.binding_id not in? captured and source.binding_id not in? captured and node.binding_id not in? written and source.binding_id not in? written {
                let aliases=dependent.get(source.binding_id set[])
                aliases.add(node.binding_id) dependent[source.binding_id]=aliases
                born[node.binding_id]=positions.get(node.expr 0)
            }
        }
    }
    loop id in blocks {
        let block=hir.node_at(session.hir id)
        $runtime_assert block is? hir.Block
        let renewals=block_renewals(block positions occurrences session.hir)
        let locals:set<addr>=set[]
        if id =? body {
            loop parameter in parameters {
                let owner=hir.node_at(session.hir parameter)
                $runtime_assert owner is? hir.Declare and owner.binding_id isnt? none
                locals.add(owner.binding_id)
            }
        }
        loop item in block.items {
            let references:dict<addr addr>=[]
            let reads:array<addr>=[item]
            loop reads.length >? 0 {
                let read=hir.node_at(session.hir reads.pop)
                if read is? hir.ExpressedIdentifier and read.binding_id isnt? none {references[read.binding_id]=references.get(read.binding_id 0)+1}
                hir.push_children(read @reads)
            }
            let candidates:array<addr>=[item]
            loop candidates.length >? 0 {
                let part_id=candidates.pop
                let part=hir.node_at(session.hir part_id)
                if part is? hir.Flow {
                    if part.arms.length >? 0 {
                        let first=hir.node_at(session.hir part.arms[0])
                        if first is? hir.IfArm {candidates.push(first.condition)}
                    }
                    continue
                }
                if part is? hir.Block|hir.FunctionLiteral|hir.ShortCircuit {continue}
                let inputs=owning_inputs(part)
                # A branch-local expressed value uses the same last-use proof
                # as an owning argument, including all trailing statements.
                if part_id =? item and resource(block.value_type session.types) isnt? none and resource(part.value_type session.types) isnt? none {inputs.push(part_id)}
                loop argument in inputs {
                    let selected=argument
                    let value=hir.node_at(session.hir selected)
                    loop true {
                        if value is? hir.ValueCast|hir.RepresentationCast {selected=value.expr}
                        else if value is? hir.Obligation {selected=value.value}
                        else break
                        value=hir.node_at(session.hir selected)
                    }
                    let root=selected
                    let owner=value
                    loop owner is? hir.MemberAccess|hir.Index {
                        root=if owner is? hir.MemberAccess owner.value else owner.array
                        owner=hir.node_at(session.hir root)
                    }
                    if owner is? hir.ExpressedIdentifier and owner.binding_id isnt? none and resource(value.value_type session.types) isnt? none and owner.binding_id in? locals and owner.binding_id not in? captured and last_component(selected root renewals last positions routes session.hir) and occurrences.get(root 0) =? 1 and references.get(owner.binding_id 0) =? 1 and not alias_alive(owner.binding_id root dependent born last positions) {plan.consume_sites.add(selected)}
                }
                hir.push_children(part @candidates)
            }
            let declaration=hir.node_at(session.hir item)
            if declaration isnt? hir.Declare continue
            let source=hir.node_at(session.hir declaration.expr)
            if source is? hir.ExpressedIdentifier and source.binding_id isnt? none and source.binding_id in? locals and source.binding_id not in? captured {
                if last.get(source.binding_id) =? declaration.expr and occurrences.get(declaration.expr 0) =? 1 and not alias_alive(source.binding_id declaration.expr dependent born last positions) {plan.transfer_sites.add(item)}
            }
            if declaration.binding_id isnt? none and source is? hir.ExpressedIdentifier and source.binding_id isnt? none and source.binding_id in? lexical and source.binding_id not in? captured and declaration.binding_id not in? captured and source.binding_id not in? written and declaration.binding_id not in? written {plan.view_sites.add(item)}
            if declaration.binding_id isnt? none and resource(source.value_type session.types) isnt? none {locals.add(declaration.binding_id)}
        }
    }
}
# Make the result's ownership explicit while retaining its evaluation point.
# A value before trailing statements needs a saved owner, not an early return.
returnable_result = (id:addr session:contexts.Session):>bool => {
    let node=hir.node_at(session.hir id)
    if types.is_primitive(types.node_at(session.types node.value_type) 'never') return true
    if resource(node.value_type session.types) is? none return false
    if node is? hir.Block {
        let values:array<addr>=[]
        loop item in node.items {
            if not types.is_primitive(types.node_at(session.types hir.node_at(session.hir item).value_type) 'void') {values.push(item)}
        }
        if values.length not=? 1 return false
        return returnable_result(values[0] session)
    }
    if node is? hir.Flow {
        if node.default is? none or not returnable_result(node.default session) return false
        loop arm_id in node.arms {
            let arm=hir.node_at(session.hir arm_id)
            if arm isnt? hir.IfArm or not returnable_result(arm.body session) return false
        }
    }
    return true
}
return_result = (id:addr @session:contexts.Session):>addr => {
    let node=hir.node_at(session.hir id)
    if types.is_primitive(types.node_at(session.types node.value_type) 'never') return id
    let bottom=types.primitive('never' @session.types)
    if node is? hir.Block {
        let block:hir.Block=node
        $runtime_assert block.items.length >? 0
        let selected:addr?=none
        loop index in 0.. and index <? block.items.length {
            if not types.is_primitive(types.node_at(session.types hir.node_at(session.hir block.items[index]).value_type) 'void') {selected=index break}
        }
        $runtime_assert selected isnt? none and selected <? block.items.length
        let index:addr=selected
        if index =? block.items.length-1 {block.items[index]=return_result(block.items[index] @session)}
        else {
            let saved=capture_result(block.items[index] block.loc @session)
            block.items[index]=saved.declaration
            block.items.push(put(hir.Return[block.loc bottom saved.value] @session))
        }
        block.value_type=bottom
        store(id block @session)
        return id
    }
    if node is? hir.Flow {
        let flow:hir.Flow=node
        loop arm_id in flow.arms {
            let arm=hir.node_at(session.hir arm_id)
            $runtime_assert arm is? hir.IfArm
            let branch:hir.IfArm=arm
            branch.body=return_result(branch.body @session)
            branch.value_type=bottom
            store(arm_id branch @session)
        }
        $runtime_assert flow.default isnt? none
        flow.default=return_result(flow.default @session)
        flow.value_type=bottom
        store(id flow @session)
        return id
    }
    return put(hir.Return[node.loc bottom id] @session)
}
prepare_function = (id:addr @plan:Plan @session:contexts.Session):>void => {
    if id in? plan.prepared or plan.problem isnt? none return
    plan.prepared.add(id)
    let node=hir.node_at(session.hir id)
    $runtime_assert node is? hir.FunctionLiteral
    let function:hir.FunctionLiteral=node
    if function.proof return
    let previous=plan.source
    let previous_function_source=plan.function_source
    plan.function_source=function.source
    let previous_result=plan.result_type
    plan.result_type=function.rettype
    if function.source isnt? none {
        $runtime_assert function.source <? session.sources.length
        plan.source=session.sources[function.source].srcfile
    }
    let params=function.pos_or_kw_args
    loop parameter in function.kw_only_args {params.push(parameter)}
    if function.rest_args isnt? none {params.push(function.rest_args)}
    let allowed:set<addr>=set[]
    let parameter_owners:array<addr>=[]
    loop index in 0.. and index <? params.length {
        let parameter=params[index]
        if resource(parameter.value_type session.types) isnt? none {
            if parameter.binding_id is? none {reject(function 'unresolved owning parameter' @plan) return}
            if not parameter.place {
                let value=put(hir.ExpressedIdentifier[function.loc parameter.value_type parameter.name parameter.binding_id] @session)
                let empty=types.primitive('void' @session.types)
                parameter_owners.push(put(hir.Declare[function.loc empty 'let' parameter.name parameter.value_type value parameter.binding_id] @session))
            }
            allowed.add(parameter.binding_id)
        }
        if parameter is? hir.BoundParam {owning_argument(parameter.value allowed false @plan @session)}
    }
    # Leave ordinary helpers (especially the cached prelude) untouched.
    # Cleanup added inside another function is visible through its call edge.
    if function.lifecycle is? none and not mentions_resource(id session) {plan.source=previous plan.function_source=previous_function_source plan.result_type=previous_result return}
    if resource(function.rettype session.types) isnt? none and returnable_result(function.body session) {function.body=return_result(function.body @session)}
    function.body=scoped_body(function.body @session)
    local_transfers(function.body parameter_owners allowed @plan session)
    # Add branch-sensitive transfers. Keep flagged owners in lexical owner
    # lists so nested scope/loop cleanup boundaries retain their indices.
    let owned:set<addr>=set[]
    loop owner in parameter_owners {
        let declared=hir.node_at(session.hir owner)
        $runtime_assert declared is? hir.Declare and declared.binding_id isnt? none
        owned.add(declared.binding_id)
    }
    let pending:array<addr>=[function.body]
    loop pending.length >? 0 {
        let current=hir.node_at(session.hir pending.pop)
        if current is? hir.FunctionLiteral continue
        if current is? hir.Declare and current.binding_id isnt? none and resource((if current.annotation is? none hir.node_at(session.hir current.expr).value_type else current.annotation) session.types) isnt? none {owned.add(current.binding_id)}
        hir.push_children(current @pending)
    }
    let conditional=ownership_liveness.consumptions(function.body owned session.hir session.types)
    loop [read owner] in conditional.consumes {
        let declaration=conditional.declarations.get(read)
        if read in? plan.consume_sites or (declaration isnt? none and declaration in? plan.transfer_sites) continue
        if declaration isnt? none {plan.transfer_sites.add(declaration)}
        else {plan.consume_sites.add(read)}
        if owner not in? plan.flags {
            let boolean=types.primitive('bool' @session.types)
            plan.flags[owner]=capture_result(put(hir.Bool[function.loc boolean true] @session) function.loc @session)
        }
    }
    let composed_parent:addr?=none
    if function.lifecycle_composition and function.lifecycle in? ['copy' 'move'] {
        let body=hir.node_at(session.hir function.body)
        $runtime_assert body is? hir.Block and body.items.length =? 2
        let parent=hir.node_at(session.hir body.items[0])
        $runtime_assert parent is? hir.Declare
        composed_parent=parent.binding_id
        if function.lifecycle =? 'move' {
            $runtime_assert function.pos_or_kw_args.length >? 0
            let receiver=function.pos_or_kw_args[0].binding_id
            $runtime_assert receiver isnt? none and hir.node_at(session.hir body.items[1]) is? hir.Return
            plan.composed_moves[body.items[1]]=receiver
        }
    }
    let owners=parameter_owners
    statement(function.body @owners [] allowed function.lifecycle =? 'drop' resource(function.rettype session.types) isnt? none @plan @session composed_parent=composed_parent entry=true)
    let prefix:array<addr>=[]
    loop owner in parameter_owners {
        let declared=hir.node_at(session.hir owner)
        $runtime_assert declared is? hir.Declare and declared.binding_id isnt? none
        $runtime_assert declared.binding_id isnt? none
        let flag=plan.flags.get(declared.binding_id)
        if flag isnt? none {prefix.push(flag.declaration)}
    }
    if prefix.length >? 0 {
        let body=hir.node_at(session.hir function.body)
        $runtime_assert body is? hir.Block
        loop item in body.items {prefix.push(item)}
        body.items=prefix
        store(function.body body @session)
    }
    store(id function @session)
    plan.source=previous
    plan.function_source=previous_function_source
    plan.result_type=previous_result
}
# `prepared` leading roots were already rewritten (the prelude, before its
# validation was cached). Their hooks still apply everywhere, but their
# bodies are not rewritten again: doing so would edit the cached graph.
prepare = (roots:array<addr> source:SrcFile @session:contexts.Session prepared:addr=0):>Error? => {
    let plan=Plan[source=source]
    # Hooks are hoisted module declarations. Unannotated programs need only
    # this small inventory scan, not another traversal of every function body.
    let items:array<addr>=[]
    let settled:addr=0
    loop index in 0.. and index <? roots.length {
        let block=hir.node_at(session.hir roots[index])
        $runtime_assert block is? hir.Block
        loop item in block.items {items.push(item)}
        if index <? prepared {settled=items.length}
    }
    loop id in items {
        let node=hir.node_at(session.hir id)
        if node isnt? hir.Declare or node.binding_id is? none {continue}
        let value=hir.node_at(session.hir node.expr)
        if value isnt? hir.FunctionLiteral or value.lifecycle is? none {continue}
        if value.source isnt? none {
            $runtime_assert value.source <? session.sources.length
            plan.source=session.sources[value.source].srcfile
        }
        if value.lifecycle not in? ['drop' 'copy' 'move'] or value.pos_or_kw_args.length =? 0 {reject(node 'an invalid lifecycle receiver' @plan) return plan.problem}
        let owner=views.structural_base(value.pos_or_kw_args[0].value_type session.types)
        let type=types.node_at(session.types owner)
        $runtime_assert type is? types.ObjectType and type.brand isnt? none
        let hook=Hook[owner node.binding_id node.name value.value_type value.lifecycle]
        plan.hooks[node.binding_id]=hook
        if value.lifecycle =? 'drop' {plan.owners[type.brand]=hook}
        if value.lifecycle =? 'move' {plan.moves[type.brand]=hook}
        if value.lifecycle =? 'copy' {plan.copies[type.brand]=hook}
    }
    if plan.hooks.length =? 0 return none
    let iteration_seen:set<addr>=set[]
    loop index in 0.. and index <? roots.length {
        if index >=? prepared {prepare_iterations(roots[index] @iteration_seen @plan @session)}
    }
    # Before rewriting bodies, summarize calls which may change a selected
    # resource-array receiver. This includes transitive captured/global writes.
    let receivers:set<addr>=set[]
    let visited:set<addr>=set[]
    # Settled items are scanned second and only read.
    loop phase in 0..1 {
        let rewritable=phase =? 0
        let pending:array<addr>=[]
        let first=if rewritable settled else 0
        let stop=if rewritable items.length else settled
        let index=first
        loop index <? stop {
            $runtime_assert index <? items.length
            pending.push(items[index])
            index+=1
        }
        loop pending.length >? 0 {
            let id=pending.pop
            if id in? visited {continue}
            visited.add(id)
            let node=hir.node_at(session.hir id)
            if node is? hir.ArrayMethod and node.name =? 'truncate' and resource(hir.node_at(session.hir node.array).value_type session.types) isnt? none {
                let root=receiver_root(node.array session.hir)
                if root isnt? none {receivers.add(root)}
            }
            if node is? hir.MemberAssign|hir.IndexAssign and resource(hir.node_at(session.hir node.target).value_type session.types) isnt? none {
                let root=receiver_root(node.target session.hir)
                if root isnt? none {receivers.add(root)}
            }
            if node is? hir.MemberAccess|hir.Index and resource(node.value_type session.types) isnt? none {
                let root=receiver_root(id session.hir)
                if root isnt? none {receivers.add(root)}
            }
            if node is? hir.Return and node.item isnt? none and resource(hir.node_at(session.hir node.item).value_type session.types) isnt? none {
                let root=receiver_root(node.item session.hir)
                if root isnt? none {receivers.add(root)}
            }
            if node is? hir.DictStore|hir.DictRemove|hir.DictLookup {
                let values=node.values
                if values isnt? none and resource(hir.node_at(session.hir values).value_type session.types) isnt? none {
                    let root=receiver_root(node.keys session.hir)
                    if root isnt? none {receivers.add(root)}
                    if node is? hir.DictLookup and rewritable {
                        # Synthesized copies may compact this dictionary. Keep
                        # membership proof, but recompute its physical position.
                        node.position=none node.static_position=none
                        store(id node @session)
                    }
                }
            }
            hir.push_children(node @pending)
        }
    }
    if receivers.length >? 0 {
        let empty=types.primitive('void' @session.types)
        let joined=put(hir.Block[Span[0 0] empty items false] @session)
        plan.argument_writes=effects.analyze_global_writes(joined session.hir receivers session.registry)
        plan.readonly_arguments=effects.read_only_places(joined session.hir session.types)
    }
    let next=prepared
    loop next <? roots.length {
        let index=next
        next+=1
        let block=hir.node_at(session.hir roots[index])
        $runtime_assert block is? hir.Block
        loop item in block.items {
            let node=hir.node_at(session.hir item)
            if node is? hir.Declare and hir.node_at(session.hir node.expr) is? hir.FunctionLiteral {prepare_function(node.expr @plan @session)}
            else {expression(item set[] false @plan @session)}
            if plan.problem isnt? none return plan.problem
        }
    }
    # Generated helpers join the last module (the entry), not a prelude
    # module: an edit inside the prelude's checked graph would discard its
    # cached validation on every compilation.
    if plan.generated.length >? 0 {
        $runtime_assert roots.length >? 0
        let last=roots[roots.length-1]
        let root=hir.node_at(session.hir last)
        $runtime_assert root is? hir.Block
        let block:hir.Block=root
        loop declaration in plan.generated {block.items.push(declaration)}
        store(last block @session)
    }
    return none
}

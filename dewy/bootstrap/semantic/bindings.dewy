from reporting import Span
import p"hir.dewy" as hir
import p"ty.dewy" as types
import p"effect_rows.dewy" as effect_rows

doc"""
Stable declaration identities, lexical lookup, and projected storage routes.

A name is a lookup key in a scope, not a value's identity. Shadowing allocates
a fresh binding; importing or looking up the same declaration retains its
binding. Parser and HIR nodes already have stable arena indices, so this port
does not need the hosted registry's keepalive objects for Python id() keys.
"""

BindingKind:type = 'value' | 'function' | 'overload' | 'param' | 'effect'
Binding:type = [
    id:addr
    name:string
    kind:BindingKind
    loc:Span
    value_type:addr?=none
    # Place parameters keep the caller's store contract through forwarding
    # and mutation, separately from a read's current flow facts.
    store_type:addr?=none
    type_value:types.TypeAliasValue?=none
    effect_value:effect_rows.Row?=none
    declaration:addr?=none
    function:addr?=none
    syntax:addr?=none
    # Compiler-bound expressions such as `end` inside a sequence index have
    # lexical identity but introduce no runtime storage of their own.
    replacement:addr?=none
    literal_path_parameter:string?=none
    read_only_reason:string?=none
    nominal_name:string?=none
    route_root:addr?=none
    # Intrinsic definitions have stable names/types but no startup declaration.
    # A user declaration with the same spelling remains an ordinary binding.
    builtin:bool=false
    proof:bool=false
]

# Generic instances retain the defining source and call context so a later
# representation pass can instantiate again when an integer becomes bigint.
GenericInstance:type = [generic:addr type_arguments:dict<string addr> context:addr effect_arguments:dict<string effect_rows.Row>=[]]
Route:type = const [id:addr root:addr path:array<string>]
Registry:type = [
    next_id:addr=1
    # Keep validation-only route allocation separate from declaration ids.
    # The hosted bounds pass packs ids in 20 bits; retain its route range for
    # now. The native fact representation must not silently truncate an id.
    next_route_id:addr=524288
    # Value snapshots share these small binding pages. Updating one binding
    # copies its page and the page index, rather than every binding record in
    # the compilation. Sparse validation ids use the same address space.
    binding_pages:dict<addr dict<addr Binding>>=[]
    # Keep the active page outside the index. Sequential declarations and
    # repeated edits can update it directly, without taking another snapshot
    # of the page on every write. Snapshots still own all three fields.
    current_page:addr?=none
    current_bindings:dict<addr Binding>=[]
    by_syntax:dict<addr addr>=[]
    # A route belongs to one root binding. Keep that grouping as the primary
    # representation: queries and invalidation need only that root's fields.
    # Registry value snapshots carry the groups together with their bindings.
    routes_by_root:dict<addr array<Route>>=[]
    generic_instances:dict<addr GenericInstance>=[]
]

const BINDING_PAGE_SIZE:addr=128
find_binding = (registry:Registry id:addr):>Binding? => {
    let page_id=id // BINDING_PAGE_SIZE
    let current=registry.current_page
    if current isnt? none and current =? page_id return registry.current_bindings.get(id)
    let page=registry.binding_pages.get(page_id)
    if page is? none return none
    return page.get(id)
}
has_binding = (registry:Registry id:addr):>bool => {
    let page_id=id // BINDING_PAGE_SIZE
    let current=registry.current_page
    if current isnt? none and current =? page_id return id in? registry.current_bindings
    let page=registry.binding_pages.get(page_id)
    return page isnt? none and id in? page
}
store_binding = (@registry:Registry id:addr binding:Binding):>void => {
    let page_id=id // BINDING_PAGE_SIZE
    let current=registry.current_page
    if current is? none or current not=? page_id {
        if current isnt? none {registry.binding_pages[current]=registry.current_bindings}
        registry.current_bindings=registry.binding_pages.pop(page_id default=[])
        registry.current_page=page_id
    }
    registry.current_bindings[id]=binding
}

binding_at = (registry:Registry id:addr):>Binding => {
    let binding = find_binding(registry id)
    $runtime_assert binding isnt? none
    return binding
}

allocate = (@registry:Registry syntax:addr? name:string kind:BindingKind loc:Span):>addr => {
    let id = registry.next_id
    registry.next_id += 1
    store_binding(@registry id Binding[id=id name=name kind=kind loc=loc syntax=syntax])
    if syntax isnt? none { registry.by_syntax[syntax] = id }
    return id
}

allocate_param = (@registry:Registry name:string value_type:addr loc:Span):>addr => {
    let id = allocate(@registry none name 'param' loc)
    let binding = binding_at(registry id)
    binding.value_type = value_type
    store_binding(@registry id binding)
    return id
}

path_starts_with = (path:array<string> prefix:array<string>):>bool => {
    if path.length <? prefix.length return false
    loop i in 0.. and i <? prefix.length { if path[i] not=? prefix[i] return false }
    return true
}

route_id = (@registry:Registry root:addr path:array<string> value_type:addr loc:Span):>addr => {
    let routes=registry.routes_by_root.get(root [])
    loop route in routes {
        if route.path.length =? path.length and path_starts_with(route.path path) return route.id
    }
    let owner = binding_at(registry root)
    let id = registry.next_route_id
    registry.next_route_id += 1
    store_binding(@registry id Binding[id=id name="{owner.name}.{path.join('.')}" kind='value' loc=loc value_type=value_type route_root=root])
    routes.push(Route[id=id root=root path=path])
    registry.routes_by_root[root]=routes
    return id
}

route_at = (registry:Registry id:addr):>Route? => {
    let binding=find_binding(registry id)
    if binding is? none or binding.route_root is? none return none
    loop route in registry.routes_by_root.get(binding.route_root []) {
        if route.id =? id return route
    }
    return none
}

routes_under = (registry:Registry root:addr prefix:array<string>):>array<addr> => {
    let output:array<addr> = []
    loop route in registry.routes_by_root.get(root []) {
        if path_starts_with(route.path prefix) { output.push(route.id) }
    }
    return output
}

# Contexts refer to lexical scopes in an arena. Branch facts can be copied
# independently while all branches still resolve the same declaration ids.
Scope:type = [parent:addr?=none names:dict<string addr>=[]]
push_scope = (@scopes:array<Scope> parent:addr?):>addr<i => i <? scopes.length> => {
    let id = scopes.length
    scopes.push(Scope[parent=parent])
    return id
}
scope_at = (scopes:array<Scope> id:addr):>Scope => {
    $runtime_assert id <? scopes.length
    return scopes[id]
}
lookup = (scopes:array<Scope> scope:addr name:string):>addr? => {
    let current:addr? = scope
    loop current isnt? none {
        let frame = scope_at(scopes current)
        let binding = frame.names.get(name)
        if binding isnt? none return binding
        current = frame.parent
    }
    return none
}
bind_name = (@frame:Scope name:string binding:addr):>void => { frame.names[name] = binding }
bind = (@scopes:array<Scope> scope:addr name:string binding:addr):>void => {
    $runtime_assert scope <? scopes.length
    # Update the frame in place: copying it out and back would detach (copy)
    # every array of its dictionary for one insertion.
    bind_name(@scopes[scope] name binding)
}

# Access decomposition has an explicit view policy. A value cast can preserve
# sequence identity for a length proof without preserving a storage location
# for assignment. `transmute` is deliberately opaque to both policies.
AccessPath:type = [root:addr steps:array<addr>]
access_path = (id:addr nodes:array<hir.AST> facts:bool=false forwarding:bool=false):>AccessPath => {
    let current:addr = id
    let reversed:array<addr> = []
    loop true {
        let node = hir.node_at(nodes current)
        if facts and node is? hir.ValueCast | hir.RepresentationCast { current = node.expr continue }
        if facts and node is? hir.Obligation { current = node.value continue }
        if node is? hir.MemberAccess { reversed.push(current) current = node.value continue }
        if forwarding and node is? hir.ForwardingAccess { reversed.push(current) current = node.value continue }
        if node is? hir.Index { reversed.push(current) current = node.array continue }
        break
    }
    let steps:array<addr> = []
    loop reversed.length >? 0 { steps.push(reversed.pop) }
    return AccessPath[root=current steps=steps]
}

member_fields = (path:AccessPath nodes:array<hir.AST>):>array<string> | none => {
    let names:array<string> = []
    loop id in path.steps {
        let step = hir.node_at(nodes id)
        if step is? hir.MemberAccess { names.push(step.name) }
        else if step is? hir.ForwardingAccess { names.push(step.field) }
        else return none
    }
    return names
}

field_route_type = (id:addr fields:array<string> nodes:types.Table):>addr? => {
    let current=id
    loop name in fields {
        let object=types.node_at(nodes types.unfold(types.strip_refinement(current nodes) nodes))
        if object isnt? types.ObjectType return none
        if object.brand isnt? none and not object.minted return none
        let field=types.object_field(object name)
        if field is? none return none
        current=field.value_type
    }
    return current
}
# Extend a known binding or field identity without constructing HIR reads.
# Keep the original root so replacing any enclosing record invalidates it.
extend_route = (id:addr fields:array<string> type_nodes:types.Table @registry:Registry):>addr? => {
    if fields.length =? 0 return id
    let binding=binding_at(registry id)
    if binding.value_type is? none return none
    let type=field_route_type(binding.value_type fields type_nodes)
    if type is? none return none
    let root=id
    let path:array<string>=[]
    if binding.route_root isnt? none {
        root=binding.route_root
        let prior=route_at(registry id)
        if prior isnt? none {path=prior.path}
    }
    loop name in fields {path.push(name)}
    return route_id(@registry root path type binding.loc)
}

array_route_id = (id:addr nodes:array<hir.AST> @registry:Registry):>addr? => {
    let path = access_path(id nodes facts=true)
    let root = hir.node_at(nodes path.root)
    if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return none
    let fields = member_fields(path nodes)
    if fields is? none return none
    if fields.length =? 0 return root.binding_id
    if not has_binding(registry root.binding_id) return none
    let node = hir.node_at(nodes id)
    return route_id(@registry root.binding_id fields node.value_type node.loc)
}

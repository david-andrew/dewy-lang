$explicit_copies

import p"hir.dewy" as hir
import p"ty.dewy" as types
import p"type_queries.dewy" as views

# The same bounded array/record proof as semantic/placement.py. Whole-value
# copies, captures, escaping addresses and resizing exclude the frame route.
# Solved calls may borrow fields/elements, or a whole owner whose storage
# they preserve: read-only arrays and field-mutating scalar records.
# Proven read-only value arguments can lend stable owners without an explicit @.
# Arrays and records share one budget. Record fields may be nested records
# of scalar words; dynamic storage and lifecycle hooks exclude this proof.
const FRAME_STORAGE_BYTES:addr=4096
scalar_record_size=(type:addr table:types.Table):>addr?=>{
    let pending:array<addr>=[type]
    let size:addr=0
    loop pending.length>?0 {
        if size>?FRAME_STORAGE_BYTES-8 return none
        let selected=views.structural_base(pending.pop table)
        let shape=types.node_at(table selected)
        if shape is? types.ObjectType {
            loop method in shape.methods {if method.lifecycle isnt? none return none}
            loop field in shape.fields {pending.push(field.value_type)}
        } else if not types.is_primitive(shape 'bool') and views.fixed_integer_layout(selected table) is? none {
            return none
        }
        size+=8
    }
    return size
}
literal_storage=(value:addr nodes:array<hir.AST> table:types.Table):>set<addr>=>{
    let result:set<addr>=set[]
    let pending:array<addr>=[value]
    loop pending.length>?0 {
        let id=pending.pop
        if id in? result continue
        result.add(id)
        let node=hir.node_at(nodes id)
        if node is? hir.ObjectLiteral {
            let shape=types.node_at(table views.structural_base(node.value_type table))
            $runtime_assert shape is? types.ObjectType
            loop field in node.fields {
                let expected=types.object_field(shape field.name)
                let value=hir.node_at(nodes field.value)
                if value is? hir.ObjectLiteral and expected isnt? none and types.same_type(views.structural_base(value.value_type table) views.structural_base(expected.value_type table) table) {pending.push(field.value)}
            }
        }
    }
    return result
}
Candidate:type=const [declaration:addr size:addr<v=>v<=?4096>]
local_values=(literal:hir.FunctionLiteral nodes:array<hir.AST> table:types.Table nonescaping_places:set<addr>=set[] fixed_places:set<addr>=set[] borrowed_values:dict<addr set<addr>>=[]):>dict<addr addr>=>{
    let items:array<addr>=[]
    let blocked:set<addr>=set[]
    let pending:array<addr>=[literal.body]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionLiteral {
            let nested:array<addr>=[node.body]
            loop nested.length >? 0 {
                let child=hir.node_at(nodes nested.pop)
                if child is? hir.ExpressedIdentifier and child.binding_id isnt? none {blocked.add(child.binding_id)}
                hir.push_children(child @nested)
            }
            continue
        }
        items.push(id)
        let children=hir.children(node)
        loop children.length >? 0 {pending.push(children.pop)}
    }
    let candidates:dict<addr Candidate>=[]
    let allowed:dict<addr addr>=[]
    let whole_places:set<addr>=set[]
    let occurrences:dict<addr addr>=[]
    loop id in items {
        let node=hir.node_at(nodes id)
        if node is? hir.ExpressedIdentifier {occurrences[id]=occurrences.get(id 0)+1}
        if node is? hir.Declare and node.binding_id isnt? none and not node.view {
            let value=hir.node_at(nodes node.expr)
            if value is? hir.ArrayLiteral {
                let shape=types.node_at(table types.strip_refinement(value.value_type table))
                if shape is? types.ArrayType and shape.length =? value.items.length and value.items.length <=? (FRAME_STORAGE_BYTES-48)//8 {
                    let element=types.node_at(table types.strip_refinement(shape.element table))
                    let scalar=types.is_primitive(element 'bool') or views.fixed_integer_layout(shape.element table) isnt? none
                    let spread=false
                    loop item in value.items {if hir.node_at(nodes item) is? hir.Spread {spread=true}}
                    if scalar and not spread {candidates[node.binding_id]=Candidate[id 48+8*value.items.length]}
                }
            } else if value is? hir.ObjectLiteral {
                let size=scalar_record_size(value.value_type table)
                if size isnt? none and size<=?FRAME_STORAGE_BYTES {candidates[node.binding_id]=Candidate[id size]}
            }
        }
        if node is? hir.FunctionCall and id in? borrowed_values {
            const borrowed=@borrowed_values[id]
            loop arg in node.pos_args {
                if arg in? borrowed and hir.node_at(nodes arg) is? hir.ExpressedIdentifier {allowed[arg]=allowed.get(arg 0)+1}
            }
            loop arg in node.kw_args.values {
                if arg in? borrowed and hir.node_at(nodes arg) is? hir.ExpressedIdentifier {allowed[arg]=allowed.get(arg 0)+1}
            }
        }
        if node is? hir.Index|hir.ArrayLength and hir.node_at(nodes node.array) is? hir.ExpressedIdentifier {allowed[node.array]=allowed.get(node.array 0)+1}
        if node is? hir.MemberAccess and hir.node_at(nodes node.value) is? hir.ExpressedIdentifier {allowed[node.value]=allowed.get(node.value 0)+1}
        if node is? hir.Place and id in? fixed_places {
            let target=hir.node_at(nodes node.target)
            if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
                allowed[node.target]=allowed.get(node.target 0)+1
                whole_places.add(target.binding_id)
            }
        }
        if node is? hir.Place and id not in? nonescaping_places {
            let selected:array<addr>=[node.target]
            loop selected.length >? 0 {
                let part=hir.node_at(nodes selected.pop)
                if part is? hir.ExpressedIdentifier and part.binding_id isnt? none {blocked.add(part.binding_id)}
                hir.push_children(part @selected)
            }
        }
    }
    loop id in items {
        let node=hir.node_at(nodes id)
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none and occurrences.get(id 0) not=? allowed.get(id 0) {blocked.add(node.binding_id)}
    }
    let result:dict<addr addr>=[]
    let used:addr<v=>v<=?4096>=0
    loop [binding candidate] in candidates {
        if binding in? blocked continue
        let size:addr=candidate.size
        if binding in? whole_places {
            let declaration=hir.node_at(nodes candidate.declaration)
            $runtime_assert declaration is? hir.Declare
            if hir.node_at(nodes declaration.expr) is? hir.ArrayLiteral {size+=8}
        }
        let next=used+size
        if next <=? FRAME_STORAGE_BYTES {result[binding]=candidate.declaration used=next}
    }
    return result
}

local_arrays=(literal:hir.FunctionLiteral nodes:array<hir.AST> table:types.Table nonescaping_places:set<addr>=set[] fixed_places:set<addr>=set[] borrowed_values:dict<addr set<addr>>=[]):>dict<addr addr>=>{
    let result:dict<addr addr>=[]
    loop [binding id] in local_values(literal nodes table nonescaping_places fixed_places borrowed_values) {
        let declaration=hir.node_at(nodes id)
        $runtime_assert declaration is? hir.Declare
        if hir.node_at(nodes declaration.expr) is? hir.ArrayLiteral {result[binding]=id}
    }
    return result
}

$explicit_copies

import p"hir.dewy" as hir
import p"ty.dewy" as types
import p"type_queries.dewy" as views

# The same bounded array/record proof as semantic/placement.py. Whole-value
# copies, captures, escaping addresses and resizing exclude the frame route.
# Solved calls may borrow fields/elements, or a whole owner whose storage
# they preserve: read-only arrays and field-mutating scalar records.
# Proven read-only value arguments can lend stable owners without an explicit @.
# Arrays and records share one budget. Record fields may be nested records
# of scalar words; dynamic storage and lifecycle hooks exclude this proof.
const FRAME_STORAGE_BYTES:addr=4096
scalar_record_size=(type:addr table:types.Table):>addr?=>{
    let pending:array<addr>=[type]
    let size:addr=0
    loop pending.length>?0 {
        if size>?FRAME_STORAGE_BYTES-8 return none
        let selected=views.structural_base(pending.pop table)
        let shape=types.node_at(table selected)
        if shape is? types.ObjectType {
            loop method in shape.methods {if method.lifecycle isnt? none return none}
            loop field in shape.fields {pending.push(field.value_type)}
        } else if not types.is_primitive(shape 'bool') and views.fixed_integer_layout(selected table) is? none {
            return none
        }
        size+=8
    }
    return size
}
# Proof witnesses become unscoped one-value blocks after validation. Neither
# form creates storage, but the proof itself must still pass ordinary checking.
initializer=(id:addr nodes:array<hir.AST> table:types.Table):>addr=>{
    loop true {
        let node=hir.node_at(nodes id)
        let inner:addr?=none
        if node is? hir.Obligation {inner=node.value}
        else if node is? hir.Block and not node.scoped and node.items.length=?1 {inner=node.items[0]}
        if inner is? none return id
        if not types.same_type(views.structural_base(node.value_type table) views.structural_base(hir.node_at(nodes inner).value_type table) table) return id
        id=inner
    }
}
literal_storage=(value:addr nodes:array<hir.AST> table:types.Table):>set<addr>=>{
    let result:set<addr>=set[]
    let pending:array<addr>=[value]
    loop pending.length>?0 {
        let id=pending.pop
        if id in? result continue
        result.push(id)
        let unwrapped=initializer(id nodes table)
        if unwrapped not=?id {pending.push(unwrapped) continue}
        let node=hir.node_at(nodes id)
        if node is? hir.CopyValue {
            let value=hir.node_at(nodes node.value)
            if value is? hir.ObjectLiteral|hir.ArrayLiteral|hir.CopyValue and types.same_type(views.structural_base(value.value_type table) views.structural_base(node.value_type table) table) {pending.push(node.value)}
        }
        if node is? hir.ObjectLiteral {
            let shape=types.node_at(table views.structural_base(node.value_type table))
            $runtime_assert shape is? types.ObjectType
            loop field in node.fields {
                let expected=types.object_field(shape field.name)
                let value=hir.node_at(nodes field.value)
                if value is? hir.ObjectLiteral|hir.CopyValue and expected isnt? none and types.same_type(views.structural_base(value.value_type table) views.structural_base(expected.value_type table) table) {pending.push(field.value)}
            }
        }
    }
    return result
}
Candidate:type=const [declaration:addr size:addr<v=>v<=?4096> growable:bool=false]
donated=(consumed:dict<addr set<addr>> call:addr argument:addr):>bool=>call in? consumed and argument in? consumed[call]
# A growable worklist starts in this many frame slots; growth beyond them
# moves its data to the arena (the frame block is never freed).
const GROWABLE_SLOTS:addr=16
# A literal of word-sized scalars bound to a runtime-length array local: it
# may grow, so its frame storage is only where it starts.
growable=(declaration:addr nodes:array<hir.AST> table:types.Table):>bool=>growable_literal(declaration nodes table) isnt? none
# The literal itself: checking casts it to the declared runtime length.
growable_literal=(declaration:addr nodes:array<hir.AST> table:types.Table):>addr?=>{
    let node=hir.node_at(nodes declaration)
    if node isnt? hir.Declare or node.annotation is? none return none
    let declared=types.node_at(table views.structural_base(node.annotation table))
    if declared isnt? types.ArrayType or declared.length isnt? none return none
    let id=initializer(node.expr nodes table)
    let value=hir.node_at(nodes id)
    loop value is? hir.ValueCast|hir.RepresentationCast {
        id=value.expr
        value=hir.node_at(nodes id)
    }
    if value isnt? hir.ArrayLiteral or value.items.length >? GROWABLE_SLOTS return none
    loop item in value.items {if hir.node_at(nodes item) is? hir.Spread return none}
    let word=views.fixed_integer_layout(declared.element table)
    if word is? none or word.bits not=? 64 return none
    return id
}
# Growable worklists may still allocate when they outgrow their frame slots,
# so only lowering asks for them; effect summaries keep the frame-only proof.
# A consumed argument is donated to the callee even when its parameter is
# also read-only: it is never a borrow of frame storage.
local_values=(literal:hir.FunctionLiteral nodes:array<hir.AST> table:types.Table nonescaping_places:set<addr>=set[] fixed_places:set<addr>=set[] borrowed_values:dict<addr set<addr>>=[] selected_reads:set<addr>=set[] growables:bool=false consumed_values:dict<addr set<addr>>=[]):>dict<addr addr>=>{
    let items:array<addr>=[]
    let blocked:set<addr>=set[]
    let blocked_growing:set<addr>=set[]
    let pending:array<addr>=[literal.body]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionLiteral {
            let nested:array<addr>=[node.body]
            loop nested.length >? 0 {
                let child=hir.node_at(nodes nested.pop)
                if child is? hir.ExpressedIdentifier and child.binding_id isnt? none {
                    blocked.push(child.binding_id)
                    blocked_growing.push(child.binding_id)
                }
                hir.push_children(child @nested)
            }
            continue
        }
        items.push(id)
        let children=hir.children(node)
        loop children.length >? 0 {pending.push(children.pop)}
    }
    let candidates:dict<addr Candidate>=[]
    let allowed:dict<addr addr>=[]
    loop id in selected_reads {allowed[id]=1}
    let whole_places:set<addr>=set[]
    let occurrences:dict<addr addr>=[]
    # Uses only a growable worklist may have: method receivers, iteration and
    # places lent to one call (none of them keeps or transfers the array).
    let growing:dict<addr addr>=[]
    loop id in items {
        let node=hir.node_at(nodes id)
        if node is? hir.ExpressedIdentifier {occurrences[id]=occurrences.get(id 0)+1}
        if node is? hir.Declare and node.binding_id isnt? none and not node.view {
            let value=hir.node_at(nodes initializer(node.expr nodes table))
            let shape=types.node_at(table views.structural_base(value.value_type table))
            if growables and growable(id nodes table) {candidates[node.binding_id]=Candidate[id 48+8*GROWABLE_SLOTS growable=true]}
            else if value is? hir.ArrayLiteral|hir.CopyValue and shape is? types.ArrayType {
                if shape.length isnt? none and shape.length <=? (FRAME_STORAGE_BYTES-48)//8 {
                    let element=types.node_at(table types.strip_refinement(shape.element table))
                    let scalar=types.is_primitive(element 'bool') or views.fixed_integer_layout(shape.element table) isnt? none
                    let spread=false
                    if value is? hir.ArrayLiteral {
                        if shape.length not=?value.items.length {spread=true}
                        loop item in value.items {if hir.node_at(nodes item) is? hir.Spread {spread=true}}
                    }
                    if scalar and not spread {candidates[node.binding_id]=Candidate[id 48+8*shape.length]}
                }
            } else if value is? hir.ObjectLiteral|hir.CopyValue {
                let size=scalar_record_size(value.value_type table)
                if size isnt? none and size<=?FRAME_STORAGE_BYTES {candidates[node.binding_id]=Candidate[id size]}
            }
        }
        if node is? hir.FunctionCall and id in? borrowed_values {
            const borrowed=@borrowed_values[id]
            loop arg in node.pos_args {
                if arg in? borrowed and not donated(consumed_values id arg) and hir.node_at(nodes arg) is? hir.ExpressedIdentifier {allowed[arg]=allowed.get(arg 0)+1}
            }
            loop arg in node.kw_args.values {
                if arg in? borrowed and not donated(consumed_values id arg) and hir.node_at(nodes arg) is? hir.ExpressedIdentifier {allowed[arg]=allowed.get(arg 0)+1}
            }
        }
        if node is? hir.CopyValue and hir.node_at(nodes node.value) is? hir.ExpressedIdentifier {allowed[node.value]=allowed.get(node.value 0)+1}
        if node is? hir.Index|hir.ArrayLength and hir.node_at(nodes node.array) is? hir.ExpressedIdentifier {allowed[node.array]=allowed.get(node.array 0)+1}
        if node is? hir.MemberAccess and hir.node_at(nodes node.value) is? hir.ExpressedIdentifier {allowed[node.value]=allowed.get(node.value 0)+1}
        if node is? hir.Place and id in? fixed_places {
            let target=hir.node_at(nodes node.target)
            if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
                allowed[node.target]=allowed.get(node.target 0)+1
                whole_places.push(target.binding_id)
            }
        }
        if node is? hir.FunctionCall {
            let callee=hir.node_at(nodes node.func)
            if callee is? hir.ArrayMethod and hir.node_at(nodes callee.array) is? hir.ExpressedIdentifier {growing[callee.array]=growing.get(callee.array 0)+1}
        }
        if node is? hir.IteratorExpression and hir.node_at(nodes node.iterable) is? hir.ExpressedIdentifier {growing[node.iterable]=growing.get(node.iterable 0)+1}
        if node is? hir.Place and id in? nonescaping_places and id not in? fixed_places and hir.node_at(nodes node.target) is? hir.ExpressedIdentifier {growing[node.target]=growing.get(node.target 0)+1}
        if node is? hir.Place and id not in? nonescaping_places {
            let selected:array<addr>=[node.target]
            loop selected.length >? 0 {
                let part=hir.node_at(nodes selected.pop)
                if part is? hir.ExpressedIdentifier and part.binding_id isnt? none {blocked.push(part.binding_id)}
                hir.push_children(part @selected)
            }
        }
    }
    loop id in items {
        let node=hir.node_at(nodes id)
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            if occurrences.get(id 0) not=? allowed.get(id 0) {blocked.push(node.binding_id)}
            if occurrences.get(id 0) not=? allowed.get(id 0)+growing.get(id 0) {blocked_growing.push(node.binding_id)}
        }
    }
    let result:dict<addr addr>=[]
    let used:addr<v=>v<=?4096>=0
    loop [binding candidate] in candidates {
        if candidate.growable {
            if binding in? blocked_growing continue
        } else if binding in? blocked continue
        let size:addr=candidate.size
        if binding in? whole_places {
            let declaration=hir.node_at(nodes candidate.declaration)
            $runtime_assert declaration is? hir.Declare
            if types.node_at(table views.structural_base(hir.node_at(nodes declaration.expr).value_type table)) is? types.ArrayType {size+=8}
        }
        let next=used+size
        if next <=? FRAME_STORAGE_BYTES {result[binding]=candidate.declaration used=next}
    }
    return result
}

local_arrays=(literal:hir.FunctionLiteral nodes:array<hir.AST> table:types.Table nonescaping_places:set<addr>=set[] fixed_places:set<addr>=set[] borrowed_values:dict<addr set<addr>>=[] selected_reads:set<addr>=set[]):>dict<addr addr>=>{
    let result:dict<addr addr>=[]
    loop [binding id] in local_values(literal nodes table nonescaping_places fixed_places borrowed_values selected_reads) {
        let declaration=hir.node_at(nodes id)
        $runtime_assert declaration is? hir.Declare
        if types.node_at(table views.structural_base(hir.node_at(nodes declaration.expr).value_type table)) is? types.ArrayType {result[binding]=id}
    }
    return result
}

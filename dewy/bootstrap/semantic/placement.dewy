import p"hir.dewy" as hir
import p"ty.dewy" as types
import p"type_queries.dewy" as views

# The same bounded local-array proof as semantic/placement.py. Whole-value
# reads, captures, address formation and resizing exclude the frame route.
const FRAME_ARRAY_BYTES:addr=4096
Candidate:type=const [declaration:addr size:addr<v=>v<=?4096>]
local_arrays=(literal:hir.FunctionLiteral nodes:array<hir.AST> table:types.Table):>dict<addr addr>=>{
    let items:array<addr>=[]
    let blocked:set<addr>=set[]
    let pending:array<addr>=[literal.body]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionLiteral {
            let nested:array<addr>=[node.body]
            loop nested.length >? 0 {
                let child=hir.node_at(nodes nested.pop)
                if child is? hir.ExpressedIdentifier and child.binding_id isnt? none {blocked.add(child.binding_id)}
                hir.push_children(child @nested)
            }
            continue
        }
        items.push(id)
        let children=hir.children(node)
        loop children.length >? 0 {pending.push(children.pop)}
    }
    let candidates:dict<addr Candidate>=[]
    let allowed:dict<addr addr>=[]
    let occurrences:dict<addr addr>=[]
    loop id in items {
        let node=hir.node_at(nodes id)
        if node is? hir.ExpressedIdentifier {occurrences[id]=occurrences.get(id 0)+1}
        if node is? hir.Declare and node.binding_id isnt? none and not node.view {
            let value=hir.node_at(nodes node.expr)
            if value is? hir.ArrayLiteral {
                let shape=types.node_at(table types.strip_refinement(value.value_type table))
                if shape is? types.ArrayType and shape.length =? value.items.length and value.items.length <=? (FRAME_ARRAY_BYTES-48)//8 {
                    let element=types.node_at(table types.strip_refinement(shape.element table))
                    let scalar=types.is_primitive(element 'bool') or views.fixed_integer_layout(shape.element table) isnt? none
                    let spread=false
                    loop item in value.items {if hir.node_at(nodes item) is? hir.Spread {spread=true}}
                    if scalar and not spread {candidates[node.binding_id]=Candidate[id 48+8*value.items.length]}
                }
            }
        }
        if node is? hir.Index|hir.ArrayLength and hir.node_at(nodes node.array) is? hir.ExpressedIdentifier {allowed[node.array]=allowed.get(node.array 0)+1}
        if node is? hir.Place {
            let selected:array<addr>=[node.target]
            loop selected.length >? 0 {
                let part=hir.node_at(nodes selected.pop)
                if part is? hir.ExpressedIdentifier and part.binding_id isnt? none {blocked.add(part.binding_id)}
                hir.push_children(part @selected)
            }
        }
    }
    loop id in items {
        let node=hir.node_at(nodes id)
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none and occurrences.get(id 0) not=? allowed.get(id 0) {blocked.add(node.binding_id)}
    }
    let result:dict<addr addr>=[]
    let used:addr<v=>v<=?4096>=0
    loop [binding candidate] in candidates {
        if binding in? blocked continue
        let size=candidate.size
        let next=used+size
        if next <=? FRAME_ARRAY_BYTES {result[binding]=candidate.declaration used=next}
    }
    return result
}

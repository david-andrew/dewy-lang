import p"effect_rows.dewy" as rows

# Compiler identities for omitted rows, distinct from user row parameters.
# Bodies and selected value boundaries contribute possible behavior. Negative
# contracts are checked afterwards; they never remove possible effects.
const PREFIX='inferred-effect:'
const BINDING_PREFIX='inferred-effect:binding:'
Constraint:type = const [actual:rows.Contract? required:rows.Contract?]
# Transient equations retain the callee's subject scope until its row has
# been solved. They are not source types or serialized generic binders.
Projection:type = const [source:rows.Contract subjects:dict<string rows.Subject?>]
Rule:type = const [targets:array<string> source:rows.Row covered:rows.Row=rows.Row[] subjects:(dict<string rows.Subject?>)?=none]
pending=(contract:rows.Contract?):>bool=>{
    if contract is? none or contract.allowed is? none return false
    loop name in contract.allowed.variables {if name.startswith(PREFIX) return true}
    return false
}
resolve=(contract:rows.Contract? solutions:dict<string rows.Row>):>rows.Contract?=>{
    return rows.replace_variables(contract solutions)
}
admitted=(contract:rows.Contract?):>rows.Row=>{
    if contract is? none or contract.allowed is? none return rows.Row[unknown=true]
    return contract.allowed
}
solve=(definitions:dict<string rows.Contract> constraints:array<Constraint>=[] projections:dict<string Projection>=[]):>dict<string rows.Row>=>{
    let rules:array<Rule>=[]
    let solutions:dict<string rows.Row>=[]
    loop [name body] in definitions {
        rules.push(Rule[[name] admitted(body)])
        solutions[name]=rows.Row[]
    }
    loop [name edge] in projections {
        rules.push(Rule[[name] admitted(edge.source) subjects=edge.subjects])
        solutions[name]=rows.Row[]
    }
    loop constraint in constraints {
        let permitted=admitted(constraint.required)
        let targets:array<string>=[]
        let covered_variables:array<string>=[]
        loop name in permitted.variables {
            if name in? definitions {targets.push(name)} else {covered_variables.push(name)}
        }
        if targets.length =? 0 or permitted.unknown continue
        rules.push(Rule[targets admitted(constraint.actual) rows.Row[permitted.atoms covered_variables]])
    }
    let users:dict<string set<addr>>=[]
    let work:array<addr>=[]
    let queued:set<addr>=set[]
    loop index in 0.. and index <? rules.length {
        loop name in rules[index].source.variables {
            if name in? solutions {
                let dependents=users.get(name set[])
                dependents.push(index) users[name]=dependents
            }
        }
        work.push(index) queued.push(index)
    }
    loop work.length >? 0 {
        let index=work.pop
        queued.pop(index default=index);
        $runtime_assert index <? rules.length
        let rule=rules[index]
        let source=rows.substitute(rule.source solutions)
        if rule.subjects isnt? none {source=admitted(rows.instantiate(rows.Contract[source] rule.subjects))}
        let atoms:array<rows.Atom>=[]
        loop atom in source.atoms {
            let covered=false
            loop bound in rule.covered.atoms {if rows.covers(bound atom) {covered=true break}}
            if not covered {atoms.push(atom)}
        }
        let variables:array<string>=[]
        loop name in source.variables {if name not in? rule.covered.variables {variables.push(name)}}
        let residual=rows.Row[atoms variables source.unknown]
        # With several destination variables, give each the residual. This
        # is conservative; it does not invent a unique minimal partition.
        loop name in rule.targets {
            $runtime_assert name in? solutions
            let updated=rows.merge(solutions[name] residual)
            if rows.identity(rows.Contract[updated]) =? rows.identity(rows.Contract[solutions[name]]) continue
            solutions[name]=updated
            loop user in users.get(name set[]) {
                if user not in? queued {work.push(user) queued.push(user)}
            }
        }
    }
    return solutions
}
satisfied=(constraint:Constraint solutions:dict<string rows.Row>):>bool=>{
    return rows.implies(resolve(constraint.actual solutions) resolve(constraint.required solutions))
}

# Possibility only. Selected value boundaries retain their final obligation;
# speculative overload/subtype probes must never contribute assignments.
compatible=(actual:rows.Contract? required:rows.Contract?):>bool=>{
    if not pending(actual) and not pending(required) return rows.implies(actual required)
    let lower:dict<string rows.Row>=[]
    let upper:dict<string rows.Row>=[]
    if actual isnt? none and actual.allowed isnt? none {
        loop name in actual.allowed.variables {if name.startswith(PREFIX) {lower[name]=rows.Row[]}}
    }
    if required isnt? none and required.allowed isnt? none {
        loop name in required.allowed.variables {if name.startswith(PREFIX) {upper[name]=rows.Row[unknown=true]}}
    }
    return rows.implies(resolve(actual lower) resolve(required upper))
}

# A row's open negative guarantees travel through inference independently of
# its possible effects. A requirement selects a candidate, never proves it.
GuaranteeRule:type=const [name:string source:rows.Contract covered:rows.Row=rows.Row[] subjects:(dict<string rows.Subject?>)?=none]
# Inverting a call environment only removes a route prefix or renames its
# parameter slot. Even recursive calls therefore select a finite vocabulary
# of route suffixes; every candidate still owes proof from all defining rules.
Inverse:type=const [slot:string prefix:array<string>]
projection_candidates=(projections:dict<string Projection> @vocabulary:array<rows.Atom> @known:set<string>):>void=>{
    let inverse:dict<string array<Inverse>>=[]
    loop [name edge] in projections {
        loop [slot subject] in edge.subjects {
            if subject is? none or subject.kind not=? 'parameter' continue
            let entries=inverse.get(subject.key [])
            entries.push(Inverse[slot subject.route])
            inverse[subject.key]=entries
        }
    }
    let cursor:addr=0
    loop cursor <? vocabulary.length {
        let atom=vocabulary[cursor]
        cursor+=1
        if atom.subject is? none or atom.subject.kind not=? 'parameter' continue
        let subject=atom.subject
        loop mapping in inverse.get(subject.key []) {
            if mapping.prefix.length >? subject.route.length continue
            let matches=true
            loop i in 0.. and i <? mapping.prefix.length {
                $runtime_assert i <? subject.route.length
                if mapping.prefix[i] not=? subject.route[i] {matches=false break}
            }
            if not matches continue
            let suffix:array<string>=[]
            let i:addr=mapping.prefix.length
            loop i <? subject.route.length {suffix.push(subject.route[i]) i+=1}
            let candidate=rows.Atom[atom.family rows.Subject['parameter' mapping.slot suffix]]
            let key=rows.atom_key(candidate)
            if key not in? known {known.push(key) vocabulary.push(candidate)}
        }
    }
}
resolve_contracts=(contract:rows.Contract? solutions:dict<string rows.Contract>):>rows.Contract?=>{
    return rows.replace_contracts(contract solutions)
}

add_candidates=(contract:rows.Contract? @vocabulary:array<rows.Atom> @known:set<string>):>void=>{
    if contract is? none return
    loop atom in contract.excluded {
        let key=rows.atom_key(atom)
        if key not in? known {known.push(key) vocabulary.push(atom)}
    }
}
solve_contracts=(definitions:dict<string rows.Contract> constraints:array<Constraint>=[] projections:dict<string Projection>=[]):>dict<string rows.Contract>=>{
    let positive=solve(definitions constraints projections)
    let vocabulary:array<rows.Atom>=[]
    let known:set<string>=set[]
    loop [name body] in definitions {add_candidates(body @vocabulary @known)}
    loop [name edge] in projections {add_candidates(edge.source @vocabulary @known)}
    loop edge in constraints {
        add_candidates(edge.actual @vocabulary @known)
        add_candidates(edge.required @vocabulary @known)
    }
    if vocabulary.length >? 0 {projection_candidates(projections @vocabulary @known)}
    let solutions:dict<string rows.Contract>=[]
    loop [name row] in positive {solutions[name]=rows.Contract[row vocabulary]}
    if vocabulary.length =? 0 return solutions
    let rules:array<GuaranteeRule>=[]
    loop [name body] in definitions {rules.push(GuaranteeRule[name body])}
    loop [name edge] in projections {rules.push(GuaranteeRule[name edge.source subjects=edge.subjects])}
    loop edge in constraints {
        let permitted=admitted(edge.required)
        let targets:array<string>=[]
        let variables:array<string>=[]
        loop name in permitted.variables {
            if name in? definitions {targets.push(name)} else {variables.push(name)}
        }
        if targets.length =? 0 or permitted.unknown continue
        let covered=rows.Row[permitted.atoms variables]
        let source=if edge.actual is? none rows.Contract[] else edge.actual
        loop name in targets {rules.push(GuaranteeRule[name source covered])}
    }
    let users:dict<string set<addr>>=[]
    let work:array<addr>=[]
    let queued:set<addr>=set[]
    loop i in 0.. and i <? rules.length {
        work.push(i) queued.push(i)
        loop name in admitted(rules[i].source).variables {
            if name in? solutions {
                let list=users.get(name set[])
                list.push(i) users[name]=list
            }
        }
    }
    # Hypotheses shrink: every defining body and incoming assignment must
    # establish a candidate. An unknown operation removes it, including in
    # a cycle. Positive effects remain the independent least fixed point.
    loop work.length >? 0 {
        let index=work.pop
        queued.pop(index default=index);
        $runtime_assert index <? rules.length
        let rule=rules[index]
        let actual=resolve_contracts(rule.source solutions)
        $runtime_assert actual isnt? none
        if rule.subjects isnt? none {actual=rows.instantiate(actual rule.subjects)}
        let behavior=admitted(actual)
        let atoms:array<rows.Atom>=[]
        loop atom in behavior.atoms {
            let covered=false
            loop bound in rule.covered.atoms {if rows.covers(bound atom) {covered=true break}}
            if not covered {atoms.push(atom)}
        }
        let variables:array<string>=[]
        loop name in behavior.variables {if name not in? rule.covered.variables {variables.push(name)}}
        let residual=rows.Contract[rows.Row[atoms variables behavior.unknown] actual.excluded]
        $runtime_assert rule.name in? solutions
        let previous=solutions[rule.name]
        let kept:array<rows.Atom>=[]
        loop atom in previous.excluded {if rows.implies(residual rows.Contract[excluded=[atom]]) {kept.push(atom)}}
        if kept.length =? previous.excluded.length continue
        solutions[rule.name]=rows.Contract[previous.allowed kept]
        loop user in users.get(rule.name set[]) {
            if user not in? queued {work.push(user) queued.push(user)}
        }
    }
    return solutions
}
satisfied_contracts=(constraint:Constraint solutions:dict<string rows.Contract>):>bool=>{
    return rows.implies(resolve_contracts(constraint.actual solutions) resolve_contracts(constraint.required solutions))
}

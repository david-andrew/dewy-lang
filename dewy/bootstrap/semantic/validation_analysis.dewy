from reporting import SrcFile, Error, Pointer, Warning
import p"analyze/storage_lifetimes.dewy" as storage_lifetimes
import p"analyze/public_effects.dewy" as public_effects
import p"analyze/effects.dewy" as effects
import p"analyze/place_contracts.dewy" as place_contracts
import p"module_state.dewy" as modules
import p"context.dewy" as contexts
import p"source_views.dewy" as sources
import p"hir.dewy" as hir
import p"proofs.dewy" as checked_proofs
import p"../targets.dewy" as targets
import p"validation_state.dewy" as proofs
import p"analyze/bounds.dewy" as bounds
import p"analyze/value_bounds.dewy" as values
import p"analyze/predicate_facts.dewy" as predicates
import p"analyze/relations.dewy" as relations
import p"analyze/fact_state.dewy" as facts
import p"analyze/expression_intervals.dewy" as intervals
import p"analyze/representation.dewy" as representation

# This boundary reads a frozen graph and returns decisions. It neither loads
# modules nor discharges witnesses, so the prelude loader can use it before
# entry checking without creating a loader/validation import cycle.
validate_module = (module:modules.Module source_files:array<SrcFile> env:values.Environment prepared:facts.Context word:addr prelude:dict<string addr> session:contexts.Session read_only:set<addr> | none=none):>proofs.Decision|Error => {
    let source=sources.srcfile(module.context session)
    let proof_error=checked_proofs.validate(module.root source session)
    if proof_error isnt? none return proof_error
    let data=predicates.Data[env relations.Context[prepared] intervals.Snapshot[] env.registry]
    let checker=bounds.Checker[data source word source_files=source_files]
    bounds.configure(@checker prepared)
    checker.data.links=session.links
    checker.prototype=module.options.prototype and not module.prelude
    bounds.validate(module.root @checker read_only=read_only)
    if checker.problem isnt? none return checker.problem
    let strict=module.prelude or module.no_prelude or 'BigInt' not in? prelude
    let unfit:dict<addr proofs.Unfit>=[]
    loop [id flag] in checker.unfit {
        if strict {
            let node=hir.node_at(env.nodes id)
            return Error[srcfile=source title="cannot prove this integer fits `{flag.word}`" pointers=[Pointer[span=node.loc message=representation.describe(flag.interval)]] hint='annotate a fixed width or establish its range with a comparison']
        }
        unfit[id]=proofs.Unfit[flag.interval flag.word]
    }
    return proofs.Decision[unfit checker.constant_indices checker.warnings checker.deferred_sites checker.word_iterators]
}

reusable = (saved:proofs.Prelude loaded:array<modules.Module> session:contexts.Session):>bool => {
    if saved.roots.length =? 0 or saved.roots.length not=? saved.decisions.length return false
    if saved.roots.length >? loaded.length return false
    if saved.nodes >? session.hir.length or saved.edits >? session.hir_edits.length return false
    loop index in 0.. and index <? saved.roots.length {
        $runtime_assert index <? loaded.length
        if not loaded[index].prelude or loaded[index].root not=? saved.roots[index] return false
    }
    # Appended user functions/generic instances are checked independently.
    # Any checking rewrite within the saved graph invalidates all saved
    # decisions. Speculative rollback restores both HIR and this edit log.
    let index=saved.edits
    loop index <? session.hir_edits.length {
        if session.hir_edits[index].id <? saved.nodes return false
        index+=1
    }
    return true
}

analyze = (word:addr loaded:array<modules.Module> prelude:dict<string addr> session:contexts.Session saved:proofs.Prelude?=none):>array<proofs.Decision>|Error => {
    let cached=saved
    if cached isnt? none and not reusable(cached loaded session) {cached=none}
    let source_files=sources.files(session)
    let roots:array<place_contracts.Root>=[]
    loop module in loaded {roots.push(place_contracts.Root[module.root module.context.source])}
    let place_error=place_contracts.validate(roots source_files session)
    if place_error isnt? none return place_error
    let lifetime_error=storage_lifetimes.validate(roots source_files session)
    if lifetime_error isnt? none return lifetime_error
    let env=values.Environment[session.hir session.types session.registry targets.max_length(session.target)]
    let prepared=bounds.prepare(env)
    let ids:array<addr>=[]
    loop module in loaded {ids.push(module.root)}
    let read_only=effects.read_only_places_in(ids session.hir session.types)
    let decisions:array<proofs.Decision>=[]
    loop index in 0.. and index <? loaded.length {
        if cached isnt? none and index <? cached.decisions.length {
            decisions.push(cached.decisions[index])
            continue
        }
        let checked=validate_module(loaded[index] source_files env prepared word prelude session read_only=read_only)
        if checked is? Error return checked
        decisions.push(checked)
    }
    # Infer direct-call effects across the complete loaded graph, including
    # imported helpers and unused source functions. Only checked advancing
    # edges authorize frame-word counters in allocation contracts.
    if loaded.length >? 0 {
        let word_iterators:set<addr>=set[]
        loop decision in decisions {loop id in decision.word_iterators {word_iterators.add(id)}}
        let effect_error=public_effects.validate(ids sources.srcfile(loaded[0].context session) session word_iterators)
        if effect_error isnt? none return effect_error
    }
    return decisions
}

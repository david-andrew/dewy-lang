from reporting import SrcFile, Error, Pointer, Warning, Span
import p"../targets.dewy" as targets
import p"../parser/t1.dewy" as tokens
import p"ty.dewy" as types
import p"hir.dewy" as hir
import p"bindings.dewy" as bindings
import p"brands.dewy" as brands
import p"subtyping.dewy" as subtyping
import p"builtins.dewy" as builtins
import p"syntax_normalization.dewy" as normalization
import p"key_facts.dewy" as keys

doc"""
Compilation-owned arenas and the lexical context of a semantic visit.

A source module keeps its own parser arena. Defaults and pending bodies
cross module boundaries by an interned SyntaxRef, not by an index borrowed
from whichever source is currently being checked. HIR and type identities
belong to the entire compilation. A Context is cheap to copy for a nested
scope; all allocations explicitly update the Session place.
"""

Source:type = const [srcfile:SrcFile nodes:array<tokens.Token>]
SyntaxRef:type = const [source:addr node:addr scope:addr]
Context:type = const [source:addr scope:addr refinement_subject:string?=none immutable_record:bool=false]
PendingBrandMatch:type = const [context:Context syntax:addr brand:string covered:set<string>]
PendingAlias:type = const [expression:SyntaxRef]
# Current read alternatives are separate from each binding's store contract.
# A branch copies this state; declaration/type/HIR identities remain shared.
ReturnSite:type = const [value_type:addr loc:Span]
ReturnCollector:type = [sites:array<ReturnSite>=[]]
ReadState:type = [types:dict<addr addr>=[] keys:array<keys.Fact>=[]]
ConstructorSet:type = [bindings:array<addr>=[]]
MethodEntry:type = const [binding:addr receiver_type:addr?=none place_self:bool=false lifecycle:string?=none]
LocalViewProbe:type = [prefix:addr used:bool=false]
CheckState:type = [
    # Checking collects diagnostics; the invocation decides how to render them.
    warnings:array<Warning>=[]
    pending_brand_matches:array<PendingBrandMatch>=[]
    read_states:array<ReadState>=[]
    retained_read_states:set<addr>=set[]
    # Literal membership of already evaluated container values. A later
    # operand may mutate their source binding without changing these copies.
    value_keys:dict<addr array<keys.Fact>>=[]
    return_collectors:array<ReturnCollector>=[]
    prepared_imports:set<addr>=set[]
    next_key_position:addr=0
    # Concrete generic bodies are module-level declarations, emitted once.
    hoisted:array<addr>=[]
    # Method identity includes the declaring type; structural equality must
    # not merge distinct bodies or defaults. Inherited entries reuse owners.
    constructors:dict<addr ConstructorSet>=[]
    methods:dict<string MethodEntry>=[]
    # Synthesized helpers and method implementations are module declarations,
    # but do not become source-facing namespace exports.
    hidden_bindings:set<addr>=set[]
    # The prelude's own `print`/`printl`: an interpolated output call is
    # streamed part by part only for these bindings, never for a name that
    # merely spells the same.
    prelude_outputs:set<addr>=set[]
    # Proof syntax is keyed by source arena, then function-body/marker node.
    # Speculative checking restores these along with ordinary declarations.
    proof_literals:dict<addr set<addr>>=[]
    proof_markers:dict<addr set<addr>>=[]
    unsafe_assertions:set<addr>=set[]
    object_strings:dict<addr addr>=[]
    preparing_methods:set<addr>=set[]
    prepared_methods:set<addr>=set[]
    registry:bindings.Registry=bindings.Registry[]
    scopes:array<bindings.Scope>=[]
    brands:brands.Registry=brands.Registry[]
    # Unit-like error mints are named primitive types, not object brands.
    error_types:set<addr>=set[]
    # Each session extends its own copy with the program's nominal links.
    links:subtyping.Graph=subtyping.default_links.copy
    builtin_aliases:dict<string addr>=[]
    pending_aliases:dict<addr PendingAlias>=[]
    resolving_aliases:set<addr>=set[]
    named_refs:dict<addr addr>=[]
    # Depth of loop-capture bodies being checked: `k -> v` at a value
    # position there is a pair, not an unsupported operator.
    capture_pairs:addr=0
    local_view_probes:array<LocalViewProbe>=[]
    local_place_roots:dict<addr addr>=[]
]
# Types and syntax references are interned append-only. HIR also appends,
# except for the few checking rewrites recorded below. A speculative parser
# reading therefore needs arena lengths and an undo position, not copies of
# every node compiled before it. All other mutable checking state is saved.
HirEdit:type = const [id:addr previous:hir.AST]
Session:type = CheckState & [
    target:targets.Target=$target sources:array<Source>=[]
    syntax_refs:array<SyntaxRef>=[] types:types.Table=types.Table[] hir:array<hir.AST>=[]
    hir_edits:array<HirEdit>=[]
    # Stable arena identities are indexed by source/node/scope. This index
    # belongs to the session, not a speculative CheckState snapshot; rollback
    # removes just the discarded suffix. Imported/preloaded references can
    # be indexed lazily without rebuilding a complete table on each lookup.
    syntax_ref_positions:dict<string addr>=[]
    syntax_refs_indexed:addr=0
]
Checkpoint:type = const [state:CheckState syntax_refs:addr types:addr hir:addr edits:addr]
# A checkpoint is an independent snapshot of the session's mutable state.
checkpoint = (session:Session):>Checkpoint => {
    let state=CheckState[
        local_place_roots=session.local_place_roots.copy
        local_view_probes=session.local_view_probes.copy
        warnings=session.warnings.copy
        pending_brand_matches=session.pending_brand_matches.copy
        read_states=session.read_states.copy
        retained_read_states=session.retained_read_states.copy
        value_keys=session.value_keys.copy
        return_collectors=session.return_collectors.copy
        prepared_imports=session.prepared_imports.copy
        next_key_position=session.next_key_position
        hoisted=session.hoisted.copy
        constructors=session.constructors.copy
        methods=session.methods.copy
        hidden_bindings=session.hidden_bindings.copy
        prelude_outputs=session.prelude_outputs.copy
        object_strings=session.object_strings.copy
        preparing_methods=session.preparing_methods.copy
        prepared_methods=session.prepared_methods.copy
        registry=session.registry.copy
        scopes=session.scopes.copy
        brands=session.brands.copy
        error_types=session.error_types.copy
        links=session.links.copy
        builtin_aliases=session.builtin_aliases.copy
        pending_aliases=session.pending_aliases.copy
        resolving_aliases=session.resolving_aliases.copy
        named_refs=session.named_refs.copy
        capture_pairs=session.capture_pairs
        proof_literals=session.proof_literals.copy
        proof_markers=session.proof_markers.copy
        unsafe_assertions=session.unsafe_assertions.copy
    ]
    return Checkpoint[state session.syntax_refs.length session.types.entries.length session.hir.length session.hir_edits.length]
}
# Every checking rewrite goes through here, including writes made by nested
# speculative readings. Later validation/representation passes run outside
# transactions and may rewrite their arenas directly.
replace_hir = (id:addr value:hir.AST @session:Session):>void => {
    $runtime_assert id <? session.hir.length
    session.hir_edits.push(HirEdit[id session.hir[id]])
    session.hir[id]=value
}
restore = (checkpoint:Checkpoint @session:Session):>void => {
    loop session.hir_edits.length >? 0 {
        if session.hir_edits.length <=? checkpoint.edits break
        let edit=session.hir_edits.pop
        $runtime_assert edit.id <? session.hir.length
        session.hir[edit.id]=edit.previous
    }
    session.hir.truncate(checkpoint.hir)
    types.truncate(@session.types checkpoint.types)
    let index=checkpoint.syntax_refs
    loop index <? session.syntax_refs.length {
        let reference=session.syntax_refs[index]
        let key=syntax_ref_key(reference.source reference.node reference.scope)
        if session.syntax_ref_positions.get(key) =? index {session.syntax_ref_positions.pop(key default=0);}
        index+=1
    }
    session.syntax_refs.truncate(checkpoint.syntax_refs)
    if session.syntax_refs_indexed >? session.syntax_refs.length {session.syntax_refs_indexed=session.syntax_refs.length}
    # One checkpoint may be restored more than once (each reading of an
    # ambiguous expression starts from it), so restoring copies its state.
    session.local_place_roots=checkpoint.state.local_place_roots.copy
    session.local_view_probes=checkpoint.state.local_view_probes.copy
    session.warnings=checkpoint.state.warnings.copy
    session.pending_brand_matches=checkpoint.state.pending_brand_matches.copy
    session.read_states=checkpoint.state.read_states.copy
    session.retained_read_states=checkpoint.state.retained_read_states.copy
    session.value_keys=checkpoint.state.value_keys.copy
    session.return_collectors=checkpoint.state.return_collectors.copy
    session.prepared_imports=checkpoint.state.prepared_imports.copy
    session.next_key_position=checkpoint.state.next_key_position
    session.hoisted=checkpoint.state.hoisted.copy
    session.constructors=checkpoint.state.constructors.copy
    session.methods=checkpoint.state.methods.copy
    session.hidden_bindings=checkpoint.state.hidden_bindings.copy
    session.object_strings=checkpoint.state.object_strings.copy
    session.preparing_methods=checkpoint.state.preparing_methods.copy
    session.prepared_methods=checkpoint.state.prepared_methods.copy
    session.registry=checkpoint.state.registry.copy
    session.scopes=checkpoint.state.scopes.copy
    session.brands=checkpoint.state.brands.copy
    session.error_types=checkpoint.state.error_types.copy
    session.links=checkpoint.state.links.copy
    session.builtin_aliases=checkpoint.state.builtin_aliases.copy
    session.pending_aliases=checkpoint.state.pending_aliases.copy
    session.resolving_aliases=checkpoint.state.resolving_aliases.copy
    session.named_refs=checkpoint.state.named_refs.copy
    session.capture_pairs=checkpoint.state.capture_pairs
    session.proof_literals=checkpoint.state.proof_literals.copy
    session.proof_markers=checkpoint.state.proof_markers.copy
    session.unsafe_assertions=checkpoint.state.unsafe_assertions.copy
}

# Branch environments live only while checking their enclosing flow/body.
# Generic declarations retain their defining environment for later instances;
# those ids remain stable, while finished nonescaping states release their
# facts. Keeping every historical branch made speculative snapshots grow with
# all previously checked functions rather than the current checking context.
release_read_states = (first:addr @session:Session):>void => {
    let stop=first
    let i=first
    loop i <? session.read_states.length {
        if i in? session.retained_read_states {stop=i+1}
        else {session.read_states[i]=ReadState[]}
        i+=1
    }
    session.read_states.truncate(stop)
}

source_at = (context:Context session:Session):>Source => {
    $runtime_assert context.source <? session.sources.length
    return session.sources[context.source]
}
node_at = (id:addr context:Context session:Session):>tokens.Token => {
    # Read one node through the arena. Returning a whole Source first would
    # copy its complete token forest merely to select this element.
    $runtime_assert context.source <? session.sources.length
    return tokens.node_at(session.sources[context.source].nodes id)
}
syntax_ref_key = (source:addr node:addr scope:addr):>string => "{source}:{node}:{scope}"
syntax_ref = (id:addr context:Context @session:Session):>addr => {
    loop session.syntax_refs_indexed <? session.syntax_refs.length {
        let index=session.syntax_refs_indexed
        let reference=session.syntax_refs[index]
        let key=syntax_ref_key(reference.source reference.node reference.scope)
        # Preserve the first identity even if a supplied arena contains the
        # same triple twice, matching the former linear search.
        if key not in? session.syntax_ref_positions {session.syntax_ref_positions[key]=index}
        session.syntax_refs_indexed+=1
    }
    let key=syntax_ref_key(context.source id context.scope)
    let known=session.syntax_ref_positions.get(key)
    if known isnt? none return known
    let reference = session.syntax_refs.length
    session.syntax_refs.push(SyntaxRef[context.source id context.scope])
    session.syntax_ref_positions[key]=reference
    session.syntax_refs_indexed=session.syntax_refs.length
    return reference
}
problem = (id:addr title:string message:string context:Context session:Session hint:string=''):>Error => {
    $runtime_assert context.source <? session.sources.length
    let node = node_at(id context session)
    # Build the nested pointer before entering Report's field scope: its
    # own default `message` must not hide this function's pointer message.
    let pointer = Pointer[span=node.loc message=message]
    return Error[srcfile=session.sources[context.source].srcfile title=title pointers=[pointer] hint=hint]
}
unsupported = (id:addr detail:string context:Context session:Session):>Error => problem(id 'native checker implementation pending' detail context session)
child = (context:Context @session:Session):>Context => {
    let scope = bindings.push_scope(@session.scopes context.scope)
    return Context[context.source scope context.refinement_subject context.immutable_record]
}
# A parsed text becomes one more source of the session: a module, or a
# compiler-synthesized helper checked in an existing scope.
add_source = (srcfile:SrcFile nodes:array<tokens.Token> @session:Session):>addr => {
    let source = session.sources.length
    session.sources.push(Source[srcfile normalization.prepare(nodes)])
    return source
}
begin = (srcfile:SrcFile nodes:array<tokens.Token> @session:Session):>Context => {
    let source = add_source(srcfile nodes @session)
    let scope = bindings.push_scope(@session.scopes none)
    if session.builtin_aliases.length =? 0 { session.builtin_aliases = builtins.type_aliases(@session.types) }
    return Context[source scope]
}

from reporting import SrcFile, Error, Pointer, Warning, Span
import p"../targets.dewy" as targets
import p"../parser/t1.dewy" as tokens
import p"ty.dewy" as types
import p"hir.dewy" as hir
import p"bindings.dewy" as bindings
import p"brands.dewy" as brands
import p"subtyping.dewy" as subtyping
import p"builtins.dewy" as builtins
import p"syntax_normalization.dewy" as normalization
import p"key_facts.dewy" as keys

doc"""
Compilation-owned arenas and the lexical context of a semantic visit.

A source module keeps its own parser arena. Defaults and pending bodies
cross module boundaries by an interned SyntaxRef, not by an index borrowed
from whichever source is currently being checked. HIR and type identities
belong to the entire compilation. A Context is cheap to copy for a nested
scope; all allocations explicitly update the Session place.
"""

Source:type = const [srcfile:SrcFile nodes:array<tokens.Token>]
SyntaxRef:type = const [source:addr node:addr scope:addr]
Context:type = const [source:addr scope:addr refinement_subject:string?=none immutable_record:bool=false]
PendingBrandMatch:type = const [context:Context syntax:addr brand:string covered:set<string>]
PendingAlias:type = const [expression:SyntaxRef]
# Current read alternatives are separate from each binding's store contract.
# A branch copies this state; declaration/type/HIR identities remain shared.
ReturnSite:type = const [value_type:addr loc:Span]
ReturnCollector:type = [sites:array<ReturnSite>=[]]
ReadState:type = [types:dict<addr addr>=[] keys:array<keys.Fact>=[]]
ConstructorSet:type = [bindings:array<addr>=[]]
MethodEntry:type = const [binding:addr receiver_type:addr?=none place_self:bool=false]
CheckState:type = [
    # Checking collects diagnostics; the invocation decides how to render them.
    warnings:array<Warning>=[]
    pending_brand_matches:array<PendingBrandMatch>=[]
    read_states:array<ReadState>=[]
    # Literal membership of already evaluated container values. A later
    # operand may mutate their source binding without changing these copies.
    value_keys:dict<addr array<keys.Fact>>=[]
    return_collectors:array<ReturnCollector>=[]
    prepared_imports:set<addr>=set[]
    next_key_position:addr=0
    syntax_refs:array<SyntaxRef>=[]
    types:array<types.Type>=[]
    hir:array<hir.AST>=[]
    # Concrete generic bodies are module-level declarations, emitted once.
    hoisted:array<addr>=[]
    # Method identity includes the declaring type; structural equality must
    # not merge distinct bodies or defaults. Inherited entries reuse owners.
    constructors:dict<addr ConstructorSet>=[]
    methods:dict<string MethodEntry>=[]
    method_bindings:set<addr>=set[]
    preparing_methods:set<addr>=set[]
    prepared_methods:set<addr>=set[]
    registry:bindings.Registry=bindings.Registry[]
    scopes:array<bindings.Scope>=[]
    brands:brands.Registry=brands.Registry[]
    # Unit-like error mints are named primitive types, not object brands.
    error_types:set<addr>=set[]
    links:array<subtyping.Link>=subtyping.default_links
    builtin_aliases:dict<string addr>=[]
    pending_aliases:dict<addr PendingAlias>=[]
    resolving_aliases:set<addr>=set[]
    named_refs:dict<addr addr>=[]
]
# Source forests are installed by the module loader, outside expression
# transactions. Checking can only read them. Keep that immutable catalog
# outside the copied state when trying alternative parser interpretations.
Session:type = CheckState & [target:targets.Target=$target sources:array<Source>=[]]
checkpoint = (session:Session):>CheckState => CheckState[
    warnings=session.warnings
    pending_brand_matches=session.pending_brand_matches
    read_states=session.read_states
    value_keys=session.value_keys
    return_collectors=session.return_collectors
    prepared_imports=session.prepared_imports
    next_key_position=session.next_key_position
    syntax_refs=session.syntax_refs
    types=session.types
    hir=session.hir
    hoisted=session.hoisted
    constructors=session.constructors
    methods=session.methods
    method_bindings=session.method_bindings
    preparing_methods=session.preparing_methods
    prepared_methods=session.prepared_methods
    registry=session.registry
    scopes=session.scopes
    brands=session.brands
    error_types=session.error_types
    links=session.links
    builtin_aliases=session.builtin_aliases
    pending_aliases=session.pending_aliases
    resolving_aliases=session.resolving_aliases
    named_refs=session.named_refs
]
restore = (snapshot:CheckState @session:Session):>void => {
    session.warnings=snapshot.warnings
    session.pending_brand_matches=snapshot.pending_brand_matches
    session.read_states=snapshot.read_states
    session.value_keys=snapshot.value_keys
    session.return_collectors=snapshot.return_collectors
    session.prepared_imports=snapshot.prepared_imports
    session.next_key_position=snapshot.next_key_position
    session.syntax_refs=snapshot.syntax_refs
    session.types=snapshot.types
    session.hir=snapshot.hir
    session.hoisted=snapshot.hoisted
    session.constructors=snapshot.constructors
    session.methods=snapshot.methods
    session.method_bindings=snapshot.method_bindings
    session.preparing_methods=snapshot.preparing_methods
    session.prepared_methods=snapshot.prepared_methods
    session.registry=snapshot.registry
    session.scopes=snapshot.scopes
    session.brands=snapshot.brands
    session.error_types=snapshot.error_types
    session.links=snapshot.links
    session.builtin_aliases=snapshot.builtin_aliases
    session.pending_aliases=snapshot.pending_aliases
    session.resolving_aliases=snapshot.resolving_aliases
    session.named_refs=snapshot.named_refs
}

source_at = (context:Context session:Session):>Source => {
    $runtime_assert context.source <? session.sources.length
    return session.sources[context.source]
}
node_at = (id:addr context:Context session:Session):>tokens.Token => {
    # Read one node through the arena. Returning a whole Source first would
    # copy its complete token forest merely to select this element.
    $runtime_assert context.source <? session.sources.length
    return tokens.node_at(session.sources[context.source].nodes id)
}
syntax_ref = (id:addr context:Context @session:Session):>addr => {
    loop i in 0.. and i <? session.syntax_refs.length {
        let reference = session.syntax_refs[i]
        if reference.source =? context.source and reference.node =? id and reference.scope =? context.scope return i
    }
    let reference = session.syntax_refs.length
    session.syntax_refs.push(SyntaxRef[context.source id context.scope])
    return reference
}
problem = (id:addr title:string message:string context:Context session:Session hint:string=''):>Error => {
    let source = source_at(context session)
    let node = tokens.node_at(source.nodes id)
    # Build the nested pointer before entering Report's field scope: its
    # own default `message` must not hide this function's pointer message.
    let pointer = Pointer[span=node.loc message=message]
    return Error[srcfile=source.srcfile title=title pointers=[pointer] hint=hint]
}
unsupported = (id:addr detail:string context:Context session:Session):>Error => problem(id 'native checker implementation pending' detail context session)
child = (context:Context @session:Session):>Context => {
    let scope = bindings.push_scope(@session.scopes context.scope)
    return Context[context.source scope context.refinement_subject context.immutable_record]
}
begin = (srcfile:SrcFile nodes:array<tokens.Token> @session:Session):>Context => {
    let source = session.sources.length
    session.sources.push(Source[srcfile normalization.prepare(nodes)])
    let scope = bindings.push_scope(@session.scopes none)
    if session.builtin_aliases.length =? 0 { session.builtin_aliases = builtins.type_aliases(@session.types) }
    return Context[source scope]
}

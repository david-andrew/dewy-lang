doc"""
Resolve source values into checked HIR. Type expressions share the same
lexical binding registry through type_check.dewy. Source, type, HIR, and
binding indices stay distinct even when their underlying word types agree.

This visitor establishes types and emits proof obligations; the analysis
passes must discharge those obligations before lowering. Successfully
building HIR alone does not authorize an unchecked native executable.

The current entry point accepts an already parsed module. Prelude/module
loading, representation selection, and the final validation/lowering driver
are separate work still needed by the compiler invocation.
"""

# Labels belong to lexical blocks, not the next written loop. Each loop
# records the index of its parent label scope. Branches retain this control
# context; a function starts a new one, even when it captures outer values.
LabelScope:type = const [labels:dict<string addr>=[]]
Control:type = const [scopes:array<LabelScope>=[] loops:array<addr?>=[] outer_labels:set<string>=set[]]
Environment:type = const [lexical:contexts.Context state:addr return_type:addr?=none control:Control=Control[] return_collector:addr?=none view_probe:addr?=none]
label_scope = (name:string control:Control):>addr? => {
    let index=control.scopes.length
    loop index >? 0 {
        index-=1
        if name in? control.scopes[index].labels return index
    }
    return none
}
function_control = (control:Control):>Control => {
    let names=control.outer_labels
    loop scope in control.scopes {loop [name position] in scope.labels {names.add(name)}}
    return Control[outer_labels=names]
}
collect_labels = (node:parser.Block env:Environment session:contexts.Session):>Control|Error => {
    let labels:dict<string addr>=[]
    loop id in node.inner {
        let item=contexts.node_at(id env.lexical session)
        if item isnt? parser.Atom continue
        let tag=contexts.node_at(item.item env.lexical session)
        if tag isnt? tokens.Metatag or tag.name in? ['test' 'proof'] continue
        if tag.name in? labels return problem(id "duplicate scope metatag `${tag.name}`" 'this scope already declares the name' env session)
        if label_scope(tag.name env.control) isnt? none return problem(id "scope metatag `${tag.name}` shadows an active declaration" 'metatag names may be reused only in disjoint sibling scopes' env session)
        labels[tag.name]=id
    }
    let scopes=env.control.scopes
    scopes.push(LabelScope[labels])
    return Control[scopes env.control.loops env.control.outer_labels]
}
loop_exit = (id:addr node:parser.KeywordExpr keyword:tokens.Keyword env:Environment @session:contexts.Session):>addr|Error => {
    let label:string?=none
    let target_scope:addr?=none
    if node.parts.length not=? 1 {
        if node.parts.length not=? 2 return problem(id 'invalid labeled loop exit' 'expected exactly one `$name` label' env session)
        let part=contexts.node_at(node.parts[1] env.lexical session)
        if part isnt? parser.Atom return problem(id 'invalid labeled loop exit' 'expected exactly one `$name` label' env session)
        let tag=contexts.node_at(part.item env.lexical session)
        if tag isnt? tokens.Metatag return problem(id 'invalid labeled loop exit' 'expected exactly one `$name` label' env session)
        label=tag.name
        target_scope=label_scope(label env.control)
        if target_scope is? none {
            if label in? env.control.outer_labels return problem(id "loop label `${label}` cannot cross a function boundary" 'this exit is in a nested function' env session)
            return problem(id "unknown loop label `${label}`" 'no visible scope declares this metatag' env session)
        }
    }
    if env.control.loops.length =? 0 return problem(id "`{keyword.name}` outside a loop" 'there is no enclosing loop to exit' env session)
    let levels:addr=0
    if target_scope isnt? none {
        let index=env.control.loops.length
        let found=false
        loop index >? 0 {
            index-=1
            if env.control.loops[index] =? target_scope {found=true break}
            levels+=1
        }
        if not found return problem(id "`${label}` does not label an enclosing loop" 'a labeled exit targets a loop whose parent lexical scope declares the metatag' env session)
    }
    let bottom=types.primitive('never' @session.types)
    return put(if keyword.name =? 'break' hir.Break[node.loc bottom label levels] else hir.Continue[node.loc bottom label levels] @session)
}
put = (node:hir.AST @session:contexts.Session):>addr => hir.append_node(@session.hir node)
node_at = (id:addr session:contexts.Session):>hir.AST => hir.node_at(session.hir id)
void_at = (id:addr env:Environment @session:contexts.Session):>addr => {
    let syntax = contexts.node_at(id env.lexical session)
    return put(hir.Void[syntax.loc types.primitive('void' @session.types)] @session)
}
problem = (id:addr title:string message:string env:Environment session:contexts.Session):>Error => contexts.problem(id title message env.lexical session)
pending = (id:addr detail:string env:Environment session:contexts.Session):>Error => contexts.unsupported(id detail env.lexical session)

# Proof markers annotate declarations before forward signatures are collected.
# Source/body arena identities survive checkpointing and native cache reloads.
is_proof_literal = (literal:parser.BinOp env:Environment session:contexts.Session):>bool => literal.right in? session.proof_literals.get(env.lexical.source set[])
is_proof_binding = (id:addr session:contexts.Session):>bool => {
    let node=node_at(id session)
    if node isnt? hir.ExpressedIdentifier or node.binding_id is? none return false
    return bindings.binding_at(session.registry node.binding_id).proof
}
collect_proof_annotations = (node:parser.Block env:Environment @session:contexts.Session):>Error? => {
    let marked=session.proof_literals.get(env.lexical.source set[])
    let markers=session.proof_markers.get(env.lexical.source set[])
    loop index in 0.. and index <? node.inner.length {
        let id=node.inner[index]
        let item=contexts.node_at(id env.lexical session)
        if item isnt? parser.Atom continue
        let tag=contexts.node_at(item.item env.lexical session)
        if tag isnt? tokens.Metatag or tag.name not=? 'proof' continue
        if index+1 >=? node.inner.length return problem(id '`$proof` must mark a function declaration' 'put it immediately before a named function declaration' env session)
        let declaration=contexts.node_at(node.inner[index+1] env.lexical session)
        if declaration is? parser.KeywordExpr and declaration.parts.length =? 2 {
            let keyword=contexts.node_at(declaration.parts[0] env.lexical session)
            if keyword is? tokens.Keyword and keyword.name in? ['let' 'const'] {declaration=contexts.node_at(declaration.parts[1] env.lexical session)}
        }
        if declaration isnt? parser.BinOp or source_views.symbol(declaration.op env.lexical session) not in? ['=' '::' ':='] return problem(id '`$proof` must mark a function declaration' 'expected a named function next' env session)
        let name=source_views.identifier(declaration.left env.lexical session)
        let literal=contexts.node_at(declaration.right env.lexical session)
        if name is? none or literal isnt? parser.BinOp or not source_views.is_operator(literal.op '=>' env.lexical session) return problem(id '`$proof` must mark a function declaration' 'expected a named function with a fact return contract next' env session)
        marked.add(literal.right)
        markers.add(id)
    }
    if markers.length >? 0 {
        session.proof_literals[env.lexical.source]=marked
        session.proof_markers[env.lexical.source]=markers
    }
    return none
}

# Builtins are ordinary stable bindings. A lexical declaration may shadow a
# source operator name; synthesized compiler helpers retain their own ids.
begin = (source:contexts.Context @session:contexts.Session inherited:dict<string addr>=[]):>Environment => {
    let definitions = builtins.definitions(@session.types)
    let loc = contexts.node_at(0 source session).loc
    loop [name value_type] in definitions {
        let binding_id = bindings.allocate(@session.registry none name 'function' loc)
        let binding = bindings.binding_at(session.registry binding_id)
        binding.value_type = value_type
        binding.builtin = true
        bindings.store_binding(@session.registry binding_id binding)
        bindings.bind(@session.scopes source.scope name binding_id)
    }
    # Builtins and prelude exports are outer bindings. Module declarations
    # can shadow either without replacing their shared declaration identity.
    let parent=source
    if inherited.length >? 0 {
        parent=contexts.child(parent @session)
        loop [name binding_id] in inherited {bindings.bind(@session.scopes parent.scope name binding_id)}
    }
    let lexical=contexts.child(parent @session)
    let state = session.read_states.length
    session.read_states.push(contexts.ReadState[])
    return Environment[lexical state]
}

# Conversion to a refinement adds an obligation, never an assumption. More
# specialized materializations (bigint, rational, quantities, protocol slots)
# will join this boundary rather than becoming per-expression exceptions.
carries_promises = (id:addr target:types.RefinedType session:contexts.Session):>bool => {
    let node=node_at(id session)
    if node is? hir.ValueCast|hir.RepresentationCast return carries_promises(node.expr target session)
    if node is? hir.Obligation return carries_promises(node.value target session)
    let plain=true
    loop promise in target.propositions {
        if promise.subject not=? 'self' or promise.projection not=? 'value' or promise.term isnt? none or promise.tested_type isnt? none or promise.when isnt? none or promise.axiom isnt? none {plain=false}
    }
    if not plain return false
    let constant=constant_integer(id session)
    if constant isnt? none {
        loop promise in target.propositions { if not propositions.holds(promise constant) return false }
        return true
    }
    let own=types.node_at(session.types node.value_type)
    if own is? types.RefinedType {
        let carried:set<string>=set[]
        loop p in own.propositions {carried.add(propositions.identity_key(p))}
        let all_carried=true
        loop promise in target.propositions { if propositions.identity_key(promise) not in? carried {all_carried=false break} }
        if all_carried return true
    }
    let members=types.node_at(session.types types.strip_refinement(node.value_type session.types))
    if members is? types.TypeOr and members.items.length >? 0 {
        let all_hold=true
        loop item in members.items {
            let literal=types.node_at(session.types item)
            if literal isnt? types.IntegerLiteralType {all_hold=false break}
            loop promise in target.propositions { if not propositions.holds(promise literal.value) {all_hold=false break} }
            if not all_hold break
        }
        if all_hold return true
    }
    if node is? hir.Block {
        if node.items.length =? 0 return false
        return carries_promises(node.items[node.items.length-1] target session)
    }
    if node is? hir.Flow {
        if node.default is? none return false
        loop arm_id in node.arms {
            let arm=node_at(arm_id session)
            if arm isnt? hir.IfArm|hir.LoopArm return false
            if not carries_promises(arm.body target session) return false
        }
        return carries_promises(node.default target session)
    }
    return false
}
against = (value:addr expected:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let checked=against_shape(value expected id env @session)
    if checked is? Error return checked
    if types.same_type(node_at(value session).value_type expected session.types) return checked
    let node=node_at(checked session)
    loop edge in effect_boundaries.constraints(node_at(value session).value_type expected session.types) {
        if edge.required isnt? none and (effect_inference.pending(edge.actual) or effect_inference.pending(edge.required)) {
            return put(hir.ValueCast[node.loc node.value_type checked effect_target=expected] @session)
        }
    }
    return checked
}
against_shape = (value:addr expected:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node = node_at(value session)
    if types.is_primitive(types.node_at(session.types node.value_type) 'never') return value
    if node is? hir.Block and not types.same_type(node.value_type expected session.types) {
        # Preserve statements around a value when numeric materialization
        # replaces that value with a constructor (even for a constant).
        let expressed:array<addr>=[]
        loop i in 0.. and i <? node.items.length {
            let type=types.node_at(session.types node_at(node.items[i] session).value_type)
            if not types.is_primitive(type 'void') and not types.is_primitive(type 'never') {expressed.push(i)}
        }
        if expressed.length =? 1 {
            let index=expressed[0]
            let checked=against(node.items[index] expected id env @session)
            if checked is? Error return checked
            let items=node.items
            items[index]=checked
            return put(hir.Block[node.loc node_at(checked session).value_type items node.scoped] @session)
        }
    }
    let target = types.node_at(session.types expected)
    if target is? types.MetaType and node is? hir.TypeValue return brand_value(node target expected id env @session)
    if target is? types.RefinedType {
        let total = views.total_dict_key(expected session.types)
        if total isnt? none {
            let error = prove_total(value total id env @session)
            if error isnt? none return error
            let checked=against(value target.base id env @session)
            if checked is? Error return checked
            # Rechecking an argument/element must not lose a guarantee this
            # boundary just established. The wrapper retains its value type.
            return put(hir.ValueCast[node.loc expected checked] @session)
        }
        let checked = against(value target.base id env @session)
        if checked is? Error return checked
        # A singleton value can discharge constant scalar promises here.
        # Preserve the checked expression (and its effects); unknown, field,
        # conditional, and relational promises still go to bounds analysis.
        let constant=constant_integer(checked session)
        if constant isnt? none {
            let proven=true
            loop promise in target.propositions {
                if promise.subject not=? 'self' or promise.projection not=? 'value' or promise.term isnt? none or promise.tested_type isnt? none or promise.when isnt? none or promise.axiom isnt? none {proven=false break}
                if not propositions.holds(promise constant) {proven=false break}
            }
            if proven return checked
        }
        # A value whose every alternative already establishes the promises
        # needs no obligation: a word narrowed by `is? Sign` to Sign's own
        # value set, a closed literal set, a constant, or a flow whose arms
        # each do. The hosted checker discharges these at the boundary too.
        if carries_promises(value target session) return checked
        return put(hir.Obligation[node.loc node_at(checked session).value_type checked expected display.type_to_dewy(expected session.types)] @session)
    }
    let inhabitant=unit_inhabitant(value expected id env @session)
    if inhabitant is? Error return inhabitant
    if inhabitant isnt? none return against(inhabitant expected id env @session)
    # A compile-time quantity (`45°`) materializes into the rational record
    # its parameter wants, keeping the dimension, as the hosted checker does.
    if target is? types.QuantityType {
        let actual_quantity=types.node_at(session.types node.value_type)
        if actual_quantity is? types.QuantityType and actual_quantity.dimension =? target.dimension {
            let literal=types.node_at(session.types types.strip_refinement(actual_quantity.number session.types))
            if literal is? types.IntegerLiteralType|types.RationalLiteralType and numeric_values.is_family(target.number 'Rational' env.lexical session) {
                let converted=to_rational(value true id env @session)
                if converted is? Error return converted
                return put(hir.ValueCast[node.loc expected converted] @session)
            }
        }
    }
    let word_rational=target is? types.ObjectType and numeric_values.is_family(expected 'Rational' env.lexical session)
    let big_rational=target is? types.ObjectType|types.TypeOr and numeric_values.is_family(expected 'BigRational' env.lexical session)
    if (word_rational or big_rational) and types.node_at(session.types node.value_type) is? types.IntegerLiteralType|types.RationalLiteralType {
        # Zero already inhabits the abstract rational's singleton alternative.
        # Let normal union materialization pack it rather than converting it
        # recursively through the same expectation.
        let constant=constant_integer(value session)
        if word_rational or constant isnt? 0 {
            let converted=to_rational(value word_rational id env @session)
            if converted is? Error return converted
            return against(converted expected id env @session)
        }
    }
    if target is? types.ObjectType and numeric_values.is_family(expected 'Fixed' env.lexical session) and not numeric_values.is_family(node.value_type 'Fixed' env.lexical session) {
        let source=types.node_at(session.types types.strip_refinement(node.value_type session.types))
        if source is? types.IntegerLiteralType|types.RationalLiteralType or numeric_values.is_family(node.value_type 'Rational' env.lexical session) or views.integer_valued(node.value_type session.types) {
            let converted=to_fixed(value id env @session)
            if converted is? Error return converted
            return against(converted expected id env @session)
        }
    }
    let materialized=union_bigint_materialization(value expected id env @session)
    if materialized is? Error return materialized
    if materialized isnt? none return materialized
    if numeric_values.is_family(node.value_type 'BigInt' env.lexical session) and not numeric_values.nonzero_form(node.value_type 'BigInt' env.lexical session) and numeric_values.nonzero_form(expected 'BigInt' env.lexical session) {
        let constant=constant_integer(value session)
        let proven=numeric_values.nonzero_form(stored_read_type(value @session) 'BigInt' env.lexical session)
        if proven or constant isnt? none and constant not=? 0 {
            # Contextual conversion may already have packed a known bigint
            # into its zero/object union. Its original nonzero type or literal
            # evidence still proves that alternative. Unwrap without
            # reevaluating or replacing the original expression.
            return put(hir.RepresentationCast[node.loc expected value] @session)
        }
    }
    if numeric_values.is_family(node.value_type 'BigInt' env.lexical session) and views.fixed_integer_layout(expected session.types) isnt? none {
        let layout=views.fixed_integer_layout(expected session.types)
        $runtime_assert layout isnt? none
        let result=library_call(if layout.signed '_bigint_to_int' else '_bigint_to_uint' [value] id env @session)
        if result is? Error return result
        let called=node_at(result session)
        $runtime_assert called is? hir.FunctionCall
        # Extracting low bits is authorized only after bounds validation has
        # proved the mathematical value fits. A user call to the same helper
        # does not acquire this compiler-generated proof obligation.
        let narrowed=put(hir.FunctionCall[called.loc called.value_type called.func called.pos_args called.kw_args called.selected_method_index 'narrow'] @session)
        return if types.same_type(called.value_type expected session.types) narrowed else put(hir.ValueCast[node.loc expected narrowed] @session)
    }
    if numeric_values.is_family(expected 'BigInt' env.lexical session) and not numeric_values.is_family(node.value_type 'BigInt' env.lexical session) {
        let constant=constant_integer(value session)
        let nonzero=numeric_values.nonzero_form(expected 'BigInt' env.lexical session)
        # Zero already inhabits the literal alternative. Let the ordinary
        # union path below pack it into a cell; returning a raw zero here
        # would pass a null pointer to a BigInt parameter.
        if constant isnt? none and constant not=? 0 {
            let declared=numeric_values.family('BigInt' env.lexical session)
            $runtime_assert declared isnt? none
            # Constructing the record is only the numeric conversion. The
            # destination may still require its tagged zero/record union.
            let converted=numeric_values.bigint_literal(constant declared node.loc @session)
            return against(converted expected id env @session)
        }
        if constant is? none and subtyping.is_subtype(node.value_type types.primitive('int' @session.types) session.links @session.types) {
            let layout=views.fixed_integer_layout(types.strip_refinement(node.value_type session.types) session.types)
            let unsigned=layout isnt? none and not layout.signed
            let helper=if unsigned (if nonzero '_bigint_from_uint_nonzero' else '_bigint_from_uint') else (if nonzero '_bigint_from_int_nonzero' else '_bigint_from_int')
            # Library helpers accept a full signed/unsigned word. Select that
            # representation explicitly before ordinary call dispatch; small
            # widths are not subtype edges, and unsigned widening must retain
            # the high bit. Value casts retain their source for bounds proofs.
            let word=against(value types.primitive(if unsigned 'uint64' else 'int64' @session.types) id env @session)
            if word is? Error return word
            let result=library_call(helper [word] id env @session)
            if result is? Error return result
            let call=node_at(result session)
            $runtime_assert call is? hir.FunctionCall
            return put(hir.FunctionCall[call.loc call.value_type call.func call.pos_args call.kw_args call.selected_method_index 'identity'] @session)
        }
    }
    if not subtyping.is_subtype(node.value_type expected session.links @session.types) {
        # A union with one available integer representation supplies that
        # context, just as a plain word or bigint expectation does. Convert
        # and prove its refinements before packing the union; subtyping alone
        # cannot materialize an abstract index into `addr | none`, or a word
        # into the combined zero/record/none alternatives of `bigint?`.
        if target is? types.TypeOr and views.integer_valued(node.value_type session.types) {
            let representations:array<addr>=[]
            loop member in target.items {
                if views.fixed_integer_layout(types.strip_refinement(member session.types) session.types) isnt? none {representations.push(member)}
            }
            let big=numeric_values.family('BigInt' env.lexical session)
            if big isnt? none and not types.same_type(big expected session.types) and subtyping.is_subtype(big expected session.links @session.types) {representations.push(big)}
            if representations.length =? 1 {
                let converted=against(value representations[0] id env @session)
                if converted is? Error return converted
                return put(hir.RepresentationCast[node.loc expected converted] @session)
            }
        }
        # Crossing fixed widths is a value conversion, not a subtype edge.
        # Preserve the cast for bounds analysis to prove (including signed
        # to unsigned and narrowing conversions); do not transmute the bits.
        if views.fixed_integer_layout(types.strip_refinement(node.value_type session.types) session.types) isnt? none and views.fixed_integer_layout(expected session.types) isnt? none return put(hir.ValueCast[node.loc expected value] @session)
        let promoted=dispatch.promote_type(types.strip_refinement(node.value_type session.types) expected dispatch.System[session.links builtins.promotions] @session.types)
        if promoted =? expected return put(hir.ValueCast[node.loc expected value] @session)
        return problem(id 'type mismatch' "`{display.type_to_dewy(node.value_type session.types)}` does not fit `{display.type_to_dewy(expected session.types)}`" env session)
    }
    if node.value_type =? expected return value
    let actual = types.node_at(session.types node.value_type)
    if actual is? types.BinaryLiteralType return put(hir.RepresentationCast[node.loc text_shapes.materialization_target(node.value_type expected @session.types) value] @session)
    if actual is? types.StringLiteralType and target is? types.ArrayType return put(hir.RepresentationCast[node.loc text_shapes.materialization_target(node.value_type expected @session.types) value] @session)
    if actual is? types.StringLiteralType and (target is? types.StringType or target is? types.Primitive and target.name in? ['string' 'char' 'grapheme']) return put(hir.RepresentationCast[node.loc expected value] @session)
    if actual is? types.ArrayType and target is? types.ArrayType and target.length is? none and actual.element =? target.element return value
    if actual is? types.FunctionType and target is? types.FunctionType return value
    if types.is_primitive(target 'any') return value
    # A value seen through the unbranded structure that carries its fields
    # still carries its nominal brand. The binding's annotation remains its
    # store contract; this read can retain the more specific value type.
    if actual is? types.ObjectType and target is? types.ObjectType and target.brand is? none return value
    # An abstract integer parameter does not materialize a new machine
    # representation. Keep singleton bounds for guards such as `i <? 3`.
    if actual is? types.IntegerLiteralType and (types.is_primitive(target 'int') or types.is_primitive(target 'uint')) return value
    if target is? types.TypeOr {
        if actual is? types.TypeOr return put(hir.RepresentationCast[node.loc expected value] @session)
        # A value already represented by one alternative needs only packing.
        # In particular, an exact-length array also fits a dynamic-length
        # alternative, but that does not make its existing representation
        # ambiguous. Keep it, as hosted checking does for subsumption.
        loop member in target.items {
            if types.same_type(node.value_type member session.types) return put(hir.RepresentationCast[node.loc expected value] @session)
        }
        let candidates:array<addr> = []
        loop member in target.items {
            if subtyping.is_subtype(node.value_type member session.links @session.types) { candidates.push(member) }
        }
        if candidates.length =? 0 and types.node_at(session.types views.structural_base(node.value_type session.types)) is? types.ObjectType {
            # The subtype proof above covers the union collectively. A parent
            # family can span disjoint descendant/exclusion alternatives;
            # packing selects its tag from the existing dynamic brand rather
            # than choosing a new value conversion here.
            let records=true
            loop member in target.items {
                if types.node_at(session.types views.structural_base(member session.types)) isnt? types.ObjectType {records=false}
            }
            if records return put(hir.RepresentationCast[node.loc expected value] @session)
        }
        if candidates.length not=? 1 return pending(id 'selecting among overlapping union materializations' env session)
        let inner = against(value candidates[0] id env @session)
        if inner is? Error return inner
        return put(hir.RepresentationCast[node.loc expected inner] @session)
    }
    if node is? hir.Integer return put(hir.Integer[node.loc expected node.prefix node.value] @session)
    return put(hir.ValueCast[node.loc expected value] @session)
}
# Subtyping alone cannot put a machine word into a bigint's limb record.
# Preserve the hosted union conversion without adding an overload preference:
# an already compatible word alternative keeps the source representation,
# and another numeric object alternative leaves the choice to dispatch.
union_bigint_materialization = (value:addr expected:addr id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let target=types.node_at(session.types expected)
    if target isnt? types.TypeOr or numeric_values.is_family(expected 'BigInt' env.lexical session) return none
    let node=node_at(value session)
    let payload=views.optional_payload(node.value_type @session.types)
    let source=if payload is? none node.value_type else payload
    if not views.integer_valued(source session.types) return none
    loop member in target.items {
        if views.integer_valued(member session.types) and subtyping.is_subtype(source member session.links @session.types) return none
    }
    let big=numeric_values.family('BigInt' env.lexical session)
    if big is? none return none
    let family=types.node_at(session.types big)
    let members:array<addr>=if family is? types.TypeOr family.items else [big]
    loop member in members {
        let found=false
        loop alternative in target.items {if types.same_type(member alternative session.types) {found=true break}}
        if not found return none
    }
    loop member in target.items {
        loop name in ['Rational' 'BigRational' 'Fixed'] {
            if numeric_values.is_family(member name env.lexical session) return none
        }
    }
    if payload is? none {
        let converted=against(value big id env @session)
        if converted is? Error return converted
        return put(hir.RepresentationCast[node.loc expected converted] @session)
    }
    let absent_type=types.primitive('none' @session.types)
    if not subtyping.is_subtype(absent_type expected session.links @session.types) return none
    # The hidden binding owns the one evaluation. Only the present branch
    # reads its payload and invokes the ordinary integer-to-bigint conversion.
    let saved=snapshot_value(value @session)
    let present=snapshot_read(saved.read payload @session)
    let converted=against(present big id env @session)
    if converted is? Error return converted
    # Native HIR makes union storage boundaries explicit. Both arms must
    # carry the destination's tags, including distinct none and bigint zero.
    let present_value=put(hir.RepresentationCast[node.loc expected converted] @session)
    let absent=put(hir.NoneValue[node.loc absent_type] @session)
    let absent_value=put(hir.RepresentationCast[node.loc expected absent] @session)
    let condition=put(hir.TypeTest[node.loc types.primitive('bool' @session.types) saved.read absent_type false] @session)
    let arm=put(hir.IfArm[node.loc expected condition absent_value] @session)
    let flow=put(hir.Flow[node.loc expected [arm] present_value] @session)
    return put(hir.Block[node.loc expected [saved.declaration flow] true] @session)
}

widen = (value:addr id:addr env:Environment @session:contexts.Session strings:bool=true abstract:bool=false):>addr|Error => {
    let node = node_at(value session)
    let type=types.node_at(session.types node.value_type)
    if type is? types.IntegerLiteralType {
        # An unannotated integer binding is the abstract `int`, as in the
        # hosted checker (`_widen_inferred_let_value`): representation
        # selection owns its storage choice (a word when the bounds analysis
        # proves every value fits, else a big integer); a source annotation
        # materializes it now. Container elements and record fields keep
        # their word representation.
        if abstract and node is? hir.Integer return put(hir.Integer[node.loc types.primitive('int' @session.types) node.prefix node.value] @session)
        if type.value <? -9223372036854775808 or type.value >? 9223372036854775807 {
            return put(hir.Integer[node.loc types.primitive('int' @session.types) '0d' type.value] @session)
        }
        return against(value types.primitive('int64' @session.types) id env @session)
    }
    if strings and type is? types.StringLiteralType return against(value types.primitive('string' @session.types) id env @session)
    if type is? types.RationalLiteralType {
        let family=numeric_values.family('BigRational' env.lexical session)
        if family is? none return problem(id 'rational values need the numeric prelude' 'no BigRational declaration is in scope' env session)
        return against(value family id env @session)
    }
    if type is? types.TypeAnd {
        # A negative branch fact is not a new mutable variable's store
        # contract. A copy keeps the family's structure and may later hold
        # the excluded descendant, just as a fresh hosted `let` can.
        let storage=views.structural_base(node.value_type session.types)
        if storage not=? node.value_type return against(value storage id env @session)
    }
    return value
}
binary_array = (value:addr @session:contexts.Session):>addr => {
    let node=node_at(value session)
    let type=types.node_at(session.types node.value_type)
    if type isnt? types.BinaryLiteralType return value
    let target=types.array_type(types.primitive('uint8' @session.types) type.value.length @session.types)
    return put(hir.RepresentationCast[node.loc target value] @session)
}
include_bytes = (arguments:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let items=source_arguments(arguments env session)
    if items.length not=? 1 return problem(id '`$include_bytes` takes one path' 'write `$include_bytes(p"...")`' env session)
    let value=expression(items[0] env @session)
    if value is? Error return value
    let path=path_values.literal(value session)
    if path is? none return problem(items[0] '`$include_bytes` needs a compile-time path' display.type_to_dewy(node_at(value session).value_type session.types) env session)
    let loc=contexts.node_at(id env.lexical session).loc
    let included=binary_literals.read_file(path source_views.srcfile(env.lexical session) loc)
    if included is? Error return included
    return put(hir.BasedString[loc types.binary_literal(included.packed.bytes @session.types) '0x' included.packed.digits included.packed.bytes included.path] @session)
}
include_declaration = (name:string value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    # Like the hosted include declaration, this creates a new binding even
    # when an earlier local used the same spelling. Earlier HIR keeps its id.
    let node=node_at(value session)
    let reference=contexts.syntax_ref(id env.lexical @session)
    let binding_id=bindings.allocate(@session.registry reference name 'value' node.loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=node.value_type binding.store_type=node.value_type
    let declaration=put(hir.Declare[node.loc types.primitive('void' @session.types) 'let' name node.value_type value binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    bindings.bind(@session.scopes env.lexical.scope name binding_id)
    return declaration
}
identifier = (name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let source = contexts.node_at(id env.lexical session)
    if name =? '..' return put(hir.Range[source.loc types.primitive('range' @session.types) none none none none] @session)
    if name =? 'none' return put(hir.NoneValue[source.loc types.primitive('none' @session.types)] @session)
    if name =? 'void' return void_at(id env @session)
    let binding_id = declarations.lookup(name env.lexical session)
    if binding_id isnt? none {
        let binding = bindings.binding_at(session.registry binding_id)
        if binding.kind =? 'effect' return problem(id 'an effect row is not a runtime value' 'use this parameter in a function effect contract' env session)
        if binding.replacement isnt? none return match_read(binding.replacement env @session)
        let value = binding.type_value
        if value is? none and binding_id in? session.pending_aliases {
            let resolved = declarations.resolve_alias(binding_id @session)
            if resolved is? Error return resolved
            value = resolved
        }
        if value isnt? none {
            if value is? addr and value in? session.error_types return put(hir.ErrorValue[source.loc value display.type_to_dewy(value session.types)] @session)
            return put(hir.TypeValue[source.loc types.primitive('type' @session.types) value name] @session)
        }
        if binding.value_type is? none return problem(id "cannot infer `{name}` before its declaration" 'add a type annotation to permit a forward reference' env session)
        let current = read_type(binding_id env session)
        $runtime_assert current isnt? none
        if types.node_at(session.types current) is? types.ModuleType return put(hir.ModuleNamespace[source.loc current name] @session)
        return put(hir.ExpressedIdentifier[source.loc current name binding_id] @session)
    }
    # Type spellings belong to the type visitor. A bare builtin type name
    # is not an implicitly declared runtime value in the hosted language.
    # In particular the primitive `end` must not make the index-local name
    # available outside that index. Explicit type aliases above are values.
    return problem(id "undefined name `{name}`" 'no declaration of this name is in scope' env session)
}

# Expected types serve two different purposes: selecting a call and checking
# its result. An umbrella like any supplies no inference information. For a
# builtin numeric operator, unions and materialized targets are result
# conversions, and a concrete operand width chooses the arithmetic width.
call_hint = (expected:addr? function:addr arguments:array<addr> env:Environment session:contexts.Session):>addr? => {
    if expected is? none return none
    let target=types.node_at(session.types expected)
    if target is? types.Primitive and target.name in? ['any' 'void' 'untyped'] return none
    let callee=node_at(function session)
    if callee isnt? hir.ExpressedIdentifier or callee.binding_id is? none return expected
    let binding=bindings.binding_at(session.registry callee.binding_id)
    if not binding.builtin return expected
    if callee.name not in? builtins.binary_operators.values and callee.name not in? builtins.prefix_operators.values and callee.name not in? builtins.inverted_comparisons.values return expected
    if target is? types.TypeOr return none
    let number=if target is? types.QuantityType target.number else expected
    if numeric_values.is_family(number 'Fixed' env.lexical session) or numeric_values.is_family(number 'Rational' env.lexical session) or numeric_values.is_family(number 'BigRational' env.lexical session) return none
    if views.fixed_integer_layout(number session.types) isnt? none {
        loop argument in arguments {
            let actual=types.strip_refinement(node_at(argument session).value_type session.types)
            let type=types.node_at(session.types actual)
            if views.fixed_integer_layout(actual session.types) isnt? none or type is? types.Primitive and type.name in? ['int' 'uint'] return none
        }
    }
    return expected
}

# Numeric conversions belong to the common value boundary. Runtime arithmetic
# uses the source library, including its overflow alternatives and nonzero
# parameter contracts; the compiler does not duplicate those algorithms.
to_rational = (value:addr word:bool id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node=node_at(value session)
    let name=if word 'Rational' else 'BigRational'
    let family=numeric_values.family(name env.lexical session)
    if family is? none return problem(id 'rational values need the numeric prelude' name env session)
    if numeric_values.is_family(node.value_type name env.lexical session) return value
    let constant=numeric_constants.value(value session)
    if constant isnt? none {
        if word and (constant.numerator <? -9223372036854775808 or constant.numerator >? 9223372036854775807 or constant.denominator >? 9223372036854775807) return problem(id 'rational constant does not fit rational<int64>' 'use the abstract rational with big-integer parts' env session)
        let big:addr?=none
        if not word {
            big=numeric_values.family('BigInt' env.lexical session)
            if big is? none return problem(id 'rational values need the numeric prelude' 'no BigInt declaration is in scope' env session)
        }
        return numeric_values.rational_literal(constant.numerator constant.denominator family big node.loc @session)
    }
    if numeric_values.is_family(node.value_type 'BigRational' env.lexical session) return problem(id 'an abstract rational cannot implicitly narrow to rational<int64>' 'keep both operands abstract or convert explicitly' env session)
    if not word and numeric_values.is_family(node.value_type 'Rational' env.lexical session) return library_call('_bigrational_from_rational' [value] id env @session)
    if not word and numeric_values.is_family(node.value_type 'BigInt' env.lexical session) return library_call('_bigrational_from_bigint' [value] id env @session)
    if not views.integer_valued(node.value_type session.types) return problem(id 'no rational conversion for this operand' display.type_to_dewy(node.value_type session.types) env session)
    let integer=against(value types.primitive('int64' @session.types) id env @session)
    if integer is? Error return integer
    return library_call(if word '_rational_from_int' else '_bigrational_from_int' [integer] id env @session)
}
# `base ^ exponent` over integers, rationals and dimensioned quantities, as
# in the hosted checker. Constant bases fold exactly (a negative exponent
# makes an integer base rational); runtime integer bases with a provably
# non-negative exponent call `_int_pow`; rational bases take any constant or
# runtime integer exponent through the rational prelude helpers.
pow_operation = (arguments:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    if arguments.length not=? 2 return none
    let base=arguments[0]
    let exponent=arguments[1]
    let loc=contexts.node_at(id env.lexical session).loc
    let exponent_type=node_at(exponent session).value_type
    if not views.integer_valued(exponent_type session.types) return problem(id 'exponent must be an integer' "this has type `{display.type_to_dewy(exponent_type session.types)}`" env session)
    let exponent_value=constant_integer(exponent session)
    let base_type=node_at(base session).value_type
    let number=numeric_constants.number_type(base session)
    let quantity=types.node_at(session.types base_type)
    let dimension:addr?=if quantity is? types.QuantityType quantity.dimension else none
    let dimensioned=dimension isnt? none and types.dimension_at(dimension session.types).powers.length >? 0
    if dimensioned and exponent_value is? none return problem(id 'a dimensioned quantity needs a constant exponent' 'the result dimension must be known at compile time' env session)
    if numeric_values.is_family(number 'Fixed' env.lexical session) return pending(id '`^` on fixed-point bases' env session)
    let unsigned_exponent=subtyping.is_subtype(exponent_type types.primitive('uint' @session.types) session.links @session.types)
    if numeric_values.is_family(number 'BigInt' env.lexical session) {
        if exponent_value isnt? none and exponent_value <? 0 return pending(id 'negative powers of big integers (rationals over big integers)' env session)
        if exponent_value is? none and not unsigned_exponent return problem(id 'integer exponent must be known to be non-negative' 'a negative exponent would make the result a rational' env session)
        let exponent64=against(exponent types.primitive('int64' @session.types) id env @session)
        if exponent64 is? Error return exponent64
        return library_call('_bigint_pow' [base exponent64] id env @session)
    }
    let shape=types.node_at(session.types types.strip_refinement(number session.types))
    let base_rational=shape is? types.RationalLiteralType or numeric_values.is_family(number 'Rational' env.lexical session) or numeric_values.is_family(number 'BigRational' env.lexical session)
    if not base_rational and not views.integer_valued(number session.types) return problem(id 'no matching overload for operator `^`' "this has type `{display.type_to_dewy(base_type session.types)}`; `^` raises integers and rationals to integer powers" env session)
    let base_value=numeric_constants.value(base session)
    if base_value isnt? none and exponent_value isnt? none {
        if base_value.numerator =? 0 and exponent_value <? 0 return problem(id 'division by zero' 'zero raised to a negative power' env session)
        let result_dimension:addr?=if dimension is? none none else types.power_dimension(dimension exponent_value @session.types)
        let magnitude=if exponent_value <? 0 (-exponent_value) else exponent_value
        let top:bigint=1
        let bottom:bigint=1
        # Exponentiation by squaring does logarithmic work in the exponent
        # (apart from the unavoidable cost of growing the exact result).
        # In particular, 0 and ±1 do not take exponent-sized loops.
        let remaining=magnitude
        let numerator:bigint=base_value.numerator
        let denominator:bigint=base_value.denominator
        loop remaining >? 0 {
            if remaining % 2 not=? 0 {top=top*numerator bottom=bottom*denominator}
            remaining=remaining // 2
            if remaining >? 0 {numerator=numerator*numerator denominator=denominator*denominator}
        }
        if exponent_value <? 0 {
            let swapped=top
            top=bottom
            bottom=swapped
            if bottom <? 0 {top=-top bottom=-bottom}
        }
        if not base_rational and exponent_value >=? 0 {
            let integer_type=types.integer_literal(top @session.types)
            if dimensioned {
                $runtime_assert result_dimension isnt? none
                integer_type=types.quantity_type(integer_type result_dimension @session.types)
            }
            return put(hir.Integer[loc integer_type '0d' top] @session)
        }
        let folded=numeric_constants.fraction(top bottom)
        let type=types.rational_literal(folded.numerator folded.denominator @session.types)
        let normalized=types.node_at(session.types type)
        $runtime_assert normalized is? types.RationalLiteralType
        let result_type=type
        if dimensioned {
            $runtime_assert result_dimension isnt? none
            result_type=types.quantity_type(type result_dimension @session.types)
        }
        return put(hir.RationalConstant[loc result_type normalized.numerator normalized.denominator] @session)
    }
    if dimensioned return pending(id 'runtime quantity arithmetic materialization' env session)
    let exponent64=against(exponent types.primitive('int64' @session.types) id env @session)
    if exponent64 is? Error return exponent64
    if base_rational or (exponent_value isnt? none and exponent_value <? 0) {
        let word=numeric_values.is_family(number 'Rational' env.lexical session)
        let prefix=if word '_rational' else '_bigrational'
        let helper=if exponent_value isnt? none and exponent_value <? 0 "{prefix}_pow_negative" else "{prefix}_pow"
        let operand=to_rational(base word id env @session)
        if operand is? Error return operand
        return library_call(helper [operand exponent64] id env @session)
    }
    if exponent_value is? none and not unsigned_exponent return problem(id 'integer exponent must be known to be non-negative' 'a negative exponent would make the result a rational; use an unsigned exponent, or make the base a rational' env session)
    let integer=against(base types.primitive('int64' @session.types) id env @session)
    if integer is? Error return integer
    return library_call('_int_pow' [integer exponent64] id env @session)
}
# A compile-time number as a fixed value: the raw Q32.32 word, rounded to
# nearest, as a `Fixed` record literal (the constant raw is then a fact).
fixed_constant = (top:bigint bottom:bigint id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let family=numeric_values.family('Fixed' env.lexical session)
    if family is? none return problem(id 'fixed-point values need the numeric prelude' 'Fixed' env session)
    let divisor:bigint=2*bottom
    if divisor <=? 0 return problem(id 'value is outside the fixed-point range' 'a fixed constant needs a positive denominator' env session)
    $runtime_assert divisor not=? 0
    let numerator:bigint=if top <? 0 (-top) else top
    let magnitude:bigint=(2*numerator*4294967296 + bottom) // divisor
    let raw:bigint=if top <? 0 (-magnitude) else magnitude
    if raw <? -9223372036854775808 or raw >? 9223372036854775807 return problem(id 'value is outside the fixed-point range' 'this constant does not fit Q32.32' env session)
    let loc=contexts.node_at(id env.lexical session).loc
    let word=put(hir.Integer[loc types.integer_literal(raw @session.types) '0d' raw] @session)
    return put(hir.ObjectLiteral[loc numeric_values.object_member(family session.types) [hir.ObjectField[loc 'raw' word]]] @session)
}
# A value as its number (the dimension dropped) for a prelude helper call.
strip_dimension = (value:addr @session:contexts.Session):>addr => {
    let node=node_at(value session)
    let type=types.node_at(session.types node.value_type)
    if type isnt? types.QuantityType return value
    return put(hir.ValueCast[node.loc type.number value] @session)
}
# An operand as a runtime `Fixed`: constants and rationals convert, as in
# the hosted checker's `_to_fixed`.
to_fixed = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let number=numeric_constants.number_type(value session)
    if numeric_values.is_family(number 'Fixed' env.lexical session) return strip_dimension(value @session)
    let constant=numeric_constants.value(value session)
    if constant isnt? none return fixed_constant(constant.numerator constant.denominator id env @session)
    if numeric_values.is_family(number 'Rational' env.lexical session) return library_call('_fixed_from_rational' [strip_dimension(value @session)] id env @session)
    if numeric_values.is_family(number 'BigRational' env.lexical session) return problem(id 'a runtime `rational` in fixed-point arithmetic' 'its big-integer parts may not fit the fixed representation; convert it first with `let f:fixed = q`' env session)
    if not views.integer_valued(number session.types) return problem(id 'no fixed-point conversion for this operand' display.type_to_dewy(node_at(value session).value_type session.types) env session)
    let integer=against(strip_dimension(value @session) types.primitive('int64' @session.types) id env @session)
    if integer is? Error return integer
    return library_call('_fixed_from_int' [integer] id env @session)
}
const fixed_binary:dict<string string>=[
    '__add__'->'_fixed_add' '__sub__'->'_fixed_sub' '__mul__'->'_fixed_mul' '__truediv__'->'_fixed_div'
    '__eq__'->'_fixed_eq' '__ne__'->'_fixed_ne' '__lt__'->'_fixed_lt' '__le__'->'_fixed_le' '__gt__'->'_fixed_gt' '__ge__'->'_fixed_ge'
]
# Operations with a fixed operand: fixed absorbs integers and rationals, and
# a dimensioned result keeps its dimension, as in the hosted checker.
fixed_operation = (name:string arguments:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let fixed=false
    loop argument in arguments {
        if numeric_values.is_family(numeric_constants.number_type(argument session) 'Fixed' env.lexical session) {fixed=true}
    }
    if not fixed return none
    let dimension=numeric_constants.result_dimension(name arguments @session)
    if dimension is? string return problem(id dimension 'only quantities of the same dimension add, subtract, or compare' env session)
    let family=numeric_values.family('Fixed' env.lexical session)
    if family is? none return problem(id 'fixed-point values need the numeric prelude' 'Fixed' env session)
    let loc=contexts.node_at(id env.lexical session).loc
    let dimensioned=dimension isnt? none and types.dimension_at(dimension session.types).powers.length >? 0
    if name =? '__unary_sub__' and arguments.length =? 1 {
        let operand=to_fixed(arguments[0] id env @session)
        if operand is? Error return operand
        let negated=library_call('_fixed_neg' [operand] id env @session)
        if negated is? Error return negated
        if not dimensioned return negated
        $runtime_assert dimension isnt? none
        return put(hir.ValueCast[loc types.quantity_type(node_at(negated session).value_type dimension @session.types) negated] @session)
    }
    let helper=fixed_binary.get(name)
    if helper is? none or arguments.length not=? 2 return problem(id 'operator is not defined for fixed-point values' 'fixed supports `+ - * /`, negation, and comparisons' env session)
    if name =? '__truediv__' {
        let constant=numeric_constants.value(arguments[1] session)
        if constant isnt? none and constant.numerator =? 0 return problem(id 'division by zero' 'the divisor is the constant `0`' env session)
    }
    let operands:array<addr>=[]
    loop argument in arguments {
        let converted=to_fixed(argument id env @session)
        if converted is? Error return converted
        operands.push(converted)
    }
    let call=library_call(helper operands id env @session)
    if call is? Error return call
    if name in? ['__eq__' '__ne__' '__lt__' '__le__' '__gt__' '__ge__'] or not dimensioned return call
    $runtime_assert dimension isnt? none
    return put(hir.ValueCast[loc types.quantity_type(node_at(call session).value_type dimension @session.types) call] @session)
}
rational_operation = (name:string arguments:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let word=false
    let big=false
    let literal=false
    loop argument in arguments {
        let type=node_at(argument session).value_type
        let shape=types.node_at(session.types types.strip_refinement(type session.types))
        if shape is? types.RationalLiteralType {literal=true}
        if shape is? types.ObjectType|types.TypeOr {
            if numeric_values.is_family(type 'Rational' env.lexical session) {word=true}
            if numeric_values.is_family(type 'BigRational' env.lexical session) {big=true}
        }
    }
    let division=name =? '__truediv__' and arguments.length =? 2
    if not word and not big and not literal and not division return none
    let operation=numeric_values.rational_binary.get(name)
    if name =? '__unary_sub__' and arguments.length =? 1 {operation='neg'}
    else if arguments.length not=? 2 {operation=none}
    if operation is? none return problem(id 'operator is not defined for rationals' name env session)
    if big {word=false}
    if division and not word and not big and not literal {
        let integers=false
        loop argument in arguments {if numeric_values.is_family(node_at(argument session).value_type 'BigInt' env.lexical session) {integers=true}}
        if integers return library_call('_bigrational_make' arguments id env @session)
        let operands:array<addr>=[]
        loop argument in arguments {
            let converted=against(argument types.primitive('int64' @session.types) id env @session)
            if converted is? Error return converted
            operands.push(converted)
        }
        let made=library_call('_rational_make' operands id env @session)
        if made is? Error return made
        return library_call('_bigrational_from_rational' [made] id env @session)
    }
    if name =? '__truediv__' and arguments.length =? 2 and not word {
        let divisor=arguments[1]
        let constant=numeric_constants.value(divisor session)
        if constant isnt? none and constant.numerator =? 0 return problem(id 'division by zero' 'the rational divisor is zero' env session)
        let type=stored_read_type(divisor @session)
        if constant is? none and numeric_values.is_family(type 'BigRational' env.lexical session) and not numeric_values.nonzero_form(type 'BigRational' env.lexical session) return problem(id 'cannot prove the divisor is nonzero' 'guard the division or take a nonzero divisor' env session)
    }
    let operands:array<addr>=[]
    loop argument in arguments {
        let converted=to_rational(argument word id env @session)
        if converted is? Error return converted
        operands.push(converted)
    }
    return library_call("{if word '_rational_' else '_bigrational_'}{operation}" operands id env @session)
}

# Explicit bigint operands already have their representation. Route their
# operators to the same prelude helpers used by late representation selection,
# widening word operands at the ordinary argument conversion boundary.
bigint_operation = (name:string arguments:array<addr> expected:addr? id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let family=numeric_values.family('BigInt' env.lexical session)
    if family is? none return none
    let selected=expected isnt? none and numeric_values.is_family(expected 'BigInt' env.lexical session)
    loop argument in arguments {
        if numeric_values.is_family(node_at(argument session).value_type 'BigInt' env.lexical session) {selected=true}
        let constant=constant_integer(argument session)
        if constant isnt? none and (constant <? -9223372036854775808 or constant >? 18446744073709551615) {selected=true}
    }
    if not selected return none
    if name =? '__unary_sub__' and arguments.length =? 1 {
        let constant=constant_integer(arguments[0] session)
        if constant isnt? none {
            let negated=-constant
            let loc=contexts.node_at(id env.lexical session).loc
            if negated >=? -9223372036854775808 and negated <=? 9223372036854775807 and not (expected isnt? none and numeric_values.is_family(expected 'BigInt' env.lexical session)) {
                return put(hir.Integer[loc types.integer_literal(negated @session.types) '0d' negated] @session)
            }
            return numeric_values.bigint_literal(negated family loc @session)
        }
    }
    if name =? '__truediv__' return none  # exact division is handled by rational_operation
    let helper=numeric_values.bigint_binary.get(name)
    if name =? '__unary_sub__' and arguments.length =? 1 {helper='_bigint_neg'}
    else if arguments.length not=? 2 {helper=none}
    if helper is? none return problem(id 'operator is not defined for big integers' name env session)
    let operands:array<addr>=[]
    loop i in 0.. and i <? arguments.length {
        let target=family
        if i =? 1 and name in? ['__floordiv__' '__mod__'] {
            let constant=constant_integer(arguments[i] session)
            if constant =? 0 return problem(id 'division by zero' 'the divisor is the constant `0`' env session)
            # A contextual union pack changes the ABI, not the divisor's
            # established nonzero fact. Actual conversions retain their
            # result type through this same provenance query.
            let type=stored_read_type(arguments[i] @session)
            if constant is? none and numeric_values.is_family(type 'BigInt' env.lexical session) and not numeric_values.nonzero_form(type 'BigInt' env.lexical session) return problem(id 'cannot prove the divisor is nonzero' 'guard the division or take a nonzero divisor' env session)
            target=numeric_values.object_member(family session.types)
        }
        let operand=against(arguments[i] target id env @session)
        if operand is? Error return operand
        operands.push(operand)
    }
    let result=library_call(helper operands id env @session)
    if result is? Error return result
    let called=node_at(result session)
    $runtime_assert called is? hir.FunctionCall
    return put(hir.FunctionCall[called.loc called.value_type called.func called.pos_args called.kw_args called.selected_method_index name] @session)
}

# Capture an expression once for a conditional conversion or equality.
# Equality first evaluates both operands, then selects a payload comparison
# through ordinary typed short-circuit branches. A simple binding can keep
# its identity so the condition also narrows it; effectful operands need
# hidden snapshots in source order, even when their tags will differ.
SnapshotValue:type = const [declaration:addr read:addr]
snapshot_value = (value:addr @session:contexts.Session):>SnapshotValue => {
    let node=node_at(value session)
    let name="__dewy_snapshot_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' node.loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=node.value_type binding.store_type=node.value_type
    let declaration=put(hir.Declare[node.loc types.primitive('void' @session.types) 'let' name node.value_type value binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    return SnapshotValue[declaration put(hir.ExpressedIdentifier[node.loc node.value_type name binding_id] @session)]
}
snapshot_read = (value:addr member:addr @session:contexts.Session):>addr => {
    let node=node_at(value session)
    $runtime_assert node is? hir.ExpressedIdentifier
    return put(hir.ExpressedIdentifier[node.loc member node.name node.binding_id] @session)
}
union_equality = (function:addr arguments:array<addr> negated:bool id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    $runtime_assert arguments.length =? 2
    let loc=contexts.node_at(id env.lexical session).loc
    let boolean=types.primitive('bool' @session.types)
    loop index in 0..1 {
        let value=arguments[index]
        let other=arguments[1-index]
        let union_id=types.unfold(types.strip_refinement(node_at(value session).value_type session.types) session.types)
        let union=types.node_at(session.types union_id)
        if union isnt? types.TypeOr continue
        if views.optional_payload(union_id @session.types) is? none and views.runtime_union_members(union_id @session.types) is? none continue
        let other_type=types.unfold(types.strip_refinement(node_at(other session).value_type session.types) session.types)
        let other_node=types.node_at(session.types other_type)
        if types.is_primitive(other_node 'none') {
            if node_at(other session) is? hir.NoneValue return put(hir.TypeTest[loc boolean value other_type negated] @session)
            let left=snapshot_value(arguments[0] @session)
            let right=snapshot_value(arguments[1] @session)
            let test=put(hir.TypeTest[loc boolean if index =? 0 left.read else right.read other_type negated] @session)
            return put(hir.Block[loc boolean [left.declaration right.declaration test] false] @session)
        }
        if other_node is? types.TypeOr {
            let left_type=views.strip_all_refinements(union_id @session.types)
            let right_type=views.strip_all_refinements(other_type @session.types)
            let left_members=types.node_at(session.types left_type)
            let right_members=types.node_at(session.types right_type)
            $runtime_assert left_members is? types.TypeOr and right_members is? types.TypeOr
            let matching=left_members.items.length =? right_members.items.length
            loop member in left_members.items {if not types.contains_type(right_members.items member session.types) {matching=false}}
            if not matching return pending(id 'equality between unions with different alternatives (narrow one side with `is?` first)' env session)
            let left=snapshot_value(arguments[0] @session)
            let right=snapshot_value(arguments[1] @session)
            let combined:addr?=none
            loop member in left_members.items {
                let left_test=put(hir.TypeTest[loc boolean left.read member negated] @session)
                let right_test=put(hir.TypeTest[loc boolean right.read member negated] @session)
                let branch=put(hir.ShortCircuit[loc boolean if negated 'or' else 'and' left_test right_test] @session)
                if not types.is_primitive(types.node_at(session.types member) 'none') and member not in? session.error_types {
                    let a=snapshot_read(left.read member @session)
                    let b=snapshot_read(right.read member @session)
                    let payload=call(function [a b] [] id env @session)
                    if payload is? Error return payload
                    branch=put(hir.ShortCircuit[loc boolean if negated 'or' else 'and' branch payload] @session)
                }
                combined=if combined is? none branch else put(hir.ShortCircuit[loc boolean if negated 'and' else 'or' combined branch] @session)
            }
            $runtime_assert combined isnt? none
            return put(hir.Block[loc boolean [left.declaration right.declaration combined] false] @session)
        }
        let members:array<addr>=[]
        loop member in union.items {
            if not types.is_primitive(types.node_at(session.types member) 'none') and subtyping.is_subtype(other_type member session.links @session.types) {members.push(member)}
        }
        if members.length =? 0 continue
        if members.length >? 1 return problem(id 'ambiguous equality against a union' 'narrow the union with `is?` first' env session)
        let member=members[0]
        let tested=value
        let prefix:array<addr>=[]
        let simple=node_at(value session) is? hir.ExpressedIdentifier
        loop argument in arguments {if node_at(argument session) isnt? hir.ExpressedIdentifier|hir.Integer|hir.Bool|hir.String|hir.NoneValue {simple=false}}
        if not simple {
            let left=snapshot_value(arguments[0] @session)
            let right=snapshot_value(arguments[1] @session)
            prefix=[left.declaration right.declaration]
            tested=if index =? 0 left.read else right.read
            other=if index =? 0 right.read else left.read
        }
        let narrowed=snapshot_read(tested member @session)
        let payload=call(function [narrowed other] [] id env @session)
        if payload is? Error return payload
        let test=put(hir.TypeTest[loc boolean tested member negated] @session)
        let comparison=put(hir.ShortCircuit[loc boolean if negated 'or' else 'and' test payload] @session)
        if prefix.length =? 0 return comparison
        prefix.push(comparison)
        return put(hir.Block[loc boolean prefix false] @session)
    }
    return none
}

# Assignment facts may narrow an optional binding all the way to none.
# If ordinary dispatch then fails, its declared union still supplies tagged
# equality. Restore that storage view only for this comparison, preserving
# ordinary operators on successfully dispatched narrowed payloads.
stored_union_equality = (function:addr arguments:array<addr> negated:bool id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let restored:array<addr>=[]
    let changed=false
    loop argument in arguments {
        let value=node_at(argument session)
        let replacement=argument
        if value is? hir.ExpressedIdentifier and value.binding_id isnt? none {
            let binding=bindings.binding_at(session.registry value.binding_id)
            let stored=if binding.store_type is? none binding.value_type else binding.store_type
            if stored isnt? none and types.node_at(session.types types.unfold(types.strip_refinement(value.value_type session.types) session.types)) isnt? types.TypeOr and types.node_at(session.types types.unfold(types.strip_refinement(stored session.types) session.types)) is? types.TypeOr and subtyping.is_subtype(value.value_type stored session.links @session.types) {
                replacement=put(hir.ExpressedIdentifier[value.loc stored value.name value.binding_id] @session)
                changed=true
            }
        }
        restored.push(replacement)
    }
    return if changed union_equality(function restored negated id env @session) else none
}

call = (function:addr positional:array<addr> keyword:dict<string addr> id:addr env:Environment @session:contexts.Session expected:addr?=none order:array<string?>=[]):>addr|Error => {
    let func = node_at(function session)
    if func is? hir.ExpressedIdentifier and func.binding_id isnt? none {
        let binding=bindings.binding_at(session.registry func.binding_id)
        let builtin=binding.builtin
        if builtin and (func.name in? builtins.binary_operators.values or func.name in? builtins.prefix_operators.values or func.name in? builtins.inverted_comparisons.values) {
            # A finite integer set is not closed under arithmetic. Decode its
            # physical tag before selecting the ordinary numeric operation.
            loop i in 0.. and i <? positional.length {
                let value=positional[i]
                let members=views.enum_members(node_at(value session).value_type session.types)
                if members is? none continue
                let integers=true
                let fits=true
                loop member in members {
                    let type=types.node_at(session.types member)
                    if type isnt? types.IntegerLiteralType {integers=false break}
                    if type.value <? -9223372036854775808 or type.value >? 9223372036854775807 {fits=false}
                }
                if not integers continue
                if not fits return pending(id 'arithmetic on literal enums wider than an integer word' env session)
                let converted=against(value types.primitive('int64' @session.types) id env @session)
                if converted is? Error return converted
                positional[i]=converted
            }
        }
    }
    if keyword.length =? 0 {
        if positional.length =? 2 and func is? hir.ExpressedIdentifier and func.binding_id isnt? none and func.name in? ['__eq__' '__ne__'] and bindings.binding_at(session.registry func.binding_id).builtin {
            let compared=metatype_equality(function positional func.name =? '__ne__' id env @session)
            if compared is? Error return compared
            if compared isnt? none return if expected is? none compared else against(compared expected id env @session)
        }
        let specialized=builtin_value(function positional id env @session)
        if specialized is? Error return specialized
        if specialized isnt? none return if expected is? none specialized else against(specialized expected id env @session)
        if func is? hir.ExpressedIdentifier and func.binding_id isnt? none and bindings.binding_at(session.registry func.binding_id).builtin and (func.name in? builtins.binary_operators.values or func.name in? builtins.prefix_operators.values or func.name in? builtins.inverted_comparisons.values) {
            if func.name =? '__pow__' {
                let powered=pow_operation(positional id env @session)
                if powered is? Error return powered
                if powered isnt? none return if expected is? none powered else against(powered expected id env @session)
            }
            let fixed=fixed_operation(func.name positional id env @session)
            if fixed is? Error return fixed
            if fixed isnt? none return if expected is? none fixed else against(fixed expected id env @session)
            let rational=rational_operation(func.name positional id env @session)
            if rational is? Error return rational
            if rational isnt? none return if expected is? none rational else against(rational expected id env @session)
            let numeric=bigint_operation(func.name positional expected id env @session)
            if numeric is? Error return numeric
            if numeric isnt? none return if expected is? none numeric else against(numeric expected id env @session)
            if func.name in? ['__eq__' '__ne__'] and positional.length =? 2 {
                let equality=union_equality(function positional func.name =? '__ne__' id env @session)
                if equality is? Error return equality
                if equality isnt? none return if expected is? none equality else against(equality expected id env @session)
            }
            if func.name in? ['__lt__' '__le__' '__gt__' '__ge__' '__eq__' '__ne__'] and positional.length =? 2 {
                let left=types.strip_refinement(node_at(positional[0] session).value_type session.types)
                let right=types.strip_refinement(node_at(positional[1] session).value_type session.types)
                if left not=? right and views.fixed_integer_layout(left session.types) isnt? none and views.fixed_integer_layout(right session.types) isnt? none {
                    # Comparisons use the left operand's representation, as
                    # in the hosted checker. This is a checked value cast:
                    # bounds analysis must prove the right operand fits,
                    # including signedness and narrowing, before lowering.
                    let converted=against(positional[1] left id env @session)
                    if converted is? Error return converted
                    positional[1]=converted
                }
            }
        }
    }
    if func is? hir.BoundMethod {
        let arguments:array<addr>=[]
        if func.receiver isnt? none {
            let signature=dispatch.method_at(session.types node_at(func.function session).value_type)
            $runtime_assert signature.pos_or_kw.length >? 0
            let receiver=func.receiver
            if signature.pos_or_kw[0].place {
                let borrowed=place(receiver id env @session)
                if borrowed is? Error return borrowed
                receiver=borrowed
            }
            arguments.push(receiver)
        }
        loop argument in positional {arguments.push(argument)}
        if order.length >? 0 and func.receiver isnt? none {
            let with_receiver:array<string?>=[none]
            loop name in order {with_receiver.push(name)}
            order=with_receiver
        }
        return call(func.function arguments keyword id env @session expected=expected order=order)
    }
    let shape = types.node_at(session.types func.value_type)
    if shape isnt? types.CallableType return problem(id 'value is not callable' display.type_to_dewy(func.value_type session.types) env session)
    let methods:array<addr> = if shape is? types.OverloadType shape.methods else [func.value_type]
    let readonly_receiver=false
    if func is? hir.ExpressedIdentifier and func.binding_id isnt? none {
        let binding=bindings.binding_at(session.registry func.binding_id)
        if binding.function isnt? none {
            let literal=node_at(binding.function session)
            readonly_receiver=literal is? hir.FunctionLiteral and literal.lifecycle =? 'copy'
        }
    }
    if readonly_receiver and positional.length >? 0 and shape is? types.FunctionType and shape.pos_or_kw.length >? 0 {
        let argument=node_at(positional[0] session)
        let required=shape.pos_or_kw[0].value_type
        if argument is? hir.Place and place_fits(node_at(argument.target session).value_type required @session readonly=true) {
            positional[0]=put(hir.Place[argument.loc required argument.target] @session)
        }
    }
    let pos_types:array<addr> = []
    let kw_types:dict<string addr> = []
    loop argument in positional { pos_types.push(node_at(argument session).value_type) }
    loop [name argument] in keyword { kw_types[name] = node_at(argument session).value_type }
    let system = dispatch.System[session.links builtins.promotions bigint=numeric_values.family('BigInt' env.lexical session) rational=numeric_values.family('Rational' env.lexical session) fixed=numeric_values.family('Fixed' env.lexical session)]
    let hint=call_hint(expected function positional env session)
    let matched = if order.length =? 0 dispatch.match_best_function(methods pos_types kw_types hint system @session.types) else dispatch.match_ordered(methods pos_types kw_types order hint system @session.types)
    if matched is? dispatch.DispatchError {
        if keyword.length =? 0 and positional.length =? 2 and func is? hir.ExpressedIdentifier and func.binding_id isnt? none and bindings.binding_at(session.registry func.binding_id).builtin and func.name in? ['__eq__' '__ne__'] {
            let comparison=stored_union_equality(function positional func.name =? '__ne__' id env @session)
            if comparison is? Error return comparison
            if comparison isnt? none return if expected is? none comparison else against(comparison expected id env @session)
        }
        return problem(id 'no matching function' matched.message env session)
    }
    let callee = function
    let method = dispatch.method_at(session.types matched.method)
    if order.length >? 0 {
        let bound=dispatch.bind_ordered(method positional keyword order)
        $runtime_assert bound isnt? none
        positional=bound.pos
        keyword=bound.kw
        pos_types=[]
        kw_types=[]
        loop argument in positional {pos_types.push(node_at(argument session).value_type)}
        loop [name argument] in keyword {kw_types[name]=node_at(argument session).value_type}
    }
    if func is? hir.ExpressedIdentifier and func.binding_id isnt? none and shape is? types.FunctionType and shape.type_params.length >? 0 {
        let instance = instantiate_call(func shape pos_types kw_types hint id env @session)
        if instance is? Error return instance
        if instance isnt? none {
            callee = instance
            method = dispatch.method_at(session.types node_at(instance session).value_type)
        }
        else { callee = put(hir.ExpressedIdentifier[func.loc matched.method func.name func.binding_id] @session) }
    }
    let args:array<addr> = []
    let places:array<addr> = []
    let named=keyword
    loop i in 0.. and i <? positional.length and i <? method.pos_or_kw.length {
        let name=method.pos_or_kw[i].name
        if name isnt? none {named[name]=positional[i]}
    }
    loop i in 0.. and i <? positional.length {
        if i >=? method.pos_or_kw.length return pending(id 'variadic argument materialization' env session)
        let slot = method.pos_or_kw[i]
        let checked = call_argument(positional[i] slot.value_type slot.place id env @session arguments=named readonly=readonly_receiver and i =? 0)
        if checked is? Error return checked
        let error = remember_place(checked @places id env session)
        if error isnt? none return error
        args.push(checked)
    }
    let kwargs:dict<string addr> = []
    loop [name argument] in keyword {
        let required:addr? = none
        let is_place = false
        loop slot in method.pos_or_kw { if slot.name =? name { required = slot.value_type is_place = slot.place break } }
        loop slot in method.kw_only { if slot.name =? name { required = slot.value_type is_place = slot.place break } }
        $runtime_assert required isnt? none
        let checked = call_argument(argument required is_place id env @session arguments=named)
        if checked is? Error return checked
        let error = remember_place(checked @places id env session)
        if error isnt? none return error
        kwargs[name] = checked
    }
    let selected:addr? = if shape is? types.OverloadType matched.method_index else none
    let source = contexts.node_at(id env.lexical session)
    if func is? hir.CopyMethod {
        let result=checked_copy(func.value id env @session)
        if result is? Error return result
        return if expected is? none result else against(result expected id env @session)
    }
    if func is? hir.DictMethod {
        let result = container_call(func args kwargs id env @session)
        if result is? Error return result
        return if expected is? none result else against(result expected id env @session)
    }
    if func is? hir.ArrayMethod {
        if func.name =? 'sort' and 'key' in? kwargs {
            let key=types.node_at(session.types types.strip_refinement(node_at(kwargs['key'] session).value_type session.types))
            if key isnt? types.FunctionType or views.fixed_integer_layout(key.ret session.types) is? none return problem(id 'a sort key must return a fixed-width integer' 'return int64, uint64, or another fixed-width integer from the key function' env session)
        }
        let error = array_transition(func args kwargs id env @session)
        if error isnt? none return error
    }
    # Promises stay on the selected signature. The expressed result sheds
    # call-specific facts while retaining named types such as addr/nat64.
    let result_type = views.strip_result_refinement(method.ret @session.types)
    let path=path_values.call_result(func positional keyword @session)
    if path isnt? none {
        result_type=path.value_type
        # A literal path is a more precise view of the declared result. It
        # keeps the existing method implementations and their receiver types.
        let owner=types.node_at(session.types path.owner)
        if owner is? types.ObjectType {
            let error=prepare_methods(path.owner display.type_to_dewy(path.owner session.types) env @session)
            if error isnt? none return error
            loop method in owner.methods {
                let entry=session.methods.get(method_key(path.owner method))
                if entry isnt? none {session.methods[method_key(path.value_type method)]=entry}
            }
            session.prepared_methods.add(path.value_type)
        }
    }
    let result = put(hir.FunctionCall[source.loc result_type callee args kwargs selected proof=is_proof_binding(callee session)] @session)
    return if expected is? none result else against(result expected id env @session)
}

# A static method with arguments is an ordinary function value. An
# instance method cannot escape its receiver; only truly zero-argument
# methods auto-call (defaults alone do not make a record method zero-arg).
auto_call = (value:addr id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    if is_proof_binding(value session) return problem(id 'a proof requires a direct statement call' 'a proof is not a callback or value; write its explicit argument list' env session)
    let node=node_at(value session)
    if node is? hir.BoundMethod {
        let signature=dispatch.method_at(session.types node.value_type)
        if signature.pos_or_kw.length >? 0 or signature.kw_only.length >? 0 or signature.rest isnt? none {
            if node.receiver isnt? none return problem(id 'a method must be called' 'this method takes arguments; supply them explicitly' env session)
            return if expected is? none node.function else against(node.function expected id env @session)
        }
    }
    return call(value [] [] id env @session expected=expected)
}

# Library-backed operations use ordinary lexical lookup and generic call
# checking. Their implementations, including equality dispatch and value
# copying, remain source library code rather than compiler-only intrinsics.
library_call = (name:string arguments:array<addr> id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let function=identifier(name id env @session)
    if function is? Error return function
    return call(function arguments [] id env @session expected=expected)
}

# Every value expression meets its expected type at this boundary. Individual
# forms still use the expectation to infer constructors, lambdas, and calls;
# completing an index/member/flow must not silently bypass the conversion.
# Keep an already emitted refinement obligation rather than duplicating it.
ambiguous_juxtaposition = (type:addr @session:contexts.Session):>bool => {
    let pending:array<addr>=[type]
    let callable=false
    let numeric=false
    let number=types.primitive('number' @session.types)
    loop pending.length >? 0 {
        let current=types.unfold(types.strip_refinement(pending.pop() session.types) session.types)
        let member=types.node_at(session.types current)
        if member is? types.TypeOr {loop item in member.items {pending.push(item)}}
        else if member is? types.CallableType {callable=true}
        else if subtyping.is_subtype(current number session.links @session.types) {numeric=true}
    }
    return callable and numeric
}
juxtaposition_problem = (id:addr env:Environment session:contexts.Session):>Error => problem(id 'ambiguous juxtaposition of a callable and numeric union' 'use `A |> B` or `B <| A` for a call, or `A * B` for multiplication; narrow the union to the required alternative' env session)

expression = (id:addr env:Environment @session:contexts.Session expected:addr?=none call_target:bool=false allow_place:bool=false):>addr|Error => {
    let value=expression_inner(id env @session expected=expected call_target=call_target allow_place=allow_place)
    if value is? Error return value
    container_state.capture(value env.state @session)
    if expected is? none return value
    let node=node_at(value session)
    if node.value_type =? expected or node is? hir.Obligation and node.refined =? expected return value
    return against(value expected id env @session)
}

expression_inner = (id:addr env:Environment @session:contexts.Session expected:addr?=none call_target:bool=false allow_place:bool=false):>addr|Error => {
    let node = contexts.node_at(id env.lexical session)
    if node is? parser.Directive return directive(id node env @session)
    if node is? parser.Ambiguous return ambiguous(id node env @session expected=expected call_target=call_target allow_place=allow_place)
    let included=source_views.include_arguments(id env.lexical session)
    if included isnt? none {
        let value=include_bytes(included id env @session)
        if value is? Error return value
        return if expected is? none value else against(value expected id env @session)
    }
    let number = source_views.integer(id env.lexical session)
    if number isnt? none {
        let literal = types.integer_literal(number @session.types)
        let value = put(hir.Integer[node.loc literal '0d' number] @session)
        return if expected is? none value else against(value expected id env @session)
    }
    if node is? parser.Atom {
        let atom = contexts.node_at(node.item env.lexical session)
        let value:addr|Error = void_at(id env @session)
        if atom is? tokens.Identifier { value = identifier(atom.name id env @session) }
        else if atom is? tokens.String { value = put(hir.String[node.loc types.string_literal(atom.content @session.types) atom.content] @session) }
        else if atom is? tokens.BasedString {
            let packed=binary_literals.pack(atom source_views.srcfile(env.lexical session))
            if packed is? Error return packed
            value=put(hir.BasedString[node.loc types.binary_literal(packed.bytes @session.types) atom.base packed.digits packed.bytes] @session)
        }
        else if atom is? tokens.Real {
            let fraction=numeric_literals.real(atom source_views.srcfile(env.lexical session))
            if fraction is? Error return fraction
            let type=types.rational_literal(fraction.numerator fraction.denominator @session.types)
            let normalized=types.node_at(session.types type)
            $runtime_assert normalized is? types.RationalLiteralType
            value=put(hir.RationalConstant[node.loc type normalized.numerator normalized.denominator] @session)
        }
        else if atom is? tokens.Bool { value = put(hir.Bool[node.loc types.primitive('bool' @session.types) atom.value] @session) }
        else if atom is? tokens.Metatag and atom.name =? 'target' {value=put(hir.TargetString[node.loc types.string_literal(session.target @session.types) session.target] @session)}
        else if atom is? tokens.Metatag and atom.name =? 'proof' {
            if id not in? session.proof_markers.get(env.lexical.source set[]) return problem(id '`$proof` must mark a function declaration' 'put it immediately before the declaration' env session)
            value=void_at(id env @session)
        }
        else if atom is? tokens.Metatag {
            if atom.name in? ['__drop__' '__copy__' '__move__'] return problem(id 'a lifecycle marker belongs on a nominal type member' 'put it immediately before the method inside the type' env session)
            let count=env.control.scopes.length
            if count =? 0 return pending(id 'metatag expression outside a direct scoped-block declaration' env session)
            let scope=env.control.scopes[count-1]
            if scope.labels.get(atom.name) not=? id return pending(id 'metatag expression outside a direct scoped-block declaration' env session)
            value=put(hir.ScopeMetatag[node.loc types.primitive('void' @session.types) atom.name] @session)
        }
        else return pending(id "{atom.kind} value" env session)
        if value is? Error return value
        if not call_target and types.node_at(session.types node_at(value session).value_type) is? types.CallableType return auto_call(value id env @session expected=expected)
        return if expected is? none value else against(value expected id env @session)
    }
    if node is? parser.IString {
        let value=interpolated_string(id node env @session)
        if value is? Error return value
        return if expected is? none value else against(value expected id env @session)
    }
    if node is? parser.Flow return flow(id node env @session expected=expected)
    if node is? parser.Flat and source_views.is_operator(node.op 'RangeJuxtapose' env.lexical session) return range_value(id node env @session)
    if node is? parser.Block {
        if node.inner.length =? 1 and node.delims in? ['[]' '[)' '(]' '()'] {
            let content = contexts.node_at(node.inner[0] env.lexical session)
            if content is? parser.Flat and source_views.is_operator(content.op 'RangeJuxtapose' env.lexical session) return range_value(id content env @session bounds=node.delims)
        }
        if node.delims =? '()' and node.inner.length =? 1 return expression(node.inner[0] env @session expected=expected call_target=call_target allow_place=allow_place)
        # `(a += 1 i += 2)`: a parenthesized statement group is an unscoped
        # block, as in the hosted checker.
        if node.delims =? '()' and node.inner.length >? 1 return block(id env @session scoped=false expected=expected)
        if node.delims =? '[]' {
            let captured=captured_loop(node env session)
            if captured isnt? none return loop_capture(id captured env @session expected=expected)
            let entry = if expected is? none none else views.container_entry_types(expected session.types)
            if entry isnt? none and entry.value isnt? none return container_literal(id node env @session expected=expected)
            loop item in node.inner {
                let row = contexts.node_at(item env.lexical session)
                if row is? parser.BinOp and source_views.symbol(row.op env.lexical session) in? ['->' '<->'] return container_literal(id node env @session expected=expected)
            }
            loop item in node.inner {
                let row = contexts.node_at(item env.lexical session)
                if row is? parser.BinOp and source_views.is_operator(row.op '=' env.lexical session) return record_literal(id node env @session expected=expected)
            }
            let target_type=if expected is? none types.primitive('any' @session.types) else types.unfold(types.strip_refinement(expected session.types) session.types)
            let target:types.Type = types.node_at(session.types target_type)
            # `[x... ...]`: the first spread's source decides between a record
            # (an object source) and an array (an array or set source).
            let first_spread:addr? = none
            loop item in node.inner {
                let operand=spread_operand(item env session)
                if operand isnt? none { first_spread=operand break }
            }
            if first_spread isnt? none {
                let source=spread_source(first_spread env @session)
                if source is? Error return source
                let source_type=node_at(source session).value_type
                let source_shape=types.node_at(session.types types.unfold(types.strip_refinement(source_type session.types) session.types))
                if source_shape is? types.ObjectType and views.container_entry_types(source_type session.types) is? none return record_literal(id node env @session expected=expected)
                let wanted_element:addr? = if target is? types.ArrayType target.element else none
                let value=spread_array(id node wanted_element env @session)
                if value is? Error return value
                return if expected is? none value else against(value expected id env @session)
            }
            if target is? types.ObjectType and expected isnt? none {
                let constructor=hir.TypeValue[node.loc types.primitive('type' @session.types) types.strip_refinement(expected session.types) display.type_to_dewy(expected session.types)]
                return construct(constructor id id env @session expected=expected)
            }
            # A union supplies an array context only through a unique array
            # alternative. This includes empty result literals such as [] in
            # an array<T>|Error function; the full union remains the checked
            # storage boundary below. Multiple array alternatives are not an
            # invitation to pick an element representation arbitrarily.
            if target is? types.TypeOr {
                let candidates:array<types.ArrayType>=[]
                loop member in target.items {
                    let shape=types.node_at(session.types types.unfold(types.strip_refinement(member session.types) session.types))
                    if shape is? types.ArrayType {candidates.push(shape)}
                }
                if candidates.length not=? 1 return problem(id 'type mismatch' 'the expected type must select one array alternative' env session)
                target=candidates[0]
            }
            let element:addr? = if target is? types.ArrayType target.element else none
            if node.inner.length =? 0 and element is? none return problem(id 'cannot infer empty array element type' 'provide an array annotation' env session)
            let value = container_array(node.inner element id env @session)
            if value is? Error return value
            return if expected is? none value else against(value expected id env @session)
        }
        if node.delims =? '\{}' return block(id env @session scoped=true expected=expected)
    }
    if node is? parser.Postfix {
        let op = source_views.symbol(node.op env.lexical session)
        if op =? 'or_throw' return propagate_exceptions(id node env @session)
    }
    if node is? parser.Prefix {
        let op = source_views.symbol(node.op env.lexical session)
        if op =? 'no' return problem(id '`no` is only an effect exclusion' 'write it in a function result contract' env session)
        if op =? '@' {
            let value = expression(node.item env @session call_target=true)
            if value is? Error return value
            if is_proof_binding(value session) return problem(id 'a proof function is not a value' 'only direct statement calls are supported' env session)
            let target = node_at(value session)
            let type=types.node_at(session.types target.value_type)
            if type is? types.FunctionType and type.type_params.length >? 0 return problem(id 'a generic function cannot be used as a value' 'call it by name, where its type arguments can be determined' env session)
            if target is? hir.BoundMethod {
                if target.receiver isnt? none return pending(id 'extracting an instance method as a function value' env session)
                return target.function
            }
            if types.node_at(session.types target.value_type) is? types.CallableType return value
            if env.view_probe isnt? none {
                $runtime_assert env.view_probe <? session.local_view_probes.length
                if session.local_view_probes[env.view_probe].prefix =? id {
                    session.local_view_probes[env.view_probe].used=true
                    return value
                }
            }
            if not allow_place return problem(id 'a place can only be used as a function argument' 'pass it directly to an `@` parameter' env session)
            return place(value id env @session)
        }
        let name = builtins.prefix_operators.get(op)
        if name isnt? none {
            let operand = expression(node.item env @session)
            if operand is? Error return operand
            let target=target_values.unwrap(operand session.hir)
            if op =? 'not' and target is? hir.TargetBool return put(hir.TargetBool[node.loc types.primitive('bool' @session.types) not target.value] @session)
            if op =? 'not' and target is? hir.DecidedBool return put(hir.DecidedBool[node.loc types.primitive('bool' @session.types) not target.value] @session)
            let func = identifier(name id env @session)
            if func is? Error return func
            return call(func [operand] [] id env @session expected=expected)
        }
    }
    if node is? parser.BinOp {
        let op = source_views.symbol(node.op env.lexical session)
        let chain=comparison_chain(id env @session expected=expected)
        if chain isnt? none return chain
        if op =? 'SemicolonJuxtapose' {
            let value = expression(node.left env @session)
            if value is? Error return value
            return put(hir.Suppress[node.loc types.primitive('void' @session.types) value] @session)
        }
        if op =? 'is?' or op =? 'isnt?' {
            let value = expression(node.left env @session)
            if value is? Error return value
            let tested = declarations.resolve(node.right env.lexical @session)
            if tested is? Error return tested
            # Do not discard an effectful operand merely because its result
            # type is known. Concrete bindings/literals have no evaluation
            # prefix to retain; arbitrary value expressions stay runtime tests.
            let input=node_at(value session)
            let metatype=metatype_of(input.value_type session)
            if metatype isnt? none return metatype_test(value metatype tested op =? 'isnt?' node.loc @session)
            if input is? hir.ExpressedIdentifier|hir.Integer|hir.Bool|hir.String|hir.NoneValue|hir.TypeValue {
                let decided=type_tests.decide(input.value_type tested session.links @session.types)
                if decided isnt? none return put(hir.DecidedBool[node.loc types.primitive('bool' @session.types) decided not=? (op =? 'isnt?')] @session)
            }
            return put(hir.TypeTest[node.loc types.primitive('bool' @session.types) value tested op =? 'isnt?'] @session)
        }
        if contexts.node_at(node.op env.lexical session) is? post.CombinedAssignment return compound_assignment(id node env @session)
        if op =? '=>' return function_literal(id node env @session expected_signature=expected)
        if op =? '->' and session.capture_pairs >? 0 {
            # `k -> v` at a loop-capture value position is a pair, checked
            # as the object literal `[__dewy_key=k __dewy_value=v]` as in the
            # hosted rewrite; the capture stores it into a dictionary.
            let key=expression(node.left env @session)
            if key is? Error return key
            key=widen(key node.left env @session)
            if key is? Error return key
            let value=expression(node.right env @session)
            if value is? Error return value
            value=widen(value node.right env @session)
            if value is? Error return value
            let layout=[types.ObjectField['__dewy_key' node_at(key session).value_type] types.ObjectField['__dewy_value' node_at(value session).value_type]]
            let type=types.object_type(layout none false [] [] @session.types)
            let fields=[hir.ObjectField[node.loc '__dewy_key' key] hir.ObjectField[node.loc '__dewy_value' value]]
            return put(hir.ObjectLiteral[node.loc type fields] @session)
        }
        if op =? '|>' or op =? '<|' {
            # `x |> f` calls the function value `f` with `x`; `f <| x` is
            # the mirror image. A named function is written `@name`.
            let callable = expression(if op =? '|>' node.right else node.left env @session)
            if callable is? Error return callable
            let argument = expression(if op =? '|>' node.left else node.right env @session)
            if argument is? Error return argument
            return call(callable [argument] [] id env @session expected=expected)
        }
        if op =? '=' or op =? ':=' or op =? '::' return declaration(id env @session)
        if op =? 'as' {
            let included=source_views.include_arguments(node.left env.lexical session)
            let name=source_views.identifier(node.right env.lexical session)
            if included isnt? none and name isnt? none {
                let value=include_bytes(included id env @session)
                if value is? Error return value
                return include_declaration(name value id env @session)
            }
            let value=expression(node.left env @session)
            if value is? Error return value
            let target = declarations.resolve(node.right env.lexical @session)
            if target is? Error return target
            return explicit_conversion(value target id env @session)
        }
        if op =? 'transmute' {
            let value=expression(node.left env @session)
            if value is? Error return value
            let target=declarations.resolve(node.right env.lexical @session)
            if target is? Error return target
            if not text_shapes.transmute_compatible(node_at(value session).value_type target session.types) return problem(id 'incompatible transmute representations' 'these types do not share the backend value shape' env session)
            return put(hir.Transmute[node.loc target value] @session)
        }
        if op =? '.' {
            let primitive=source_views.identifier(node.left env.lexical session)
            if primitive isnt? none and declarations.lookup(primitive env.lexical session) is? none {
                let bounds=views.fixed_integer_bounds(types.primitive(primitive @session.types) session.types)
                if bounds isnt? none {
                    let name=source_views.identifier(node.right env.lexical session)
                    if name not=? 'min' and name not=? 'max' return problem(id 'integer type has no such member' 'fixed-width integer types expose `min` and `max`' env session)
                    let number=if name =? 'min' bounds.minimum else bounds.maximum
                    let value=put(hir.Integer[node.loc types.integer_literal(number @session.types) '0d' number] @session)
                    return if expected is? none value else against(value expected id env @session)
                }
            }
            let receiver = expression(node.left env @session allow_place=allow_place)
            if receiver is? Error return receiver
            let base = node_at(receiver session)
            let selected = if base is? hir.Place base.target else receiver
            let value = member(selected node.right id env @session)
            if value is? Error return value
            if base is? hir.Place return place(value id env @session)
            if not call_target and types.node_at(session.types node_at(value session).value_type) is? types.CallableType return auto_call(value id env @session expected=expected)
            return if expected is? none value else against(value expected id env @session)
        }
        let adjacency = contexts.node_at(node.op env.lexical session)
        if adjacency is? post.Juxtapose and source_views.identifier(node.left env.lexical session) =? 'set' and declarations.lookup('set' env.lexical session) is? none {
            let body = contexts.node_at(node.right env.lexical session)
            if body is? parser.Block and body.delims =? '[]' return container_literal(id body env @session expected=expected is_set=true)
            let value=expression(node.right env @session)
            if value is? Error return value
            let type=node_at(value session).value_type
            if views.string_valued(type session.types) return library_call('_set_of_graphemes' [value] id env @session expected=expected)
            if types.node_at(session.types types.unfold(types.strip_refinement(type session.types) session.types)) is? types.ArrayType return library_call('_set_of_array' [value] id env @session expected=expected)
            return problem(id '`set` takes a string or an array' display.type_to_dewy(type session.types) env session)
        }
        if adjacency is? post.Juxtapose and adjacency.options.length >? 1 {
            if 'CallJuxtapose' in? adjacency.options and is_typeof_call(node.left env session) {
                let value=type_of(node.right id env @session)
                if value is? Error return value
                return if expected is? none value else against(value expected id env @session)
            }
            let left = expression(node.left env @session call_target=true allow_place=allow_place)
            if left is? Error return left
            let value = node_at(left session)
            if ambiguous_juxtaposition(value.value_type @session) return juxtaposition_problem(id env session)
            if value is? hir.TypeValue return construct(value node.right id env @session expected=expected)
            let type = types.node_at(session.types types.strip_refinement(value.value_type session.types))
            if 'CallJuxtapose' in? adjacency.options and metatype_of(value.value_type session) isnt? none return metatype_construct(left node.right id env @session expected=expected)
            if type is? types.CallableType and 'CallJuxtapose' in? adjacency.options return call_syntax(left node.right id env @session expected=expected)
            if (type is? types.ArrayType|types.BinaryLiteralType|types.StringType|types.StringLiteralType or types.is_primitive(type 'string') or views.container_entry_types(value.value_type session.types) isnt? none) and 'IndexJuxtapose' in? adjacency.options return index_syntax(left node.right id env @session)
            let number = types.primitive('number' @session.types)
            if 'MultiplyJuxtapose' in? adjacency.options and subtyping.is_subtype(value.value_type number session.links @session.types) {
                let right = expression(node.right env @session)
                if right is? Error return right
                let func = identifier('__mul__' id env @session)
                if func is? Error return func
                return call(func [left right] [] id env @session expected=expected)
            }
            if value is? hir.ErrorValue return problem(id 'value is not callable or indexable' 'an error mint already denotes its singleton value' env session)
            return pending(id 'ambiguous adjacency involving this value type' env session)
        }
        if op =? 'CallJuxtapose' {
            if is_typeof_call(node.left env session) {
                let value=type_of(node.right id env @session)
                if value is? Error return value
                return if expected is? none value else against(value expected id env @session)
            }
            let func = expression(node.left env @session call_target=true)
            if func is? Error return func
            let value = node_at(func session)
            if ambiguous_juxtaposition(value.value_type @session) return juxtaposition_problem(id env session)
            if value is? hir.TypeValue return construct(value node.right id env @session expected=expected)
            if metatype_of(value.value_type session) isnt? none return metatype_construct(func node.right id env @session expected=expected)
            return call_syntax(func node.right id env @session expected=expected)
        }
        if op =? 'IndexJuxtapose' {
            let sequence = expression(node.left env @session allow_place=allow_place)
            if sequence is? Error return sequence
            return index_syntax(sequence node.right id env @session)
        }
        if op in? ['in?' 'not in?'] {
            let key = expression(node.left env @session)
            if key is? Error return key
            let container = expression(node.right env @session)
            if container is? Error return container
            let selected=target_values.membership(key container session.hir)
            if selected isnt? none return put(hir.TargetBool[node.loc types.primitive('bool' @session.types) selected not=? (op =? 'not in?')] @session)
            let range=resolved_range(container session)
            if range isnt? none {
                let result=range_membership(key range id env @session)
                if result is? Error return result
                if op =? 'in?' return result
                return library_call('__not__' [result] id env @session)
            }
            let type=types.node_at(session.types types.unfold(types.strip_refinement(node_at(container session).value_type session.types) session.types))
            if type is? types.ArrayType {
                let result=library_call('_array_contains' [key container] id env @session)
                if result is? Error return result
                if op =? 'in?' return result
                return library_call('__not__' [result] id env @session)
            }
            let entry = views.container_entry_types(node_at(container session).value_type session.types)
            if entry is? none return pending(id 'membership on this non-container type' env session)
            let checked = against(key entry.key node.left env @session)
            if checked is? Error return checked
            let arrays = container_values.arrays(container @session)
            let result = put(hir.DictContains[node.loc types.primitive('bool' @session.types) arrays.keys checked position=key_position(@session)] @session)
            if op =? 'in?' return result
            let negate = identifier('__not__' id env @session)
            if negate is? Error return negate
            return call(negate [result] [] id env @session)
        }
        let operator = builtins.binary_operators.get(if op =? 'MultiplyJuxtapose' '*' else op)
        if op =? 'not=?' { operator = '__ne__' }
        if operator isnt? none {
            let left = expression(node.left env @session)
            if left is? Error return left
            let left_type = node_at(left session).value_type
            if op =? 'MultiplyJuxtapose' and ambiguous_juxtaposition(left_type @session) return juxtaposition_problem(id env session)
            let logical = op in? ['and' '&' 'or' '|' 'nand' 'nor'] and types.is_primitive(types.node_at(session.types left_type) 'bool')
            let continues = op in? ['and' '&' 'nand']
            let shortcut = if logical refined(left not continues env @session) else env
            let right_env = if logical refined(left continues env @session) else env
            let right = expression(node.right right_env @session)
            if right is? Error return right
            let selected=target_values.logical(op left right session.hir)
            if selected isnt? none return put(hir.TargetBool[node.loc types.primitive('bool' @session.types) selected] @session)
            # Exact division has no `T/T -> T` builtin signature. Its
            # result representation depends on the numeric operands.
            if operator =? '__truediv__' and declarations.lookup(operator env.lexical session) is? none {
                let value=folded_number(operator [left right] id env @session)
                if value is? Error return value
                if value is? none {value=fixed_operation(operator [left right] id env @session)}
                if value is? Error return value
                if value is? none {value=rational_operation(operator [left right] id env @session)}
                if value is? Error return value
                if value is? none return problem(id 'exact division requires numeric operands' 'no rational operation accepts these values' env session)
                return if expected is? none value else against(value expected id env @session)
            }
            let func = identifier(operator id env @session)
            if func is? Error return func
            let value = call(func [left right] [] id right_env @session expected=if logical types.primitive('bool' @session.types) else expected)
            if value is? Error return value
            let result = node_at(value session)
            if logical and result is? hir.FunctionCall and types.is_primitive(types.node_at(session.types result.value_type) 'bool') {
                let operation:'and'|'or'|'nand'|'nor' = if op =? 'nand' 'nand' else if op =? 'nor' 'nor' else if continues 'and' else 'or'
                let paths:array<Environment> = [shortcut right_env]
                let first = node_at(left session)
                if first is? hir.Bool { paths = [if first.value =? continues right_env else shortcut] }
                join_reads(paths env @session)
                let checked = put(hir.ShortCircuit[node.loc result.value_type operation left right] @session)
                return if expected is? none checked else against(checked expected id env @session)
            }
            return value
        }
    }
    if node is? parser.KeywordExpr and node.parts.length >? 0 {
        let keyword = contexts.node_at(node.parts[0] env.lexical session)
        if keyword is? tokens.Keyword and keyword.name in? ['import' 'from'] {
            let reference = contexts.syntax_ref(id env.lexical @session)
            if reference in? session.prepared_imports return void_at(id env @session)
            return pending(id 'loading an import at this expression site' env session)
        }
        if keyword is? tokens.Keyword and keyword.name in? ['break' 'continue'] {
            return loop_exit(id node keyword env @session)
        }
        if keyword is? tokens.Keyword and keyword.name =? 'return' {
            if env.return_collector is? none return problem(id '`return` outside a function' 'nothing here catches this return' env session)
            let empty = void_at(id env @session)
            let value:addr|Error = empty
            if node.parts.length =? 2 { value = expression(node.parts[1] env @session expected=env.return_type) }
            else if env.return_type isnt? none { value = against(empty env.return_type id env @session) }
            if value is? Error return value
            record_return(node_at(value session).value_type node.loc env @session)
            return put(hir.Return[node.loc types.primitive('never' @session.types) value] @session)
        }
    }
    if node is? parser.KeywordExpr and node.parts.length =? 2 {
        let keyword = contexts.node_at(node.parts[0] env.lexical session)
        if keyword is? tokens.Keyword and keyword.name in? ['let' 'const'] return declaration(node.parts[1] env @session constant=keyword.name =? 'const' explicit=true)
    }
    return pending(id "{node.kind} expression" env session)
}

# Each interpretation runs against the same mutable checking state. The
# source catalog is read-only during expression checking and is not copied.
# Restore every mutable arena/fact field on rejection, on ambiguity, and on
# success; a losing reading cannot leak declarations, mints, or place effects.
ambiguous = (id:addr node:parser.Ambiguous env:Environment @session:contexts.Session expected:addr?=none call_target:bool=false allow_place:bool=false):>addr|Error => {
    let before=contexts.checkpoint(session)
    let winner:addr? = none
    let rejected:array<Error> = []
    let next:addr=0
    loop candidate in node.candidates {
        # The first reading already has the original state. Restoring it
        # would only copy the checkpoint back over identical arenas.
        if next >? 0 {contexts.restore(before @session)}
        next+=1
        let result = expression(candidate env @session expected=expected call_target=call_target allow_place=allow_place)
        if result is? Error { rejected.push(result) continue }
        if winner isnt? none {
            contexts.restore(before @session)
            return problem(id 'ambiguous expression' 'multiple readings typecheck; add explicit operators or parentheses' env session)
        }
        # A final successful reading is already installed, with every earlier
        # reading rejected. Keep it without copying and restoring a winner.
        if next =? node.candidates.length return result
        winner = candidate
    }
    if winner is? none {
        contexts.restore(before @session)
        # Keep implementation gaps visible when no supported reading wins.
        loop rejection in rejected { if rejection.title =? 'native checker implementation pending' return rejection }
        if rejected.length >? 0 return rejected[0]
        return problem(id 'no valid interpretation for ambiguous expression' 'no candidate expression typechecks' env session)
    }
    # The sole successful earlier reading is replayed from its original
    # state. Its node ids remain deterministic, and no discarded suffix must
    # be retained just in case the final candidate fails.
    contexts.restore(before @session)
    return expression(winner env @session expected=expected call_target=call_target allow_place=allow_place)
}

# `[a b] = value` / `let [a b] = value`: the value is bound once (a hidden
# local unless it is already a binding), then each target takes a field by
# name from an object or an element by position from an array of proven
# length, declaring a new name or assigning an existing one exactly as
# `a = ...` would (`let` always declares). `_` discards an element.
unpack = (targets_id:addr right:addr id:addr env:Environment @session:contexts.Session constant:bool=false explicit:bool=false):>addr|Error => {
    let loc=contexts.node_at(id env.lexical session).loc
    let void_type=types.primitive('void' @session.types)
    let statements:array<addr>=[]
    let source_name=source_views.identifier(right env.lexical session)
    let source:addr=0
    if source_name isnt? none and declarations.lookup(source_name env.lexical session) isnt? none {
        let read=expression(right env @session)
        if read is? Error return read
        source=read
    } else {
        let value=expression(right env @session)
        if value is? Error return value
        let bound=hidden_binding("__dewy_unpack_{session.registry.next_id}" value loc env @session)
        statements.push(bound.declaration)
        source=bound.reference
    }
    let unpacked=unpack_value(targets_id source id env @session constant=constant explicit=explicit)
    if unpacked is? Error return unpacked
    statements.push(unpacked)
    return put(hir.Block[loc void_type statements false] @session)
}
HiddenBinding:type = const [declaration:addr reference:addr name:string binding_id:addr]
hidden_binding = (name:string value:addr loc:Span env:Environment @session:contexts.Session):>HiddenBinding => {
    let binding_id=bindings.allocate(@session.registry none name 'value' loc)
    let binding=bindings.binding_at(session.registry binding_id)
    let type=node_at(value session).value_type
    binding.value_type=type binding.store_type=type
    let declaration=put(hir.Declare[loc types.primitive('void' @session.types) 'let' name type value binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    set_read_type(binding_id stored_read_type(value @session) env @session)
    return HiddenBinding[declaration put(hir.ExpressedIdentifier[loc type name binding_id] @session) name binding_id]
}
# `value or_throw`: the exception alternatives (`error` subtypes and `none`)
# return from the enclosing function; the expression continues as the
# ordinary alternatives. Checked as the hosted `OrThrow`, spelled here as a
# hidden binding, a test with an early return, and a narrowed read.
propagate_exceptions = (id:addr node:parser.Postfix env:Environment @session:contexts.Session):>addr|Error => {
    let value=expression(node.item env @session)
    if value is? Error return value
    let type=node_at(value session).value_type
    let shape=types.node_at(session.types types.strip_refinement(type session.types))
    let members:array<addr>=if shape is? types.TypeOr shape.items else [type]
    let exception=types.primitive('exception' @session.types)
    let exceptions:array<addr>=[]
    let ordinary:array<addr>=[]
    loop member in members {
        if subtyping.is_subtype(member exception session.links @session.types) {exceptions.push(member)} else {ordinary.push(member)}
    }
    if exceptions.length =? 0 return problem(id 'nothing to propagate' "this has type `{display.type_to_dewy(type session.types)}`, which has no `error` or `none` alternative" env session)
    if ordinary.length =? 0 return problem(id '`or_throw` always returns' 'every alternative is propagated; write `return value` instead' env session)
    if env.return_collector is? none return problem(id '`or_throw` outside a function' 'nothing here catches the propagated value' env session)
    let expected=env.return_type
    if expected is? none or types.is_primitive(types.node_at(session.types expected) 'void') return problem(id 'the enclosing function has no declared result type to propagate into' 'annotate the function result with `:>T | ...` including the propagated alternatives' env session)
    loop member in exceptions {
        if not subtyping.is_subtype(member expected session.links @session.types) return problem(id "the enclosing function does not return `{display.type_to_dewy(member session.types)}`" 'add that alternative to the function result type, or handle it with `is?` first' env session)
    }
    let loc=node.loc
    let bound=hidden_binding("__dewy_or_throw_{session.registry.next_id}" value loc env @session)
    let exception_type=types.union(exceptions @session.types)
    let ordinary_type=types.union(ordinary @session.types)
    let propagated=if types.is_primitive(types.node_at(session.types exception_type) 'none') put(hir.NoneValue[loc types.primitive('none' @session.types)] @session) else put(hir.ExpressedIdentifier[loc exception_type bound.name bound.binding_id] @session)
    let converted=against(propagated expected id env @session)
    if converted is? Error return converted
    record_return(node_at(converted session).value_type loc env @session)
    let boolean=types.primitive('bool' @session.types)
    let void_type=types.primitive('void' @session.types)
    let condition=put(hir.TypeTest[loc boolean bound.reference exception_type false] @session)
    let exit=put(hir.Return[loc types.primitive('never' @session.types) converted] @session)
    let arm=put(hir.IfArm[loc void_type condition exit] @session)
    let flow=put(hir.Flow[loc void_type [arm] none] @session)
    let result=put(hir.ExpressedIdentifier[loc ordinary_type bound.name bound.binding_id] @session)
    return put(hir.Block[loc ordinary_type [bound.declaration flow result] false] @session)
}
# Each target takes a field by name from an object or an element by position
# from an array of proven length; a nested `[...]` target unpacks that
# element further through its own hidden binding.
unpack_value = (targets_id:addr source:addr id:addr env:Environment @session:contexts.Session constant:bool=false explicit:bool=false):>addr|Error => {
    let targets=contexts.node_at(targets_id env.lexical session)
    $runtime_assert targets is? parser.Block
    let loc=contexts.node_at(id env.lexical session).loc
    let void_type=types.primitive('void' @session.types)
    let statements:array<addr>=[]
    let source_type=stored_read_type(source @session)
    let shape=types.node_at(session.types types.unfold(types.strip_refinement(source_type session.types) session.types))
    let entries=views.container_entry_types(source_type session.types)
    let names:array<string>=[]
    let values:array<addr>=[]
    if entries isnt? none {
        # A dictionary or set unpacks its entries in insertion order when the
        # entry count is a fact here: a set's members like array elements, a
        # dictionary's entries as `[key value]` pairs.
        # The entry arrays' exact lengths live on their member routes' read
        # types, as for any array field.
        let key_type=types.array_type(entries.key none @session.types)
        let value_element=entries.value
        let value_type:addr?=if value_element is? none none else types.array_type(value_element none @session.types)
        let count:bigint?=none
        let source_node=node_at(source session)
        if source_node is? hir.ExpressedIdentifier and source_node.binding_id isnt? none {
            loop route in session.registry.routes_by_root.get(source_node.binding_id []) {
                if route.path.length not=? 1 continue
                let known=read_type(route.id env session)
                if known is? none continue
                let known_shape=types.node_at(session.types types.strip_refinement(known session.types))
                if known_shape isnt? types.ArrayType continue
                if route.path[0] =? 'keys' {key_type=known count=known_shape.length}
                if route.path[0] =? 'values' {value_type=known}
            }
        }
        let kind=if entries.value is? none 'set' else 'dictionary'
        if count is? none return problem(right_of(id env session) "cannot prove how many entries this {kind} has" 'unpacking needs an exact count: look entries up by key instead' env session)
        if targets.inner.length not=? count return problem(targets_id "unpacking must name every {if entries.value is? none 'member' else 'entry'}" "{targets.inner.length} targets for {count} entries; use `_` for a value you do not need" env session)
        let key_member=put(hir.MemberAccess[loc key_type source 'keys' true] @session)
        let value_member:addr?=none
        if value_type isnt? none {value_member=put(hir.MemberAccess[loc value_type source 'values' true] @session)}
        loop index in 0.. and index <? targets.inner.length {
            let item=targets.inner[index]
            let item_node=contexts.node_at(item env.lexical session)
            let item_loc=item_node.loc
            let position=put(hir.Integer[item_loc types.integer_literal(index @session.types) '0d' index] @session)
            if value_member is? none {
                let target_name=source_views.identifier(item env.lexical session)
                if target_name is? none return problem(item 'unpack targets must be names' 'this is not a name' env session)
                if target_name =? '_' continue
                names.push(target_name)
                values.push(put(hir.Index[item_loc entries.key key_member position index] @session))
                continue
            }
            if item_node isnt? parser.Block or item_node.delims not=? '[]' or item_node.inner.length not=? 2 return problem(item 'a dictionary entry is a key and a value' 'unpack it as `[key value]`' env session)
            let key_target=source_views.identifier(item_node.inner[0] env.lexical session)
            let value_target=source_views.identifier(item_node.inner[1] env.lexical session)
            if key_target is? none or value_target is? none return problem(item 'unpack targets must be names' 'each of `[key value]` is a name' env session)
            $runtime_assert value_element isnt? none
            if key_target not=? '_' {
                names.push(key_target)
                values.push(put(hir.Index[item_loc entries.key key_member position index] @session))
            }
            if value_target not=? '_' {
                names.push(value_target)
                values.push(put(hir.Index[item_loc value_element value_member position index] @session))
            }
        }
    } else if shape is? types.ObjectType {
        loop item in targets.inner {
            let target_name=source_views.identifier(item env.lexical session)
            if target_name is? none or target_name =? '_' return problem(item 'objects unpack by field name' 'each target names the field it takes' env session)
            let field=types.object_field(shape target_name)
            if field is? none return problem(item "no field `{target_name}` to unpack" 'the value has no field of this name' env session)
            names.push(target_name)
            values.push(put(hir.MemberAccess[contexts.node_at(item env.lexical session).loc field.value_type source target_name field.mutable and not shape.immutable] @session))
        }
    } else if shape is? types.ArrayType {
        if shape.length is? none return problem(right_of(id env session) 'cannot prove how many elements this array has' 'unpacking needs an exact length: index the elements you need under a length guard instead' env session)
        if targets.inner.length not=? shape.length return problem(targets_id 'unpacking must name every element' "{targets.inner.length} targets for {shape.length} elements; use `_` for a value you do not need" env session)
        loop index in 0.. and index <? targets.inner.length {
            let item=targets.inner[index]
            let item_node=contexts.node_at(item env.lexical session)
            let item_loc=item_node.loc
            let position=put(hir.Integer[item_loc types.integer_literal(index @session.types) '0d' index] @session)
            let element=put(hir.Index[item_loc shape.element source position index] @session)
            if item_node is? parser.Block and item_node.delims =? '[]' {
                let bound=hidden_binding("__dewy_entry_{session.registry.next_id}" element item_loc env @session)
                statements.push(bound.declaration)
                let inner=unpack_value(item bound.reference id env @session constant=constant explicit=explicit)
                if inner is? Error return inner
                statements.push(inner)
                continue
            }
            let target_name=source_views.identifier(item env.lexical session)
            if target_name is? none return problem(item 'unpack targets must be names' 'this is not a name (or a nested `[...]`)' env session)
            if target_name =? '_' continue
            names.push(target_name)
            values.push(element)
        }
    } else return problem(targets_id 'this value cannot be unpacked' 'unpacking takes an object or an array' env session)
    loop i in 0.. and i <? names.length and i <? values.length {
        let target_name=names[i]
        let value=values[i]
        let scope=bindings.scope_at(session.scopes env.lexical.scope)
        let existing=if explicit scope.names.get(target_name) else declarations.lookup(target_name env.lexical session)
        if existing isnt? none and not explicit {
            let prior=bindings.binding_at(session.registry existing)
            if prior.read_only_reason isnt? none return problem(id 'cannot assign to a constant' target_name env session)
            let required=if prior.store_type is? none node_at(value session).value_type else prior.store_type
            let assigned=put(hir.ExpressedIdentifier[loc required target_name existing] @session)
            let converted=against(value required id env @session)
            if converted is? Error return converted
            container_state.changed(existing env.state @session)
            set_read_type(existing stored_read_type(converted @session) env @session)
            statements.push(put(hir.Assign[loc void_type assigned '=' converted] @session))
            continue
        }
        if existing isnt? none return problem(id "duplicate declaration `{target_name}`" 'this scope already declares the name' env session)
        let widened=if constant value else widen(value id env @session strings=false abstract=true)
        if widened is? Error return widened
        let type=node_at(widened session).value_type
        let binding_id=bindings.allocate(@session.registry none target_name 'value' loc)
        let binding=bindings.binding_at(session.registry binding_id)
        binding.value_type=type binding.store_type=type
        if constant {binding.read_only_reason='const binding'}
        let declaration=put(hir.Declare[loc void_type (if constant 'const' else 'let') target_name type widened binding_id] @session)
        binding.declaration=declaration
        bindings.store_binding(@session.registry binding_id binding)
        bindings.bind(@session.scopes env.lexical.scope target_name binding_id)
        set_read_type(binding_id stored_read_type(widened @session) env @session)
        statements.push(declaration)
    }
    return put(hir.Block[loc void_type statements false] @session)
}
right_of = (id:addr env:Environment session:contexts.Session):>addr => {
    let node=contexts.node_at(id env.lexical session)
    return if node is? parser.BinOp node.right else id
}
# Only a leading @ on the receiver spine is a local-view request. An @
# inside an index or call argument still uses the ordinary place barrier.
local_view_prefix = (id:addr env:Environment session:contexts.Session):>addr? => {
    let node=contexts.node_at(id env.lexical session)
    if node is? parser.Prefix and source_views.is_operator(node.op '@' env.lexical session) return id
    if node is? parser.Block and node.delims =? '()' and node.inner.length =? 1 return local_view_prefix(node.inner[0] env session)
    if node is? parser.BinOp {
        let op=contexts.node_at(node.op env.lexical session)
        if op is? post.Juxtapose or source_views.is_operator(node.op '.' env.lexical session) return local_view_prefix(node.left env session)
    }
    return none
}

# Imports retain declaration identity. A bare assignment cannot replace a
# binding owned by another module; explicit let creates a local shadow.
foreign_assignment = (binding:bindings.Binding id:addr env:Environment session:contexts.Session):>Error? => {
    if binding.syntax is? none return none
    $runtime_assert binding.syntax <? session.syntax_refs.length
    let origin=session.syntax_refs[binding.syntax]
    if origin.source =? env.lexical.source return none
    return problem(id "cannot assign to `{binding.name}`: it belongs to another module" "write `let {binding.name} = ...` to declare a local shadow" env session)
}

declaration = (id:addr env:Environment @session:contexts.Session constant:bool=false explicit:bool=false):>addr|Error => {
    let node = contexts.node_at(id env.lexical session)
    if node isnt? parser.BinOp return problem(id 'declaration needs a value' 'expected a named assignment' env session)
    let target = contexts.node_at(node.left env.lexical session)
    let target_id = node.left
    let annotation:addr? = none
    if target is? parser.BinOp and source_views.is_operator(target.op ':' env.lexical session) {
        target_id = target.left
        let type = declarations.resolve(target.right env.lexical @session)
        if type is? Error return type
        type = declarations.value_type(type target.right env.lexical @session)
        if type is? Error return type
        let resolved=declarations.resolve_scope_terms(type target.right env.lexical @session)
        if resolved is? Error return resolved
        annotation = resolved
    }
    let name = source_views.identifier(target_id env.lexical session)
    if name is? none {
        if annotation is? none and target is? parser.Block and target.delims =? '[]' return unpack(target_id node.right id env @session constant=constant explicit=explicit)
        if explicit or annotation isnt? none return pending(id 'destructuring declaration' env session)
        if target is? parser.BinOp {
            let adjacency = contexts.node_at(target.op env.lexical session)
            if adjacency is? post.Juxtapose and 'IndexJuxtapose' in? adjacency.options {
                let container = expression(target.left env @session)
                if container is? Error return container
                if views.container_entry_types(node_at(container session).value_type session.types) isnt? none return container_index(container target.right id env @session store=node.right)
            }
        }
        let place = expression(target_id env @session call_target=true)
        if place is? Error return place
        let member = node_at(place session)
        if member isnt? hir.MemberAccess|hir.Index return problem(id 'assignment requires mutable storage' 'select a binding, record field, or array element' env session)
        let error = writable(place id env session)
        if error isnt? none return error
        let value = expression(node.right env @session expected=store_type(place @session))
        if value is? Error return value
        container_state.replaced(place env.state @session)
        if member is? hir.Index return put(hir.IndexAssign[node.loc types.primitive('void' @session.types) place value] @session)
        let marked=receiver_method(value store_type(place @session) id env @session)
        if marked is? Error return marked
        value=marked
        return put(hir.MemberAssign[node.loc types.primitive('void' @session.types) place value] @session)
    }
    let scope = bindings.scope_at(session.scopes env.lexical.scope)
    let existing = if explicit or annotation isnt? none scope.names.get(name) else declarations.lookup(name env.lexical session)
    if existing isnt? none and not explicit and annotation is? none {
        let error=foreign_assignment(bindings.binding_at(session.registry existing) id env session)
        if error isnt? none return error
    }
    if existing isnt? none and existing in? session.pending_aliases {
        let pending=session.pending_aliases[existing].expression
        # Only the alias's original statement completes its declaration.
        # Other assignments must not silently re-emit that alias and discard
        # their right-hand side (including assignments to imported aliases).
        if pending.source not=? env.lexical.source or pending.scope not=? env.lexical.scope or pending.node not=? node.right return problem(id 'assignment requires runtime storage' "`{name}` is a type alias; use `let` to declare a local shadow" env session)
        let value = declarations.resolve_alias(existing @session)
        if value is? Error return value
        if value is? addr {
            let error=prepare_methods(value name env @session)
            if error isnt? none return error
        }
        let expr = put(hir.TypeValue[node.loc types.primitive('type' @session.types) value name] @session)
        return put(hir.Declare[node.loc types.primitive('void' @session.types) if constant 'const' else 'let' name annotation expr existing] @session)
    }
    let reserved = false
    if existing isnt? none {
        let binding = bindings.binding_at(session.registry existing)
        reserved = binding.kind =? 'function' and binding.declaration is? none
    }
    if existing isnt? none and not reserved {
        let prior = bindings.binding_at(session.registry existing)
        if explicit return problem(id "duplicate declaration `{name}`" 'this scope already declares the name' env session)
        if prior.type_value isnt? none return problem(id 'assignment requires runtime storage' "`{name}` is a type alias; use `let` to declare a local shadow" env session)
        if prior.replacement isnt? none {
            let member=node_at(prior.replacement session)
            if member isnt? hir.MemberAccess return problem(id 'cannot assign to a method' name env session)
            let error=writable(prior.replacement id env session)
            if error isnt? none return error
            let value=expression(node.right env @session expected=store_type(prior.replacement @session))
            if value is? Error return value
            container_state.replaced(prior.replacement env.state @session)
            return put(hir.MemberAssign[node.loc types.primitive('void' @session.types) prior.replacement value] @session)
        }
        if prior.read_only_reason isnt? none return problem(id 'cannot assign to a constant' name env session)
        let required = if prior.store_type is? none prior.value_type else prior.store_type
        let value = expression(node.right env @session expected=required)
        if value is? Error return value
        let target = identifier(name target_id env @session)
        if target is? Error return target
        container_state.changed(existing env.state @session)
        container_state.seed(existing value env.state @session)
        container_state.seed_fields(existing value env.state @session)
        set_read_type(existing stored_read_type(value @session) env @session)
        return put(hir.Assign[node.loc types.primitive('void' @session.types) target '=' value] @session)
    }
    let rhs = contexts.node_at(node.right env.lexical session)
    let prefix=local_view_prefix(node.right env session)
    let checking=env
    let probe=session.local_view_probes.length
    if prefix isnt? none {
        session.local_view_probes.push(contexts.LocalViewProbe[prefix])
        checking=Environment[env.lexical env.state env.return_type env.control env.return_collector probe]
    }
    let value = if rhs is? parser.BinOp and source_views.is_operator(rhs.op '=>' env.lexical session) function_literal(node.right rhs env @session name=name expected_signature=annotation) else expression(node.right checking @session expected=annotation)
    if value is? Error return value
    let view=false
    if prefix isnt? none {
        $runtime_assert probe <? session.local_view_probes.length
        view=session.local_view_probes[probe].used
        session.local_view_probes.truncate(probe)
    }
    if view {
        if not constant {
            let access=bindings.access_path(value session.hir dictionaries=true)
            let entry=false
            loop step in access.steps {if node_at(step session) is? hir.DictLookup {entry=true}}
            let borrowed=if entry writable(value id env session named=true) else place(value id env @session)
            if borrowed is? Error return borrowed
        }
        if env.return_collector is? none return problem(id 'a local view needs a function scope' 'bind the view inside its owning function' env session)
        let target=node_at(value session)
        if target isnt? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index|hir.DictLookup return problem(id 'a local view needs a stored value' 'select a named binding, field, or element' env session)
    }
    if annotation is? none and explicit {
        let inhabitant=unit_inhabitant(value none node.right env @session)
        if inhabitant is? Error return inhabitant
        if inhabitant isnt? none {value=inhabitant}
    }
    if value is? Error return value
    if annotation is? none and not constant { value = widen(value node.right env @session strings=false abstract=true) }
    if value is? Error return value
    let checked = node_at(value session)
    let initializer=effect_boundary_value(value session)
    let initial_node=node_at(initializer session)
    let syntax_id = contexts.syntax_ref(id env.lexical @session)
    let binding_id = if existing is? none bindings.allocate(@session.registry syntax_id name 'value' node.loc) else existing
    let binding = bindings.binding_at(session.registry binding_id)
    let signature=types.node_at(session.types checked.value_type)
    if annotation is? none and signature is? types.FunctionType and initial_node isnt? hir.FunctionLiteral|hir.GenericFunction and signature.type_params.length =? 0 and not view {
        let name="{effect_inference.BINDING_PREFIX}{binding_id}"
        let effects=effect_rows.Contract[effect_rows.Row[variables=[name]]]
        let type=types.function_type(signature.pos_or_kw signature.kw_only signature.rest signature.ret signature.type_params @session.types effects=effects)
        value=put(hir.ValueCast[checked.loc type value effect_target=type] @session)
        checked=node_at(value session)
    }
    binding.value_type = if annotation is? none checked.value_type else annotation
    binding.store_type = binding.value_type
    if view and not constant {
        let path=bindings.access_path(value session.hir dictionaries=true)
        let root=node_at(path.root session)
        $runtime_assert root is? hir.ExpressedIdentifier and root.binding_id isnt? none
        let owner=bindings.binding_at(session.registry root.binding_id)
        session.local_place_roots[binding_id]=session.local_place_roots.get(owner.id default=owner.id)
        let stored=checked.value_type
        if checked is? hir.ExpressedIdentifier {
            if owner.store_type isnt? none {stored=owner.store_type}
            else if owner.value_type isnt? none {stored=owner.value_type}
        }
        if checked is? hir.MemberAccess {
            let shape=types.node_at(session.types views.structural_base(node_at(checked.value session).value_type session.types))
            if shape is? types.ObjectType {
                let field=types.object_field(shape checked.name)
                if field isnt? none {stored=field.value_type}
            }
        }
        if annotation isnt? none and not place_fits(stored annotation @session) return problem(id 'local place annotation changes its storage contract' 'a mutable place must retain the selected storage contract' env session)
        binding.store_type=stored
        annotation=stored
    }
    let read=if annotation isnt? none and numeric_values.is_family(annotation 'BigInt' env.lexical session) annotation else checked.value_type
    # A declared function type is the binding's contract: a call through it
    # yields the declared (possibly wider) result, not the initializer's.
    if annotation isnt? none and types.node_at(session.types types.strip_refinement(annotation session.types)) is? types.FunctionType|types.OverloadType {read=annotation}
    if annotation isnt? none {
        let payload=views.optional_payload(annotation @session.types)
        let actual=stored_read_type(value @session)
        if payload isnt? none and types.node_at(session.types payload) is? types.ArrayType and types.node_at(session.types actual) is? types.ArrayType {
            # Optional storage keeps its tag, but the present initializer
            # still proves an exact length. Mutation continues to use the
            # separately recorded store contract, never this initial fact.
            read=views.optional(actual @session.types)
        }
    }
    set_read_type(binding_id read env @session)
    if constant {
        binding.read_only_reason = 'const binding'
        # This evidence comes from initialization, not a caller's branch.
        # Immutable values keep it for later function/default checking even
        # when the written store contract (e.g. array<T>) omits the length.
        # Mutable bindings retain their contract here; their current read
        # alternatives live only in the flow state above.
        binding.value_type = read
    }
    bindings.store_binding(@session.registry binding_id binding)
    bindings.bind(@session.scopes env.lexical.scope name binding_id)
    container_state.seed(binding_id value env.state @session)
    container_state.seed_fields(binding_id value env.state @session)
    let declared = put(hir.Declare[node.loc types.primitive('void' @session.types) if constant 'const' else 'let' name annotation value binding_id view] @session)
    binding.declaration = declared
    if initial_node is? hir.FunctionLiteral | hir.GenericFunction {
        binding.function = initializer binding.kind = 'function'
        if rhs is? parser.BinOp {binding.literal_path_parameter=source_views.path_parameter(rhs env.lexical session)}
    }
    if checked is? hir.OverloadedFunction {binding.function=value binding.kind='overload'}
    bindings.store_binding(@session.registry binding_id binding)
    return declared
}

block = (id:addr env:Environment @session:contexts.Session scoped:bool=false expected:addr?=none):>addr|Error => {
    let node = contexts.node_at(id env.lexical session)
    if node isnt? parser.Block return expression(id env @session expected=expected)
    let inner = if scoped Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector] else env
    if node.delims =? '\{}' {
        let control=collect_labels(node env session)
        if control is? Error return control
        inner=Environment[inner.lexical inner.state inner.return_type control inner.return_collector]
    }
    let proof_error=collect_proof_annotations(node inner @session)
    if proof_error isnt? none return proof_error
    let aliases:array<addr>=[]
    loop statement in node.inner {
        let alias = declarations.predeclare_alias(statement inner.lexical @session)
        if alias is? Error return alias
        if alias isnt? none {aliases.push(alias)}
    }
    # Resolve aliases in declaration order before signature lookup can enter
    # a recursive family through one of its function-typed slots.
    loop alias in aliases {
        let resolved=declarations.resolve_alias(alias @session)
        if resolved is? Error return resolved
    }
    loop statement in node.inner {
        let error = predeclare_function(statement inner @session)
        if error isnt? none return error
    }
    let items:array<addr> = []
    let deferred:dict<addr addr>=[]
    let result = types.primitive('void' @session.types)
    let values:addr = 0
    loop item in node.inner {
        # A complete signature is enough to check calls. Check its body after
        # eager declarations have supplied the remaining value types, while
        # retaining this statement's original initialization position. Generic
        # declarations keep their existing deferred-instantiation behavior.
        let reference=contexts.syntax_ref(item inner.lexical @session)
        let reserved=session.registry.by_syntax.get(reference)
        if reserved isnt? none {
            let binding=bindings.binding_at(session.registry reserved)
            if binding.kind =? 'function' and binding.function is? none and binding.declaration is? none {
                deferred[items.length]=item
                items.push(void_at(item inner @session))
                continue
            }
        }
        # A result expectation belongs to the block's expressed value, not
        # each statement. A single-item wrapper remains transparent so a
        # literal can use its context; multi-item blocks check their result
        # below. Explicit returns use the enclosing function's own contract.
        let value = expression(item inner @session expected=if node.inner.length =? 1 expected else none)
        if value is? Error return value
        let checked=node_at(value session)
        if checked is? hir.Block and not checked.scoped {loop item in checked.items {items.push(item)}}
        else {items.push(value)}
        let type = node_at(value session).value_type
        let atom = types.node_at(session.types type)
        if types.is_primitive(atom 'never') { result = type break }
        if not types.is_primitive(atom 'void') {
            values += 1 result = type
        }
    }
    loop [position item] in deferred {
        let value=expression(item inner @session)
        if value is? Error return value
        $runtime_assert position <? items.length
        items[position]=value
    }
    if scoped and values >? 1 return problem(id 'block expresses multiple values' 'suppress unused expressions with a semicolon' env session)
    let value=put(hir.Block[node.loc result items scoped] @session)
    return if expected is? none value else against(value expected id env @session)
}

# Keep hoisted instances with the module that first requested them. Nested
# instantiations append their callees first; the original result type is not
# changed by the added void declarations.
module = (id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let source=source_views.srcfile(env.lexical session)
    $runtime_assert env.lexical.source <? session.sources.length
    let reserved=source_names.validate(id source session.sources[env.lexical.source].nodes)
    if reserved isnt? none return reserved
    let first=session.read_states.length
    let result=module_inner(id env @session)
    contexts.release_read_states(first @session)
    return result
}
module_inner = (id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let first = session.hoisted.length
    let checked = block(id env @session)
    if checked is? Error return checked
    let root = node_at(checked session)
    $runtime_assert root is? hir.Block
    let items:array<addr>=[]
    let i = first
    loop i <? session.hoisted.length { items.push(session.hoisted[i]) i += 1 }
    # Instances carry no module initialization state. Declare them before
    # the source statements that call them; nested callees are already first
    # in the hoisted list, matching the hosted module assembly.
    loop item in root.items {items.push(item)}
    return put(hir.Block[root.loc root.value_type items root.scoped] @session)
}

read_type = (id:addr env:Environment session:contexts.Session fallback:addr?=none):>addr? => {
    $runtime_assert env.state <? session.read_states.length
    let state = session.read_states[env.state]
    let type = state.types.get(id)
    if type isnt? none return type
    return if fallback is? none bindings.binding_at(session.registry id).value_type else fallback
}
# Update the state in place: copying it out and back would detach (copy)
# every array of its dictionary for one insertion.
store_read_type = (@state:contexts.ReadState id:addr type:addr):>void => { state.types[id] = type }
set_read_type = (id:addr type:addr env:Environment @session:contexts.Session):>void => {
    $runtime_assert env.state <? session.read_states.length
    store_read_type(@session.read_states[env.state] id type)
}
# Packing a value into its wider store union changes storage, not which
# alternatives this value can contain. Keep that evidence for reads and
# operator proofs; conversions (such as decoding bytes to string|none) retain
# their result type because the input is not a subtype of that result.
stored_read_type = (value:addr @session:contexts.Session):>addr => {
    let node=node_at(value session)
    # A store conversion must prove this contract before installation. Its
    # base-typed representation is not the read type of the stored value:
    # otherwise assigning addr into addr|Error makes a branch join forget
    # the nonnegative payload even when every surviving arm supplies addr.
    if node is? hir.Obligation return node.refined
    if node is? hir.RepresentationCast and types.node_at(session.types node.value_type) is? types.TypeOr {
        let source=node_at(node.expr session)
        if subtyping.is_subtype(source.value_type node.value_type session.links @session.types) return stored_read_type(node.expr @session)
    }
    return node.value_type
}
fork = (env:Environment @session:contexts.Session):>Environment => {
    $runtime_assert env.state <? session.read_states.length
    let copy = session.read_states[env.state]
    let state = session.read_states.length
    session.read_states.push(copy)
    return Environment[env.lexical state env.return_type env.control env.return_collector]
}

# Annotated functions reserve their signature before any body in the block
# is checked. Initialization analysis, not name resolution, decides whether
# an eager call reaches a declaration before its value has been initialized.
function_shape = (literal:parser.BinOp env:Environment @session:contexts.Session concrete:bool=false):>addr|Error => {
    let proof=is_proof_literal(literal env session)
    let signature = contexts.node_at(literal.left env.lexical session)
    let parameter_id=literal.left
    let result_id:addr?=none
    if signature is? parser.BinOp and source_views.is_operator(signature.op ':>' env.lexical session) {
        parameter_id=signature.left result_id=signature.right
    } else if signature is? parser.BinOp and source_views.is_operator(signature.op 'TypeParamJuxtapose' env.lexical session) {
        return problem(literal.left 'a generic function needs a declared result type' 'annotate the result with `:>T`' env session)
    }
    let lexical = env.lexical
    let generic:array<types.GenericParam> = []
    let prefix = contexts.node_at(parameter_id env.lexical session)
    if prefix is? parser.BinOp and source_views.is_operator(prefix.op 'TypeParamJuxtapose' env.lexical session) {
        let parameters = contexts.node_at(prefix.left env.lexical session)
        if parameters isnt? parser.Block or parameters.delims not=? '<>' return problem(prefix.left 'invalid generic parameters' 'expected a type-parameter block' env session)
        if parameters.inner.length =? 0 return problem(prefix.left 'a generic function needs at least one type parameter' 'this parameter list is empty' env session)
        parameter_id = prefix.right
        if not concrete {
            let declared = declarations.generic_parameters(parameters lexical @session)
            if declared is? Error return declared
            lexical = declared.context generic = declared.params
        }
        # Generic signatures need declared parameter types; an implicit any
        # would hide the connection between arguments and type parameters.
        let arguments = contexts.node_at(parameter_id env.lexical session)
        let rows:array<addr> = if arguments is? parser.Block arguments.inner else [parameter_id]
        loop item in rows {
            if declarations.is_divider(item env.lexical session) continue
            let parsed=declarations.parameter_source(item env.lexical session)
            if parsed is? Error return parsed
            if parsed.annotation is? none return problem(item 'a generic function needs every parameter type declared' 'annotate this parameter' env session)
        }
    }
    let args = declarations.function_args(parameter_id lexical @session literal=true)
    if args is? Error return args
    let parameters:array<types.PosOrKwArg> = []
    loop arg in args.pos_or_kw {
        parameters.push(types.PosOrKwArg[arg.name arg.value_type arg.required arg.place])
    }
    if proof and generic.length >? 0 return problem(literal.left 'generic proof functions are not supported yet' 'the initial proof subset uses concrete parameter types' env session)
    if proof and result_id is? none return problem(literal.left 'a proof needs a fact-only return contract' 'write `:> <P>` after the parameters' env session)
    let result=if result_id is? none types.primitive('untyped' @session.types) else declarations.function_result(result_id lexical @session proof=proof)
    if result is? Error return result
    # Abstract integers keep mathematical arithmetic until bounds analysis
    # chooses their representation. Selecting a word here would silently
    # give an `int` function wrapping arithmetic before its proofs run.
    let effect_parameters=parameters
    let syntax=contexts.node_at(parameter_id lexical session)
    let source_parameters:array<addr>=if syntax is? parser.Block and syntax.delims =? '()' syntax.inner else [parameter_id]
    loop index in 0.. and index <? effect_parameters.length and index <? source_parameters.length {
        let parameter=effect_parameters[index]
        if parameter.name isnt? none continue
        let parsed=declarations.parameter_source(source_parameters[index] lexical session)
        if parsed is? Error return parsed
        effect_parameters[index]=types.PosOrKwArg[parsed.name parameter.value_type parameter.required parameter.place]
    }
    let effect_contract=if result_id is? none none else declarations.effect_contract(result_id effect_parameters args.kw_only lexical @session)
    if effect_contract is? Error return effect_contract
    let inferred:string?=none
    if effect_contract is? none {
        # SyntaxRef includes lexical scope, so generic instances are distinct.
        inferred="{effect_inference.PREFIX}{contexts.syntax_ref(literal.left env.lexical @session)}"
        effect_contract=effect_rows.Contract[effect_rows.Row[variables=[inferred]]]
    }
    return types.function_type(parameters args.kw_only none result generic @session.types effects=effect_contract inferred_effect=inferred)
}
predeclare_function = (id:addr env:Environment @session:contexts.Session):>Error? => {
    let node = contexts.node_at(id env.lexical session)
    let explicit=false
    if node is? parser.KeywordExpr and node.parts.length =? 2 {
        let keyword = contexts.node_at(node.parts[0] env.lexical session)
        if keyword is? tokens.Keyword and keyword.name in? ['let' 'const'] { node = contexts.node_at(node.parts[1] env.lexical session) explicit=true }
    }
    if node isnt? parser.BinOp or source_views.symbol(node.op env.lexical session) not in? ['=' '::' ':='] return none
    let name = source_views.identifier(node.left env.lexical session)
    let literal = contexts.node_at(node.right env.lexical session)
    if name is? none or literal isnt? parser.BinOp or not source_views.is_operator(literal.op '=>' env.lexical session) return none
    # A complete function signature does not turn assignment to an existing
    # binding into a declaration. Alias collection follows this same rule.
    if not explicit and declarations.lookup(name env.lexical session) isnt? none return none
    let signature = contexts.node_at(literal.left env.lexical session)
    if signature isnt? parser.BinOp or not source_views.is_operator(signature.op ':>' env.lexical session) return none
    let shape = function_shape(literal env @session)
    if shape is? Error return shape
    let signature_type = dispatch.method_at(session.types shape)
    if signature_type.type_params.length =? 0 {
        # A default is part of collecting a complete signature in the hosted
        # checker. If it needs a value whose type is not available yet, leave
        # this declaration in source order; only its body may be deferred.
        # Generic defaults remain attached to their instantiable source.
        let arguments=contexts.node_at(signature.left env.lexical session)
        let rows:array<addr>=if arguments is? parser.Block arguments.inner else [signature.left]
        loop i in 0.. and i <? rows.length and i <? signature_type.pos_or_kw.length {
            let parsed=declarations.parameter_source(rows[i] env.lexical session)
            if parsed is? Error return parsed
            if parsed.default isnt? none {
                let value=expression(parsed.default env @session expected=signature_type.pos_or_kw[i].value_type)
                if value is? Error return none
            }
        }
    }
    let scope = bindings.scope_at(session.scopes env.lexical.scope)
    if name in? scope.names return problem(id "duplicate declaration `{name}`" 'this scope already declares the name' env session)
    let reference = contexts.syntax_ref(id env.lexical @session)
    let binding_id = bindings.allocate(@session.registry reference name 'function' node.loc)
    let binding = bindings.binding_at(session.registry binding_id)
    binding.value_type = shape binding.store_type = shape
    binding.proof=is_proof_literal(literal env session)
    if binding.proof {binding.read_only_reason='is a proof declaration and cannot be reassigned'}
    binding.literal_path_parameter=source_views.path_parameter(literal env.lexical session)
    if signature_type.type_params.length >? 0 {
        let literal_ref = contexts.syntax_ref(node.right env.lexical @session)
        session.retained_read_states.add(env.state)
        binding.function = put(hir.GenericFunction[literal.loc shape name hir.GenericSource[literal_ref env.state signature_type.type_params]] @session)
    }
    bindings.store_binding(@session.registry binding_id binding)
    bindings.bind(@session.scopes env.lexical.scope name binding_id)
    return none
}
# An unannotated literal parameter takes the corresponding expected slot's
# input type. The parameter's own spelling remains its lexical name. Explicit
# annotations and place parameters keep their declared contracts; generic
# expected functions require their own instantiation before contextual use.
contextual_parameters = (literal:parser.BinOp shape:types.FunctionType expected:addr? env:Environment session:contexts.Session):>array<types.PosOrKwArg> => {
    let parameters=shape.pos_or_kw
    if expected is? none return parameters
    let wanted=types.node_at(session.types types.strip_refinement(expected session.types))
    if wanted isnt? types.FunctionType or wanted.type_params.length >? 0 return parameters
    let signature=contexts.node_at(literal.left env.lexical session)
    let parameter_id=if signature is? parser.BinOp and source_views.is_operator(signature.op ':>' env.lexical session) signature.left else literal.left
    let syntax=contexts.node_at(parameter_id env.lexical session)
    let rows:array<addr>=if syntax is? parser.Block syntax.inner else [parameter_id]
    loop i in 0.. and i <? parameters.length and i <? wanted.pos_or_kw.length and i <? rows.length {
        let parameter=parameters[i]
        # Defaults already supply a concrete inferred type in function_args.
        if parameter.place or not parameter.required continue
        let parsed=declarations.parameter_source(rows[i] env.lexical session)
        if parsed is? Error or parsed.annotation isnt? none continue
        let type=types.strip_refinement(wanted.pos_or_kw[i].value_type session.types)
        if types.is_primitive(types.node_at(session.types type) 'any') continue
        parameters[i]=types.PosOrKwArg[parameter.name type parameter.required parameter.place]
    }
    return parameters
}

function_literal = (id:addr literal:parser.BinOp env:Environment @session:contexts.Session concrete:bool=false name:string='<anonymous>' method:contexts.MethodEntry?=none owner:addr?=none expected_signature:addr?=none):>addr|Error => {
    let first=session.read_states.length
    let collectors=session.return_collectors.length
    let result=function_literal_inner(id literal env @session concrete=concrete name=name method=method owner=owner expected_signature=expected_signature)
    contexts.release_read_states(first @session)
    session.return_collectors.truncate(collectors)
    return result
}
function_literal_inner = (id:addr literal:parser.BinOp env:Environment @session:contexts.Session concrete:bool=false name:string='<anonymous>' method:contexts.MethodEntry?=none owner:addr?=none expected_signature:addr?=none):>addr|Error => {
    let resolved = function_shape(literal env @session concrete=concrete)
    if resolved is? Error return resolved
    let shape = dispatch.method_at(session.types resolved)
    if shape.type_params.length >? 0 {
        if name =? '<anonymous>' return problem(id 'a generic function must be declared with `let`' 'its instances are created where it is called by name' env session)
        let reference = contexts.syntax_ref(id env.lexical @session)
        session.retained_read_states.add(env.state)
        return put(hir.GenericFunction[literal.loc resolved name hir.GenericSource[reference env.state shape.type_params]] @session)
    }
    shape.pos_or_kw=contextual_parameters(literal shape expected_signature env session)
    let effect_contract=shape.effects
    let inferred_effect=shape.inferred_effect
    let contract=shape.ret
    if expected_signature isnt? none {
        let required=types.node_at(session.types types.strip_refinement(expected_signature session.types))
        if required is? types.FunctionType and required.type_params.length =? 0 {
            contract=contracts.adopt(contract required shape.pos_or_kw @session.types)
            if inferred_effect isnt? none and required.effects isnt? none and (required.inferred_effect isnt? none or not effect_inference.pending(required.effects)) {
                effect_contract=required.effects
                inferred_effect=required.inferred_effect
            }
        }
    }
    let infer=types.is_primitive(types.node_at(session.types contract) 'untyped')
    let collector=session.return_collectors.length
    session.return_collectors.push(contexts.ReturnCollector[])
    let annotation:addr?=if infer none else contract
    # The function runs at a later call, not at its declaration (or the end
    # of this block, when deferred bodies are checked). Captured bindings
    # retain their declared types, but caller flow narrowing does not cross
    # this boundary. Only the existing immutable-container facts survive.
    let function_state=session.read_states.length
    session.read_states.push(contexts.ReadState[keys=container_state.inherited(env.state session)])
    let defining=Environment[env.lexical function_state control=function_control(env.control)]
    let inner = Environment[contexts.child(env.lexical @session) function_state annotation control=function_control(env.control) return_collector=collector]
    let parameters:array<hir.Param> = []
    let signature = contexts.node_at(literal.left env.lexical session)
    let parameter_id=if signature is? parser.BinOp and source_views.is_operator(signature.op ':>' env.lexical session) signature.left else literal.left
    let prefix = contexts.node_at(parameter_id env.lexical session)
    if prefix is? parser.BinOp and source_views.is_operator(prefix.op 'TypeParamJuxtapose' env.lexical session) { parameter_id = prefix.right }
    let arguments = contexts.node_at(parameter_id env.lexical session)
    let source_rows:array<addr> = if arguments is? parser.Block arguments.inner else [parameter_id]
    # The `...` divider is not a parameter; keyword-only rows follow it.
    let rows:array<addr> = []
    loop row in source_rows { if not declarations.is_divider(row env.lexical session) { rows.push(row) } }
    let position:addr = 0
    let positional_count = shape.pos_or_kw.length
    let parameter_slots:array<types.PosOrKwArg> = []
    loop param in shape.pos_or_kw { parameter_slots.push(param) }
    loop param in shape.kw_only { parameter_slots.push(types.PosOrKwArg[param.name param.value_type param.required param.place]) }
    loop param in parameter_slots {
        $runtime_assert position <? rows.length
        let parsed=declarations.parameter_source(rows[position] env.lexical session)
        if parsed is? Error return parsed
        let scope = bindings.scope_at(session.scopes inner.lexical.scope)
        if parsed.name in? scope.names return problem(id 'duplicate function parameter' parsed.name env session)
        # Defaults run in the callee but resolve in the defining outer scope,
        # as in the hosted checker. BoundParam retains the checked expression
        # without evaluating it while declaring the function.
        let default:addr? = none
        if parsed.default isnt? none {
            let value = expression(parsed.default defining @session expected=param.value_type)
            if value is? Error return value
            default = value
        }
        position += 1
        let binding_id = bindings.allocate_param(@session.registry parsed.name param.value_type literal.loc)
        let binding = bindings.binding_at(session.registry binding_id)
        binding.store_type = param.value_type
        bindings.store_binding(@session.registry binding_id binding)
        bindings.bind(@session.scopes inner.lexical.scope parsed.name binding_id)
        if default is? none { parameters.push(hir.Param[parsed.name param.value_type binding_id position_only=parsed.position_only place=param.place]) }
        else { parameters.push(hir.BoundParam[parsed.name param.value_type binding_id position_only=parsed.position_only value=default place=param.place]) }
    }
    # Parameter defaults above retain the defining scope. The body sees
    # member proxies in a parent of its parameter scope, so local bindings
    # and nested function parameters shadow members by ordinary lookup.
    loop i in 0.. and i <? parameters.length {
        let param=parameters[i]
        let resolved=contracts.bind_parameters(param.value_type parameters @session.types @session.registry)
        param.value_type=resolved
        parameters[i]=param
        if param.binding_id isnt? none {
            let binding=bindings.binding_at(session.registry param.binding_id)
            binding.value_type=resolved
            binding.store_type=resolved
            bindings.store_binding(@session.registry param.binding_id binding)
        }
    }
    let keyword_parameters:array<hir.Param> = []
    if parameters.length >? positional_count {
        let positional:array<hir.Param> = []
        loop i in 0.. and i <? parameters.length { if i <? positional_count { positional.push(parameters[i]) } else { keyword_parameters.push(parameters[i]) } }
        parameters=positional
    }
    if method isnt? none and owner isnt? none {
        let member_scope=contexts.child(env.lexical @session)
        let receiver:addr?=none
        if method.receiver_type isnt? none {
            let receiver_type=method.receiver_type
            let receiver_id=bindings.allocate_param(@session.registry '__dewy_receiver' receiver_type literal.loc)
            if method.lifecycle =? 'copy' {
                let binding=bindings.binding_at(session.registry receiver_id)
                binding.read_only_reason='is the read-only receiver of a copy hook'
                bindings.store_binding(@session.registry receiver_id binding)
            }
            receiver=put(hir.ExpressedIdentifier[literal.loc receiver_type '__dewy_receiver' receiver_id] @session)
            let with_receiver:array<hir.Param>=[hir.Param['__dewy_receiver' receiver_type receiver_id place=method.place_self]]
            loop parameter in parameters {with_receiver.push(parameter)}
            parameters=with_receiver
        }
        let error=bind_method_members(owner receiver member_scope env @session)
        if error isnt? none return error
        let parameter_scope=bindings.scope_at(session.scopes inner.lexical.scope)
        parameter_scope.parent=member_scope.scope
        $runtime_assert inner.lexical.scope <? session.scopes.length
        session.scopes[inner.lexical.scope]=parameter_scope
    }
    let all_parameters=parameters
    loop param in keyword_parameters {all_parameters.push(param)}
    if not infer {
        let unknown=contracts.unknown_parameter(contract all_parameters session.types)
        if unknown isnt? none return problem(id 'result fact names something that is not a parameter' unknown env session)
        contract=contracts.bind_parameters(contract all_parameters @session.types @session.registry)
        annotation=contract
        inner=Environment[inner.lexical inner.state contract inner.control inner.return_collector]
    }
    # A void fact contract is checked at normal exits, including an empty
    # body or an if without an else. It is not a value supplied by the last
    # statement. Explicit returns already check the same contract above.
    let promised=types.node_at(session.types contract)
    let void_contract=promised is? types.RefinedType and types.is_primitive(types.node_at(session.types promised.base) 'void')
    let body=expression(literal.right inner @session expected=if void_contract none else annotation)
    if body is? Error return body
    let result=infer_function_result(body literal.right inner @session)
    if result is? Error return result
    if not infer and not subtyping.is_subtype(types.strip_refinement(result session.types) types.strip_refinement(contract session.types) session.links @session.types) return problem(id 'function body does not provide its result' display.type_to_dewy(contract session.types) env session)
    if void_contract {
        let empty=void_at(literal.right inner @session)
        let obligation=against(empty contract literal.right inner @session)
        if obligation is? Error return obligation
        let original=node_at(body session)
        body=put(hir.Block[original.loc original.value_type [body obligation] false] @session)
    }
    let returns=if infer result else contract
    $runtime_assert collector <? session.return_collectors.length
    if infer and session.return_collectors[collector].sites.length =? 0 and types.is_primitive(types.node_at(session.types returns) 'bool') {
        let predicate=inferred_results.predicate(body all_parameters @session)
        if predicate isnt? none {returns=predicate}
    }
    let slots:array<types.PosOrKwArg>=[]
    if method isnt? none and method.receiver_type isnt? none {
        slots.push(types.PosOrKwArg['__dewy_receiver' method.receiver_type true method.place_self])
        # This body's inference variable is defined with the complete
        # parameter list, including the receiver. Only a written contract
        # still names the source slots and needs their indices shifted.
        if inferred_effect is? none {
            effect_contract=effect_rows.prepend_parameter(effect_contract shape.pos_or_kw.length+shape.kw_only.length)
        }
    }
    loop slot in shape.pos_or_kw {slots.push(slot)}
    let function_type=types.function_type(slots shape.kw_only shape.rest returns [] @session.types effects=effect_contract inferred_effect=inferred_effect)
    let value=put(hir.FunctionLiteral[literal.loc function_type parameters keyword_parameters none returns body source=env.lexical.source proof=is_proof_literal(literal env session) lifecycle=if method is? none none else method.lifecycle] @session)
    return if expected_signature is? none value else against(value expected_signature id env @session)
}

# A type test selects a read alternative; it does not alter the binding's
# store contract. Disjoint alternatives disappear, and a positive test of a
# broad nominal family selects the tested descendant itself.
select_type = (current:addr tested:addr truth:bool @session:contexts.Session):>addr => {
    let node = types.node_at(session.types current)
    if node is? types.MetaType {
        # `kind is? Whitespace`: the type value names a type under `Whitespace`
        let target=types.node_at(session.types types.unfold(tested session.types))
        if truth and target is? types.ObjectType and target.minted and target.brand isnt? none return types.meta_type(types.unfold(tested session.types) @session.types)
        return current
    }
    if node is? types.TypeOr {
        let members:array<addr> = []
        loop member in node.items { members.push(select_type(member tested truth @session)) }
        return subtyping.join(members session.links @session.types)
    }
    # A test of A|B has one successful route per alternative; failure
    # excludes both. Distribute before intersecting with earlier exclusions,
    # so a family narrowed by successive tests still exposes its selected
    # record layouts (rather than an opaque Family & (A|B) conjunction).
    let target=types.node_at(session.types types.unfold(tested session.types))
    if target is? types.TypeOr {
        if truth {
            let members:array<addr>=[]
            loop member in target.items {members.push(select_type(current member true @session))}
            return subtyping.join(members session.links @session.types)
        }
        let remaining=current
        loop member in target.items {remaining=select_type(remaining member false @session)}
        return remaining
    }
    if subtyping.is_subtype(current tested session.links @session.types) return if truth current else types.primitive('never' @session.types)
    let overlap = types.intersect([current tested] @session.types)
    if subtyping.is_empty(overlap session.links @session.types) return if truth types.primitive('never' @session.types) else current
    if truth and subtyping.is_subtype(tested current session.links @session.types) return tested
    return if truth overlap else types.intersect([current types.negate(tested @session.types)] @session.types)
}
# Only a search emitted directly before its branch has a reusable result
# slot there. Nested short-circuit searches still prove membership, but the
# enclosing continuation must perform its own lookup for the position.
hoist_condition = (condition:addr @session:contexts.Session):>void => {
    let value=node_at(condition session)
    if value is? hir.DictContains {
        $runtime_assert condition <? session.hir.length
        contexts.replace_hir(condition hir.DictContains[value.loc value.value_type value.keys value.key value.position true] @session)
    }
}
refined = (condition:addr truth:bool env:Environment @session:contexts.Session invalidated:set<addr>=set[] moved:set<addr>=set[]):>Environment => {
    let result = fork(env @session)
    let node = node_at(condition session)
    if node is? hir.ValueCast return refined(node.expr truth result @session invalidated=invalidated moved=moved)
    if invalidated.length >? 0 and node isnt? hir.ShortCircuit {
        loop binding in predicate_effects.read_bindings(condition session.hir) {
            if binding in? invalidated return result
        }
    }
    if node is? hir.FunctionCall and node.pos_args.length =? 1 {
        let func = node_at(node.func session)
        if func is? hir.ExpressedIdentifier and func.name =? '__not__' return refined(node.pos_args[0] not truth result @session invalidated=invalidated moved=moved)
    }
    if node is? hir.FunctionCall {
        # Promises name the callee's parameters; source reads must refine the
        # corresponding caller binding, including named arguments and places.
        loop returned in hir_facts.call_result_refinements(condition session.hir session.types) {
            loop promise in returned.propositions {
                if promise.when isnt? none and promise.when not=? truth continue
                if promise.tested_type is? none or promise.op not in? ['is?' 'isnt?'] continue
                let name=propositions.parameter(promise)
                if name is? none continue
                let actual=hir_facts.call_argument(condition name session.hir session.types)
                if actual is? none continue
                let route=bindings.array_route_id(hir_facts.strip_casts(actual session.hir) session.hir @session.registry)
                if route isnt? none {
                    let current=read_type(route result session fallback=node_at(actual session).value_type)
                    $runtime_assert current isnt? none
                    set_read_type(route select_type(current promise.tested_type promise.op =? 'is?' @session) result @session)
                }
            }
        }
    }
    if node is? hir.DictContains and truth {
        let array = node_at(node.keys session)
        if array is? hir.MemberAccess {
            let position = if node.hoisted node.position else none
            loop binding in predicate_effects.read_bindings(node.keys session.hir) { if binding in? moved { position = none break } }
            container_state.remember(array.value node.key result.state @session position=position)
        }
    }
    if node is? hir.TypeTest {
        # Fields and literal/const-selected elements have stable route ids.
        # Only the branch's read alternatives change, never the storage type.
        let route=bindings.array_route_id(node.value session.hir @session.registry)
        if route isnt? none {
            let current = read_type(route result session fallback=node_at(node.value session).value_type)
            $runtime_assert current isnt? none
            set_read_type(route select_type(current node.test_type truth not=? node.negated @session) result @session)
        }
    }
    if node is? hir.ShortCircuit {
        let effective_truth = if node.op in? ['nand' 'nor'] not truth else truth
        let conjunction = node.op in? ['and' 'nand']
        if effective_truth =? conjunction {
            let changed = invalidated
            loop binding in predicate_effects.mutated_bindings(node.right session.hir) { changed.add(binding) }
            let compacted = moved
            loop binding in predicate_effects.compacted_bindings(node.right session.hir) { compacted.add(binding) }
            result = refined(node.left effective_truth result @session invalidated=changed moved=compacted)
            result = refined(node.right effective_truth result @session invalidated=invalidated moved=moved)
        }
    }
    return result
}
# Lengths established by branches are facts about one array's current value,
# not different storage alternatives. Preserve an agreed exact length; when
# they differ, retain the shared element contract and let bounds analysis
# join the numeric length facts. Different element contracts remain a union.
array_read_join = (alternatives:array<addr> @session:contexts.Session):>addr? => {
    if alternatives.length =? 0 return none
    let first=types.node_at(session.types types.unfold(types.strip_refinement(alternatives[0] session.types) session.types))
    if first isnt? types.ArrayType return none
    let length=first.length
    loop alternative in alternatives {
        let type=types.node_at(session.types types.unfold(types.strip_refinement(alternative session.types) session.types))
        if type isnt? types.ArrayType or not types.same_type(type.element first.element session.types) return none
        if type.length not=? length {length=none}
    }
    return types.array_type(first.element length @session.types)
}
join_reads = (exits:array<Environment> env:Environment @session:contexts.Session):>void => {
    if exits.length =? 0 return void
    let names:set<addr> = set[]
    loop exit in exits {
        $runtime_assert exit.state <? session.read_states.length
        loop [binding type] in session.read_states[exit.state].types { names.add(binding) }
    }
    let joined = contexts.ReadState[]
    let first = true
    loop exit in exits {
        let current = container_state.facts(exit.state session)
        joined.keys = if first current else keys.intersect(joined.keys current)
        first = false
    }
    loop binding in names {
        let alternatives:array<addr> = []
        loop exit in exits {
            let type = read_type(binding exit session)
            if type isnt? none { alternatives.push(type) }
        }
        if alternatives.length =? exits.length {
            let array=array_read_join(alternatives @session)
            let result=if array is? none subtyping.join(alternatives session.links @session.types) else array
            let original=read_type(binding env session)
            # A join can encounter the same union alternatives in another
            # order (for example a record assignment before the zero arm).
            # When the value set is unchanged, retain the incoming union's
            # representation and prelude identity instead of inventing a
            # reordered tagged type. Strictly narrower joins still survive.
            if original isnt? none and types.node_at(session.types original) is? types.TypeOr and subtyping.is_subtype(original result session.links @session.types) and subtyping.is_subtype(result original session.links @session.types) {result=original}
            # A family split by `is? Child` rejoins to the same family.
            # The negative arm is represented explicitly as T & ~Child;
            # retaining Child | (T & ~Child) here would invent tagged storage
            # and hide ordinary family members such as `.typename`.
            if original isnt? none and types.node_at(session.types original) is? types.ObjectType and subtyping.is_subtype(original result session.links @session.types) {
                let covered=true
                loop alternative in alternatives {
                    if not subtyping.covered(views.structural_base(alternative session.types) original set[] session.links @session.types) {covered=false break}
                }
                if covered {result=original}
            }
            # A literal narrowed out of an integer word (`picked:1|2|3` is a
            # refined `int64`) rejoins that word: `3 | int64<1..3>` would
            # invent a tagged cell for storage that is one integer.
            if original isnt? none and views.fixed_integer_layout(original session.types) isnt? none and result not=? original and subtyping.is_subtype(result original session.links @session.types) {result=original}
            joined.types[binding]=result
        }
    }
    $runtime_assert env.state <? session.read_states.length
    session.read_states[env.state] = joined
}
flow = (id:addr node:parser.Flow env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let first=session.read_states.length
    let result=flow_inner(id node env @session expected=expected)
    contexts.release_read_states(first @session)
    return result
}
flow_inner = (id:addr node:parser.Flow env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    if node.arms.length =? 1 and node.default is? none {
        let arm = contexts.node_at(node.arms[0] env.lexical session)
        if arm is? parser.KeywordExpr and arm.parts.length =? 3 {
            let keyword = contexts.node_at(arm.parts[0] env.lexical session)
            if keyword is? tokens.Keyword and keyword.name =? 'loop' return loop_flow(id arm env @session)
        }
    }
    let specs:array<FlowSpec>=[]
    let prelude:array<addr>=[]
    let has_match=false
    let match_total=false
    let uncovered:string?=none
    loop arm_id in node.arms {
        let arm=contexts.node_at(arm_id env.lexical session)
        if arm isnt? parser.KeywordExpr or arm.parts.length not=? 3 return pending(arm_id 'this conditional arm' env session)
        let keyword=contexts.node_at(arm.parts[0] env.lexical session)
        if keyword isnt? tokens.Keyword return pending(arm_id 'this conditional keyword' env session)
        if keyword.name =? 'match' {
            has_match=true
            let plan=match_plan(arm env @session)
            if plan is? Error return plan
            loop spec in plan.specs {specs.push(spec)}
            loop declaration in plan.prelude {prelude.push(declaration)}
            match_total=match_total or plan.total
            loop coordinate in plan.coverage {
                loop member in coordinate.members {
                    if not patterns.full(member) and uncovered is? none {uncovered=patterns.uncovered(member session)}
                    if plan.total and node.default is? none and member.brands isnt? none and not member.full {
                        let family=patterns.family(member.value_type session.types)
                        $runtime_assert family isnt? none
                        let shape=types.node_at(session.types family)
                        $runtime_assert shape is? types.ObjectType and shape.brand isnt? none
                        session.pending_brand_matches.push(contexts.PendingBrandMatch[env.lexical arm_id shape.brand member.covered_brands])
                    }
                }
            }
        } else if keyword.name =? 'if' {specs.push(FlowSpec[arm_id arm.parts[2] condition=arm.parts[1]])}
        else if keyword.name =? 'loop' {specs.push(FlowSpec[arm_id arm.parts[2] condition=arm.parts[1] is_loop=true])}
        else return pending(arm_id 'this flow-chain keyword' env session)
    }
    if has_match and not match_total and node.default is? none return problem(id 'match is not exhaustive' if uncovered is? none 'the arms do not cover the scrutinee' else "{uncovered} is not handled by any arm" env session)
    let remaining=fork(env @session)
    let arms:array<addr>=[]
    let results:array<addr>=[]
    let exits:array<Environment>=[]
    let selected=false
    loop spec in specs {
        if spec.is_loop {
            # Reuse the ordinary loop's mutation invalidation and iterator
            # scope. Later alternatives see its condition fail before the
            # first iteration; exits from an entered loop skip those arms.
            let syntax=contexts.node_at(spec.syntax remaining.lexical session)
            $runtime_assert syntax is? parser.KeywordExpr
            let checked=loop_flow(spec.syntax syntax remaining @session)
            if checked is? Error return checked
            let checked_flow=node_at(checked session)
            $runtime_assert checked_flow is? hir.Flow and checked_flow.arms.length =? 1
            let arm=node_at(checked_flow.arms[0] session)
            $runtime_assert arm is? hir.LoopArm
            arms.push(checked_flow.arms[0])
            if not types.is_primitive(types.node_at(session.types arm.value_type) 'never') {results.push(arm.value_type) exits.push(fork(remaining @session))}
            remaining=refined(arm.condition false remaining @session)
            continue
        }
        let condition=if spec.condition is? none match_condition(spec remaining @session) else expression(spec.condition remaining @session expected=types.primitive('bool' @session.types))
        if condition is? Error return condition
        let decided=target_values.unwrap(condition session.hir)
        if decided is? hir.TargetBool|hir.DecidedBool {
            if not decided.value continue
            # Platform declarations inhabit the surrounding lexical scope.
            # Runtime flows and static type decisions keep their own scope.
            let syntax=contexts.node_at(spec.body env.lexical session)
            if decided is? hir.TargetBool and expected is? none and syntax is? parser.Block and syntax.delims =? '\{}' {
                let body=block(spec.body env @session)
                if body is? Error return body
                let contents=node_at(body session)
                $runtime_assert contents is? hir.Block
                return put(hir.Block[contents.loc types.primitive('void' @session.types) contents.items false] @session)
            }
            selected=true
        }
        hoist_condition(condition @session)
        let positive=refined(condition true remaining @session)
        let body=if spec.condition is? none match_body(spec positive @session expected=expected) else expression(spec.body positive @session expected=expected)
        if body is? Error return body
        let type=node_at(body session).value_type
        arms.push(put(hir.IfArm[contexts.node_at(spec.syntax env.lexical session).loc type condition body] @session))
        if not types.is_primitive(types.node_at(session.types type) 'never') {results.push(type) exits.push(positive)}
        remaining=refined(condition false remaining @session)
        if selected break
    }
    let default:addr?=none
    if selected or match_total and node.default is? none {
        $runtime_assert arms.length >? 0
        let last=node_at(arms.pop session)
        $runtime_assert last is? hir.IfArm
        default=last.body
    } else if node.default isnt? none {
        let checked=expression(node.default remaining @session expected=expected)
        if checked is? Error return checked
        default=checked
        let type=node_at(checked session).value_type
        if not types.is_primitive(types.node_at(session.types type) 'never') {results.push(type) exits.push(remaining)}
    } else {exits.push(remaining)}
    join_reads(exits env @session)
    let type=if default is? none types.primitive('void' @session.types) else flow_value_type(results id env @session)
    if type is? Error return type
    let value=if arms.length =? 0 and default isnt? none default else put(hir.Flow[node.loc type arms default] @session)
    if prelude.length =? 0 return value
    prelude.push(value)
    return put(hir.Block[node.loc node_at(value session).value_type prelude false] @session)
}

# An absent argument block denotes an implicit zero-argument construction;
# callers need no synthesized parser node merely to express an empty list.
source_arguments = (id:addr? env:Environment session:contexts.Session):>array<addr> => {
    if id is? none return []
    let arguments=contexts.node_at(id env.lexical session)
    return if arguments is? parser.Block arguments.inner else [id]
}
call_syntax = (function:addr arguments_id:addr? id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let items=source_arguments(arguments_id env session)
    let signature = types.node_at(session.types node_at(function session).value_type)
    let callee=node_at(function session)
    # Match the hosted output path: the ordinary generic print receives each
    # interpolation part in source order. Numeric families keep their print
    # protocols; a materialized string still requires a string conversion.
    if callee is? hir.ExpressedIdentifier and callee.name in? ['print' 'printl'] and signature is? types.FunctionType and signature.type_params.length >? 0 and items.length =? 1 {
        let source=contexts.node_at(items[0] env.lexical session)
        if source is? parser.IString {
            let value=interpolated_string(items[0] source env @session for_output=true)
            if value is? Error return value
            let interpolation=node_at(value session)
            $runtime_assert interpolation is? hir.InterpolatedString
            let parts=interpolation.parts
            if callee.name =? 'printl' {parts.push(put(hir.String[source.loc types.string_literal('\n' @session.types) '\n'] @session))}
            let statements:array<addr>=[]
            loop part in parts {
                let printed=library_call('print' [part] id env @session)
                if printed is? Error return printed
                statements.push(printed)
            }
            let result=put(hir.Block[contexts.node_at(id env.lexical session).loc types.primitive('void' @session.types) statements false] @session)
            return if expected is? none result else against(result expected id env @session)
        }
    }
    let positional:array<addr> = []
    let keyword:dict<string addr> = []
    let order:array<string?>=[]
    let bound:set<addr>=set[]
    let interleaved=false
    loop item in items {
        let row = contexts.node_at(item env.lexical session)
        if row is? parser.BinOp and source_views.is_operator(row.op '=' env.lexical session) {
            let name = source_views.identifier(row.left env.lexical session)
            if name is? none return problem(item 'named argument needs a name' 'use `name=value`' env session)
            if name in? keyword return problem(item 'duplicate named argument' name env session)
            let wanted:addr? = none
            if signature is? types.FunctionType and signature.type_params.length =? 0 {
                loop param in signature.pos_or_kw { if param.name =? name and not param.place { wanted = param.value_type } }
                loop param in signature.kw_only { if param.name =? name and not param.place { wanted = param.value_type } }
            }
            let value = expression(row.right env @session expected=wanted allow_place=true)
            if value is? Error return value
            keyword[name] = value
            order.push(name)
            if signature is? types.FunctionType {
                loop i in 0.. and i <? signature.pos_or_kw.length {if signature.pos_or_kw[i].name =? name {bound.add(i)}}
            }
        } else {
            if keyword.length >? 0 {interleaved=true}
            let index:addr=0
            if signature is? types.FunctionType {loop index <? signature.pos_or_kw.length and index in? bound {index+=1}}
            let wanted:addr? = none
            if signature is? types.FunctionType and signature.type_params.length =? 0 and index <? signature.pos_or_kw.length {
                let param = signature.pos_or_kw[index]
                if not param.place { wanted = param.value_type }
            }
            let value = expression(item env @session expected=wanted allow_place=true)
            if value is? Error return value
            positional.push(value)
            order.push(none)
            bound.add(index)
        }
    }
    return call(function positional keyword id env @session expected=expected order=if interleaved order else [])
}

# The index scope binds `end` to this sequence's last position. Its binding
# is lexical and disappears after the index; a nested index gets its own end.
index_syntax = (sequence:addr index_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    # Prefix @ may sit to the left of juxtaposed brackets. Project the
    # storage first and retain the place wrapper around the selected element.
    let source=node_at(sequence session)
    if source is? hir.Place {
        let selected=index_syntax(source.target index_id id env @session)
        if selected is? Error return selected
        return place(selected id env @session)
    }
    sequence=binary_array(sequence @session)
    if views.container_entry_types(node_at(sequence session).value_type session.types) isnt? none return container_index(sequence index_id id env @session)
    let arguments = contexts.node_at(index_id env.lexical session)
    let item = index_id
    if arguments is? parser.Block {
        if arguments.inner.length not=? 1 return problem(id 'index requires one expression' 'select one element, or use a range for a slice' env session)
        item = arguments.inner[0]
    }
    let value = node_at(sequence session)
    let type = types.node_at(session.types types.strip_refinement(value.value_type session.types))
    let string = views.string_valued(value.value_type session.types)
    if type isnt? types.ArrayType and not string return problem(id 'index target is not an array or string' display.type_to_dewy(value.value_type session.types) env session)
    let length:addr? = none
    if type is? types.ArrayType|types.StringType { length = type.length }
    else if type is? types.StringLiteralType { length = type.value.length }
    let loc = contexts.node_at(id env.lexical session).loc
    let word = types.primitive('int64' @session.types)
    let last:addr = 0
    if length isnt? none {
        let number:bigint = length-1
        last = put(hir.Integer[loc types.integer_literal(number @session.types) '0d' number] @session)
    } else {
        let count = put(if string hir.StringLength[loc word sequence] else hir.ArrayLength[loc word sequence] @session)
        let one = put(hir.Integer[loc word '0d' 1] @session)
        let subtract = identifier('__sub__' id env @session)
        if subtract is? Error return subtract
        let computed = call(subtract [count one] [] id env @session)
        if computed is? Error return computed
        last = computed
    }
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector]
    let binding_id = bindings.allocate_param(@session.registry 'end' node_at(last session).value_type loc)
    let binding = bindings.binding_at(session.registry binding_id)
    binding.replacement = last binding.read_only_reason = 'sequence index end'
    bindings.store_binding(@session.registry binding_id binding)
    bindings.bind(@session.scopes inner.lexical.scope 'end' binding_id)
    let index = expression(item inner @session)
    if index is? Error return index
    let checked = node_at(index session)
    let route = bindings.array_route_id(sequence session.hir @session.registry)
    if checked is? hir.Range {
        let range:hir.Range=checked
        let range_index:addr=index
        # A range written directly in the index takes its open/closed ends
        # from the indexing delimiters. An explicitly nested range already
        # has its own bounds and keeps them (`text[(a..b]]`, for example).
        if range.bounds is? none and arguments is? parser.Block {
            let bounds=arguments.delims
            $runtime_assert bounds is? '[]'|'[)'|'(]'|'()'
            range=hir.Range[range.loc range.value_type bounds range.step_pair range.left range.right]
            range_index=put(range @session)
        }
        return sequence_slice(sequence range_index range type length route id env @session)
    }
    if not subtyping.is_subtype(checked.value_type types.primitive('int' @session.types) session.links @session.types) return problem(item 'array index must be an integer' display.type_to_dewy(checked.value_type session.types) env session)
    if length is? none and route is? none return problem(id 'sequence index is not proven in bounds' 'this sequence does not have an exact compile-time length or a stable storage route' env session)
    let position = constant_integer(index session)
    if position isnt? none and (position <? 0 or length isnt? none and position >=? length) return problem(item 'array index is out of bounds' 'this index is outside the sequence' env session)
    let constant:addr? = none
    if position isnt? none {
        if position >? targets.max_length(session.target) return problem(item 'array index exceeds the target address space' 'no sequence on this target can contain this position' env session)
        $runtime_assert position >=? 0 and position <=? targets.max_length(session.target)
        constant = position as addr
    }
    if type is? types.ArrayType return projected_read(put(hir.Index[loc type.element sequence index constant] @session) env @session)
    return put(hir.StringIndex[loc types.string_type(1 @session.types) sequence index constant] @session)
}

sequence_slice = (sequence:addr index:addr range:hir.Range type:types.Type length:addr? route:addr? id:addr env:Environment @session:contexts.Session):>addr|Error => {
    if range.step_pair isnt? none return pending(id 'stepped sequence slicing' env session)
    let string = views.string_valued(node_at(sequence session).value_type session.types)
    if length is? none and (range.left isnt? none or range.right isnt? none) and not string return problem(id 'sequence slice is not proven in bounds' 'bounded slicing requires a known sequence length' env session)
    let start:bigint? = none
    let stop:bigint? = none
    let count:addr? = none
    if length isnt? none {
        start = if range.left is? none 0 else constant_integer(range.left session)
        stop = if range.right is? none length-1 else constant_integer(range.right session)
        if start isnt? none and stop isnt? none {
            let bounds = if range.bounds is? none '[]' else range.bounds
            if bounds =? '(]' or bounds =? '()' { start += 1 }
            if bounds =? '[)' or bounds =? '()' { stop -= 1 }
            if start <? 0 or start >? length or stop <? -1 or stop >=? length return problem(id 'sequence slice is out of bounds' 'this slice is outside the sequence' env session)
            count = if stop <? start 0 else (stop-start+1) as addr
        }
    }
    let loc = contexts.node_at(id env.lexical session).loc
    if string return put(hir.StringSlice[loc types.string_type(count @session.types) sequence index] @session)
    $runtime_assert type is? types.ArrayType
    if count is? none or start is? none or stop is? none or length is? none return problem(id 'sequence slice is not proven in bounds' 'dynamic array slices require a runtime-sized result, which is not implemented yet' env session)
    if node_at(sequence session) isnt? hir.ExpressedIdentifier return pending(id 'slicing an array expression with runtime evaluation' env session)
    let items:array<addr> = []
    $runtime_assert start >=? 0 and start <=? length and stop >=? -1 and stop <? length
    let position:addr = start as addr
    loop position <=? stop {
        let constant = position as addr
        let value = put(hir.Integer[loc types.integer_literal(position @session.types) '0d' position] @session)
        items.push(put(hir.Index[loc type.element sequence value constant] @session))
        position += 1
    }
    return put(hir.ArrayLiteral[loc types.array_type(type.element count @session.types) items] @session)
}

# Field reads preserve their receiver expression. The route registry can later
# attach stable fact identities without evaluating the receiver a second time.
member = (receiver:addr name_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let name = source_views.identifier(name_id env.lexical session)
    if name is? none return problem(id 'member access needs a name' 'expected a field or method name' env session)
    return member_named(receiver name id env @session)
}
copy_method = (receiver:addr loc:Span @session:contexts.Session):>addr => {
    let signature=types.function_type([] [] none node_at(receiver session).value_type [] @session.types)
    return put(hir.CopyMethod[loc signature receiver] @session)
}
# A union's builtin copy snapshots the active alternative. An explicitly
# declared member still wins: do not silently replace it with this operation.
builtin_copy_available = (id:addr nodes:types.Table):>bool => {
    let type=types.node_at(nodes views.structural_base(id nodes))
    if type is? types.TypeOr {
        loop member in type.items {if not builtin_copy_available(member nodes) return false}
        return true
    }
    if type is? types.ObjectType {
        let method=types.object_method(type 'copy')
        return types.object_field(type 'copy') is? none and (method is? none or method.lifecycle =? 'copy')
    }
    return type is? types.Primitive|types.ArrayType|types.IntegerLiteralType|types.StringLiteralType|types.StringType
}
# A custom copy enters the ordinary call graph before fact/effect analysis.
# Its result contract, not the source's current facts, describes the result.
checked_copy = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node=node_at(value session)
    let loc=contexts.node_at(id env.lexical session).loc
    let blocker=lifecycle.copy_blocker(node.value_type session.types)
    if blocker isnt? none {
        let component=if blocker.path =? '' 'this type' else "component `{blocker.path}`"
        return problem(id 'cannot copy a move-only value' "{component} declares `$__drop__` without `$__copy__`" env session)
    }
    let owner=views.structural_base(node.value_type session.types)
    let type=types.node_at(session.types owner)
    if type is? types.ObjectType {
        let hook:types.MethodSpec?=none
        loop method in type.methods {
            if method.lifecycle =? 'copy' {hook=method}
        }
        if hook isnt? none {
            let alias=if type.brand is? none display.type_to_dewy(owner session.types) else type.brand
            let error=prepare_methods(owner alias env @session)
            if error isnt? none return error
            let entry=session.methods.get(method_key(owner hook))
            if entry is? none return pending(id 'a recursive lifecycle copy before its signature is available' env session)
            let binding=bindings.binding_at(session.registry entry.binding)
            $runtime_assert binding.value_type isnt? none
            let signature=dispatch.method_at(session.types binding.value_type)
            let function=put(hir.ExpressedIdentifier[loc binding.value_type binding.name binding.id] @session)
            let receiver=put(hir.Place[node.loc owner value] @session)
            return put(hir.FunctionCall[loc views.strip_result_refinement(signature.ret @session.types) function [receiver] []] @session)
        }
    }
    return put(hir.CopyValue[loc node.value_type value] @session)
}
member_named = (receiver:addr name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    if name =? 'length' {receiver=binary_array(receiver @session)}
    let value = node_at(receiver session)
    let type = types.node_at(session.types views.structural_base(value.value_type session.types))
    let loc = contexts.node_at(id env.lexical session).loc
    if type is? types.ModuleType {
        let field = namespaces.field(type name)
        if field is? none return problem(id 'module does not export this name' name env session)
        if field.type_value isnt? none {
            if field.type_value is? addr and field.type_value in? session.error_types return put(hir.ErrorValue[loc field.type_value display.type_to_dewy(field.type_value session.types)] @session)
            return put(hir.TypeValue[loc types.primitive('type' @session.types) field.type_value name] @session)
        }
        let binding = bindings.binding_at(session.registry field.binding_id)
        return put(hir.ExpressedIdentifier[loc field.value_type binding.name field.binding_id] @session)
    }
    if type is? types.MetaType return metatype_member(receiver type name id env @session)
    if value is? hir.TypeValue and value.value is? addr {
        if name =? 'typename' return type_names.literal(value.value loc @session)
        let selected=method_member(value.value none name id env @session)
        if selected is? Error return selected
        if selected isnt? none return selected
    }
    let entry = views.container_entry_types(value.value_type session.types)
    if entry isnt? none {
        if name =? 'copy' return copy_method(receiver loc @session)
        return container_member(receiver entry name id env @session)
    }
    if type is? types.ObjectType {
        let field = types.object_field(type name)
        if field isnt? none {
            # Keep a named guarantee such as totaldict on the selected value;
            # call/sibling-specific relations stay in the fact environment.
            let read=if field.refinement.length =? 0 field.value_type else views.strip_result_refinement(types.refined_type(field.value_type field.refinement @session.types) @session.types)
            return match_read(put(hir.MemberAccess[loc read receiver name field.mutable and not type.immutable] @session) env @session)
        }
        if name =? 'copy' and builtin_copy_available(value.value_type session.types) return copy_method(receiver loc @session)
        let selected=method_member(views.structural_base(value.value_type session.types) receiver name id env @session)
        if selected is? Error return selected
        if selected isnt? none return selected
        if name =? 'typename' return type_names.instance(receiver loc @session)
        if name =? 'copy' return copy_method(receiver loc @session)
        return problem(id 'object has no such member' name env session)
    }
    if name =? 'copy' and (type is? types.ArrayType or views.string_valued(value.value_type session.types)) return copy_method(receiver loc @session)
    if type is? types.ArrayType and name in? array_methods.names return array_method(receiver type name id env @session)
    if views.string_valued(value.value_type session.types) and name in? STRING_METHODS return string_method(receiver name id env @session)
    if type is? types.TypeOr {
        if name =? 'copy' and builtin_copy_available(value.value_type session.types) return copy_method(receiver loc @session)
        let forwarded=forwarding_member(receiver type name id env @session)
        if forwarded isnt? none return forwarded
    }
    if name =? 'length' {
        let word = types.primitive('int64' @session.types)
        if type is? types.ArrayType {
            let result = if type.length is? none word else types.integer_literal(type.length @session.types)
            return put(hir.ArrayLength[loc result receiver] @session)
        }
        if views.string_valued(value.value_type session.types) {
            let length:addr? = none
            if type is? types.StringType { length = type.length }
            if type is? types.StringLiteralType { length = type.value.length }
            let result = if length is? none word else types.integer_literal(length @session.types)
            return put(hir.StringLength[loc result receiver] @session)
        }
    }
    if type is? types.Primitive|types.IntegerLiteralType|types.FunctionType|types.ArrayType return problem(id 'member access requires an object' display.type_to_dewy(value.value_type session.types) env session)
    return pending(id "member `{name}` on `{display.type_to_dewy(value.value_type session.types)}`" env session)
}

# Common fields are read from the active ordinary alternative. Exceptions
# propagate unchanged, preserving the same `R... | X...` result as the hosted
# checker. The hidden binding makes evaluating the receiver exactly once an
# explicit part of HIR, including when that receiver is a call.
forwarding_member = (receiver:addr union:types.TypeOr name:string id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let exception=types.primitive('exception' @session.types)
    let exceptions:array<addr>=[]
    let ordinary:array<addr>=[]
    loop member in union.items {
        if subtyping.is_subtype(member exception session.links @session.types) {exceptions.push(member)}
        else {ordinary.push(member)}
    }
    if ordinary.length =? 0 return none
    loop member in ordinary {
        if types.node_at(session.types views.structural_base(member session.types)) isnt? types.ObjectType return none
    }
    let results=exceptions
    loop member in ordinary {
        let object=types.node_at(session.types views.structural_base(member session.types))
        $runtime_assert object is? types.ObjectType
        let field=types.object_field(object name)
        if field is? none return problem(id "member access requires every ordinary alternative to have `{name}`" "`{display.type_to_dewy(member session.types)}` has no field `{name}`; narrow the value with `is?` first" env session)
        results.push(field.value_type)
    }
    let loc=contexts.node_at(id env.lexical session).loc
    let hidden="__dewy_forward_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none hidden 'value' loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=node_at(receiver session).value_type
    bindings.store_binding(@session.registry binding_id binding)
    return put(hir.ForwardingAccess[loc types.union(results @session.types) receiver name hidden binding_id types.union(exceptions @session.types)] @session)
}

# The library owns these implementations. Binding a method removes the
# leading text parameter from its exposed signature, so calls, defaults,
# parameter facts, and receiver evaluation use the ordinary function path.
const STRING_METHODS:set<string>=set['contains' 'startswith' 'endswith' 'find' 'rfind' 'split' 'lines' 'trim' 'trim_start' 'trim_end' 'replace' 'casefold']
string_method = (receiver:addr name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let binding_id=declarations.lookup("_string_{name}" env.lexical session)
    if binding_id is? none return problem(id "`.{name}` needs the prelude" 'string methods are implemented in the prelude string library' env session)
    let binding=bindings.binding_at(session.registry binding_id)
    if binding.value_type is? none return problem(id 'string method has no signature' name env session)
    let signature=types.node_at(session.types binding.value_type)
    if signature isnt? types.FunctionType or signature.pos_or_kw.length =? 0 return problem(id 'string method has no receiver parameter' name env session)
    let parameters:array<types.PosOrKwArg>=[]
    loop i in 1.. and i <? signature.pos_or_kw.length {parameters.push(signature.pos_or_kw[i])}
    let exposed=types.function_type(parameters signature.kw_only signature.rest signature.ret signature.type_params @session.types effects=effect_rows.bind_receiver(signature.effects signature.pos_or_kw.length+signature.kw_only.length))
    let loc=contexts.node_at(id env.lexical session).loc
    let function=put(hir.ExpressedIdentifier[loc binding.value_type binding.name binding_id] @session)
    return put(hir.BoundMethod[loc exposed function receiver] @session)
}

# Record fields enter a fresh lexical scope in source order, so later values
# can refer to earlier fields. These bindings identify the already evaluated
# field values; they do not cause the initializer to run again.
RecordEntry:type = const [name:string syntax:addr read:addr? read_type:addr? mutable:bool loc:Span]
# Deferred effect checks retain the original callable underneath. Runtime
# method metadata belongs to that literal, while the boundary stays in HIR
# until its obligation has been checked.
effect_boundary_value = (value:addr session:contexts.Session):>addr => {
    let node=node_at(value session)
    loop node is? hir.ValueCast and node.effect_target isnt? none {
        value=node.expr
        node=node_at(value session)
    }
    return value
}
# A function stored in a record field is a receiver method: a call through
# the field passes the record as its hidden first argument. Only a literal
# can be one; another function value (`Box[@twice]`) is rejected as in the
# hosted checker, rather than wrapped, until closures exist.
receiver_method = (value:addr type:addr id:addr env:Environment @session:contexts.Session forward:bool=false):>addr|Error => {
    let literal=effect_boundary_value(value session)
    let node=node_at(literal session)
    if node is? hir.FunctionLiteral {
        if node.object_receiver return value
        contexts.replace_hir(literal hir.FunctionLiteral[node.loc node.value_type node.pos_or_kw_args node.kw_only_args node.rest_args node.rettype node.body object_receiver=true object_fields=node.object_fields object_type=node.object_type source=node.source] @session)
        return value
    }
    let signature=types.node_at(session.types types.unfold(types.strip_refinement(type session.types) session.types))
    if signature isnt? types.FunctionType return value
    if forward return slot_forwarder(value signature type env @session)
    return pending(id 'storing a non-literal function in an object field' env session)
}
# A slot's default forwarding to the type's method, as the hosted checker's
# `_slot_forwarder`: the field holds a literal in the field's convention (the
# record first) that calls the method, whose body keeps its own.
slot_forwarder = (value:addr signature:types.FunctionType type:addr env:Environment @session:contexts.Session):>addr => {
    let node=node_at(value session)
    let loc=node.loc
    let params:array<hir.Param>=[]
    let reads:array<addr>=[]
    loop i in 0.. and i <? signature.pos_or_kw.length {
        let slot=signature.pos_or_kw[i]
        let name:string=if slot.name is? none "__dewy_p{i}" else slot.name
        let binding_id=bindings.allocate_param(@session.registry name slot.value_type loc)
        let binding=bindings.binding_at(session.registry binding_id)
        binding.store_type=slot.value_type
        bindings.store_binding(@session.registry binding_id binding)
        params.push(hir.Param[name slot.value_type binding_id position_only=false place=slot.place])
        let read=put(hir.ExpressedIdentifier[loc slot.value_type name binding_id] @session)
        reads.push(if slot.place put(hir.Place[loc slot.value_type read] @session) else read)
    }
    let call=put(hir.FunctionCall[loc signature.ret value reads []] @session)
    return put(hir.FunctionLiteral[loc type params [] none signature.ret call object_receiver=true source=env.lexical.source] @session)
}
record_literal = (id:addr node:parser.Block env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector]
    let selected = if expected is? none types.primitive('any' @session.types) else types.unfold(types.strip_refinement(expected session.types) session.types)
    let wanted = types.node_at(session.types selected)
    if wanted is? types.TypeOr {
        # Check fields against the expected record before constructing its
        # shape. A unique record alternative is unambiguous; with several,
        # written field names select one. Predicates remain obligations.
        let candidates:array<addr>=[]
        loop member in wanted.items {
            let unfolded=types.unfold(member session.types)
            if types.node_at(session.types unfolded) is? types.ObjectType {candidates.push(unfolded)}
        }
        if candidates.length >? 1 {
            let written:set<string>=set[]
            loop row_id in node.inner {
                let row=contexts.node_at(row_id env.lexical session)
                if row isnt? parser.BinOp or not source_views.is_operator(row.op '=' env.lexical session) continue
                let name=source_views.identifier(row.left env.lexical session)
                if name isnt? none {written.add(name)}
            }
            let matching:array<addr>=[]
            loop candidate in candidates {
                let record=types.node_at(session.types candidate)
                $runtime_assert record is? types.ObjectType
                let names:set<string>=set[]
                loop field in record.fields {names.add(field.name)}
                if names.length =? written.length and (names - written).length =? 0 {matching.push(candidate)}
            }
            if matching.length =? 1 {candidates=matching}
        }
        if candidates.length =? 1 {selected=candidates[0] wanted=types.node_at(session.types selected)}
    }
    if expected isnt? none and wanted isnt? types.ObjectType return problem(id 'type mismatch' 'the expected type must select one record alternative' env session)
    let fields:array<hir.ObjectField> = []
    let layout:array<types.ObjectField> = []
    # Spread rows (`obj...`) contribute their source's fields as member reads.
    # Names repeat in the splat sense: the later entry wins, at the position
    # of the first; two written fields with one name are a mistake.
    let entries:array<RecordEntry> = []
    loop row_id in node.inner {
        let row_loc=contexts.node_at(row_id env.lexical session).loc
        let operand=spread_operand(row_id env session)
        if operand isnt? none {
            let source=spread_source(operand env @session)
            if source is? Error return source
            let source_type=node_at(source session).value_type
            let shape=types.node_at(session.types types.unfold(types.strip_refinement(source_type session.types) session.types))
            if shape isnt? types.ObjectType or views.container_entry_types(source_type session.types) isnt? none return problem(row_id 'object spread requires an object' display.type_to_dewy(source_type session.types) env session)
            loop field in shape.fields {
                let read=put(hir.MemberAccess[row_loc field.value_type source field.name field.mutable and not shape.immutable] @session)
                entries.push(RecordEntry[field.name row_id read field.value_type field.mutable row_loc])
            }
            continue
        }
        let row = contexts.node_at(row_id env.lexical session)
        if row isnt? parser.BinOp or not source_views.is_operator(row.op '=' env.lexical session) return problem(row_id 'mixed record and array literal' 'each record field needs a named value' env session)
        let written_target = contexts.node_at(row.left env.lexical session)
        let written_name_id = if written_target is? parser.BinOp and source_views.is_operator(written_target.op ':' env.lexical session) written_target.left else row.left
        let written_name = source_views.identifier(written_name_id env.lexical session)
        if written_name is? none return problem(row_id 'record field needs a name' 'use `name=value` or `name:Type=value`' env session)
        entries.push(RecordEntry[written_name row_id none none true row_loc])
    }
    let merged:array<RecordEntry> = []
    loop entry in entries {
        let at:addr<i => i <=? merged.length> = 0
        loop at <? merged.length and merged[at].name not=? entry.name { at += 1 }
        if at <? merged.length {
            if entry.read is? none and merged[at].read is? none return problem(entry.syntax 'duplicate record field' entry.name env session)
            merged[at]=entry
        } else { merged.push(entry) }
    }
    loop entry in merged {
        let row_id = entry.syntax
        let spread_read = entry.read
        if spread_read isnt? none {
            let read_type = entry.read_type
            $runtime_assert read_type isnt? none
            let name = entry.name
            let value:addr = spread_read
            let type:addr = read_type
            let field:types.ObjectField? = if wanted is? types.ObjectType types.object_field(wanted name) else none
            if field isnt? none {
                let converted = against(value field.value_type row_id inner @session)
                if converted is? Error return converted
                value = converted
                type = field.value_type
            }
            let binding = bind_field(name type entry.loc inner @session)
            let mutable = if field is? none entry.mutable else field.mutable
            if wanted is? types.ObjectType and wanted.immutable { mutable = false }
            fields.push(hir.ObjectField[entry.loc name value binding mutable])
            if field isnt? none {layout.push(field)} else {layout.push(types.ObjectField[name type])}
            continue
        }
        let row = contexts.node_at(row_id env.lexical session)
        $runtime_assert row is? parser.BinOp
        let target = contexts.node_at(row.left env.lexical session)
        let name_id = row.left
        let annotation:addr? = none
        if target is? parser.BinOp and source_views.is_operator(target.op ':' env.lexical session) {
            name_id = target.left
            let subject=source_views.identifier(target.left env.lexical session)
            let field_context=contexts.Context[inner.lexical.source inner.lexical.scope subject]
            let resolved = declarations.resolve(target.right field_context @session)
            if resolved is? Error return resolved
            resolved = declarations.value_type(resolved target.right field_context @session)
            if resolved is? Error return resolved
            let bound=declarations.resolve_scope_terms(resolved target.right inner.lexical @session)
            if bound is? Error return bound
            annotation = bound
        }
        let name = source_views.identifier(name_id env.lexical session)
        if name is? none return problem(row_id 'record field needs a name' 'use `name=value` or `name:Type=value`' env session)
        let scope = bindings.scope_at(session.scopes inner.lexical.scope)
        if name in? scope.names return problem(row_id 'duplicate record field' name env session)
        let field:types.ObjectField? = none
        if wanted is? types.ObjectType {
            field = types.object_field(wanted name)
            if field is? none return problem(row_id 'unknown record field' name env session)
            if annotation is? none { annotation = field.value_type }
        }
        let value = expression(row.right inner @session expected=annotation)
        if value is? Error return value
        if annotation is? none { value = widen(value row.right inner @session) }
        if value is? Error return value
        let type = if annotation is? none node_at(value session).value_type else annotation
        if field isnt? none and field.refinement.length >? 0 {
            let required=declarations.resolve_scope_terms(types.refined_type(type field.refinement @session.types) row_id inner.lexical @session)
            if required is? Error return required
            value = against(value required row_id inner @session)
            if value is? Error return value
        }
        let marked = receiver_method(value type row_id inner @session)
        if marked is? Error return marked
        value = marked
        let binding = bind_field(name type row.loc inner @session)
        let mutable = if field is? none true else field.mutable
        if wanted is? types.ObjectType and wanted.immutable { mutable = false }
        fields.push(hir.ObjectField[row.loc name value binding mutable])
        if field isnt? none {layout.push(field)}
        else {
            # An inline annotation and a separately declared record field
            # have the same storage contract. Store its predicates on the
            # field so later member reads retain them after type erasure.
            let declared=types.node_at(session.types type)
            layout.push(if declared is? types.RefinedType types.ObjectField[name declared.base refinement=declared.propositions] else types.ObjectField[name type])
        }
    }
    if wanted is? types.ObjectType {
        loop field in wanted.fields {
            let scope = bindings.scope_at(session.scopes inner.lexical.scope)
            if field.name not in? scope.names return problem(id 'missing record field' field.name env session)
        }
    }
    let type = if wanted is? types.ObjectType and expected isnt? none selected else types.object_type(layout none false [] [] @session.types)
    # A function stored in a record literal is a method of that record: it
    # takes the record as a hidden receiver and reads sibling fields through
    # it, as the hosted checker marks it (`object_receiver`).
    let field_bindings:array<hir.FieldBinding> = []
    loop field in fields { if field.binding_id isnt? none { field_bindings.push(hir.FieldBinding[field.binding_id field.name]) } }
    loop field in fields {
        let literal_id=effect_boundary_value(field.value session)
        let literal = node_at(literal_id session)
        if literal isnt? hir.FunctionLiteral continue
        contexts.replace_hir(literal_id hir.FunctionLiteral[literal.loc literal.value_type literal.pos_or_kw_args literal.kw_only_args literal.rest_args literal.rettype literal.body object_receiver=true object_fields=field_bindings object_type=type source=literal.source] @session)
    }
    let value = put(hir.ObjectLiteral[node.loc type fields] @session)
    return if expected is? none value else against(value expected id env @session)
}

bind_field = (name:string type:addr loc:Span env:Environment @session:contexts.Session):>addr => {
    let id = bindings.allocate(@session.registry none name 'value' loc)
    let binding = bindings.binding_at(session.registry id)
    binding.value_type = type binding.store_type = type
    bindings.store_binding(@session.registry id binding)
    bindings.bind(@session.scopes env.lexical.scope name id)
    return id
}

# A concrete empty mint has one inhabitant. Fully defaulted minted records
# use their ordinary field-wise constructor too. The name remains a type in
# an uncontextualized expression (for spelling and static members); a value
# expectation or an explicit value declaration requests its inhabitant.
unit_inhabitant = (value:addr expected:addr? id:addr env:Environment @session:contexts.Session):>addr|none|Error => {
    let node=node_at(value session)
    if node isnt? hir.TypeValue or node.value isnt? addr return none
    let type=types.node_at(session.types types.unfold(node.value session.types))
    if type isnt? types.ObjectType or not type.minted or type.abstract return none
    if expected isnt? none and not subtyping.is_subtype(node.value types.strip_refinement(expected session.types) session.links @session.types) return none
    loop field in type.fields {if field.default is? none and not implemented_slot(type field session) return none}
    let constructed=construct(node none id env @session)
    if constructed is? Error return constructed
    return if node_at(constructed session) is? hir.ObjectLiteral constructed else none
}

# Constructor defaults retain their declaration's source and outer scope.
# The completed earlier fields form the innermost scope in either source.
# As in the hosted constructor, arguments bind slots first and field
# initializers run in declaration order. Defaults only fill absent slots.
construct = (constructor:hir.TypeValue arguments_id:addr? id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    if constructor.value isnt? addr return pending(id 'generic type constructor inference' env session)
    let type = types.unfold(constructor.value session.types)
    let shape = types.node_at(session.types type)
    if shape isnt? types.ObjectType return pending(id 'non-record type constructor' env session)
    if shape.abstract return problem(id 'cannot construct an abstract type' display.type_to_dewy(type session.types) env session)
    let overload=constructor_overload(constructor arguments_id id env @session expected=expected)
    if overload is? Error return overload
    if overload isnt? none return overload
    let items=source_arguments(arguments_id env session)
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector]
    let given:dict<string addr> = []
    let positional:array<addr> = []
    loop item in items {
        let row = contexts.node_at(item env.lexical session)
        let name:string? = none
        let value_id = item
        if row is? parser.BinOp and source_views.is_operator(row.op '=' env.lexical session) {
            name = source_views.identifier(row.left env.lexical session)
            value_id = row.right
            if name is? none return problem(item 'constructor argument needs a field name' 'use `name=value`' env session)
        } else {
            positional.push(item)
            continue
        }
        $runtime_assert name isnt? none
        if name in? given return problem(item 'duplicate constructor field' name env session)
        let field = types.object_field(shape name)
        if field is? none return problem(item 'unknown constructor field' name env session)
        given[name] = value_id
    }
    if positional.length >? shape.fields.length return problem(id 'too many constructor arguments' 'the type has fewer fields than positional arguments' env session)
    loop i in 0.. and i <? positional.length and i <? shape.fields.length {
        let name = shape.fields[i].name
        if name in? given return problem(positional[i] 'duplicate constructor field' name env session)
        given[name] = positional[i]
    }
    let fields:array<hir.ObjectField> = []
    loop field in shape.fields {
        let supplied = given.get(field.name)
        let value:addr? = none
        let from_default = false
        if supplied isnt? none {
            let checked = expression(supplied inner @session expected=field.value_type)
            if checked is? Error return checked
            value = checked
        } else if field.default is? none and implemented_slot(shape field session) {
            let error=prepare_methods(type if constructor.name is? none display.type_to_dewy(type session.types) else constructor.name env @session)
            if error isnt? none return error
            let method=types.object_method(shape field.name)
            $runtime_assert method isnt? none
            let entry=session.methods.get(method_key(type method))
            $runtime_assert entry isnt? none
            if entry.receiver_type isnt? none return problem(id 'a function slot needs a static implementation' field.name env session)
            let binding=bindings.binding_at(session.registry entry.binding)
            $runtime_assert binding.value_type isnt? none
            let function=put(hir.ExpressedIdentifier[constructor.loc binding.value_type binding.name binding.id] @session)
            let checked=against(function field.value_type id env @session)
            if checked is? Error return checked
            value=checked
            from_default=true
        } else {
            if field.default is? none return problem(id 'missing constructor field' field.name env session)
            $runtime_assert field.default <? session.syntax_refs.length
            let reference = session.syntax_refs[field.default]
            let scope = bindings.scope_at(session.scopes inner.lexical.scope)
            let default_scope = bindings.push_scope(@session.scopes reference.scope)
            loop [name binding] in scope.names { bindings.bind(@session.scopes default_scope name binding) }
            let lexical = contexts.Context[reference.source default_scope]
            let default_env = Environment[lexical env.state env.return_type env.control env.return_collector]
            let checked = expression(reference.node default_env @session expected=field.value_type)
            if checked is? Error return checked
            value = checked
            from_default = true
        }
        $runtime_assert value isnt? none
        if field.refinement.length >? 0 {
            # Earlier fields are real bindings in this construction. Resolve
            # sibling promises against that scope, including defaults read
            # from another module; a spelling alone is not proof evidence.
            let required=declarations.resolve_scope_terms(types.refined_type(field.value_type field.refinement @session.types) id inner.lexical @session)
            if required is? Error return required
            let checked = against(value required id inner @session)
            if checked is? Error return checked
            value = checked
        }
        $runtime_assert value isnt? none
        let marked = receiver_method(value field.value_type id inner @session forward=from_default)
        if marked is? Error return marked
        value = marked
        let binding = bind_field(field.name field.value_type node_at(value session).loc inner @session)
        fields.push(hir.ObjectField[node_at(value session).loc field.name value binding field.mutable and not shape.immutable])
    }
    let loc = contexts.node_at(id env.lexical session).loc
    let value = put(hir.ObjectLiteral[loc type fields] @session)
    return if expected is? none value else against(value expected id env @session)
}

# A place keeps its declared storage type, even when the latest read carried
# a stronger alternative or length. The callee can replace that storage, so
# preparing the argument invalidates read facts about its containing root.
# Every projected mutation follows the whole storage route. A mutable final
# field does not authorize a write through an immutable ancestor or a borrowed
# iterator value. Checking the route itself does not discard sequence lengths.
writable = (value:addr id:addr env:Environment session:contexts.Session named:bool=false):>Error? => {
    let path = bindings.access_path(value session.hir dictionaries=true)
    loop step in path.steps {
        let member = node_at(step session)
        if member is? hir.MemberAccess and not member.mutable return problem(id 'cannot mutate an immutable field' member.name env session)
    }
    let root = node_at(path.root session)
    if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {
        let binding = bindings.binding_at(session.registry root.binding_id)
        if binding.read_only_reason isnt? none return problem(id 'cannot mutate a read-only binding' binding.name env session)
    }
    else if named return problem(id 'a place needs a named root' 'this temporary does not name caller storage' env session)
    return none
}

place = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let target = node_at(value session)
    if target isnt? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index return problem(id 'a place needs mutable storage' 'use a binding, field, or indexed element' env session)
    let error = writable(value id env session named=true)
    if error isnt? none return error
    let path = bindings.access_path(value session.hir)
    let root = node_at(path.root session)
    $runtime_assert root is? hir.ExpressedIdentifier and root.binding_id isnt? none
    let binding = bindings.binding_at(session.registry root.binding_id)
    let store_type = store_type(value @session)
    if target is? hir.ExpressedIdentifier {
        if binding.store_type isnt? none { store_type = binding.store_type }
        else if binding.value_type isnt? none { store_type = binding.value_type }
        value = put(hir.ExpressedIdentifier[target.loc store_type target.name target.binding_id] @session)
    }
    container_state.replaced(value env.state @session)
    if binding.value_type isnt? none { set_read_type(binding.id binding.value_type env @session) }
    let loc = contexts.node_at(id env.lexical session).loc
    return put(hir.Place[loc store_type value] @session)
}
call_argument = (argument:addr required:addr place_parameter:bool id:addr env:Environment @session:contexts.Session arguments:dict<string addr>=[] readonly:bool=false):>addr|Error => {
    let node = node_at(argument session)
    if place_parameter and node isnt? hir.Place return problem(id 'place argument requires `@`' 'the parameter can write its caller binding' env session)
    if not place_parameter and node is? hir.Place return problem(id 'value parameter does not accept a place' 'remove `@` to pass an independent value' env session)
    if node is? hir.Place {
        let actual=if readonly node_at(node.target session).value_type else node.value_type
        if not place_fits(actual required @session readonly=readonly) return problem(id 'place parameter types are invariant' 'the storage and parameter types must agree' env session)
        return argument
    }
    let rebound=contracts.at_call(required arguments session.hir @session.types @session.registry)
    # Syntax checking may already have wrapped the same unresolved contract.
    # Retarget that boundary; retaining it underneath would still demand the
    # old parameter identity during validation.
    let value=argument
    if node is? hir.Obligation and types.same_type(node.refined required session.types) {value=node.value}
    return against(value rebound id env @session)
}
remember_place = (argument:addr @places:array<addr> id:addr env:Environment session:contexts.Session):>Error? => {
    let node = node_at(argument session)
    if node isnt? hir.Place return none
    let path = bindings.access_path(node.target session.hir)
    let root = node_at(path.root session)
    $runtime_assert root is? hir.ExpressedIdentifier
    loop previous in places {
        let other = bindings.access_path(previous session.hir)
        let owner = node_at(other.root session)
        $runtime_assert owner is? hir.ExpressedIdentifier
        if root.binding_id not=? owner.binding_id continue
        let disjoint = false
        loop i in 0.. and i <? path.steps.length and i <? other.steps.length {
            let left = node_at(path.steps[i] session)
            let right = node_at(other.steps[i] session)
            if left is? hir.MemberAccess and right is? hir.MemberAccess and left.name not=? right.name { disjoint = true break }
            if left is? hir.Index and right is? hir.Index {
                let a = node_at(left.index session)
                let b = node_at(right.index session)
                if a is? hir.Integer and b is? hir.Integer and a.value not=? b.value { disjoint = true break }
            }
        }
        if not disjoint return problem(id 'overlapping mutable places in one call' 'these arguments may name the same storage' env session)
    }
    places.push(node.target)
    return none
}

# A nominal prefix must preserve every writable field's storage contract,
# not just the layout or ordinary value subtype relation. A parent method
# must not overwrite a child's stronger invariant with a wider parent value.
place_fits = (actual:addr required:addr @session:contexts.Session readonly:bool=false):>bool => {
    if types.same_type(actual required session.types) return true
    if readonly {actual=types.strip_refinement(actual session.types) required=types.strip_refinement(required session.types)}
    let a = types.node_at(session.types types.unfold(actual session.types))
    let r = types.node_at(session.types types.unfold(required session.types))
    if a isnt? types.ObjectType or not a.minted or r isnt? types.ObjectType return false
    if (not readonly and a.immutable not=? r.immutable) or a.fields.length <? r.fields.length return false
    loop i in 0.. and i <? r.fields.length {
        $runtime_assert i <? a.fields.length
        let mine=a.fields[i]
        let theirs=r.fields[i]
        if mine.name not=? theirs.name return false
        if readonly {
            if not types.same_type(types.strip_refinement(mine.value_type session.types) types.strip_refinement(theirs.value_type session.types) session.types) return false
        } else if not types.same_type(mine.value_type theirs.value_type session.types) or mine.mutable not=? theirs.mutable or not types.same_propositions(mine.refinement theirs.refinement session.types) return false
    }
    if readonly {
        # The mint checker established value subtyping; only constness may
        # differ for this compiler-owned read-only borrow of the parent.
        let parent=types.object_type(r.fields r.brand a.immutable r.methods r.constructors @session.types minted=r.minted parent=r.parent abstract=r.abstract)
        return subtyping.is_subtype(actual parent session.links @session.types)
    }
    return subtyping.is_subtype(actual required session.links @session.types)
}

array_method = (receiver:addr read:types.ArrayType name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let receiver_node = node_at(receiver session)
    let declared:addr = store_type(receiver @session)
    if name not=? 'join' {
        let path = bindings.access_path(receiver session.hir)
        let root = node_at(path.root session)
        if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return problem(id 'array mutation needs a named receiver' 'bind the array before changing it' env session)
        let binding = bindings.binding_at(session.registry root.binding_id)
        if binding.read_only_reason isnt? none return problem(id 'cannot mutate a const binding' binding.name env session)
        loop step in path.steps {
            let field = node_at(step session)
            if field is? hir.MemberAccess and not field.mutable return problem(id 'cannot mutate an immutable field' field.name env session)
        }
        if receiver_node is? hir.ExpressedIdentifier and binding.store_type isnt? none { declared = binding.store_type }
        if receiver_node is? hir.ExpressedIdentifier and binding.declaration isnt? none {
            let declaration_id = binding.declaration
            let declaration = node_at(declaration_id session)
            let stored = types.node_at(session.types types.strip_refinement(declared session.types))
            if declaration is? hir.Declare and declaration.annotation is? none and stored is? types.ArrayType {
                # An inferred array grows when its program uses a growth
                # method. An explicitly fixed length remains a store contract.
                declared = types.array_type(stored.element none @session.types)
                binding.value_type = declared binding.store_type = declared
                bindings.store_binding(@session.registry binding.id binding)
                $runtime_assert declaration_id <? session.hir.length
                contexts.replace_hir(declaration_id hir.Declare[declaration.loc declaration.value_type declaration.decltype declaration.name declared declaration.expr declaration.binding_id declaration.view] @session)
            }
        }
        let shape = types.node_at(session.types types.strip_refinement(declared session.types))
        if shape is? types.TypeOr {
            loop alternative in shape.items {
                let candidate = types.node_at(session.types types.strip_refinement(alternative session.types))
                if candidate is? types.ArrayType and candidate.length is? none and subtyping.is_subtype(receiver_node.value_type alternative session.links @session.types) {
                    declared = alternative
                    break
                }
            }
            shape = types.node_at(session.types types.strip_refinement(declared session.types))
        }
        if shape isnt? types.ArrayType or shape.length isnt? none return problem(id 'exact-length arrays cannot change length' 'declare the storage as `array<T>` to permit growth' env session)
        declared = types.strip_refinement(declared session.types)
        if receiver_node is? hir.ExpressedIdentifier { receiver = put(hir.ExpressedIdentifier[receiver_node.loc declared receiver_node.name receiver_node.binding_id] @session) }
        else if receiver_node is? hir.MemberAccess { receiver = put(hir.MemberAccess[receiver_node.loc declared receiver_node.value receiver_node.name receiver_node.mutable] @session) }
    } else {
        if not subtyping.is_subtype(read.element types.primitive('string' @session.types) session.links @session.types) return problem(id '`join` requires string elements' display.type_to_dewy(read.element session.types) env session)
    }
    let signature = array_methods.signature(name read.element @session.types)
    let loc = contexts.node_at(id env.lexical session).loc
    return put(hir.ArrayMethod[loc signature receiver name] @session)
}

# This is the checker's exact-length view. The bounds validator separately
# transfers intervals, proves operation indices, and enforces the original
# storage refinements; losing an exact length is not permission to skip it.
array_transition = (method:hir.ArrayMethod positional:array<addr> keyword:dict<string addr> id:addr env:Environment @session:contexts.Session):>Error? => {
    if method.name in? ['join' 'reserve'] return none
    container_state.replaced(method.array env.state @session descendants=true)
    if method.name =? 'sort' return none
    let limit = targets.max_length(session.target)
    let route = bindings.array_route_id(method.array session.hir @session.registry)
    if route is? none return none
    let current = read_type(route env session fallback=node_at(method.array session).value_type)
    let array = types.node_at(session.types node_at(method.array session).value_type)
    $runtime_assert array is? types.ArrayType
    let length:addr? = none
    if current isnt? none {
        let shape = types.node_at(session.types types.strip_refinement(current session.types))
        if shape is? types.ArrayType { length = shape.length }
    }
    let index:addr? = none
    if method.name =? 'pop' or method.name =? 'truncate' {
        index = if positional.length >? 0 positional[0] else keyword.get(if method.name =? 'pop' 'idx' else 'count')
    }
    if method.name =? 'insert' { index = if positional.length >? 1 positional[1] else keyword.get('idx') }
    let count:bigint? = none
    if index isnt? none {
        let number = node_at(index session)
        if number is? hir.Integer { count = number.value }
    }
    if count isnt? none and count <? 0 return problem(id 'array method index cannot be negative' method.name env session)
    if method.name =? 'clear' { length = 0 }
    else if method.name =? 'push' or method.name =? 'insert' {
        if method.name =? 'insert' and count isnt? none and length isnt? none and count >? length return problem(id 'insert index is out of bounds' 'the index must be at or before the end' env session)
        if length isnt? none {
            if length >=? limit return problem(id 'array length exceeds the target address space' 'this array cannot grow by another element' env session)
            length += 1
        }
    } else if method.name =? 'pop' {
        if length isnt? none {
            if length =? 0 return problem(id 'pop on an empty array' 'no element can be removed' env session)
            if count isnt? none and count >=? length return problem(id 'pop index is out of bounds' 'the index must select an existing element' env session)
            length -= 1
        }
    } else if method.name =? 'truncate' {
        if count is? none { length = none }
        else if length isnt? none and count <? length {
            $runtime_assert count >=? 0 and count <=? limit
            length = count as addr
        }
    }
    set_read_type(route types.array_type(array.element length @session.types) env @session)
    return none
}

# A compound dictionary store retains the lookup's membership proof and
# evaluates its key once. Only named writable receiver routes reach this
# boundary; the ordinary store lowering retains the receiver across the RHS.
compound_container = (lookup:hir.DictLookup right_id:addr operator:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let keys_array=node_at(lookup.keys session)
    $runtime_assert keys_array is? hir.MemberAccess
    let receiver=keys_array.value
    let writable=writable_container(receiver id env @session)
    if writable is? Error return writable
    let key=node_at(lookup.key session)
    let name="__dewy_store_key_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' key.loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=key.value_type binding.store_type=key.value_type
    let declaration=put(hir.Declare[key.loc types.primitive('void' @session.types) 'let' name key.value_type lookup.key binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    let local=put(hir.ExpressedIdentifier[key.loc key.value_type name binding_id] @session)
    let original_key=lookup.key
    lookup.key=local
    let read=put(lookup @session)
    let operand_type=types.strip_refinement(lookup.value_type session.types)
    let right=expression(right_id env @session expected=operand_type)
    if right is? Error return right
    let function=identifier(operator id env @session)
    if function is? Error return function
    let result=call(function [read right] [] id env @session expected=operand_type)
    if result is? Error return result
    result=against(result lookup.value_type id env @session)
    if result is? Error return result
    container_state.forget_positions(receiver env.state @session)
    let position=key_position(@session)
    container_state.remember(receiver local env.state @session position=position)
    # The RHS may have changed the original key binding. The captured key is
    # present after the store; that does not prove the binding's new value is.
    let identity=keys.identity(original_key session.hir @session.registry @session.types)
    if identity is? keys.Literal {container_state.remember(receiver original_key env.state @session position=position)}
    let loc=contexts.node_at(id env.lexical session).loc
    let store=put(hir.DictStore[loc types.primitive('void' @session.types) lookup.keys lookup.values local result position=position] @session)
    return put(hir.Block[loc types.primitive('void' @session.types) [declaration store] false] @session)
}

compound_assignment = (id:addr node:parser.BinOp env:Environment @session:contexts.Session):>addr|Error => {
    let op = contexts.node_at(node.op env.lexical session)
    $runtime_assert op is? post.CombinedAssignment
    let symbol = source_views.symbol(op.op env.lexical session)
    let name = builtins.binary_operators.get(symbol)
    if name is? none return pending(id "compound operator `{symbol}=`" env session)
    let target = expression(node.left env @session call_target=true)
    if target is? Error return target
    let read = node_at(target session)
    if read is? hir.TypeValue and symbol =? '&' return declare_constructor(read node.right id env @session)
    if read is? hir.DictLookup return compound_container(read node.right name id env @session)
    if read isnt? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index return problem(id 'assignment requires mutable storage' 'select a binding, record field, or array element' env session)
    if read is? hir.ExpressedIdentifier and read.binding_id isnt? none {
        let error=foreign_assignment(bindings.binding_at(session.registry read.binding_id) id env session)
        if error isnt? none return error
    }
    let error = writable(target id env session)
    if error isnt? none return error
    let required = store_type(target @session)
    # The hosted placeholder remains until lowering preserves one evaluation
    # of the array route and index across both the read and the write.
    if read is? hir.Index return pending(id 'compound indexed assignment' env session)
    # The RHS supplies an operand, not a replacement value. For `x >= 5`,
    # `x += 1` need not prove `1 >= 5`; only the computed store must satisfy
    # the contract. Retain the representation hint while shedding its facts.
    let operand_type=types.strip_refinement(read.value_type session.types)
    # A shift count has its own unsigned operand type. Passing the value's
    # signed representation as its hint would reject even `value >>= 1`.
    # Leave that operand to the same overload selection as an ordinary shift.
    let right_type:addr?=if name in? ['__lshift__' '__rshift__'] none else operand_type
    let right = expression(node.right env @session expected=right_type)
    if right is? Error return right
    let func = identifier(name id env @session)
    if func is? Error return func
    let result = call(func [target right] [] id env @session expected=operand_type)
    if result is? Error return result
    result = against(result required id env @session)
    if result is? Error return result
    container_state.replaced(target env.state @session)
    if read is? hir.MemberAccess return put(hir.MemberAssign[node.loc types.primitive('void' @session.types) target result] @session)
    $runtime_assert read is? hir.ExpressedIdentifier and read.binding_id isnt? none
    set_read_type(read.binding_id stored_read_type(result @session) env @session)
    # Keep the selected operation, including any conversions, on the RHS.
    # Lowering need not redispatch a source compound operator independently.
    return put(hir.Assign[node.loc types.primitive('void' @session.types) target '=' result] @session)
}

# Ranges remain values, including their open/closed endpoints and step pair.
# Normalizing an iterator is a separate operation: an unbounded value is
# legal even when it has no first element from which a loop could start.
range_value = (id:addr node:parser.Flat env:Environment @session:contexts.Session bounds:string?=none):>addr|Error => {
    let left:addr? = none
    let right:addr? = none
    let before = true
    loop item in node.items {
        if source_views.identifier(item env.lexical session) =? '..' { before = false continue }
        if before { left = item } else { right = item }
    }
    let pair:hir.RangeStep? = none
    let checked_left:addr? = none
    let checked_right:addr? = none
    let left_pair = false
    loop side in [true false] {
        let item = if side left else right
        if item is? none continue
        let value = contexts.node_at(item env.lexical session)
        if value is? parser.Flat and source_views.is_operator(value.op ',' env.lexical session) {
            if value.items.length not=? 2 return problem(item 'range step syntax requires exactly two anchors' 'expected `first,second..last`' env session)
            if not side and left_pair return problem(item 'range cannot specify step anchors on both sides' 'choose one step-pair form' env session)
            if not side and left isnt? none return problem(item 'trailing range step pairs require an unbounded left side' 'write `first,second..last` instead' env session)
            let first = expression(value.items[0] env @session)
            if first is? Error return first
            let second = expression(value.items[1] env @session)
            if second is? Error return second
            pair = hir.RangeStep[first second]
            if side { checked_left = first left_pair = true } else { checked_right = second }
        } else {
            let checked = expression(item env @session)
            if checked is? Error return checked
            if side { checked_left = checked } else { checked_right = checked }
        }
    }
    # Character/scalar domains use the same HIR, but require the Unicode
    # ordinal conversion before their iterator normalization is enabled.
    let anchors:array<addr> = []
    if checked_left isnt? none { anchors.push(checked_left) }
    if checked_right isnt? none { anchors.push(checked_right) }
    if pair isnt? none { anchors.push(pair.first) anchors.push(pair.second) }
    loop anchor in anchors {
        if views.string_valued(node_at(anchor session).value_type session.types) and scalar_ordinal(anchor session) is? none return pending(id 'character range ordinal conversion' env session)
    }
    let delims:('[]'|'[)'|'(]'|'()')? = none
    if bounds isnt? none {
        $runtime_assert bounds is? '[]'|'[)'|'(]'|'()'
        delims = bounds
    }
    return put(hir.Range[contexts.node_at(id env.lexical session).loc types.primitive('range' @session.types) delims pair checked_left checked_right] @session)
}
# A character range anchor: a one-scalar string literal's dense Unicode
# ordinal (the surrogate gap omitted), as the hosted checker orders scalars.
scalar_ordinal = (id:addr session:contexts.Session):>bigint? => {
    let node=node_at(id session)
    loop node is? hir.RepresentationCast|hir.ValueCast { node=node_at(node.expr session) }
    if node isnt? hir.String or node.content.length not=? 1 return none
    let scalars=node.content as array<uint32>
    if scalars.length not=? 1 return none
    let scalar:bigint=scalars[0]
    return if scalar <? 0xD800 scalar else scalar - 0x800
}
range_anchor = (id:addr session:contexts.Session):>bigint? => {
    let constant=constant_integer(id session)
    return if constant isnt? none constant else scalar_ordinal(id session)
}
constant_integer = (id:addr session:contexts.Session):>bigint? => {
    let value = constants.constant_in(id session.hir session.types session.registry)
    if value is? none or value.lower is? none or value.upper is? none or value.lower not=? value.upper return none
    return value.lower
}

# A named range is compile-time syntax retained by its declaration, as in
# the hosted range resolver; there is no new runtime range descriptor here.
resolved_range = (id:addr session:contexts.Session):>hir.Range? => {
    let node=target_values.unwrap(id session.hir)
    if node is? hir.Range return node
    if node is? hir.RepresentationCast|hir.ValueCast return resolved_range(node.expr session)
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
        let binding=bindings.binding_at(session.registry node.binding_id)
        if binding.declaration isnt? none {
            let declaration=node_at(binding.declaration session)
            if declaration is? hir.Declare return resolved_range(declaration.expr session)
        }
    }
    return none
}
range_membership = (value:addr range:hir.Range id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let candidate=constant_integer(value session)
    let left=if range.left is? none none else constant_integer(range.left session)
    let right=if range.right is? none none else constant_integer(range.right session)
    let bounds=if range.bounds is? none '[]' else range.bounds
    let boolean=types.primitive('bool' @session.types)
    let loc=contexts.node_at(id env.lexical session).loc
    if range.step_pair is? none {
        if candidate isnt? none and (range.left is? none or left isnt? none) and (range.right is? none or right isnt? none) {
            let included=true
            if left isnt? none {included=if bounds.startswith('[') candidate >=? left else candidate >? left}
            if included and right isnt? none {included=if bounds.endswith(']') candidate <=? right else candidate <? right}
            return put(hir.Bool[loc boolean included] @session)
        }
        let word=types.primitive('int64' @session.types)
        let checked=against(value word id env @session)
        if checked is? Error return checked
        let first:addr?=none
        let last:addr?=none
        if range.left isnt? none {
            let bound=against(range.left word id env @session)
            if bound is? Error return bound
            first=bound
        }
        if range.right isnt? none {
            let bound=against(range.right word id env @session)
            if bound is? Error return bound
            last=bound
        }
        let runtime=put(hir.Range[range.loc range.value_type range.bounds none first last] @session)
        return put(hir.RangeMembership[loc boolean checked runtime] @session)
    }
    if range.left is? none return pending(id 'left-unbounded stepped range membership' env session)
    let second=constant_integer(range.step_pair.second session)
    if left is? none or second is? none or range.right isnt? none and right is? none return pending(id 'runtime range endpoint normalization' env session)
    let normalized=integer_ranges.normalize(left second right bounds)
    if normalized is? none return problem(id 'range step cannot be zero' 'choose a distinct second anchor' env session)
    if candidate isnt? none return put(hir.Bool[loc boolean integer_ranges.contains(candidate normalized)] @session)
    let components:array<bigint>=[normalized.first normalized.step]
    if normalized.last isnt? none {components.push(normalized.last)}
    loop component in components {if component <? -9223372036854775808 or component >? 9223372036854775807 return pending(id 'runtime stepped range membership requires bigint lowering' env session)}
    let checked=against(value types.primitive('int64' @session.types) id env @session)
    if checked is? Error return checked
    return put(hir.RangeMembership[loc boolean checked put(range @session) normalized.first normalized.step normalized.last normalized.count] @session)
}

IteratorResult:type = const [values:array<addr> environment:Environment]
iterator = (id:addr env:Environment @guards:array<addr> @prelude:array<addr> @session:contexts.Session):>IteratorResult|Error => {
    let node = contexts.node_at(source_views.unparen(id env.lexical session) env.lexical session)
    if node isnt? parser.BinOp or not source_views.is_operator(node.op 'in' env.lexical session) return pending(id 'non-conjunctive iterator formula' env session)
    let iterable = expression(node.right env @session)
    if iterable is? Error return iterable
    let entry = views.container_entry_types(node_at(iterable session).value_type session.types)
    if entry isnt? none return container_iterators(id node iterable entry env @prelude @session)
    let name = source_views.identifier(node.left env.lexical session)
    if name is? none return pending(id 'iterator target unpacking over non-container values' env session)
    let value = node_at(iterable session)
    # A stored range binding is compile-time syntax: iterate its literal, as
    # membership does, with no runtime range representation.
    if value isnt? hir.Range {
        let stored = resolved_range(iterable session)
        if stored isnt? none {
            iterable = put(stored @session)
            value = node_at(iterable session)
        }
    }
    # A range whose end is a runtime expression (`[0..argv.length)`) iterates
    # the open range under a guard, as the hosted checker rewrites it: the end
    # becomes the predicate `target <? end` (`<=?` when inclusive), which
    # bounds the counter like an explicit guard and stops the loop.
    let runtime_end:addr? = none
    let end_comparison:string = '<?'
    if value is? hir.Range and value.step_pair is? none and value.left isnt? none and value.right isnt? none and (value.bounds is? none or value.bounds.startswith('[')) {
        if constant_integer(value.left session) isnt? none and constant_integer(value.right session) is? none {
            runtime_end = value.right
            if value.bounds isnt? none and value.bounds.endswith(']') { end_comparison = '<=?' }
            iterable = put(hir.Range[value.loc value.value_type '[]' none value.left none] @session)
            value = node_at(iterable session)
        }
    }
    let shape = types.node_at(session.types types.strip_refinement(value.value_type session.types))
    let target:addr? = none
    let first:bigint = 0
    let step:bigint = 1
    let last:bigint? = none
    let count:bigint? = none
    let character_range = false
    if shape is? types.ArrayType {
        target = shape.element
        count = shape.length
    } else if views.string_valued(value.value_type session.types) {
        target = types.string_type(1 @session.types)
        if shape is? types.StringType { count = shape.length }
        if shape is? types.StringLiteralType { count = shape.value.length }
    } else if value is? hir.Range {
        if value.left is? none return problem(id 'range iteration requires a left anchor' 'this range has no first value to iterate from' env session)
        # Character ranges iterate scalar ordinals; the target is a grapheme.
        let character = views.string_valued(node_at(value.left session).value_type session.types)
        character_range = character
        let anchor = range_anchor(value.left session)
        let second:bigint? = none
        let right:bigint? = none
        if value.step_pair isnt? none { second = range_anchor(value.step_pair.second session) }
        if value.right isnt? none { right = range_anchor(value.right session) }
        if anchor is? none or (value.step_pair isnt? none and second is? none) or (value.right isnt? none and right is? none) return pending(id 'runtime range endpoint normalization' env session)
        if character and right is? none { right = if second is? none or second >? anchor 1112063 else 0 }
        let bounds = if value.bounds is? none '[]' else value.bounds
        let normalized=integer_ranges.normalize(anchor second right bounds)
        if normalized is? none return problem(id 'range iterator step cannot be zero' 'choose a distinct second anchor' env session)
        first=normalized.first step=normalized.step count=normalized.count
        target = if character types.string_type(1 @session.types) else types.primitive('int' @session.types)
    } else return problem(id 'value is not iterable' display.type_to_dewy(value.value_type session.types) env session)
    if count isnt? none { last = first + (count-1)*step }
    if value is? hir.Range and count isnt? none and last isnt? none and not character_range {
        let fits = true
        loop n in [first step last count] { if n <? -9223372036854775808 or n >? 9223372036854775807 { fits = false } }
        if fits { target = types.primitive('int64' @session.types) }
    }
    $runtime_assert target isnt? none
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector]
    let binding_id = bindings.allocate_param(@session.registry name target node.loc)
    let binding = bindings.binding_at(session.registry binding_id)
    binding.store_type = target
    if types.node_at(session.types types.strip_refinement(target session.types)) is? types.ObjectType { binding.read_only_reason = 'borrows the array element; copy it with `let` to change it' }
    bindings.store_binding(@session.registry binding_id binding)
    bindings.bind(@session.scopes inner.lexical.scope name binding_id)
    let target_node = put(hir.ExpressedIdentifier[contexts.node_at(node.left env.lexical session).loc target name binding_id] @session)
    let type = types.parameterize(types.primitive('iterator' @session.types) [target] @session.types)
    if runtime_end isnt? none {
        let operator=builtins.binary_operators.get(end_comparison)
        $runtime_assert operator isnt? none
        let function=identifier(operator id inner @session)
        if function is? Error return function
        let counter=put(hir.ExpressedIdentifier[contexts.node_at(node.left env.lexical session).loc target name binding_id] @session)
        let guard=call(function [counter runtime_end] [] id inner @session expected=types.primitive('bool' @session.types))
        if guard is? Error return guard
        guards.push(guard)
    }
    return IteratorResult[[put(hir.IteratorExpression[node.loc type target_node iterable first step last count] @session)] inner]
}

invalidate_loop_names = (names:set<string> replacements:set<string> env:Environment @session:contexts.Session):>void => {
    loop name in names {
        let id = declarations.lookup(name env.lexical session)
        if id is? none continue
        container_state.changed(id env.state @session)
        let current = read_type(id env session)
        let binding = bindings.binding_at(session.registry id)
        let declared = if binding.store_type is? none binding.value_type else binding.store_type
        if declared isnt? none { set_read_type(id declared env @session) }
        if name not in? replacements and current isnt? none {
            let shape = types.node_at(session.types types.strip_refinement(current session.types))
            if shape is? types.ArrayType { set_read_type(id types.array_type(shape.element none @session.types) env @session) }
        }
        # Projected facts were dropped by changed(). Do not reinstall a
        # route's first observed type: replacing a nominal variant can give
        # the same field name a different type. The next read uses its
        # current owner's declaration as the fallback.
    }
}
breaks_loop = (id:addr depth:addr session:contexts.Session):>bool => {
    let node = node_at(id session)
    if node is? hir.Break return node.loop_levels =? depth
    if node is? hir.FunctionLiteral return false
    if node is? hir.LoopArm return breaks_loop(node.condition depth session) or breaks_loop(node.body depth+1 session)
    loop child in hir.children(node) { if breaks_loop(child depth session) return true }
    return false
}
# A loop condition's iterator leaves combined by logical operators, as a
# postfix formula over leaf indices (`i in a or j in b` is `0 1 or`). Each
# leaf binds its target for the parts checked after it. A dictionary pair
# contributes two leaves joined by `and`.
collect_iterators = (part:addr body_env:Environment arm:parser.KeywordExpr changed:set<string> env:Environment @iterators:array<addr> @formula:array<hir.IteratorFormulaToken> @names:set<string> @guards:array<addr> @prelude:array<addr> @session:contexts.Session):>Environment|Error => {
    $runtime_assert arm.parts.length =? 3
    let node=contexts.node_at(source_views.unparen(part env.lexical session) env.lexical session)
    if node is? parser.BinOp {
        let op=source_views.symbol(node.op env.lexical session)
        if op in? ['and' 'or' 'xor' 'nand' 'nor' 'xnor'] and source_views.contains_iterator(node.left env.lexical session) and source_views.contains_iterator(node.right env.lexical session) {
            let after_left=collect_iterators(node.left body_env arm changed env @iterators @formula @names @guards @prelude @session)
            if after_left is? Error return after_left
            let after_right=collect_iterators(node.right after_left arm changed env @iterators @formula @names @guards @prelude @session)
            if after_right is? Error return after_right
            if op =? 'and' {formula.push('and')}
            else if op =? 'or' {formula.push('or')}
            else if op =? 'xor' {formula.push('xor')}
            else if op =? 'nand' {formula.push('nand')}
            else if op =? 'nor' {formula.push('nor')}
            else {formula.push('xnor')}
            return after_right
        }
    }
    let result=iterator(part body_env @guards @prelude @session)
    if result is? Error return result
    let first=true
    loop iterator_id in result.values {
        let iter=node_at(iterator_id session)
        $runtime_assert iter is? hir.IteratorExpression
        let target=node_at(iter.target session)
        $runtime_assert target is? hir.ExpressedIdentifier
        if target.name in? names return problem(part 'duplicate iterator target' target.name env session)
        names.add(target.name)
        let owner=node_at(iter.iterable session)
        let route=bindings.access_path(if owner is? hir.DictEntries owner.dictionary else iter.iterable session.hir)
        let root=node_at(route.root session)
        if owner is? hir.DictEntries {
            if root is? hir.ExpressedIdentifier and root.name in? changed {
                let fields:array<string>=[]
                loop step in route.steps {
                    let access=node_at(step session)
                    if access isnt? hir.MemberAccess break
                    fields.push(access.name)
                }
                if source_views.mutates_route(arm.parts[2] root.name fields env.lexical session) or source_views.mutates_route(arm.parts[1] root.name fields env.lexical session) return problem(part 'dictionary changes during iteration' 'the loop body writes this dictionary' env session)
            }
            container_state.forget_positions(owner.dictionary env.state @session)
        }
        formula.push(iterators.length)
        if not first {formula.push('and')}
        first=false
        iterators.push(iterator_id)
    }
    return result.environment
}
evaluate_formula = (formula:array<hir.IteratorFormulaToken> active:array<bool>):>bool? => {
    let stack:array<bool>=[]
    loop token in formula {
        if token is? addr {
            if token >=? active.length return none
            stack.push(active[token])
            continue
        }
        if stack.length <? 2 return none
        let right=stack.pop
        let left=stack.pop
        if token =? 'and' {stack.push(left and right)}
        else if token =? 'or' {stack.push(left or right)}
        else if token =? 'xor' {stack.push(left not=? right)}
        else if token =? 'nand' {stack.push(not (left and right))}
        else if token =? 'nor' {stack.push(not (left or right))}
        else {stack.push(left =? right)}
    }
    if stack.length not=? 1 return none
    return stack[0]
}
# A predicate tested after the iterators advance: its truth refines the body,
# a bounded counter is marked guarded, and its falsity breaks the loop.
loop_predicate = (predicate:addr iterators:array<addr> body_env:Environment @prefix:array<addr> @session:contexts.Session):>Environment => {
    hoist_condition(predicate @session)
    let refined_env = refined(predicate true body_env @session)
    loop index in 0.. and index <? iterators.length {
        let iter = node_at(iterators[index] session)
        $runtime_assert iter is? hir.IteratorExpression
        let target = node_at(iter.target session)
        $runtime_assert target is? hir.ExpressedIdentifier and target.binding_id isnt? none
        if hir_facts.predicate_bounds_counter(predicate target.binding_id session.hir session.types) {
            let item = iterators[index]
            $runtime_assert item <? session.hir.length
            contexts.replace_hir(item hir.IteratorExpression[iter.loc iter.value_type iter.target iter.iterable iter.first iter.step iter.last iter.count true] @session)
        }
    }
    let loc = node_at(predicate session).loc
    let empty = put(hir.Void[loc types.primitive('void' @session.types)] @session)
    let guard = put(hir.IfArm[loc node_at(empty session).value_type predicate empty] @session)
    let stop = put(hir.Break[loc types.primitive('never' @session.types)] @session)
    prefix.push(put(hir.Flow[loc node_at(empty session).value_type [guard] stop] @session))
    return refined_env
}
loop_flow = (id:addr arm:parser.KeywordExpr env:Environment @session:contexts.Session):>addr|Error => {
    let first=session.read_states.length
    let result=loop_flow_inner(id arm env @session)
    contexts.release_read_states(first @session)
    return result
}
loop_flow_inner = (id:addr arm:parser.KeywordExpr env:Environment @session:contexts.Session):>addr|Error => {
    $runtime_assert arm.parts.length =? 3
    let changed = source_views.mutations(arm.parts[2] env.lexical session)
    let replaced = source_views.mutations(arm.parts[2] env.lexical session true)
    loop name in source_views.mutations(arm.parts[1] env.lexical session) { changed.add(name) }
    loop name in source_views.mutations(arm.parts[1] env.lexical session true) { replaced.add(name) }
    let iterator_syntax=source_views.contains_iterator(arm.parts[1] env.lexical session)
    # Iterator inputs are evaluated once, before the body can mutate them.
    # A Boolean condition repeats, so it starts with the backedge facts gone.
    if not iterator_syntax {invalidate_loop_names(changed replaced env @session)}
    let body_env = fork(env @session)
    let condition:addr? = none
    let prefix:array<addr> = []
    if iterator_syntax {
        let iterators:array<addr> = []
        let predicates:array<addr> = []
        let guards:array<addr> = []
        let prelude:array<addr> = []
        let names:set<string> = set[]
        let formula:array<hir.IteratorFormulaToken> = []
        let joined=false
        loop part in source_views.conjuncts(arm.parts[1] env.lexical session) {
            if not source_views.contains_iterator(part env.lexical session) { predicates.push(part) continue }
            let collected=collect_iterators(part body_env arm changed env @iterators @formula @names @guards @prelude @session)
            if collected is? Error return collected
            if joined {formula.push('and')}
            joined=true
            body_env=collected
        }
        invalidate_loop_names(changed replaced env @session)
        invalidate_loop_names(changed replaced body_env @session)
        $runtime_assert iterators.length >? 0
        # Guards synthesized for runtime range ends precede the written
        # predicates, as in the hosted rewrite.
        # Nested unpack targets declare their names from the hidden element
        # binding at the start of every iteration, before any guard.
        loop declaration in prelude { prefix.push(declaration) }
        loop guard in guards { body_env = loop_predicate(guard iterators body_env @prefix @session) }
        loop predicate_id in predicates {
            let predicate = expression(predicate_id body_env @session expected=types.primitive('bool' @session.types))
            if predicate is? Error return predicate
            body_env = loop_predicate(predicate iterators body_env @prefix @session)
        }
        condition = iterators[0]
        if iterators.length >? 1 {
            # Where the formula stops depends only on the leaves' static
            # counts: a leaf exhausted before that point still binds its
            # target, as `none`. A formula that stays true after every
            # counted leaf ends repeats until the body exits.
            let counts:array<bigint?> = []
            let dynamic=false
            loop iterator_id in iterators {
                let iter=node_at(iterator_id session)
                $runtime_assert iter is? hir.IteratorExpression
                counts.push(iter.count)
                if iter.count is? none and node_at(iter.iterable session) isnt? hir.Range {dynamic=true}
            }
            let lockstep=true
            loop token in formula {if token isnt? addr and token not=? 'and' {lockstep=false}}
            if dynamic and not lockstep return pending(id 'dynamic-length arrays in multiiterator formulas other than `and`' env session)
            let boundaries:array<bigint> = [0]
            loop count in counts {if count isnt? none and count not in? boundaries {boundaries.push(count)}}
            let sorted:array<bigint> = []
            loop value in boundaries {
                let at:addr<i => i <=? sorted.length> = 0
                loop at <? sorted.length and sorted[at] <? value {at += 1}
                sorted.insert(value idx=at)
            }
            let stop:bigint? = none
            loop iteration in sorted {
                if stop isnt? none continue
                let active:array<bool> = []
                loop count in counts {active.push(count is? none or iteration <? count)}
                let holds=evaluate_formula(formula active)
                if holds is? none return problem(id 'invalid iterator formula' 'the loop condition is not a formula over its iterators' env session)
                if not holds {stop=iteration}
            }
            let repeats = stop is? none and not (dynamic and lockstep)
            # An open range leaf (`i in 0..`) ends where the formula stops:
            # with a static stop whose values fit a word, the counter is an
            # `int64` with that last value and count, as in the hosted checker.
            if stop isnt? none {
                loop index in 0.. and index <? iterators.length {
                    let iter=node_at(iterators[index] session)
                    $runtime_assert iter is? hir.IteratorExpression
                    if iter.count isnt? none or node_at(iter.iterable session) isnt? hir.Range continue
                    let effective_last:bigint = if stop >? 0 iter.first + (stop-1)*iter.step else iter.first - iter.step
                    let fits=true
                    loop n in [iter.first iter.step effective_last stop] { if n <? -9223372036854775808 or n >? 9223372036854775807 { fits=false } }
                    if not fits continue
                    let word=types.primitive('int64' @session.types)
                    let target=node_at(iter.target session)
                    $runtime_assert target is? hir.ExpressedIdentifier and target.binding_id isnt? none
                    let binding=bindings.binding_at(session.registry target.binding_id)
                    binding.value_type=word binding.store_type=word
                    bindings.store_binding(@session.registry target.binding_id binding)
                    contexts.replace_hir(iter.target hir.ExpressedIdentifier[target.loc word target.name target.binding_id] @session)
                    let type=types.parameterize(types.primitive('iterator' @session.types) [word] @session.types)
                    contexts.replace_hir(iterators[index] hir.IteratorExpression[iter.loc type iter.target iter.iterable iter.first iter.step effective_last stop iter.guarded] @session)
                }
            }
            loop index in 0.. and index <? iterators.length {
                let iter=node_at(iterators[index] session)
                $runtime_assert iter is? hir.IteratorExpression
                let count=iter.count
                if count is? none continue
                if stop isnt? none and stop <=? count continue
                let target=node_at(iter.target session)
                $runtime_assert target is? hir.ExpressedIdentifier and target.binding_id isnt? none
                let optional=views.optional(target.value_type @session.types)
                let binding=bindings.binding_at(session.registry target.binding_id)
                binding.value_type=optional binding.store_type=optional
                bindings.store_binding(@session.registry target.binding_id binding)
                contexts.replace_hir(iter.target hir.ExpressedIdentifier[target.loc optional target.name target.binding_id] @session)
                let type=types.parameterize(types.primitive('iterator' @session.types) [optional] @session.types)
                contexts.replace_hir(iterators[index] hir.IteratorExpression[iter.loc type iter.target iter.iterable iter.first iter.step iter.last iter.count iter.guarded] @session)
            }
            let type = types.parameterize(types.primitive('multiiterator' @session.types) [types.primitive('int64' @session.types)] @session.types)
            condition = put(hir.MultiIteratorExpression[arm.loc type iterators formula repeats] @session)
        }
    } else {
        let value = expression(arm.parts[1] env @session expected=types.primitive('bool' @session.types))
        if value is? Error return value
        condition = value
        hoist_condition(value @session)
        body_env = refined(value true env @session)
    }
    $runtime_assert condition isnt? none
    let loops=body_env.control.loops
    # An expression-bodied function can have no declaring lexical block.
    # An absent parent cannot be named by a visible label.
    loops.push(if env.control.scopes.length =? 0 none else env.control.scopes.length-1)
    let control=Control[body_env.control.scopes loops body_env.control.outer_labels]
    body_env = Environment[body_env.lexical body_env.state body_env.return_type control body_env.return_collector]
    let checked_body = expression(arm.parts[2] body_env @session)
    if checked_body is? Error return checked_body
    let body:addr = checked_body
    if prefix.length >? 0 {
        prefix.push(body)
        body = put(hir.Block[node_at(body session).loc node_at(body session).value_type prefix false] @session)
    }
    let test = node_at(condition session)
    let diverges = test is? hir.Bool and test.value and not breaks_loop(body 0 session)
    let type = types.primitive(if diverges 'never' else 'void' @session.types)
    # The general bounds pass computes loop fixed points. The source visitor
    # retains no body-only facts on an exit or on a possible zero-iteration path.
    invalidate_loop_names(changed replaced env @session)
    let checked_arm = put(hir.LoopArm[arm.loc type condition body] @session)
    return put(hir.Flow[contexts.node_at(id env.lexical session).loc type [checked_arm]] @session)
}

# Literal keys and values are separate homogeneous arrays, matching the
# insertion-order HIR representation. The entry expressions still check in
# source order within each array, as in the hosted implementation.
join_container_callables = (left:addr right:addr @session:contexts.Session):>addr? => {
    let a=types.node_at(session.types left)
    let b=types.node_at(session.types right)
    if a isnt? types.FunctionType or b isnt? types.FunctionType return none
    let a_shape=types.function_type(a.pos_or_kw a.kw_only a.rest a.ret a.type_params @session.types)
    let b_shape=types.function_type(b.pos_or_kw b.kw_only b.rest b.ret b.type_params @session.types)
    if not types.same_type(a_shape b_shape session.types) return none
    # Inferred rows are unresolved here. Subtyping alone can accept either
    # direction provisionally; choosing one would lose the other body's effects.
    return subtyping.join([left right] session.links @session.types)
}
container_array = (items:array<addr> wanted:addr? id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let values:array<addr> = []
    let element = wanted
    loop item in items {
        let checked = expression(item env @session expected=wanted)
        if checked is? Error return checked
        if wanted is? none { checked = widen(checked item env @session) }
        if checked is? Error return checked
        let current = node_at(checked session).value_type
        if element is? none { element = current }
        else if wanted is? none {
            let callable=join_container_callables(element current @session)
            if callable isnt? none { element=callable }
            else if subtyping.is_subtype(current element session.links @session.types) {}
            else if subtyping.is_subtype(element current session.links @session.types) { element = current }
            else return problem(item 'container elements differ in type' 'annotate the container to select one element type' env session)
        }
        values.push(checked)
    }
    if element is? none return problem(id 'empty container needs an element type' 'provide a container annotation' env session)
    let converted:array<addr> = []
    loop value in values {
        let checked = against(value element id env @session)
        if checked is? Error return checked
        converted.push(checked)
    }
    let loc = contexts.node_at(id env.lexical session).loc
    return put(hir.ArrayLiteral[loc types.array_type(element converted.length @session.types) converted] @session)
}
# The operand of a spread item `x...`, else none.
spread_operand = (row_id:addr env:Environment session:contexts.Session):>addr? => {
    let row=contexts.node_at(row_id env.lexical session)
    if row isnt? parser.BinOp or not source_views.is_operator(row.op 'EllipsisJuxtapose' env.lexical session) return none
    let marker=source_views.identifier(row.right env.lexical session)
    if marker is? none or marker not=? '...' return none
    return row.left
}
# A spread operand is a named place, so reading it several times is one
# evaluation, as in the hosted checker.
spread_source = (operand:addr env:Environment @session:contexts.Session):>addr|Error => {
    let checked=expression(operand env @session)
    if checked is? Error return checked
    let placed=node_at(checked session)
    let value:addr = if placed is? hir.Place placed.target else checked
    let node=node_at(value session)
    if node isnt? hir.ExpressedIdentifier|hir.MemberAccess return pending(operand 'spreading a computed value (bind it to a name first)' env session)
    if types.node_at(session.types types.strip_refinement(node.value_type session.types)) is? types.TypeOr return problem(operand 'cannot spread a union-typed value' 'narrow it with `is?` first' env session)
    return value
}
# `[xs... 0 ys...]`: the elements of the spread arrays (a set spreads its
# members) in order with the written elements. The length is exact when
# every spread operand's is; a spread fixes the element type.
spread_array = (id:addr node:parser.Block wanted:addr? env:Environment @session:contexts.Session):>addr|Error => {
    let loc=contexts.node_at(id env.lexical session).loc
    let items:array<addr>=[]
    let spreads:array<bool>=[]
    let plain:array<addr>=[]
    let length:addr?=0
    let first_element:addr?=none
    loop item in node.inner {
        let operand=spread_operand(item env session)
        if operand is? none {
            let value=expression(item env @session expected=wanted)
            if value is? Error return value
            items.push(value) spreads.push(false) plain.push(value)
            if length isnt? none { length=length+1 }
            continue
        }
        let source=spread_source(operand env @session)
        if source is? Error return source
        let source_type=node_at(source session).value_type
        let entry=views.container_entry_types(source_type session.types)
        if entry isnt? none and entry.value is? none {
            source=put(hir.DictView[loc types.array_type(entry.key none @session.types) source 'values'] @session)
            source_type=node_at(source session).value_type
        }
        let shape=types.node_at(session.types types.unfold(types.strip_refinement(source_type session.types) session.types))
        if shape isnt? types.ArrayType return problem(item 'array spread requires an array or set' 'dictionaries spread into dictionary literals; objects into object literals' env session)
        if first_element is? none { first_element=shape.element }
        let extra=shape.length
        if extra is? none { length=none }
        else if length isnt? none { length=length+extra }
        items.push(put(hir.Spread[loc source_type source] @session)) spreads.push(true)
    }
    let element:addr?=wanted
    if element is? none {
        $runtime_assert first_element isnt? none
        element=first_element
        let literal=types.node_at(session.types element)
        if literal is? types.IntegerLiteralType|types.StringLiteralType and plain.length >? 0 {
            let common=capture_element(plain id env @session)
            if common is? Error return common
            element=common
        }
    }
    $runtime_assert element isnt? none
    let checked:array<addr>=[]
    loop i in 0.. and i <? items.length and i <? spreads.length {
        if spreads[i] { checked.push(items[i]) continue }
        let value=against(items[i] element id env @session)
        if value is? Error return value
        checked.push(value)
    }
    return put(hir.ArrayLiteral[loc types.array_type(element length @session.types) checked] @session)
}
# Value identity alone is not permission to discard evaluation: a call can
# have a singleton result type and still change state. Only literal payloads
# and their inert wrappers can be collapsed before runtime set insertion.
constant_member = (id:addr session:contexts.Session):>bool => {
    let node=node_at(id session)
    loop true {
        if node is? hir.ValueCast|hir.RepresentationCast {node=node_at(node.expr session)}
        else if node is? hir.Block and not node.scoped and node.items.length =? 1 {node=node_at(node.items[0] session)}
        else return node is? hir.String|hir.Integer|hir.Bool
    }
    return false
}
container_literal = (id:addr node:parser.Block env:Environment @session:contexts.Session expected:addr?=none is_set:bool=false):>addr|Error => {
    let captured=captured_loop(node env session)
    if is_set and captured isnt? none return loop_capture(id captured env @session expected=expected is_set=true)
    let annotation = if expected is? none none else views.container_entry_types(expected session.types)
    let key_nodes:array<addr> = []
    let value_nodes:array<addr> = []
    if is_set { key_nodes = node.inner }
    else {
        loop row_id in node.inner {
            let row = contexts.node_at(row_id env.lexical session)
            if row isnt? parser.BinOp return problem(row_id 'dictionary literal needs pairs' 'write `key -> value` for every entry' env session)
            let op = source_views.symbol(row.op env.lexical session)
            if op =? '<->' return pending(row_id 'bidirectional dictionary literals' env session)
            if op not=? '->' return problem(row_id 'dictionary literal needs pairs' 'write `key -> value` for every entry' env session)
            key_nodes.push(row.left) value_nodes.push(row.right)
        }
    }
    let checked_keys = container_array(key_nodes if annotation is? none none else annotation.key id env @session)
    if checked_keys is? Error return checked_keys
    let key_array:addr = checked_keys
    let key_node = node_at(key_array session)
    $runtime_assert key_node is? hir.ArrayLiteral
    let key_type = types.node_at(session.types key_node.value_type)
    $runtime_assert key_type is? types.ArrayType
    let value_array:addr? = none
    let value_type:addr? = none
    if not is_set {
        let array = container_array(value_nodes if annotation is? none none else annotation.value id env @session)
        if array is? Error return array
        value_array = array
        let type = types.node_at(session.types node_at(array session).value_type)
        $runtime_assert type is? types.ArrayType
        value_type = type.element
    } else {
        # Constant members collapse now. General values need the ordinary
        # array-to-set library call, including its once-only evaluation.
        let seen:array<keys.Identity> = []
        let distinct:array<addr> = []
        loop item in key_node.items {
            let identity = keys.identity(item session.hir @session.registry @session.types)
            if identity isnt? keys.Literal or not constant_member(item session) return library_call('_set_of_array' [key_array] id env @session expected=expected)
            let duplicate = false
            loop prior in seen { if keys.same(prior identity) { duplicate = true break } }
            if not duplicate { seen.push(identity) distinct.push(item) }
        }
        key_array = put(hir.ArrayLiteral[node.loc types.array_type(key_type.element distinct.length @session.types) distinct] @session)
    }
    let type = views.container_type(key_type.element value_type @session.types)
    let value = container_values.literal(node.loc type key_array value_array @session)
    return if expected is? none value else against(value expected id env @session)
}
container_member = (receiver:addr entry:views.EntryTypes name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let loc = contexts.node_at(id env.lexical session).loc
    let is_set = entry.value is? none
    if name =? 'length' {
        return put(hir.MemberAccess[loc views.addr_type(@session.types) receiver 'live' false] @session)
    }
    if name in? ['keys' 'values'] {
        if is_set and name =? 'keys' return problem(id 'sets have no keys' 'use `.values` for the members as an array' env session)
        container_state.forget_positions(receiver env.state @session)
        let type = if name =? 'keys' views.set_type(entry.key @session.types) else types.array_type(if entry.value is? none entry.key else entry.value none @session.types)
        return put(hir.DictView[loc type receiver name] @session)
    }
    if (name =? 'get' and not is_set) or name in? ['pop' 'clear'] or (name in? ['add' 'push'] and is_set) {
        if name not=? 'get' {
            let target = writable_container(receiver id env @session)
            if target is? Error return target
            let node = node_at(receiver session)
            let binding = container_state.route(receiver @session)
            let declared = if binding is? none none else bindings.binding_at(session.registry binding).store_type
            let total = views.total_dict_key(node.value_type session.types)
            if declared isnt? none and total is? none { total = views.total_dict_key(declared session.types) }
            if total isnt? none and name in? ['pop' 'clear'] return problem(id 'cannot remove keys from a total dictionary' 'its type promises every key remains present' env session)
        }
        # `push` is uniform across containers. `add` remains a compatibility
        # alias, and both lower to the same insertion operation and effects.
        let operation=if name =? 'push' 'add' else name
        return put(hir.DictMethod[loc container_methods.signature(operation entry @session.types) receiver operation] @session)
    }
    return problem(id 'unknown container member' name env session)
}
writable_container = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let path = bindings.access_path(value session.hir dictionaries=true)
    let root = node_at(path.root session)
    if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return problem(id 'container mutation needs a named place' 'bind the container before changing it' env session)
    let binding = bindings.binding_at(session.registry root.binding_id)
    if binding.read_only_reason isnt? none return problem(id 'cannot mutate a constant container' binding.name env session)
    loop step in path.steps {
        let node = node_at(step session)
        # Array selections already carry ordinary bounds and rooted-place
        # checks; storage lowering captures their selectors exactly once.
        if node is? hir.MemberAccess and not node.mutable return problem(id 'cannot mutate an immutable container field' node.name env session)
    }
    return value
}
container_call = (method:hir.DictMethod args:array<addr> kwargs:dict<string addr> id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let entry = views.container_entry_types(node_at(method.dictionary session).value_type session.types)
    $runtime_assert entry isnt? none
    let arrays = container_values.arrays(method.dictionary @session)
    let loc = contexts.node_at(id env.lexical session).loc
    if method.name =? 'clear' {
        container_state.removed(method.dictionary none env.state @session)
        return put(hir.DictRemove[loc types.primitive('void' @session.types) arrays.keys arrays.values none] @session)
    }
    let key = if args.length >? 0 args[0] else kwargs.get('key')
    $runtime_assert key isnt? none
    let default = if args.length >? 1 args[1] else kwargs.get('default')
    if method.name =? 'get' {
        $runtime_assert entry.value isnt? none and arrays.values isnt? none
        let result = if default is? none views.optional(entry.value @session.types) else entry.value
        return put(hir.DictLookup[loc result arrays.keys arrays.values key default=default] @session)
    }
    if method.name =? 'add' {
        container_state.forget_positions(method.dictionary env.state @session)
        let position = key_position(@session)
        container_state.remember(method.dictionary key env.state @session position=position)
        return put(hir.DictStore[loc types.primitive('void' @session.types) arrays.keys none key none position=position] @session)
    }
    let fact = container_state.proven(method.dictionary key env.state @session)
    if fact is? none and default is? none return problem(id 'container key is not proven present' 'guard the pop with `in?`, or supply `default=...`' env session)
    let result = if entry.value is? none entry.key else entry.value
    if entry.value is? none and default isnt? none {
        # The signature accepts an optional default, but a supplied member
        # still gives a nonoptional result. Discard only the argument's
        # contextual wrapper, preserving the type of an actually optional
        # source value (which cannot stand in for a definite member).
        let original = default
        loop true {
            let value = node_at(original session)
            if value is? hir.RepresentationCast|hir.ValueCast { original = value.expr }
            else break
        }
        if node_at(original session) is? hir.NoneValue {
            default = original
            result = views.optional(entry.key @session.types)
        } else {
            let checked = against(original entry.key id env @session)
            if checked is? Error return checked
            default = checked
        }
    }
    container_state.removed(method.dictionary key env.state @session)
    return put(hir.DictRemove[loc result arrays.keys arrays.values key position=if fact is? none none else fact.position static_position=if fact is? none none else fact.static_position default=default lenient=entry.value is? none and default isnt? none] @session)
}
key_position = (@session:contexts.Session):>string => {
    let position = session.next_key_position
    session.next_key_position += 1
    return "__dewy_key_pos_{position}"
}
container_index = (receiver:addr index_id:addr id:addr env:Environment @session:contexts.Session store:addr?=none):>addr|Error => {
    let indices = contexts.node_at(index_id env.lexical session)
    if indices isnt? parser.Block or indices.inner.length not=? 1 return problem(id 'dictionary index needs one key' 'write `dictionary[key]`' env session)
    let entry = views.container_entry_types(node_at(receiver session).value_type session.types)
    $runtime_assert entry isnt? none
    if entry.value is? none return problem(id 'sets do not have indexed values' 'use membership, add, or pop' env session)
    let key = expression(indices.inner[0] env @session expected=entry.key)
    if key is? Error return key
    let arrays = container_values.arrays(receiver @session)
    $runtime_assert arrays.values isnt? none
    let loc = contexts.node_at(id env.lexical session).loc
    if store isnt? none {
        let target = writable_container(receiver id env @session)
        if target is? Error return target
        let value = expression(store env @session expected=entry.value)
        if value is? Error return value
        container_state.forget_positions(receiver env.state @session)
        let position = key_position(@session)
        container_state.remember(receiver key env.state @session position=position)
        return put(hir.DictStore[loc types.primitive('void' @session.types) arrays.keys arrays.values key value position=position] @session)
    }
    let fact = container_state.proven(receiver key env.state @session)
    if fact is? none return problem(id 'dictionary key is not proven present' 'guard the read with `in?`, or use `get` for an optional value' env session)
    return projected_read(put(hir.DictLookup[loc entry.value arrays.keys arrays.values key true fact.position fact.static_position] @session) env @session)
}

prove_total = (value:addr key_type:addr id:addr env:Environment @session:contexts.Session):>Error? => {
    let members = views.finite_members(key_type session.types)
    if members is? none return problem(id 'total dictionary needs a finite key type' display.type_to_dewy(key_type session.types) env session)
    let literal = container_values.literal_facts(0 value @session)
    let complete = true
    loop member in members {
        if keys.find(literal 0 keys.Literal[member]) is? none { complete = false break }
    }
    if complete return none
    let binding = container_state.route(value @session)
    let node = node_at(value session)
    let known = container_state.total_key(value session)
    if binding isnt? none {
        let declared = bindings.binding_at(session.registry binding).store_type
        if known is? none and declared isnt? none { known = views.total_dict_key(declared session.types) }
        if known is? none and keys.find(container_state.facts(env.state session) binding keys.Total[]) isnt? none {
            let entry = views.container_entry_types(node.value_type session.types)
            if entry isnt? none { known = entry.key }
        }
    }
    if known isnt? none and subtyping.is_subtype(key_type known session.links @session.types) return none
    return problem(id 'cannot prove the dictionary has every key' 'provide a literal covering the key type or an already-total dictionary' env session)
}

# A dictionary's key/value targets advance together over its compacted live
# entry arrays. This uses the same iterator HIR as arrays, preserving the
# binding identity of the key so `d[key]` is proven inside the body.
container_iterators = (id:addr node:parser.BinOp iterable:addr entry:views.EntryTypes env:Environment @prelude:array<addr> @session:contexts.Session):>IteratorResult|Error => {
    let target_syntax = contexts.node_at(node.left env.lexical session)
    let targets:array<addr> = [node.left]
    let fields:array<string> = ['keys']
    let elements:array<addr> = [entry.key]
    if entry.value isnt? none {
        if target_syntax isnt? parser.Block or target_syntax.delims not=? '[]' or target_syntax.inner.length not=? 2 return problem(id 'dictionary iteration needs two targets' 'write `loop [key value] in dictionary`' env session)
        targets = target_syntax.inner
        fields.push('values') elements.push(entry.value)
    } else if target_syntax is? parser.Block return problem(id 'a set iterator has one target' 'iterate the member directly' env session)
    container_state.forget_positions(iterable env.state @session)
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector]
    let values:array<addr> = []
    loop i in 0.. and i <? targets.length and i <? fields.length and i <? elements.length {
        let name = source_views.identifier(targets[i] env.lexical session)
        # `loop [k [a b]] in specs`: a nested target is a hidden binding of
        # the element; each written name is declared per iteration as the
        # field of that name (objects unpack by name), as the hosted rewrite.
        let nested:array<addr> = []
        if name is? none {
            let nested_syntax = contexts.node_at(targets[i] env.lexical session)
            if nested_syntax isnt? parser.Block or nested_syntax.delims not=? '[]' return pending(id 'nested iterator target unpacking' env session)
            loop item in nested_syntax.inner {
                if source_views.identifier(item env.lexical session) is? none return pending(id 'nested iterator target unpacking' env session)
                nested.push(item)
            }
            name = "__dewy_unpack_{session.registry.next_id}"
        }
        let scope = bindings.scope_at(session.scopes inner.lexical.scope)
        if name in? scope.names return problem(id 'duplicate iterator target' name env session)
        let element = elements[i]
        let binding_id = bindings.allocate_param(@session.registry name element node.loc)
        let binding = bindings.binding_at(session.registry binding_id)
        binding.store_type = element
        if types.node_at(session.types types.strip_refinement(element session.types)) is? types.ObjectType { binding.read_only_reason = 'borrows the array element; copy it with `let` to change it' }
        bindings.store_binding(@session.registry binding_id binding)
        bindings.bind(@session.scopes inner.lexical.scope name binding_id)
        let target = put(hir.ExpressedIdentifier[contexts.node_at(targets[i] env.lexical session).loc element name binding_id] @session)
        let entries = put(hir.DictEntries[node.loc types.array_type(element none @session.types) iterable fields[i]] @session)
        let type = types.parameterize(types.primitive('iterator' @session.types) [element] @session.types)
        values.push(put(hir.IteratorExpression[node.loc type target entries 0 1 none none] @session))
        if fields[i] =? 'keys' { container_state.remember(iterable target inner.state @session) }
        if nested.length >? 0 {
            let shape = types.node_at(session.types types.unfold(types.strip_refinement(element session.types) session.types))
            if shape isnt? types.ObjectType return problem(targets[i] 'nested unpacking needs an object element' display.type_to_dewy(element session.types) env session)
            loop item in nested {
                let field_name = source_views.identifier(item env.lexical session)
                $runtime_assert field_name isnt? none
                let field:types.ObjectField? = none
                loop candidate in shape.fields { if candidate.name =? field_name { field = candidate } }
                if field is? none return problem(item "no field `{field_name}` to unpack" 'objects unpack by field name: write the names of the fields you need' env session)
                let field_scope = bindings.scope_at(session.scopes inner.lexical.scope)
                if field_name in? field_scope.names return problem(item 'duplicate iterator target' field_name env session)
                let item_loc = contexts.node_at(item env.lexical session).loc
                let field_binding = bindings.allocate_param(@session.registry field_name field.value_type item_loc)
                let stored = bindings.binding_at(session.registry field_binding)
                stored.store_type = field.value_type
                bindings.store_binding(@session.registry field_binding stored)
                bindings.bind(@session.scopes inner.lexical.scope field_name field_binding)
                let source = put(hir.ExpressedIdentifier[item_loc element name binding_id] @session)
                let member = put(hir.MemberAccess[item_loc field.value_type source field_name field.mutable and not shape.immutable] @session)
                prelude.push(put(hir.Declare[item_loc types.primitive('void' @session.types) 'let' field_name field.value_type member field_binding] @session))
            }
        }
    }
    return IteratorResult[values inner]
}

# Algebra is a builtin-call rule, so a lexical replacement of an operator
# remains an ordinary function. Invariant containers need matching element
# types; dictionary union retains left order and the right value on overlap.
container_algebra = (name:string left:addr right:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let a = node_at(left session)
    let b = node_at(right session)
    let a_entry = views.container_entry_types(a.value_type session.types)
    let b_entry = views.container_entry_types(b.value_type session.types)
    if a_entry is? none or b_entry is? none return problem(id 'container operands must have the same kind' 'combine two dictionaries or two sets' env session)
    let operation = container_methods.algebra.get(name)
    if operation is? none return problem(id 'no matching container operator' name env session)
    if a_entry.value isnt? none or b_entry.value isnt? none {
        if a_entry.value is? none or b_entry.value is? none or operation not=? 'union' return problem(id 'dictionaries combine with union' 'use `|`/`or`, or take `.keys` for set algebra' env session)
        if not types.same_type(a.value_type b.value_type session.types) return problem(id 'dictionary operands have different types' 'their key and value types must match' env session)
    } else if not types.same_type(a_entry.key b_entry.key session.types) return problem(id 'set operands have different element types' 'their member types must match' env session)
    let loc = contexts.node_at(id env.lexical session).loc
    return put(hir.SetAlgebra[loc a.value_type operation left right] @session)
}

# Some builtins select a representation-bearing HIR operation once their
# operand types are known. Only the original builtin binding reaches these
# rules; lexical operator declarations keep normal function-call semantics.
folded_number = (name:string arguments:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let dimension=numeric_constants.result_dimension(name arguments @session)
    if dimension is? string return problem(id dimension 'only quantities of the same dimension add, subtract, or compare' env session)
    let folded=numeric_constants.fold(name arguments session)
    if folded isnt? none {
        let loc=contexts.node_at(id env.lexical session).loc
        if folded is? string return problem(id folded 'the divisor is the constant `0`' env session)
        if folded is? bool return put(hir.Bool[loc types.primitive('bool' @session.types) folded] @session)
        let type=types.rational_literal(folded.numerator folded.denominator @session.types)
        let normalized=types.node_at(session.types type)
        $runtime_assert normalized is? types.RationalLiteralType
        let dimensioned=dimension isnt? none and types.dimension_at(dimension session.types).powers.length >? 0
        let integers=true
        loop argument in arguments {
            if types.node_at(session.types numeric_constants.number_type(argument session)) isnt? types.IntegerLiteralType {integers=false break}
        }
        if normalized.denominator =? 1 and (dimensioned or integers and name not=? '__truediv__') {
            let integer_type=types.integer_literal(normalized.numerator @session.types)
            if dimensioned {
                $runtime_assert dimension isnt? none
                integer_type=types.quantity_type(integer_type dimension @session.types)
            }
            return put(hir.Integer[loc integer_type '0d' normalized.numerator] @session)
        }
        let result_type=type
        if dimensioned {
            $runtime_assert dimension isnt? none
            result_type=types.quantity_type(type dimension @session.types)
        }
        return put(hir.RationalConstant[loc result_type normalized.numerator normalized.denominator] @session)
    }
    loop argument in arguments {
        if numeric_values.is_family(numeric_constants.number_type(argument session) 'Fixed' env.lexical session) return none
    }
    if dimension isnt? none return pending(id 'runtime quantity arithmetic materialization' env session)
    return none
}
builtin_value = (function:addr arguments:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    let func = node_at(function session)
    if func isnt? hir.ExpressedIdentifier or func.binding_id is? none return none
    let binding = bindings.binding_at(session.registry func.binding_id)
    if not binding.builtin return none
    let name = func.name
    let folded=folded_number(name arguments id env @session)
    if folded isnt? none return folded
    if arguments.length not=? 2 return none
    let left = arguments[0]
    let right = arguments[1]
    let a = node_at(left session)
    let b = node_at(right session)
    if name in? ['__eq__' '__ne__'] {
        let member=literal_members.find(left right session)
        if member isnt? none return put(hir.TypeTest[contexts.node_at(id env.lexical session).loc types.primitive('bool' @session.types) member.value member.literal name =? '__ne__'] @session)
        loop index in 0..1 {
            let value=arguments[index]
            let other=arguments[1-index]
            let constant=numeric_constants.value(other session)
            if constant is? none or constant.numerator not=? 0 continue
            let field=numeric_zero_field(node_at(value session).value_type env session)
            if field is? none continue
            # The guard must name the payload route. Fixed division needs
            # its raw word nonzero; word-rational division needs its numerator.
            let payload=member_named(value field id env @session)
            if payload is? Error return payload
            let zero=put(hir.Integer[node_at(other session).loc types.integer_literal(0 @session.types) '0d' 0] @session)
            return call(function [payload zero] [] id env @session)
        }
    }
    if name =? '__and__' and types.node_at(session.types a.value_type) is? types.CallableType and types.node_at(session.types b.value_type) is? types.CallableType {
        let methods:array<addr>=[]
        let alternates:array<addr>=[]
        loop argument in arguments {
            let value=node_at(argument session)
            let type=types.node_at(session.types value.value_type)
            if type is? types.OverloadType {loop method in type.methods {methods.push(method)}}
            else {methods.push(value.value_type)}
            if value is? hir.OverloadedFunction {loop alternate in value.alternates {alternates.push(alternate)}}
            else {alternates.push(argument)}
        }
        let loc=contexts.node_at(id env.lexical session).loc
        return put(hir.OverloadedFunction[loc types.overload_type(methods @session.types) alternates] @session)
    }
    if views.container_entry_types(a.value_type session.types) isnt? none or views.container_entry_types(b.value_type session.types) isnt? none return container_algebra(name left right id env @session)
    if not views.string_valued(a.value_type session.types) or not views.string_valued(b.value_type session.types) return none
    let loc = contexts.node_at(id env.lexical session).loc
    let a_type = types.node_at(session.types a.value_type)
    let b_type = types.node_at(session.types b.value_type)
    if name in? ['__eq__' '__ne__'] {
        let boolean = types.primitive('bool' @session.types)
        if a_type is? types.StringLiteralType and b_type is? types.StringLiteralType {
            let equal=(a_type.value =? b_type.value) not=? (name =? '__ne__')
            return put(if a is? hir.TargetString or b is? hir.TargetString hir.TargetBool[loc boolean equal] else hir.Bool[loc boolean equal] @session)
        }
        return put(hir.StringEqual[loc boolean left right name =? '__ne__'] @session)
    }
    if name =? '__add__' {
        if a_type is? types.StringLiteralType and b_type is? types.StringLiteralType {
            let content = a_type.value + b_type.value
            return put(hir.String[loc types.string_literal(content @session.types) content] @session)
        }
        return put(hir.StringConcat[loc types.string_type(none @session.types) left right] @session)
    }
    return none
}

numeric_zero_field = (type:addr env:Environment session:contexts.Session):>string? => {
    const names:dict<string string>=['Fixed'->'raw' 'Rational'->'numerator']
    loop [name field] in names {
        let id=declarations.lookup(name env.lexical session)
        if id is? none continue
        let binding=bindings.binding_at(session.registry id)
        let declared=binding.type_value
        if declared is? addr and types.same_type(type declared session.types) return field
    }
    return none
}

# A generic's checked signature participates in normal dispatch, but its body
# belongs to the defining source/scope. Call-site names only determine actual
# types; they must not change how names inside that body resolve.
instantiate_call = (callee:hir.ExpressedIdentifier signature:types.FunctionType positional:array<addr> keyword:dict<string addr> expected:addr? id:addr env:Environment @session:contexts.Session):>addr|Error|none => {
    if callee.binding_id is? none return none
    let original = bindings.binding_at(session.registry callee.binding_id)
    if original.function is? none return none
    let generic = node_at(original.function session)
    if generic isnt? hir.GenericFunction return none
    let inference = dispatch.infer_type_args(signature positional keyword expected dispatch.System[session.links builtins.promotions bigint=numeric_values.family('BigInt' env.lexical session) rational=numeric_values.family('Rational' env.lexical session) fixed=numeric_values.family('Fixed' env.lexical session)] @session.types)
    if inference is? none return problem(id 'cannot infer generic type parameters' 'the arguments do not determine every type parameter' env session)
    let arguments:dict<string addr> = []
    loop param in generic.source.params {
        if param.kind =? 'effect' continue
        let inferred = inference.bindings.get(param.name)
        $runtime_assert inferred isnt? none
        let type = types.node_at(session.types inferred)
        let concrete = inferred
        if type is? types.IntegerLiteralType or types.is_primitive(type 'int') {
            concrete = types.primitive('int64' @session.types)
            if type is? types.IntegerLiteralType and not subtyping.is_subtype(inferred concrete session.links @session.types) {
                # Match an ordinary inferred binding and hosted generic
                # inference: large literals materialize into the prelude's
                # bigint representation before entering the instance.
                let big=numeric_values.family('BigInt' env.lexical session)
                if big is? none return pending(id 'a bigint generic type argument without the numeric prelude' env session)
                concrete=big
            }
        }
        else if type is? types.StringLiteralType | types.StringType { concrete = types.primitive('string' @session.types) }
        else if type is? types.BinaryLiteralType { concrete = types.array_type(types.primitive('uint8' @session.types) type.value.length @session.types) }
        # Refinements nested inside containers are invariant storage contracts,
        # not scalar read facts. Inference retains them; do not erase them here.
        arguments[param.name] = concrete
    }
    let cached:addr? = none
    loop [binding_id instance] in session.registry.generic_instances {
        if instance.generic not=? callee.binding_id continue
        let matches = true
        loop [name actual] in arguments {
            let prior = instance.type_arguments.get(name)
            # Type arena identity retains defaults/method source. Structural
            # equality is sufficient for assignment, not for checking a body.
            if prior is? none or prior not=? actual { matches = false break }
        }
        if matches {
            loop [key actual] in inference.effects {
                let prior=instance.effect_arguments.get(key)
                if prior is? none or effect_rows.identity(prior) not=? effect_rows.identity(actual) {matches=false break}
            }
        }
        if matches { cached = binding_id break }
    }
    if cached isnt? none {
        let binding = bindings.binding_at(session.registry cached)
        $runtime_assert binding.value_type isnt? none
        return put(hir.ExpressedIdentifier[callee.loc binding.value_type binding.name binding.id] @session)
    }
    let source = generic.source
    $runtime_assert source.literal <? session.syntax_refs.length
    let reference = session.syntax_refs[source.literal]
    let lexical = contexts.child(contexts.Context[reference.source reference.scope] @session)
    loop [name actual] in arguments {
        let parameter_id = bindings.allocate_param(@session.registry name types.primitive('type' @session.types) generic.loc)
        let parameter = bindings.binding_at(session.registry parameter_id)
        parameter.type_value = actual
        bindings.store_binding(@session.registry parameter_id parameter)
        bindings.bind(@session.scopes lexical.scope name parameter_id)
    }
    loop parameter in source.params {
        if parameter.kind not=? 'effect' {continue}
        $runtime_assert parameter.identity in? inference.effects
        let parameter_id=bindings.allocate_param(@session.registry parameter.name types.primitive('type' @session.types) generic.loc)
        let binding=bindings.binding_at(session.registry parameter_id)
        binding.kind='effect'
        binding.effect_value=inference.effects[parameter.identity]
        bindings.store_binding(@session.registry parameter_id binding)
        bindings.bind(@session.scopes lexical.scope parameter.name parameter_id)
    }
    let literal = contexts.node_at(reference.node lexical session)
    $runtime_assert literal is? parser.BinOp
    let defining = Environment[lexical source.context]
    let resolved = function_shape(literal defining @session concrete=true)
    if resolved is? Error return resolved
    let name = "{generic.name}__instance_{session.registry.next_id}"
    let binding_id = bindings.allocate(@session.registry none name 'function' generic.loc)
    let binding = bindings.binding_at(session.registry binding_id)
    binding.value_type = resolved binding.store_type = resolved
    bindings.store_binding(@session.registry binding_id binding)
    # Register before checking: a recursive call with these same types must
    # refer to this declaration, rather than instantiate another body.
    session.registry.generic_instances[binding_id] = bindings.GenericInstance[callee.binding_id arguments contexts.syntax_ref(id env.lexical @session) inference.effects]
    let value = function_literal(reference.node literal defining @session concrete=true name=name)
    if value is? Error {
        if binding_id in? session.registry.generic_instances { session.registry.generic_instances.pop(binding_id); }
        return value
    }
    let declared = put(hir.Declare[generic.loc types.primitive('void' @session.types) 'let' name none value binding_id] @session)
    binding = bindings.binding_at(session.registry binding_id)
    binding.declaration = declared binding.function = value
    bindings.store_binding(@session.registry binding_id binding)
    session.hoisted.push(declared)
    return put(hir.ExpressedIdentifier[callee.loc resolved name binding_id] @session)
}


# Keep source diagnostics beside their proof obligation. Reporting is a
# runtime-library operation, separate from checking the condition and from
# carrying facts along the continuation that can actually be reached.
const assertion_whitespace=set['\r\n' '\u0009' '\u000a' '\u000b' '\u000c' '\u000d' '\u001c' '\u001d' '\u001e' '\u001f' '\u0020' '\u0085' '\u00a0' '\u1680' '\u2000' '\u2001' '\u2002' '\u2003' '\u2004' '\u2005' '\u2006' '\u2007' '\u2008' '\u2009' '\u200a' '\u2028' '\u2029' '\u202f' '\u205f' '\u3000']
assertion_source = (id:addr env:Environment session:contexts.Session):>string => {
    let span = contexts.node_at(id env.lexical session).loc
    let text = source_views.srcfile(env.lexical session).body
    $runtime_assert span.start <=? span.stop and span.stop <=? text.length
    if span.start =? span.stop return ''
    # Match the hosted diagnostic's whitespace normalization, including
    # Unicode separators; source offsets themselves remain untouched.
    let parts:array<string>=[]
    let pending_space:bool=false
    let i=span.start
    loop i <? span.stop {
        let char=text[i]
        let space=char in? assertion_whitespace
        if space { pending_space=parts.length >? 0 }
        else {
            if pending_space { parts.push(' ') pending_space=false }
            parts.push(char)
        }
        i += 1
    }
    return parts.join
}
assertion_failure = (id:addr node:parser.Directive condition:addr? text:string env:Environment @session:contexts.Session):>addr|Error => {
    let message:addr? = none
    let dimmed:Span? = none
    if node.message isnt? none {
        let checked = expression(node.message env @session expected=types.primitive('string' @session.types))
        if checked is? Error return checked
        message = checked
        if node.condition isnt? none {
            let condition_span = contexts.node_at(node.condition env.lexical session).loc
            let message_span = contexts.node_at(node.message env.lexical session).loc
            dimmed = Span[condition_span.stop message_span.stop]
        }
    }
    let mode:'assert'|'expect'|'fail' = if node.name =? 'expect' 'expect' else if node.name =? 'fail' 'fail' else 'assert'
    return put(hir.RuntimeFailure[node.loc types.primitive('never' @session.types) env.lexical.source text mode condition message dimmed] @session)
}
directive = (id:addr node:parser.Directive env:Environment @session:contexts.Session):>addr|Error => {
    if node.name =? 'abstract' return problem(id '`$abstract` marks a `type of` mint' 'it belongs on the value of a type alias' env session)
    if node.name =? 'breakpoint' return pending(id 'debugger binding snapshots and breakpoint reporting' env session)
    if node.name =? 'expect' or node.name =? 'fail' {
        if env.return_collector is? none return problem(id "`${node.name}` outside a function" 'a failed expectation returns from the enclosing void function' env session)
        if env.return_type isnt? none and not types.is_primitive(types.node_at(session.types env.return_type) 'void') return problem(id "`${node.name}` in a function that returns a value" 'expectations belong in void functions' env session)
        record_return(types.primitive('void' @session.types) node.loc env @session)
    }
    if node.name =? 'fail' return assertion_failure(id node none 'fail' env @session)
    if node.name not in? ['assert' 'unsafe_assume' 'runtime_assert' 'expect'] return pending(id "directive `${node.name}`" env session)
    $runtime_assert node.condition isnt? none
    let condition = expression(node.condition env @session expected=types.primitive('bool' @session.types))
    if condition is? Error return condition
    let value = node_at(condition session)
    hoist_condition(condition @session)
    let text = assertion_source(node.condition env session)
    let dimmed:Span? = none
    if node.message isnt? none {
        let condition_span = contexts.node_at(node.condition env.lexical session).loc
        let message_span = contexts.node_at(node.message env.lexical session).loc
        dimmed = Span[condition_span.stop message_span.stop]
    }
    let empty = types.primitive('void' @session.types)
    if node.name in? ['assert' 'unsafe_assume'] {
        let message:string? = none
        if node.message isnt? none {
            let checked = expression(node.message env @session)
            if checked is? Error return checked
            let literal = node_at(checked session)
            if literal isnt? hir.String return problem(node.message 'a compile-time assertion message must be a string literal' 'the message cannot depend on runtime values' env session)
            message = literal.content
        }
        if node.name =? 'unsafe_assume' {
            if not checked_proofs.fact_term(condition checked_proofs.Input[session.hir session.registry session.sources]) return problem(node.condition 'an unsafe assumption needs a pure fact condition' 'the condition is not evaluated at runtime; use names, literals, trusted measures and supported arithmetic' env session)
            let held=refined(condition true env @session)
            join_reads([held] env @session)
            let assertion=put(hir.Assert[node.loc empty condition text message dimmed=dimmed unsafe=true] @session)
            session.unsafe_assertions.add(assertion)
            return assertion
        }
        if value is? hir.Bool {
            if not value.value return problem(node.condition 'assertion refuted' if message is? none 'this condition is false at compile time' else message env session)
            return void_at(id env @session)
        }
        return put(hir.Assert[node.loc empty condition text message dimmed=dimmed] @session)
    }
    if value is? hir.Bool {
        if not value.value and node.name not=? 'expect' return problem(node.condition 'assertion refuted' 'this condition is false at compile time' env session)
        if not value.value {
            let syntax = contexts.node_at(node.condition env.lexical session)
            let literal = if syntax is? parser.Atom contexts.node_at(syntax.item env.lexical session) is? tokens.Bool else false
            if not literal {
                let pointer=Pointer[span=syntax.loc message='this condition is false']
                session.warnings.push(Warning[srcfile=source_views.srcfile(env.lexical session) title='expectation refuted at compile time' pointers=[pointer] hint='the test will fail when it runs'])
            }
            return assertion_failure(id node condition text env @session)
        }
        # Dead messages are still checked, matching the hosted source checker.
        if node.message isnt? none {
            let message = expression(node.message env @session)
            if message is? Error return message
        }
        return void_at(id env @session)
    }
    let failure_env = refined(condition false env @session)
    let failed = assertion_failure(id node condition text failure_env @session)
    if failed is? Error return failed
    let failure = put(hir.Block[node.loc types.primitive('never' @session.types) [failed] true] @session)
    let arm = put(hir.IfArm[node.loc empty condition void_at(id env @session)] @session)
    let flow = put(hir.Flow[node.loc empty [arm] failure] @session)
    let obligation = put(hir.Assert[node.loc empty condition text none runtime=true dimmed=dimmed expect=node.name =? 'expect'] @session)
    let held = refined(condition true env @session)
    join_reads([held] env @session)
    return put(hir.Block[node.loc empty [obligation flow] false] @session)
}

# A flow specification keeps source bodies unevaluated while all match
# patterns establish reachability and exhaustiveness. Scrutinees which are
# not named storage are evaluated once, in the flow's prelude.
FlowSpec:type = const [syntax:addr body:addr condition:addr?=none patterns:array<patterns.Pattern>=[] subjects:array<addr>=[] is_loop:bool=false]
MatchPlan:type = const [specs:array<FlowSpec> prelude:array<addr> total:bool coverage:array<patterns.Coordinate>]
match_bind = (name:string value:addr id:addr env:Environment @session:contexts.Session hidden:bool=false):>addr|Error => {
    let loc=contexts.node_at(id env.lexical session).loc
    # Pattern bindings are sequential declarations, including repeated `_`
    # parameters. A later binding shadows the earlier name, not its HIR id.
    let checked:addr|Error=if hidden value else widen(value id env @session strings=false)
    if checked is? Error return checked
    let type=node_at(checked session).value_type
    let binding_id=bindings.allocate(@session.registry none name 'value' loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=type binding.store_type=type
    let declaration=put(hir.Declare[loc types.primitive('void' @session.types) 'let' name none checked binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    bindings.bind(@session.scopes env.lexical.scope name binding_id)
    set_read_type(binding_id type env @session)
    container_state.seed(binding_id checked env.state @session)
    container_state.seed_fields(binding_id checked env.state @session)
    return declaration
}
match_plan = (arm:parser.KeywordExpr env:Environment @session:contexts.Session):>MatchPlan|Error => {
    $runtime_assert arm.parts.length =? 3
    let scrutinee=contexts.node_at(arm.parts[1] env.lexical session)
    let elements:array<addr>=if scrutinee is? parser.Block and scrutinee.delims =? '()' and scrutinee.inner.length not=? 1 scrutinee.inner else [arm.parts[1]]
    let subjects:array<addr>=[]
    let prelude:array<addr>=[]
    let coverage:array<patterns.Coordinate>=[]
    loop element in elements {
        let checked=expression(element env @session)
        if checked is? Error return checked
        let value:addr=checked
        let node=node_at(value session)
        if types.is_primitive(types.node_at(session.types node.value_type) 'void') return problem(element 'match scrutinee must have a value' 'void does not supply a value to match' env session)
        if node isnt? hir.ExpressedIdentifier {
            let declared=match_bind("__dewy_match_{session.registry.next_id}" value element env @session hidden=true)
            if declared is? Error return declared
            prelude.push(declared)
            let binding=node_at(declared session)
            $runtime_assert binding is? hir.Declare
            value=put(hir.ExpressedIdentifier[node.loc node.value_type binding.name binding.binding_id] @session)
        }
        subjects.push(value)
        coverage.push(patterns.Coordinate[patterns.begin(node_at(value session).value_type session)])
    }
    let clauses=contexts.node_at(arm.parts[2] env.lexical session)
    let rows:array<addr>=if clauses is? parser.Block and clauses.delims =? '\{}' clauses.inner else [arm.parts[2]]
    if rows.length =? 0 return problem(arm.parts[2] 'match needs at least one arm' 'empty arm group' env session)
    let specs:array<FlowSpec>=[]
    let products:array<patterns.Product>=[]
    let total=false
    loop row in rows {
        let clause=contexts.node_at(row env.lexical session)
        if clause isnt? parser.BinOp or not source_views.is_operator(clause.op '=>' env.lexical session) return problem(row 'match arm must be `pattern => body`' 'not an arm' env session)
        let parsed=patterns.parse(clause.left env.lexical @session)
        if parsed is? Error return parsed
        let selected:array<patterns.Pattern>=[]
        if parsed.kind =? 'sequence' {
            if parsed.items.length not=? subjects.length return problem(clause.left 'sequence match arm arity' 'the pattern and scrutinee must have the same number of values' env session)
            loop element in parsed.items {
                let pattern=patterns.parse(element env.lexical @session)
                if pattern is? Error return pattern
                if pattern.kind =? 'sequence' return problem(element 'a sequence pattern needs a sequence scrutinee' 'this scrutinee element is one value' env session)
                selected.push(pattern)
            }
        } else {
            if subjects.length not=? 1 return problem(clause.left 'sequence match arm arity' 'the pattern and scrutinee must have the same number of values' env session)
            selected.push(parsed)
        }
        if total return problem(clause.left 'unreachable match arm' 'earlier arms already cover every value' env session)
        let progressed=false
        let complete=true
        let possible=true
        let arm_complete=true
        let admitted:array<patterns.Coordinate>=[]
        loop i in 0.. and i <? selected.length {
            $runtime_assert i <? coverage.length
            let member=coverage[i].members
            let fresh=patterns.fresh(member)
            if patterns.cover(selected[i] @member @session) {progressed=true}
            if not patterns.all_full(member) {complete=false}
            coverage[i]=patterns.Coordinate[member]
            if not patterns.cover(selected[i] @fresh @session) {possible=false}
            if not patterns.all_full(fresh) {arm_complete=false}
            admitted.push(patterns.Coordinate[fresh])
        }
        if subjects.length >? 1 {
            let product=patterns.Product[admitted]
            if not possible return problem(clause.left 'unreachable match arm' 'the pattern admits no value' env session)
            loop previous in products {
                if patterns.contains_product(previous product) return problem(clause.left 'unreachable match arm' 'an earlier arm already covers this product' env session)
            }
            total=arm_complete
            products.push(product)
        } else {
            if not progressed return problem(clause.left 'unreachable match arm' 'earlier arms already cover these values' env session)
            total=complete
        }
        specs.push(FlowSpec[row clause.right patterns=selected subjects=subjects])
    }
    return MatchPlan[specs prelude total coverage]
}
# Refresh named reads with this arm's alternatives while preserving their
# binding identities. A shadowing pattern name must not redirect a subject.
projected_read = (id:addr env:Environment @session:contexts.Session):>addr => {
    let type=types.node_at(session.types views.structural_base(node_at(id session).value_type session.types))
    if type is? types.ObjectType|types.TypeOr return match_read(id env @session)
    return id
}
match_read = (id:addr env:Environment @session:contexts.Session):>addr => {
    let node=node_at(id session)
    let route=bindings.array_route_id(id session.hir @session.registry)
    if route is? none return id
    # A route id identifies storage, not the record alternative first seen
    # at that path. Without a fact in this branch, use this owner's field
    # declaration (`Bool.value` and `Integer.value` can have different types).
    let type=read_type(route env session fallback=node.value_type)
    $runtime_assert type isnt? none
    if type =? node.value_type return id
    if node is? hir.ExpressedIdentifier return put(hir.ExpressedIdentifier[node.loc type node.name node.binding_id] @session)
    if node is? hir.MemberAccess return put(hir.MemberAccess[node.loc type node.value node.name node.mutable] @session)
    if node is? hir.Index return put(hir.Index[node.loc type node.array node.index node.constant_index] @session)
    if node is? hir.DictLookup return put(hir.DictLookup[node.loc type node.keys node.values node.key node.proven node.position node.static_position node.default] @session)
    return id
}
# A narrowed read does not narrow the destination's assignment contract.
store_type = (id:addr @session:contexts.Session):>addr => {
    let node=node_at(id session)
    if node is? hir.MemberAccess {
        let owner=types.node_at(session.types views.structural_base(node_at(node.value session).value_type session.types))
        if owner is? types.ObjectType {
            let field=types.object_field(owner node.name)
            if field isnt? none return if field.refinement.length =? 0 field.value_type else types.refined_type(field.value_type field.refinement @session.types)
        }
    }
    if node is? hir.Index {
        let array=types.node_at(session.types views.structural_base(node_at(node.array session).value_type session.types))
        if array is? types.ArrayType return array.element
    }
    let route=bindings.array_route_id(id session.hir @session.registry)
    if route isnt? none {
        let binding=bindings.binding_at(session.registry route)
        if binding.store_type isnt? none return binding.store_type
        let declared=binding.value_type
        if declared isnt? none return declared
    }
    return node_at(id session).value_type
}

MatchTest:type = const [conditions:array<addr> environment:Environment]
match_test = (subject:addr pattern:patterns.Pattern env:Environment @session:contexts.Session):>MatchTest|Error => {
    if pattern.kind =? 'any' return MatchTest[[] env]
    let current=env
    let conditions:array<addr>=[]
    let base:addr?=none
    let props:array<propositions.Proposition>=[]
    if pattern.kind =? 'type' {
        $runtime_assert pattern.test isnt? none
        base=types.strip_refinement(pattern.test session.types)
        let declared=types.node_at(session.types pattern.test)
        if declared is? types.RefinedType {props=declared.propositions}
    } else if pattern.kind =? 'object' {
        base=patterns.object_member(node_at(match_read(subject current @session) session).value_type pattern.fields session.types)
        if base is? none return problem(pattern.syntax 'object pattern does not select one member' 'the field names must identify exactly one record alternative' env session)
    } else return problem(pattern.syntax 'a sequence pattern needs a sequence scrutinee' 'the scrutinee is one value' env session)
    $runtime_assert base isnt? none
    let value=match_read(subject current @session)
    let type=node_at(value session).value_type
    let loc=contexts.node_at(pattern.syntax env.lexical session).loc
    if not subtyping.is_subtype(types.strip_refinement(type session.types) base session.links @session.types) {
        let condition=put(hir.TypeTest[loc types.primitive('bool' @session.types) value base false] @session)
        let target=types.node_at(session.types base)
        if target is? types.IntegerLiteralType {
            let literal=put(hir.Integer[loc base '0d' target.value] @session)
            let function=identifier('__eq__' pattern.syntax current @session)
            if function is? Error return function
            let tested=call(function [value literal] [] pattern.syntax current @session)
            if tested is? Error return tested
            condition=tested
        }
        conditions.push(condition)
        current=refined(condition true current @session)
    }
    loop proposition in props {
        let value=match_read(subject current @session)
        let field=propositions.field(proposition)
        if field isnt? none {
            loop name in field.split('.') {
                let accessed=member_named(value name pattern.syntax current @session)
                if accessed is? Error return accessed
                value=accessed
            }
        }
        if proposition.subject =? 'length' or proposition.projection =? 'length' {
            let accessed=member_named(value 'length' pattern.syntax current @session)
            if accessed is? Error return accessed
            value=accessed
        }
        if proposition.term isnt? none or proposition.tested_type isnt? none return pending(pattern.syntax 'nonconstant match refinement tests' env session)
        let name=builtins.binary_operators.get(proposition.op)
        if proposition.op =? 'not=?' {name='__ne__'}
        if name is? none return pending(pattern.syntax 'this match refinement test' env session)
        let function=identifier(name pattern.syntax current @session)
        if function is? Error return function
        let constant=put(hir.Integer[loc types.integer_literal(proposition.value @session.types) '0d' proposition.value] @session)
        let guard=call(function [value constant] [] pattern.syntax current @session)
        if guard is? Error return guard
        conditions.push(guard)
        current=refined(guard true current @session)
    }
    if pattern.kind =? 'object' {
        loop field in pattern.fields {
            if field.test is? none continue
            let value=member_named(match_read(subject current @session) field.name pattern.syntax current @session)
            if value is? Error return value
            let tested=match_test(value patterns.Pattern[pattern.syntax 'type' name=field.name test=field.test] current @session)
            if tested is? Error return tested
            loop condition in tested.conditions {conditions.push(condition)}
            current=tested.environment
        }
    }
    return MatchTest[conditions current]
}
match_condition = (spec:FlowSpec env:Environment @session:contexts.Session):>addr|Error => {
    let current=env
    let conditions:array<addr>=[]
    loop i in 0.. and i <? spec.patterns.length {
        $runtime_assert i <? spec.subjects.length
        let tested=match_test(spec.subjects[i] spec.patterns[i] current @session)
        if tested is? Error return tested
        loop condition in tested.conditions {conditions.push(condition)}
        current=tested.environment
    }
    let loc=contexts.node_at(spec.syntax env.lexical session).loc
    let bool=types.primitive('bool' @session.types)
    if conditions.length =? 0 return put(hir.Bool[loc bool true] @session)
    let combined=conditions[0]
    let i:addr=1
    loop i <? conditions.length {combined=put(hir.ShortCircuit[loc bool 'and' combined conditions[i]] @session) i += 1}
    return combined
}
match_body = (spec:FlowSpec env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let inner=Environment[contexts.child(env.lexical @session) env.state env.return_type env.control env.return_collector]
    let declarations:array<addr>=[]
    # Read all subjects before introducing names, so binding a parameter named
    # like another scrutinee cannot redirect its lexical identity.
    loop i in 0.. and i <? spec.patterns.length {
        $runtime_assert i <? spec.subjects.length
        let pattern=spec.patterns[i]
        let value=match_read(spec.subjects[i] inner @session)
        if pattern.name isnt? none {
            let declared=match_bind(pattern.name value pattern.syntax inner @session)
            if declared is? Error return declared
            declarations.push(declared)
        }
        if pattern.kind =? 'object' {
            loop field in pattern.fields {
                let checked=member_named(value field.name pattern.syntax inner @session)
                if checked is? Error return checked
                let accessed:addr=checked
                if field.test isnt? none {
                    # The arm's runtime tests established this field's selected
                    # alternative. Binding the field copies that checked read.
                    let field_node=node_at(accessed session)
                    let selected=select_type(field_node.value_type field.test true @session)
                    accessed=put(hir.ValueCast[field_node.loc selected accessed] @session)
                }
                let declared=match_bind(field.name accessed pattern.syntax inner @session)
                if declared is? Error return declared
                declarations.push(declared)
            }
        }
    }
    let syntax=contexts.node_at(spec.body inner.lexical session)
    let value=if syntax is? parser.Block and syntax.delims =? '\{}' block(spec.body inner @session expected=expected) else expression(spec.body inner @session expected=expected)
    if value is? Error return value
    let node=node_at(value session)
    declarations.push(value)
    return put(hir.Block[node.loc node.value_type declarations true] @session)
}
# Flow results describe the common value boundary, not the syntax of each
# arm. Equal singleton results stay exact; different integer singletons use
# a word, while string alternatives retain their enum-like union.
flow_value_type = (results:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error => {
    if results.length =? 0 return types.primitive('never' @session.types)
    let has_void=false
    let has_value=false
    let same=true
    let same_base=true
    let integers=true
    let first=results[0]
    let base=types.strip_refinement(first session.types)
    let literals:array<bigint>=[]
    let words:array<addr>=[]
    loop result in results {
        if types.is_primitive(types.node_at(session.types result) 'void') {has_void=true} else {has_value=true}
        if not types.same_type(first result session.types) {same=false}
        if not types.same_type(base types.strip_refinement(result session.types) session.types) {same_base=false}
        let node=types.node_at(session.types result)
        if node is? types.IntegerLiteralType {literals.push(node.value)}
        else {integers=false words.push(types.strip_refinement(result session.types))}
    }
    if has_void and has_value return problem(id 'conditional branches disagree on whether they produce a value' 'suppress unwanted values with a semicolon or give every continuing branch a value' env session)
    if has_void return types.primitive('void' @session.types)
    if same return first
    if same_base return base
    if integers return types.primitive('int64' @session.types)
    if literals.length >? 0 and words.length >? 0 {
        let word=words[0]
        let same_word=true
        loop type in words {if not types.same_type(word type session.types) {same_word=false}}
        let bounds=views.fixed_integer_bounds(word session.types)
        if same_word and bounds isnt? none {
            let fits=true
            loop value in literals {if value <? bounds.minimum or value >? bounds.maximum {fits=false}}
            if fits return word
        }
    }
    return subtyping.join(results session.links @session.types)
}


# Explicit returns share a collector across lexical branches, but nested
# functions start a new one. A valued return cannot be mixed with a bare
# return or fall through into an implicit expression result.
record_return = (type:addr loc:Span env:Environment @session:contexts.Session):>void => {
    $runtime_assert env.return_collector isnt? none and env.return_collector <? session.return_collectors.length
    let collector=session.return_collectors[env.return_collector]
    collector.sites.push(contexts.ReturnSite[type loc])
    session.return_collectors[env.return_collector]=collector
}
discarded_expression = (id:addr session:contexts.Session):>bool => {
    let node=node_at(id session)
    if node is? hir.Block {
        loop item in node.items {if discarded_expression(item session) return true}
        return false
    }
    if node is? hir.Flow {
        loop arm in node.arms {
            let item=node_at(arm session)
            if item is? hir.IfArm|hir.LoopArm and discarded_expression(item.body session) return true
        }
        return node.default isnt? none and discarded_expression(node.default session)
    }
    let type=types.node_at(session.types node.value_type)
    return not types.is_primitive(type 'void') and not types.is_primitive(type 'never')
}
infer_function_result = (body:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    $runtime_assert env.return_collector isnt? none and env.return_collector <? session.return_collectors.length
    let collector=session.return_collectors[env.return_collector]
    let body_type=node_at(body session).value_type
    if collector.sites.length =? 0 return body_type
    let bare=false
    let values:array<addr>=[]
    loop site in collector.sites {
        if types.is_primitive(types.node_at(session.types site.value_type) 'void') {bare=true}
        else {values.push(site.value_type)}
    }
    if bare and values.length >? 0 return problem(id 'not all paths return a value' 'give every return a value, or none of them' env session)
    if not bare and not types.is_primitive(types.node_at(session.types body_type) 'never') return problem(id 'not all paths return a value' 'control reaches the end of a body which explicitly returns values' env session)
    if discarded_expression(body session) return problem(id 'expressed value is discarded' 'this body returns explicitly; use return or suppress the unused expression with a semicolon' env session)
    return if bare types.primitive('void' @session.types) else subtyping.join(values session.links @session.types)
}

# Type metadata retains source methods unchanged. Compilation-owned entries
# hold hidden functions, keeping interned type keys stable across checking.
method_key = (owner:addr method:types.MethodSpec):>string => "{owner}:{method.literal}"
MethodPlan:type = const [method:types.MethodSpec references:set<string> instance:bool mutates:bool]
prepare_methods = (owner:addr alias:string env:Environment @session:contexts.Session):>Error? => {
    let type_id=views.structural_base(owner session.types)
    let type=types.node_at(session.types type_id)
    if type isnt? types.ObjectType or type.methods.length =? 0 return none
    if type_id in? session.prepared_methods or type_id in? session.preparing_methods return none
    let lifecycle_roles:set<string>=set[]
    loop method in type.methods {
        if method.lifecycle is? none {continue}
        $runtime_assert method.literal <? session.syntax_refs.length
        let reference=session.syntax_refs[method.literal]
        let defining=Environment[contexts.Context[reference.source reference.scope] env.state]
        if not type.minted return problem(reference.node 'lifecycle hooks require a nominal type' 'declare the owner with `type of [...]`' defining session)
        if types.object_field(type method.name) isnt? none return problem(reference.node 'a lifecycle hook cannot implement a callable field' 'lifecycle members are compiler-only, not runtime function values' defining session)
        if method.lifecycle in? lifecycle_roles return problem(reference.node 'duplicate lifecycle hook' method.lifecycle defining session)
        lifecycle_roles.add(method.lifecycle)
        let count:addr=0
        loop other in type.methods {if other.name =? method.name {count+=1}}
        if count not=? 1 return problem(reference.node 'a lifecycle hook cannot be overloaded' method.name defining session)
    }
    if env.return_collector isnt? none {
        $runtime_assert type.methods.length >? 0
        let first=type.methods[0]
        $runtime_assert first.literal <? session.syntax_refs.length
        let reference=session.syntax_refs[first.literal]
        return pending(reference.node 'methods on a type declared inside a function' Environment[contexts.Context[reference.source reference.scope] env.state] session)
    }
    session.preparing_methods.add(type_id)
    let names:set<string>=set['typename']
    let fields:set<string>=set['typename']
    loop field in type.fields {names.add(field.name) fields.add(field.name)}
    loop method in type.methods {names.add(method.name)}
    let plans:array<MethodPlan>=[]
    let instances:set<string>=set[]
    loop method in type.methods {
        $runtime_assert method.literal <? session.syntax_refs.length
        let reference=session.syntax_refs[method.literal]
        let lexical=contexts.Context[reference.source reference.scope]
        let literal=contexts.node_at(reference.node lexical session)
        $runtime_assert literal is? parser.BinOp
        # A minted child's inherited body belongs to its declaring family.
        # Reuse that family's receiver type and hidden binding.
        if method.owner isnt? none and method.owner not=? alias {
            if method.lifecycle isnt? none {
                let inherited=inherit_lifecycle(type_id method reference.node Environment[lexical env.state] @session)
                if inherited is? Error return inherited
                session.methods[method_key(type_id method)]=contexts.MethodEntry[inherited type_id true method.lifecycle]
                instances.add(method.name)
                continue
            }
            let parent=method_owner(method.owner lexical @session)
            if parent is? Error return parent
            if parent isnt? none {
                let error=prepare_methods(parent method.owner env @session)
                if error isnt? none return error
                let inherited=session.methods.get(method_key(views.structural_base(parent session.types) method))
                if inherited isnt? none {
                    session.methods[method_key(type_id method)]=inherited
                    if inherited.receiver_type isnt? none {instances.add(method.name)}
                    continue
                }
            }
        }
        let hidden=source_views.method_parameters(literal lexical session)
        loop name in source_views.method_locals(literal.right lexical session) {hidden.add(name)}
        let visible:set<string>=set[]
        loop name in names {if name not in? hidden {visible.add(name)}}
        let analysis=source_views.method_scan(literal.right visible lexical session)
        loop candidate in type.methods {
            if candidate.lifecycle isnt? none and candidate.name in? analysis.references return problem(reference.node 'a lifecycle hook is compiler-only' candidate.name Environment[lexical env.state] session)
        }
        let instance=method.lifecycle isnt? none
        loop name in analysis.references {if name in? fields {instance=true}}
        if instance {instances.add(method.name)}
        plans.push(MethodPlan[method analysis.references instance analysis.mutates])
    }
    let changed=true
    loop changed {
        changed=false
        loop plan in plans {
            loop name in plan.references {
                if name in? instances and plan.method.name not in? instances {instances.add(plan.method.name) changed=true}
            }
        }
    }
    # Reserve annotated signatures before bodies. Inferred methods become
    # callable only after their body supplies the result, just like functions.
    loop plan in plans {
        let spec=plan.method
        $runtime_assert spec.literal <? session.syntax_refs.length
        let reference=session.syntax_refs[spec.literal]
        let defining=Environment[contexts.Context[reference.source reference.scope] env.state]
        let literal=contexts.node_at(reference.node defining.lexical session)
        $runtime_assert literal is? parser.BinOp
        let instance=spec.name in? instances
        let mutates=plan.mutates
        if instance and mutates and type.immutable return problem(reference.node 'method changes an immutable record' spec.name defining session)
        let shape=function_shape(literal defining @session)
        if shape is? Error return shape
        let signature=dispatch.method_at(session.types shape)
        if spec.lifecycle isnt? none {
            if signature.type_params.length >? 0 return problem(reference.node 'a lifecycle hook cannot have generic parameters' 'the compiler supplies only its borrowed receiver' defining session)
            if signature.pos_or_kw.length >? 0 or signature.kw_only.length >? 0 or signature.rest isnt? none return problem(reference.node 'a lifecycle hook takes no explicit parameters' 'write `()`' defining session)
        }
        if signature.type_params.length >? 0 return pending(reference.node 'generic record methods' defining session)
        let parameters:array<types.PosOrKwArg>=[]
        let place_self=mutates or spec.lifecycle isnt? none
        if instance {parameters.push(types.PosOrKwArg['__dewy_receiver' type_id true place_self])}
        loop parameter in signature.pos_or_kw {parameters.push(parameter)}
        let effects=if instance and signature.inferred_effect is? none effect_rows.prepend_parameter(signature.effects signature.pos_or_kw.length+signature.kw_only.length) else signature.effects
        let full=types.function_type(parameters signature.kw_only signature.rest signature.ret [] @session.types effects=effects inferred_effect=signature.inferred_effect)
        let ordinal:addr=0
        loop earlier in type.methods {
            if earlier.literal =? spec.literal break
            if earlier.name =? spec.name {ordinal += 1}
        }
        let suffix=if ordinal =? 0 '' else "_{ordinal+1}"
        let hidden_name="{alias}__{spec.name}{suffix}" + if spec.lifecycle is? none '' else '$lifecycle'
        let binding_id=bindings.allocate(@session.registry none hidden_name 'function' literal.loc)
        let binding=bindings.binding_at(session.registry binding_id)
        binding.value_type=full binding.store_type=full
        bindings.store_binding(@session.registry binding_id binding)
        session.hidden_bindings.add(binding_id)
        session.methods[method_key(type_id spec)]=contexts.MethodEntry[binding_id if instance type_id else none place_self spec.lifecycle]
    }
    # Prefer callees before callers so inferred methods have concrete results.
    # Cycles with complete signatures are already reserved above; an inferred
    # cycle remains an ordinary unresolved-result error.
    let remaining=plans
    loop remaining.length >? 0 {
        let selected:addr=0
        loop i in 0.. and i <? remaining.length {
            let ready=true
            loop other in remaining {
                if other.method.literal not=? remaining[i].method.literal and other.method.name in? remaining[i].references {ready=false}
            }
            if ready {selected=i break}
        }
        $runtime_assert selected <? remaining.length
        let plan=remaining[selected]
        let next:array<MethodPlan>=[]
        loop i in 0.. and i <? remaining.length {if i not=? selected {next.push(remaining[i])}}
        remaining=next
        let entry=session.methods.get(method_key(type_id plan.method))
        $runtime_assert entry isnt? none and plan.method.literal <? session.syntax_refs.length
        let reference=session.syntax_refs[plan.method.literal]
        let defining=Environment[contexts.Context[reference.source reference.scope] env.state]
        let literal=contexts.node_at(reference.node defining.lexical session)
        $runtime_assert literal is? parser.BinOp
        let binding=bindings.binding_at(session.registry entry.binding)
        let slot=types.object_field(type plan.method.name)
        let expected:addr?=none
        if entry.receiver_type is? none and slot isnt? none and types.node_at(session.types slot.value_type) is? types.FunctionType {expected=slot.value_type}
        let checked=function_literal(reference.node literal defining @session name=binding.name method=entry owner=type_id expected_signature=expected)
        if checked is? Error return checked
        if plan.method.lifecycle isnt? none {
            let signature=dispatch.method_at(session.types node_at(checked session).value_type)
            let actual=views.structural_base(signature.ret session.types)
            let required=if plan.method.lifecycle =? 'drop' types.primitive('void' @session.types) else type_id
            if actual not=? required return problem(reference.node 'invalid lifecycle hook result' if plan.method.lifecycle =? 'drop' 'drop must return void' else 'copy and move must return the same nominal type' defining session)
        }
        if expected isnt? none and not subtyping.is_subtype(node_at(checked session).value_type expected session.links @session.types) return problem(reference.node 'method does not fit its slot' plan.method.name defining session)
        binding.value_type=node_at(checked session).value_type binding.store_type=binding.value_type binding.function=checked
        let declared=put(hir.Declare[literal.loc types.primitive('void' @session.types) 'const' binding.name none checked binding.id] @session)
        binding.declaration=declared
        bindings.store_binding(@session.registry binding.id binding)
        session.hoisted.push(declared)
    }
    session.prepared_methods.add(type_id)
    if type_id in? session.preparing_methods {session.preparing_methods.pop(type_id);}
    return none
}
method_value = (entry:contexts.MethodEntry receiver:addr? loc:Span @session:contexts.Session):>addr => {
    let binding=bindings.binding_at(session.registry entry.binding)
    $runtime_assert binding.value_type isnt? none
    let signature=dispatch.method_at(session.types binding.value_type)
    let parameters:array<types.PosOrKwArg>=[]
    let index:addr=0
    loop slot in signature.pos_or_kw {
        if index >? 0 or entry.receiver_type is? none {parameters.push(slot)}
        index += 1
    }
    let effects=if entry.receiver_type is? none signature.effects else effect_rows.bind_receiver(signature.effects signature.pos_or_kw.length+signature.kw_only.length)
    let exposed=types.function_type(parameters signature.kw_only signature.rest signature.ret signature.type_params @session.types effects=effects)
    let function=put(hir.ExpressedIdentifier[loc binding.value_type binding.name binding.id] @session)
    return put(hir.BoundMethod[loc exposed function if entry.receiver_type is? none none else receiver] @session)
}
method_member = (owner:addr receiver:addr? name:string id:addr env:Environment @session:contexts.Session):>addr|none|Error => {
    let type_id=views.structural_base(owner session.types)
    let type=types.node_at(session.types type_id)
    if type isnt? types.ObjectType return none
    let method=types.object_method(type name)
    if method is? none return none
    if method.lifecycle isnt? none return problem(id 'a lifecycle hook is compiler-only' name env session)
    let alias=if type.brand is? none display.type_to_dewy(type_id session.types) else type.brand
    let error=prepare_methods(type_id alias env @session)
    if error isnt? none return error
    let entry=session.methods.get(method_key(type_id method))
    $runtime_assert entry isnt? none
    if entry.receiver_type isnt? none and receiver is? none return problem(id 'instance method needs a receiver' name env session)
    let binding=bindings.binding_at(session.registry entry.binding)
    $runtime_assert binding.value_type isnt? none
    let signature=dispatch.method_at(session.types binding.value_type)
    if types.is_primitive(types.node_at(session.types signature.ret) 'untyped') return problem(id 'cannot infer a recursive method result' 'add a result annotation' env session)
    return method_value(entry receiver contexts.node_at(id env.lexical session).loc @session)
}
bind_method_members = (owner:addr receiver:addr? lexical:contexts.Context env:Environment @session:contexts.Session):>Error? => {
    let type=types.node_at(session.types owner)
    $runtime_assert type is? types.ObjectType
    let loc=contexts.node_at(0 lexical session).loc
    if receiver isnt? none {
        let name_value=type_names.instance(receiver loc @session)
        bind_member_proxy('typename' name_value lexical @session);
        loop field in type.fields {
            let value=put(hir.MemberAccess[loc field.value_type receiver field.name field.mutable and not type.immutable] @session)
            bind_member_proxy(field.name value lexical @session);
        }
    }
    loop method in type.methods {
        if method.lifecycle isnt? none continue
        let entry=session.methods.get(method_key(owner method))
        if entry is? none continue
        if entry.receiver_type isnt? none and receiver is? none continue
        if receiver isnt? none and types.object_field(type method.name) isnt? none continue
        let binding=bindings.binding_at(session.registry entry.binding)
        $runtime_assert binding.value_type isnt? none
        let signature=dispatch.method_at(session.types binding.value_type)
        if types.is_primitive(types.node_at(session.types signature.ret) 'untyped') continue
        let value=method_value(entry receiver loc @session)
        bind_member_proxy(method.name value lexical @session);
    }
    return none
}
bind_member_proxy = (name:string value:addr lexical:contexts.Context @session:contexts.Session):>void => {
    let node=node_at(value session)
    let id=bindings.allocate(@session.registry none name 'value' node.loc)
    let binding=bindings.binding_at(session.registry id)
    binding.value_type=node.value_type binding.store_type=node.value_type binding.replacement=value
    bindings.store_binding(@session.registry id binding)
    bindings.bind(@session.scopes lexical.scope name id)
}


# Types as runtime values: a `type<Family>` value is a type minted under
# `Family`, carried as its brand id (the hosted MetaType). Such a value is
# stored, compared, matched, dispatched on and constructed through.
brand_value = (node:hir.TypeValue target:types.MetaType expected:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    if node.value isnt? addr return problem(id 'type value outside its family' 'a generic alias is not a runtime type value' env session)
    let minted_id=types.unfold(node.value session.types)
    let minted=types.node_at(session.types minted_id)
    if minted isnt? types.ObjectType or not minted.minted or minted.brand is? none return problem(id 'type mismatch' "`{display.type_to_dewy(node.value session.types)}` does not fit `{display.type_to_dewy(expected session.types)}`" env session)
    let family=types.node_at(session.types target.family)
    $runtime_assert family is? types.ObjectType
    if minted_id not=? target.family and not subtyping.brand_descends(minted family session.types) return problem(id 'type value outside its family' "`{minted.brand}` is not minted under `{display.type_to_dewy(target.family session.types)}`" env session)
    return put(hir.BrandValue[node.loc types.meta_type(minted_id @session.types) minted.brand] @session)
}
metatype_of = (id:addr session:contexts.Session):>types.MetaType? => {
    let node=types.node_at(session.types types.unfold(types.strip_refinement(id session.types) session.types))
    return if node is? types.MetaType node else none
}
# `typeof(value)`: the minted type a value carries, as a `type<Family>` value
# read from its brand word when the static type has types under it, else
# that type itself as a compile-time type value.
type_of = (arguments_id:addr? id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let items=source_arguments(arguments_id env session)
    if items.length not=? 1 return problem(id '`typeof` takes one value' 'the value whose type is wanted' env session)
    let value=expression(items[0] env @session)
    if value is? Error return value
    let node=node_at(value session)
    let source=types.node_at(session.types node.value_type)
    if types.is_primitive(source 'void') or types.is_primitive(source 'never') return problem(id '`typeof` operand needs a value' 'this expression does not produce one' env session)
    if metatype_of(node.value_type session) isnt? none return value
    let plain=views.structural_base(node.value_type session.types)
    let shape=types.node_at(session.types plain)
    let loc=contexts.node_at(id env.lexical session).loc
    if shape isnt? types.ObjectType or not shape.minted or shape.brand is? none return put(hir.TypeValue[loc types.primitive('type' @session.types) plain] @session)
    return put(hir.TypeOf[loc types.meta_type(plain @session.types) value] @session)
}
is_typeof_call = (callee:addr env:Environment session:contexts.Session):>bool =>
    source_views.identifier(callee env.lexical session) =? 'typeof' and declarations.lookup('typeof' env.lexical session) is? none
# `kind is? Whitespace` on a `type<Token>` value: whether the type it names
# is `Whitespace` or minted under it, a brand range test on the value itself;
# decided when the static family already settles it.
metatype_test = (value:addr metatype:types.MetaType tested:addr negated:bool loc:Span @session:contexts.Session):>addr => {
    let boolean=types.primitive('bool' @session.types)
    let tested_id=types.unfold(tested session.types)
    let target=types.node_at(session.types tested_id)
    let family=types.node_at(session.types metatype.family)
    $runtime_assert family is? types.ObjectType
    if target isnt? types.ObjectType or not target.minted or target.brand is? none return put(hir.DecidedBool[loc boolean negated] @session)
    if tested_id =? metatype.family or subtyping.brand_descends(family target session.types) return put(hir.DecidedBool[loc boolean not negated] @session)
    if not subtyping.brand_descends(target family session.types) return put(hir.DecidedBool[loc boolean negated] @session)
    return put(hir.TypeTest[loc boolean value tested_id negated] @session)
}
# `kind =? Whitespace`: type values compare by brand id; any type of the
# family compares, so both sides are read as values of the root family.
metatype_equality = (function:addr positional:array<addr> negated:bool id:addr env:Environment @session:contexts.Session):>addr|none|Error => {
    let family:addr?=none
    loop argument in positional {
        let meta=metatype_of(node_at(argument session).value_type session)
        if meta isnt? none {family=meta.family break}
    }
    if family is? none return none
    let shape=types.node_at(session.types family)
    $runtime_assert shape is? types.ObjectType and shape.brand isnt? none
    let root_name=brands.root(shape.brand session.brands)
    let root=brands.lookup(root_name session.brands)
    $runtime_assert root isnt? none
    let root_type=types.meta_type(root.value_type @session.types)
    let word=types.primitive('int64' @session.types)
    let words:array<addr>=[]
    loop argument in positional {
        let converted=against(argument root_type id env @session)
        if converted is? Error return converted
        words.push(put(hir.Transmute[node_at(converted session).loc word converted] @session))
    }
    return call(function words [] id env @session)
}
# A member of a `type<Family>` value: `typename`, or a static method (or a
# function-typed slot) dispatched by the brand through a hidden function.
metatype_member = (receiver:addr metatype:types.MetaType name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let loc=contexts.node_at(id env.lexical session).loc
    if name =? 'typename' return type_names.instance(receiver loc @session)
    let family=types.node_at(session.types metatype.family)
    $runtime_assert family is? types.ObjectType and family.brand isnt? none
    let signature=family_signature(metatype.family name env @session)
    if signature is? Error return signature
    if signature is? none return problem(id "a type value has no member `{name}`" "`{display.type_to_dewy(types.meta_type(metatype.family @session.types) session.types)}` names a type, not a value of it; `typename` gives its name; a static method or a function-typed slot declared on the family dispatches" env session)
    let dispatcher=brand_dispatcher(metatype.family name signature id env @session)
    if dispatcher is? Error return dispatcher
    return method_value(contexts.MethodEntry[dispatcher metatype.family] receiver loc @session)
}
# `kind(src=... idx=...)`: construct whichever type under the family `kind`
# names, through the family's hidden constructor.
metatype_construct = (kind:addr arguments_id:addr? id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let node=node_at(kind session)
    let metatype=metatype_of(node.value_type session)
    $runtime_assert metatype isnt? none
    let constructor=brand_constructor(metatype.family id env @session)
    if constructor is? Error return constructor
    let bound=method_value(contexts.MethodEntry[constructor metatype.family] kind node.loc @session)
    return call_syntax(bound arguments_id id env @session expected=expected)
}
# The signature a family declares for `name`: a static method's, or a
# function-typed slot's.
family_signature = (family_id:addr name:string env:Environment @session:contexts.Session):>addr|none|Error => {
    let static=static_method(family_id name env @session)
    if static is? Error return static
    if static isnt? none {
        let binding=bindings.binding_at(session.registry static)
        if binding.value_type isnt? none and types.node_at(session.types binding.value_type) is? types.FunctionType return binding.value_type
    }
    let family=types.node_at(session.types family_id)
    $runtime_assert family is? types.ObjectType
    let slot=types.object_field(family name)
    if slot isnt? none and types.node_at(session.types slot.value_type) is? types.FunctionType return slot.value_type
    return none
}
# The hidden function of a static method of the type, else none.
static_method = (type_id:addr name:string env:Environment @session:contexts.Session):>addr|none|Error => {
    let type=types.node_at(session.types type_id)
    if type isnt? types.ObjectType return none
    let method=types.object_method(type name)
    if method is? none return none
    let alias=if type.brand is? none display.type_to_dewy(type_id session.types) else type.brand
    let error=prepare_methods(type_id alias env @session)
    if error isnt? none return error
    let entry=session.methods.get(method_key(type_id method))
    if entry is? none or entry.receiver_type isnt? none return none
    return entry.binding
}
slot_filled = (type:types.ObjectType name:string session:contexts.Session):>bool => {
    let slot=types.object_field(type name)
    return slot isnt? none and types.node_at(session.types slot.value_type) is? types.FunctionType and slot.default isnt? none
}
concrete_brands_under = (name:string session:contexts.Session):>array<string> => {
    let found:array<string>=[]
    loop brand in brands.descendants(name session.brands) {if brands.concrete(brand session.brands) {found.push(brand)}}
    # Sorted by name: the arm order is the hosted dispatcher's.
    loop i in 1.. and i <? found.length {
        let item=found[i]
        let j=i
        loop j >? 0 and string_before(item found[j-1]) {found[j]=found[j-1] j-=1}
        found[j]=item
    }
    return found
}
brand_type = (name:string session:contexts.Session):>addr => {
    let entry=brands.lookup(name session.brands)
    $runtime_assert entry isnt? none
    return entry.value_type
}
# The synthesized text names types through hidden aliases bound in the
# helper's scope (`__dewy_family`, `__dewy_brand_0`, `__dewy_t0`, ...),
# as a generic instance binds its type parameters: a brand's spelling may
# carry a disambiguating suffix, and a parameter type need not be nameable
# where the helper is checked.
HiddenAlias:type = const [name:string value:addr]
# A lifecycle helper borrows the complete child once. The parent operation
# supplies its portion; ordinary construction checks the resulting child's
# field contracts instead of assuming the source's facts survived the hook.
inherit_lifecycle = (owner:addr method:types.MethodSpec id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let child=types.node_at(session.types owner)
    $runtime_assert child is? types.ObjectType and child.parent isnt? none and child.brand isnt? none
    let registered=brands.lookup(child.brand session.brands)
    if registered is? none or registered.value_type not=? owner return pending(id 'lifecycle hooks on structurally extended nominal types' env session)
    let parent_id=views.structural_base(child.parent session.types)
    let parent=types.node_at(session.types parent_id)
    if parent isnt? types.ObjectType or parent.brand is? none return pending(id 'lifecycle hooks on structurally extended nominal types' env session)
    let error=prepare_methods(parent_id parent.brand env @session)
    if error isnt? none return error
    let hook:types.MethodSpec?=none
    loop candidate in parent.methods {if candidate.lifecycle =? method.lifecycle {hook=candidate}}
    $runtime_assert hook isnt? none
    let entry=session.methods.get(method_key(parent_id hook))
    $runtime_assert entry isnt? none
    let text:string='(@__dewy_value:__dewy_lifecycle_child):>void => __dewy_lifecycle_parent(@__dewy_value)'
    if method.lifecycle not=? 'drop' {
        let fields:array<string>=[]
        loop field in parent.fields {fields.push("{field.name}=__dewy_parent_value.{field.name}")}
        loop field in child.fields {
            if types.object_field(parent field.name) isnt? none {continue}
            let value="__dewy_value.{field.name}"
            let field_type=types.node_at(session.types views.structural_base(field.value_type session.types))
            let aggregate=field_type is? types.ObjectType|types.ArrayType|types.TypeOr or views.string_valued(field.value_type session.types)
            if method.lifecycle =? 'copy' and aggregate and builtin_copy_available(field.value_type session.types) {value+='.copy()'}
            fields.push("{field.name}={value}")
        }
        text="(@__dewy_value:__dewy_lifecycle_child):>__dewy_lifecycle_child => \{\nlet __dewy_parent_value=__dewy_lifecycle_parent(@__dewy_value)\nreturn __dewy_lifecycle_child[{fields.join(' ')}]\n}"
    }
    return hoist_hidden_function("{child.brand}__{method.name}$lifecycle" text [HiddenAlias['__dewy_lifecycle_child' owner]] id env @session values=[hir.FieldBinding[entry.binding '__dewy_lifecycle_parent']] lifecycle=method.lifecycle lifecycle_composition=true)
}
# Code point order, as the hosted `sorted` on brand names (UTF-8 bytes order
# as code points do).
string_before = (a:string b:string):>bool => {
    let left=a as array<uint8>
    let right=b as array<uint8>
    loop i in 0.. and i <? left.length and i <? right.length {
        if left[i] not=? right[i] return left[i] <? right[i]
    }
    return left.length <? right.length
}
# The hidden function `Family__dispatch__name(kind args...)` calling the
# static method `name` of whichever type under the family `kind` names,
# synthesized as Dewy like the hosted checker: a `match` over the family's
# concrete types, each arm a static call.
brand_dispatcher = (family_id:addr name:string signature_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let family=types.node_at(session.types family_id)
    $runtime_assert family is? types.ObjectType and family.brand isnt? none
    let key="dispatch:{family.brand}:{name}"
    let existing=session.methods.get(key)
    if existing isnt? none return existing.binding
    let signature=types.node_at(session.types signature_id)
    $runtime_assert signature is? types.FunctionType
    if signature.kw_only.length >? 0 or signature.rest isnt? none or signature.type_params.length >? 0 return pending(id 'dispatching a keyword-only, rest, or generic signature through a type value' env session)
    let members=concrete_brands_under(family.brand session)
    loop brand in members {
        let child_id=brand_type(brand session)
        let child=types.node_at(session.types child_id)
        $runtime_assert child is? types.ObjectType
        let static=static_method(child_id name env @session)
        if static is? Error return static
        if static is? none and not slot_filled(child name session) return problem(id "`{brand}` has no static `{name}`" "every type under `{family.brand}` needs one to dispatch `{name}` through a type value" env session)
    }
    let aliases:array<HiddenAlias>=[HiddenAlias['__dewy_family' family_id]]
    let params:array<string>=[]
    let args:array<string>=[]
    loop i in 0.. and i <? signature.pos_or_kw.length {
        let slot=signature.pos_or_kw[i]
        let parameter=if slot.name is? none "__dewy_p{i}" else slot.name
        let prefix=if slot.place '@' else ''
        aliases.push(HiddenAlias["__dewy_t{i}" slot.value_type])
        params.push("{prefix}{parameter}:__dewy_t{i}")
        args.push("{prefix}{parameter}")
    }
    let ret=types.node_at(session.types signature.ret)
    let result:string=''
    if not (types.is_primitive(ret 'void') or types.is_primitive(ret 'untyped')) {
        aliases.push(HiddenAlias['__dewy_ret' signature.ret])
        result=':>__dewy_ret'
    }
    let arms:array<string>=[]
    loop i in 0.. and i <? members.length {
        aliases.push(HiddenAlias["__dewy_brand_{i}" brand_type(members[i] session)])
        arms.push("    <__dewy_brand_{i}> => return __dewy_brand_{i}.{name}({args.join(' ')})")
    }
    let text="(__dewy_kind:type<__dewy_family> {params.join(' ')}){result} => \{ match __dewy_kind \{\n{arms.join('\n')}\n} }\n"
    let hidden=hoist_hidden_function("{family.brand}__dispatch__{name}" text aliases id env @session)
    if hidden is? Error return hidden
    session.methods[key]=contexts.MethodEntry[hidden family_id]
    return hidden
}
# The hidden function `Family__construct(kind fields...)` constructing
# whichever type under the family `kind` names, with the family's own
# required fields (a function-typed slot is the child's; a child's extra
# fields default).
brand_constructor = (family_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let family=types.node_at(session.types family_id)
    $runtime_assert family is? types.ObjectType and family.brand isnt? none
    let key="construct:{family.brand}"
    let existing=session.methods.get(key)
    if existing isnt? none return existing.binding
    let given:array<types.ObjectField>=[]
    loop field in family.fields {
        if field.default is? none and types.node_at(session.types field.value_type) isnt? types.FunctionType {given.push(field)}
    }
    let members=concrete_brands_under(family.brand session)
    loop brand in members {
        let child=types.node_at(session.types brand_type(brand session))
        $runtime_assert child is? types.ObjectType
        loop field in child.fields {
            if field.default isnt? none continue
            let is_slot=types.node_at(session.types field.value_type) is? types.FunctionType
            if is_slot {
                if not implemented_slot(child field session) return problem(id "`{brand}` leaves the slot `{field.name}` unfilled" "every type constructed through a `type<{family.brand}>` value fills its function-typed slots with a method" env session)
                continue
            }
            if types.object_field(family field.name) is? none return problem(id "`{brand}` cannot be constructed through a `type<{family.brand}>` value" "its field `{field.name}` has no default, and only `{family.brand}`'s fields are given here" env session)
        }
    }
    let aliases:array<HiddenAlias>=[HiddenAlias['__dewy_family' family_id]]
    let params:array<string>=[]
    let args:array<string>=[]
    loop i in 0.. and i <? given.length {
        let field=given[i]
        let declared=if field.refinement.length >? 0 types.refined_type(field.value_type field.refinement @session.types) else field.value_type
        aliases.push(HiddenAlias["__dewy_t{i}" declared])
        params.push("{field.name}:__dewy_t{i}")
        args.push("{field.name}={field.name}")
    }
    let arms:array<string>=[]
    loop i in 0.. and i <? members.length {
        aliases.push(HiddenAlias["__dewy_brand_{i}" brand_type(members[i] session)])
        arms.push("    <__dewy_brand_{i}> => return __dewy_brand_{i}({args.join(' ')})")
    }
    let text="(__dewy_kind:type<__dewy_family> {params.join(' ')}):>__dewy_family => \{ match __dewy_kind \{\n{arms.join('\n')}\n} }\n"
    let hidden=hoist_hidden_function("{family.brand}__construct" text aliases id env @session)
    if hidden is? Error return hidden
    session.methods[key]=contexts.MethodEntry[hidden family_id]
    return hidden
}
# The module scope of the current context (under the prelude and builtins):
# synthesized helpers are checked there, as the hosted checker checks them
# in the module context, and become module-level hidden functions.
module_scope = (scope:addr session:contexts.Session):>addr => {
    let current=scope
    loop true {
        let frame=bindings.scope_at(session.scopes current)
        if frame.parent is? none return current
        let parent=bindings.scope_at(session.scopes frame.parent)
        if parent.parent is? none or bindings.scope_at(session.scopes parent.parent).parent is? none return current
        current=frame.parent
    }
}
# Typecheck a synthesized function literal as a module-level hidden
# function, like a generic instance or a type's method.
hoist_hidden_function = (name:string text:string aliases:array<HiddenAlias> id:addr env:Environment @session:contexts.Session values:array<hir.FieldBinding>=[] lifecycle:string?=none lifecycle_composition:bool=false):>addr|Error => {
    let srcfile=SrcFile["<{name}>" text]
    let parsed=parser.parse(srcfile)
    if parsed is? Error return parsed
    let source=contexts.add_source(srcfile parsed.nodes @session)
    let lexical=contexts.child(contexts.Context[source module_scope(env.lexical.scope session)] @session)
    loop alias in aliases {
        # The generated text passes through t1, so bind its canonical name
        # too. In particular `_0` and `₀` must identify the same alias.
        let canonical=tokens.normalize_identifier(alias.name)
        let alias_id=bindings.allocate_param(@session.registry canonical types.primitive('type' @session.types) contexts.node_at(id env.lexical session).loc)
        let alias_binding=bindings.binding_at(session.registry alias_id)
        alias_binding.type_value=alias.value
        bindings.store_binding(@session.registry alias_id alias_binding)
        bindings.bind(@session.scopes lexical.scope canonical alias_id)
    }
    loop value in values {bindings.bind(@session.scopes lexical.scope tokens.normalize_identifier(value.name) value.id)}
    let root=contexts.node_at(parsed.root lexical session)
    $runtime_assert root is? parser.Block and root.inner.length =? 1
    let literal_id=root.inner[0]
    let literal=contexts.node_at(literal_id lexical session)
    $runtime_assert literal is? parser.BinOp
    let binding_id=bindings.allocate(@session.registry none name 'function' literal.loc)
    let defining=Environment[lexical env.state]
    let value=function_literal(literal_id literal defining @session name=name)
    if value is? Error return value
    let checked=node_at(value session)
    $runtime_assert checked is? hir.FunctionLiteral and value <? session.hir.length
    checked.lifecycle=lifecycle
    checked.lifecycle_composition=lifecycle_composition
    session.hir[value]=checked
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=checked.value_type binding.store_type=checked.value_type binding.function=value
    let declared=put(hir.Declare[literal.loc types.primitive('void' @session.types) 'let' name none value binding_id] @session)
    binding.declaration=declared
    bindings.store_binding(@session.registry binding_id binding)
    session.hidden_bindings.add(binding_id)
    session.hoisted.push(declared)
    return binding_id
}

# An explicit conversion is a value operation, distinct from an annotation's
# store contract. In particular `7 as int64` may retain its singleton type;
# a word-width conversion emits a cast whose range the analysis must prove.
explicit_conversion = (value:addr target:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node=node_at(value session)
    let source=types.node_at(session.types node.value_type)
    if types.is_primitive(source 'void') or types.is_primitive(source 'never') return problem(id 'conversion needs a value' 'this expression does not produce one' env session)
    if views.string_valued(target session.types) {
        let spelled=spelling_string(value @session)
        if spelled isnt? none return spelled
    }
    target=text_shapes.materialization_target(node.value_type target @session.types)
    let destination=types.node_at(session.types target)
    if types.same_type(node.value_type target session.types) return value
    if source is? types.BinaryLiteralType {
        let payload=views.optional_payload(target @session.types)
        if payload isnt? none and views.string_valued(payload session.types) return put(hir.RepresentationCast[node.loc target binary_array(value @session)] @session)
        if subtyping.is_subtype(node.value_type target session.links @session.types) return put(hir.RepresentationCast[node.loc target value] @session)
        if views.string_valued(target session.types) return problem(id 'binary data is not Unicode text' 'decode bytes explicitly with `as string | none`' env session)
    }
    if source is? types.StringLiteralType and subtyping.is_subtype(node.value_type target session.links @session.types) return put(hir.RepresentationCast[node.loc target value] @session)
    if views.string_valued(node.value_type session.types) and destination is? types.ArrayType {
        let element=types.node_at(session.types destination.element)
        if element is? types.Primitive and element.name in? ['uint8' 'uint32' 'char' 'grapheme'] return put(hir.RepresentationCast[node.loc target value] @session)
    }
    if source is? types.ArrayType {
        let element=types.node_at(session.types source.element)
        let payload=views.optional_payload(target @session.types)
        if types.is_primitive(element 'uint8') and payload isnt? none and views.string_valued(payload session.types) return put(hir.RepresentationCast[node.loc target value] @session)
        if views.string_valued(target session.types) {
            if element is? types.Primitive and element.name in? ['uint8' 'uint32'] return problem(id 'string conversion requires a validity proof' 'decode bytes with `as string | none`; unvalidated scalars do not prove Unicode text' env session)
            if types.is_primitive(destination 'string') and (element is? types.Primitive and element.name in? ['char' 'grapheme'] or element is? types.StringType and element.length =? 1) return put(hir.RepresentationCast[node.loc target value] @session)
        }
    }
    # Explicit integer-to-bigint conversion uses the same literal limbs and
    # word helpers as an annotated store. In particular a positive literal
    # need not fit int64 before it can become a bigint (e.g. 2**63).
    if numeric_values.is_family(target 'BigInt' env.lexical session) and views.integer_valued(node.value_type session.types) return against(value target id env @session)
    if numeric_values.is_family(node.value_type 'BigInt' env.lexical session) and views.fixed_integer_layout(types.strip_refinement(target session.types) session.types) isnt? none return against(value target id env @session)
    if subtyping.is_subtype(node.value_type target session.links @session.types) return value
    if subtyping.is_subtype(node.value_type types.primitive('int' @session.types) session.links @session.types) and views.fixed_integer_layout(target session.types) isnt? none return put(hir.ValueCast[node.loc target value] @session)
    # An object can carry a descendant's brand, conversion method and fields.
    # Dispatch before choosing the base type's conversion protocol.
    if views.string_valued(target session.types) and types.node_at(session.types views.structural_base(node.value_type session.types)) is? types.ObjectType|types.MetaType return text_part(value id env @session)
    let converted=conversion_method(value target id env @session)
    if converted is? Error return converted
    if converted isnt? none return converted
    let owner=types.node_at(session.types views.structural_base(node.value_type session.types))
    if views.string_valued(target session.types) and owner is? types.ObjectType|types.ArrayType|types.TypeOr {
        let part=text_part(value id env @session)
        if part is? Error return part
        return if views.string_valued(node_at(part session).value_type session.types) part else put(hir.InterpolatedString[node.loc target [part]] @session)
    }
    return problem(id 'unsupported value conversion' "cannot convert `{display.type_to_dewy(node.value_type session.types)}` to `{display.type_to_dewy(target session.types)}`" env session)
}

# Conversion overloads select by result type. Each declaration has its own
# hidden signature, including whether that body requires a mutable receiver.
# The existing protocol takes no source arguments, even optional ones.
conversion_method = (value:addr target:addr id:addr env:Environment @session:contexts.Session):>addr|none|Error => {
    let node=node_at(value session)
    # Numeric representations use their registered prelude role just as
    # arithmetic does. One formatter accepts both the zero and record arms,
    # preserving ordinary call evaluation for explicit casts/interpolation.
    if views.string_valued(target session.types) and numeric_values.is_family(node.value_type 'BigInt' env.lexical session) return library_call('_bigint_as_string' [value] id env @session)
    let owner=views.structural_base(node.value_type session.types)
    let type=types.node_at(session.types owner)
    if type isnt? types.ObjectType or types.object_method(type '__as__') is? none return none
    let alias=if type.brand is? none display.type_to_dewy(owner session.types) else type.brand
    let error=prepare_methods(owner alias env @session)
    if error isnt? none return error
    loop method in type.methods {
        if method.name not=? '__as__' continue
        let entry=session.methods.get(method_key(owner method))
        $runtime_assert entry isnt? none
        let binding=bindings.binding_at(session.registry entry.binding)
        $runtime_assert binding.value_type isnt? none
        let signature=dispatch.method_at(session.types binding.value_type)
        let count=if entry.receiver_type is? none 0 else 1
        if signature.pos_or_kw.length not=? count or signature.kw_only.length >? 0 or signature.rest isnt? none return problem(id '`__as__` takes no arguments' 'a conversion target is its result type; declare `__as__ = ():>T => ...`' env session)
        if not subtyping.is_subtype(signature.ret target session.links @session.types) and not (views.string_valued(signature.ret session.types) and views.string_valued(target session.types)) continue
        let bound=method_value(entry value node.loc @session)
        return call(bound [] [] id env @session)
    }
    return none
}
spelling_string = (value:addr @session:contexts.Session):>addr? => {
    let node=node_at(value session)
    let text:string?=none
    if node is? hir.TypeValue {
        if node.value is? addr {text=display.type_to_dewy(node.value session.types)}
        else {text=node.name}
    } else if types.node_at(session.types node.value_type) is? types.CallableType {text=display.type_to_dewy(node.value_type session.types)}
    if text is? none return none
    return put(hir.String[node.loc types.string_literal(text @session.types) text] @session)
}
# Formatting uses ordinary typed control flow. A union-valued field is
# evaluated once into a hidden local, then each arm reads its narrowed member.
# Keeping the declaration inside the expression preserves left-to-right
# interpolation effects, including calls and fields of temporary records.
text_part = (value:addr id:addr env:Environment @session:contexts.Session dispatch_brands:bool=true):>addr|Error => {
    let node=node_at(value session)
    let string=types.primitive('string' @session.types)
    let spelled=spelling_string(value @session)
    if spelled isnt? none return spelled
    let type=types.node_at(session.types views.structural_base(node.value_type session.types))
    if types.is_primitive(type 'none') return put(hir.String[node.loc types.string_literal('none' @session.types) 'none'] @session)
    if types.is_primitive(type 'void') or types.is_primitive(type 'never') return problem(id 'string interpolation needs a value' 'this expression does not produce one' env session)
    if type is? types.MetaType return type_names.instance(value node.loc @session)   # a type value: its name
    if dispatch_brands and type is? types.ObjectType {
        let choices=type_names.alternatives(node.value_type session)
        if choices.length >? 0 return branded_text(value choices id env @session)
    }
    let converted=conversion_method(value string id env @session)
    if converted is? Error return converted
    if converted isnt? none return converted
    if views.string_valued(node.value_type session.types) return value
    let members=views.runtime_union_members(node.value_type @session.types)
    let payload=views.optional_payload(node.value_type @session.types)
    if payload isnt? none {members=[types.primitive('none' @session.types) payload]}
    if members isnt? none {
        let name="__dewy_text_{session.registry.next_id}"
        let binding_id=bindings.allocate(@session.registry none name 'value' node.loc)
        let binding=bindings.binding_at(session.registry binding_id)
        binding.value_type=node.value_type binding.store_type=node.value_type
        let declaration=put(hir.Declare[node.loc types.primitive('void' @session.types) 'let' name node.value_type value binding_id] @session)
        binding.declaration=declaration
        bindings.store_binding(@session.registry binding_id binding)
        let reference=put(hir.ExpressedIdentifier[node.loc node.value_type name binding_id] @session)
        let arms:array<addr>=[]
        let otherwise:addr?=none
        loop i in 0.. and i <? members.length {
            let member=members[i]
            let narrowed=put(hir.ExpressedIdentifier[node.loc member name binding_id] @session)
            let part=text_part(narrowed id env @session)
            if part is? Error return part
            let body=if views.string_valued(node_at(part session).value_type session.types) part else put(hir.InterpolatedString[node.loc string [part]] @session)
            if i+1 =? members.length {otherwise=body}
            else {
                let condition=put(hir.TypeTest[node.loc types.primitive('bool' @session.types) reference member false] @session)
                arms.push(put(hir.IfArm[node.loc string condition body] @session))
            }
        }
        let flow=put(hir.Flow[node.loc string arms otherwise] @session)
        return put(hir.Block[node.loc string [declaration flow] false] @session)
    }
    let structure=text_formatting.structure(node.value_type session.types)
    if structure isnt? none {
        let arguments:array<addr>=[value]
        loop member in structure.members {
            # Preserve the hosted container-iteration boundary. A formatter
            # must not accept nested containers that its generic loop cannot
            # visit, nor expose a dict's implementation as an ordinary record.
            if text_formatting.structure(member session.types) isnt? none return problem(id 'no string conversion for this value' 'container members cannot themselves be containers yet' env session)
            let quote=text_formatting.quoted_member(member @session.types)
            arguments.push(put(hir.Bool[node.loc types.primitive('bool' @session.types) quote] @session))
        }
        return library_call(structure.helper arguments id env @session)
    }
    if type is? types.ObjectType {
        loop name in ['Rational' 'BigRational' 'Fixed'] {
            if numeric_values.is_family(node.value_type name env.lexical session) return problem(id 'no string conversion for this value' "`{name}` has no string conversion yet" env session)
        }
        if type.brand is? none or type.minted return object_text(value id env @session)
    }
    if type is? types.ObjectType|types.ArrayType|types.TypeOr return pending(id 'structural string interpolation' env session)
    return value
}

# A value viewed as a parent (or its original structural shape) retains its
# most specific runtime brand. Use the same deepest-first choices as typename;
# each selected arm then uses that type's own conversion and field layout.
branded_text = (value:addr choices:array<type_names.Alternative> id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node=node_at(value session)
    let name="__dewy_branded_text_{session.registry.next_id}"
    let binding_id=bindings.allocate(@session.registry none name 'value' node.loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=node.value_type binding.store_type=node.value_type
    let declaration=put(hir.Declare[node.loc types.primitive('void' @session.types) 'let' name node.value_type value binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    let reference=put(hir.ExpressedIdentifier[node.loc node.value_type name binding_id] @session)
    let arms:array<addr>=[]
    let string=types.primitive('string' @session.types)
    loop choice in choices {
        let narrowed=put(hir.ExpressedIdentifier[node.loc choice.value_type name binding_id] @session)
        let body=text_part(narrowed id env @session dispatch_brands=false)
        if body is? Error return body
        let condition=put(hir.TypeTest[node.loc types.primitive('bool' @session.types) reference choice.value_type false] @session)
        arms.push(put(hir.IfArm[node.loc string condition body] @session))
    }
    let fallback=text_part(reference id env @session dispatch_brands=false)
    if fallback is? Error return fallback
    let flow=put(hir.Flow[node.loc string arms fallback] @session)
    return put(hir.Block[node.loc string [declaration flow] false] @session)
}

# A record printer is an ordinary hidden function, shared by all conversions
# of that record type. Publish its signature before preparing the fields:
# `Node[next:Node|none]` needs to call the same printer from its optional arm.
# The function parameter also evaluates an effectful receiver exactly once.
object_text = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node=node_at(value session)
    let owner=views.structural_base(node.value_type session.types)
    let helper=session.object_strings.get(owner)
    if helper is? none {
        let saved=contexts.checkpoint(session)
        let prepared=object_text_function(owner id env @session)
        if prepared is? Error {
            # A failed speculative conversion must not leave a signature for
            # a helper whose body never finished, including nested helpers.
            contexts.restore(saved @session)
            return prepared
        }
        helper=prepared
    }
    let binding=bindings.binding_at(session.registry helper)
    $runtime_assert binding.value_type isnt? none
    let callee=put(hir.ExpressedIdentifier[node.loc binding.value_type binding.name helper] @session)
    return call(callee [value] [] id env @session)
}
object_text_function = (owner:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let type=types.node_at(session.types owner)
    $runtime_assert type is? types.ObjectType
    let loc=contexts.node_at(id env.lexical session).loc
    let string=types.primitive('string' @session.types)
    let signature=types.function_type([types.PosOrKwArg['__dewy_value' owner]] [] none string [] @session.types)
    let name="__dewy_object_string_{session.registry.next_id}"
    let helper=bindings.allocate(@session.registry none name 'function' loc)
    let binding=bindings.binding_at(session.registry helper)
    binding.value_type=signature binding.store_type=signature
    bindings.store_binding(@session.registry helper binding)
    session.object_strings[owner]=helper
    session.hidden_bindings.add(helper)

    let parameter=bindings.allocate_param(@session.registry '__dewy_value' owner loc)
    let receiver=put(hir.ExpressedIdentifier[loc owner '__dewy_value' parameter] @session)
    let parts:array<addr>=[]
    let brand=if type.minted and type.brand isnt? none type.brand else ''
    loop index in 0.. and index <? type.fields.length {
        let field=type.fields[index]
        let prefix="{if index =? 0 "{brand}[" else ' '}{field.name}="
        parts.push(put(hir.String[loc types.string_literal(prefix @session.types) prefix] @session))
        let member=put(hir.MemberAccess[loc field.value_type receiver field.name field.mutable and not type.immutable] @session)
        let prepared=text_part(member id env @session)
        if prepared is? Error return prepared
        let text=if views.string_valued(node_at(prepared session).value_type session.types) prepared else put(hir.InterpolatedString[loc string [prepared]] @session)
        if text_formatting.quoted_member(field.value_type @session.types) {
            let quoted=library_call('_quoted' [text] id env @session)
            if quoted is? Error return quoted
            text=quoted
        }
        parts.push(text)
    }
    let suffix=if type.fields.length >? 0 ']' else if brand not=? '' brand else '[]'
    parts.push(put(hir.String[loc types.string_literal(suffix @session.types) suffix] @session))
    let formatted=put(hir.InterpolatedString[loc string parts] @session)
    let owned=library_call('_arena_text' [formatted] id env @session)
    if owned is? Error return owned
    let body=put(hir.Return[loc types.primitive('never' @session.types) owned] @session)
    let function=put(hir.FunctionLiteral[loc signature [hir.Param['__dewy_value' owner parameter]] [] none string body source=env.lexical.source] @session)
    let declaration=put(hir.Declare[loc types.primitive('void' @session.types) 'let' name none function helper] @session)
    binding.function=function binding.declaration=declaration
    bindings.store_binding(@session.registry helper binding)
    session.hoisted.push(declaration)
    return helper
}
interpolated_string = (id:addr node:parser.IString env:Environment @session:contexts.Session for_output:bool=false):>addr|Error => {
    let parts:array<addr>=[]
    let string=types.primitive('string' @session.types)
    loop part_id in node.content {
        let part=contexts.node_at(part_id env.lexical session)
        if part is? tokens.StringChunk {
            if part.content not=? '' {parts.push(put(hir.String[part.loc types.string_literal(part.content @session.types) part.content] @session))}
            continue
        }
        if part is? parser.ParametricEscape return pending(part_id 'parametric escape inside an interpolated string' env session)
        if part isnt? parser.Block or part.inner.length not=? 1 return problem(part_id 'string interpolation requires one expression' 'place exactly one expression between these braces' env session)
        let value=expression(part.inner[0] env @session)
        if value is? Error return value
        let prepared:addr|Error=value
        if for_output {
            let type=types.node_at(session.types node_at(value session).value_type)
            if type is? types.RationalLiteralType {prepared=widen(value part_id env @session)}
            else if type is? types.Primitive and type.name in? ['int' 'uint'] {prepared=against(value types.primitive(if type.name =? 'uint' 'uint64' else 'int64' @session.types) part_id env @session)}
        } else {prepared=text_part(value part_id env @session)}
        if prepared is? Error return prepared
        parts.push(prepared)
    }
    return put(hir.InterpolatedString[node.loc string parts] @session)
}


# Constructor overloads join the existing field-wise signature. Their bodies
# are ordinary functions, with the same defining scope, inference, and call
# validation. A dispatch probe owns its speculative arenas and read facts;
# choosing the field-wise form leaves its sequential initializer scope intact.
declare_constructor = (constructor:hir.TypeValue literal_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    if constructor.value isnt? addr return pending(id 'generic type constructor overloads' env session)
    let owner=views.structural_base(constructor.value session.types)
    if types.node_at(session.types owner) isnt? types.ObjectType return problem(id 'constructor overload needs a record type' 'the left side names a record type' env session)
    let literal=contexts.node_at(literal_id env.lexical session)
    if literal isnt? parser.BinOp or not source_views.is_operator(literal.op '=>' env.lexical session) return problem(id 'a constructor overload must be a function literal' 'use `(params):>Type => ...`' env session)
    let overloads=session.constructors.get(owner contexts.ConstructorSet[])
    let alias=if constructor.name is? none display.type_to_dewy(owner session.types) else constructor.name
    let name="{alias}__new_{overloads.bindings.length + 1}"
    let checked=function_literal(literal_id literal env @session name=name)
    if checked is? Error return checked
    let binding_id=bindings.allocate(@session.registry none name 'function' literal.loc)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.value_type=node_at(checked session).value_type binding.store_type=binding.value_type binding.function=checked
    let declaration=put(hir.Declare[literal.loc types.primitive('void' @session.types) 'const' name none checked binding_id] @session)
    binding.declaration=declaration
    bindings.store_binding(@session.registry binding_id binding)
    session.hidden_bindings.add(binding_id)
    session.hoisted.push(declaration)
    overloads.bindings.push(binding_id)
    session.constructors[owner]=overloads
    return void_at(id env @session)
}
constructor_overload = (constructor:hir.TypeValue arguments_id:addr? id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|none|Error => {
    $runtime_assert constructor.value is? addr
    let owner=views.structural_base(constructor.value session.types)
    let type=types.node_at(session.types owner)
    $runtime_assert type is? types.ObjectType
    let overloads=session.constructors.get(owner contexts.ConstructorSet[type.constructors])
    if overloads.bindings.length =? 0 return none
    let trial=session
    let parameters:array<types.PosOrKwArg>=[]
    loop field in type.fields {parameters.push(types.PosOrKwArg[field.name field.value_type field.default is? none and not implemented_slot(type field session)])}
    let fieldwise=types.function_type(parameters [] none owner [] @trial.types)
    let signatures:array<addr>=[fieldwise]
    loop id in overloads.bindings {
        let binding=bindings.binding_at(trial.registry id)
        $runtime_assert binding.value_type isnt? none
        signatures.push(binding.value_type)
    }
    let shape=types.overload_type(signatures @trial.types)
    let callee=put(hir.ExpressedIdentifier[constructor.loc shape '__dewy_constructor_choice' none] @trial)
    let checked=call_syntax(callee arguments_id id env @trial)
    # As in the hosted dispatcher, the ordinary constructor reports failures
    # when no unique user overload wins. Do not leak speculative declarations.
    if checked is? Error return none
    let call_node=node_at(checked trial)
    $runtime_assert call_node is? hir.FunctionCall and call_node.selected_method_index isnt? none
    let selected=call_node.selected_method_index
    if selected =? 0 return none
    let position=selected - 1
    $runtime_assert position >=? 0 and position <? overloads.bindings.length
    let binding=bindings.binding_at(trial.registry overloads.bindings[position])
    $runtime_assert binding.value_type isnt? none
    let function=put(hir.ExpressedIdentifier[constructor.loc binding.value_type binding.name binding.id] @trial)
    let result=call(function call_node.pos_args call_node.kw_args id env @trial expected=expected)
    if result is? Error return result
    session=trial
    return result
}

# A method implementing an inherited function field supplies its constructor
# default. The field remains real storage, so callers may override the value.
implemented_slot = (owner:types.ObjectType field:types.ObjectField session:contexts.Session):>bool =>
    types.node_at(session.types field.value_type) is? types.FunctionType and types.object_method(owner field.name) isnt? none

method_owner = (name:string lexical:contexts.Context @session:contexts.Session):>addr|none|Error => {
    # A minted name may have a disambiguating suffix; it need not be a source
    # spelling in this module. The program registry retains its real identity.
    loop brand in session.brands.entries {if brand.name =? name return brand.value_type}
    let binding=declarations.lookup(name lexical session)
    if binding is? none return none
    let value=declarations.resolve_alias(binding @session)
    if value is? Error return value
    return if value is? addr value else none
}

# Capture only value positions: the last expression of a block, each flow
# arm, and a nested loop's body. A statement or unmatched filter contributes
# no element. In particular a flow's overall `void` type does not erase the
# values expressed by its matching arms.
capture_values = (id:addr session:contexts.Session):>array<addr> => {
    let node=node_at(id session)
    if node is? hir.Block {
        if node.items.length =? 0 return []
        return capture_values(node.items[node.items.length-1] session)
    }
    let values:array<addr>=[]
    if node is? hir.Flow {
        loop arm in node.arms {loop value in capture_values(arm session) {values.push(value)}}
        if node.default isnt? none {loop value in capture_values(node.default session) {values.push(value)}}
        return values
    }
    if node is? hir.IfArm|hir.LoopArm return capture_values(node.body session)
    let type=types.node_at(session.types node.value_type)
    if types.is_primitive(type 'void') or types.is_primitive(type 'never') return []
    return [id]
}
# Rewrite the checked value sites, rather than rechecking their syntax in a
# different scope. This preserves iterator identities and branch narrowing.
capture_pushes = (id:addr receiver:addr element:addr syntax:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node=node_at(id session)
    let void_type=types.primitive('void' @session.types)
    if node is? hir.Block {
        if node.items.length =? 0 return id
        let items=node.items
        $runtime_assert items.length >? 0
        let last=items.length-1
        $runtime_assert last <? items.length
        let value=capture_pushes(items[last] receiver element syntax env @session)
        if value is? Error return value
        items[last]=value
        return put(hir.Block[node.loc void_type items node.scoped] @session)
    }
    if node is? hir.Flow {
        let arms:array<addr>=[]
        loop arm in node.arms {
            let value=capture_pushes(arm receiver element syntax env @session)
            if value is? Error return value
            arms.push(value)
        }
        let default:addr?=none
        if node.default isnt? none {
            let value=capture_pushes(node.default receiver element syntax env @session)
            if value is? Error return value
            default=value
        }
        return put(hir.Flow[node.loc void_type arms default] @session)
    }
    if node is? hir.IfArm|hir.LoopArm {
        let body=capture_pushes(node.body receiver element syntax env @session)
        if body is? Error return body
        return put(if node is? hir.IfArm hir.IfArm[node.loc void_type node.condition body] else hir.LoopArm[node.loc void_type node.condition body] @session)
    }
    let type=types.node_at(session.types node.value_type)
    if types.is_primitive(type 'void') or types.is_primitive(type 'never') return id
    let entry=views.container_entry_types(node_at(receiver session).value_type session.types)
    if entry isnt? none and entry.value isnt? none {
        # A dictionary capture stores the pair literal's key and value.
        $runtime_assert node is? hir.ObjectLiteral and node.fields.length =? 2
        let key=against(node.fields[0].value entry.key syntax env @session)
        if key is? Error return key
        let stored=against(node.fields[1].value entry.value syntax env @session)
        if stored is? Error return stored
        let arrays=container_values.arrays(receiver @session)
        return put(hir.DictStore[node.loc void_type arrays.keys arrays.values key stored] @session)
    }
    let value=against(id element syntax env @session)
    if value is? Error return value
    if entry isnt? none {
        let arrays=container_values.arrays(receiver @session)
        return put(hir.DictStore[node.loc void_type arrays.keys none value none] @session)
    }
    let signature=array_methods.signature('push' element @session.types)
    let method=put(hir.ArrayMethod[node.loc signature receiver 'push'] @session)
    return put(hir.FunctionCall[node.loc void_type method [value] []] @session)
}
# The common storage type of captured values: each widened, joined by
# subtyping; values of unrelated types need an annotated container.
capture_element = (values:array<addr> id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let element:addr?=none
    loop value in values {
        let widened=widen(value id env @session)
        if widened is? Error return widened
        let current=node_at(widened session).value_type
        if element is? none {element=current}
        else {
            let callable=join_container_callables(element current @session)
            if callable isnt? none {element=callable}
            else if subtyping.is_subtype(current element session.links @session.types) {}
            else if subtyping.is_subtype(element current session.links @session.types) {element=current}
            else return problem(id 'loop capture values differ in type' 'annotate the container to choose its element type' env session)
        }
    }
    $runtime_assert element isnt? none
    return element
}
capture_pair = (id:addr session:contexts.Session):>bool => {
    let node=node_at(id session)
    return node is? hir.ObjectLiteral and node.fields.length =? 2 and node.fields[0].name =? '__dewy_key' and node.fields[1].name =? '__dewy_value'
}
loop_capture = (id:addr syntax:addr env:Environment @session:contexts.Session expected:addr?=none is_set:bool=false):>addr|Error => {
    session.capture_pairs += 1
    let checked=expression(syntax env @session)
    if session.capture_pairs >? 0 { session.capture_pairs -= 1 }
    if checked is? Error return checked
    let values=capture_values(checked session)
    if values.length =? 0 return problem(id 'this loop expresses no value to capture' 'end the body with the value to collect' env session)
    let target_type=if expected is? none types.primitive('any' @session.types) else types.unfold(types.strip_refinement(expected session.types) session.types)
    let target=types.node_at(session.types target_type)
    let entries=if expected is? none none else views.container_entry_types(expected session.types)
    let loc=contexts.node_at(id env.lexical session).loc
    # `[loop ... k -> v]` builds a dictionary from pair values.
    let pairs:addr=0
    loop value in values { if capture_pair(value session) { pairs += 1 } }
    if pairs >? 0 {
        if is_set return problem(id 'a set capture takes members, not pairs' '`->` builds a dictionary: write `[loop ... k -> v]`' env session)
        if pairs not=? values.length return problem(id 'a capture mixes pairs and values' 'every value of a dictionary capture is a `key -> value` pair' env session)
        let keys:array<addr>=[]
        let stored:array<addr>=[]
        loop value in values {
            let pair=node_at(value session)
            $runtime_assert pair is? hir.ObjectLiteral and pair.fields.length =? 2
            keys.push(pair.fields[0].value) stored.push(pair.fields[1].value)
        }
        let key_type:addr|Error=if entries isnt? none entries.key else capture_element(keys id env @session)
        if key_type is? Error return key_type
        let value_type:addr|Error=if entries isnt? none and entries.value isnt? none entries.value else capture_element(stored id env @session)
        if value_type is? Error return value_type
        let type=views.container_type(key_type value_type @session.types)
        let name="__dewy_capture_{session.registry.next_id}"
        let binding_id=bindings.allocate_param(@session.registry name type loc)
        let receiver=put(hir.ExpressedIdentifier[loc type name binding_id] @session)
        let empty_keys=put(hir.ArrayLiteral[loc types.array_type(key_type 0 @session.types) []] @session)
        let empty_values=put(hir.ArrayLiteral[loc types.array_type(value_type 0 @session.types) []] @session)
        let initial=container_values.literal(loc type empty_keys empty_values @session)
        let declaration=put(hir.Declare[loc types.primitive('void' @session.types) 'let' name type initial binding_id] @session)
        let binding=bindings.binding_at(session.registry binding_id)
        binding.declaration=declaration binding.store_type=type
        bindings.store_binding(@session.registry binding_id binding)
        let filled=capture_pushes(checked receiver key_type id env @session)
        if filled is? Error return filled
        return put(hir.Block[loc type [declaration filled receiver] true] @session)
    }
    let element:addr?=if is_set and entries isnt? none entries.key else if target is? types.ArrayType target.element else none
    if element is? none {
        let common=capture_element(values id env @session)
        if common is? Error return common
        element=common
    }
    $runtime_assert element isnt? none
    let type=if is_set views.set_type(element @session.types) else types.array_type(element none @session.types)
    let name="__dewy_capture_{session.registry.next_id}"
    let binding_id=bindings.allocate_param(@session.registry name type loc)
    let receiver=put(hir.ExpressedIdentifier[loc type name binding_id] @session)
    let empty=put(hir.ArrayLiteral[loc types.array_type(element 0 @session.types) []] @session)
    let initial=if is_set container_values.literal(loc type empty none @session) else empty
    let declaration=put(hir.Declare[loc types.primitive('void' @session.types) 'let' name type initial binding_id] @session)
    let binding=bindings.binding_at(session.registry binding_id)
    binding.declaration=declaration binding.store_type=type
    bindings.store_binding(@session.registry binding_id binding)
    let filled=capture_pushes(checked receiver element id env @session)
    if filled is? Error return filled
    # Local result storage stays in the expression's evaluation position.
    # Lowering legalizes this block with the same rules as ordinary user code.
    return put(hir.Block[loc type [declaration filled receiver] true] @session)
}

# Only a single loop flow denotes a capture; a list containing other values
# still follows ordinary literal checking. Shared by array and set syntax.
captured_loop = (block:parser.Block env:Environment session:contexts.Session):>addr? => {
    if block.inner.length not=? 1 return none
    let candidate=contexts.node_at(block.inner[0] env.lexical session)
    if candidate isnt? parser.Flow or candidate.arms.length not=? 1 or candidate.default isnt? none return none
    let arm=contexts.node_at(candidate.arms[0] env.lexical session)
    if arm isnt? parser.KeywordExpr or arm.parts.length not=? 3 return none
    let keyword=contexts.node_at(arm.parts[0] env.lexical session)
    return if keyword is? tokens.Keyword and keyword.name =? 'loop' block.inner[0] else none
}

# A comparison chain is one monotonic statement, with equality allowed in
# either direction. Parenthesized comparisons are values, not continuations.
# Keep the operator token: `not <?` is an inverted test, even though the
# ordinary binary dispatcher also presents it as `>=?`.
chain_operator = (id:addr env:Environment session:contexts.Session):>string? => {
    let token=contexts.node_at(id env.lexical session)
    if token is? post.InvertedComparison return "not {token.symbol}"
    if token is? tokens.Operator and token.symbol in? ['<?' '<=?' '>?' '>=?' '=?' 'is?' 'isnt?' 'in?'] return token.symbol
    return none
}
chain_simple = (id:addr env:Environment session:contexts.Session):>bool => {
    let node=contexts.node_at(id env.lexical session)
    if node is? parser.Atom {
        let token=contexts.node_at(node.item env.lexical session)
        return token is? tokens.Identifier|tokens.String|tokens.Integer
    }
    let root=id
    loop node is? parser.BinOp and source_views.is_operator(node.op '.' env.lexical session) {
        if source_views.identifier(node.right env.lexical session) is? none return false
        root=node.left
        node=contexts.node_at(root env.lexical session)
    }
    return node is? parser.Atom and source_views.identifier(root env.lexical session) isnt? none
}
comparison_chain = (id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error|none => {
    let current=id
    let reversed:array<parser.BinOp>=[]
    loop true {
        let node=contexts.node_at(current env.lexical session)
        if node isnt? parser.BinOp or chain_operator(node.op env session) is? none break
        reversed.push(node)
        current=node.left
    }
    if reversed.length <? 2 return none
    let operations:array<parser.BinOp>=[]
    loop reversed.length >? 0 {operations.push(reversed.pop)}
    $runtime_assert operations.length >? 0
    let rising=false
    let falling=false
    let operands:array<addr>=[operations[0].left]
    loop operation in operations {
        let symbol=chain_operator(operation.op env session)
        $runtime_assert symbol isnt? none
        if symbol not in? ['<?' '<=?' '>?' '>=?' '=?'] return problem(id 'comparison does not chain' "`{symbol}` cannot be part of a comparison chain; combine tests with `and`" env session)
        if symbol in? ['<?' '<=?'] {rising=true}
        if symbol in? ['>?' '>=?'] {falling=true}
        operands.push(operation.right)
    }
    if rising and falling return problem(id 'comparison chain changes direction' 'a chain reads one way; write the other comparison with `and`' env session)
    # Match hosted evaluation: computed interior values are bound before the
    # conjunction. Simple reads retain their identities for relational facts.
    let prelude:array<addr>=[]
    let names:dict<addr string>=[]
    let i:addr=1
    loop i+1 <? operands.length {
        if not chain_simple(operands[i] env session) {
            let value=expression(operands[i] env @session)
            if value is? Error return value
            let name="__dewy_chain_{session.registry.next_id}"
            let declaration=match_bind(name value operands[i] env @session hidden=true)
            if declaration is? Error return declaration
            prelude.push(declaration)
            names[i]=name
        }
        i += 1
    }
    let combined:addr?=none
    let active=env
    let exits:array<Environment>=[]
    i=0
    loop i <? operations.length {
        $runtime_assert i+1 <? operands.length
        let left_name=names.get(i)
        let right_name=names.get(i+1)
        let left=if left_name isnt? none identifier(left_name operands[i] active @session) else expression(operands[i] active @session)
        if left is? Error return left
        let right=if right_name isnt? none identifier(right_name operands[i+1] active @session) else expression(operands[i+1] active @session)
        if right is? Error return right
        let symbol=source_views.symbol(operations[i].op env.lexical session)
        let operator=builtins.binary_operators.get(symbol)
        $runtime_assert operator isnt? none
        let function=identifier(operator id active @session)
        if function is? Error return function
        let compared=call(function [left right] [] id active @session expected=types.primitive('bool' @session.types))
        if compared is? Error return compared
        exits.push(refined(compared false active @session))
        active=refined(compared true active @session)
        combined=if combined is? none compared else put(hir.ShortCircuit[contexts.node_at(id env.lexical session).loc types.primitive('bool' @session.types) 'and' combined compared] @session)
        i += 1
    }
    exits.push(active)
    join_reads(exits env @session)
    $runtime_assert combined isnt? none
    let value=if expected is? none combined else against(combined expected id env @session)
    if value is? Error return value
    if prelude.length =? 0 return value
    prelude.push(value)
    return put(hir.Block[contexts.node_at(id env.lexical session).loc node_at(value session).value_type prelude false] @session)
}

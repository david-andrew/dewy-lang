from reporting import Error, Span
import p"../parser/p0.dewy" as parser
import p"../parser/t1.dewy" as tokens
import p"../parser/t2.dewy" as post
import p"context.dewy" as contexts
import p"syntax.dewy" as syntax
import p"type_check.dewy" as declarations
import p"ty.dewy" as types
import p"hir.dewy" as hir
import p"bindings.dewy" as bindings
import p"builtins.dewy" as builtins
import p"dispatch.dewy" as dispatch
import p"subtyping.dewy" as subtyping
import p"type_display.dewy" as display
import p"analyze/predicate_effects.dewy" as predicate_effects
import p"array_methods.dewy" as array_methods
import p"../targets.dewy" as targets
import p"namespaces.dewy" as namespaces

doc"""
Resolve source values into checked HIR. Type expressions share the same
lexical binding registry through type_check.dewy. Source, type, HIR, and
binding indices stay distinct even when their underlying word types agree.

This visitor establishes types and emits proof obligations; the analysis
passes must discharge those obligations before lowering. Successfully
building HIR alone does not authorize an unchecked native executable.

The current entry point accepts an already parsed module. Prelude/module
loading, representation selection, and the final validation/lowering driver
are separate work still needed by the compiler invocation.
"""

Environment:type = const [lexical:contexts.Context state:addr return_type:addr?=none]
put = (node:hir.AST @session:contexts.Session):>addr => hir.append_node(@session.hir node)
node_at = (id:addr session:contexts.Session):>hir.AST => hir.node_at(session.hir id)
void_at = (id:addr env:Environment @session:contexts.Session):>addr => {
    let syntax = contexts.node_at(id env.lexical session)
    return put(hir.Void[syntax.loc types.primitive('void' @session.types)] @session)
}
problem = (id:addr title:string message:string env:Environment session:contexts.Session):>Error => contexts.problem(id title message env.lexical session)
pending = (id:addr detail:string env:Environment session:contexts.Session):>Error => contexts.unsupported(id detail env.lexical session)

# Builtins are ordinary stable bindings. A lexical declaration may shadow a
# source operator name; synthesized compiler helpers retain their own ids.
begin = (source:contexts.Context @session:contexts.Session):>Environment => {
    let definitions = builtins.definitions(@session.types)
    let src = contexts.source_at(source session)
    $runtime_assert src.nodes.length >? 0
    let loc = src.nodes[0].loc
    loop [name value_type] in definitions {
        let binding_id = bindings.allocate(@session.registry none name 'function' loc)
        let binding = bindings.binding_at(session.registry binding_id)
        binding.value_type = value_type
        session.registry.by_id[binding_id] = binding
        bindings.bind(@session.scopes source.scope name binding_id)
    }
    let state = session.read_states.length
    session.read_states.push(contexts.ReadState[])
    return Environment[source state]
}

# Conversion to a refinement adds an obligation, never an assumption. More
# specialized materializations (bigint, rational, quantities, protocol slots)
# will join this boundary rather than becoming per-expression exceptions.
against = (value:addr expected:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node = node_at(value session)
    let target = types.node_at(session.types expected)
    if target is? types.RefinedType {
        let checked = against(value target.base id env @session)
        if checked is? Error return checked
        return put(hir.Obligation[node.loc node_at(checked session).value_type checked expected display.type_to_dewy(expected session.types)] @session)
    }
    if not subtyping.is_subtype(node.value_type expected session.links @session.types) return problem(id 'type mismatch' "`{display.type_to_dewy(node.value_type session.types)}` does not fit `{display.type_to_dewy(expected session.types)}`" env session)
    if node.value_type =? expected return value
    let actual = types.node_at(session.types node.value_type)
    if actual is? types.ArrayType and target is? types.ArrayType and target.length is? none and actual.element =? target.element return value
    if types.is_primitive(target 'any') return value
    if target is? types.TypeOr {
        if actual is? types.TypeOr return put(hir.RepresentationCast[node.loc expected value] @session)
        let candidates:array<addr> = []
        loop member in target.items {
            if subtyping.is_subtype(node.value_type member session.links @session.types) { candidates.push(member) }
        }
        if candidates.length not=? 1 return pending(id 'selecting among overlapping union materializations' env session)
        let inner = against(value candidates[0] id env @session)
        if inner is? Error return inner
        return put(hir.RepresentationCast[node.loc expected inner] @session)
    }
    if node is? hir.Integer return put(hir.Integer[node.loc expected node.prefix node.value] @session)
    return put(hir.ValueCast[node.loc expected value] @session)
}
widen = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node = node_at(value session)
    if node is? hir.Integer return against(value types.primitive('int64' @session.types) id env @session)
    if node is? hir.String return against(value types.primitive('string' @session.types) id env @session)
    return value
}
identifier = (name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let source = contexts.node_at(id env.lexical session)
    if name =? 'none' return put(hir.NoneValue[source.loc types.primitive('none' @session.types)] @session)
    if name =? 'void' return void_at(id env @session)
    let binding_id = declarations.lookup(name env.lexical session)
    if binding_id isnt? none {
        let binding = bindings.binding_at(session.registry binding_id)
        let value = binding.type_value
        if value is? none and binding_id in? session.pending_aliases {
            let resolved = declarations.resolve_alias(binding_id @session)
            if resolved is? Error return resolved
            value = resolved
        }
        if value isnt? none return put(hir.TypeValue[source.loc types.primitive('type' @session.types) value name] @session)
        if binding.value_type is? none return problem(id "cannot infer `{name}` before its declaration" 'add a type annotation to permit a forward reference' env session)
        let current = read_type(binding_id env session)
        $runtime_assert current isnt? none
        if types.node_at(session.types current) is? types.ModuleType return put(hir.ModuleNamespace[source.loc current name] @session)
        return put(hir.ExpressedIdentifier[source.loc current name binding_id] @session)
    }
    # A builtin type has no runtime declaration, but it may occur as a value
    # to construct or as the operand of an explicit cast.
    let type = declarations.resolve_name(name id env.lexical @session)
    if type is? Error return problem(id "undefined name `{name}`" 'no declaration of this name is in scope' env session)
    return put(hir.TypeValue[source.loc types.primitive('type' @session.types) type name] @session)
}

call = (function:addr positional:array<addr> keyword:dict<string addr> id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let func = node_at(function session)
    let shape = types.node_at(session.types func.value_type)
    if shape isnt? types.CallableType return problem(id 'value is not callable' display.type_to_dewy(func.value_type session.types) env session)
    let methods:array<addr> = if shape is? types.OverloadType shape.methods else [func.value_type]
    let pos_types:array<addr> = []
    let kw_types:dict<string addr> = []
    loop argument in positional { pos_types.push(node_at(argument session).value_type) }
    loop [name argument] in keyword { kw_types[name] = node_at(argument session).value_type }
    let system = dispatch.System[session.links builtins.promotions]
    let matched = dispatch.match_best_function(methods pos_types kw_types expected system @session.types)
    if matched is? dispatch.DispatchError return problem(id 'no matching function' matched.message env session)
    let method = dispatch.method_at(session.types matched.method)
    let args:array<addr> = []
    let places:array<addr> = []
    loop i in 0.. and i <? positional.length {
        if i >=? method.pos_or_kw.length return pending(id 'variadic argument materialization' env session)
        let slot = method.pos_or_kw[i]
        let checked = call_argument(positional[i] slot.value_type slot.place id env @session)
        if checked is? Error return checked
        let error = remember_place(checked @places id env session)
        if error isnt? none return error
        args.push(checked)
    }
    let kwargs:dict<string addr> = []
    loop [name argument] in keyword {
        let required:addr? = none
        let is_place = false
        loop slot in method.pos_or_kw { if slot.name =? name { required = slot.value_type is_place = slot.place break } }
        loop slot in method.kw_only { if slot.name =? name { required = slot.value_type is_place = slot.place break } }
        $runtime_assert required isnt? none
        let checked = call_argument(argument required is_place id env @session)
        if checked is? Error return checked
        let error = remember_place(checked @places id env session)
        if error isnt? none return error
        kwargs[name] = checked
    }
    let selected:addr? = if shape is? types.OverloadType matched.method_index else none
    let source = contexts.node_at(id env.lexical session)
    # Generic builtins specialize their signature here. User generic bodies
    # need instantiation and must not be emitted as unresolved generic calls.
    let callee = function
    if func is? hir.ExpressedIdentifier and shape is? types.FunctionType and shape.type_params.length >? 0 {
        callee = put(hir.ExpressedIdentifier[func.loc matched.method func.name func.binding_id] @session)
    }
    if func is? hir.ArrayMethod {
        let error = array_transition(func args kwargs id env @session)
        if error isnt? none return error
    }
    let result = put(hir.FunctionCall[source.loc method.ret callee args kwargs selected] @session)
    return if expected is? none result else against(result expected id env @session)
}

expression = (id:addr env:Environment @session:contexts.Session expected:addr?=none call_target:bool=false allow_place:bool=false):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let node = tokens.node_at(source.nodes id)
    let number = syntax.integer(id source.nodes)
    if number isnt? none {
        let literal = types.integer_literal(number @session.types)
        let value = put(hir.Integer[node.loc literal '0d' number] @session)
        return if expected is? none value else against(value expected id env @session)
    }
    if node is? parser.Atom {
        let atom = tokens.node_at(source.nodes node.item)
        let value:addr|Error = void_at(id env @session)
        if atom is? tokens.Identifier { value = identifier(atom.name id env @session) }
        else if atom is? tokens.String { value = put(hir.String[node.loc types.string_literal(atom.content @session.types) atom.content] @session) }
        else if atom is? tokens.Bool { value = put(hir.Bool[node.loc types.primitive('bool' @session.types) atom.value] @session) }
        else return pending(id "{atom.kind} value" env session)
        if value is? Error return value
        if not call_target and types.node_at(session.types node_at(value session).value_type) is? types.CallableType return call(value [] [] id env @session expected=expected)
        return if expected is? none value else against(value expected id env @session)
    }
    if node is? parser.Flow return flow(id node env @session expected=expected)
    if node is? parser.Block {
        if node.delims =? '()' and node.inner.length =? 1 return expression(node.inner[0] env @session expected=expected call_target=call_target allow_place=allow_place)
        if node.delims =? '[]' {
            loop item in node.inner {
                let row = tokens.node_at(source.nodes item)
                if row is? parser.BinOp and syntax.is_operator(row.op '=' source.nodes) return record_literal(id node env @session expected=expected)
            }
            let target:types.Type = types.node_at(session.types if expected is? none types.primitive('any' @session.types) else types.strip_refinement(expected session.types))
            let element:addr? = if target is? types.ArrayType target.element else none
            if node.inner.length =? 0 and element is? none return problem(id 'cannot infer empty array element type' 'provide an array annotation' env session)
            let items:array<addr> = []
            let item_types:array<addr> = []
            loop item in node.inner {
                let checked = expression(item env @session expected=element)
                if checked is? Error return checked
                if element is? none { checked = widen(checked item env @session) }
                if checked is? Error return checked
                items.push(checked) item_types.push(node_at(checked session).value_type)
            }
            if element is? none { element = subtyping.join(item_types session.links @session.types) }
            $runtime_assert element isnt? none
            let type = types.array_type(element node.inner.length @session.types)
            let value = put(hir.ArrayLiteral[node.loc type items] @session)
            return if expected is? none value else against(value expected id env @session)
        }
        if node.delims =? '\{}' return block(id env @session scoped=true expected=expected)
    }
    if node is? parser.Prefix {
        let op = syntax.symbol(node.op source.nodes)
        if op =? '@' {
            let value = expression(node.item env @session call_target=true)
            if value is? Error return value
            let target = node_at(value session)
            if types.node_at(session.types target.value_type) is? types.CallableType return value
            if not allow_place return problem(id 'a place can only be used as a function argument' 'pass it directly to an `@` parameter' env session)
            return place(value id env @session)
        }
        let name = builtins.prefix_operators.get(op)
        if name isnt? none {
            let operand = expression(node.item env @session)
            if operand is? Error return operand
            let func = identifier(name id env @session)
            if func is? Error return func
            return call(func [operand] [] id env @session expected=expected)
        }
    }
    if node is? parser.BinOp {
        let op = syntax.symbol(node.op source.nodes)
        if op =? 'SemicolonJuxtapose' {
            let value = expression(node.left env @session)
            if value is? Error return value
            return put(hir.Suppress[node.loc types.primitive('void' @session.types) value] @session)
        }
        if op =? 'is?' or op =? 'isnt?' {
            let value = expression(node.left env @session)
            if value is? Error return value
            let tested = declarations.resolve(node.right env.lexical @session)
            if tested is? Error return tested
            return put(hir.TypeTest[node.loc types.primitive('bool' @session.types) value tested op =? 'isnt?'] @session)
        }
        if tokens.node_at(source.nodes node.op) is? post.CombinedAssignment return compound_assignment(id node env @session)
        if op =? '=>' return function_literal(id node env @session)
        if op =? '=' or op =? ':=' or op =? '::' return declaration(id env @session)
        if op =? 'as' {
            let target = declarations.resolve(node.right env.lexical @session)
            if target is? Error return target
            return expression(node.left env @session expected=target)
        }
        if op =? '.' {
            let receiver = expression(node.left env @session allow_place=allow_place)
            if receiver is? Error return receiver
            let base = node_at(receiver session)
            let selected = if base is? hir.Place base.target else receiver
            let value = member(selected node.right id env @session)
            if value is? Error return value
            if base is? hir.Place return place(value id env @session)
            if not call_target and types.node_at(session.types node_at(value session).value_type) is? types.CallableType return call(value [] [] id env @session expected=expected)
            return if expected is? none value else against(value expected id env @session)
        }
        let adjacency = tokens.node_at(source.nodes node.op)
        if adjacency is? post.Juxtapose and adjacency.options.length >? 1 {
            let left = expression(node.left env @session call_target=true)
            if left is? Error return left
            let value = node_at(left session)
            if value is? hir.TypeValue return construct(value node.right id env @session expected=expected)
            let type = types.node_at(session.types types.strip_refinement(value.value_type session.types))
            if type is? types.CallableType and 'CallJuxtapose' in? adjacency.options return call_syntax(left node.right id env @session expected=expected)
            if (type is? types.ArrayType|types.StringType|types.StringLiteralType or types.is_primitive(type 'string')) and 'IndexJuxtapose' in? adjacency.options return index_syntax(left node.right id env @session)
            let number = types.primitive('number' @session.types)
            if 'MultiplyJuxtapose' in? adjacency.options and subtyping.is_subtype(value.value_type number session.links @session.types) {
                let right = expression(node.right env @session)
                if right is? Error return right
                let func = identifier('__mul__' id env @session)
                if func is? Error return func
                return call(func [left right] [] id env @session expected=expected)
            }
            return pending(id 'ambiguous adjacency involving this value type' env session)
        }
        if op =? 'CallJuxtapose' {
            let func = expression(node.left env @session call_target=true)
            if func is? Error return func
            let value = node_at(func session)
            if value is? hir.TypeValue return construct(value node.right id env @session expected=expected)
            return call_syntax(func node.right id env @session expected=expected)
        }
        if op =? 'IndexJuxtapose' {
            let sequence = expression(node.left env @session)
            if sequence is? Error return sequence
            return index_syntax(sequence node.right id env @session)
        }
        let operator = builtins.binary_operators.get(op)
        if op =? 'not=?' { operator = '__ne__' }
        if operator isnt? none {
            let left = expression(node.left env @session)
            if left is? Error return left
            let left_type = node_at(left session).value_type
            let logical = op in? ['and' '&' 'or' '|' 'nand' 'nor'] and types.is_primitive(types.node_at(session.types left_type) 'bool')
            let continues = op in? ['and' '&' 'nand']
            let shortcut = if logical refined(left not continues env @session) else env
            let right_env = if logical refined(left continues env @session) else env
            let right = expression(node.right right_env @session)
            if right is? Error return right
            let func = identifier(operator id env @session)
            if func is? Error return func
            let value = call(func [left right] [] id right_env @session expected=if logical types.primitive('bool' @session.types) else expected)
            if value is? Error return value
            let result = node_at(value session)
            if logical and result is? hir.FunctionCall and types.is_primitive(types.node_at(session.types result.value_type) 'bool') {
                let operation:'and'|'or'|'nand'|'nor' = if op =? 'nand' 'nand' else if op =? 'nor' 'nor' else if continues 'and' else 'or'
                let paths:array<Environment> = [shortcut right_env]
                let first = node_at(left session)
                if first is? hir.Bool { paths = [if first.value =? continues right_env else shortcut] }
                join_reads(paths env @session)
                let checked = put(hir.ShortCircuit[node.loc result.value_type operation left right] @session)
                return if expected is? none checked else against(checked expected id env @session)
            }
            return value
        }
    }
    if node is? parser.KeywordExpr and node.parts.length >? 0 {
        let keyword = tokens.node_at(source.nodes node.parts[0])
        if keyword is? tokens.Keyword and keyword.name in? ['import' 'from'] {
            let reference = contexts.syntax_ref(id env.lexical @session)
            if reference in? session.prepared_imports return void_at(id env @session)
            return pending(id 'loading an import at this expression site' env session)
        }
        if keyword is? tokens.Keyword and keyword.name =? 'return' {
            if env.return_type is? none return problem(id '`return` outside a function' 'nothing here catches this return' env session)
            let empty = void_at(id env @session)
            let value:addr|Error = empty
            if node.parts.length =? 2 { value = expression(node.parts[1] env @session expected=env.return_type) }
            else { value = against(empty env.return_type id env @session) }
            if value is? Error return value
            return put(hir.Return[node.loc types.primitive('never' @session.types) value] @session)
        }
    }
    if node is? parser.KeywordExpr and node.parts.length =? 2 {
        let keyword = tokens.node_at(source.nodes node.parts[0])
        if keyword is? tokens.Keyword and keyword.name in? ['let' 'const'] return declaration(node.parts[1] env @session constant=keyword.name =? 'const' explicit=true)
    }
    return pending(id "{node.kind} expression" env session)
}

declaration = (id:addr env:Environment @session:contexts.Session constant:bool=false explicit:bool=false):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let node = tokens.node_at(source.nodes id)
    if node isnt? parser.BinOp return problem(id 'declaration needs a value' 'expected a named assignment' env session)
    let target = tokens.node_at(source.nodes node.left)
    let target_id = node.left
    let annotation:addr? = none
    if target is? parser.BinOp and syntax.is_operator(target.op ':' source.nodes) {
        target_id = target.left
        let type = declarations.resolve(target.right env.lexical @session)
        if type is? Error return type
        annotation = type
    }
    let name = syntax.identifier(target_id source.nodes)
    if name is? none {
        if explicit or annotation isnt? none return pending(id 'destructuring declaration' env session)
        let place = expression(target_id env @session)
        if place is? Error return place
        let member = node_at(place session)
        if member isnt? hir.MemberAccess return pending(id 'this projected assignment target' env session)
        if not member.mutable return problem(id 'cannot assign to an immutable field' member.name env session)
        let path = bindings.access_path(place session.hir)
        let root = node_at(path.root session)
        if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {
            let binding = bindings.binding_at(session.registry root.binding_id)
            if binding.read_only_reason isnt? none return problem(id 'cannot mutate a field of a const binding' binding.name env session)
        }
        let value = expression(node.right env @session expected=member.value_type)
        if value is? Error return value
        return put(hir.MemberAssign[node.loc types.primitive('void' @session.types) place value] @session)
    }
    let scope = bindings.scope_at(session.scopes env.lexical.scope)
    let existing = if explicit or annotation isnt? none scope.names.get(name) else declarations.lookup(name env.lexical session)
    if existing isnt? none and existing in? session.pending_aliases {
        let value = declarations.resolve_alias(existing @session)
        if value is? Error return value
        let expr = put(hir.TypeValue[node.loc types.primitive('type' @session.types) value name] @session)
        return put(hir.Declare[node.loc types.primitive('void' @session.types) if constant 'const' else 'let' name annotation expr existing] @session)
    }
    let reserved = false
    if existing isnt? none {
        let binding = bindings.binding_at(session.registry existing)
        reserved = binding.kind =? 'function' and binding.declaration is? none
    }
    if existing isnt? none and not reserved {
        let prior = bindings.binding_at(session.registry existing)
        if explicit return problem(id "duplicate declaration `{name}`" 'this scope already declares the name' env session)
        if prior.read_only_reason isnt? none return problem(id 'cannot assign to a constant' name env session)
        let required = if prior.store_type is? none prior.value_type else prior.store_type
        let value = expression(node.right env @session expected=required)
        if value is? Error return value
        let target = identifier(name target_id env @session)
        if target is? Error return target
        set_read_type(existing node_at(value session).value_type env @session)
        return put(hir.Assign[node.loc types.primitive('void' @session.types) target '=' value] @session)
    }
    let value = expression(node.right env @session expected=annotation)
    if value is? Error return value
    if annotation is? none and not constant { value = widen(value node.right env @session) }
    if value is? Error return value
    let checked = node_at(value session)
    let syntax_id = contexts.syntax_ref(id env.lexical @session)
    let binding_id = if existing is? none bindings.allocate(@session.registry syntax_id name 'value' node.loc) else existing
    let binding = bindings.binding_at(session.registry binding_id)
    binding.value_type = if annotation is? none checked.value_type else annotation
    binding.store_type = binding.value_type
    set_read_type(binding_id checked.value_type env @session)
    if constant { binding.read_only_reason = 'const binding' }
    session.registry.by_id[binding_id] = binding
    bindings.bind(@session.scopes env.lexical.scope name binding_id)
    let declared = put(hir.Declare[node.loc types.primitive('void' @session.types) if constant 'const' else 'let' name annotation value binding_id] @session)
    binding.declaration = declared
    if checked is? hir.FunctionLiteral { binding.function = value }
    session.registry.by_id[binding_id] = binding
    return declared
}

block = (id:addr env:Environment @session:contexts.Session scoped:bool=false expected:addr?=none):>addr|Error => {
    let node = contexts.node_at(id env.lexical session)
    if node isnt? parser.Block return expression(id env @session expected=expected)
    let inner = if scoped Environment[contexts.child(env.lexical @session) env.state env.return_type] else env
    loop statement in node.inner {
        let alias = declarations.predeclare_alias(statement inner.lexical @session)
        if alias is? Error return alias
    }
    loop statement in node.inner {
        let error = predeclare_function(statement inner @session)
        if error isnt? none return error
    }
    let items:array<addr> = []
    let result = types.primitive('void' @session.types)
    let values:addr = 0
    loop item in node.inner {
        let value = expression(item inner @session expected=expected)
        if value is? Error return value
        items.push(value)
        let type = node_at(value session).value_type
        let atom = types.node_at(session.types type)
        if types.is_primitive(atom 'never') { result = type break }
        if not types.is_primitive(atom 'void') {
            values += 1 result = type
        }
    }
    if scoped and values >? 1 return problem(id 'block expresses multiple values' 'suppress unused expressions with a semicolon' env session)
    return put(hir.Block[node.loc result items scoped] @session)
}

read_type = (id:addr env:Environment session:contexts.Session):>addr? => {
    $runtime_assert env.state <? session.read_states.length
    let state = session.read_states[env.state]
    let type = state.types.get(id)
    return if type is? none bindings.binding_at(session.registry id).value_type else type
}
set_read_type = (id:addr type:addr env:Environment @session:contexts.Session):>void => {
    $runtime_assert env.state <? session.read_states.length
    let state = session.read_states[env.state]
    state.types[id] = type
    session.read_states[env.state] = state
}
fork = (env:Environment @session:contexts.Session):>Environment => {
    $runtime_assert env.state <? session.read_states.length
    let copy = session.read_states[env.state]
    let state = session.read_states.length
    session.read_states.push(copy)
    return Environment[env.lexical state env.return_type]
}

# Annotated functions reserve their signature before any body in the block
# is checked. Initialization analysis, not name resolution, decides whether
# an eager call reaches a declaration before its value has been initialized.
function_shape = (literal:parser.BinOp env:Environment @session:contexts.Session):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let signature = tokens.node_at(source.nodes literal.left)
    if signature isnt? parser.BinOp or not syntax.is_operator(signature.op ':>' source.nodes) return pending(literal.left 'inferring a function result type' env session)
    let args = declarations.function_args(signature.left env.lexical @session)
    if args is? Error return args
    let parameters:array<types.PosOrKwArg> = []
    loop arg in args {
        parameters.push(types.PosOrKwArg[arg.name declarations.word_element(arg.value_type @session) arg.required arg.place])
    }
    let result = declarations.function_result(signature.right env.lexical @session)
    if result is? Error return result
    return types.function_type(parameters [] none declarations.word_element(result @session) [] @session.types)
}
predeclare_function = (id:addr env:Environment @session:contexts.Session):>Error? => {
    let source = contexts.source_at(env.lexical session)
    let node = tokens.node_at(source.nodes id)
    if node is? parser.KeywordExpr and node.parts.length =? 2 {
        let keyword = tokens.node_at(source.nodes node.parts[0])
        if keyword is? tokens.Keyword and keyword.name in? ['let' 'const'] { node = tokens.node_at(source.nodes node.parts[1]) }
    }
    if node isnt? parser.BinOp or syntax.symbol(node.op source.nodes) not in? ['=' '::' ':='] return none
    let name = syntax.identifier(node.left source.nodes)
    let literal = tokens.node_at(source.nodes node.right)
    if name is? none or literal isnt? parser.BinOp or not syntax.is_operator(literal.op '=>' source.nodes) return none
    let signature = tokens.node_at(source.nodes literal.left)
    if signature isnt? parser.BinOp or not syntax.is_operator(signature.op ':>' source.nodes) return none
    let shape = function_shape(literal env @session)
    if shape is? Error return shape
    let scope = bindings.scope_at(session.scopes env.lexical.scope)
    if name in? scope.names return problem(id "duplicate declaration `{name}`" 'this scope already declares the name' env session)
    let reference = contexts.syntax_ref(id env.lexical @session)
    let binding_id = bindings.allocate(@session.registry reference name 'function' node.loc)
    let binding = bindings.binding_at(session.registry binding_id)
    binding.value_type = shape binding.store_type = shape
    session.registry.by_id[binding_id] = binding
    bindings.bind(@session.scopes env.lexical.scope name binding_id)
    return none
}
function_literal = (id:addr literal:parser.BinOp env:Environment @session:contexts.Session):>addr|Error => {
    let resolved = function_shape(literal env @session)
    if resolved is? Error return resolved
    let shape = dispatch.method_at(session.types resolved)
    let inner = Environment[contexts.child(env.lexical @session) fork(env @session).state shape.ret]
    let parameters:array<hir.Param> = []
    let source = contexts.source_at(env.lexical session)
    let signature = tokens.node_at(source.nodes literal.left)
    $runtime_assert signature is? parser.BinOp
    let arguments = tokens.node_at(source.nodes signature.left)
    let rows:array<addr> = if arguments is? parser.Block arguments.inner else [signature.left]
    let position:addr = 0
    loop param in shape.pos_or_kw {
        $runtime_assert param.name isnt? none
        let scope = bindings.scope_at(session.scopes inner.lexical.scope)
        if param.name in? scope.names return problem(id 'duplicate function parameter' param.name env session)
        # Defaults run in the callee but resolve in the defining outer scope,
        # as in the hosted checker. BoundParam retains the checked expression
        # without evaluating it while declaring the function.
        $runtime_assert position <? rows.length
        let row = tokens.node_at(source.nodes rows[position])
        let default:addr? = none
        if row is? parser.BinOp and syntax.is_operator(row.op '=' source.nodes) {
            let value = expression(row.right env @session expected=param.value_type)
            if value is? Error return value
            default = value
        }
        position += 1
        let binding_id = bindings.allocate_param(@session.registry param.name param.value_type literal.loc)
        let binding = bindings.binding_at(session.registry binding_id)
        binding.store_type = param.value_type
        session.registry.by_id[binding_id] = binding
        bindings.bind(@session.scopes inner.lexical.scope param.name binding_id)
        if default is? none { parameters.push(hir.Param[param.name param.value_type binding_id place=param.place]) }
        else { parameters.push(hir.BoundParam[param.name param.value_type binding_id value=default place=param.place]) }
    }
    let body = expression(literal.right inner @session expected=shape.ret)
    if body is? Error return body
    let body_type = node_at(body session).value_type
    if not subtyping.is_subtype(body_type shape.ret session.links @session.types) return problem(id 'function body does not provide its result' display.type_to_dewy(shape.ret session.types) env session)
    let result = put(hir.FunctionLiteral[literal.loc resolved parameters [] none shape.ret body source=contexts.source_at(env.lexical session).srcfile] @session)
    return result
}

# A type test selects a read alternative; it does not alter the binding's
# store contract. Disjoint alternatives disappear, and a positive test of a
# broad nominal family selects the tested descendant itself.
select_type = (current:addr tested:addr truth:bool @session:contexts.Session):>addr => {
    let node = types.node_at(session.types current)
    if node is? types.TypeOr {
        let members:array<addr> = []
        loop member in node.items { members.push(select_type(member tested truth @session)) }
        return subtyping.join(members session.links @session.types)
    }
    if subtyping.is_subtype(current tested session.links @session.types) return if truth current else types.primitive('never' @session.types)
    let overlap = types.intersect([current tested] @session.types)
    if subtyping.is_empty(overlap session.links @session.types) return if truth types.primitive('never' @session.types) else current
    if truth and subtyping.is_subtype(tested current session.links @session.types) return tested
    return if truth overlap else types.intersect([current types.negate(tested @session.types)] @session.types)
}
refined = (condition:addr truth:bool env:Environment @session:contexts.Session invalidated:set<addr>=set[]):>Environment => {
    let result = fork(env @session)
    let node = node_at(condition session)
    if node is? hir.ValueCast return refined(node.expr truth result @session invalidated=invalidated)
    if node isnt? hir.ShortCircuit {
        loop binding in predicate_effects.read_bindings(condition session.hir) {
            if binding in? invalidated return result
        }
    }
    if node is? hir.FunctionCall and node.pos_args.length =? 1 {
        let func = node_at(node.func session)
        if func is? hir.ExpressedIdentifier and func.name =? '__not__' return refined(node.pos_args[0] not truth result @session invalidated=invalidated)
    }
    if node is? hir.TypeTest {
        let value = node_at(node.value session)
        if value is? hir.ExpressedIdentifier and value.binding_id isnt? none {
            let current = read_type(value.binding_id result session)
            $runtime_assert current isnt? none
            set_read_type(value.binding_id select_type(current node.test_type truth not=? node.negated @session) result @session)
        }
    }
    if node is? hir.ShortCircuit {
        let effective_truth = if node.op in? ['nand' 'nor'] not truth else truth
        let conjunction = node.op in? ['and' 'nand']
        if effective_truth =? conjunction {
            let changed = invalidated
            loop binding in predicate_effects.mutated_bindings(node.right session.hir) { changed.add(binding) }
            result = refined(node.left effective_truth result @session invalidated=changed)
            result = refined(node.right effective_truth result @session invalidated=invalidated)
        }
    }
    return result
}
join_reads = (exits:array<Environment> env:Environment @session:contexts.Session):>void => {
    if exits.length =? 0 return void
    let names:set<addr> = set[]
    loop exit in exits {
        $runtime_assert exit.state <? session.read_states.length
        loop [binding type] in session.read_states[exit.state].types { names.add(binding) }
    }
    let joined = contexts.ReadState[]
    loop binding in names {
        let alternatives:array<addr> = []
        loop exit in exits {
            let type = read_type(binding exit session)
            if type isnt? none { alternatives.push(type) }
        }
        if alternatives.length =? exits.length { joined.types[binding] = subtyping.join(alternatives session.links @session.types) }
    }
    $runtime_assert env.state <? session.read_states.length
    session.read_states[env.state] = joined
}
flow = (id:addr node:parser.Flow env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let remaining = fork(env @session)
    let arms:array<addr> = []
    let results:array<addr> = []
    let exits:array<Environment> = []
    loop arm_id in node.arms {
        let arm = tokens.node_at(source.nodes arm_id)
        if arm isnt? parser.KeywordExpr or arm.parts.length not=? 3 return pending(arm_id 'this conditional arm' env session)
        let keyword = tokens.node_at(source.nodes arm.parts[0])
        if keyword isnt? tokens.Keyword or keyword.name not=? 'if' return pending(arm_id 'loop transfer and iterator checking' env session)
        let condition = expression(arm.parts[1] remaining @session expected=types.primitive('bool' @session.types))
        if condition is? Error return condition
        let positive = refined(condition true remaining @session)
        let body = expression(arm.parts[2] positive @session expected=expected)
        if body is? Error return body
        if expected is? none { body = widen(body arm.parts[2] positive @session) }
        if body is? Error return body
        let type = node_at(body session).value_type
        arms.push(put(hir.IfArm[arm.loc type condition body] @session))
        if not types.is_primitive(types.node_at(session.types type) 'never') { results.push(type) exits.push(positive) }
        remaining = refined(condition false remaining @session)
    }
    let default:addr? = none
    if node.default isnt? none {
        let checked = expression(node.default remaining @session expected=expected)
        if checked is? Error return checked
        if expected is? none { checked = widen(checked node.default remaining @session) }
        if checked is? Error return checked
        default = checked
        let type = node_at(checked session).value_type
        if not types.is_primitive(types.node_at(session.types type) 'never') { results.push(type) exits.push(remaining) }
    } else { exits.push(remaining) }
    join_reads(exits env @session)
    let type = if node.default is? none types.primitive('void' @session.types) else subtyping.join(results session.links @session.types)
    return put(hir.Flow[node.loc type arms default] @session)
}

call_syntax = (function:addr arguments_id:addr id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let arguments = tokens.node_at(source.nodes arguments_id)
    let items:array<addr> = if arguments is? parser.Block arguments.inner else [arguments_id]
    let positional:array<addr> = []
    let keyword:dict<string addr> = []
    loop item in items {
        let row = tokens.node_at(source.nodes item)
        if row is? parser.BinOp and syntax.is_operator(row.op '=' source.nodes) {
            let name = syntax.identifier(row.left source.nodes)
            if name is? none return problem(item 'named argument needs a name' 'use `name=value`' env session)
            if name in? keyword return problem(item 'duplicate named argument' name env session)
            let value = expression(row.right env @session allow_place=true)
            if value is? Error return value
            keyword[name] = value
        } else {
            if keyword.length >? 0 return pending(item 'interleaved named and positional argument normalization' env session)
            let value = expression(item env @session allow_place=true)
            if value is? Error return value
            positional.push(value)
        }
    }
    return call(function positional keyword id env @session expected=expected)
}

index_syntax = (sequence:addr index_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let arguments = tokens.node_at(source.nodes index_id)
    let item = index_id
    if arguments is? parser.Block {
        if arguments.inner.length not=? 1 return problem(id 'index requires one expression' 'select one element, or use a range for a slice' env session)
        item = arguments.inner[0]
    }
    let index = expression(item env @session expected=types.primitive('int64' @session.types))
    if index is? Error return index
    let value = node_at(sequence session)
    let type = types.node_at(session.types types.strip_refinement(value.value_type session.types))
    let syntax = tokens.node_at(source.nodes id)
    if type is? types.ArrayType return put(hir.Index[syntax.loc type.element sequence index none] @session)
    if type is? types.StringType|types.StringLiteralType or types.is_primitive(type 'string') return put(hir.StringIndex[syntax.loc types.string_type(1 @session.types) sequence index none] @session)
    return problem(id 'index target is not an array or string' display.type_to_dewy(value.value_type session.types) env session)
}

# Field reads preserve their receiver expression. The route registry can later
# attach stable fact identities without evaluating the receiver a second time.
member = (receiver:addr name_id:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let name = syntax.identifier(name_id source.nodes)
    if name is? none return problem(id 'member access needs a name' 'expected a field or method name' env session)
    let value = node_at(receiver session)
    let type = types.node_at(session.types types.unfold(types.strip_refinement(value.value_type session.types) session.types))
    let loc = tokens.node_at(source.nodes id).loc
    if type is? types.ModuleType {
        let field = namespaces.field(type name)
        if field is? none return problem(id 'module does not export this name' name env session)
        if field.type_value isnt? none return put(hir.TypeValue[loc types.primitive('type' @session.types) field.type_value name] @session)
        let binding = bindings.binding_at(session.registry field.binding_id)
        return put(hir.ExpressedIdentifier[loc field.value_type binding.name field.binding_id] @session)
    }
    if type is? types.ObjectType {
        let field = types.object_field(type name)
        if field isnt? none return put(hir.MemberAccess[loc field.value_type receiver name field.mutable and not type.immutable] @session)
    }
    if type is? types.ArrayType and name in? array_methods.names return array_method(receiver type name id env @session)
    if name =? 'length' {
        let word = types.primitive('int64' @session.types)
        if type is? types.ArrayType {
            let result = if type.length is? none word else types.integer_literal(type.length @session.types)
            return put(hir.ArrayLength[loc result receiver] @session)
        }
        if type is? types.StringType|types.StringLiteralType or types.is_primitive(type 'string') {
            let length:addr? = none
            if type is? types.StringType { length = type.length }
            if type is? types.StringLiteralType { length = type.value.length }
            let result = if length is? none word else types.integer_literal(length @session.types)
            return put(hir.StringLength[loc result receiver] @session)
        }
    }
    return pending(id "member `{name}` on `{display.type_to_dewy(value.value_type session.types)}`" env session)
}

# Record fields enter a fresh lexical scope in source order, so later values
# can refer to earlier fields. These bindings identify the already evaluated
# field values; they do not cause the initializer to run again.
record_literal = (id:addr node:parser.Block env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type]
    let wanted:types.Type = types.node_at(session.types if expected is? none types.primitive('any' @session.types) else types.unfold(types.strip_refinement(expected session.types) session.types))
    let fields:array<hir.ObjectField> = []
    let layout:array<types.ObjectField> = []
    loop row_id in node.inner {
        let row = tokens.node_at(source.nodes row_id)
        if row isnt? parser.BinOp or not syntax.is_operator(row.op '=' source.nodes) return problem(row_id 'mixed record and array literal' 'each record field needs a named value' env session)
        let target = tokens.node_at(source.nodes row.left)
        let name_id = row.left
        let annotation:addr? = none
        if target is? parser.BinOp and syntax.is_operator(target.op ':' source.nodes) {
            name_id = target.left
            let resolved = declarations.resolve(target.right inner.lexical @session)
            if resolved is? Error return resolved
            annotation = resolved
        }
        let name = syntax.identifier(name_id source.nodes)
        if name is? none return problem(row_id 'record field needs a name' 'use `name=value` or `name:Type=value`' env session)
        let scope = bindings.scope_at(session.scopes inner.lexical.scope)
        if name in? scope.names return problem(row_id 'duplicate record field' name env session)
        let field:types.ObjectField? = none
        if wanted is? types.ObjectType {
            field = types.object_field(wanted name)
            if field is? none return problem(row_id 'unknown record field' name env session)
            if annotation is? none { annotation = field.value_type }
        }
        let value = expression(row.right inner @session expected=annotation)
        if value is? Error return value
        if annotation is? none { value = widen(value row.right inner @session) }
        if value is? Error return value
        let type = if annotation is? none node_at(value session).value_type else annotation
        if field isnt? none and field.refinement.length >? 0 {
            let required = types.refined_type(type field.refinement @session.types)
            value = against(value required row_id inner @session)
            if value is? Error return value
        }
        let binding = bind_field(name type row.loc inner @session)
        let mutable = if field is? none true else field.mutable
        if wanted is? types.ObjectType and wanted.immutable { mutable = false }
        fields.push(hir.ObjectField[row.loc name value binding mutable])
        layout.push(if field is? none types.ObjectField[name type] else field)
    }
    if wanted is? types.ObjectType {
        loop field in wanted.fields {
            let scope = bindings.scope_at(session.scopes inner.lexical.scope)
            if field.name not in? scope.names return problem(id 'missing record field' field.name env session)
        }
    }
    let type = if wanted is? types.ObjectType and expected isnt? none types.strip_refinement(expected session.types) else types.object_type(layout none false [] [] @session.types)
    let value = put(hir.ObjectLiteral[node.loc type fields] @session)
    return if expected is? none value else against(value expected id env @session)
}

bind_field = (name:string type:addr loc:Span env:Environment @session:contexts.Session):>addr => {
    let id = bindings.allocate(@session.registry none name 'value' loc)
    let binding = bindings.binding_at(session.registry id)
    binding.value_type = type binding.store_type = type
    session.registry.by_id[id] = binding
    bindings.bind(@session.scopes env.lexical.scope name id)
    return id
}

# Constructor defaults retain their declaration's source and outer scope.
# The completed earlier fields form the innermost scope in either source.
# As in the hosted constructor, arguments bind slots first and field
# initializers run in declaration order. Defaults only fill absent slots.
construct = (constructor:hir.TypeValue arguments_id:addr id:addr env:Environment @session:contexts.Session expected:addr?=none):>addr|Error => {
    if constructor.value isnt? addr return pending(id 'generic type constructor inference' env session)
    let type = types.unfold(constructor.value session.types)
    let shape = types.node_at(session.types type)
    if shape isnt? types.ObjectType return pending(id 'non-record type constructor' env session)
    if shape.abstract return problem(id 'cannot construct an abstract type' display.type_to_dewy(type session.types) env session)
    if shape.constructors.length >? 0 return pending(id 'user constructor overloads' env session)
    let source = contexts.source_at(env.lexical session)
    let arguments = tokens.node_at(source.nodes arguments_id)
    let items:array<addr> = if arguments is? parser.Block arguments.inner else [arguments_id]
    let inner = Environment[contexts.child(env.lexical @session) env.state env.return_type]
    let given:dict<string addr> = []
    let positional:array<addr> = []
    loop item in items {
        let row = tokens.node_at(source.nodes item)
        let name:string? = none
        let value_id = item
        if row is? parser.BinOp and syntax.is_operator(row.op '=' source.nodes) {
            name = syntax.identifier(row.left source.nodes)
            value_id = row.right
            if name is? none return problem(item 'constructor argument needs a field name' 'use `name=value`' env session)
        } else {
            positional.push(item)
            continue
        }
        $runtime_assert name isnt? none
        if name in? given return problem(item 'duplicate constructor field' name env session)
        let field = types.object_field(shape name)
        if field is? none return problem(item 'unknown constructor field' name env session)
        given[name] = value_id
    }
    if positional.length >? shape.fields.length return problem(id 'too many constructor arguments' 'the type has fewer fields than positional arguments' env session)
    loop i in 0.. and i <? positional.length and i <? shape.fields.length {
        let name = shape.fields[i].name
        if name in? given return problem(positional[i] 'duplicate constructor field' name env session)
        given[name] = positional[i]
    }
    let fields:array<hir.ObjectField> = []
    loop field in shape.fields {
        let supplied = given.get(field.name)
        let value:addr? = none
        if supplied isnt? none {
            let checked = expression(supplied inner @session expected=field.value_type)
            if checked is? Error return checked
            value = checked
        } else {
            if field.default is? none return problem(id 'missing constructor field' field.name env session)
            $runtime_assert field.default <? session.syntax_refs.length
            let reference = session.syntax_refs[field.default]
            let scope = bindings.scope_at(session.scopes inner.lexical.scope)
            let default_scope = bindings.push_scope(@session.scopes reference.scope)
            loop [name binding] in scope.names { bindings.bind(@session.scopes default_scope name binding) }
            let lexical = contexts.Context[reference.source default_scope]
            let default_env = Environment[lexical env.state env.return_type]
            let checked = expression(reference.node default_env @session expected=field.value_type)
            if checked is? Error return checked
            value = checked
        }
        $runtime_assert value isnt? none
        if field.refinement.length >? 0 {
            let required = types.refined_type(field.value_type field.refinement @session.types)
            let checked = against(value required id env @session)
            if checked is? Error return checked
            value = checked
        }
        $runtime_assert value isnt? none
        let binding = bind_field(field.name field.value_type node_at(value session).loc inner @session)
        fields.push(hir.ObjectField[node_at(value session).loc field.name value binding field.mutable and not shape.immutable])
    }
    let loc = tokens.node_at(source.nodes id).loc
    let value = put(hir.ObjectLiteral[loc type fields] @session)
    return if expected is? none value else against(value expected id env @session)
}

# A place keeps its declared storage type, even when the latest read carried
# a stronger alternative or length. The callee can replace that storage, so
# preparing the argument invalidates read facts about its containing root.
place = (value:addr id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let target = node_at(value session)
    if target isnt? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index return problem(id 'a place needs mutable storage' 'use a binding, field, or indexed element' env session)
    let path = bindings.access_path(value session.hir)
    let root = node_at(path.root session)
    if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return problem(id 'a place needs a named root' 'this temporary does not name caller storage' env session)
    let binding = bindings.binding_at(session.registry root.binding_id)
    if binding.read_only_reason isnt? none return problem(id 'cannot pass a const binding as a mutable place' binding.name env session)
    loop step in path.steps {
        let member = node_at(step session)
        if member is? hir.MemberAccess and not member.mutable return problem(id 'cannot pass an immutable field as a mutable place' member.name env session)
    }
    let store_type = target.value_type
    if target is? hir.ExpressedIdentifier {
        if binding.store_type isnt? none { store_type = binding.store_type }
        else if binding.value_type isnt? none { store_type = binding.value_type }
        value = put(hir.ExpressedIdentifier[target.loc store_type target.name target.binding_id] @session)
    }
    if binding.value_type isnt? none { set_read_type(binding.id binding.value_type env @session) }
    let loc = contexts.node_at(id env.lexical session).loc
    return put(hir.Place[loc store_type value] @session)
}
call_argument = (argument:addr required:addr place_parameter:bool id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let node = node_at(argument session)
    if place_parameter and node isnt? hir.Place return problem(id 'place argument requires `@`' 'the parameter can write its caller binding' env session)
    if not place_parameter and node is? hir.Place return problem(id 'value parameter does not accept a place' 'remove `@` to pass an independent value' env session)
    if node is? hir.Place {
        if not place_fits(node.value_type required @session) return problem(id 'place parameter types are invariant' 'the storage and parameter types must agree' env session)
        return argument
    }
    return against(argument required id env @session)
}
remember_place = (argument:addr @places:array<addr> id:addr env:Environment session:contexts.Session):>Error? => {
    let node = node_at(argument session)
    if node isnt? hir.Place return none
    let path = bindings.access_path(node.target session.hir)
    let root = node_at(path.root session)
    $runtime_assert root is? hir.ExpressedIdentifier
    loop previous in places {
        let other = bindings.access_path(previous session.hir)
        let owner = node_at(other.root session)
        $runtime_assert owner is? hir.ExpressedIdentifier
        if root.binding_id not=? owner.binding_id continue
        let disjoint = false
        loop i in 0.. and i <? path.steps.length and i <? other.steps.length {
            let left = node_at(path.steps[i] session)
            let right = node_at(other.steps[i] session)
            if left is? hir.MemberAccess and right is? hir.MemberAccess and left.name not=? right.name { disjoint = true break }
            if left is? hir.Index and right is? hir.Index {
                let a = node_at(left.index session)
                let b = node_at(right.index session)
                if a is? hir.Integer and b is? hir.Integer and a.value not=? b.value { disjoint = true break }
            }
        }
        if not disjoint return problem(id 'overlapping mutable places in one call' 'these arguments may name the same storage' env session)
    }
    places.push(node.target)
    return none
}

# The established nominal exception keeps the parent's leading field layout.
# It does not make ordinary mutable containers covariant.
place_fits = (actual:addr required:addr @session:contexts.Session):>bool => {
    if types.same_type(actual required session.types) return true
    let a = types.node_at(session.types types.unfold(types.strip_refinement(actual session.types) session.types))
    let r = types.node_at(session.types types.unfold(types.strip_refinement(required session.types) session.types))
    if a isnt? types.ObjectType or not a.minted or r isnt? types.ObjectType return false
    return subtyping.is_subtype(actual required session.links @session.types)
}

array_method = (receiver:addr read:types.ArrayType name:string id:addr env:Environment @session:contexts.Session):>addr|Error => {
    let receiver_node = node_at(receiver session)
    let declared:addr = receiver_node.value_type
    if name not=? 'join' {
        let path = bindings.access_path(receiver session.hir)
        let root = node_at(path.root session)
        if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return problem(id 'array mutation needs a named receiver' 'bind the array before changing it' env session)
        let binding = bindings.binding_at(session.registry root.binding_id)
        if binding.read_only_reason isnt? none return problem(id 'cannot mutate a const binding' binding.name env session)
        loop step in path.steps {
            let field = node_at(step session)
            if field is? hir.MemberAccess and not field.mutable return problem(id 'cannot mutate an immutable field' field.name env session)
        }
        if receiver_node is? hir.ExpressedIdentifier and binding.store_type isnt? none { declared = binding.store_type }
        if receiver_node is? hir.ExpressedIdentifier and binding.declaration isnt? none {
            let declaration_id = binding.declaration
            let declaration = node_at(declaration_id session)
            let stored = types.node_at(session.types types.strip_refinement(declared session.types))
            if declaration is? hir.Declare and declaration.annotation is? none and stored is? types.ArrayType {
                # An inferred array grows when its program uses a growth
                # method. An explicitly fixed length remains a store contract.
                declared = types.array_type(stored.element none @session.types)
                binding.value_type = declared binding.store_type = declared
                session.registry.by_id[binding.id] = binding
                $runtime_assert declaration_id <? session.hir.length
                session.hir[declaration_id] = hir.Declare[declaration.loc declaration.value_type declaration.decltype declaration.name declared declaration.expr declaration.binding_id]
            }
        }
        let shape = types.node_at(session.types types.strip_refinement(declared session.types))
        if shape is? types.TypeOr {
            loop alternative in shape.items {
                let candidate = types.node_at(session.types types.strip_refinement(alternative session.types))
                if candidate is? types.ArrayType and candidate.length is? none and subtyping.is_subtype(receiver_node.value_type alternative session.links @session.types) {
                    declared = alternative
                    break
                }
            }
            shape = types.node_at(session.types types.strip_refinement(declared session.types))
        }
        if shape isnt? types.ArrayType or shape.length isnt? none return problem(id 'exact-length arrays cannot change length' 'declare the storage as `array<T>` to permit growth' env session)
        declared = types.strip_refinement(declared session.types)
        if receiver_node is? hir.ExpressedIdentifier { receiver = put(hir.ExpressedIdentifier[receiver_node.loc declared receiver_node.name receiver_node.binding_id] @session) }
        else if receiver_node is? hir.MemberAccess { receiver = put(hir.MemberAccess[receiver_node.loc declared receiver_node.value receiver_node.name receiver_node.mutable] @session) }
    } else {
        if not subtyping.is_subtype(read.element types.primitive('string' @session.types) session.links @session.types) return problem(id '`join` requires string elements' display.type_to_dewy(read.element session.types) env session)
    }
    let signature = array_methods.signature(name read.element @session.types)
    let loc = contexts.node_at(id env.lexical session).loc
    return put(hir.ArrayMethod[loc signature receiver name] @session)
}

# This is the checker's exact-length view. The bounds validator separately
# transfers intervals, proves operation indices, and enforces the original
# storage refinements; losing an exact length is not permission to skip it.
array_transition = (method:hir.ArrayMethod positional:array<addr> keyword:dict<string addr> id:addr env:Environment @session:contexts.Session):>Error? => {
    if method.name in? ['join' 'reserve' 'sort'] return none
    let limit = targets.max_length(session.target)
    let route = bindings.array_route_id(method.array session.hir @session.registry)
    if route is? none return none
    let current = read_type(route env session)
    let array = types.node_at(session.types node_at(method.array session).value_type)
    $runtime_assert array is? types.ArrayType
    let length:addr? = none
    if current isnt? none {
        let shape = types.node_at(session.types types.strip_refinement(current session.types))
        if shape is? types.ArrayType { length = shape.length }
    }
    let index:addr? = none
    if method.name =? 'pop' or method.name =? 'truncate' {
        index = if positional.length >? 0 positional[0] else keyword.get(if method.name =? 'pop' 'idx' else 'count')
    }
    if method.name =? 'insert' { index = if positional.length >? 1 positional[1] else keyword.get('idx') }
    let count:bigint? = none
    if index isnt? none {
        let number = node_at(index session)
        if number is? hir.Integer { count = number.value }
    }
    if count isnt? none and count <? 0 return problem(id 'array method index cannot be negative' method.name env session)
    if method.name =? 'clear' { length = 0 }
    else if method.name =? 'push' or method.name =? 'insert' {
        if method.name =? 'insert' and count isnt? none and length isnt? none and count >? length return problem(id 'insert index is out of bounds' 'the index must be at or before the end' env session)
        if length isnt? none {
            if length >=? limit return problem(id 'array length exceeds the target address space' 'this array cannot grow by another element' env session)
            length += 1
        }
    } else if method.name =? 'pop' {
        if length isnt? none {
            if length =? 0 return problem(id 'pop on an empty array' 'no element can be removed' env session)
            if count isnt? none and count >=? length return problem(id 'pop index is out of bounds' 'the index must select an existing element' env session)
            length -= 1
        }
    } else if method.name =? 'truncate' {
        if count is? none { length = none }
        else if length isnt? none and count <? length {
            $runtime_assert count >=? 0 and count <=? limit
            length = count as addr
        }
    }
    set_read_type(route types.array_type(array.element length @session.types) env @session)
    return none
}

compound_assignment = (id:addr node:parser.BinOp env:Environment @session:contexts.Session):>addr|Error => {
    let source = contexts.source_at(env.lexical session)
    let op = tokens.node_at(source.nodes node.op)
    $runtime_assert op is? post.CombinedAssignment
    let symbol = syntax.symbol(op.op source.nodes)
    let name = builtins.binary_operators.get(symbol)
    if name is? none return pending(id "compound operator `{symbol}=`" env session)
    let target = expression(node.left env @session call_target=true)
    if target is? Error return target
    let read = node_at(target session)
    if read isnt? hir.ExpressedIdentifier|hir.MemberAccess return pending(id 'compound indexed assignment' env session)
    let path = bindings.access_path(target session.hir)
    let root = node_at(path.root session)
    if root isnt? hir.ExpressedIdentifier or root.binding_id is? none return problem(id 'assignment needs named storage' 'the target is temporary' env session)
    let binding = bindings.binding_at(session.registry root.binding_id)
    if binding.read_only_reason isnt? none return problem(id 'cannot assign to a constant' binding.name env session)
    loop step in path.steps {
        let field = node_at(step session)
        if field is? hir.MemberAccess and not field.mutable return problem(id 'cannot assign to an immutable field' field.name env session)
    }
    let required = read.value_type
    if read is? hir.ExpressedIdentifier and binding.store_type isnt? none { required = binding.store_type }
    let right = expression(node.right env @session expected=read.value_type)
    if right is? Error return right
    let func = identifier(name id env @session)
    if func is? Error return func
    let result = call(func [target right] [] id env @session expected=read.value_type)
    if result is? Error return result
    result = against(result required id env @session)
    if result is? Error return result
    if read is? hir.MemberAccess return put(hir.MemberAssign[node.loc types.primitive('void' @session.types) target result] @session)
    set_read_type(binding.id node_at(result session).value_type env @session)
    # Keep the selected operation, including any conversions, on the RHS.
    # Lowering need not redispatch a source compound operator independently.
    return put(hir.Assign[node.loc types.primitive('void' @session.types) target '=' result] @session)
}

from reporting import SrcFile, Error, Pointer, Warning
import p"modules.dewy" as modules
import p"context.dewy" as contexts
import p"source_views.dewy" as sources
import p"hir.dewy" as hir
import p"unsafe_audit.dewy" as unsafe_audit
import p"ty.dewy" as types
import p"../targets.dewy" as targets
import p"analyze/value_bounds.dewy" as values
import p"analyze/fact_state.dewy" as facts
import p"analyze/representation.dewy" as representation
import p"runtime_reports.dewy" as runtime_reports
import p"validation_state.dewy" as proofs
import p"validation_analysis.dewy" as analysis
import p"analyze/prototype_checks.dewy" as prototype

# Bounds validation precedes representation selection. Library foundations
# cannot fall back to the BigInt helpers they are themselves defining.
# Keep this boundary separate from loading: a checked graph still contains
# proof obligations and mathematical integers with no chosen storage.
Result:type = [warnings:array<Warning>=[] notes:array<representation.Note>=[] unsafe:array<unsafe_audit.Entry>=[]]

# Rewrite proof witnesses only after their module has passed validation.
# Runtime assertions already have their reporting/control flow in HIR; the
# Assert node is the analysis witness alongside that actual runtime code.
discharge = (root:addr constants:dict<addr bigint> @session:contexts.Session):>void => {
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    let void_type=types.primitive('void' @session.types)
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=hir.node_at(session.hir id)
        hir.push_children(node @pending)
        if node is? hir.Obligation {
            $runtime_assert id <? session.hir.length
            session.hir[id]=hir.Block[node.loc node.value_type [node.value] false]
        } else if node is? hir.Assert {
            $runtime_assert id <? session.hir.length
            session.hir[id]=hir.Void[node.loc void_type]
        } else if node is? hir.Index|hir.StringIndex {
            let constant=constants.get(id)
            if constant isnt? none and constant >=? 0 and constant <=? targets.max_length(session.target) {
                if node is? hir.Index {node.constant_index=constant as addr}
                else {node.constant_index=constant as addr}
                $runtime_assert id <? session.hir.length
                session.hir[id]=node
            }
        }
    }
}
# A validation result retains only decisions that must survive into rewriting.
# Checker contexts, predicate snapshots, and branch facts die with the module.
Decision:type = proofs.Decision
validate_module = (module:modules.Module source_files:array<SrcFile> env:values.Environment prepared:facts.Context word:addr engine:modules.Engine):>Decision|Error => {
    return analysis.validate_module(module source_files env prepared word engine.prelude_bindings engine.session)
}
# All modules read the same immutable graph. Representation selection and
# proof discharge happen after this scope returns, so no analysis can observe
# a partly rewritten graph and no old snapshot survives the first write.
analyze_modules = (word:addr engine:modules.Engine):>array<Decision>|Error => {
    return analysis.analyze(word engine.modules engine.prelude_bindings engine.session saved=engine.prelude_validation)
}
validate = (@engine:modules.Engine):>Result|Error => {
    let word=types.primitive('int64' @engine.session.types)
    let decisions=analyze_modules(word engine)
    if decisions is? Error return decisions
    let result=Result[]
    let loaded=engine.modules
    $runtime_assert decisions.length =? loaded.length
    loop index in 0.. and index <? loaded.length {
        let module=loaded[index]
        let checked=decisions[index]
        loop entry in unsafe_audit.collect(module.root sources.srcfile(module.context engine.session) engine.session) {result.unsafe.push(entry)}
        loop warning in checked.warnings {result.warnings.push(warning)}
        if checked.deferred.length >? 0 {
            # `$prototype`: each unproven site becomes a runtime check that
            # panics with the deferred report; one with no safe check stays
            # a compile error. The edits go into the session's graph.
            let unhandled=prototype.insert(checked.deferred module.context.source @engine.session)
            if unhandled.length >? 0 return unhandled[0]
            if module.options.prototype_warnings {
                loop [id site] in checked.deferred {
                    let report=site.report
                    let notes=report.notes
                    notes.push('deferred to a runtime check by `$prototype`')
                    result.warnings.push(Warning[srcfile=report.srcfile title="prototype: {report.title}" pointers=report.pointers notes=notes hint=report.hint])
                }
            }
        }
        let strict=module.prelude or module.no_prelude or 'BigInt' not in? engine.prelude_bindings
        if not strict {
            let source=sources.srcfile(module.context engine.session)
            let selected=representation.select(module.root source engine.prelude_bindings checked.unfit @engine.session)
            if selected is? Error return selected
            loop note in selected {result.notes.push(note)}
        }
        discharge(module.root checked.constants @engine.session)
    }
    # Install diagnostic helper calls after all user proof obligations have
    # been decided. Graph assembly can then retain the reachable reporters.
    loop module in loaded {
        let error=runtime_reports.lower(module.root engine.prelude_bindings @engine.session)
        if error isnt? none return error
    }
    return result
}

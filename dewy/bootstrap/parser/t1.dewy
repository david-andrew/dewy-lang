from reporting import SrcFile, Span, Pointer
import p"t0.dewy" as raw
import p"cli.dewy" as cli
doc"""
Compound tokenization. The token shapes follow hosted t1; child lists hold
indices into a token arena so later rewriting passes can share subtrees under
Dewy's value semantics. A token is complete before its index is published.
See ../DESIGN_NOTES.md for pending literal and syntax decisions.
"""


TokenError:type = raw.TokenError
BasePrefix:type = raw.BasePrefix
# Symbols split into operators and symbolic identifiers here; words split into
# identifiers, keywords, word operators, and booleans. Whitespace survives this
# stage because t2 needs to distinguish adjacency from separated expressions.
Token = $abstract type of any & [loc:Span kind:string]
Identifier = type of Token & [kind='Identifier' name:string]
Keyword = type of Token & [kind='Keyword' name:string]
Metatag = type of Token & [kind='Metatag' name:string]
Operator = type of Token & [kind='Operator' symbol:string]
Whitespace = type of Token & [kind='Whitespace']
Semicolon = type of Token & [kind='Semicolon']
Bool = type of Token & [kind='Bool' value:bool]
Integer = type of Token & [kind='Integer' value:raw.Number]
# Keep spelling/base information until a typed context chooses representation.
# The exponent's sign is separate from its digits; p/P means a power of two.
Exponent:type = [value:raw.Number positive:bool=true binary:bool=false]
Real = type of Token & [kind='Real' whole:raw.Number fraction:raw.Number? exponent:Exponent?]
# A string with only characters and ordinary escapes is already fully decoded.
# Interpolations and braced Unicode escapes need expression evaluation, so an
# IString instead holds alternating chunks and expression containers.
String = type of Token & [kind='String' content:string]
StringChunk = type of Token & [kind='StringChunk' content:string]
IString = type of Token & [kind='IString' content:array<addr>]
Block = type of Token & [kind='Block' inner:array<addr> delims:string base:BasePrefix?=none]
ParametricEscape = type of Token & [kind='ParametricEscape' inner:array<addr>]
BasedString = type of Token & [kind='BasedString' digits:array<raw.BasedStringChars> base:BasePrefix]
TokenStream:type = [nodes:array<Token> roots:array<addr>]

# TODO: hosted comments describe case-insensitive keywords/bools, but its
# classifier currently matches these spellings exactly. Preserve that behavior
# until the discrepancy is resolved rather than silently changing the language.
const keywords = set['loop' 'if' 'else' 'match' 'return' 'yield' 'break' 'continue' 'import' 'from' 'let' 'const' 'local_const' 'overload_only']
# extern/intrinsic/none/void/untyped/end/new remain ordinary identifiers.
const symbolic_identifiers = set['..' '...' '$' '∞' '∅']
const word_operators = set['and' 'or' 'xor' 'nand' 'nor' 'xnor' 'not' 'as' 'in' 'transmute' 'of' 'or_throw']
const escape_map:dict<string string> = ['n'->'\n' '\n'->'' '\r\n'->'' 'r'->'\r' 't'->'\t' 'v'->'\v' 'f'->'\f' 'b'->'\b' 'a'->'\a' '0'->'\0']

append_node = (@nodes:array<Token> token:Token):>addr<i => i <? nodes.length> => {
    let id = nodes.length
    nodes.push(token)
    return id
}
node_at = (nodes:array<Token> id:addr):>Token => {
    $runtime_assert id <? nodes.length
    return nodes[id]
}

lexical_error = (srcfile:SrcFile loc:Span title:string):>TokenError => TokenError[
    srcfile=srcfile title=title pointers=[Pointer[span=loc message=title]]
]

# Decode only escapes whose value is known during parsing. Braced Unicode
# escapes remain expression nodes, and byte escapes remain the hosted placeholder.
escape_text = (token:raw.StringEscape srcfile:SrcFile):>string | TokenError => {
    let text = raw.token_text(token)
    if text.length <? 2 return lexical_error(srcfile token.loc "Incomplete string escape")
    let code = text[1..]
    if code in? escape_map return escape_map[code]
    if text[1] is? 'u' | 'U' {
        let alphabet = raw.BASE_SPECS['0x'].alphabet
        let value:uint32 = 0
        loop i in 2.. and i <? text.length {
            let c = text[i].casefold
            let digit:uint32 = 0
            loop j in 0.. and j <? alphabet.length {
                if alphabet[j] =? c { digit = j as uint32 }
            }
            value = value*16+digit
        }
        if value >=? 0x110000 or 0xD800 <=? value <=? 0xDFFF return lexical_error(srcfile token.loc "Unicode escape is not a scalar value")
        return chr(value)
    }
    return text[1..]
}

RealMatch:type = [count:addr value:Real]
# Recognize whole[.fraction][eEpP[+-]power], requiring a fraction or exponent.
# Each number retains its own base: 0x1.0x8p10 is valid, whereas the text after
# the dot in 0x1.fp-2 is an identifier, not a prefixed hexadecimal number.
# TODO: hosted design suggests warnings for mixed mantissa bases and p/P on
# non-power-of-two bases. Parsing currently preserves these for later analysis.
# nan/inf remain identifiers whose representation depends on their typed use.
probe_real = (tokens:array<raw.Token> start:addr stop:addr):>RealMatch? => {
    if start >=? stop or stop >? tokens.length return none
    let whole = tokens[start]
    if whole isnt? raw.Number return none
    let i:addr = start+1
    let fraction:raw.Number? = none
    if i+1 <? stop {
        let dot = tokens[i]
        let digits = tokens[i+1]
        if dot is? raw.Symbol and raw.token_text(dot) =? '.' and digits is? raw.Number {
            fraction = digits
            i += 2
        }
    }
    let exponent:Exponent? = none
    if i <? stop {
        let marker = tokens[i]
        let spelling = raw.token_text(marker)
        if marker is? raw.ExponentMarker {
            exponent = Exponent[value=marker.power binary=spelling.startswith('p') or spelling.startswith('P')]
            i += 1
        }
        else if marker is? raw.Identifier and spelling in? set['e' 'E' 'p' 'P'] {
            let next:addr = i+1
            let positive:bool = true
            if next <? stop {
                let sign = tokens[next]
                if sign is? raw.Symbol and raw.token_text(sign) in? set['+' '-'] {
                    positive = raw.token_text(sign) =? '+'
                    next += 1
                }
            }
            if next <? stop {
                let power = tokens[next]
                if power is? raw.Number {
                    exponent = Exponent[value=power positive=positive binary=spelling in? set['p' 'P']]
                    i = next+1
                }
            }
        }
    }
    if fraction is? none and exponent is? none return none
    if i <=? start or i >? tokens.length return none
    return RealMatch[count=i-start value=Real[loc=Span[whole.loc.start tokens[i-1].loc.stop] whole=whole fraction=fraction exponent=exponent]]
}

StringOpeners:type = raw.StringQuoteOpener | raw.RawStringQuoteOpener | raw.TemplateStringQuoteOpener | raw.HeredocStringOpener | raw.RawHeredocStringOpener | raw.TemplateHeredocStringOpener | raw.RestOfFileStringQuote | raw.RawRestOfFileStringQuote | raw.TemplateRestOfFileStringQuote
BlockOpeners:type = raw.LeftSquareBracket | raw.LeftParenthesis | raw.LeftCurlyBrace | raw.LeftAngleBracket | raw.BasedBlockOpener

# The arena is append-only. A recursive call completes its children before
# the parent is appended; there are no cyclic token references to initialize.
compound_range = (tokens:array<raw.Token> partners:dict<addr addr> start:addr stop:addr srcfile:SrcFile @nodes:array<Token>):>array<addr> | TokenError => {
    if start >? stop or stop >? tokens.length return lexical_error(srcfile Span[0 0] "Invalid token range")
    let output:array<addr> = []
    let i:addr = start
    loop i <? stop {
        let token = tokens[i]
        let loc = token.loc
        let text = raw.token_text(token)
        # Comments separate tokens just like whitespace. Coalesce each run so
        # comment spelling does not affect the later juxtaposition decisions.
        if token is? raw.Whitespace | raw.LineComment | raw.BlockComment {
            let limit:addr = i+1
            loop limit <? stop {
                let following = tokens[limit]
                if following isnt? raw.Whitespace | raw.LineComment | raw.BlockComment break
                limit += 1
            }
            output.push(append_node(@nodes Whitespace[loc=Span[loc.start tokens[limit-1].loc.stop]]))
            i = limit
            continue
        }
        if token is? raw.Number {
            let real = probe_real(tokens i stop)
            if real isnt? none {
                output.push(append_node(@nodes real.value))
                i += real.count
                continue
            }
            output.push(append_node(@nodes Integer[loc=loc value=token]))
        }
        else if token is? StringOpeners {
            # An EOF string has no closing token. Its exclusive boundary is
            # stop itself, so its final content token must still be consumed.
            let eof = token is? raw.RestOfFileStringQuote | raw.RawRestOfFileStringQuote | raw.TemplateRestOfFileStringQuote
            let close:addr = stop
            let after:addr = stop
            let limit:addr = srcfile.body.length
            if not eof {
                let partner = partners.get(i)
                if partner is? none return lexical_error(srcfile loc "Missing string closing quote")
                close = partner
                if close >=? stop return lexical_error(srcfile loc "String closer outside token range")
                after = close+1
                limit = tokens[close].loc.stop
            }
            let chunks:array<addr> = []
            let plain:string = ""
            let interpolated:bool = false
            let j:addr = i+1
            loop j <? close and j <? tokens.length {
                let part = tokens[j]
                if part is? raw.StringChars | raw.RawStringChars { plain += raw.token_text(part) }
                else if part is? raw.StringEscape {
                    let decoded = escape_text(part srcfile)
                    if decoded is? TokenError return decoded
                    plain += decoded
                }
                else if part is? raw.ParametricStringEscape | raw.LeftCurlyBrace | raw.TemplateLeftCurlyBrace {
                    let closing = partners.get(j)
                    if closing is? none return lexical_error(srcfile part.loc "Missing interpolation closing brace")
                    if closing >=? close or closing >=? tokens.length return lexical_error(srcfile part.loc "Invalid interpolation boundary")
                    if part isnt? raw.ParametricStringEscape and closing =? j+1 return lexical_error(srcfile part.loc "Empty interpolation block")
                    if plain.length >? 0 {
                        chunks.push(append_node(@nodes StringChunk[loc=part.loc content=plain]))
                        plain = ""
                    }
                    let inner = compound_range(tokens partners j+1 closing srcfile @nodes)
                    if inner is? TokenError return inner
                    let span = Span[part.loc.start tokens[closing].loc.stop]
                    if part is? raw.ParametricStringEscape {
                        chunks.push(append_node(@nodes ParametricEscape[loc=span inner=inner]))
                    }
                    else { chunks.push(append_node(@nodes Block[loc=span inner=inner delims='\{\}'])) }
                    interpolated = true
                    j = closing+1
                    continue
                }
                else { return lexical_error(srcfile part.loc "Invalid token in string body") }
                j += 1
            }
            let span = Span[loc.start limit]
            if interpolated {
                if plain.length >? 0 { chunks.push(append_node(@nodes StringChunk[loc=span content=plain])) }
                output.push(append_node(@nodes IString[loc=span content=chunks]))
            }
            else { output.push(append_node(@nodes String[loc=span content=plain])) }
            i = after
            continue
        }
        else if token is? BlockOpeners | raw.BasedStringQuoteOpener {
            # t0 has already paired nested delimiters and tracked inherited
            # numeric bases. Keep explicit based-block metadata for semantics;
            # based-string digits are packed only once their value type is known.
            let close = partners.get(i)
            if close is? none return lexical_error(srcfile loc "Missing closing delimiter")
            if close >=? stop return lexical_error(srcfile loc "Closing delimiter outside token range")
            let span = Span[loc.start tokens[close].loc.stop]
            if token is? raw.BasedStringQuoteOpener {
                let digits:array<raw.BasedStringChars> = []
                let j:addr = i+1
                loop j <? close {
                    let part = tokens[j]
                    if part is? raw.BasedStringChars { digits.push(part) }
                    j += 1
                }
                output.push(append_node(@nodes BasedString[loc=span digits=digits base=token.base]))
            }
            else {
                let inner = compound_range(tokens partners i+1 close srcfile @nodes)
                if inner is? TokenError return inner
                let base:BasePrefix? = none
                if token is? raw.BasedBlockOpener { base = token.base }
                if text.length =? 0 return lexical_error(srcfile loc "Empty block opener")
                let delims = text[text.length-1]+raw.token_text(tokens[close])
                output.push(append_node(@nodes Block[loc=span inner=inner delims=delims base=base]))
            }
            i = close+1
            continue
        }
        else if token is? raw.Identifier {
            if text in? keywords { output.push(append_node(@nodes Keyword[loc=loc name=text])) }
            else if text in? word_operators { output.push(append_node(@nodes Operator[loc=loc symbol=text])) }
            else if text =? 'true' or text =? 'false' { output.push(append_node(@nodes Bool[loc=loc value=(text =? 'true')])) }
            else { output.push(append_node(@nodes Identifier[loc=loc name=text])) }
        }
        else if token is? raw.Symbol | raw.ShiftSymbol {
            if text =? ';' { output.push(append_node(@nodes Semicolon[loc=loc])) }
            else if text in? symbolic_identifiers { output.push(append_node(@nodes Identifier[loc=loc name=text])) }
            else { output.push(append_node(@nodes Operator[loc=loc symbol=text])) }
        }
        else if token is? raw.Metatag {
            output.push(append_node(@nodes Metatag[loc=loc name=(if text.length >? 1 text[1..] else '')]))
        }
        else { return lexical_error(srcfile loc "No compound token found") }
        i += 1
    }
    return output
}

tokenize = (srcfile:SrcFile):>TokenStream | TokenError => {
    let lexical = raw.tokenize(srcfile)
    if lexical is? TokenError return lexical
    let partners:dict<addr addr> = []
    loop pair in lexical.pairs { partners[pair.opening] = pair.closing }
    let nodes:array<Token> = []
    let roots = compound_range(lexical.tokens partners 0 lexical.tokens.length srcfile @nodes)
    if roots is? TokenError return roots
    return TokenStream[nodes roots]
}

# Stable, source-located tree output shared by the command line and parity
# tests. String payloads use Dewy's escaped literal spelling.
number_text = (number:raw.Number):>string => "{number.prefix}:{raw.token_text(number)}"
token_payload = (node:Token):>string => {
    if node is? Identifier | Keyword | Metatag return node.name
    if node is? Operator return node.symbol
    if node is? String | StringChunk return node.content
    if node is? Bool return if node.value 'true' else 'false'
    if node is? Integer return number_text(node.value)
    if node is? Real {
        let parts:array<string> = [number_text(node.whole)]
        let fraction = node.fraction
        let exponent = node.exponent
        parts.push(if fraction is? none '' else number_text(fraction))
        if exponent is? none { parts.push('') }
        else { parts.push("{if exponent.positive '+' else '-'}{if exponent.binary 'p' else 'e'}{number_text(exponent.value)}") }
        return parts.join('|')
    }
    if node is? Block return "{node.delims}:{if node.base is? none '' else node.base}"
    if node is? BasedString {
        let pieces:array<string> = []
        loop digit in node.digits { pieces.push(raw.token_text(digit)) }
        return "{node.base}:{pieces.join('|')}"
    }
    return ''
}
dump_tree = (nodes:array<Token> roots:array<addr> depth:addr):>void => {
    loop id in roots {
        let node = node_at(nodes id)
        printl"{depth}\t{node.kind}\t{node.loc.start}\t{node.loc.stop}\t{_quoted(token_payload(node))}"
        if node is? Block | ParametricEscape { dump_tree(nodes node.inner depth+1) }
        else if node is? IString { dump_tree(nodes node.content depth+1) }
    }
}
let run = (input:cli.Input):>int64 => {
    let result = tokenize(input.srcfile)
    if result is? TokenError { result.fail }
    if input.dump { dump_tree(result.nodes result.roots 0) }
    else {
        let pointers:array<Pointer> = []
        loop id in result.roots {
            let node = node_at(result.nodes id)
            if node is? Whitespace continue
            pointers.push(Pointer[span=node.loc message="{node.kind} {_quoted(token_payload(node))}"])
        }
        cli.show_tokens(input.srcfile pointers 't1')
    }
    return 0
}
main = (argv:array<string>):>int64 => {
    let input = cli.read_input(argv 't1')
    if input isnt? cli.Input { input.fail }
    if input.stage not=? 't1' { printl"Use parser.dewy to select another stage" return 1 }
    return run(input)
}

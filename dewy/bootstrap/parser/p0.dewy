from reporting import SrcFile, Span, Pointer, Warning
import p"t1.dewy" as compound
import p"t2.dewy" as post
import p"cli.dewy" as cli
doc"""
Initial parsing by binding-power reductions, preserving ambiguous
juxtaposition alternatives until semantic analysis. AST children and
operators use the same append-only arena as the preceding token stages.
Unlike hosted ProtoAST, every intermediate item has an explicit nominal
AST/token distinction. The hosted pending design notes are retained in
../DESIGN_NOTES.md, including operator chains and backtick preference.
"""
AST = $abstract type of compound.Token
# Leaf tokens keep their literal/source metadata inside Atom. Containers get
# their own AST variants rather than placing AST children into token fields.
Atom = type of AST & [kind='Atom' item:addr]
BinOp = type of AST & [kind='BinOp' op:addr left:addr right:addr]
Prefix = type of AST & [kind='Prefix' op:addr item:addr]
Postfix = type of AST & [kind='Postfix' op:addr item:addr]
Flat = type of AST & [kind='Flat' op:addr items:array<addr>]
# These alternatives are equally viable syntactically; their order is not a
# preference. Typechecking must test them and diagnose any remaining ambiguity.
Ambiguous = type of AST & [kind='Ambiguous' candidates:array<addr>]
Block = type of AST & [kind='Block' inner:array<addr> delims:string base:compound.BasePrefix?=none]
ParametricEscape = type of AST & [kind='ParametricEscape' inner:array<addr>]
IString = type of AST & [kind='IString' content:array<addr>]
KeywordExpr = type of AST & [kind='KeywordExpr' parts:array<addr>]
Flow = type of AST & [kind='Flow' arms:array<addr> default:addr?=none]
Directive = type of AST & [kind='AssertDirective' name:string condition:addr?=none message:addr?=none]
Program:type = [nodes:array<compound.Token> root:addr]
Associativity:type = 'left' | 'right' | 'prefix' | 'postfix' | 'flat' | 'fail'
PrecedenceRow:type = const [assoc:Associativity operators:set<string>]
# Highest precedence first; this is the hosted table, including its reserved
# `has` entry. `??` and `<=>` have tokens but no assigned precedence yet.
const precedence_rows:array<PrecedenceRow> = [
    [assoc="prefix" operators=set["@"]]
    [assoc="left" operators=set["." "CallJuxtapose" "IndexJuxtapose"]]
    [assoc="fail" operators=set["TypeParamJuxtapose"]]
    [assoc="fail" operators=set["EllipsisJuxtapose"]]
    [assoc="postfix" operators=set["`"]]
    [assoc="prefix" operators=set["`"]]
    [assoc="prefix" operators=set["~"]]
    [assoc="postfix" operators=set["?"]]
    [assoc="right" operators=set["^"]]
    [assoc="left" operators=set["MultiplyJuxtapose"]]
    [assoc="left" operators=set["*" "/" "//" "%" "\\"]]
    [assoc="prefix" operators=set["+" "-"]]
    [assoc="left" operators=set["+" "-"]]
    [assoc="left" operators=set["<<" ">>" "<<<" ">>>" "<<!" "!>>"]]
    [assoc="flat" operators=set[","]]
    [assoc="flat" operators=set["RangeJuxtapose"]]
    [assoc="fail" operators=set["in"]]
    [assoc="prefix" operators=set["type of"]]
    [assoc="left" operators=set["&"]]
    [assoc="left" operators=set["|"]]
    [assoc="left" operators=set["=?" ">?" "<?" ">=?" "<=?" "is?" "isnt?" "in?"]]
    [assoc="prefix" operators=set["not"]]
    [assoc="left" operators=set["and" "nand"]]
    [assoc="left" operators=set["xor" "xnor"]]
    [assoc="left" operators=set["or" "nor"]]
    [assoc="left" operators=set["as" "transmute"]]
    [assoc="postfix" operators=set["or_throw"]]
    [assoc="fail" operators=set["of" "has"]]
    [assoc="fail" operators=set[":"]]
    [assoc="left" operators=set[":>"]]
    [assoc="right" operators=set["=>"]]
    [assoc="left" operators=set["|>"]]
    [assoc="right" operators=set["<|"]]
    [assoc="fail" operators=set["->" "<->"]]
    [assoc="fail" operators=set["=" "::" ":=" "CombinedAssignmentOp"]]
    [assoc="left" operators=set["SemicolonJuxtapose"]]
]
Power:type = [left:array<int64> right:array<int64> assocs:array<Associativity>]
Rank:type = [op:addr side:int8 power:int64]
Shift:type = [direction:int8 left:addr?=none right:addr?=none]
Work:type = [items:array<addr> shifts:array<int8>]

operator_label = (node:compound.Token nodes:array<compound.Token>):>string => {
    if node is? compound.Operator | post.InvertedComparison return node.symbol
    if node is? post.CombinedAssignment return 'CombinedAssignmentOp'
    if node is? post.Broadcast return operator_label(compound.node_at(nodes node.op) nodes)
    if node is? post.Juxtapose return node.options.join('|')
    return node.kind
}
operator_equal = (a:compound.Token b:compound.Token nodes:array<compound.Token>):>bool => {
    if a.kind not=? b.kind return false
    if a is? post.Broadcast and b is? post.Broadcast return operator_equal(compound.node_at(nodes a.op) compound.node_at(nodes b.op) nodes)
    if a is? post.CombinedAssignment and b is? post.CombinedAssignment return operator_equal(compound.node_at(nodes a.op) compound.node_at(nodes b.op) nodes)
    return operator_label(a nodes) =? operator_label(b nodes)
}
powers = (op:compound.Token nodes:array<compound.Token>):>Power => {
    let labels:array<string> = []
    labels.push(operator_label(op nodes))
    if op is? post.Juxtapose { labels = op.options }
    let left:array<int64> = []
    let right:array<int64> = []
    let assocs:array<Associativity> = []
    loop label in labels {
        loop i in 0.. and i <? precedence_rows.length {
            let row = precedence_rows[i]
            if label not in? row.operators continue
            let power:int64 = 1+2*(precedence_rows.length-i-1)
            let l:int64 = power
            let r:int64 = power
            if row.assoc =? 'left' { r += 1 }
            else if row.assoc =? 'prefix' { l = -1 }
            else if row.assoc =? 'postfix' { r = -1 }
            else { l += 1 }
            if l >=? 0 and l not in? left { left.push(l) }
            if r >=? 0 and r not in? right { right.push(r) }
            if row.assoc not in? assocs { assocs.push(row.assoc) }
        }
    }
    if left.length =? 0 { left.push(-1) }
    if right.length =? 0 { right.push(-1) }
    return Power[left right assocs]
}
strictly_greater = (a:array<int64> b:array<int64>):>bool => {
    loop x in a { loop y in b { if x <=? y return false } }
    return true
}
operator_options = (id:addr @nodes:array<compound.Token>):>array<addr> => {
    let op = compound.node_at(nodes id)
    if op isnt? post.Juxtapose return [id]
    let result:array<addr> = []
    loop option in op.options { result.push(compound.append_node(@nodes post.Juxtapose[loc=op.loc options=[option]])) }
    return result
}
combine_options = (ids:array<addr> @nodes:array<compound.Token>):>addr => {
    $runtime_assert ids.length >? 0
    if ids.length =? 1 return ids[0]
    let first = compound.node_at(nodes ids[0])
    let options:array<string> = []
    loop id in ids {
        let op = compound.node_at(nodes id)
        if op is? post.Juxtapose { loop option in op.options { if option not in? options { options.push(option) } } }
    }
    return compound.append_node(@nodes post.Juxtapose[loc=first.loc options=options])
}

# Only branch when the two sides compete. Operators that bind on the same
# side together remain a QJuxtapose, as in hosted p0's ShiftMeta groups.
shift_options = (items:array<addr> position:addr @nodes:array<compound.Token>):>array<Shift> => {
    $runtime_assert position <? items.length
    let node = compound.node_at(nodes items[position])
    let left:addr? = none
    let right:addr? = none
    if position >? 0 {
        let candidate = compound.node_at(nodes items[position-1])
        if candidate isnt? AST { left = items[position-1] }
    }
    if position+1 <? items.length {
        let candidate = compound.node_at(nodes items[position+1])
        if candidate isnt? AST { right = items[position+1] }
    }
    if node is? Atom and compound.node_at(nodes node.item) is? compound.Semicolon {
        if left is? none return [Shift[0]]
        if not post.is_jux(compound.node_at(nodes left) 'SemicolonJuxtapose') return [Shift[0]]
    }
    let l:array<int64> = if left is? none [-1] else powers(compound.node_at(nodes left) nodes).right
    let r:array<int64> = if right is? none [-1] else powers(compound.node_at(nodes right) nodes).left
    if strictly_greater(l r) return [Shift[-1]]
    if strictly_greater(r l) return [Shift[1]]
    if left is? none or right is? none return [Shift[0]]
    let ranks:array<Rank> = []
    let left_options = operator_options(left @nodes)
    let right_options = operator_options(right @nodes)
    loop id in left_options {
        let p = powers(compound.node_at(nodes id) nodes)
        loop bp in p.right { ranks.push(Rank[id (-1) bp]) }
    }
    loop id in right_options {
        let p = powers(compound.node_at(nodes id) nodes)
        loop bp in p.left { ranks.push(Rank[id 1 bp]) }
    }
    ranks.sort(key=(.power) reverse=true)
    let result:array<Shift> = []
    let i:addr = 0
    loop i <? ranks.length {
        let leader = ranks[i]
        let superior:array<addr> = []
        loop i <? ranks.length and ranks[i].side =? leader.side { superior.push(ranks[i].op) i += 1 }
        let subordinate:array<addr> = []
        let j:addr = i
        loop j <? ranks.length {
            let follower = ranks[j]
            if follower.side not=? leader.side and follower.power <? leader.power { subordinate.push(follower.op) }
            j += 1
        }
        if subordinate.length =? 0 continue
        let higher = combine_options(superior @nodes)
        let lower = combine_options(subordinate @nodes)
        result.push(Shift[direction=leader.side left=(if leader.side =? -1 higher else lower) right=(if leader.side =? 1 higher else lower)])
    }
    return result
}
# Decide whether an operator can have a left operand through intervening
# postfix operators. A prefix-only operator or an expression separator blocks
# that route. Hosted p0 uses this to prefer postfix backtick when both roles
# fit; TODO: that preference is built into the algorithm, not just the table.
can_attach_left = (items:array<addr> position:addr nodes:array<compound.Token>):>bool => {
    let i:addr = position
    loop i >? 0 {
        i -= 1
        $runtime_assert i <? items.length
        let node = compound.node_at(nodes items[i])
        if node is? AST {
            if node is? Atom and compound.node_at(nodes node.item) is? compound.Semicolon return false
            return true
        }
        if post.is_binary(node nodes) return false
        let prefix = post.is_prefix(node nodes)
        let postfix = post.is_postfix(node nodes)
        if prefix and not postfix return false
        if postfix and not prefix return true
        if not prefix and not postfix return false
    }
    return false
}

# An operand's shift points at the neighboring operator that wins it. Reduce
# only operators whose required operands point inward. Flat operators consume
# a whole connected run; nonassociative ones diagnose nested uses instead of
# arbitrarily choosing a tree. Repeating the pass leaves one expression.
reduce_work = (work:Work srcfile:SrcFile @nodes:array<compound.Token>):>array<addr> | compound.TokenError => {
    let items = work.items
    let shifts = work.shifts
    $runtime_assert shifts.length =? items.length
    let output:array<addr> = []
    let i:addr = 0
    loop i <? items.length {
        let node = compound.node_at(nodes items[i])
        if node is? AST { output.push(items[i]) i += 1 continue }
        let p = powers(node nodes)
        if p.assocs.length =? 0 return compound.lexical_error(srcfile node.loc "No precedence is defined for `{operator_label(node nodes)}`")
        let left:addr? = none
        let right:addr? = none
        if i >? 0 and shifts[i-1] =? 1 { left = items[i-1] }
        if i+1 <? items.length and shifts[i+1] =? -1 { right = items[i+1] }
        let binary:bool = left isnt? none and right isnt? none and ('left' in? p.assocs or 'right' in? p.assocs or 'flat' in? p.assocs or 'fail' in? p.assocs)
        if binary {
            $runtime_assert i >? 0 and i+1 <? items.length
            $runtime_assert left isnt? none and right isnt? none
            let lhs = compound.node_at(nodes left)
            let rhs = compound.node_at(nodes right)
            let loc = Span[lhs.loc.start rhs.loc.stop]
            let id:addr = 0
            if 'flat' in? p.assocs {
                # Consume the entire connected flat run only when its outer
                # operands both point inward. Comma voids supply missing ends.
                let first:addr = i-1
                let last:addr = i+1
                loop first >=? 2 {
                    let prev = compound.node_at(nodes items[first-1])
                    if prev is? AST or not operator_equal(prev node nodes) break
                    first -= 2
                }
                loop last+2 <? items.length {
                    let next = compound.node_at(nodes items[last+1])
                    if next is? AST or not operator_equal(next node nodes) break
                    last += 2
                }
                if shifts[first] not=? 1 or shifts[last] not=? -1 { output.push(items[i]) i += 1 continue }
                # A right-associative flat run's ready operator is the last
                # one. Remove its already copied prefix before replacing it.
                let remove = i-first
                $runtime_assert remove <=? output.length
                output.truncate(output.length-remove)
                let children:array<addr> = []
                let j:addr = first
                let dots:addr = 0
                loop j <=? last {
                    $runtime_assert j <? items.length
                    let child = compound.node_at(nodes items[j])
                    if child isnt? AST return compound.lexical_error(srcfile node.loc 'Incomplete flat expression')
                    if child is? Atom and post.is_identifier(compound.node_at(nodes child.item) '..') { dots += 1 }
                    children.push(items[j])
                    j += 2
                }
                if post.is_jux(node 'RangeJuxtapose') and dots >? 1 return compound.lexical_error(srcfile node.loc 'Multiple `..` tokens encountered in single range expression')
                let first_node = compound.node_at(nodes items[first])
                let last_node = compound.node_at(nodes items[last])
                id = compound.append_node(@nodes Flat[loc=Span[first_node.loc.start last_node.loc.stop] op=items[i] items=children])
                i = last+1
            }
            else {
                if 'fail' in? p.assocs {
                    if lhs is? BinOp and operator_equal(compound.node_at(nodes lhs.op) node nodes) return compound.lexical_error(srcfile node.loc 'Non-associative operator nesting')
                    if rhs is? BinOp and operator_equal(compound.node_at(nodes rhs.op) node nodes) return compound.lexical_error(srcfile node.loc 'Non-associative operator nesting')
                }
                $runtime_assert output.length >? 0
                output.pop;
                id = compound.append_node(@nodes BinOp[loc=loc op=items[i] left=left right=right])
                i += 2
            }
            output.push(id)
            continue
        }
        if left isnt? none and 'postfix' in? p.assocs {
            let lhs = compound.node_at(nodes left)
            $runtime_assert output.length >? 0
            output.pop;
            output.push(compound.append_node(@nodes Postfix[loc=Span[lhs.loc.start node.loc.stop] op=items[i] item=left]))
            i += 1
            continue
        }
        if right isnt? none and 'prefix' in? p.assocs and not can_attach_left(items i nodes) {
            let rhs = compound.node_at(nodes right)
            output.push(compound.append_node(@nodes Prefix[loc=Span[node.loc.start rhs.loc.stop] op=items[i] item=right]))
            i += 2
            continue
        }
        output.push(items[i])
        i += 1
    }
    return output
}

reduce_chain = (initial:array<addr> srcfile:SrcFile @nodes:array<compound.Token>):>addr | compound.TokenError => {
    let alternatives:array<Work> = []
    alternatives.push(Work[initial []])
    loop true {
        let progress:bool = false
        let following:array<Work> = []
        loop alternative in alternatives {
            let zeros:array<int8> = [loop item in alternative.items 0 as int8]
            let branches:array<Work> = []
            branches.push(Work[alternative.items zeros])
            loop position in 0.. and position <? alternative.items.length {
                let node = compound.node_at(nodes alternative.items[position])
                if node isnt? AST continue
                let options = shift_options(alternative.items position @nodes)
                if options.length =? 0 return compound.lexical_error(srcfile node.loc 'Unresolved operator binding powers')
                let expanded:array<Work> = []
                loop option in options {
                    loop branch in branches {
                        let items = branch.items
                        let shifts = branch.shifts
                        $runtime_assert position <? shifts.length
                        shifts[position] = option.direction
                        let left = option.left
                        let right = option.right
                        if left isnt? none {
                            $runtime_assert position >? 0 and position-1 <? items.length
                            items[position-1] = left
                        }
                        if right isnt? none {
                            $runtime_assert position+1 <? items.length
                            items[position+1] = right
                        }
                        expanded.push(Work[items shifts])
                    }
                }
                branches = expanded
            }
            if branches.length >? 1 { progress = true }
            loop branch in branches {
                let reduced = reduce_work(branch srcfile @nodes)
                if reduced is? compound.TokenError return reduced
                if reduced.length <? branch.items.length { progress = true }
                following.push(Work[reduced []])
            }
        }
        alternatives = following
        if not progress break
    }
    let candidates:array<addr> = []
    loop alternative in alternatives {
        if alternative.items.length not=? 1 return compound.lexical_error(srcfile Span[0 0] 'Incomplete expression: missing operand or unsupported operator chain')
        let node = compound.node_at(nodes alternative.items[0])
        if node isnt? AST return compound.lexical_error(srcfile node.loc 'Expected an operand')
        candidates.push(alternative.items[0])
    }
    if candidates.length =? 0 return compound.lexical_error(srcfile Span[0 0] 'Expected expression')
    if candidates.length =? 1 return candidates[0]
    let first = compound.node_at(nodes candidates[0])
    if candidates.length >? 50 { Warning[srcfile=srcfile title='Highly ambiguous expressions' pointers=[Pointer[span=first.loc message="{candidates.length} possible parses; add explicit operators to disambiguate"]]].warn }
    return compound.append_node(@nodes Ambiguous[loc=first.loc candidates=candidates])
}

parse_node = (id:addr srcfile:SrcFile @nodes:array<compound.Token>):>addr | compound.TokenError => {
    let node = compound.node_at(nodes id)
    if node is? post.Chain {
        let items:array<addr> = []
        loop child in node.items {
            let token = compound.node_at(nodes child)
            if token is? compound.Operator | post.Juxtapose | post.InvertedComparison | post.Broadcast | post.CombinedAssignment { items.push(child) }
            else {
                let parsed = parse_node(child srcfile @nodes)
                if parsed is? compound.TokenError return parsed
                items.push(parsed)
            }
        }
        return reduce_chain(items srcfile @nodes)
    }
    let children:array<addr> = []
    if node is? compound.Block | compound.ParametricEscape { children = node.inner }
    else if node is? compound.IString { children = node.content }
    else if node is? post.KeywordExpr { children = node.parts }
    else if node is? post.Flow { children = node.arms }
    loop i in 0.. and i <? children.length {
        let child = compound.node_at(nodes children[i])
        if child is? compound.Keyword | compound.StringChunk continue
        let parsed = parse_node(children[i] srcfile @nodes)
        if parsed is? compound.TokenError return parsed
        children[i] = parsed
    }
    if node is? compound.Block return compound.append_node(@nodes Block[loc=node.loc inner=children delims=node.delims base=node.base])
    if node is? compound.ParametricEscape return compound.append_node(@nodes ParametricEscape[loc=node.loc inner=children])
    if node is? compound.IString return compound.append_node(@nodes IString[loc=node.loc content=children])
    if node is? post.KeywordExpr return compound.append_node(@nodes KeywordExpr[loc=node.loc parts=children])
    if node is? post.Flow {
        let default = node.default
        if default isnt? none {
            let parsed = parse_node(default srcfile @nodes)
            if parsed is? compound.TokenError return parsed
            default = parsed
        }
        return compound.append_node(@nodes Flow[loc=node.loc arms=children default=default])
    }
    if node is? post.Directive {
        let condition = node.condition
        let message = node.message
        if condition isnt? none {
            let parsed = parse_node(condition srcfile @nodes)
            if parsed is? compound.TokenError return parsed
            condition = parsed
        }
        if message isnt? none {
            let parsed = parse_node(message srcfile @nodes)
            if parsed is? compound.TokenError return parsed
            message = parsed
        }
        return compound.append_node(@nodes Directive[loc=node.loc name=node.name condition=condition message=message])
    }
    return compound.append_node(@nodes Atom[loc=node.loc item=id])
}
parse = (srcfile:SrcFile):>Program | compound.TokenError => {
    let tokens = post.postok(srcfile)
    if tokens is? compound.TokenError return tokens
    let nodes = tokens.nodes
    let children:array<addr> = []
    loop id in tokens.roots {
        let parsed = parse_node(id srcfile @nodes)
        if parsed is? compound.TokenError return parsed
        children.push(parsed)
    }
    let loc = Span[0 0]
    if children.length >? 0 {
        let first = compound.node_at(nodes children[0])
        let last = compound.node_at(nodes children[end])
        loc = Span[first.loc.start last.loc.stop]
    }
    let root = compound.append_node(@nodes Block[loc=loc inner=children delims='\{\}'])
    return Program[nodes root]
}

token_payload = (node:compound.Token):>string => {
    if node is? Block return "{node.delims}:{if node.base is? none '' else node.base}"
    if node is? Directive return "{node.name}:{node.condition isnt? none}:{node.message isnt? none}"
    return post.token_payload(node)
}
children_of = (node:compound.Token):>array<addr> => {
    if node is? Atom return [node.item]
    if node is? BinOp return [node.op node.left node.right]
    if node is? Prefix | Postfix return [node.op node.item]
    if node is? Flat {
        let children:array<addr> = [node.op]
        loop id in node.items { children.push(id) }
        return children
    }
    if node is? Ambiguous return node.candidates
    if node is? Block | ParametricEscape return node.inner
    if node is? IString return node.content
    if node is? KeywordExpr return node.parts
    let children:array<addr> = []
    if node is? Flow {
        children = node.arms
        if node.default isnt? none { children.push(node.default) }
        return children
    }
    if node is? Directive {
        if node.condition isnt? none { children.push(node.condition) }
        if node.message isnt? none { children.push(node.message) }
        return children
    }
    return post.children_of(node)
}
dump_tree = (nodes:array<compound.Token> roots:array<addr> depth:addr):>void => {
    loop id in roots {
        let node = compound.node_at(nodes id)
        printl"{depth}\t{node.kind}\t{node.loc.start}\t{node.loc.stop}\t{_quoted(token_payload(node))}"
        dump_tree(nodes children_of(node) depth+1)
    }
}
show_tree = (nodes:array<compound.Token> roots:array<addr> indent:string):>void => {
    loop id in roots {
        let node = compound.node_at(nodes id)
        printl"{indent}{node.kind} {_quoted(token_payload(node))} [{node.loc.start}..{node.loc.stop})"
        show_tree(nodes children_of(node) indent+'  ')
    }
}

let run = (input:cli.Input):>int64 => {
    let result = parse(input.srcfile)
    if result is? compound.TokenError { result.fail }
    if input.dump { dump_tree(result.nodes [result.root] 0) }
    else { show_tree(result.nodes [result.root] '') }
    return 0
}
main = (argv:array<string>):>int64 => {
    let input = cli.read_input(argv 'p0')
    if input isnt? cli.Input { input.fail }
    if input.stage not=? 'p0' { printl"Use parser.dewy to select another stage" return 1 }
    return run(input)
}

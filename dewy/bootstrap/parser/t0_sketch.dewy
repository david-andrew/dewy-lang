doc"""
Alternative t0 design sketch: narrow context -> probe -> select -> finish.

Implements layout/comments, identifiers, symbols, numbers, metatags, shifts,
and ordinary/type/based block delimiters, including nesting and EOF errors.
Also implements quoted ordinary/raw/template strings, escapes, interpolation,
parametric Unicode escapes, and ExponentMarker. Based strings, heredocs, and
rest-of-file strings are still ahead.

Targets immutable record types and construction-time sibling-field proofs:
`const [...]` is a type of deeply immutable values, not compile-time evaluation.
The radix default must satisfy its equality even when explicitly overridden.
See t0_sketch_notes.md for compiler requirements and validation scenarios.
No closures, generators, token-class registry, or context-dependent finish call.
"""

from reporting import SrcFile, Span, Pointer, Error, Warning

let nonemptystring:type = string<length >? 0>
let PositiveLength:type = addr<(>? 0)>
let TokenError = type of error & Error

# Character/base tables copied from t0.dewy so the sketch can stand alone.
const newline_chars = set['\n' '\r\n']
const whitespace = set[' ' '\t' '\n' '\r\n' '\r']
const ascii_control_chars = set[loop i in [0x0..0x20) if chr(i) not in? whitespace chr(i)] # most ascii<0x20 are ignored for security reasons
const line_comment_start:'#' = '#'
const block_comment_start: '#\{' = '#\{'
const block_comment_end: '\}#' = '\}#'

# TODO: The specific set of digits is open for debate. The following are proposed:
# latin = set('ÆØÞßæøþẞ')
# misc = set('‽¢£¥€§†‡※')
# units = set('℃℉℥ℨ')
# Also `ϕϖϗϰϱϴ`, perhaps just `ϕϴ` which would normalize to the greek versions
const digits = set'0123456789'
const alpha = set'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
const greek = set'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩαβγδεϵζηθικλμνξοπρςστυφχψω'
const math = set'ℂℕℤℚℝℙℍ𝔼𝕊𝕋𝔽𝔾ℵℒ'
const misc = set'_‾!°'
const subscripts   = set'₀₁₂₃₄₅₆₇₈₉₊₋₌₍₎ₐₑₒₓₕₖₗₘₙₚₛₜᵢᵣᵤᵥⱼᵦᵧᵨᵩᵪ'                                  # these get normalized to the corresponding _N form, e.g. x₁ to x_1 (excluding ₊₋₌₍₎)
const superscripts = set'⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻⁼⁽⁾ᴬᴭᴮᴰᴱᴳᴴᴵᴶᴷᴸᴹᴺᴻᴼᴾᴿᵀᵁᵂᵃᵅᵆᵇᶜᵈᵉᶠᵍʰⁱʲᵏˡᵐⁿᵒᵖʳˢᵗᵘᵛʷˣʸᶻᵝᵞᵟᵠᵡᶿꜝ'  # these get normalized to the corresponding ‾N form, e.g. ¹x to ‾1x (excluding ⁺⁻⁼⁽⁾)
const misc_decorations = set'℠™©®'
const primes = set'′″‴⁗'

const start_characters = alpha | greek | math | misc # | latin | units
const continue_characters = start_characters | digits
const decoration_characters = superscripts | subscripts | misc_decorations | primes

# note that the prefix is case sensitive
# numbers may have _ as a separator (if _ is not in the set of digits)
const BasePrefix:type = '0b' | '0t' | '0q' | '0s' | '0o' | '0d' | '0z' | '0x' | '0u' | '0r' | '0g'

BaseInfo:type = const [
    alphabet:string<2 <=? length <=? uint8.max>
    case_sensitive:bool
    extra_chars:dict<string int8?>
    radix:uint8<radix =? alphabet.length> = alphabet.length
]

const BASE_SPECS: totaldict<BasePrefix BaseInfo> = [
    '0b' -> ['01' true []]
    '0t' -> ['012' true ['T'->(-1)]]
    '0q' -> ['0123' true []]
    '0s' -> ['012345' true []]
    '0o' -> ['01234567' true []]
    '0d' -> ['0123456789' true []]
    '0z' -> ['0123456789XE' false []]
    '0x' -> ['0123456789abcdef' false []]
    '0u' -> ['0123456789abcdefghijklmnopqrstuv' false []]
    '0r' -> ['0123456789abcdefghijklmnopqrstuvwxyz' false []]
    '0g' -> ['0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/' true ['-'->62 '_'->63 '='->none]]
]

# commonly used bases
const base10 = '0d'
const base16 = '0x'
const MAX_NUMBER_BASE = 16  # explicitly prefixed numbers; higher bases use strings/arrays

# Mostly operators, but also some special identifiers
# Symbols are case-sensitive
symbols:array<nonemptystring> = [
    '~' '@' '$' '`'
    '?' ';'
    '+' '-' '*' '/' '//' '%' '^'
    '\\' # left divide e.g. given Ax=b x=A\b where A\B ≡ solve(A B) (note this is not the same as x=A⁻¹B) (TODO: move description to docs)
    '=?' '>?' '<?' '>=?' '<=?' 'in?' 'is?' 'isnt?' '<=>'
    '|' '&' '??'
    '=' '::' ':=' # not a walrus operator. `x:=y` is sugar for `let x=y` (TODO: move this description to where ever we describe all operators e.g. docs)
    '|>' '<|' '=>'
    '->' '<->'
    '.' '..' '...' ',' ':' ':>'
    '∞' '∅'
    # ⁂ ‰ ‱
]
symbols.sort(key=(.length) reverse=true)
LEN_LONGEST_SYMBOL = symbols[0].length

shift_operators:array<nonemptystring> = ['<<' '>>' '<<<' '>>>' '<<!' '!>>']
shift_operators.sort(key=(.length) reverse=true)

# Normalize the opening information once. Frames contain immutable lexical
# state; stack mutation is confined to the driver. An index is an identifier
# into the output sequence, not a reference to a mutable token object.
BlockKind:type = 'square' | 'round' | 'curly' | 'based'
CloseSpelling:type = ']' | ')' | '\}'
Opening:type = const [idx:addr loc:Span]
QuoteEnd = type of any & const [text:nonemptystring]
StringEnding:type = QuoteEnd # | HeredocEnd | EndOfFile
StringMode:type = 'ordinary' | 'raw' | 'template'
InterpolationKind:type = 'ordinary' | 'template' | 'unicode'

# Individual tokenization contexts.
Root = type of any & const [default_base:BasePrefix=base10]
BlockBody = type of any & const [opening:Opening kind:BlockKind default_base:BasePrefix=base10]
TypeBody = type of any & const [opening:Opening default_base:BasePrefix=base10]

# The delimiter text is normalized at recognition, without a prefix such as r/t.
StringBody = type of any & const [opening:Opening ending:StringEnding]
RawStringBody = type of any & const [opening:Opening ending:StringEnding]
TemplateStringBody = type of any & const [opening:Opening ending:StringEnding]
# BasedStringBody = type of any & const [opening:Opening ending:QuoteEnd base:BasePrefix]
# HeredocEnd(text) and EndOfFile will extend StringEnding; heredoc/rest-of-file
# openers reuse these body contexts rather than introducing new context variants.


# Compound context groups. Keep the complete set last.
NestedContext:type = BlockBody | TypeBody | StringBody | RawStringBody | TemplateStringBody # | BasedStringBody
GeneralBodyContexts:type = Root | BlockBody | TypeBody
BodyWithoutTypeContexts:type = Root | BlockBody
WhitespaceOrCommentContexts:type = GeneralBodyContexts # | BasedStringBody
QuotedStringContexts:type = StringBody | RawStringBody | TemplateStringBody # | BasedStringBody
EscapedStringContexts:type = StringBody | TemplateStringBody
Context:type = Root | BlockBody | TypeBody | StringBody | RawStringBody | TemplateStringBody # | BasedStringBody

# Tokens are completed output values. No recognizer protocol on the base type,
# and no Number temporarily lacking its required prefix.
Token = $abstract type of any & [
    src:string                 # whole source, as in t0.dewy; loc selects its text
    loc:Span
    idx:addr
    __as__ = ():>string => if loc.start <? loc.stop <=? src.length
        "<{typename} {_quoted(src[loc.start..loc.stop))}>"
    else "<{typename}>"
]
Whitespace = type of Token
LineComment = type of Token
BlockComment = type of Token
Identifier = type of Token
Symbol = type of Token
Number = type of Token & [prefix:BasePrefix]
Metatag = type of Token
ShiftSymbol = type of Token
LeftSquareBracket = type of Token
LeftParenthesis = type of Token
LeftCurlyBrace = type of Token
LeftAngleBracket = type of Token
BasedBlockOpener = type of Token & [base:BasePrefix]
RightSquareBracket = type of Token
RightParenthesis = type of Token
RightCurlyBrace = type of Token
RightAngleBracket = type of Token
StringQuoteOpener = type of Token
RawStringQuoteOpener = type of Token
TemplateStringQuoteOpener = type of Token
StringQuoteCloser = type of Token
StringChars = type of Token
RawStringChars = type of Token
StringEscape = type of Token
TemplateLeftCurlyBrace = type of Token
ParametricStringEscape = type of Token
ExponentMarker = type of Token & [power:Number]

# A match is a small construction recipe. Minted variants preserve identity
# even when their fields are identical. No full tokens or contexts are built.
MatchData:type = [length:PositiveLength]
WhitespaceMatch = type of any & MatchData & [lone_crs:array<addr>]
LineCommentMatch = type of any & MatchData
BlockCommentMatch = type of any & MatchData
IdentifierMatch = type of any & MatchData
SymbolMatch = type of any & MatchData
NumberMatch = type of any & MatchData & [prefix:BasePrefix]
MetatagMatch = type of any & MatchData
ShiftSymbolMatch = type of any & MatchData
OpenBlockMatch = type of any & MatchData & [kind:BlockKind base:BasePrefix=base10]
OpenTypeMatch = type of any & MatchData
# Retain the narrowed frame as evidence. finish never reads the current stack.
CloseBlockMatch = type of any & MatchData & [spelling:CloseSpelling frame:BlockBody]
CloseTypeMatch = type of any & MatchData & [frame:TypeBody]
OpenStringMatch = type of any & MatchData & [mode:StringMode ending:QuoteEnd]
CloseStringMatch = type of any & MatchData & [opening:Opening]
StringCharsMatch = type of any & MatchData & [raw:bool]
StringEscapeMatch = type of any & MatchData
InterpolationMatch = type of any & MatchData & [kind:InterpolationKind]
ExponentMatch = type of any & MatchData & [power:NumberMatch]
Candidate:type = WhitespaceMatch | LineCommentMatch | BlockCommentMatch | IdentifierMatch | SymbolMatch | NumberMatch | MetatagMatch | ShiftSymbolMatch | OpenBlockMatch | OpenTypeMatch | CloseBlockMatch | CloseTypeMatch | OpenStringMatch | CloseStringMatch | StringCharsMatch | StringEscapeMatch | InterpolationMatch | ExponentMatch

Keep = type of any
Push = type of any & [frame:NestedContext]
Close = type of any & [opening:Opening]
ContextAction:type = Keep | Push | Close
Finished:type = [token:Token action:ContextAction=Keep[]]
# Append a pair only after its closer wins. Tokens never acquire half-built
# backlinks. t1 can build a partner lookup from these indices when it needs it.
DelimiterPair:type = const [opening:addr closing:addr]
Tokenization:type = [tokens:array<Token> pairs:array<DelimiterPair>]

# Probe contracts:
# - none means this recognizer does not apply; no continuation exists.
# - a candidate contains everything finish needs from recognition.
# - TokenError means malformed syntax that must not fall back to another token.
# - every successful length is <= src.length (checked again by the driver;
#   the candidate type above only preserves the source-independent positivity).
# Probes do not mutate context, emit reports, or alter the output token list.
# All diagnostic spans are absolute. offset locates the probed suffix; an
# earlier opener can therefore appear in the same report without being shifted.

probe_whitespace = (src:nonemptystring):>WhitespaceMatch? => {
    i:addr = 0
    lone_crs:array<addr> = []
    loop i <? src.length and src[i] in? whitespace {
        if src[i] =? '\r' lone_crs.push(i)
        i += 1
    }
    if i =? 0 return none
    return WhitespaceMatch[length=i lone_crs=lone_crs]
}

probe_line_comment = (src:nonemptystring):>LineCommentMatch? => {
    if not src.startswith(line_comment_start) return none
    if src.startswith(block_comment_start) return none
    loop i in 0.. and i <? src.length {
        if src[i] in? newline_chars return LineCommentMatch[length=i+1]
    }
    return LineCommentMatch[length=src.length]
}

probe_block_comment = (src:nonemptystring srcfile:SrcFile offset:addr):>BlockCommentMatch? | TokenError => {
    if not src.startswith(block_comment_start) return none
    openers:array<Span length>=?1> = [Span[offset offset+block_comment_start.length]]
    i:addr = block_comment_start.length
    loop i <? src.length {
        if src[i..].startswith(block_comment_start) {
            openers.push(Span[offset+i offset+i+block_comment_start.length])
            i += block_comment_start.length
        }
        else if src[i..].startswith(block_comment_end) {
            i += block_comment_end.length
            if openers.length =? 1 return BlockCommentMatch[length=i]
            openers.pop;
        }
        else { i += 1 }
    }
    return TokenError[
        srcfile=srcfile
        title="Unterminated block comment"
        pointers=[
            loop opener in openers
                Pointer[span=opener message="Unclosed block comment opened here"]
        ]
        hint="Each block comment opener needs a closing `{block_comment_end}`"
    ]
}

probe_identifier = (src:nonemptystring):>IdentifierMatch? => {
    i:addr = 0
    loop i <? src.length and src[i] in? decoration_characters { i += 1 }
    if i >=? src.length or src[i] not in? start_characters return none
    i += 1
    loop i <? src.length and (src[i] in? continue_characters or src[i] in? decoration_characters) { i += 1 }
    return IdentifierMatch[length=i]
}

probe_symbol = (src:nonemptystring):>SymbolMatch? => {
    loop op in symbols {
        if src.startswith(op) return SymbolMatch[length=op.length]
    }
    return none
}

# Canonical alphabet order encodes digit values. Extras are accepted even
# when their value is none (padding); only membership is needed in this stage.
# This direct scan keeps the spec as the only table. A later decoder can derive
# canonical/case-alias/extra lookup entries once if profiling warrants it.
is_based_digit = (c:string base:BasePrefix):>bool => {
    info = BASE_SPECS[base]
    if c in? info.extra_chars return true
    loop digit in info.alphabet {
        if c =? digit return true
        if not info.case_sensitive and c.casefold =? digit.casefold return true
    }
    return false
}

probe_number = (src:nonemptystring default_base:BasePrefix srcfile:SrcFile offset:addr):>NumberMatch? | TokenError => {
    base:BasePrefix = default_base
    i:addr = 0
    explicit_prefix = false
    if src.length >=? 2 {
        prefix = src[..2)
        if prefix is? BasePrefix {
            base = prefix
            explicit_prefix = true
            i = 2
        }
    }

    # A bare prefix, or a prefix followed by a quote/bracket, isn't a Number.
    # Future based-string/block probes can then recognize the whole opener.
    if i >=? src.length or not is_based_digit(src[i] base) return none
    first_digit = i
    i += 1  # consume the digit already proven present; positivity is explicit
    loop i <? src.length and (is_based_digit(src[i] base) or src[i] =? '_') { i += 1 }

    # Preserve hosted behavior: a high-base array body permits unprefixed
    # numbers; an explicitly prefixed high-base number is still rejected.
    if explicit_prefix and BASE_SPECS[base].radix >? MAX_NUMBER_BASE {
        return TokenError[
            srcfile=srcfile
            title="Number base too high"
            pointers=[Pointer[span=Span[offset offset+i] message="Unquoted base-{BASE_SPECS[base].radix} digits"]]
            hint="Numeric literals support bases up to {MAX_NUMBER_BASE}; use a based string such as {base}'{src[first_digit..i)}'"
        ]
    }

    # The one resolved base is used both to accept digits and construct Number.
    # finish neither reexamines the prefix nor consults the context again.
    return NumberMatch[length=i prefix=base]
}

probe_metatag = (src:nonemptystring):>MetatagMatch? => {
    if not src.startswith('$') or src.length <=? 1 return none
    name = probe_identifier(src[1..])
    if name is? none return none
    return MetatagMatch[length=name.length+1]
}

probe_shift_symbol = (src:nonemptystring):>ShiftSymbolMatch? => {
    loop op in shift_operators {
        if src.startswith(op) return ShiftSymbolMatch[length=op.length]
    }
    return none
}

probe_block_opener = (src:nonemptystring):>OpenBlockMatch? => {
    if src.startswith('[') return OpenBlockMatch[length=1 kind='square']
    if src.startswith('(') return OpenBlockMatch[length=1 kind='round']
    if src.startswith('\{') return OpenBlockMatch[length=1 kind='curly']
    if src.length >=? 3 {
        prefix = src[..2)
        if prefix is? BasePrefix and src[2] =? '[' {
            return OpenBlockMatch[length=3 kind='based' base=prefix]
        }
    }
    return none
}

probe_type_opener = (src:nonemptystring):>OpenTypeMatch? => {
    if src.startswith('<') return OpenTypeMatch[length=1]
    return none
}

probe_block_closer = (src:nonemptystring ctx:BlockBody):>CloseBlockMatch? => {
    c = src[0]
    if c is? ']' | ')' | '\}' {
        return CloseBlockMatch[length=1 spelling=c frame=ctx]
    }
    return none
}

probe_type_closer = (src:nonemptystring ctx:TypeBody):>CloseTypeMatch? => {
    if src.startswith('>') return CloseTypeMatch[length=1 frame=ctx]
    return none
}

# A run of N quotes opens with N quotes if odd, N/2 if even (empty strings).
# Save the exact delimiter here; string-body probes never inspect opener tokens.
probe_string_opener = (src:nonemptystring):>OpenStringMatch? => {
    mode:StringMode = 'ordinary'
    start:addr = 0
    if src.startswith('r"') or src.startswith("r'") { mode = 'raw' start = 1 }
    else if src.startswith('t"') or src.startswith("t'") { mode = 'template' start = 1 }
    if start >=? src.length return none
    quote = src[start]
    if quote isnt? '"' | "'" return none
    i:addr = start + 1
    loop i <? src.length and src[i] =? quote { i += 1 }
    count = i-start
    length = if count % 2 =? 0 count//2 else count
    if length <=? 0 return none
    stop = start+length
    if stop <=? start or stop >? src.length return none  # expose the slice bounds and nonemptiness
    return OpenStringMatch[length=stop mode=mode ending=QuoteEnd[src[start..stop)]]
}

probe_string_closer = (src:nonemptystring ctx:QuotedStringContexts):>CloseStringMatch? => {
    delimiter = ctx.ending.text
    # The type promises this; nested named string refinements are not currently
    # recovered on this read. Keep the invariant explicit until that is fixed.
    $runtime_assert delimiter.length >? 0
    if src.startswith(delimiter) {
        return CloseStringMatch[length=delimiter.length opening=ctx.opening]
    }
    return none
}

probe_string_chars = (src:nonemptystring ctx:QuotedStringContexts):>StringCharsMatch? => {
    i:addr = 0
    loop i <? src.length {
        if src[i..].startswith(ctx.ending.text) break
        if ctx isnt? RawStringBody {
            if src[i] =? '\\' break
            if ctx is? StringBody and src[i] =? '\{' break
            if ctx is? TemplateStringBody and src[i..].startswith('$\{') break
        }
        i += 1
    }
    if i =? 0 return none
    return StringCharsMatch[length=i raw=(ctx is? RawStringBody)]
}

# Parametric escapes open ordinary expression blocks whose default base is hex.
# These compete with simple escapes, but simple escapes explicitly decline \u{.
probe_interpolation = (src:nonemptystring ctx:EscapedStringContexts):>InterpolationMatch? => {
    if src.startswith('\\u\{') or src.startswith('\\U\{') {
        return InterpolationMatch[length=3 kind='unicode']
    }
    if ctx is? StringBody and src.startswith('\{') return InterpolationMatch[length=1 kind='ordinary']
    if ctx is? TemplateStringBody and src.startswith('$\{') return InterpolationMatch[length=2 kind='template']
    return none
}

probe_string_escape = (src:nonemptystring srcfile:SrcFile offset:addr):>StringEscapeMatch? | TokenError => {
    if not src.startswith('\\') return none
    if src.length <? 2 {
        return TokenError[
            srcfile=srcfile title="Incomplete escape sequence at end of string"
            pointers=[Pointer[span=Span[offset offset+src.length] message="Expected a character after the backslash"]]
        ]
    }
    code = src[1]
    if code is? 'x' | 'X' {
        return TokenError[
            srcfile=srcfile title="Hex byte escapes are not supported in Dewy strings"
            pointers=[Pointer[span=Span[offset offset+2] message="Unsupported hex byte escape"]]
            hint="Use a Unicode escape or a based byte string"
        ]
    }
    if code is? 'u' | 'U' {
        if src.length >=? 3 and src[2] =? '\{' return none
        i:addr = 2
        loop i <? src.length and i <? 6 and is_based_digit(src[i] base16) { i += 1 }
        if i <? 6 {
            return TokenError[
                srcfile=srcfile title="Unicode escape sequence is too short"
                pointers=[Pointer[span=Span[offset offset+i] message="Expected four hexadecimal digits after the escape code"]]
                hint="Use four hex digits or a braced Unicode expression"
            ]
        }
        return StringEscapeMatch[length=i]
    }
    # Includes predefined escapes, escaped newline, and the catch-all literal.
    # t0 recognizes the source span; decoding the escaped value belongs to t1.
    return StringEscapeMatch[length=2]
}

# The immediate previous token must be a Number (whitespace is not skipped).
# Only that observation crosses the probe boundary, not an optional token.
# Keep the nested NumberMatch and pass its own absolute offset to diagnostics.
probe_exponent = (src:nonemptystring previous_is_number:bool base:BasePrefix srcfile:SrcFile offset:addr):>ExponentMatch? | TokenError => {
    if not previous_is_number or src.length <? 2 return none
    if src[0] not in? set'eEpP' return none
    power = probe_number(src[1..] base srcfile offset+1)
    if power is? TokenError return power
    if power is? none return none
    return ExponentMatch[length=power.length+1 power=power]
}

# Keep only maximal lengths, but retain all ties for precedence/ambiguity.
# There is no sorting and no dependence on registration order for equal lengths.
consider = (@best:array<Candidate> result:Candidate?):>void => {
    if result is? none return
    if best.length >? 0 {
        if result.length <? best[0].length return
        if result.length >? best[0].length best.clear
    }
    best.push(result)
}

# Context eligibility is established where calls happen, not in a returned
# list of classes. The two groups overlap, so these are independent branches.
probe_context = (src:nonemptystring ctx:Context previous_is_number:bool srcfile:SrcFile offset:addr):>array<Candidate> | TokenError => {
    best:array<Candidate> = []
    if ctx is? WhitespaceOrCommentContexts {
        consider(@best probe_whitespace(src))
        consider(@best probe_line_comment(src))
        block = probe_block_comment(src srcfile offset)
        if block is? TokenError return block
        consider(@best block)
    }
    if ctx is? GeneralBodyContexts {
        consider(@best probe_identifier(src))
        consider(@best probe_symbol(src))
        number = probe_number(src ctx.default_base srcfile offset)
        if number is? TokenError return number
        consider(@best number)
        exponent = probe_exponent(src previous_is_number ctx.default_base srcfile offset)
        if exponent is? TokenError return exponent
        consider(@best exponent)
        consider(@best probe_string_opener(src))
        consider(@best probe_metatag(src))
        consider(@best probe_block_opener(src))
        consider(@best probe_type_opener(src))
    }
    if ctx is? BodyWithoutTypeContexts {
        consider(@best probe_shift_symbol(src))
    }
    if ctx is? BlockBody {
        consider(@best probe_block_closer(src ctx))
    }
    if ctx is? TypeBody {
        consider(@best probe_type_closer(src ctx))
    }
    if ctx is? QuotedStringContexts {
        consider(@best probe_string_closer(src ctx))
        consider(@best probe_string_chars(src ctx))
    }
    if ctx is? EscapedStringContexts {
        consider(@best probe_interpolation(src ctx))
        escape = probe_string_escape(src srcfile offset)
        if escape is? TokenError return escape
        consider(@best escape)
    }
    return best
}

# Only Identifier can be displaced by precedence in this subset. This encodes
# the existing Python pairs (Symbol/Number/ExponentMarker > Identifier), not a
# total ordering that would silently resolve other, potentially invalid ties.
select = (matches:array<Candidate> srcfile:SrcFile offset:addr):>Candidate | TokenError => {
    beats_identifier = false
    loop m in matches {
        if m is? SymbolMatch or m is? NumberMatch or m is? ExponentMatch { beats_identifier = true }
    }
    remaining:array<Candidate> = [
        loop m in matches
            if not (beats_identifier and m is? IdentifierMatch) m
    ]
    if remaining.length =? 1 return remaining[0]
    if remaining.length =? 0 {
        return TokenError[
            srcfile=srcfile
            title="No token matched"
            pointers=[Pointer[span=Span[offset offset] message="No implemented token starts here"]]
            hint="Based strings, heredocs, and rest-of-file strings are not implemented in this sketch yet"
        ]
    }
    return TokenError[
        srcfile=srcfile
        title="Ambiguous token"
        pointers=[Pointer[span=Span[offset offset+remaining[0].length] message="Multiple equally preferred tokens matched"]]
    ]
}

# Validation occurs after selection: e.g. a TypeBody's `>` candidate must
# not cause a pop or a mismatch report when the longer symbol `>?` wins.
# The sole driver applies the returned action exactly once, after construction.
closing_matches = (kind:BlockKind spelling:CloseSpelling):>bool => {
    if kind is? 'square' | 'round' return spelling is? ']' | ')'
    if kind =? 'based' return spelling =? ']'
    return spelling =? '\}'
}

expected_closer = (kind:BlockKind):>string => {
    if kind is? 'square' | 'round' return "`]` or `)`"
    if kind =? 'based' return "`]`"
    return "`\}`"
}

finish = (m:Candidate srcfile:SrcFile loc:Span idx:addr):>Finished | TokenError => {
    src = srcfile.body
    return match m {
        <WhitespaceMatch> => Finished[token=Whitespace[src loc idx]]
        <LineCommentMatch> => Finished[token=LineComment[src loc idx]]
        <BlockCommentMatch> => Finished[token=BlockComment[src loc idx]]
        <IdentifierMatch> => Finished[token=Identifier[src loc idx]]
        <SymbolMatch> => Finished[token=Symbol[src loc idx]]
        n:NumberMatch => Finished[token=Number[src loc idx n.prefix]]
        <MetatagMatch> => Finished[token=Metatag[src loc idx]]
        <ShiftSymbolMatch> => Finished[token=ShiftSymbol[src loc idx]]
        e:ExponentMatch => Finished[token=ExponentMarker[
            src loc idx Number[src Span[loc.start+1 loc.stop] idx e.power.prefix]
        ]]
        o:OpenStringMatch => {
            opening = Opening[idx loc]
            # Construct the token and its matching frame together in each arm.
            match o.mode {
                <'ordinary'> => Finished[
                    token=StringQuoteOpener[src loc idx]
                    action=Push[StringBody[opening o.ending]]
                ]
                <'raw'> => Finished[
                    token=RawStringQuoteOpener[src loc idx]
                    action=Push[RawStringBody[opening o.ending]]
                ]
                <'template'> => Finished[
                    token=TemplateStringQuoteOpener[src loc idx]
                    action=Push[TemplateStringBody[opening o.ending]]
                ]
            }
        }
        c:CloseStringMatch => Finished[token=StringQuoteCloser[src loc idx] action=Close[c.opening]]
        c:StringCharsMatch => {
            token:Token = if c.raw RawStringChars[src loc idx] else StringChars[src loc idx]
            Finished[token=token]
        }
        <StringEscapeMatch> => Finished[token=StringEscape[src loc idx]]
        o:InterpolationMatch => {
            token:Token = match o.kind {
                <'ordinary'> => LeftCurlyBrace[src loc idx]
                <'template'> => TemplateLeftCurlyBrace[src loc idx]
                <'unicode'> => ParametricStringEscape[src loc idx]
            }
            base:BasePrefix = if o.kind =? 'unicode' base16 else base10
            frame = BlockBody[opening=Opening[idx loc] kind='curly' default_base=base]
            Finished[token=token action=Push[frame]]
        }
        o:OpenBlockMatch => {
            token:Token = match o.kind {
                <'square'> => LeftSquareBracket[src loc idx]
                <'round'> => LeftParenthesis[src loc idx]
                <'curly'> => LeftCurlyBrace[src loc idx]
                <'based'> => BasedBlockOpener[src loc idx o.base]
            }
            frame = BlockBody[opening=Opening[idx loc] kind=o.kind default_base=o.base]
            Finished[token=token action=Push[frame]]
        }
        <OpenTypeMatch> => Finished[
            token=LeftAngleBracket[src loc idx]
            action=Push[TypeBody[opening=Opening[idx loc]]]
        ]
        c:CloseBlockMatch => {
            if not closing_matches(c.frame.kind c.spelling) {
                return TokenError[
                    srcfile=srcfile
                    title="Mismatched opening and closing delimiters"
                    pointers=[
                        Pointer[span=c.frame.opening.loc message="Block opened here"]
                        Pointer[span=loc message="Expected {expected_closer(c.frame.kind)}"]
                    ]
                ]
            }
            token:Token = match c.spelling {
                <']'> => RightSquareBracket[src loc idx]
                <')'> => RightParenthesis[src loc idx]
                <'\}'> => RightCurlyBrace[src loc idx]
            }
            Finished[token=token action=Close[c.frame.opening]]
        }
        c:CloseTypeMatch => Finished[
            token=RightAngleBracket[src loc idx]
            action=Close[c.frame.opening]
        ]
    }
}

# Warnings belong to the winner. Store only the offsets while probing, then
# allocate/emit reports after selection. No shared Context.warnings buffer.
report_warnings = (m:Candidate srcfile:SrcFile offset:addr):>void => {
    if m is? WhitespaceMatch {
        loop pos in m.lone_crs {
            Warning[
                srcfile=srcfile
                title="Lone carriage return"
                pointers=[Pointer[span=Span[offset+pos offset+pos+1] message="\\r without \\n"]]
                hint="Remove the \\r or follow it with \\n"
            ].warn
        }
    }
}

# The root is never popped. Keeping a single nonempty stack makes entering,
# resuming, and EOF validation explicit without copying token lists into frames.
tokenize = (srcfile:SrcFile):>Tokenization | TokenError => {
    tokens:array<Token> = []
    pairs:array<DelimiterPair> = []
    stack:array<Context length>?0> = [Root[]]
    src = srcfile.body
    i:addr = 0
    loop i <? src.length {
        previous_is_number = false
        if tokens.length >? 0 {
            previous = tokens[end]
            previous_is_number = previous is? Number
        }
        candidates = probe_context(src[i..] stack[end] previous_is_number srcfile i)
        if candidates is? TokenError return candidates
        winner = select(candidates srcfile i)
        if winner is? TokenError return winner

        # Reestablish the input-relative bound after storing/selecting matches.
        # PositiveLength already proves progress; source identity isn't encoded
        # in Candidate, so the driver still checks this particular upper bound.
        length = winner.length
        if length >? src.length-i {
            return TokenError[
                srcfile=srcfile
                title="Internal tokenizer error: match exceeds remaining source"
                pointers=[Pointer[span=Span[i i] message="Invalid probe result"]]
            ]
        }
        finished = finish(winner srcfile Span[i i+length] tokens.length)
        if finished is? TokenError return finished
        action = finished.action
        if action is? Close {
            # These checks establish driver invariants at the mutation boundary.
            # No stack update has occurred since probing the selected closer.
            top = stack[end]
            if stack.length <=? 1 or top is? Root {
                return TokenError[
                    srcfile=srcfile
                    title="Internal tokenizer error: attempt to close root"
                    pointers=[Pointer[span=Span[i i+length] message="Invalid close action"]]
                ]
            }
            if action.opening.idx >=? tokens.length or action.opening.idx not=? top.opening.idx {
                return TokenError[
                    srcfile=srcfile
                    title="Internal tokenizer error: closer refers to a different frame"
                    pointers=[Pointer[span=Span[i i+length] message="Invalid opening index"]]
                ]
            }
            pairs.push(DelimiterPair[action.opening.idx tokens.length])
            stack.pop;
        }
        else if action is? Push {
            stack.push(action.frame)
        }
        tokens.push(finished.token)
        report_warnings(winner srcfile i)
        i += length
    }

    if stack.length >? 1 {
        pointers:array<Pointer> = [
            loop frame in stack {
                if frame is? BlockBody {
                    Pointer[span=frame.opening.loc message="Unclosed block; expected {expected_closer(frame.kind)}"]
                }
                else if frame is? TypeBody {
                    Pointer[span=frame.opening.loc message="Unclosed type body; expected `>`"]
                }
                else if frame is? QuotedStringContexts {
                    Pointer[span=frame.opening.loc message="Unclosed string; expected {_quoted(frame.ending.text)}"]
                }
            }
        ]
        pointers.push(Pointer[span=Span[src.length src.length] message="End of file reached here"])
        return TokenError[srcfile=srcfile title="Unclosed delimiters" pointers=pointers]
    }
    return Tokenization[tokens pairs]
}

main = (argv:array<string>):>int64 => {
    if argv.length <? 2 {
        printl"usage: t0_sketch.dewy <source-file>"
        return 1
    }
    path = p(argv[1])
    body = path.read_text
    if body isnt? string { printl"Could not read source file" return 1 }
    result = tokenize(SrcFile[path=path.path body=body])
    if result is? TokenError { result.fail }
    printl"{result.tokens}"
    printl"delimiter pairs: {result.pairs}"
    return 0
}

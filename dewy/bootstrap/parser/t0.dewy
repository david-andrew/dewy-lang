doc"""
Tokenizer Framework

(TBD attempt to simplify over the )
"""

from reporting import Report, SrcFile #, Error, Warning, Info, Hint



# some helpers
let err = (msg:string?=none) => {
    if msg is? string printl"error: {msg}" else printl"error: unimplemented"  # would be nice if this could print out the location it was called
    exit(1)
}

let nonemptystring:type = string<length >? 0>




##### CHARACTER SETS AND USEFUL CONSTANTS #####

const newline_chars = set['\n' '\r\n']
const whitespace = set[' ' '\t' '\n' '\r\n' '\r']
const ascii_control_chars = set[loop i in [0x0..0x20) if chr(i) not in? whitespace chr(i)] # {chr(i) for i in range(0x20) if i not in whitespace} | {'\x7F'} # most ascii<0x20 are ignored for security reasons
const line_comment_start:'#' = '#'
const block_comment_start: '#\{' = '#\{'
const block_comment_end: '\}#' = '\}#'

# TODO: The specific set of digits is open for debate. The following are proposed:
# latin = set('ÆØÞßæøþẞ')
# misc = set('‽¢£¥€§†‡※')
# units = set('℃℉℥ℨ')
# Also `ϕϖϗϰϱϴ`, perhaps just `ϕϴ` which would normalize to the greek versions
const digits = set'0123456789'
const alpha = set'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
const greek = set'ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩαβγδεϵζηθικλμνξοπρςστυφχψω'
const math = set'ℂℕℤℚℝℙℍ𝔼𝕊𝕋𝔽𝔾ℵℒ'
const misc = set'_‾!°'
const subscripts   = set'₀₁₂₃₄₅₆₇₈₉₊₋₌₍₎ₐₑₒₓₕₖₗₘₙₚₛₜᵢᵣᵤᵥⱼᵦᵧᵨᵩᵪ'                                  # these get normalized to the corresponding _N form, e.g. x₁ to x_1 (excluding ₊₋₌₍₎)
const superscripts = set'⁰¹²³⁴⁵⁶⁷⁸⁹⁺⁻⁼⁽⁾ᴬᴭᴮᴰᴱᴳᴴᴵᴶᴷᴸᴹᴺᴻᴼᴾᴿᵀᵁᵂᵃᵅᵆᵇᶜᵈᵉᶠᵍʰⁱʲᵏˡᵐⁿᵒᵖʳˢᵗᵘᵛʷˣʸᶻᵝᵞᵟᵠᵡᶿꜝ'  # these get normalized to the corresponding ‾N form, e.g. ¹x to ‾1x (excluding ⁺⁻⁼⁽⁾)
const misc_decorations = set'℠™©®'
const primes = set'′″‴⁗'

const start_characters = alpha | greek | math | misc # | latin | units
const continue_characters = start_characters | digits
const decoration_characters = superscripts | subscripts | misc_decorations | primes

# note that the prefix is case insensitive, so call .casefold() when matching the prefix
# numbers may have _ as a separator (if _ is not in the set of digits)
const BasePrefix:type = '0b' | '0t' | '0q' | '0s' | '0o' | '0d' | '0z' | '0x' | '0u' | '0r' | '0g'

BaseInfo:type = [
    digits:set<string> #length>?1 >  #TODO: compiler improvements: adding the length here didn't work
    case_insensitive:bool
    extra_chars:dict<string int?>     # TODO compiler improvements: calling this `:dict<string int|undefined>` gave a pretty cryptic error when below I tried including empty dicts in the structure. "arrays require a fixed-width scalar or handle element type, got `int | undefined`". perhaps the error could highlight multiple places? but also general improvements to the error (e.g. hint to change `int` to some `intN`, etc.). and also just the ability to have `int` here in the first place, and it would figure out what it width it needs based on all the places that do provide something rather than failing on the ones that don't need it
]

BASE_SPECS: dict<BasePrefix BaseInfo> = [
    '0b' -> [set'01' false []]    # binary
    '0t' -> [set'012' false ['T'->(-1)]]    # ternary (and also support balanced ternary with 'T')
    '0q' -> [set'0123' false []]    # quaternary
    '0s' -> [set'012345' false []]    # seximal
    '0o' -> [set'01234567' false []]    # octal
    '0d' -> [set'0123456789' false []]    # decimal
    '0z' -> [set'0123456789XE' true []]    # dozenal (case-insensitive)
    '0x' -> [set'0123456789abcdef' true []]    # hexadecimal (case-insensitive)
    '0u' -> [set'0123456789abcdefghijklmnopqrstuv' true []]    # base 32 (duotrigesimal) (case-insensitive)
    '0r' -> [set'0123456789abcdefghijklmnopqrstuvwxyz' true []]    # base 36 (hexatrigesimal) (case-insensitive)
    '0g' -> [set'0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/' false ['-'->62 '_'->63 '='->none]]    # base 64 (tetrasexagesimal) (case-sensitive)
]

base_radixes: dict<BasePrefix int> = [
    loop [prefix info] in BASE_SPECS
        prefix -> info.digits.length
]


# commonly used bases
const base10 = '0d'
const base16 = '0x'
const MAX_NUMBER_BASE = 16  # maximum base for integer literals. Rest must be based strings or based arrays








# Mostly operators, but also some special identifiers
# Symbols are case-insensitive (mainly relevant for `in?`, `is?`, `isnt?`)
symbols:array<nonemptystring> = [
    '~' '@' '$' '`'
    '?' ';'
    '+' '-' '*' '/' '//' '%' '^'
    '\\' # left divide e.g. given Ax=b x=A\b where A\B ≡ solve(A B) (note this is not the same as x=A⁻¹B) (TODO: move description to docs)
    '=?' '>?' '<?' '>=?' '<=?' 'in?' 'is?' 'isnt?' '<=>'
    '|' '&' '??'
    '=' '::' ':=' # not a walrus operator. `x:=y` is sugar for `let x=y` (TODO: move this description to where ever we describe all operators e.g. docs)
    '|>' '<|' '=>'
    '->' '<->'
    '.' '..' '...' ',' ':' ':>'
    '∞' '∅'
    # ⁂ ‰ ‱
]
symbols.sort(key=(.length) reverse=true)
LEN_LONGEST_SYMBOL = symbols[0].length

# shift operators are not allowed in type groups, so deal with them separately
shift_operators = ['<<' '>>' '<<<' '>>>' '<<!' '!>>']
shift_operators.sort(key=(.length) reverse=true)





# Token Structs
# StringQuoteOpener = type of any & [matching_quote:StringQuoteCloser?=none]
# StringQuoteCloser = type of any & [matching_quote:StringQuoteOpener|RawStringQuoteOpener|TemplateStringQuoteOpener|BasedStringQuoteOpener|none=none]  # TODO compiler fixes: causes recursion limit overflow


# Tokenization Contexts
Context = $abstract type of any & [srcfile:SrcFile previous:Token? warnings:array<Report> = []]   # warnings an `eat` raises, with spans relative to its `src`; the tokenize loop shifts and prints them
Root:type = type of Context & [default_base:BasePrefix=base10]
StringBody:type = type of Context# & [opening_quote: StringQuoteOpener | RestOfFileStringQuote | HeredocStringOpener]
RawStringBody:type = type of Context# & [opening_quote: RawStringQuoteOpener | RawHeredocStringOpener | RawRestOfFileStringQuote]
TemplateStringBody:type = type of Context# & [opening_quote: TemplateStringQuoteOpener | TemplateHeredocStringOpener | TemplateRestOfFileStringQuote]
BasedStringBody:type = type of Context#{ & [
    opening_quote: BasedStringQuoteOpener
    base: BasePrefix
]}#
BlockBody:type = type of Context #{ & [
    opening_delim: LeftSquareBracket | LeftParenthesis | LeftCurlyBrace | TemplateLeftCurlyBrace | ParametricStringEscape
    default_base: BasePrefix = base10
] }#
TypeBody:type = type of Context #{ & [
    opening_delim: LeftAngleBracket
    default_base: BasePrefix = base10
]}#

# AllContexts = Root | StringBody | RawStringBody | TemplateStringBody | BasedStringBody | BlockBody | TypeBody

# let Context = type of any
let Push = type of any & [ctx:Context]
let Pop = type of any
# ConextAction:type = Push | Pop | none

let eatfn:type = (src:nonemptystring @ctx:Context):>uint64 & <(<=?src.length)> | none | TokenError
let actionfn:type = (ctx:Context):>Push|Pop
# let no_op = (ctx:Context)=>none

let Token:type = $abstract type of any & [
    src:string
    loc:Span
    idx:uint64
    eat:eatfn
    action_on_eat:actionfn?=none
    __as__ = ():>string => if loc.start <? loc.stop <=? src.length
        "<{typename} {_quoted(src[loc.start..loc.stop))}>"
    else
        "<{typename}>"

]

let TokenError = type of error & Error



# 1 -> '1st', 2 -> '2nd', 3 -> '3rd', 4 -> '4th', 11 -> '11th', …
ordinalize = (n:uint64):>string => {
    if n % 100 >=? 10 and n % 100 <=? 13 return "{n}th"
    last_digit = n % 10
    if last_digit =? 1 return "{n}st"
    if last_digit =? 2 return "{n}nd"
    if last_digit =? 3 return "{n}rd"
    return "{n}th"
}


##### TOKEN CLASSES: WHITESPACE AND COMMENTS #####
# Tokens that consume layout-only characters or comments. These are valid in
# general body contexts and usually don't affect the context stack.

# TODO: want a warning if there is a lone \r not followed by \n
Whitespace = type of Token & [
    eat = (src:nonemptystring @ctx:Context):> uint64? => {
        doc"""white space is any sequence of whitespace characters"""
        i = 0
        loop i <? src.length and src[i] in? whitespace {
            if src[i] =? '\r' { # dewy grapheme handling automatically merges \r\n into a single character
                warning_lone_carriage_return(src i @ctx) # just emit a warning
            }
            i += 1
        }
        return if i >? 0 i else none
    }
    
    warning_lone_carriage_return = (src:nonemptystring i:uint64 @ctx:Context):>void => {
        ctx.warnings.push(Warning[
            srcfile=ctx.srcfile
            title="Lone carriage return"
            pointers=[Pointer[span=Span[i i+1] message="\\r without \\n"]]  #TODO: test if we can remove `Pointer` since it's completely structural
            hint="\\r should always be followed by \\n in Dewy source code. Recommend either removing the \\r or adding newline (\\r\\n)"
        ])
    }

]

LineComment = type of Token & [
    eat = (src:nonemptystring @ctx:Context):>uint64? => {
        doc"""line comments are any sequence of characters after a # until the end of the line"""
        if not src.startswith(line_comment_start) return none
        if src.startswith(block_comment_start) return none # don't match a block comment\
        # consume until the end of the line
        loop i in 0..uint64.max and i <? src.length {  
            if src[i] in? newline_chars return i + 1
        }
        return src.length
    }
]


# probably the simplest is that value casting between uint64 and int64 is allowed, perhaps returning an error if a truncation happened? tbd (or no error if known within convertable bounds)
BlockComment = type of Token & [
    eat = (src:nonemptystring @ctx:Context):>uint64? | TokenError => {
        doc"""
        Block comments are of the form #\{ ... \}# and can be nested.
        """
        
        if not src.startswith(block_comment_start) return none
        
        openers:array<Span length>=?1> = [Span[0 block_comment_start.length]]
        i:uint64 = block_comment_start.length

        loop i <? src.length {
            if src[i..].startswith(block_comment_start) {
                openers.push(Span[i i+block_comment_start.length])
                i+=block_comment_start.length
            }
            else if src[i..].startswith(block_comment_end) {
                i+=block_comment_end.length
                if openers.length =? 1 return i
                openers.pop;
            }
            else { i += 1 }
        }
    
        # error, unterminated block comment(s). Spans are relative to `src`: the tokenize loop shifts them
        plural = if openers.length >? 1 "s" else ""
        pointers:array<Pointer> = [
            loop k in 0.. and k <? openers.length {
                inside = if k >? 0 " (inside {ordinalize(k)})" else ""
                Pointer[span=openers[k] message="{ordinalize(k+1)} unterminated block comment opened here{inside}"]
            }
        ]
        unbound:array<Span> = [   # the text between one opener's end and the next one's start
            loop k in 1.. and k <? openers.length
                if openers[k].start >=? openers[k-1].stop
                    Span[openers[k-1].stop openers[k].start]
        ]
        pointers.push(Pointer[span=Span[openers[end].stop src.length] spans=unbound message="Unbound block comment{plural}"])
        return TokenError[
            srcfile=ctx.srcfile
            title="{openers.length} unterminated block comment{plural}"
            pointers=pointers
            hint="Did you forget {openers.length} closing `{block_comment_end}`?\nBlock comments start with `{block_comment_start}` and end with `{block_comment_end}` and can be nested"
        ]
    }
]




##### TOKEN CLASSES: IDENTIFIERS AND SYMBOLIC OPERATORS #####
# Identifier-like things: plain identifiers and variants such as hashtags.

Identifier = type of Token & [
    eat = (src:nonemptystring @ctx:Context):> uint64? => {
        doc"""
        Identifiers:
        - may not start with a number
        - may not be an operator (handled by longest match + token precedence)
        - may contain decorator characters (superscripts/subscripts) anywhere (but must include at least one start character)
        """
        i = 0
        
        # Skip leading decorator characters
        loop i <? src.length and src[i] in? decoration_characters { i += 1 }
        
        # Must have at least one start character
        if i >=? src.length or src[i] not in? start_characters { return none }
        
        # Consume the start character
        i += 1
        
        # Continue consuming continue_characters or decorator characters
        loop i <? src.length and (src[i] in? continue_characters or src[i] in? decoration_characters) { i += 1 }
        
        return i
    }
]


Symbol = type of Token & [
    eat = (src:nonemptystring @ctx:Context):> uint64? => {
        doc"""symbolic operators are any sequence of characters in the symbolic_operators set"""
        chunksize = if src.length <? LEN_LONGEST_SYMBOL src.length else LEN_LONGEST_SYMBOL
        chunk = src[..chunksize).casefold()
        loop op in symbols {
            if chunk.startswith(op) {
                return op.length
            }
        }
        return none
    }
]





# what tokens are allowed in what contexts
contextmap = (ctx:Context):>array<type<Token>> => match ctx {
    <Root> => [
        Whitespace
        LineComment
        BlockComment
        Identifier
        Symbol
    ]
    <StringBody> => []
    <RawStringBody> => []
    <TemplateStringBody> => []
    <BasedStringBody> => []
    <BlockBody> => [
        Whitespace
        LineComment
        BlockComment
        Identifier
        Symbol
    ]
    <TypeBody> => [
        Whitespace
        LineComment
        BlockComment
        Identifier
        Symbol
    ]
}



tokenize = (srcfile:SrcFile):>array<Token> | TokenError => {
    ctx_stack:array<Context length>?0> = [  #TODO: what's the clean way to share tokens (unlike p0.py where tokens and tokens_so_far were separate views on the same thing. want to reduce the redundancy)
        Root[srcfile=srcfile previous=none]
    ]
    tokens:array<Token> = []
    
    src = srcfile.body
    printl"src: {src}"
    i:uint64 = 0
    loop i <? src.length {
        ctx = ctx_stack[end]
        allowed_tokens = contextmap(ctx)
        printl"---------------------------------------------------\nallowed_tokens: {allowed_tokens}"
        matches = [
            loop token_cls in allowed_tokens {
                result = token_cls.eat(src[i..] @ctx)
                if result is? TokenError { result.shift(i)  return result }   # its spans were relative to `src[i..]`
                if result isnt? exception
                    [length=result token_cls=token_cls]
            }
        ]
        loop w in ctx.warnings { w.shift(i)  w.warn }
        ctx.warnings.clear
        matches.sort(key=(.length) reverse=true)
        longest_match_length = if matches.length >? 0 matches[0].length else 0
        matches = [loop m in matches if m.length =? longest_match_length m else break]
        printl"matched tokens: {matches}"
        if matches.length >? 1 err"TODO: handling multiple matches not handled yet: {matches}"
        if matches.length =? 0 err"TODO: no tokens matched this round. remaining src:\n```dewy\n{_quoted(src[i..])}\n```"
        [length token_cls] = matches[0]
        token = token_cls[src Span[i i+length] tokens.length]
        printl"matched token {token}"
        tokens.push(token)
        i+=length
    }

    return tokens
}




# # why is iterating over argv/accessing members so difficult? `loop i in 0..argv.length` complains about argv.length not being a compiletime constant...
main = (argv:array<string>):>uint64 => {
    if argv.length <? 2 {
        err"please specify the path to the file to tokenize"
    }
    path_arg = p(argv[1])
    printl"tokenizing {path_arg}"
    # if not path.exists { printl"path does not exist: {path}" return }
    # src = 
    # src = path.read_text
    srcfile = SrcFile[
        path=path_arg.path
        body=match path_arg.read_text {
            s:string => s
            _ => err"failed to read file {path_arg}"
        }
    ]
    tokens = tokenize(srcfile)
    if tokens is? TokenError { tokens.fail } # exit with report
    printl"tokens={tokens}"


    return 0
}
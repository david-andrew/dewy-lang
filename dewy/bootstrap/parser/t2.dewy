from reporting import SrcFile, Span, Pointer, Warning
import p"t1.dewy" as compound
import p"cli.dewy" as cli
doc"""
Post-tokenization preserves the hosted pass ordering. Each rewrite returns
indices into the shared token arena; completed child lists replace their old
lists by value. Keyword collection uses an explicit next position instead of
mutating a cursor shared by recursive calls. See ../DESIGN_NOTES.md for the
pending juxtaposition, operator-chain, and directive design decisions.
"""
# Plain adjacency can mean call, index, or multiplication: sin(x), x[y], x(y).
# Syntax can eliminate some alternatives, but only semantics can choose among
# those remaining. One representation covers both definite and ambiguous jux.
Juxtapose = type of compound.Token & [kind='Juxtapose' options:array<string>]
InvertedComparison = type of compound.Token & [kind='InvertedComparisonOp' symbol:string]
Broadcast = type of compound.Token & [kind='BroadcastOp' op:addr]
CombinedAssignment = type of compound.Token & [kind='CombinedAssignmentOp' op:addr]
OpFn = type of compound.Token & [kind='OpFn' op:addr]
Placeholder = type of compound.Token & [kind='Placeholder']
# Chains delimit expressions before precedence parsing. Keyword parts are
# separate chains (e.g. an if condition and body); Flow groups the entire
# if/else-if/else sequence without deciding its value type.
Chain = type of compound.Token & [kind='Chain' items:array<addr>]
KeywordExpr = type of compound.Token & [kind='KeywordExpr' parts:array<addr>]
Flow = type of compound.Token & [kind='Flow' arms:array<addr> default:addr?=none]
Directive = type of compound.Token & [kind='Directive' name:string condition:addr?=none message:addr?=none]
Collected:type = [id:addr next:addr]
Chunk:type = [items:array<addr> next:addr]
const binary_symbols = set['+' '-' '*' '/' '//' '%' '^' '\\' '=?' '>?' '<?' '>=?' '<=?' 'in?' 'is?' 'isnt?' '<=>' '|' '&' '??' '=' '::' ':=' '|>' '<|' '=>' '->' '<->' '.' ',' ':' ':>' '<<' '>>' '<<<' '>>>' '<<!' '!>>' 'and' 'or' 'xor' 'nand' 'nor' 'xnor' 'as' 'in' 'transmute' 'of']
const prefix_symbols = set['@' '~' 'not' '`' '+' '-' 'type of']
const postfix_symbols = set['`' '?' 'or_throw']
const comparisons = set['=?' '>?' '<?' '>=?' '<=?' 'in?' 'is?' 'isnt?']
const partial_symbols = comparisons | set['.' 'as' 'transmute' '*' '/' '//' '^' '%' '\\']
const directives = set['assert' 'runtime_assert' 'expect' 'fail' 'abstract' 'breakpoint']
const flows = set['if' 'loop' 'match']
const no_stops:set<string> = set[]

is_binary = (node:compound.Token nodes:array<compound.Token>):>bool => {
    if node is? compound.Operator return node.symbol in? binary_symbols
    if node is? Broadcast return is_binary(compound.node_at(nodes node.op) nodes)
    return node is? Juxtapose | CombinedAssignment | InvertedComparison
}
is_prefix = (node:compound.Token nodes:array<compound.Token>):>bool => {
    if node is? compound.Operator return node.symbol in? prefix_symbols
    if node is? Broadcast return is_prefix(compound.node_at(nodes node.op) nodes)
    return false
}
is_postfix = (node:compound.Token nodes:array<compound.Token>):>bool => {
    if node is? compound.Operator return node.symbol in? postfix_symbols
    if node is? Broadcast return is_postfix(compound.node_at(nodes node.op) nodes)
    return false
}
is_atom = (node:compound.Token):>bool => node is? compound.Identifier | compound.Metatag | compound.Bool | compound.Integer | compound.Real | compound.String | compound.IString | compound.Block | compound.BasedString | compound.Semicolon | OpFn | Placeholder | KeywordExpr | Flow | Directive
is_symbol = (node:compound.Token symbol:string):>bool => node is? compound.Operator and node.symbol =? symbol
is_identifier = (node:compound.Token name:string):>bool => node is? compound.Identifier and node.name =? name
is_stop = (node:compound.Token stop:set<string>):>bool => node is? compound.Keyword and node.name in? stop
is_directive = (node:compound.Token):>bool => node is? compound.Metatag and node.name in? directives
is_jux = (node:compound.Token name:string):>bool => node is? Juxtapose and node.options.length =? 1 and node.options[0] =? name

jux_options = (left:compound.Token right:compound.Token previous:compound.Token? nodes:array<compound.Token> srcfile:SrcFile):>array<string> => {
    if left is? compound.Semicolon return []
    if right is? compound.Semicolon {
        if not is_jux(left 'SemicolonJuxtapose') return ['SemicolonJuxtapose']
        return []
    }
    if left is? compound.Keyword | KeywordExpr | Flow or right is? compound.Keyword | KeywordExpr | Flow return []
    if is_identifier(left '...') { if is_atom(right) or is_prefix(right nodes) return ['EllipsisJuxtapose'] return [] }
    if is_identifier(right '...') { if is_atom(left) or is_postfix(left nodes) return ['EllipsisJuxtapose'] return [] }
    if is_identifier(left '..') { if is_atom(right) or is_prefix(right nodes) return ['RangeJuxtapose'] return [] }
    if is_identifier(right '..') { if is_atom(left) or is_postfix(left nodes) return ['RangeJuxtapose'] return [] }
    if left is? compound.Block and left.delims =? '<>' {
        if is_atom(right) and (previous is? none or not is_jux(previous 'TypeParamJuxtapose')) return ['TypeParamJuxtapose']
        return []
    }
    if right is? compound.Block and right.delims =? '<>' { if is_atom(left) return ['TypeParamJuxtapose'] return [] }
    let options:array<string> = []
    if is_atom(left) and is_atom(right) {
        if left isnt? compound.String | compound.IString | compound.BasedString | compound.Bool | compound.Integer | compound.Real { options.push('CallJuxtapose') }
        if left isnt? compound.Bool | compound.Integer | compound.Real | OpFn and right isnt? compound.String | compound.IString | compound.BasedString | compound.Bool | compound.Integer | compound.Real | OpFn { options.push('IndexJuxtapose') }
        if left isnt? compound.String | compound.IString | compound.BasedString | compound.Bool | OpFn | Placeholder and right isnt? compound.String | compound.IString | compound.BasedString | compound.Bool | compound.Integer | compound.Real | OpFn | Placeholder { options.push('MultiplyJuxtapose') }
        if options.length =? 0 {
            Warning[srcfile=srcfile title='Invalid types for juxtaposition'
                pointers=[Pointer[span=Span[left.loc.stop right.loc.start] message="Juxtaposition ignored; these are separate expressions"]]].warn
        }
    }
    return options
}

chain = (items:array<addr> @nodes:array<compound.Token>):>addr => {
    $runtime_assert items.length >? 0
    let first = compound.node_at(nodes items[0])
    let last = compound.node_at(nodes items[end])
    return compound.append_node(@nodes Chain[loc=Span[first.loc.start last.loc.stop] items=items])
}

# Recurse through containers without putting another Chain around an existing
# Chain. That distinction matters when the final pass reaches keyword parts.
rewrite_child = (id:addr pass:uint8 srcfile:SrcFile @nodes:array<compound.Token>):>addr | compound.TokenError => {
    let node = compound.node_at(nodes id)
    if node is? compound.Block | compound.ParametricEscape {
        let children = rewrite_list(node.inner pass srcfile @nodes)
        if children is? compound.TokenError return children
        if node is? compound.Block return compound.append_node(@nodes compound.Block[loc=node.loc inner=children delims=node.delims base=node.base])
        return compound.append_node(@nodes compound.ParametricEscape[loc=node.loc inner=children])
    }
    let children:array<addr> = []
    if node is? compound.IString { children = node.content }
    else if node is? Chain { children = node.items }
    else if node is? KeywordExpr { children = node.parts }
    else if node is? Flow { children = node.arms }
    loop i in 0.. and i <? children.length {
        let changed = rewrite_child(children[i] pass srcfile @nodes)
        if changed is? compound.TokenError return changed
        children[i] = changed
    }
    if node is? compound.IString return compound.append_node(@nodes compound.IString[loc=node.loc content=children])
    if node is? Chain return compound.append_node(@nodes Chain[loc=node.loc items=children])
    if node is? KeywordExpr return compound.append_node(@nodes KeywordExpr[loc=node.loc parts=children])
    if node is? Flow {
        let default = node.default
        if default isnt? none {
            let changed = rewrite_child(default pass srcfile @nodes)
            if changed is? compound.TokenError return changed
            default = changed
        }
        return compound.append_node(@nodes Flow[loc=node.loc arms=children default=default])
    }
    if node is? Directive {
        let condition = node.condition
        let message = node.message
        if condition isnt? none {
            let changed = rewrite_child(condition pass srcfile @nodes)
            if changed is? compound.TokenError return changed
            condition = changed
        }
        if message isnt? none {
            let changed = rewrite_child(message pass srcfile @nodes)
            if changed is? compound.TokenError return changed
            message = changed
        }
        return compound.append_node(@nodes Directive[loc=node.loc name=node.name condition=condition message=message])
    }
    return id
}

# The ordering is semantic: remove whitespace (0), then insert adjacency (1),
# supply voids at missing comma operands (2), combine type-of (3), inverted
# comparisons (4), broadcast operators (5), and combined assignments (6).
# Only then desugar partial operators (7), recognize operator functions (8)
# and predicate placeholders (9), collect keywords/directives (10), and finish
# expression chains (11). Each pass also visits nested containers.
rewrite_list = (input:array<addr> pass:uint8 srcfile:SrcFile @nodes:array<compound.Token>):>array<addr> | compound.TokenError => {
    let items:array<addr> = []
    loop id in input {
        let changed = rewrite_child(id pass srcfile @nodes)
        if changed is? compound.TokenError return changed
        let node = compound.node_at(nodes changed)
        if pass =? 0 and node is? compound.Whitespace continue
        items.push(changed)
    }
    let output:array<addr> = []
    let i:addr = 0
    loop i <? items.length {
        let id = items[i]
        let node = compound.node_at(nodes id)
        if pass =? 1 {
            output.push(id)
            if i+1 <? items.length {
                let right = compound.node_at(nodes items[i+1])
                if node.loc.stop =? right.loc.start {
                    let previous:compound.Token? = none
                    if output.length >? 1 { previous = compound.node_at(nodes output[output.length-2]) }
                    let options = jux_options(node right previous nodes srcfile)
                    if options.length >? 0 { output.push(compound.append_node(@nodes Juxtapose[loc=Span[node.loc.stop node.loc.stop] options=options])) }
                }
            }
            i += 1
            continue
        }
        if pass =? 2 and is_symbol(node ',') {
            if output.length =? 0 or is_symbol(compound.node_at(nodes output[end]) ',') {
                output.push(compound.append_node(@nodes compound.Identifier[loc=Span[node.loc.start node.loc.start] name='void']))
            }
        }
        if i+1 <? items.length {
            let right = compound.node_at(nodes items[i+1])
            let loc = Span[node.loc.start right.loc.stop]
            let replacement:compound.Token? = none
            if pass =? 3 and is_identifier(node 'type') and is_symbol(right 'of') { replacement = compound.Operator[loc=loc symbol='type of'] }
            if pass =? 4 and is_symbol(node 'not') and right is? compound.Operator and right.symbol in? comparisons { replacement = InvertedComparison[loc=loc symbol=right.symbol] }
            if pass =? 5 and is_symbol(node '.') and (is_binary(right nodes) or is_prefix(right nodes)) { replacement = Broadcast[loc=loc op=items[i+1]] }
            if pass =? 6 and (is_binary(node nodes) or node is? Broadcast) and is_symbol(right '=') { replacement = CombinedAssignment[loc=loc op=id] }
            if replacement isnt? none { output.push(compound.append_node(@nodes replacement)) i += 2 continue }
        }
        if pass =? 7 and node is? compound.Block and node.delims =? '()' and node.inner.length >=? 2 {
            # (.field) and (>? limit) stand for
            # single-argument functions. Insert an explicit parameter/arrow
            # before chain collection so ordinary expression parsing handles it.
            let op = compound.node_at(nodes node.inner[0])
            let following = compound.node_at(nodes node.inner[1])
            if (op is? InvertedComparison or op is? compound.Operator and op.symbol in? partial_symbols) and following isnt? compound.Semicolon {
                let param = compound.append_node(@nodes compound.Identifier[loc=op.loc name='__dewy_partial'])
                let arrow = compound.append_node(@nodes compound.Operator[loc=op.loc symbol='=>'])
                let inner:array<addr> = [param arrow param]
                loop child in node.inner { inner.push(child) }
                id = compound.append_node(@nodes compound.Block[loc=node.loc inner=inner delims=node.delims base=node.base])
            }
        }
        if pass =? 8 and node is? compound.Block and node.delims =? '()' and node.inner.length =? 1 {
            let op = compound.node_at(nodes node.inner[0])
            if op is? compound.Operator | Broadcast | CombinedAssignment { id = compound.append_node(@nodes OpFn[loc=node.loc op=node.inner[0]]) }
        }
        if pass =? 9 and is_identifier(node '$') { id = compound.append_node(@nodes Placeholder[loc=node.loc]) }
        if pass =? 10 and (node is? compound.Keyword and node.name not=? 'else' or is_directive(node)) {
            let result = collect_atom(items i set['else'] srcfile @nodes)
            if result is? compound.TokenError return result
            output.push(result.id)
            i = result.next
            continue
        }
        if pass =? 11 {
            let result = collect_expr(items i no_stops srcfile @nodes)
            if result is? compound.TokenError return result
            output.push(result.id)
            i = result.next
            continue
        }
        output.push(id)
        i += 1
    }
    if pass =? 2 and output.length >? 0 {
        let last = compound.node_at(nodes output[end])
        if is_symbol(last ',') { output.push(compound.append_node(@nodes compound.Identifier[loc=Span[last.loc.stop last.loc.stop] name='void'])) }
    }
    return output
}

# Collection returns the next unread position alongside the completed value.
# Recursive keyword collection therefore cannot accidentally advance its
# caller's cursor twice or consume the caller's terminating else/keyword.
collect_chunk = (items:array<addr> start:addr stop:set<string> srcfile:SrcFile @nodes:array<compound.Token>):>Chunk | compound.TokenError => {
    let i:addr = start
    let output:array<addr> = []
    loop i <? items.length {
        let node = compound.node_at(nodes items[i])
        if is_stop(node stop) or not is_prefix(node nodes) break
        output.push(items[i])
        i += 1
    }
    if i >=? items.length return Chunk[output i]
    let node = compound.node_at(nodes items[i])
    if is_stop(node stop) or node is? compound.Semicolon return Chunk[output i]
    if node is? compound.Keyword or is_directive(node) {
        let result = collect_atom(items i stop srcfile @nodes)
        if result is? compound.TokenError return result
        output.push(result.id)
        i = result.next
        if is_directive(node) return Chunk[output i]
    }
    else {
        if not is_atom(node) return compound.lexical_error(srcfile node.loc 'Expected expression')
        output.push(items[i])
        i += 1
    }
    loop i <? items.length {
        let following = compound.node_at(nodes items[i])
        if is_stop(following stop) or not is_postfix(following nodes) break
        output.push(items[i])
        i += 1
    }
    return Chunk[output i]
}
collect_expr = (items:array<addr> start:addr stop:set<string> srcfile:SrcFile @nodes:array<compound.Token>):>Collected | compound.TokenError => {
    if start >=? items.length return compound.lexical_error(srcfile Span[srcfile.body.length srcfile.body.length] 'Expected expression')
    let first = compound.node_at(nodes items[start])
    if first is? compound.Semicolon return Collected[chain([items[start]] @nodes) start+1]
    let chunk = collect_chunk(items start stop srcfile @nodes)
    if chunk is? compound.TokenError return chunk
    if chunk.items.length =? 0 return compound.lexical_error(srcfile first.loc 'Expected expression')
    let output = chunk.items
    let i:addr = chunk.next
    loop i <? items.length {
        let op = compound.node_at(nodes items[i])
        if is_stop(op stop) or op is? compound.Semicolon or not is_binary(op nodes) break
        output.push(items[i])
        i += 1
        let next = collect_chunk(items i stop srcfile @nodes)
        if next is? compound.TokenError return next
        loop child in next.items { output.push(child) }
        i = next.next
    }
    if i >? 0 and i <? items.length {
        if is_jux(compound.node_at(nodes items[i-1]) 'SemicolonJuxtapose') and compound.node_at(nodes items[i]) is? compound.Semicolon { output.push(items[i]) i += 1 }
    }
    return Collected[chain(output @nodes) i]
}

collect_atom = (items:array<addr> start:addr stop:set<string> srcfile:SrcFile @nodes:array<compound.Token>):>Collected | compound.TokenError => {
    $runtime_assert start <? items.length
    let kw = compound.node_at(nodes items[start])
    if kw is? compound.Metatag return collect_directive(items start stop srcfile @nodes)
    if kw isnt? compound.Keyword return compound.lexical_error(srcfile kw.loc 'Expected keyword')
    let i:addr = start+1
    let parts:array<addr> = [items[start]]
    if kw.name in? flows {
        let arms:array<addr> = []
        let default:addr? = none
        i = start
        loop true {
            $runtime_assert i <? items.length
            let arm_kw = compound.node_at(nodes items[i])
            let arm_parts:array<addr> = [items[i]]
            let condition = collect_expr(items i+1 stop|set['else'] srcfile @nodes)
            if condition is? compound.TokenError return condition
            arm_parts.push(condition.id)
            let body = collect_expr(items condition.next stop|set['else'] srcfile @nodes)
            if body is? compound.TokenError return body
            arm_parts.push(body.id)
            let last = compound.node_at(nodes body.id)
            arms.push(compound.append_node(@nodes KeywordExpr[loc=Span[arm_kw.loc.start last.loc.stop] parts=arm_parts]))
            i = body.next
            if i >=? items.length break
            let next = compound.node_at(nodes items[i])
            if next isnt? compound.Keyword or next.name not=? 'else' break
            i += 1
            if i <? items.length {
                let next = compound.node_at(nodes items[i])
                if next is? compound.Keyword and next.name in? flows continue
            }
            let result = collect_expr(items i stop|set['else'] srcfile @nodes)
            if result is? compound.TokenError return result
            default = result.id
            i = result.next
            break
        }
        $runtime_assert arms.length >? 0
        let last = compound.node_at(nodes arms[end])
        if default isnt? none { last = compound.node_at(nodes default) }
        return Collected[compound.append_node(@nodes Flow[loc=Span[kw.loc.start last.loc.stop] arms=arms default=default]) i]
    }
    if kw.name in? set['return' 'yield'] {
        if i+1 <? items.length and is_jux(compound.node_at(nodes items[i]) 'SemicolonJuxtapose') and compound.node_at(nodes items[i+1]) is? compound.Semicolon {
            return Collected[compound.append_node(@nodes KeywordExpr[loc=kw.loc parts=parts]) i+2]
        }
        if i <? items.length and compound.node_at(nodes items[i]) is? compound.Semicolon { return Collected[compound.append_node(@nodes KeywordExpr[loc=kw.loc parts=parts]) i+1] }
        let bare:bool = i >=? items.length
        if i <? items.length {
            let following = compound.node_at(nodes items[i])
            $runtime_assert kw.loc.stop <=? following.loc.start <=? srcfile.body.length
            bare = is_stop(following stop)
            loop char in srcfile.body[kw.loc.stop..following.loc.start) { if char is? '\n' | '\r\n' { bare = true } }
        }
        if bare return Collected[compound.append_node(@nodes KeywordExpr[loc=kw.loc parts=parts]) i]
    }
    if kw.name in? set['break' 'continue'] {
        let loc = kw.loc
        if i <? items.length {
            let tag = compound.node_at(nodes items[i])
            if tag is? compound.Metatag { parts.push(chain([items[i]] @nodes)) loc = Span[kw.loc.start tag.loc.stop] i += 1 }
        }
        return Collected[compound.append_node(@nodes KeywordExpr[loc=loc parts=parts]) i]
    }
    if kw.name =? 'else' return compound.lexical_error(srcfile kw.loc '`else` is not a match arm')
    let first_stop = stop
    if kw.name =? 'import' { first_stop = stop|set['from'] }
    if kw.name =? 'from' { first_stop = stop|set['import'] }
    let first = collect_expr(items i first_stop srcfile @nodes)
    if first is? compound.TokenError return first
    parts.push(first.id)
    i = first.next
    let needs_import:bool = kw.name =? 'from'
    let has_from:bool = false
    if i <? items.length { has_from = is_stop(compound.node_at(nodes items[i]) set['from']) }
    if needs_import or kw.name =? 'import' and has_from {
        if i >=? items.length return compound.lexical_error(srcfile kw.loc 'Expected `import` after `from`')
        if needs_import and not is_stop(compound.node_at(nodes items[i]) set['import']) return compound.lexical_error(srcfile kw.loc 'Expected `import` after `from`')
        parts.push(items[i])
        let second = collect_expr(items i+1 stop srcfile @nodes)
        if second is? compound.TokenError return second
        parts.push(second.id)
        i = second.next
    }
    let last = compound.node_at(nodes parts[end])
    return Collected[compound.append_node(@nodes KeywordExpr[loc=Span[kw.loc.start last.loc.stop] parts=parts]) i]
}

collect_directive = (items:array<addr> start:addr stop:set<string> srcfile:SrcFile @nodes:array<compound.Token>):>Collected | compound.TokenError => {
    $runtime_assert start <? items.length
    let tag = compound.node_at(nodes items[start])
    if tag isnt? compound.Metatag return compound.lexical_error(srcfile tag.loc 'Expected directive')
    let i:addr = start+1
    if tag.name =? 'breakpoint' return Collected[compound.append_node(@nodes Directive[loc=tag.loc name=tag.name]) i]
    let ends_here:bool = i >=? items.length
    if i <? items.length {
        let next = compound.node_at(nodes items[i])
        ends_here = is_stop(next stop) or next is? compound.Semicolon | KeywordExpr or next is? compound.Keyword and next.name not in? flows
    }
    if ends_here {
        if tag.name =? 'fail' return Collected[compound.append_node(@nodes Directive[loc=tag.loc name=tag.name]) i]
        return compound.lexical_error(srcfile tag.loc "`${tag.name}` needs a condition")
    }
    let argument = collect_expr(items i stop srcfile @nodes)
    if argument is? compound.TokenError return argument
    let arg = compound.node_at(nodes argument.id)
    if arg isnt? Chain return compound.lexical_error(srcfile tag.loc 'Expected directive expression')
    let loc = Span[tag.loc.start arg.loc.stop]
    if tag.name =? 'fail' return Collected[compound.append_node(@nodes Directive[loc=loc name=tag.name message=argument.id]) argument.next]
    if tag.name =? 'abstract' return Collected[compound.append_node(@nodes Directive[loc=loc name=tag.name condition=argument.id]) argument.next]
    let condition_items:array<addr> = []
    let message_items:array<addr> = []
    let comma:bool = false
    loop id in arg.items {
        let node = compound.node_at(nodes id)
        if is_symbol(node ',') {
            if comma return compound.lexical_error(srcfile node.loc 'An assertion takes a condition and at most one message')
            comma = true
        }
        else if comma { message_items.push(id) }
        else { condition_items.push(id) }
    }
    if not comma return Collected[compound.append_node(@nodes Directive[loc=loc name=tag.name condition=argument.id]) argument.next]
    if condition_items.length =? 0 or message_items.length =? 0 return compound.lexical_error(srcfile loc 'An assertion takes condition, message')
    let real_message:bool = false
    loop id in message_items {
        let node = compound.node_at(nodes id)
        if not is_identifier(node 'void') or node.loc.start not=? node.loc.stop { real_message = true }
    }
    if not real_message return compound.lexical_error(srcfile loc 'An assertion takes condition, message')
    let condition = chain(condition_items @nodes)
    let message = chain(message_items @nodes)
    return Collected[compound.append_node(@nodes Directive[loc=loc name=tag.name condition=condition message=message]) argument.next]
}

postok = (srcfile:SrcFile):>compound.TokenStream | compound.TokenError => {
    let result = compound.tokenize(srcfile)
    if result is? compound.TokenError return result
    let nodes = result.nodes
    let roots = result.roots
    loop pass in [0..12) {
        let rewritten = rewrite_list(roots pass as uint8 srcfile @nodes)
        if rewritten is? compound.TokenError return rewritten
        roots = rewritten
    }
    return compound.TokenStream[nodes roots]
}

# Structural output includes operator wrappers and directive slot presence.
token_payload = (node:compound.Token):>string => {
    if node is? Juxtapose return node.options.join('|')
    if node is? InvertedComparison return node.symbol
    if node is? Directive return "{node.name}:{node.condition isnt? none}:{node.message isnt? none}"
    return compound.token_payload(node)
}
children_of = (node:compound.Token):>array<addr> => {
    if node is? compound.Block | compound.ParametricEscape return node.inner
    if node is? compound.IString return node.content
    if node is? Chain return node.items
    if node is? KeywordExpr return node.parts
    if node is? Broadcast | CombinedAssignment | OpFn return [node.op]
    let children:array<addr> = []
    if node is? Flow {
        children = node.arms
        if node.default isnt? none { children.push(node.default) }
    }
    if node is? Directive {
        if node.condition isnt? none { children.push(node.condition) }
        if node.message isnt? none { children.push(node.message) }
    }
    return children
}
dump_tree = (nodes:array<compound.Token> roots:array<addr> depth:addr):>void => {
    loop id in roots {
        let node = compound.node_at(nodes id)
        printl"{depth}\t{node.kind}\t{node.loc.start}\t{node.loc.stop}\t{_quoted(token_payload(node))}"
        dump_tree(nodes children_of(node) depth+1)
    }
}
show_tree = (nodes:array<compound.Token> roots:array<addr> indent:string):>void => {
    loop id in roots {
        let node = compound.node_at(nodes id)
        printl"{indent}{node.kind} {_quoted(token_payload(node))}"
        show_tree(nodes children_of(node) indent+'  ')
    }
}

let run = (input:cli.Input):>int64 => {
    let result = postok(input.srcfile)
    if result is? compound.TokenError { result.fail }
    if input.dump { dump_tree(result.nodes result.roots 0) }
    else {
        let pointers:array<Pointer> = []
        loop id in result.roots {
            let node = compound.node_at(result.nodes id)
            if node is? compound.Whitespace continue
            pointers.push(Pointer[span=node.loc message="{node.kind} {_quoted(token_payload(node))}"])
        }
        cli.show_tokens(input.srcfile pointers 't2')
        show_tree(result.nodes result.roots '')
    }
    return 0
}
main = (argv:array<string>):>int64 => {
    let input = cli.read_input(argv 't2')
    if input isnt? cli.Input { input.fail }
    if input.stage not=? 't2' { printl"Use parser.dewy to select another stage" return 1 }
    return run(input)
}

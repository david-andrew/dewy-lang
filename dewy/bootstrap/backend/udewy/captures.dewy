import p"../../semantic/hir.dewy" as hir

# Follow the hosted lambda-lifting boundary: direct calls pass the current
# values of enclosing bindings as hidden parameters. Dependencies propagate
# those parameters through callers, including mutually recursive functions.
# Capturing functions used as values and writes through captures still need
# closure storage; keep those cases explicit rather than silently copying.
Function:type = [id:addr locals:set<addr>=set[] direct:set<addr>=set[] dependencies:set<addr>=set[] captures:set<addr>=set[] writes:set<addr>=set[]]
Plan:type = [reassigned:set<addr>=set[] functions:dict<addr Function>=[] named:dict<addr addr>=[] definitions:dict<addr addr>=[] names:dict<addr string>=[] globals:set<addr>=set[] source_bindings:set<addr>=set[]]

discover = (root:addr nodes:array<hir.AST> @plan:Plan @seen:set<addr>):>void => {
    if root in? seen return void
    seen.add(root)
    let node=hir.node_at(nodes root)
    if node is? hir.FunctionLiteral {plan.functions[root]=Function[root]}
    # A stored callback is a runtime value after any assignment or writable
    # exposure. Its initializer alone is not a call-target proof.
    loop target in write_targets(node nodes) {
        let binding=root_binding(target nodes)
        if binding isnt? none {plan.reassigned.add(binding)}
    }
    if node is? hir.Declare and node.binding_id isnt? none {
        plan.definitions[node.binding_id]=node.expr
        plan.names[node.binding_id]=node.name
        if hir.node_at(nodes node.expr) is? hir.FunctionLiteral {plan.named[node.binding_id]=node.expr}
    }
    loop child in hir.children(node) {discover(child nodes @plan @seen)}
}
# The checker flattens callable signatures in dispatch order. Identifier
# alternatives may themselves name overload sets, so flatten their bodies in
# that same order before selecting the recorded method. Each branch owns its
# cycle guard: two alternatives may legitimately share one source function.
callables = (id:addr plan:Plan nodes:array<hir.AST> seen:set<addr>=set[]):>array<addr>|none => {
    if id in? seen return none
    seen.add(id)
    let node=hir.node_at(nodes id)
    if node is? hir.FunctionLiteral return [id]
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
        if node.binding_id in? plan.reassigned return none
        let definition=plan.definitions.get(node.binding_id)
        if definition isnt? none return callables(definition plan nodes seen)
    } else if node is? hir.OverloadedFunction {
        let result:array<addr>=[]
        loop alternative in node.alternates {
            let resolved=callables(alternative plan nodes seen)
            if resolved is? none return none
            loop function in resolved {result.push(function)}
        }
        return result
    } else if node is? hir.Block and not node.scoped and node.items.length =? 1 return callables(node.items[0] plan nodes seen)
    return none
}
resolve = (id:addr selected:addr? plan:Plan nodes:array<hir.AST>):>addr? => {
    let node=hir.node_at(nodes id)
    if node is? hir.FunctionLiteral return id
    if node is? hir.ExpressedIdentifier {
        if node.binding_id is? none or node.binding_id in? plan.reassigned return none
        let named=plan.named.get(node.binding_id)
        if named isnt? none return named
        if node.binding_id not in? plan.definitions return none
    } else if node isnt? hir.OverloadedFunction|hir.Block return none
    let alternatives=callables(id plan nodes)
    if alternatives is? none return none
    if selected is? none return if alternatives.length =? 1 alternatives[0] else none
    return if selected <? alternatives.length alternatives[selected] else none
}
# Function addresses observed by source value expressions. Inspect edges:
# one shared checked node may be both a direct callee and a stored value.
# A declaration defines its literal; every other use may expose its address.
value_functions = (root:addr nodes:array<hir.AST> plan:Plan):>set<addr> => {
    let result:set<addr>=set[]
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=hir.node_at(nodes id)
        loop child in hir.children(node) {
            let value=hir.node_at(nodes child)
            if node is? hir.FunctionCall and node.func =? child continue
            if node is? hir.Declare and node.expr =? child and value is? hir.FunctionLiteral continue
            if value isnt? hir.ExpressedIdentifier|hir.FunctionLiteral|hir.OverloadedFunction|hir.Block continue
            let targets=callables(child plan nodes)
            if targets isnt? none {loop target in targets {result.add(target)}}
        }
        hir.push_children(node @pending)
    }
    return result
}
locals = (id:addr nodes:array<hir.AST> @result:set<addr> @seen:set<addr>):>void => {
    if id in? seen return void
    seen.add(id)
    let node=hir.node_at(nodes id)
    if node is? hir.FunctionLiteral return void
    if node is? hir.Declare and node.binding_id isnt? none {result.add(node.binding_id)}
    if node is? hir.ObjectLiteral {
        loop field in node.fields {if field.binding_id isnt? none {result.add(field.binding_id)}}
    }
    if node is? hir.IteratorExpression {
        let target=hir.node_at(nodes node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {result.add(target.binding_id)}
    }
    loop child in hir.children(node) {locals(child nodes @result @seen)}
}
# Storage exposed to mutation by one node. Keep this shared with call-boundary
# borrowing: an array method or dictionary update matters just as much as an
# assignment spelled with `=`. Children are visited by the caller.
write_targets = (node:hir.AST nodes:array<hir.AST>):>array<addr> => {
    if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign|hir.Place|hir.IteratorExpression return [node.target]
    if node is? hir.DictStore|hir.DictRemove {
        let result:array<addr>=[node.keys]
        let values=node.values
        if values isnt? none {result.push(values)}
        return result
    }
    if node is? hir.FunctionCall {
        let callee=hir.node_at(nodes node.func)
        if callee is? hir.ArrayMethod and callee.name not=? 'join' return [callee.array]
    }
    return []
}

references = (id:addr nodes:array<hir.AST> plan:Plan symbols:set<addr> @function:Function @seen:set<addr>):>void => {
    if id in? seen return void
    seen.add(id)
    let node=hir.node_at(nodes id)
    if node is? hir.FunctionLiteral {function.dependencies.add(id) return void}
    if node is? hir.FunctionCall {
        let direct=resolve(node.func node.selected_method_index plan nodes)
        if direct isnt? none {
            function.dependencies.add(direct)
            loop argument in node.pos_args {references(argument nodes plan symbols @function @seen)}
            loop argument in node.kw_args.values {references(argument nodes plan symbols @function @seen)}
            return void
        }
    }
    loop target in write_targets(node nodes) {
        let binding=root_binding(target nodes)
        if binding isnt? none {function.writes.add(binding)}
    }
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
        let binding=node.binding_id
        let code=plan.named.get(binding)
        if code isnt? none {function.dependencies.add(code)}
        else if binding in? symbols and binding not in? plan.globals and binding not in? function.locals {function.direct.add(binding)}
    }
    loop child in hir.children(node) {references(child nodes plan symbols @function @seen)}
}
root_binding = (id:addr nodes:array<hir.AST>):>addr? => {
    let node=hir.node_at(nodes id)
    if node is? hir.ExpressedIdentifier return node.binding_id
    if node is? hir.MemberAccess return root_binding(node.value nodes)
    if node is? hir.Index return root_binding(node.array nodes)
    if node is? hir.DictLookup return root_binding(node.values nodes)
    if node is? hir.Obligation return root_binding(node.value nodes)
    if node is? hir.Suppress return root_binding(node.item nodes)
    if node is? hir.ValueCast|hir.RepresentationCast|hir.Transmute return root_binding(node.expr nodes)
    if node is? hir.Block and not node.scoped and node.items.length =? 1 return root_binding(node.items[0] nodes)
    return none
}
analyze = (root:addr nodes:array<hir.AST> symbols:set<addr>):>Plan => {
    let result=Plan[source_bindings=symbols]
    let seen:set<addr>=set[]
    discover(root nodes @result @seen)
    let block=hir.node_at(nodes root)
    if block is? hir.Block {
        # A module item desugared into a statement group (an unpacking
        # assignment) still declares globals.
        let pending:array<addr>=block.items
        loop pending.length >? 0 {
            let id=pending.pop
            let node=hir.node_at(nodes id)
            if node is? hir.Declare and node.binding_id isnt? none {result.globals.add(node.binding_id)}
            if node is? hir.Block and not node.scoped {loop item in node.items {pending.push(item)}}
        }
    }
    let functions=result.functions.keys
    loop id in functions {
        $runtime_assert id in? result.functions
        let function=result.functions[id]
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let parameters=literal.pos_or_kw_args
        loop parameter in literal.kw_only_args {parameters.push(parameter)}
        loop parameter in parameters {if parameter.binding_id isnt? none {function.locals.add(parameter.binding_id)}}
        seen=set[]
        locals(literal.body nodes @function.locals @seen)
        loop parameter in parameters {
            if parameter is? hir.BoundParam {locals(parameter.value nodes @function.locals @seen)}
        }
        seen=set[]
        references(literal.body nodes result symbols @function @seen)
        loop parameter in parameters {
            if parameter is? hir.BoundParam {references(parameter.value nodes result symbols @function @seen)}
        }
        # A receiver method reads its record's fields through the receiver.
        if literal.object_receiver {
            loop field in literal.object_fields { function.direct.pop(field.id default=field.id); }
        }
        function.captures=function.direct
        result.functions[id]=function
    }
    let callers:dict<addr array<addr>>=[]
    loop id in functions {
        $runtime_assert id in? result.functions
        loop dependency in result.functions[id].dependencies {
            let users=callers.get(dependency [])
            users.push(id)
            callers[dependency]=users
        }
    }
    # A newly captured binding travels only along reverse dependency edges.
    # Filtering globals and each caller's locals preserves the lexical scope
    # boundary; a recursive component converges when its capture sets stop growing.
    let pending:array<addr>=[]
    let queued:set<addr>=set[]
    loop id in functions {pending.push(id) queued.add(id)}
    loop pending.length >? 0 {
        let id=pending.pop
        queued.pop(id default=id);
        let other=result.functions.get(id)
        if other is? none continue
        loop caller in callers.get(id []) {
            $runtime_assert caller in? result.functions
            let function=result.functions[caller]
            let changed=false
            loop binding in other.captures {
                if binding in? result.globals or binding in? function.locals or binding in? function.captures continue
                function.captures.add(binding)
                changed=true
            }
            if changed {
                result.functions[caller]=function
                if caller not in? queued {queued.add(caller) pending.push(caller)}
            }
        }
    }
    return result
}

$explicit_copies
import p"../../semantic/hir.dewy" as hir
import p"../../semantic/ty.dewy" as types
import p"../../semantic/type_queries.dewy" as views
import p"../../semantic/analyze/storage_borrows.dewy" as storage_borrows
import p"../../semantic/analyze/ownership_liveness.dewy" as ownership_liveness

doc"""
Last-use moves.

An owned local whose last use hands its value to storage that outlives the
expression (a `return`, a record or array literal, a field, element or
dictionary store, a binding, an owning call argument) moves there: the lowering takes the local's
handle and empties the local, so its scope-exit release does nothing. A use
is the last one when no reference to the binding follows it in traversal
order on a compatible branch path, it is not
inside a loop the declaration is outside of (the next iteration would read
the emptied local), and no nested function literal captures the binding.
A `return` leaves every path, so a local returned there always moves,
whatever the text after the return does with it. Likewise a transfer that a
later `return` statement of an enclosing block follows unconditionally, at
the same loop depth, with no use, `break` or `continue` in between, is the
last use on its path: later text belongs to other paths. Parameters are not
declarations here and never move. Mirrors `_compute_moves` in the hosted
lowering.
"""

Use:type = const [id:addr sequence:addr depth:addr nested:bool transfer:bool returned:bool path:addr]
# Persistent lexical paths keep one word per use, rather than copying the
# complete branch stack. Distinct arms of one conditional cannot both run.
Branch:type = const [parent:addr depth:addr conditional:addr]
# A transfer use in statement order, and one followed by a `return` of an
# enclosing block: it moves if nothing in `(sequence, until]` intervenes.
Transfer:type = const [binding:addr id:addr sequence:addr depth:addr]
Candidate:type = const [id:addr sequence:addr until:addr]
Analysis:type = [
    uses:dict<addr array<Use>>=[] declared:dict<addr addr>=[] counter:addr=0
    transfers:array<Transfer>=[] exits:array<addr>=[] candidates:dict<addr array<Candidate>>=[]
    paths:array<Branch>=[Branch[0 0 0]] path:addr=0 next_conditional:addr=0
]

compatible = (left:addr right:addr paths:array<Branch>):>bool => {
    loop left not=? right {
        $runtime_assert left <? paths.length and right <? paths.length
        let a=paths[left] let b=paths[right]
        if a.depth >? b.depth {left=a.parent}
        else if b.depth >? a.depth {right=b.parent}
        else if a.conditional =? b.conditional {return false}
        else {left=a.parent right=b.parent}
    }
    return true
}
walk_branch = (id:addr conditional:addr depth:addr nested:bool transfer:bool returned:bool nodes:array<hir.AST> donations:dict<addr set<addr>> @analysis:Analysis):>void => {
    let parent=analysis.path
    $runtime_assert parent <? analysis.paths.length
    let branch=Branch[parent analysis.paths[parent].depth+1 conditional]
    analysis.path=analysis.paths.length
    analysis.paths.push(branch)
    if transfer {walk_transfer(id depth nested returned nodes donations @analysis)}
    else {walk(id depth nested nodes donations @analysis)}
    analysis.path=parent
}

# The expression a transfer site hands over, through the wrappers that keep its storage.
peel = (id:addr nodes:array<hir.AST>):>addr => {
    let current=id
    loop true {
        let node=hir.node_at(nodes current)
        if node is? hir.Suppress {current=node.item continue}
        if node is? hir.Obligation {current=node.value continue}
        if node is? hir.ValueCast|hir.RepresentationCast {current=node.expr continue}
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=node.items[0] continue}
        return current
    }
}

note_use = (id:addr binding:addr depth:addr nested:bool transfer:bool returned:bool @analysis:Analysis):>void => {
    analysis.counter+=1
    if binding not in? analysis.uses {analysis.uses[binding]=[]}
    let uses=@analysis.uses[binding]
    uses.push(Use[id analysis.counter depth nested transfer returned analysis.path])
    if transfer and not nested and not returned {analysis.transfers.push(Transfer[binding id analysis.counter depth])}
}
# Statement `i` of a block falls through to the next `return` statement of
# that block. Transfers directly in statement `i` (not in a nested loop) are
# candidates up to the end of that return.
Span:type = const [first:addr finish:addr returns:bool]
walk_block = (items:array<addr> depth:addr nested:bool nodes:array<hir.AST> donations:dict<addr set<addr>> @analysis:Analysis):>void => {
    let spans:array<Span>=[]
    loop item in items {
        let first=analysis.transfers.length
        walk(item depth nested nodes donations @analysis)
        spans.push(Span[first analysis.counter hir.node_at(nodes item) is? hir.Return])
    }
    if nested return
    let until:addr?=none
    let last=analysis.transfers.length
    let i=spans.length
    loop i >? 0 {
        i-=1
        let span=spans[i]
        let stop=last
        last=span.first
        if span.returns {until=span.finish continue}
        if until is? none continue
        let k=span.first
        loop k <? stop and k <? analysis.transfers.length {
            let transfer=analysis.transfers[k]
            k+=1
            if transfer.depth not=? depth continue
            if transfer.binding not in? analysis.candidates {analysis.candidates[transfer.binding]=[]}
            let pending=@analysis.candidates[transfer.binding]
            pending.push(Candidate[transfer.id transfer.sequence until])
        }
    }
}

walk_transfer = (id:addr depth:addr nested:bool returned:bool nodes:array<hir.AST> donations:dict<addr set<addr>> @analysis:Analysis):>void => {
    let inner=peel(id nodes)
    let node=hir.node_at(nodes inner)
    if node is? hir.ExpressedIdentifier {
        if node.binding_id isnt? none {note_use(inner node.binding_id depth nested true returned @analysis)}
        return
    }
    if node is? hir.MemberAccess {
        # A field transfer needs the complete containing owner's last-use
        # proof, including readers through aliases. The storage boundary
        # separately checks that this is an owned descriptor field.
        let root=hir.node_at(nodes node.value)
        loop root is? hir.MemberAccess {root=hir.node_at(nodes root.value)}
        if root is? hir.ExpressedIdentifier and root.binding_id isnt? none {
            note_use(inner root.binding_id depth nested true returned @analysis)
            return
        }
    }
    # Value conditionals hand over only the selected arm. Conditions are
    # evaluated first; the result leaves share the enclosing transfer site.
    if node is? hir.Flow {
        let conditional=true
        loop arm in node.arms {if hir.node_at(nodes arm) isnt? hir.IfArm {conditional=false}}
        if conditional {
            analysis.next_conditional+=1
            let choice=analysis.next_conditional
            loop arm_id in node.arms {
                let arm=hir.node_at(nodes arm_id)
                $runtime_assert arm is? hir.IfArm
                walk(arm.condition depth nested nodes donations @analysis)
                walk_branch(arm.body choice depth nested true returned nodes donations @analysis)
            }
            if node.default isnt? none {walk_branch(node.default choice depth nested true returned nodes donations @analysis)}
            return
        }
    }
    if node is? hir.Block and node.items.length>?0 {
        let last=node.items[node.items.length-1]
        if hir.node_at(nodes last).value_type =? node.value_type {
            let preceding:array<addr>=[]
            loop i in 0.. and i<?node.items.length-1 {preceding.push(node.items[i])}
            walk_block(preceding depth nested nodes donations @analysis)
            walk_transfer(last depth nested returned nodes donations @analysis)
            return
        }
    }
    walk(id depth nested nodes donations @analysis)
}

walk = (id:addr depth:addr nested:bool nodes:array<hir.AST> donations:dict<addr set<addr>> @analysis:Analysis):>void => {
    let node=hir.node_at(nodes id)
    if node is? hir.FunctionLiteral {
        walk(node.body depth true nodes donations @analysis)
        return
    }
    if node is? hir.Declare {
        walk_transfer(node.expr depth nested false nodes donations @analysis)
        if not nested and node.binding_id isnt? none {
            analysis.counter+=1
            analysis.declared[node.binding_id]=depth
        }
        return
    }
    if node is? hir.ExpressedIdentifier {
        if node.binding_id isnt? none {note_use(id node.binding_id depth nested false false @analysis)}
        return
    }
    if node is? hir.Break|hir.Continue {
        analysis.counter+=1
        if not nested {analysis.exits.push(analysis.counter)}
        return
    }
    if node is? hir.Block {
        walk_block(node.items depth nested nodes donations @analysis)
        return
    }
    if node is? hir.Return {
        let first=analysis.transfers.length
        if node.item isnt? none {walk_transfer(node.item depth nested true nodes donations @analysis)}
        if not nested {
            let index=first
            loop index <? analysis.transfers.length {
                let transfer=analysis.transfers[index]
                index+=1
                if transfer.depth not=? depth continue
                if transfer.binding not in? analysis.candidates {analysis.candidates[transfer.binding]=[]}
                let candidates=@analysis.candidates[transfer.binding]
                candidates.push(Candidate[transfer.id transfer.sequence analysis.counter])
            }
        }
        return
    }
    if node is? hir.ObjectLiteral {
        loop field in node.fields {walk_transfer(field.value depth nested false nodes donations @analysis)}
        return
    }
    if node is? hir.ArrayLiteral {
        loop item in node.items {walk_transfer(item depth nested false nodes donations @analysis)}
        return
    }
    if node is? hir.MemberAssign|hir.IndexAssign {
        walk(node.target depth nested nodes donations @analysis)
        walk_transfer(node.value depth nested false nodes donations @analysis)
        return
    }
    if node is? hir.DictStore {
        walk(node.keys depth nested nodes donations @analysis)
        if node.values isnt? none {walk(node.values depth nested nodes donations @analysis)}
        walk(node.key depth nested nodes donations @analysis)
        if node.value isnt? none {walk_transfer(node.value depth nested false nodes donations @analysis)}
        return
    }
    if node is? hir.Assign {
        # The target is written, not read.
        walk_transfer(node.value depth nested false nodes donations @analysis)
        return
    }
    if node is? hir.FunctionCall and id in? donations {
        let donated=donations[id]
        walk(node.func depth nested nodes donations @analysis)
        loop argument in node.pos_args {
            if argument in? donated {walk_transfer(argument depth nested false nodes donations @analysis)}
            else {walk(argument depth nested nodes donations @analysis)}
        }
        loop [name argument] in node.kw_args {
            if argument in? donated {walk_transfer(argument depth nested false nodes donations @analysis)}
            else {walk(argument depth nested nodes donations @analysis)}
        }
        return
    }
    if node is? hir.FunctionCall {
        # A pushed or inserted value becomes an element the array owns.
        let callee=hir.node_at(nodes node.func)
        if callee is? hir.ArrayMethod and callee.name in? ['push' 'insert'] {
            walk(node.func depth nested nodes donations @analysis)
            loop i in 0.. and i <? node.pos_args.length {
                if i =? 0 {walk_transfer(node.pos_args[i] depth nested false nodes donations @analysis)}
                else {walk(node.pos_args[i] depth nested nodes donations @analysis)}
            }
            loop [name argument] in node.kw_args {
                if name =? 'value' and node.pos_args.length =? 0 {walk_transfer(argument depth nested false nodes donations @analysis)}
                else {walk(argument depth nested nodes donations @analysis)}
            }
            return
        }
    }
    if node is? hir.Flow {
        let conditional=true
        loop arm_id in node.arms {if hir.node_at(nodes arm_id) isnt? hir.IfArm {conditional=false}}
        analysis.next_conditional+=1
        let choice=analysis.next_conditional
        loop arm_id in node.arms {
            let arm=hir.node_at(nodes arm_id)
            let arm_depth:addr=depth
            if arm is? hir.LoopArm {arm_depth=depth+1}
            if arm is? hir.IfArm|hir.LoopArm {
                walk(arm.condition arm_depth nested nodes donations @analysis)
                if conditional {walk_branch(arm.body choice arm_depth nested false false nodes donations @analysis)}
                else {walk(arm.body arm_depth nested nodes donations @analysis)}
            }
        }
        if node.default isnt? none {
            if conditional {walk_branch(node.default choice depth nested false false nodes donations @analysis)}
            else {walk(node.default depth nested nodes donations @analysis)}
        }
        return
    }
    let children:array<addr>=[]
    hir.push_children(node @children)
    # Recursion mutates only analysis. Read each scalar child id directly;
    # no owning iterator snapshot of this private work list is needed.
    let index:addr=0
    loop index <? children.length {walk(children[index] depth nested nodes donations @analysis) index+=1}
}

# The value uses (node ids) of `literal` that can transfer owned storage.
# A storage borrow extends its owner's liveness through every use of the
# borrowed binding, including further borrows of that binding. Keep this
# dependency separate from ordinary value reads: copying a scalar field does
# not keep its former owner alive.
borrow_live_after = (binding:addr sequence:addr path:addr borrows:dict<addr set<addr>> analysis:Analysis):>bool => {
    let pending:array<addr>=[binding]
    let visited:set<addr>=set[]
    loop pending.length >? 0 {
        let owner=pending.pop
        if owner in? visited continue
        visited.push(owner)
        if owner not in? borrows continue
        loop borrower in borrows[owner] {
            if borrower in? analysis.uses {loop use in analysis.uses[borrower] {
                if use.nested or (use.sequence >? sequence and compatible(path use.path analysis.paths)) return true
            }}
            pending.push(borrower)
        }
    }
    return false
}
compute = (literal:addr nodes:array<hir.AST> table:types.Table borrows:dict<addr set<addr>>=[] donations:dict<addr set<addr>>=[] parameters:set<addr>=set[]):>set<addr> => {
    let function=hir.node_at(nodes literal)
    let moves:set<addr>=set[]
    if function isnt? hir.FunctionLiteral return moves
    # The immutable call-donation map belongs to the whole program. Keep it
    # as a borrowed input instead of copying it into each function's mutable
    # analysis state.
    let analysis=Analysis[]
    # Caller-donated inputs are lexical owners from function entry. They
    # obey the same later-read and live-borrow constraints as local owners.
    loop parameter in function.pos_or_kw_args {
        if parameter.binding_id isnt? none and parameter.binding_id in? parameters {analysis.declared[parameter.binding_id]=0}
    }
    loop parameter in function.kw_only_args {
        if parameter.binding_id isnt? none and parameter.binding_id in? parameters {analysis.declared[parameter.binding_id]=0}
    }
    walk(function.body 0 false nodes donations @analysis)
    loop [binding uses] in analysis.uses {
        let declared=analysis.declared.get(binding)
        if declared is? none or uses.length =? 0 continue
        let nested=false
        loop use in uses {
            if use.nested {nested=true}
        }
        if nested continue
        # A `return` leaves every path: a returned local is always at its
        # last use there, whatever follows the return in the text.
        loop use in uses {if use.returned {moves.push(use.id)}}
        if binding in? analysis.candidates {loop candidate in analysis.candidates[binding] {
            if candidate.id in? moves or not quiet_until(binding candidate analysis) continue
            if borrow_live_between(binding candidate.sequence candidate.until borrows analysis) continue
            moves.push(candidate.id)
        }}
        # Match the hosted finite comparison budget. Exhaustion retains the
        # copy. The syntactic last read needs no comparison at all.
        let budget:addr=4096
        let cursor=uses.length
        loop cursor >? 0 {
            cursor-=1
            let use=uses[cursor]
            if not use.transfer or use.id in? moves or use.depth >? declared continue
            let live=false
            let later=uses.length
            loop later >? cursor+1 {
                later-=1
                if budget=?0 {live=true break}
                budget-=1
                if compatible(use.path uses[later].path analysis.paths) {live=true break}
            }
            if not live and not borrow_live_after(binding use.sequence use.path borrows analysis) {moves.push(use.id)}
        }
    }
    # The logical ownership pass already joins field paths across branches
    # and loop backedges. Reuse it when only siblings remain live; a root
    # with a dependent view keeps the conservative whole-owner proof.
    let field_candidates:set<addr>=set[]
    let field_owners:set<addr>=set[]
    let eligible:dict<addr bool>=[]
    loop [binding uses] in analysis.uses {
        if binding not in? analysis.declared or binding in? borrows continue
        loop use in uses {
            if not use.transfer or use.id in? moves continue
            let field=hir.node_at(nodes use.id)
            if field isnt? hir.MemberAccess continue
            let array=types.node_at(table views.structural_base(field.value_type table))
            let receiver=types.node_at(table views.structural_base(hir.node_at(nodes field.value).value_type table))
            if array isnt? types.ArrayType or receiver isnt? types.ObjectType continue
            let slot=types.object_field(receiver field.name)
            if slot is? none continue
            let stored=types.node_at(table views.structural_base(slot.value_type table))
            if stored isnt? types.ArrayType or stored.length isnt? none or not types.same_type(stored.element array.element table) continue
            let root=hir.node_at(nodes field.value)
            loop root is? hir.MemberAccess {root=hir.node_at(nodes root.value)}
            if root isnt? hir.ExpressedIdentifier or not storage_borrows.ordinary(root.value_type table @eligible) continue
            field_candidates.push(use.id) field_owners.push(binding)
        }
    }
    if field_candidates.length>?0 {
        let logical=ownership_liveness.consumptions(function.body field_owners nodes table)
        loop site in field_candidates {if site in? logical.consumes {moves.push(site)}}
    }
    return moves
}
# No use of the binding and no loop exit between a candidate and its return.
quiet_until = (binding:addr candidate:Candidate analysis:Analysis):>bool => {
    if binding in? analysis.uses {loop use in analysis.uses[binding] {
        if use.sequence >? candidate.sequence and use.sequence <=? candidate.until return false
    }}
    loop exit in analysis.exits {
        if exit >? candidate.sequence and exit <=? candidate.until return false
    }
    return true
}
borrow_live_between = (binding:addr sequence:addr until:addr borrows:dict<addr set<addr>> analysis:Analysis):>bool => {
    let pending:array<addr>=[binding]
    let visited:set<addr>=set[]
    loop pending.length >? 0 {
        let owner=pending.pop
        if owner in? visited continue
        visited.push(owner)
        if owner not in? borrows continue
        loop borrower in borrows[owner] {
            if borrower in? analysis.uses {loop use in analysis.uses[borrower] {
                if use.nested or (use.sequence >? sequence and use.sequence <=? until) return true
            }}
            pending.push(borrower)
        }
    }
    return false
}

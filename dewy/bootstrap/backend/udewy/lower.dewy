loop_checkpoint = (node:hir.AST @state:State):>addr => {
    $runtime_assert state.loop_levels isnt? none and state.loop_kind isnt? none
    let levels=state.loop_levels
    let kind=state.loop_kind
    let boolean=types.primitive('bool' @state.type_nodes)
    let bottom=types.primitive('never' @state.type_nodes)
    let stop=put(hir.Break[node.loc bottom] @state)
    let next=put(hir.Continue[node.loc bottom] @state)
    let stopping=intrinsic_call('__eq__' [kind word(1 node @state)] boolean node @state)
    let stopped=sequence([loop_assignment(kind word(0 node @state) node @state) stop] node @state)
    let continued=sequence([loop_assignment(kind word(0 node @state) node @state) next] node @state)
    let arm=put(hir.IfArm[node.loc bottom stopping stopped] @state)
    let dispatch=put(hir.Flow[node.loc bottom [arm] continued] @state)
    # At the exit site only the innermost body is cleaned. Its iterator
    # storage is released after the loop. Clean this enclosing body now;
    # releasing every target frame at the original site would double-release
    # iterator storage while unwinding through these checkpoints.
    let cleanup=loop_cleanup(node @state)
    let target=cleanup
    target.push(loop_assignment(levels word(0 node @state) node @state))
    target.push(dispatch)
    let propagate=cleanup
    propagate.push(loop_assignment(levels word_op('__sub__' levels word(1 node @state) node @state) node @state))
    propagate.push(stop)
    return sequence([
        conditional(intrinsic_call('__eq__' [levels word(1 node @state)] boolean node @state) sequence(target node @state) node @state)
        conditional(intrinsic_call('__gt__' [levels word(1 node @state)] boolean node @state) sequence(propagate node @state) node @state)

# Nested defaults retain lazy setup for later loop arms and the existing
# rule that `else` runs only when that loop arm never entered.
flow_value = (id:addr expected:addr @state:State):>addr => {
    let source=hir.node_at(state.input.nodes id)
    let value=if state.cleanup_enabled cleanup_scoped(id @state) else expression(id @state)
    if source.value_type =? expected return value
    if types.is_primitive(types.node_at(state.type_nodes expected) 'void') return value
    let actual=types.node_at(state.type_nodes types.unfold(source.value_type state.type_nodes))
    if types.is_primitive(actual 'void') or types.is_primitive(actual 'never') return value
    # The selected arm owns its result when cleanup is active. A union's
    # record payload may have a smaller allocation than its joined parent;
    # unpacking its address alone would leak the cell and free the payload
    # later through the parent's (wrong) allocator size class.
    if state.cleanup_enabled {
        if cell_members(source.value_type @state) isnt? none return convert_owned_cell(value source.value_type expected source @state)
        if object_valued(source.value_type state) and object_valued(expected state) return owned_record(value source.value_type expected source @state)
    }
    # Inferred joins need the same representation on every returning path.
    # A narrowed optional payload is a word; the other arm may still be a
    # cell. The flow result must materialize the word into the joined cell.
    if enum_members(expected state) isnt? none return enum_pack(value source.value_type expected source @state)
    if cell_members(expected @state) isnt? none return cell_pack(value source.value_type expected source @state owned=state.cleanup_enabled)
    return read_value(value source.value_type expected source @state)
}
# µDewy has only nearest-loop exits. A nonlocal exit breaks the innermost
# loop with a remaining distance and kind. The checkpoint after that loop
# either handles the target or propagates another break. Generated helper
# loops never affect this source-loop distance.
loop_assignment = (target:addr value:addr node:hir.AST @state:State):>addr => put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) target '=' value] @state)
loop_cleanup = (node:hir.AST @state:State):>array<addr> => {
    if not state.cleanup_enabled or state.cleanup_loops.length =? 0 return []
    let last=state.cleanup_loops.length-1
    $runtime_assert last <? state.cleanup_loops.length
    return cleanup_since(state.cleanup_loops[last] node @state)
}
loop_exit = (node:hir.Break|hir.Continue @state:State):>addr => {
    let prefix=loop_cleanup(node @state)
    let bottom=types.primitive('never' @state.type_nodes)
    if node.loop_levels =? 0 {
        prefix.push(put(if node is? hir.Break hir.Break[node.loc bottom] else hir.Continue[node.loc bottom] @state))
    } else {
        if state.loop_levels is? none {
            let declarations:array<addr>=[]
            state.loop_levels=snapshot(word(0 node @state) @declarations @state)
            state.loop_kind=snapshot(word(0 node @state) @declarations @state)
            state.loop_prologue=declarations
        }
        $runtime_assert state.loop_levels isnt? none and state.loop_kind isnt? none
        let levels=state.loop_levels
        let kind=state.loop_kind
        prefix.push(loop_assignment(levels word(node.loop_levels node @state) node @state))
        prefix.push(loop_assignment(kind word(if node is? hir.Break 1 else 2 node @state) node @state))
        prefix.push(put(hir.Break[node.loc bottom] @state))
    }
    return put(hir.Block[node.loc bottom prefix false] @state)

from reporting import Error, Pointer, SrcFile
import p"emit.dewy" as emit
import p"program.dewy" as program
import p"statements.dewy" as statements
import p"layouts.dewy" as layouts
import p"captures.dewy" as captures
import p"borrowing.dewy" as borrowing
import p"../../semantic/hir.dewy" as hir
import p"../../semantic/ty.dewy" as types
import p"../../semantic/type_queries.dewy" as views
import p"../../semantic/builtins.dewy" as builtins
import p"../../semantic/brands.dewy" as brands
import p"../../semantic/subtyping.dewy" as subtyping
import p"../../semantic/type_tests.dewy" as type_tests

doc"""
Legalize validated semantic HIR into concrete µDewy function units.

Binding ids choose symbols, so source shadowing and imported names cannot
silently capture each other during hoisting. Input nodes remain immutable;
the output arena has its own indices and shares only the type arena values.

Scalar and aggregate storage preserves independent value copies through
arguments, defaults, returns, records, and nested arrays. Cached recursive
copy helpers preserve dynamic brands and the active payload of union cells.
Strings use immutable UTF-8 views with grapheme boundary tables; byte-array
conversions create independent storage. Iterator setup remains local to its
flow arm, and advancing happens before each condition, including continue.

Places share binding slots or inline record/cell storage through fields,
indices, and forwarded parameters. Local functions are hoisted; direct calls
pass read-only captures as hidden arguments, as in the hosted backend.
Escaping closures remain a subsequent step. An unsupported representation reports a
pending-implementation diagnostic before program emission.
"""
OwnedLocal:type = const [value:addr value_type:addr box:addr?=none condition:addr?=none]
ScalarProjection:type = const [function:addr read:addr field:string result:addr symbol:string]
State:type = [
    input:emit.Input
    source:SrcFile
    source_index:addr?=none
    nodes:array<hir.AST>=[]
    type_nodes:types.Table=types.Table[]
    symbols:dict<addr string>=[]
    serial:addr=0
    # The driver identifies the prelude allocator by binding, not spelling.
    allocator:addr?=none
    runtime_helpers:dict<string addr>=[]
    layout_context:layouts.Context=layouts.Context[]
    record_layouts:dict<addr layouts.Record>=[]
    links:array<subtyping.Link>=subtyping.default_links
    brand_numbers:dict<string brands.NumberedBrand>=[]
    # Checked descriptions stay stable while lowering only appends runtime
    # types. Each successful representation is validated once in this state.
    runtime_types:dict<addr addr>=[]
    # A real cell has alternatives; an empty cached list means no cell.
    cell_types:dict<addr array<addr>>=[]
    storage_types:dict<addr addr>=[]
    capture_plan:captures.Plan=captures.Plan[]
    borrowed_arguments:dict<addr set<addr>>=[]
    disposable_arguments:dict<addr set<addr>>=[]
    code_symbols:dict<addr string>=[]
    # A place is an address of the binding's storage, including the handle
    # slot for an aggregate. Replacing a record/array through @ must replace
    # that slot rather than merely mutate the old object's contents.
    boxed:set<addr>=set[]
    addressed:set<addr>=set[]
    place_parameters:set<addr>=set[]
    union_tags:dict<string addr>=[]
    next_tag:addr=1
    copy_helpers:dict<string string>=[]
    release_helpers:dict<string string>=[]
    cleanup_enabled:bool=false
    cleanup_frames:array<array<OwnedLocal>>=[]
    cleanup_loops:array<addr>=[]
    # Program-wide capture/place exclusions are computed once. Rebuilding
    # this set in every function revisited the entire function graph N times.
    cleanup_excluded:set<addr>=set[]
    cleanup_owned:set<addr>=set[]
    generated:array<program.Function>=[]
    getter_reads:dict<addr addr?>=[]
    scalar_projections:dict<string ScalarProjection>=[]
    pending_projections:array<ScalarProjection>=[]
    result_projection:ScalarProjection?=none
    problem:Error?=none
]
Result:type = const [program:program.Program input:emit.Input]
put = (node:hir.AST @state:State):>addr => hir.append_node(@state.nodes node)
reject = (node:hir.AST detail:string @state:State):>addr => {
    if state.problem is? none {state.problem=Error[srcfile=state.source title='native lowering implementation pending' pointers=[Pointer[node.loc detail]]]}
    return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
}
symbol = (name:string binding:addr? @state:State):>string => {
    if binding is? none return name
    let existing=state.symbols.get(binding)
    if existing isnt? none return existing
    # Intrinsics have no runtime declarations; discovery preinstalls symbols
    # for every source declaration, including a declaration shadowing one.
    return name
}
# Unit error mints occupy one zero payload word. Their identity travels in
# a surrounding union's tag; the compilation supplies the nominal registry
# and links so a test against the exception/error family selects those tags.
unit_type = (id:addr state:State):>bool => {
    let plain=types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes)
    return plain in? state.layout_context.nominals or types.is_primitive(types.node_at(state.type_nodes plain) 'none')
}
runtime_type = (id:addr node:hir.AST @state:State):>addr => {
    let cached=state.runtime_types.get(id)
    if cached isnt? none return cached
    let result=runtime_type_uncached(id node @state)
    # Failure locations belong to their source use. Do not memoize a fallback
    # representation from a failed validation as if it were a supported type.
    if state.problem is? none {state.runtime_types[id]=result}
    return result
}
runtime_type_uncached = (id:addr node:hir.AST @state:State):>addr => {
    # A negative type test restricts values without changing the positive
    # family's storage. Keep those exclusions out of representation queries.
    let plain=views.structural_base(id state.type_nodes)
    let type=types.node_at(state.type_nodes plain)
    if type is? types.QuantityType return runtime_type(type.number node @state)
    if type is? types.IntegerLiteralType {
        if type.value <? -9223372036854775808 or type.value >? 9223372036854775807 {reject(node 'arbitrary-precision integer storage' @state);}
        return types.primitive('int64' @state.type_nodes)
    }
    if unit_type(plain state) return types.primitive('int64' @state.type_nodes)
    if type is? types.Primitive {
        if type.name in? ['int' 'uint'] return types.primitive(if type.name =? 'int' 'int64' else 'uint64' @state.type_nodes)
        if type.name in? ['bool' 'void' 'never'] or views.fixed_integer_layout(plain state.type_nodes) isnt? none return plain
    }
    if enum_members(id state) isnt? none return types.primitive('int64' @state.type_nodes)
    if cell_members(id @state) isnt? none or types.is_primitive(type 'none') return types.primitive('int64' @state.type_nodes)
    if string_type(id state) return types.primitive('int64' @state.type_nodes)
    if type is? types.BinaryLiteralType return types.primitive('int64' @state.type_nodes)
    if type is? types.ArrayType {
        let element=types.node_at(state.type_nodes types.unfold(types.strip_refinement(type.element state.type_nodes) state.type_nodes))
        if element isnt? types.ObjectType|types.ArrayType|types.FunctionType and cell_members(type.element @state) is? none and enum_members(type.element state) is? none and not string_type(type.element state) and not types.is_primitive(element 'bool') and not unit_type(type.element state) and views.fixed_integer_layout(type.element state.type_nodes) is? none {reject(node 'array elements requiring owned aggregate storage' @state);}
        return types.primitive('int64' @state.type_nodes)
    }
    if type is? types.ObjectType {
        loop field in type.fields {runtime_type(field.value_type node @state);}
        return types.primitive('int64' @state.type_nodes)
    }
    if type is? types.FunctionType {
        if type.type_params.length >? 0 or type.rest isnt? none {reject(node 'generic or rest function signatures' @state);}
        let arguments:array<types.PosOrKwArg>=[]
        loop argument in type.pos_or_kw {
            arguments.push(types.PosOrKwArg[argument.name if argument.place types.primitive('int64' @state.type_nodes) else runtime_type(argument.value_type node @state)])
            if not argument.required {arguments.push(types.PosOrKwArg[none types.primitive('bool' @state.type_nodes)])}
        }
        loop argument in type.kw_only {
            arguments.push(types.PosOrKwArg[argument.name if argument.place types.primitive('int64' @state.type_nodes) else runtime_type(argument.value_type node @state)])
            if not argument.required {arguments.push(types.PosOrKwArg[none types.primitive('bool' @state.type_nodes)])}
        }
        return types.function_type(arguments [] none runtime_type(type.ret node @state) [] @state.type_nodes)
    }
    reject(node 'selecting a concrete representation for this value type' @state);
    return types.primitive('void' @state.type_nodes)
}

# Discover before lowering any initializer/body, preserving forward function
# references. A later capture pass can use the same binding-to-symbol map.
parameters = (node:hir.FunctionLiteral):>array<hir.Param> => {
    let result=node.pos_or_kw_args
    loop parameter in node.kw_only_args {result.push(parameter)}
    return result
}
discover = (id:addr @state:State):>void => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Place {
        let target=hir.node_at(state.input.nodes node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            state.addressed.add(target.binding_id)
            if not inline_place(node.value_type @state) {state.boxed.add(target.binding_id)}
        }
    }
    if node is? hir.Declare and node.binding_id isnt? none {
        state.symbols[node.binding_id]="__dewy_binding_{node.binding_id}_{node.name}"
        state.storage_types[node.binding_id]=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
    }
    if node is? hir.ObjectLiteral {
        loop field in node.fields {
            if field.binding_id isnt? none {
                state.symbols[field.binding_id]="__dewy_binding_{field.binding_id}_{field.name}"
                state.storage_types[field.binding_id]=hir.node_at(state.input.nodes field.value).value_type
            }
        }
    }
    if node is? hir.FunctionLiteral {
        loop parameter in parameters(node) {
            if parameter.binding_id isnt? none {state.symbols[parameter.binding_id]="__dewy_binding_{parameter.binding_id}_{parameter.name}" state.storage_types[parameter.binding_id]=parameter.value_type}
            if parameter.place and parameter.binding_id isnt? none {
                state.addressed.add(parameter.binding_id)
                state.place_parameters.add(parameter.binding_id)
                if not inline_place(parameter.value_type @state) {state.boxed.add(parameter.binding_id)}
            }
        }
    }
    if node is? hir.IteratorExpression {
        let target=hir.node_at(state.input.nodes node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            state.symbols[target.binding_id]="__dewy_binding_{target.binding_id}_{target.name}"
            state.storage_types[target.binding_id]=target.value_type
        }
    }
    loop child in hir.children(node) {discover(child @state)}
}
items = (ids:array<addr> @state:State):>array<addr> => {
    let result:array<addr>=[]
    loop id in ids {result.push(expression(id @state))}
    return result
}
# Exact rational scales and ranges remain compile-time bindings, as in the
# hosted backend. Checking resolves their supported uses; a surviving runtime
# read still receives the ordinary unsupported-representation diagnostic.
compile_time_binding = (node:hir.Declare state:State):>bool => {
    let id=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes))
    if type is? types.QuantityType {type=types.node_at(state.type_nodes type.number)}
    return type is? types.RationalLiteralType or types.is_primitive(type 'range')
}
expression = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if state.problem isnt? none return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
    if node is? hir.ValueCast {
        let actual=hir.node_at(state.input.nodes node.expr).value_type
        if object_valued(actual state) and object_valued(node.value_type state) and expression_owns(node.expr @state) return owned_record(expression(node.expr @state) actual node.value_type node @state)
        if temporary_owner(node.expr @state) {
            if cell_members(actual @state) isnt? none return owned_cell_cast(node actual @state)
            if cell_members(node.value_type @state) isnt? none return cell_pack(owned_value(node.expr @state) actual node.value_type node @state owned=true)
        }
        if enum_members(node.value_type state) isnt? none return enum_pack(expression(node.expr @state) actual node.value_type node @state)
        if enum_members(actual state) isnt? none return enum_read(expression(node.expr @state) actual node.value_type node @state)
        # A logical upcast can leave a narrowed union representation behind:
        # (Record & ~Child) | Child fits Record, but its cell must be unpacked
        # before a caller reads Record fields or makes an owned record copy.
        return read_value(expression(node.expr @state) actual node.value_type node @state)
    }
    if node is? hir.Suppress return expression(node.item @state)
    if node is? hir.Place return place_address(node.target @state)
    if node is? hir.GenericFunction|hir.OverloadedFunction return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
    let type=runtime_type(node.value_type node @state)
    if node is? hir.String return string_literal(node @state)
    if node is? hir.BasedString return binary_literal(node @state)
    if node is? hir.StringConcat return string_concat(node @state)
    if node is? hir.InterpolatedString return interpolated_string(node @state)
    if node is? hir.StringLength {
        let prefix:array<addr>=[]
        let receiver=read_operand(node.string @prefix @state)
        return finish_read(read_word(receiver.value layouts.string_descriptor.grapheme_length node @state) receiver node @prefix @state)
    }
    if node is? hir.StringIndex return string_index(node @state)
    if node is? hir.StringSlice return string_slice(node @state)
    if node is? hir.StringEqual return string_equal(node @state)
    if node is? hir.RuntimeFailure {
        if node.lowered is? none return reject(node 'runtime failure without installed reporting helpers' @state)
        return expression(node.lowered @state)
    }
    if node is? hir.RepresentationCast return representation(node @state)
    if node is? hir.ObjectLiteral return object_literal(node @state)
    if node is? hir.TypeTest return runtime_test(node @state)
    if node is? hir.ForwardingAccess return forwarding_field(node @state)
    if node is? hir.DictContains return dict_contains(node @state)
    if node is? hir.DictLookup return dict_lookup(node @state)
    if node is? hir.DictStore return dict_store(node @state)
    if node is? hir.DictRemove return dict_remove(node @state)
    if node is? hir.DictEntries return dict_entries(node @state)
    if node is? hir.DictView return dict_view(node @state)
    if node is? hir.SetAlgebra return set_algebra(node @state)
    if node is? hir.NoneValue|hir.ErrorValue return word(0 node @state)
    if node is? hir.MemberAccess {
        # Most fields read a local, not a call result. Inspect its brand in
        # place before asking for a variant, avoiding a record/cell snapshot
        # on every ordinary field access just to rule this optimization out.
        $runtime_assert node.value <? state.input.nodes.length
        if state.input.nodes[node.value] is? hir.FunctionCall {
            let projection=scalar_getter_projection(node @state)
            if projection isnt? none {
                let call=hir.node_at(state.input.nodes node.value)
                $runtime_assert call is? hir.FunctionCall
                return ordinary_call(node.value call runtime_type(node.value_type node @state) @state projection=projection)
            }
        }
        let stored=stored_type(id state)
        let prefix:array<addr>=[]
        let receiver=read_operand(node.value @prefix @state)
        let pointer=field_address(receiver.value node @state)
        let value=read_value(field_read(pointer stored node @state) stored node.value_type node @state)
        return finish_read(value receiver node @prefix @state)
    }
    if node is? hir.MemberAssign {
        let target=hir.node_at(state.input.nodes node.target)
        if target isnt? hir.MemberAccess return reject(node 'a non-record member assignment' @state)
        let prefix:array<addr>=[]
        let pointer=snapshot(field_pointer(target @state writable=true) @prefix @state)
        let source=snapshot(owned_value(node.value @state) @prefix @state)
        let stored=stored_type(node.target state)
        if object_valued(stored state) {prefix.push(release_record(pointer stored node @state))}
        else if cell_members(stored @state) isnt? none {prefix.push(release_cell(pointer stored node @state))}
        else if releasable(stored @state) {prefix.push(release_value(field_read(pointer stored node @state) stored node @state))}
        prefix.push(field_write(pointer source stored node @state))
        # Inline record/cell writes copy into the field; the temporary wrapper
        # and its independent contents are no longer needed after that copy.
        if object_valued(stored state) or cell_members(stored @state) isnt? none {prefix.push(release_value(source stored node @state))}
        return sequence(prefix node @state)
    }
    if node is? hir.ArrayLiteral return array_literal(node @state)
    if node is? hir.ArrayLength {
        let prefix:array<addr>=[]
        let receiver=read_operand(node.array @prefix @state)
        let value=read_word(receiver.value layouts.array_descriptor.length node @state)
        return finish_read(value receiver node @prefix @state)
    }
    if node is? hir.Index {
        let prefix:array<addr>=[]
        let receiver=read_operand(node.array @prefix @state)
        let descriptor=snapshot(receiver.value @prefix @state)
        let pointer=array_element_address(descriptor expression(node.index @state) node @state)
        let stored=stored_type(id state)
        let value=read_value(array_load(pointer stored node @state) stored node.value_type node @state)
        return finish_read(value receiver node @prefix @state)
    }
    if node is? hir.IndexAssign {
        let target=hir.node_at(state.input.nodes node.target)
        if target isnt? hir.Index return reject(node 'a non-array index assignment' @state)
        let prefix:array<addr>=[]
        let descriptor=snapshot(write_route(target.array @state) @prefix @state)
        let index=snapshot(expression(target.index @state) @prefix @state)
        let stored=stored_type(node.target state)
        prefix.push(array_unique(descriptor stored node @state))
        let pointer=snapshot(array_element_address(descriptor index target @state) @prefix @state)
        let replacement=snapshot(owned_value(node.value @state) @prefix @state)
        # Raw exposure pins the entire container tree. An untracked pointer
        # can still name the previous record or cell after this replacement.
        let tracked=compare('__ne__' read_word(descriptor layouts.array_descriptor.owner node @state) word(-1 node @state) node @state)
        prefix.push(conditional(tracked release_value(array_load(pointer stored node @state) stored node @state) node @state))
        prefix.push(array_store(replacement pointer stored node @state))
        return put(hir.Block[node.loc type prefix false] @state)
    }
    if node is? hir.Void return put(hir.Void[node.loc type] @state)
    if node is? hir.Integer return put(hir.Integer[node.loc type node.prefix node.value] @state)
    if node is? hir.Bool return put(hir.Bool[node.loc type node.value] @state)
    if node is? hir.ExpressedIdentifier {
        let function=if node.binding_id is? none none else state.capture_plan.named.get(node.binding_id)
        if function isnt? none return function_value(function node @state)
        let stored=stored_type(id state)
        let raw=binding_storage(node stored @state)
        if node.binding_id isnt? none and node.binding_id in? state.boxed {raw=array_load(raw stored node @state)}
        return read_value(raw stored node.value_type node @state)
    }
    if node is? hir.Transmute {
        let source=hir.node_at(state.input.nodes node.expr)
        let value=expression(node.expr @state)
        if aggregate(source.value_type state) and not aggregate(node.value_type state) {value=pin_value(value source.value_type node @state)}
        return put(hir.Transmute[node.loc type value] @state)
    }
    if node is? hir.Return and state.cleanup_enabled return cleanup_return(node @state)
    if node is? hir.Return return put(hir.Return[node.loc type if node.item is? none none else owned_value(node.item @state)] @state)
    if node is? hir.Declare {
        if compile_time_binding(node state) return put(hir.Void[node.loc type] @state)
        if hir.node_at(state.input.nodes node.expr) is? hir.FunctionLiteral|hir.OverloadedFunction return put(hir.Void[node.loc type] @state)
        let value=owned_value(node.expr @state)
        let annotation=runtime_type(if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation node @state)
        if node.binding_id isnt? none and node.binding_id in? state.boxed {
            value=box_value(value if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation node @state)
            annotation=types.primitive('int64' @state.type_nodes)
        }
        if state.cleanup_enabled and node.binding_id isnt? none and node.binding_id not in? state.cleanup_excluded and state.cleanup_frames.length >? 0 {
            let stored=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
            if releasable(stored @state) {
                let read=put(hir.ExpressedIdentifier[node.loc annotation symbol(node.name node.binding_id @state) node.binding_id] @state)
                $runtime_assert state.cleanup_frames.length >? 0
                let frame=state.cleanup_frames.pop
                let box:addr?=none
                if node.binding_id in? state.boxed {box=read read=array_load(read stored node @state)}
                frame.push(OwnedLocal[read stored box])
                state.cleanup_owned.add(node.binding_id)
                state.cleanup_frames.push(frame)
            }
        }
        return put(hir.Declare[node.loc type node.decltype symbol(node.name node.binding_id @state) annotation value node.binding_id] @state)
    }
    if node is? hir.Assign {
        let original=hir.node_at(state.input.nodes node.target)
        if original isnt? hir.ExpressedIdentifier return reject(node 'a non-binding assignment target' @state)
        let stored=stored_type(node.target state)
        let target=binding_storage(original stored @state)
        let boxed=original.binding_id isnt? none and original.binding_id in? state.boxed
        let value=owned_value(node.value @state)
        if node.op not=? '=' {
            if node.op.length <? 2 return reject(node 'invalid compound assignment spelling' @state)
            let operator=node.op[0..node.op.length-1)
            let name=builtins.binary_operators.get(operator)
            if name is? none return reject(node 'this compound assignment operator' @state)
            let operand_type=runtime_type(stored node @state)
            let signature=types.function_type([types.PosOrKwArg[none operand_type] types.PosOrKwArg[none operand_type]] [] none operand_type [] @state.type_nodes)
            let function=put(hir.ExpressedIdentifier[node.loc signature name] @state)
            value=put(hir.FunctionCall[node.loc operand_type function [if boxed array_load(target stored node @state) else target value] []] @state)
        }
        if state.cleanup_enabled and original.binding_id isnt? none and (original.binding_id in? state.cleanup_owned or original.binding_id in? state.place_parameters) {
            let prefix:array<addr>=[]
            let replacement=snapshot(value @prefix @state)
            if original.binding_id in? state.addressed and inline_place(stored @state) {
                if object_valued(stored state) {prefix.push(release_record(target stored node @state))}
                else {prefix.push(release_cell(target stored node @state))}
                prefix.push(field_write(target replacement stored node @state))
                prefix.push(release_value(replacement stored node @state))
            } else {
                prefix.push(release_value((if boxed array_load(target stored node @state) else target) stored node @state))
                prefix.push(if boxed array_store(replacement target stored node @state) else put(hir.Assign[node.loc type target '=' replacement] @state))
            }
            return sequence(prefix node @state)
        }
        if boxed return array_store(value target stored node @state)
        if original.binding_id isnt? none and original.binding_id in? state.addressed and inline_place(stored @state) return field_write(target value stored node @state)
        return put(hir.Assign[node.loc type target '=' value] @state)
    }
    if node is? hir.FunctionCall {
        let args:array<addr>=[]
        let callee=hir.node_at(state.input.nodes node.func)
        if callee is? hir.ArrayMethod return array_method_call(node callee @state)
        let function:addr=0
        if node.kw_args.length =? 0 and callee is? hir.ExpressedIdentifier and (callee.binding_id is? none or callee.binding_id not in? state.symbols) and (callee.name in? emit.binary or callee.name in? emit.prefix or callee.name in? emit.intrinsics) {
            if callee.name =? '__unreachable__' {
                # µDewy has no unreachable opcode. As in the hosted backend,
                # an empty infinite loop closes a path after an exit syscall.
                let empty=types.primitive('void' @state.type_nodes)
                let yes=put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) true] @state)
                let body=put(hir.Block[node.loc empty [] true] @state)
                let arm=put(hir.LoopArm[node.loc empty yes body] @state)
                return put(hir.Flow[node.loc types.primitive('never' @state.type_nodes) [arm] none] @state)
            }
            # Builtins and intrinsics have already converted their operands. Their
            # concrete runtime signature records the selected word width;
            # the original overload set has no runtime representation.
            let raw=callee.name.startswith('__load_') or callee.name.startswith('__store_') or callee.name.startswith('__syscall') or callee.name in? ['__load__' '__store__']
            loop argument in node.pos_args {
                let source=hir.node_at(state.input.nodes argument)
                let value=expression(argument @state)
                if raw and aggregate(source.value_type state) {value=pin_value(value source.value_type node @state)}
                args.push(value)
            }
            let parameters:array<types.PosOrKwArg>=[]
            loop argument in args {parameters.push(types.PosOrKwArg[none hir.node_at(state.nodes argument).value_type])}
            let signature=types.function_type(parameters [] none type [] @state.type_nodes)
            function=put(hir.ExpressedIdentifier[callee.loc signature callee.name callee.binding_id] @state)
        } else {return ordinary_call(id node type @state)}
        return put(hir.FunctionCall[node.loc type function args [] node.selected_method_index node.integer_operation] @state)
    }
    if node is? hir.FunctionLiteral return function_value(id node @state)
    if node is? hir.ShortCircuit return put(hir.ShortCircuit[node.loc type node.op expression(node.left @state) expression(node.right @state)] @state)
    if node is? hir.Block and state.cleanup_enabled return cleanup_block(node @state)
    if node is? hir.Block return put(hir.Block[node.loc type items(node.items @state) node.scoped] @state)
    if node is? hir.IfArm return put(hir.IfArm[node.loc type expression(node.condition @state) expression(node.body @state)] @state)
    if node is? hir.LoopArm return put(hir.LoopArm[node.loc type expression(node.condition @state) expression(node.body @state)] @state)
    if node is? hir.Flow return lower_flow(node 0 @state)
    if state.cleanup_enabled and node is? hir.Break|hir.Continue and node.loop_levels <? state.cleanup_loops.length {
        let index=state.cleanup_loops.length-1-node.loop_levels
        $runtime_assert index >=? 0 and index <? state.cleanup_loops.length
        let first=state.cleanup_loops[index]
        let prefix=cleanup_since(first node @state)
        prefix.push(put(if node is? hir.Break hir.Break[node.loc type node.label node.loop_levels] else hir.Continue[node.loc type node.label node.loop_levels] @state))
        return put(hir.Block[node.loc type prefix false] @state)
    }
    if node is? hir.Break return put(hir.Break[node.loc type node.label node.loop_levels] @state)
    if node is? hir.Continue return put(hir.Continue[node.loc type node.label node.loop_levels] @state)
    return reject(node "{node.typename} legalization" @state)
}
# Scalar arrays use the hosted six-word descriptors. Without a runtime
# allocator they stay within one function frame. The driver can supply the
# prelude allocator binding for independent values that cross frames or grow.
# Copies own their elements recursively. Growth returns the old owned byte
# buffer to the arena; element handles move into the replacement buffer.
# Releasing complete values at their last use remains a lifetime pass.
array_type = (id:addr state:State):>types.ArrayType? => {
    let type=types.node_at(state.type_nodes views.structural_base(id state.type_nodes))
    return if type is? types.ArrayType type else none
}
word = (value:bigint node:hir.AST @state:State):>addr => put(hir.Integer[node.loc types.primitive('int64' @state.type_nodes) '0d' value] @state)
intrinsic = (name:string arguments:array<addr> result:addr node:hir.AST @state:State):>addr => {
    let params:array<types.PosOrKwArg>=[]
    loop id in arguments {params.push(types.PosOrKwArg[none hir.node_at(state.nodes id).value_type])}
    let type=types.function_type(params [] none result [] @state.type_nodes)
    let function=put(hir.ExpressedIdentifier[node.loc type name] @state)
    return put(hir.FunctionCall[node.loc result function arguments []] @state)
}
word_op = (name:string left:addr right:addr node:hir.AST @state:State):>addr => intrinsic(name [left right] types.primitive('int64' @state.type_nodes) node @state)
address = (base:addr offset:addr node:hir.AST @state:State):>addr => if offset =? 0 base else word_op('__add__' base word(offset node @state) node @state)
# A provided allocator makes descriptors and element bytes survive the
# creating frame. The caller copies an ordinary array argument before any
# later argument is evaluated, so callee mutation cannot affect the caller.
# Frame storage remains available for small compiler-kernel tests without a
# prelude; values using it are forbidden from escaping that frame.
allocation = (size:addr node:hir.AST @state:State):>addr => {
    let name:string='__alloca__'
    if state.allocator isnt? none {
        let selected=state.symbols.get(state.allocator)
        if selected is? none return reject(node 'the requested arena allocator has no declaration' @state)
        name=selected
    }
    return intrinsic(name [size] types.primitive('int64' @state.type_nodes) node @state)
}
# Records and tagged cells occupy inline storage in fields. Their existing
# storage is itself the place; scalar values and array handles need a slot.
inline_place = (type:addr @state:State):>bool => object_valued(type state) or cell_members(type @state) isnt? none
binding_storage = (node:hir.ExpressedIdentifier stored:addr @state:State):>addr => {
    let type=if node.binding_id isnt? none and node.binding_id in? state.boxed types.primitive('int64' @state.type_nodes) else runtime_type(stored node @state)
    return put(hir.ExpressedIdentifier[node.loc type symbol(node.name node.binding_id @state) node.binding_id] @state)
}
box_value = (value:addr stored:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let initial=snapshot(value @prefix @state)
    let pointer=snapshot(allocation(word(8 node @state) node @state) @prefix @state)
    prefix.push(array_store(initial pointer stored node @state))
    prefix.push(pointer)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
place_address = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.ExpressedIdentifier return binding_storage(node stored_type(id state) @state)
    if node is? hir.MemberAccess return field_pointer(node @state writable=true)
    if node is? hir.Index {
        let pointer=array_index(node @state writable=true)
        return if inline_place(stored_type(id state) @state) array_load(pointer stored_type(id state) node @state) else pointer
    }
    return reject(node 'an addressable place route' @state)
}
# This describes the storage produced by expression, not the source type's
# mutability. Keep adoption and temporary reclamation on the same rule: a
# borrowed binding/field cannot be released merely because it is aggregate.
expression_owns = (id:addr @state:State):>bool => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Suppress return expression_owns(node.item @state)
    if node is? hir.RepresentationCast and array_valued(node.value_type state) {
        let source=hir.node_at(state.input.nodes node.expr)
        let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes))
        # These conversions construct an independent array. Value boundaries
        # adopt it; temporary reads/discarded conversions must reclaim it.
        if type is? types.BinaryLiteralType or string_type(source.value_type state) return true
    }
    if node is? hir.ValueCast|hir.RepresentationCast {
        let source=hir.node_at(state.input.nodes node.expr)
        if cell_members(source.value_type @state) isnt? none and temporary_owner(node.expr @state) return true
        if node is? hir.ValueCast {
            if object_valued(source.value_type state) and object_valued(node.value_type state) return expression_owns(node.expr @state)
            if array_valued(source.value_type state) and array_valued(node.value_type state) return expression_owns(node.expr @state)
        }
    }
    if node is? hir.StringConcat|hir.InterpolatedString|hir.StringIndex|hir.StringSlice return true
    if node is? hir.ValueCast|hir.RepresentationCast and owned_string(node.value_type state) {
        let source=hir.node_at(state.input.nodes node.expr)
        if owned_string(source.value_type state) return expression_owns(node.expr @state)
        if node is? hir.RepresentationCast and array_valued(source.value_type state) return true
    }
    if node is? hir.ObjectLiteral|hir.ArrayLiteral|hir.DictView|hir.SetAlgebra return true
    if node is? hir.DictEntries and temporary_owner(node.dictionary @state) return true
    if node is? hir.MemberAccess and temporary_owner(node.value @state) return true
    if node is? hir.Index and temporary_owner(node.array @state) return true
    if node is? hir.Block|hir.Flow and state.cleanup_enabled return true
    # Packing a non-cell value already creates an independent payload and
    # cell. Copying that result again abandons the first owned allocation.
    if node is? hir.ValueCast|hir.RepresentationCast and cell_members(node.value_type @state) isnt? none {
        let source=hir.node_at(state.input.nodes node.expr)
        if cell_members(source.value_type @state) is? none return true
    }
    if node is? hir.DictLookup {
        if not node.proven return true
        let keys=hir.node_at(state.input.nodes node.keys)
        if keys is? hir.MemberAccess and temporary_owner(keys.value @state) return true
    }
    if node is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index and cell_members(node.value_type @state) isnt? none {
        if cell_members(stored_type(id state) @state) is? none return true
    }
    if node is? hir.DictRemove return true
    # Ordinary Dewy calls already return independent aggregate storage: both
    # explicit returns and implicit function results pass through this value
    # boundary. Adopt that result instead of cloning it and abandoning its
    # original allocation. Intrinsics and array methods have separate ABIs.
    if node is? hir.FunctionCall {
        let callee=hir.node_at(state.input.nodes node.func)
        # Pop transfers the removed element; it no longer belongs to the
        # shortened array. This applies to discarded pops as well as locals.
        if callee is? hir.ArrayMethod and callee.name in? ['pop' 'join'] return true
        if callee is? hir.FunctionLiteral return true
        if callee is? hir.ExpressedIdentifier and callee.name not in? emit.intrinsics and callee.name not in? emit.binary and callee.name not in? emit.prefix return true
    }
    return false
}
temporary_owner = (id:addr @state:State):>bool => state.cleanup_enabled and releasable(hir.node_at(state.input.nodes id).value_type @state) and expression_owns(id @state)

# A read borrows its receiver until the result is evaluated. When that
# receiver was fresh, copy any aggregate result before releasing the owner.
# The returned expression contains its own setup/cleanup, so skipped flow
# arms and short-circuit operands never execute either half accidentally.
ReadOperand:type = [value:addr owner_type:addr?]
read_operand = (id:addr @prefix:array<addr> @state:State):>ReadOperand => {
    let original=hir.node_at(state.input.nodes id)
    if original is? hir.RepresentationCast and binary_array_view(original state) {
        # Binary literals already use the byte-array descriptor layout. A
        # read needs only that view, not a mutable copy of the entire table.
        # Actual value conversions still materialize independent storage.
        return read_operand(original.expr @prefix @state)
    }
    let owner:addr?=if temporary_owner(id @state) hir.node_at(state.input.nodes id).value_type else none
    let value=expression(id @state)
    if owner isnt? none {value=snapshot(value @prefix @state)}
    return ReadOperand[value owner]
}
finish_read = (value:addr receiver:ReadOperand node:hir.AST @prefix:array<addr> @state:State):>addr => {
    if receiver.owner_type isnt? none {
        if releasable(node.value_type @state) {value=copy_value(value node.value_type node @state)}
        value=snapshot(value @prefix @state)
        prefix.push(release_value(receiver.value receiver.owner_type node @state))
    }
    if prefix.length =? 0 return value
    prefix.push(value)
    return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
}
copy_value = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if owned_string(type state) return string_runtime('_native_string_copy' [value] node @state)
    if cell_members(type @state) isnt? none return cell_copy(value type node @state)
    let array=array_type(type state)
    if array isnt? none return array_copy(value array node @state)
    if object_valued(type state) return object_copy(value type node @state)
    return value
}
# A fresh flow can carry a union of differently refined arrays even when
# the enclosing result is one ordinary array type. Extracting the payload
# must not abandon that cell. Retagging may itself create a new cell on only
# some paths; release that intermediate only when it differs from the source.
owned_cell_cast = (node:hir.ValueCast|hir.RepresentationCast actual:addr @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(expression(node.expr @state) @prefix @state)
    let value=if enum_members(node.value_type state) isnt? none enum_pack(source actual node.value_type node @state) else read_value(source actual node.value_type node @state)
    value=snapshot(value @prefix @state)
    let result=snapshot(copy_value(value node.value_type node @state) @prefix @state)
    if cell_members(node.value_type @state) isnt? none {
        prefix.push(conditional(compare('__ne__' value source node @state) release_value(value node.value_type node @state) node @state))
    }
    prefix.push(release_value(source actual node @state))
    prefix.push(result)
    return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
}
owned_value = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if state.result_projection isnt? none and state.result_projection.read =? id {
        let projection=state.result_projection
        # Keep the selected field while the route and all enclosing locals
        # are alive. Scalars pass through; aggregate handles acquire their
        # own lifetime before ordinary return cleanup releases the source.
        let member=hir.MemberAccess[node.loc projection.result id projection.field]
        let prefix:array<addr>=[]
        let receiver=read_operand(id @prefix @state)
        let value=field_read(field_address(receiver.value member @state) projection.result member @state)
        # finish_read already keeps a field of an owned temporary receiver.
        if receiver.owner_type is? none {value=copy_value(value projection.result member @state)}
        return finish_read(value receiver member @prefix @state)
    }
    if node is? hir.Suppress return owned_value(node.item @state)
    if node is? hir.ValueCast {
        let source=hir.node_at(state.input.nodes node.expr)
        # A logical record upcast preserves the owned allocation, including
        # its dynamic child fields. Do not abandon a constructor/call result
        # merely because contextual typing inserted a transparent cast.
        if object_valued(source.value_type state) and object_valued(node.value_type state) return owned_record(owned_value(node.expr @state) source.value_type node.value_type node @state)
        if cell_members(source.value_type @state) is? none and cell_members(node.value_type @state) isnt? none return cell_pack(owned_value(node.expr @state) source.value_type node.value_type node @state owned=true)
    }
    let value=expression(id @state)
    if node is? hir.Place or expression_owns(id @state) return value
    if owned_string(node.value_type state) return string_runtime('_native_string_copy' [value] node @state)
    if cell_members(node.value_type @state) isnt? none return cell_copy(value node.value_type node @state)
    let array=array_type(node.value_type state)
    if array isnt? none and node isnt? hir.ArrayLiteral return array_copy(value array node @state)
    if object_valued(node.value_type state) and node isnt? hir.ObjectLiteral return object_copy(value node.value_type node @state)
    return value
}
# Parent storage reserves room for every possible descendant. An owned
# child's allocation may be smaller; cleanup needs the destination's size.
# Preserve equal layouts and resize differing ones without abandoning the
# independent source. This also applies when packing a record into a cell.
owned_record = (value:addr actual:addr expected:addr node:hir.AST @state:State):>addr => {
    if object_layout(actual node @state).size =? object_layout(expected node @state).size return value
    let prefix:array<addr>=[]
    let original=snapshot(value @prefix @state)
    let result=snapshot(object_copy(original expected node @state) @prefix @state)
    prefix.push(release_value(original actual node @state))
    prefix.push(result)
    return put(hir.Block[node.loc runtime_type(expected node @state) prefix false] @state)
}
ArrayMemory:type = [descriptor:addr data:addr prefix:array<addr>]
array_memory = (length:addr stride:addr node:hir.AST @state:State):>ArrayMemory => {
    let prefix:array<addr>=[]
    let size=word_op('__mul__' length word(stride node @state) node @state)
    let data=snapshot(allocation(size node @state) @prefix @state)
    let descriptor=snapshot(allocation(word(layouts.array_descriptor.size node @state) node @state) @prefix @state)
    let fields:array<addr>=[data length length word(stride node @state) word(layouts.array_flags.mutable + (if state.allocator is? none 0 else layouts.array_flags.arena_descriptor) node @state) word(if state.allocator is? none 0 else 1 node @state)]
    let offset:addr=0
    loop value in fields {
        prefix.push(intrinsic('__store_i64__' [value address(descriptor offset node @state)] types.primitive('void' @state.type_nodes) node @state))
        offset+=8
    }
    return ArrayMemory[descriptor data prefix]
}
array_store = (value:addr pointer:addr element:addr node:hir.AST @state:State):>addr => {
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(element state.type_nodes) state.type_nodes))
    if type is? types.ObjectType|types.ArrayType or cell_members(element @state) isnt? none or enum_members(element state) isnt? none or string_type(element state) or unit_type(element state) return store_word(value pointer 0 node @state)
    if type is? types.FunctionType {
        let word=put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) value] @state)
        return store_word(word pointer 0 node @state)
    }
    if types.is_primitive(type 'bool') {
        let byte=put(hir.Transmute[node.loc types.primitive('uint8' @state.type_nodes) value] @state)
        return intrinsic('__store_u8__' [byte pointer] types.primitive('void' @state.type_nodes) node @state)
    }
    let layout=views.fixed_integer_layout(element state.type_nodes)
    if layout is? none return reject(node 'array element store representation' @state)
    return intrinsic("__store_{if layout.signed 'i' else 'u'}{layout.bits}__" [value pointer] types.primitive('void' @state.type_nodes) node @state)
}
array_load = (pointer:addr element:addr node:hir.AST @state:State):>addr => {
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(element state.type_nodes) state.type_nodes))
    if type is? types.ObjectType|types.ArrayType or cell_members(element @state) isnt? none or enum_members(element state) isnt? none or string_type(element state) or unit_type(element state) return read_word(pointer 0 node @state)
    if type is? types.FunctionType return put(hir.Transmute[node.loc runtime_type(element node @state) read_word(pointer 0 node @state)] @state)
    if types.is_primitive(type 'bool') {
        let byte=intrinsic('__load_i8__' [pointer] types.primitive('int8' @state.type_nodes) node @state)
        return put(hir.Transmute[node.loc types.primitive('bool' @state.type_nodes) byte] @state)
    }
    let layout=views.fixed_integer_layout(element state.type_nodes)
    if layout is? none return reject(node 'array element load representation' @state)
    return intrinsic("__load_{if layout.signed 'i' else 'u'}{layout.bits}__" [pointer] runtime_type(element node @state) node @state)
}
array_literal = (node:hir.ArrayLiteral @state:State):>addr => {
    let type=array_type(node.value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let memory=array_memory(word(node.items.length node @state) layout.size node @state)
    let offset:addr=0
    loop item in node.items {
        memory.prefix.push(array_store(owned_value(item @state) address(memory.data offset node @state) type.element node @state))
        offset+=layout.size
    }
    memory.prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) memory.prefix false] @state)
}
array_index = (node:hir.Index @state:State writable:bool=false):>addr => {
    let prefix:array<addr>=[]
    let descriptor=snapshot((if writable write_route(node.array @state) else expression(node.array @state)) @prefix @state)
    let index=snapshot(expression(node.index @state) @prefix @state)
    if writable {
        let type=array_type(hir.node_at(state.input.nodes node.array).value_type state)
        $runtime_assert type isnt? none
        prefix.push(array_unique(descriptor type.element node @state))
    }
    prefix.push(array_element_address(descriptor index node @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
array_element_address = (descriptor:addr index:addr node:hir.Index @state:State):>addr => {
    let type=array_type(hir.node_at(state.input.nodes node.array).value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let data=read_word(descriptor 0 node @state)
    let offset=word_op('__mul__' index word(layout.size node @state) node @state)
    return word_op('__add__' data offset node @state)
}
# Copy helpers are monomorphic in storage type and shared by every use.
# Reserve the symbol before generating its body: a recursive record through
# array handles calls the reserved helper rather than recursively expanding
# the compiler's own lowering stack. These helpers require arena storage;
# a stack allocation inside a returning helper would immediately dangle.
finish_copy = (name:string parameter:string body:addr node:hir.AST @state:State):>void => {
    let word_type=types.primitive('int64' @state.type_nodes)
    # Helpers end in a descriptor/handle value. Statement sequences default
    # to void, so restore that fallthrough type before scalar normalization.
    let block=hir.node_at(state.nodes body)
    if block is? hir.Block {body=put(hir.Block[block.loc word_type block.items block.scoped] @state)}
    let type=types.function_type([types.PosOrKwArg[parameter word_type]] [] none word_type [] @state.type_nodes)
    let literal=put(hir.FunctionLiteral[node.loc type [hir.Param[parameter word_type]] [] none word_type body source=state.source_index] @state)
    state.generated.push(program.Function[name literal])
}
array_copy = (value:addr type:types.ArrayType node:hir.AST @state:State):>addr => {
    if state.allocator is? none return array_copy_body(value type node @state)
    let key="array:{type.element}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated_name=fresh('copy_array' @state)
        name=generated_name
        state.copy_helpers[key]=generated_name
        let parameter=fresh('copy_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=array_copy_body(source type node @state)
        finish_copy(generated_name parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
object_copy = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return object_copy_body(value type node @state)
    let key="object:{types.unfold(types.strip_refinement(type state.type_nodes) state.type_nodes)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated_name=fresh('copy_object' @state)
        name=generated_name
        state.copy_helpers[key]=generated_name
        let parameter=fresh('copy_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=object_copy_body(source type node @state)
        finish_copy(generated_name parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
owned_copy = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if owned_string(type state) return string_runtime('_native_string_copy' [value] node @state)
    if cell_members(type @state) isnt? none return cell_copy(value type node @state)
    let array=array_type(type state)
    if array isnt? none return array_copy(value array node @state)
    if object_valued(type state) return object_copy(value type node @state)
    return value
}

# Copy-on-write is a provisional storage strategy, not a source-level alias.
# Descriptors are private; owner 0 is borrowed/static, 1 unique arena data,
# and an aligned pointer >1 names a shared reference-count word.
array_shared = (descriptor:addr owner:addr node:hir.AST @state:State):>addr => {
    let flag=word_op('__and__' read_word(descriptor layouts.array_descriptor.flags node @state) word(layouts.array_flags.shared node @state) node @state)
    return put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'and' compare('__ne__' flag word(0 node @state) node @state) compare('__gt__' owner word(1 node @state) node @state)] @state)
}
array_copy_body = (value:addr type:types.ArrayType node:hir.AST @state:State):>addr => {
    if state.allocator is? none return array_copy_storage(value type node @state)
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let owner=snapshot(read_word(source layouts.array_descriptor.owner node @state) @prefix @state)
    let shared:array<addr>=[]
    let establish:array<addr>=[]
    establish.push(assign_value(owner allocation(word(8 node @state) node @state) node @state))
    establish.push(store_word(word(1 node @state) owner 0 node @state))
    establish.push(store_word(owner source layouts.array_descriptor.owner node @state))
    establish.push(store_word(word_op('__or__' read_word(source layouts.array_descriptor.flags node @state) word(layouts.array_flags.shared node @state) node @state) source layouts.array_descriptor.flags node @state))
    shared.push(conditional(compare('__eq__' owner word(1 node @state) node @state) sequence(establish node @state) node @state))
    shared.push(store_word(word_op('__add__' read_word(owner 0 node @state) word(1 node @state) node @state) owner 0 node @state))
    let target=snapshot(allocation(word(layouts.array_descriptor.size node @state) node @state) @shared @state)
    let offsets:array<addr>=[layouts.array_descriptor.data layouts.array_descriptor.length layouts.array_descriptor.capacity layouts.array_descriptor.stride layouts.array_descriptor.owner]
    loop offset in offsets {
        shared.push(store_word(read_word(source offset node @state) target offset node @state))
    }
    shared.push(store_word(word(layouts.array_flags.mutable+layouts.array_flags.arena_descriptor+layouts.array_flags.shared node @state) target layouts.array_descriptor.flags node @state))
    shared.push(target)
    let arm=put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'or' compare('__eq__' owner word(1 node @state) node @state) array_shared(source owner node @state)] @state) sequence(shared node @state)] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [arm] array_copy_storage(source type node @state)] @state))
    return sequence(prefix node @state)
}
array_unique = (descriptor:addr element:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return sequence([] node @state)
    let key="unique:{element}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated=fresh('unique_array' @state)
        state.copy_helpers[key]=generated name=generated
        let parameter=fresh('unique_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=array_unique_body(source element node @state)
        finish_copy(generated parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic(name [descriptor] types.primitive('int64' @state.type_nodes) node @state)
}
array_unique_body = (source:addr element:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let owner=snapshot(read_word(source layouts.array_descriptor.owner node @state) @prefix @state)
    let detached:array<addr>=[]
    let storage_type=array_type(types.array_type(element none @state.type_nodes) state)
    $runtime_assert storage_type isnt? none
    let copied=snapshot(array_copy_storage(source storage_type node @state) @detached @state)
    detached.push(store_word(word_op('__sub__' read_word(owner 0 node @state) word(1 node @state) node @state) owner 0 node @state))
    let offsets:array<addr>=[layouts.array_descriptor.data layouts.array_descriptor.length layouts.array_descriptor.capacity layouts.array_descriptor.stride]
    loop offset in offsets {
        detached.push(store_word(read_word(copied offset node @state) source offset node @state))
    }
    detached.push(release_block(copied word(layouts.array_descriptor.size node @state) node @state))
    let shared:array<addr>=[]
    let arm=put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) compare('__gt__' read_word(owner 0 node @state) word(1 node @state) node @state) sequence(detached node @state)] @state)
    shared.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] release_block(owner word(8 node @state) node @state)] @state))
    shared.push(store_word(word(1 node @state) source layouts.array_descriptor.owner node @state))
    shared.push(store_word(word_op('__and__' read_word(source layouts.array_descriptor.flags node @state) word(-9 node @state) node @state) source layouts.array_descriptor.flags node @state))
    prefix.push(conditional(array_shared(source owner node @state) sequence(shared node @state) node @state))
    prefix.push(source)
    return sequence(prefix node @state)
}
# Raw pointers have no tracked lifetime. Detach existing snapshots and pin
# the exposed tree: later ordinary copies must use the recursive fallback.
pin_value = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none or not aggregate(type state) return value
    if owned_string(type state) return string_runtime('_native_string_pin' [value] node @state)
    let key="pin:{type}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated=fresh('pin_value' @state)
        state.copy_helpers[key]=generated name=generated
        let parameter=fresh('pin_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=pin_body(source type node @state)
        finish_copy(generated parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
pin_record = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let record=object_type(type state)
    $runtime_assert record isnt? none
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    loop field in record.fields {
        if not aggregate(field.value_type state) continue
        let offset=layout.offsets.get(field.name)
        $runtime_assert offset isnt? none
        let member=field_read(address(value offset node @state) field.value_type node @state)
        prefix.push(pin_value(member field.value_type node @state))
    }
    return sequence(prefix node @state)
}
pin_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let array=array_type(type state)
    if array isnt? none {
        let body:array<addr>=[array_unique(value array.element node @state)]
        let copied:array<addr>=[]
        let fresh=snapshot(array_copy_storage(value array node @state) @copied @state)
        let offsets:array<addr>=[layouts.array_descriptor.data layouts.array_descriptor.length layouts.array_descriptor.capacity layouts.array_descriptor.stride]
        loop offset in offsets {copied.push(store_word(read_word(fresh offset node @state) value offset node @state))}
        copied.push(release_block(fresh word(layouts.array_descriptor.size node @state) node @state))
        body.push(conditional(compare('__ne__' read_word(value layouts.array_descriptor.owner node @state) word(1 node @state) node @state) sequence(copied node @state) node @state))
        body.push(store_word(word(-1 node @state) value layouts.array_descriptor.owner node @state))
        if aggregate(array.element state) {
            let index=snapshot(word(0 node @state) @body @state)
            let child=array_load(dict_element_pointer(value index array.element node @state) array.element node @state)
            body.push(loop_while(compare('__lt__' index read_word(value layouts.array_descriptor.length node @state) node @state) [pin_value(child array.element node @state) assign_value(index word_op('__add__' index word(1 node @state) node @state) node @state)] node @state))
        }
        prefix.push(conditional(compare('__ne__' read_word(value layouts.array_descriptor.owner node @state) word(-1 node @state) node @state) sequence(body node @state) node @state))
    } else if object_valued(type state) {
        let storage=views.structural_base(type state.type_nodes)
        let layout=object_layout(type node @state)
        let brand=layout.offsets.get(layouts.brand_field)
        let arms:array<addr>=[]
        if brand isnt? none {
            let tag=snapshot(read_word(value brand node @state) @prefix @state)
            loop entry in state.layout_context.brands.entries {
                if not subtyping.is_subtype(entry.value_type storage state.links @state.type_nodes) continue
                let numbered=brand_number(entry.name state)
                $runtime_assert numbered isnt? none
                arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) compare('__eq__' tag word(numbered.first node @state) node @state) pin_record(value entry.value_type node @state)] @state))
            }
        }
        prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms pin_record(value type node @state)] @state))
    } else {
        let members=cell_members(type @state)
        $runtime_assert members isnt? none
        let tag=snapshot(read_word(value 0 node @state) @prefix @state)
        let payload=snapshot(read_word(value 8 node @state) @prefix @state)
        let optional=views.optional_payload(type @state.type_nodes)
        let arms:array<addr>=[]
        loop member in members {
            if not aggregate(member state) continue
            let condition=compare((if optional isnt? none '__ne__' else '__eq__') tag word(if optional isnt? none 0 else member_tag(member @state) node @state) node @state)
            arms.push(put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) condition pin_value(payload member node @state)] @state))
        }
        prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) arms word(0 node @state)] @state))
    }
    prefix.push(value)
    return sequence(prefix node @state)
}

# Follow a mutable route through arrays before exposing the nested value.
# Plain reads keep sharing; taking a place makes each enclosing buffer unique.
write_route = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    let stored=stored_type(id state)
    if node is? hir.Index return read_value(array_load(array_index(node @state writable=true) stored node @state) stored node.value_type node @state)
    if node is? hir.MemberAccess return read_value(field_read(field_pointer(node @state writable=true) stored node @state) stored node.value_type node @state)
    return expression(id @state)
}

array_copy_storage = (value:addr type:types.ArrayType node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let descriptor=snapshot(value @prefix @state)
    let source=snapshot(intrinsic('__load_i64__' [descriptor] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let length=snapshot(intrinsic('__load_i64__' [address(descriptor layouts.array_descriptor.length node @state)] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let memory=array_memory(length layout.size node @state)
    loop item in memory.prefix {prefix.push(item)}
    let counter=state.runtime_helpers.get('_arena_note_copy')
    if counter isnt? none {
        let symbol=state.symbols.get(counter)
        if symbol isnt? none {prefix.push(intrinsic(symbol [word_op('__mul__' length word(layout.size node @state) node @state)] types.primitive('void' @state.type_nodes) node @state))}
    }
    if aggregate(type.element state) {
        if state.allocator is? none return reject(node 'owned aggregate array elements need the prelude arena allocator' @state)
        let cursor=snapshot(word(0 node @state) @prefix @state)
        let offset=word_op('__mul__' cursor word(layout.size node @state) node @state)
        let item=array_load(word_op('__add__' source offset node @state) type.element node @state)
        let copied=owned_copy(item type.element node @state)
        let store=array_store(copied word_op('__add__' memory.data offset node @state) type.element node @state)
        let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
        let body=sequence([store increment] node @state)
        let condition=intrinsic('__lt__' [cursor length] types.primitive('bool' @state.type_nodes) node @state)
        let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
        prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
        prefix.push(memory.descriptor)
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    let count=snapshot(word_op('__mul__' length word(layout.size node @state) node @state) @prefix @state)
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let source_pointer=word_op('__add__' source cursor node @state)
    let into=word_op('__add__' memory.data cursor node @state)
    let byte=intrinsic('__load_u8__' [source_pointer] types.primitive('uint8' @state.type_nodes) node @state)
    let store=intrinsic('__store_u8__' [byte into] types.primitive('void' @state.type_nodes) node @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let body=put(hir.Block[node.loc types.primitive('void' @state.type_nodes) [store increment] true] @state)
    let condition=intrinsic('__lt__' [cursor count] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Optional and general union cells share two words: a program-wide member
# tag, then a scalar payload or an owned aggregate handle. None is tag zero.
# Views retain tags when their alternatives remain the same. Splitting or
# combining record families converts the tags at the read/cast boundary.
cell_members = (id:addr @state:State):>array<addr>|none => {
    # Most calls ask about a non-cell type. Cache negative answers too, while
    # distinguishing them from a type that has not been queried yet.
    let cached=state.cell_types.get(id)
    if cached isnt? none return if cached.length =? 0 none else cached
    let plain=types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes)
    let payload=views.optional_payload(plain @state.type_nodes)
    let result:array<addr>|none=if payload isnt? none [types.primitive('none' @state.type_nodes) payload] else views.runtime_union_members(plain @state.type_nodes)
    state.cell_types[id]=if result is? none [] else result
    return result
}
member_tag = (type:addr @state:State):>addr => {
    let plain=types.unfold(types.strip_refinement(type state.type_nodes) state.type_nodes)
    if types.is_primitive(types.node_at(state.type_nodes plain) 'none') return 0
    let key=if string_type(plain state) 'string' else types.shape_of(plain state.type_nodes)
    let tag=state.union_tags.get(key)
    if tag isnt? none return tag
    let fresh:addr=state.next_tag
    state.next_tag+=1
    state.union_tags[key]=fresh
    return fresh
}
# The read type may be narrower than a binding or field's physical slot.
# Preserve the declared type separately; only a single-member read loads
# the payload. A read that still has several alternatives remains a cell.
stored_type = (id:addr state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
        let type=state.storage_types.get(node.binding_id)
        if type isnt? none return type
    }
    if node is? hir.MemberAccess {
        let record=object_type(hir.node_at(state.input.nodes node.value).value_type state)
        if record isnt? none {
            let field=types.object_field(record node.name)
            if field isnt? none return field.value_type
        }
    }
    if node is? hir.Index {
        let array=array_type(hir.node_at(state.input.nodes node.array).value_type state)
        if array isnt? none return array.element
    }
    return node.value_type
}
cell_payload = (cell:addr type:addr node:hir.AST @state:State):>addr => {
    let value=read_word(cell 8 node @state)
    let runtime=runtime_type(type node @state)
    if types.is_primitive(types.node_at(state.type_nodes runtime) 'int64') return value
    return put(hir.Transmute[node.loc runtime value] @state)
}
read_value = (value:addr stored:addr read:addr node:hir.AST @state:State):>addr => {
    # Most reads keep their declared type. In particular, do not compare all
    # pairs of alternatives in a large AST union when no narrowing occurred.
    if stored =? read return value
    if enum_members(stored state) isnt? none return enum_read(value stored read node @state)
    # Narrowing a branded parent to several children changes the read's
    # representation: the parent is one record handle, the child union is a
    # tagged cell. Its first record field must never be mistaken for a tag.
    if object_valued(stored state) and cell_members(read @state) isnt? none return cell_pack(value stored read node @state)
    let original=cell_members(stored @state)
    let narrowed=cell_members(read @state)
    if original isnt? none and narrowed isnt? none {
        # A parent may itself occupy a union cell (e.g. Token|none). Keeping
        # several child alternatives then needs new tags, not just the old
        # parent tag with a narrower logical annotation.
        let retag:set<addr>=set[]
        let tags:set<addr>=set[]
        loop target in narrowed {tags.add(member_tag(target @state))}
        loop member in original {
            if member_tag(member @state) in? tags continue
            # Array length facts refine a read without changing its physical
            # payload or presence tag. Only record family conversions need
            # to split a parent tag into children (or widen children back).
            if object_valued(member state) and not type_tests.disjoint(member read state.links @state.type_nodes) {retag.add(member)}
        }
        if retag.length >? 0 {
            let prefix:array<addr>=[]
            let source=snapshot(value @prefix @state)
            let tag=snapshot(read_word(source 0 node @state) @prefix @state)
            let arms:array<addr>=[]
            let output=types.primitive('int64' @state.type_nodes)
            loop member in original {
                if member not in? retag continue
                let converted=cell_pack(cell_payload(source member node @state) member read node @state)
                let condition=compare('__eq__' tag word(member_tag(member @state) node @state) node @state)
                arms.push(put(hir.IfArm[node.loc output condition converted] @state))
            }
            $runtime_assert arms.length >? 0
            # Other alternatives retain their original cell, including a
            # refined array alongside a record family in the same union.
            prefix.push(put(hir.Flow[node.loc output arms source] @state))
            return put(hir.Block[node.loc output prefix false] @state)
        }
    }
    if original isnt? none and narrowed is? none return cell_payload(value read node @state)
    return value
}
cell_copy = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return cell_copy_body(value type node @state)
    let key="cell:{types.shape_of(type state.type_nodes)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated_name=fresh('copy_cell' @state)
        name=generated_name
        state.copy_helpers[key]=generated_name
        let parameter=fresh('copy_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=cell_copy_body(source type node @state)
        finish_copy(generated_name parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
cell_write = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => {
    let members=cell_members(type @state)
    $runtime_assert members isnt? none
    let prefix:array<addr>=[]
    source=snapshot(source @prefix @state)
    let tag=snapshot(read_word(source 0 node @state) @prefix @state)
    let payload=snapshot(read_word(source 8 node @state) @prefix @state)
    let arms:array<addr>=[]
    let optional=views.optional_payload(type @state.type_nodes)
    loop member in members {
        if not aggregate(member state) continue
        # An optional has one possible present payload. Its read may retain
        # a more precise length/shape than its stored tag; any nonzero tag
        # still denotes that payload, which must receive an independent copy.
        let condition=if optional isnt? none intrinsic('__ne__' [tag word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state) else intrinsic('__eq__' [tag word(member_tag(member @state) node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let copy=owned_copy(payload member node @state)
        arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition store_word(copy destination 8 node @state)] @state))
    }
    let fallback=store_word(payload destination 8 node @state)
    prefix.push(store_word(tag destination 0 node @state))
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms fallback] @state))
    return sequence(prefix node @state)
}
cell_copy_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let cell=snapshot(allocation(word(16 node @state) node @state) @prefix @state)
    prefix.push(cell_write(cell source type node @state))
    prefix.push(cell)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
cell_pack = (value:addr actual:addr expected:addr node:hir.AST @state:State owned:bool=false):>addr => {
    let members=cell_members(expected @state)
    $runtime_assert members isnt? none
    if cell_members(actual @state) isnt? none return read_value(value actual expected node @state)
    let selected:addr?=none
    # Preserve an existing member before considering other types it fits.
    # Proof joins can retain both a narrowed record arm and a broader arm;
    # repacking the former keeps its own tag. This does not select between
    # ambiguous source conversions that have no exact member identity.
    loop member in members {
        if actual =? member {selected=member break}
    }
    if selected is? none {
        loop member in members {
            if subtyping.is_subtype(actual member state.links @state.type_nodes) {
                if selected isnt? none return reject(node 'overlapping union payload representations' @state)
                selected=member
            }
        }
    }
    if selected is? none {
        # A checked parent-to-child-union read needs dynamic brand selection.
        # Every branch packs the chosen child's layout and the union's tag;
        # this also preserves fields whose offsets differ between children.
        if not object_valued(actual state) return reject(node 'the value has no member in this union storage' @state)
        let prefix:array<addr>=[]
        let source=snapshot(value @prefix @state)
        let arms:array<addr>=[]
        let output=types.primitive('int64' @state.type_nodes)
        loop member in members {
            if type_tests.disjoint(actual member state.links @state.type_nodes) continue
            if not object_valued(member state) return reject(node 'a narrowed record union has a non-record payload' @state)
            let condition=object_matches(source actual member node @state)
            let payload=if owned owned_record(source actual member node @state) else source
            let packed=cell_pack(payload member expected node @state owned=owned)
            arms.push(put(hir.IfArm[node.loc output condition packed] @state))
        }
        if arms.length =? 0 return reject(node 'the value has no member in this union storage' @state)
        # The checked read/representation conversion already proves coverage.
        let last=hir.node_at(state.nodes arms.pop)
        $runtime_assert last is? hir.IfArm
        prefix.push(put(hir.Flow[node.loc output arms last.body] @state))
        return put(hir.Block[node.loc output prefix false] @state)
    }
    let prefix:array<addr>=[]
    let content=value
    if not owned {content=owned_copy(value selected node @state)}
    else if object_valued(actual state) and object_valued(selected state) {content=owned_record(value actual selected node @state)}
    let payload=snapshot(content @prefix @state)
    let word_value=put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) payload] @state)
    let cell=snapshot(allocation(word(16 node @state) node @state) @prefix @state)
    prefix.push(store_word(word(member_tag(selected @state) node @state) cell 0 node @state))
    prefix.push(store_word(word_value cell 8 node @state))
    prefix.push(cell)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# Runtime predicate lowering must not silently erase refinements while
# distributing a tested union into its storage alternatives.
test_has_refinement = (id:addr state:State):>bool => {
    let type=types.node_at(state.type_nodes types.unfold(id state.type_nodes))
    if type is? types.RefinedType return true
    if type is? types.TypeOr|types.TypeAnd {
        loop member in type.items {if test_has_refinement(member state) return true}
    }
    if type is? types.TypeNot return test_has_refinement(type.item state)
    return false
}
test_refinements_implied = (actual:addr tested:addr @state:State):>bool => {
    let required=types.node_at(state.type_nodes types.unfold(tested state.type_nodes))
    if required is? types.RefinedType {
        # Storage alternatives omit facts, but the read's logical alternatives
        # still carry them. An addr | Record tested for addr needs only a tag;
        # an int64 | Record tested for addr still needs a payload predicate.
        let input=types.node_at(state.type_nodes types.unfold(actual state.type_nodes))
        let variants:array<addr>=if input is? types.TypeOr input.items else [actual]
        loop variant in variants {
            if not type_tests.covers(variant tested state.links @state.type_nodes) and not type_tests.disjoint(variant required.base state.links @state.type_nodes) return false
        }
        return test_refinements_implied(actual required.base @state)
    }
    if required is? types.TypeOr|types.TypeAnd {
        loop member in required.items {if not test_refinements_implied(actual member @state) return false}
    }
    if required is? types.TypeNot return test_refinements_implied(actual required.item @state)
    return true
}
runtime_test = (node:hir.TypeTest @state:State):>addr => {
    let prefix:array<addr>=[]
    let receiver=read_operand(node.value @prefix @state)
    let value=runtime_test_value(receiver.value node @state)
    return finish_read(value receiver node @prefix @state)
}
runtime_test_value = (operand:addr node:hir.TypeTest @state:State):>addr => {
    let actual=hir.node_at(state.input.nodes node.value).value_type
    if test_has_refinement(node.test_type state) {
        if not test_refinements_implied(actual node.test_type @state) return reject(node 'runtime refinement predicates' @state)
        node=hir.TypeTest[node.loc node.value_type node.value views.strip_all_refinements(node.test_type @state.type_nodes) node.negated]
    }
    let optional=views.optional_payload(actual @state.type_nodes)
    if optional isnt? none {
        let present=subtyping.is_subtype(optional node.test_type state.links @state.type_nodes)
        if present or type_tests.disjoint(optional node.test_type state.links @state.type_nodes) {
            # Shape facts about the sole payload do not replace the tag
            # already written into this optional's storage. Tests that cover
            # or exclude that payload need only presence, as in hosted
            # optional lowering. Preserve evaluation of the source once.
            let absent=subtyping.is_subtype(types.primitive('none' @state.type_nodes) node.test_type state.links @state.type_nodes)
            let prefix:array<addr>=[]
            let source=snapshot(operand @prefix @state)
            let boolean=types.primitive('bool' @state.type_nodes)
            let result=if present =? absent put(hir.Bool[node.loc boolean present] @state) else intrinsic(if present '__ne__' else '__eq__' [read_word(source 0 node @state) word(0 node @state)] boolean node @state)
            if node.negated {result=intrinsic('__not__' [result] boolean node @state)}
            prefix.push(result)
            return put(hir.Block[node.loc boolean prefix false] @state)
        }
    }
    let enum=enum_members(actual state)
    if enum isnt? none {
        let prefix:array<addr>=[]
        let tag=snapshot(operand @prefix @state)
        let boolean=types.primitive('bool' @state.type_nodes)
        let result=put(hir.Bool[node.loc boolean false] @state)
        loop member in enum {
            if not subtyping.is_subtype(member node.test_type state.links @state.type_nodes) continue
            let matches=intrinsic('__eq__' [tag word(enum_tag(member @state) node @state)] boolean node @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result matches] @state)
        }
        if node.negated {result=intrinsic('__not__' [result] boolean node @state)}
        prefix.push(result)
        return put(hir.Block[node.loc boolean prefix false] @state)
    }
    let members=cell_members(actual @state)
    if members is? none {
        if string_type(actual state) {
            let result=string_type_test(operand node.test_type node @state)
            return if node.negated intrinsic('__not__' [result] types.primitive('bool' @state.type_nodes) node @state) else result
        }
        return object_test(operand node @state)
    }
    let prefix:array<addr>=[]
    let source=snapshot(operand @prefix @state)
    let tag=snapshot(read_word(source 0 node @state) @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let result=put(hir.Bool[node.loc boolean false] @state)
    let seen:set<addr>=set[]
    loop member in members {
        let tag_number=member_tag(member @state)
        if tag_number in? seen continue
        seen.add(tag_number)
        # String alternatives share the descriptor representation and tag.
        # Their literal spelling is in the payload, never in that shared tag.
        if string_type(member state) {
            let active=intrinsic('__eq__' [tag word(tag_number node @state)] boolean node @state)
            let payload=cell_payload(source types.primitive('string' @state.type_nodes) node @state)
            let matches=string_type_test(payload node.test_type node @state)
            let selected=put(hir.ShortCircuit[node.loc boolean 'and' active matches] @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result selected] @state)
        } else if subtyping.is_subtype(member node.test_type state.links @state.type_nodes) {
            let matches=intrinsic('__eq__' [tag word(member_tag(member @state) node @state)] boolean node @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result matches] @state)
        } else if object_valued(member state) and not type_tests.disjoint(member node.test_type state.links @state.type_nodes) {
            let active=intrinsic('__eq__' [tag word(tag_number node @state)] boolean node @state)
            let matches=object_matches(cell_payload(source member node @state) member node.test_type node @state)
            let selected=put(hir.ShortCircuit[node.loc boolean 'and' active matches] @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result selected] @state)
        } else if not type_tests.disjoint(member node.test_type state.links @state.type_nodes) {
            return reject(node 'a runtime test within one union payload alternative' @state)
        }
    }
    if node.negated {result=intrinsic('__not__' [result] boolean node @state)}
    prefix.push(result)
    return put(hir.Block[node.loc boolean prefix false] @state)
}

# Strings are immutable views over UTF-8 bytes and a table of grapheme byte
# boundaries. A slice advances the boundary pointer but retains the original
# byte base. The start word is therefore an absolute offset into that base.
# Owned descriptors retain shared backing; releasing the last descriptor
# returns the bytes and boundary table to the arena.
string_type = (id:addr state:State):>bool => {
    let plain=types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes)
    return views.string_valued(plain state.type_nodes)
}
# Compact string enums are integers, not descriptor pointers.
owned_string = (id:addr state:State):>bool => string_type(id state) and enum_members(id state) is? none
string_runtime = (helper:string arguments:array<addr> node:hir.AST @state:State result_void:bool=false):>addr => {
    let binding=state.runtime_helpers.get(helper)
    # Prelude-free kernels only have frame/static storage, with no reclamation.
    if state.allocator is? none {
        if result_void return sequence([] node @state)
        if helper in? ['_native_string_copy' '_native_string_pin'] and arguments.length >? 0 return arguments[0]
        return word(0 node @state)
    }
    if binding is? none return reject(node "native string storage needs {helper}" @state)
    let name=state.symbols.get(binding)
    if name is? none return reject(node "native string helper {helper} is absent" @state)
    return intrinsic(name arguments types.primitive(if result_void 'void' else 'int64' @state.type_nodes) node @state)
}
string_memory = (data:addr byte_length:addr boundaries:addr length:addr start:addr node:hir.AST @state:State static_storage:bool=false owner:addr?=none):>addr => {
    let prefix:array<addr>=[]
    if not static_storage {
        data=snapshot(data @prefix @state) byte_length=snapshot(byte_length @prefix @state)
        boundaries=snapshot(boundaries @prefix @state) length=snapshot(length @prefix @state)
    }
    let size=word(layouts.string_descriptor.size node @state)
    let storage=if static_storage intrinsic('__static_alloca__' [size] types.primitive('int64' @state.type_nodes) node @state) else allocation(size node @state)
    let descriptor=snapshot(storage @prefix @state)
    let control=if static_storage word(0 node @state) else if owner isnt? none owner else string_runtime('_native_string_owner' [data byte_length boundaries word_op('__mul__' word_op('__add__' length word(1 node @state) node @state) word(4 node @state) node @state)] node @state)
    let fields:array<addr>=[data byte_length boundaries length start control]
    let offset:addr=0
    loop value in fields {prefix.push(store_word(value descriptor offset node @state)) offset+=8}
    prefix.push(descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_literal = (node:hir.String @state:State):>addr => {
    let prefix:array<addr>=[]
    let bytes=node.content as array<uint8>
    if bytes.length >? uint32.max return reject(node 'a string literal exceeding the runtime boundary offset range' @state)
    # Segmentation here is a compile-time operation using Dewy's own string
    # indexing. Runtime concatenation/UTF-8 decoding must segment the joined
    # bytes afresh: concatenating two boundary tables is not Unicode-correct.
    let offsets:array<addr>=[0]
    let offset:addr=0
    loop i in 0.. and i <? node.content.length {
        let grapheme=node.content[i] as array<uint8>
        offset+=grapheme.length
        offsets.push(offset)
    }
    let boundaries=snapshot(intrinsic('__static_alloca__' [word(offsets.length*4 node @state)] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    loop i in 0.. and i <? offsets.length {
        let value=put(hir.Integer[node.loc types.primitive('uint32' @state.type_nodes) '0d' offsets[i]] @state)
        prefix.push(intrinsic('__store_u32__' [value word_op('__add__' boundaries word(i*4 node @state) node @state)] types.primitive('void' @state.type_nodes) node @state))
    }
    let data=put(hir.String[node.loc types.primitive('int64' @state.type_nodes) node.content] @state)
    # Every descriptor field is constant for this literal site. Like its
    # bytes and boundary table, the descriptor can be reused across calls;
    # allocating it on each evaluation retains space for immutable data.
    prefix.push(string_memory(data word(bytes.length node @state) boundaries word(node.content.length node @state) word(0 node @state) node @state static_storage=true))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_data = (value:addr node:hir.AST @state:State):>addr => word_op('__add__' read_word(value layouts.string_descriptor.data node @state) read_word(value layouts.string_descriptor.start node @state) node @state)
string_view = (value:addr first:addr count:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let boundaries=snapshot(word_op('__add__' read_word(value layouts.string_descriptor.boundaries node @state) word_op('__mul__' first word(4 node @state) node @state) node @state) @prefix @state)
    let start=snapshot(intrinsic('__load_u32__' [boundaries] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let end_pointer=word_op('__add__' boundaries word_op('__mul__' count word(4 node @state) node @state) node @state)
    let stop=snapshot(intrinsic('__load_u32__' [end_pointer] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    prefix.push(string_memory(read_word(value layouts.string_descriptor.data node @state) word_op('__sub__' stop start node @state) boundaries count start node @state owner=string_runtime('_native_string_view_owner' [value] node @state)))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_index = (node:hir.StringIndex @state:State):>addr => {
    let prefix:array<addr>=[]
    let value=snapshot(owned_value(node.string @state) @prefix @state)
    let index=snapshot(expression(node.index @state) @prefix @state)
    let result=snapshot(string_view(value index word(1 node @state) node @state) @prefix @state)
    prefix.push(string_runtime('_native_string_release' [value] node @state result_void=true))
    prefix.push(result)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_slice = (node:hir.StringSlice @state:State):>addr => {
    let range=hir.node_at(state.input.nodes node.range)
    if range isnt? hir.Range or range.step_pair isnt? none return reject(node 'stepped string slicing' @state)
    let prefix:array<addr>=[]
    let value=snapshot(owned_value(node.string @state) @prefix @state)
    let bounds=if range.bounds is? none '[]' else range.bounds
    let first=if range.left is? none word(0 node @state) else expression(range.left @state)
    if range.left isnt? none and bounds in? ['()' '(]'] {first=word_op('__add__' first word(1 node @state) node @state)}
    first=snapshot(first @prefix @state)
    let stop=if range.right is? none read_word(value layouts.string_descriptor.grapheme_length node @state) else expression(range.right @state)
    if range.right isnt? none and bounds in? ['[]' '(]'] {stop=word_op('__add__' stop word(1 node @state) node @state)}
    stop=snapshot(stop @prefix @state)
    let count=snapshot(word_op('__sub__' stop first node @state) @prefix @state)
    let negative=intrinsic('__lt__' [count word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
    let zero=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) count '=' word(0 node @state)] @state)
    prefix.push(conditional(negative zero node @state))
    let result=snapshot(string_view(value first count node @state) @prefix @state)
    prefix.push(string_runtime('_native_string_release' [value] node @state result_void=true))
    prefix.push(result)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_equal = (node:hir.StringEqual @state:State):>addr => {
    let prefix:array<addr>=[]
    let left=snapshot(owned_value(node.left @state) @prefix @state)
    let right=snapshot(owned_value(node.right @state) @prefix @state)
    let result=snapshot(string_equal_values(left right node node.negated @state) @prefix @state)
    prefix.push(string_runtime('_native_string_release' [left] node @state result_void=true))
    prefix.push(string_runtime('_native_string_release' [right] node @state result_void=true))
    prefix.push(result)
    return put(hir.Block[node.loc types.primitive('bool' @state.type_nodes) prefix false] @state)
}
string_equal_values = (a_value:addr b_value:addr node:hir.AST negated:bool @state:State):>addr => {
    let prefix:array<addr>=[]
    let left=snapshot(a_value @prefix @state)
    let right=snapshot(b_value @prefix @state)
    let length=snapshot(read_word(left layouts.string_descriptor.byte_length node @state) @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let same=snapshot(intrinsic('__eq__' [length read_word(right layouts.string_descriptor.byte_length node @state)] boolean node @state) @prefix @state)
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let a=snapshot(string_data(left node @state) @prefix @state)
    let b=snapshot(string_data(right node @state) @prefix @state)
    let byte_type=types.primitive('uint8' @state.type_nodes)
    let av=intrinsic('__load_u8__' [word_op('__add__' a cursor node @state)] byte_type node @state)
    let bv=intrinsic('__load_u8__' [word_op('__add__' b cursor node @state)] byte_type node @state)
    let comparison=intrinsic('__eq__' [av bv] boolean node @state)
    let assign=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) same '=' comparison] @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let running=intrinsic('__lt__' [cursor length] boolean node @state)
    let condition=put(hir.ShortCircuit[node.loc boolean 'and' same running] @state)
    let body=sequence([assign increment] node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    prefix.push(if negated intrinsic('__not__' [same] boolean node @state) else same)
    return put(hir.Block[node.loc boolean prefix false] @state)
}
string_bytes = (value:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let length=snapshot(read_word(source layouts.string_descriptor.byte_length node @state) @prefix @state)
    let memory=array_memory(length 1 node @state)
    loop item in memory.prefix {prefix.push(item)}
    prefix.push(counted_bytes(string_data(source node @state) memory.data word(0 node @state) length node @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Materialize an independent array of immutable one-grapheme views. Reuse
# the string's boundary table (including a slice's shifted boundary pointer),
# rather than decoding scalars or segmenting the same UTF-8 bytes again.
# Each element owns its view descriptor and retains the shared string backing.
string_graphemes = (value:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let length=snapshot(read_word(source layouts.string_descriptor.grapheme_length node @state) @prefix @state)
    let memory=array_memory(length 8 node @state)
    loop item in memory.prefix {prefix.push(item)}
    let index=snapshot(word(0 node @state) @prefix @state)
    let destination=word_op('__add__' memory.data word_op('__mul__' index word(8 node @state) node @state) node @state)
    let store=store_word(string_view(source index word(1 node @state) node @state) destination 0 node @state)
    let advance=assign_value(index word_op('__add__' index word(1 node @state) node @state) node @state)
    prefix.push(loop_while(compare('__lt__' index length node @state) [store advance] node @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Strings already contain valid UTF-8. Decode scalar values, not grapheme
# clusters: a combining sequence yields several uint32 elements. A slice's
# data starts at its byte offset, and its byte length bounds this traversal.
Utf8Width:type = const [limit:int64 width:int64 mask:int64]
string_scalars = (value:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let data=snapshot(string_data(source node @state) @prefix @state)
    let length=snapshot(read_word(source layouts.string_descriptor.byte_length node @state) @prefix @state)
    # The byte count is a safe capacity; the final length counts scalars.
    let memory=array_memory(length 4 node @state)
    loop item in memory.prefix {prefix.push(item)}
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let count=snapshot(word(0 node @state) @prefix @state)
    let scalar=snapshot(word(0 node @state) @prefix @state)
    let empty=types.primitive('void' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let pointer=word_op('__add__' data cursor node @state)
    let leading=intrinsic('__load_u8__' [pointer] types.primitive('int64' @state.type_nodes) node @state)
    let arms:array<addr>=[]
    loop encoding in [Utf8Width[128 1 127] Utf8Width[224 2 31] Utf8Width[240 3 15] Utf8Width[256 4 7]] {
        let limit=encoding.limit
        let width=encoding.width
        let mask=encoding.mask
        let decoded=word_op('__and__' leading word(mask node @state) node @state)
        loop delta in 1.. and delta <? width {
            let byte=intrinsic('__load_u8__' [word_op('__add__' pointer word(delta node @state) node @state)] types.primitive('int64' @state.type_nodes) node @state)
            decoded=word_op('__add__' word_op('__lshift__' decoded word(6 node @state) node @state) word_op('__and__' byte word(63 node @state) node @state) node @state)
        }
        let save=put(hir.Assign[node.loc empty scalar '=' decoded] @state)
        let advance=put(hir.Assign[node.loc empty cursor '=' word_op('__add__' cursor word(width node @state) node @state)] @state)
        let selected=intrinsic('__lt__' [leading word(limit node @state)] boolean node @state)
        arms.push(put(hir.IfArm[node.loc empty selected sequence([save advance] node @state)] @state))
    }
    let decode=put(hir.Flow[node.loc empty arms none] @state)
    let destination=word_op('__add__' memory.data word_op('__mul__' count word(4 node @state) node @state) node @state)
    let store=intrinsic('__store_u32__' [scalar destination] empty node @state)
    let advance=put(hir.Assign[node.loc empty count '=' word_op('__add__' count word(1 node @state) node @state)] @state)
    let running=intrinsic('__lt__' [cursor length] boolean node @state)
    let loop_arm=put(hir.LoopArm[node.loc empty running sequence([decode store advance] node @state)] @state)
    prefix.push(put(hir.Flow[node.loc empty [loop_arm] none] @state))
    prefix.push(store_word(count memory.descriptor layouts.array_descriptor.length node @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Raw literal bytes and compiler-created borrowed byte views use the same
# descriptor as arrays. A later value copy makes independently mutable
# storage; merely describing embedded data must not allocate a second copy.
byte_descriptor = (data:addr length:addr node:hir.AST @state:State static_storage:bool=false):>addr => {
    let prefix:array<addr>=[]
    let size=word(layouts.array_descriptor.size node @state)
    let storage=if static_storage intrinsic('__static_alloca__' [size] types.primitive('int64' @state.type_nodes) node @state) else allocation(size node @state)
    let descriptor=snapshot(storage @prefix @state)
    let flags=layouts.array_flags.borrowed_static + if static_storage 0 else layouts.array_flags.arena_descriptor
    let fields:array<addr>=[data length length word(1 node @state) word(flags node @state) word(0 node @state)]
    let offset:addr=0
    loop field in fields {prefix.push(store_word(field descriptor offset node @state)) offset+=8}
    prefix.push(descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
binary_literal = (node:hir.BasedString @state:State):>addr => {
    let data=put(hir.BasedString[node.loc types.primitive('int64' @state.type_nodes) node.prefix node.digits node.content node.include_path] @state)
    return byte_descriptor(data word(node.content.length node @state) node @state static_storage=true)
}
binary_array_view = (node:hir.RepresentationCast state:State):>bool => {
    let source=hir.node_at(state.input.nodes node.expr)
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes))
    let target=array_type(node.value_type state)
    return type is? types.BinaryLiteralType and target isnt? none and types.is_primitive(types.node_at(state.type_nodes target.element) 'uint8')
}

# Materialized strings resegment all bytes, including a cluster crossing a
# concatenation boundary. The library returns validated word offsets; the
# runtime string layout stores those offsets as uint32, as the hosted one
# does. Call by installed helper identity to preserve lexical shadowing.
segmented_string = (data:addr length:addr node:hir.AST optional:bool @state:State):>addr => {
    let binding=state.runtime_helpers.get('_utf8_boundaries')
    if binding is? none return reject(node 'runtime UTF-8 materialization needs the prelude segmentation helper' @state)
    let name=state.symbols.get(binding)
    if name is? none return reject(node 'the segmentation helper is absent from the lowered graph' @state)
    let prefix:array<addr>=[]
    data=snapshot(data @prefix @state) length=snapshot(length @prefix @state)
    let bytes=snapshot(byte_descriptor(data length node @state) @prefix @state)
    let checked=snapshot(intrinsic(name [bytes] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    # The helper borrows the byte view for this call. Its optional offsets
    # are owned scratch storage, independent of the final uint32 table.
    prefix.push(release_block(bytes word(layouts.array_descriptor.size node @state) node @state))
    let valid=intrinsic('__ne__' [read_word(checked 0 node @state) word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
    let fits=intrinsic('__le__' [length word(uint32.max node @state)] types.primitive('bool' @state.type_nodes) node @state)
    valid=put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'and' fits valid] @state)
    let success:array<addr>=[]
    let offsets=snapshot(read_word(checked 8 node @state) @success @state)
    let count=snapshot(read_word(offsets layouts.array_descriptor.length node @state) @success @state)
    let boundaries=snapshot(allocation(word_op('__mul__' count word(4 node @state) node @state) node @state) @success @state)
    let cursor=snapshot(word(0 node @state) @success @state)
    let source=word_op('__add__' read_word(offsets 0 node @state) word_op('__mul__' cursor word(8 node @state) node @state) node @state)
    let target=word_op('__add__' boundaries word_op('__mul__' cursor word(4 node @state) node @state) node @state)
    let narrowed=put(hir.Transmute[node.loc types.primitive('uint32' @state.type_nodes) read_word(source 0 node @state)] @state)
    let write=intrinsic('__store_u32__' [narrowed target] types.primitive('void' @state.type_nodes) node @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let condition=intrinsic('__lt__' [cursor count] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition sequence([write increment] node @state)] @state)
    success.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    let result=string_memory(data length boundaries word_op('__sub__' count word(1 node @state) node @state) word(0 node @state) node @state)
    if optional {
        let cell=snapshot(allocation(word(16 node @state) node @state) @prefix @state)
        prefix.push(store_word(word(0 node @state) cell 0 node @state))
        prefix.push(store_word(word(0 node @state) cell 8 node @state))
        success.push(store_word(result cell 8 node @state))
        success.push(store_word(word(member_tag(types.primitive('string' @state.type_nodes) @state) node @state) cell 0 node @state))
        prefix.push(conditional(valid sequence(success node @state) node @state))
        prefix.push(conditional(intrinsic('__not__' [valid] types.primitive('bool' @state.type_nodes) node @state) release_block(data length node @state) node @state))
        prefix.push(cell)
    } else {
        # Both inputs of concatenation are already valid strings. A failed
        # validation here is unreachable, not an invented empty-string value.
        let yes=put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) true] @state)
        let forever=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) yes sequence([] node @state)] @state)
        let impossible=put(hir.Flow[node.loc types.primitive('never' @state.type_nodes) [forever] none] @state)
        success.push(result)
        let body=put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) success false] @state)
        let selected=put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) valid body] @state)
        prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [selected] impossible] @state))
    }
    # Preserve the selected result before destroying the helper's optional
    # cell and growable offsets array, on success and on invalid UTF-8.
    $runtime_assert prefix.length >? 0
    let selected=prefix.pop
    let output=snapshot(selected @prefix @state)
    let offsets_type=types.array_type(types.primitive('int64' @state.type_nodes) none @state.type_nodes)
    let checked_type=types.union([offsets_type types.primitive('none' @state.type_nodes)] @state.type_nodes)
    prefix.push(release_value(checked checked_type node @state))
    prefix.push(output)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_concat = (node:hir.StringConcat @state:State):>addr => {
    let prefix:array<addr>=[]
    let left=snapshot(owned_value(node.left @state) @prefix @state)
    let right=snapshot(owned_value(node.right @state) @prefix @state)
    let first=snapshot(read_word(left layouts.string_descriptor.byte_length node @state) @prefix @state)
    let second=snapshot(read_word(right layouts.string_descriptor.byte_length node @state) @prefix @state)
    let length=snapshot(word_op('__add__' first second node @state) @prefix @state)
    let data=snapshot(allocation(length node @state) @prefix @state)
    prefix.push(counted_bytes(string_data(left node @state) data word(0 node @state) first node @state))
    prefix.push(counted_bytes(string_data(right node @state) word_op('__add__' data first node @state) word(0 node @state) second node @state))
    prefix.push(string_runtime('_native_string_release' [left] node @state result_void=true))
    prefix.push(string_runtime('_native_string_release' [right] node @state result_void=true))
    prefix.push(segmented_string(data length node false @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# Formatting produces byte views first. Only the final joined buffer is
# segmented, so combining marks can cross interpolation fields too.
TextBytes:type = const [data:addr length:addr]
integer_text = (value:addr type:addr node:hir.AST @prefix:array<addr> @state:State):>TextBytes => {
    let layout=views.fixed_integer_layout(runtime_type(type node @state) state.type_nodes)
    if layout is? none return TextBytes[reject(node 'formatting a non-word integer' @state) word(0 node @state)]
    let uint=types.primitive('uint64' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let actual=snapshot(value @prefix @state)
    let negative=snapshot(if layout.signed intrinsic('__lt__' [actual put(hir.Integer[node.loc hir.node_at(state.nodes actual).value_type '0d' 0] @state)] boolean node @state) else put(hir.Bool[node.loc boolean false] @state) @prefix @state)
    let magnitude=snapshot(put(hir.Transmute[node.loc uint actual] @state) @prefix @state)
    let zero=put(hir.Integer[node.loc uint '0d' 0] @state)
    # Unsigned subtraction also represents abs(int64.min), whose magnitude
    # does not fit a signed word. No signed negation or division overflows.
    let negate=intrinsic('__sub__' [zero magnitude] uint node @state)
    prefix.push(conditional(negative put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) magnitude '=' negate] @state) node @state))
    # Formatting consumes these bytes inside this expression; they never
    # escape into the materialized string. Reserve fixed frame scratch.
    let buffer=snapshot(intrinsic('__alloca__' [word(21 node @state)] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let cursor=snapshot(word(21 node @state) @prefix @state)
    let body:array<addr>=[]
    body.push(put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__sub__' cursor word(1 node @state) node @state)] @state))
    let ten=put(hir.Integer[node.loc uint '0d' 10] @state)
    let digit=intrinsic('__mod__' [magnitude ten] uint node @state)
    let ascii=intrinsic('__add__' [digit put(hir.Integer[node.loc uint '0d' 48] @state)] uint node @state)
    let byte=put(hir.Transmute[node.loc types.primitive('uint8' @state.type_nodes) ascii] @state)
    body.push(intrinsic('__store_u8__' [byte word_op('__add__' buffer cursor node @state)] types.primitive('void' @state.type_nodes) node @state))
    body.push(put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) magnitude '=' intrinsic('__floordiv__' [magnitude ten] uint node @state)] @state))
    let more=intrinsic('__ne__' [magnitude zero] boolean node @state)
    let first=intrinsic('__eq__' [cursor word(21 node @state)] boolean node @state)
    let condition=put(hir.ShortCircuit[node.loc boolean 'or' first more] @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition sequence(body node @state)] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    let sign:array<addr>=[put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__sub__' cursor word(1 node @state) node @state)] @state)]
    sign.push(intrinsic('__store_u8__' [put(hir.Integer[node.loc types.primitive('uint8' @state.type_nodes) '0d' 45] @state) word_op('__add__' buffer cursor node @state)] types.primitive('void' @state.type_nodes) node @state))
    prefix.push(conditional(negative sequence(sign node @state) node @state))
    return TextBytes[snapshot(word_op('__add__' buffer cursor node @state) @prefix @state) snapshot(word_op('__sub__' word(21 node @state) cursor node @state) @prefix @state)]
}
interpolated_string = (node:hir.InterpolatedString @state:State):>addr => {
    let prefix:array<addr>=[]
    let pieces:array<TextBytes>=[]
    let owners:array<addr>=[]
    let total=word(0 node @state)
    loop id in node.parts {
        let original=hir.node_at(state.input.nodes id)
        let plain=types.node_at(state.type_nodes types.unfold(types.strip_refinement(original.value_type state.type_nodes) state.type_nodes))
        let value=snapshot(owned_value(id @state) @prefix @state)
        if owned_string(original.value_type state) {owners.push(value)}
        let part:TextBytes=[word(0 node @state) word(0 node @state)]
        if string_type(original.value_type state) {
            if enum_members(original.value_type state) isnt? none {value=enum_read(value original.value_type types.primitive('string' @state.type_nodes) original @state)}
            part=TextBytes[snapshot(string_data(value node @state) @prefix @state) snapshot(read_word(value layouts.string_descriptor.byte_length node @state) @prefix @state)]
        } else if types.is_primitive(plain 'bool') {
            let word_type=types.primitive('int64' @state.type_nodes)
            let yes=put(hir.String[node.loc word_type 'true'] @state)
            let no=put(hir.String[node.loc word_type 'false'] @state)
            let pointer=put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type value yes] @state)] no] @state)
            let length=put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type value word(4 node @state)] @state)] word(5 node @state)] @state)
            part=TextBytes[snapshot(pointer @prefix @state) snapshot(length @prefix @state)]
        } else {part=integer_text(value original.value_type original @prefix @state)}
        pieces.push(part)
        total=word_op('__add__' total part.length node @state)
    }
    total=snapshot(total @prefix @state)
    let buffer=snapshot(allocation(total node @state) @prefix @state)
    let cursor=word(0 node @state)
    loop part in pieces {
        prefix.push(counted_bytes(part.data word_op('__add__' buffer cursor node @state) word(0 node @state) part.length node @state))
        cursor=word_op('__add__' cursor part.length node @state)
    }
    loop owner in owners {prefix.push(string_runtime('_native_string_release' [owner] node @state result_void=true))}
    prefix.push(segmented_string(buffer total node false @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_join = (call:hir.FunctionCall method:hir.ArrayMethod @state:State):>addr => {
    let prefix:array<addr>=[]
    let array=snapshot(owned_value(method.array @state) @prefix @state)
    let argument=call.kw_args.get('sep')
    if call.pos_args.length >? 0 {argument=call.pos_args[0]}
    let separator=if argument is? none string_literal(hir.String[call.loc types.string_literal('' @state.type_nodes) ''] @state) else owned_value(argument @state)
    separator=snapshot(separator @prefix @state)
    let separator_length=snapshot(read_word(separator layouts.string_descriptor.byte_length call @state) @prefix @state)
    let count=snapshot(read_word(array layouts.array_descriptor.length call @state) @prefix @state)
    let data=snapshot(read_word(array 0 call @state) @prefix @state)
    let total=snapshot(word(0 call @state) @prefix @state)
    let cursor=snapshot(word(0 call @state) @prefix @state)
    let piece=read_word(word_op('__add__' data word_op('__mul__' cursor word(8 call @state) call @state) call @state) 0 call @state)
    let length=read_word(piece layouts.string_descriptor.byte_length call @state)
    let empty=types.primitive('void' @state.type_nodes)
    let increment=put(hir.Assign[call.loc empty cursor '=' word_op('__add__' cursor word(1 call @state) call @state)] @state)
    let running=intrinsic('__lt__' [cursor count] types.primitive('bool' @state.type_nodes) call @state)
    let separated=intrinsic('__gt__' [cursor word(0 call @state)] types.primitive('bool' @state.type_nodes) call @state)
    let sum=put(hir.Assign[call.loc empty total '=' word_op('__add__' total length call @state)] @state)
    let gap=put(hir.Assign[call.loc empty total '=' word_op('__add__' total separator_length call @state)] @state)
    let measure=put(hir.LoopArm[call.loc empty running sequence([sum conditional(separated gap call @state) increment] call @state)] @state)
    prefix.push(put(hir.Flow[call.loc empty [measure] none] @state))
    let buffer=snapshot(allocation(total call @state) @prefix @state)
    prefix.push(put(hir.Assign[call.loc empty cursor '=' word(0 call @state)] @state))
    let offset=snapshot(word(0 call @state) @prefix @state)
    let separator_copy=counted_bytes(string_data(separator call @state) word_op('__add__' buffer offset call @state) word(0 call @state) separator_length call @state)
    let advance_gap=put(hir.Assign[call.loc empty offset '=' word_op('__add__' offset separator_length call @state)] @state)
    let copy=counted_bytes(string_data(piece call @state) word_op('__add__' buffer offset call @state) word(0 call @state) length call @state)
    let advance=put(hir.Assign[call.loc empty offset '=' word_op('__add__' offset length call @state)] @state)
    let fill=put(hir.LoopArm[call.loc empty running sequence([conditional(separated sequence([separator_copy advance_gap] call @state) call @state) copy advance increment] call @state)] @state)
    prefix.push(put(hir.Flow[call.loc empty [fill] none] @state))
    prefix.push(release_value(array hir.node_at(state.input.nodes method.array).value_type call @state))
    prefix.push(string_runtime('_native_string_release' [separator] call @state result_void=true))
    prefix.push(segmented_string(buffer total call false @state))
    return put(hir.Block[call.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
representation = (node:hir.RepresentationCast @state:State):>addr => {
    let source=hir.node_at(state.input.nodes node.expr)
    let source_type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes))
    let target_array=array_type(node.value_type state)
    if source_type is? types.BinaryLiteralType and target_array isnt? none return array_copy(expression(node.expr @state) target_array node @state)
    let source_array=array_type(source.value_type state)
    let optional=views.optional_payload(node.value_type @state.type_nodes)
    let target=if optional is? none node.value_type else optional
    if source_array isnt? none and types.is_primitive(types.node_at(state.type_nodes source_array.element) 'uint8') and string_type(target state) {
        let prefix:array<addr>=[]
        let bytes=read_operand(node.expr @prefix @state)
        let source=snapshot(bytes.value @prefix @state)
        let length=snapshot(read_word(source layouts.array_descriptor.length node @state) @prefix @state)
        let data=snapshot(allocation(length node @state) @prefix @state)
        prefix.push(counted_bytes(read_word(source 0 node @state) data word(0 node @state) length node @state))
        if bytes.owner_type isnt? none {prefix.push(release_value(source bytes.owner_type node @state))}
        let result=snapshot(segmented_string(data length node optional isnt? none @state) @prefix @state)
        prefix.push(result)
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    # Both logical and representation conversions can consume a fresh union
    # result. Preserve its payload before retiring the source cell instead
    # of treating that result as a borrowed binding and abandoning it.
    if cell_members(source.value_type @state) isnt? none and temporary_owner(node.expr @state) return owned_cell_cast(node source.value_type @state)
    if enum_members(node.value_type state) isnt? none return enum_pack(expression(node.expr @state) source.value_type node.value_type node @state)
    if enum_members(source.value_type state) isnt? none return enum_read(expression(node.expr @state) source.value_type node.value_type node @state)
    if cell_members(node.value_type @state) isnt? none {
        # Packing is itself an ownership boundary. Constructors and calls
        # already own their payload; borrowing reads acquire a copy here.
        # Copying expression(...) indiscriminately leaked fresh payloads.
        if cell_members(source.value_type @state) is? none return cell_pack(owned_value(node.expr @state) source.value_type node.value_type node @state owned=true)
        return cell_pack(expression(node.expr @state) source.value_type node.value_type node @state)
    }
    # Checking may prove one alternative without a syntactic type-test read,
    # for example a known nonzero bigint packed by contextual conversion.
    # Preserve evaluation and load the already validated active payload.
    if cell_members(source.value_type @state) isnt? none return cell_payload(expression(node.expr @state) node.value_type node @state)
    if string_type(source.value_type state) {
        if string_type(node.value_type state) return expression(node.expr @state)
        let prefix:array<addr>=[]
        let receiver=read_operand(node.expr @prefix @state)
        let array=array_type(node.value_type state)
        let result:addr?=none
        if array isnt? none and types.is_primitive(types.node_at(state.type_nodes array.element) 'uint8') {result=string_bytes(receiver.value node @state)}
        if array isnt? none and types.is_primitive(types.node_at(state.type_nodes array.element) 'uint32') {result=string_scalars(receiver.value node @state)}
        if array isnt? none and (types.is_primitive(types.node_at(state.type_nodes array.element) 'grapheme') or types.is_primitive(types.node_at(state.type_nodes array.element) 'char')) {result=string_graphemes(receiver.value node @state)}
        if result isnt? none {
            let value=snapshot(result @prefix @state)
            if receiver.owner_type isnt? none {prefix.push(release_value(receiver.value receiver.owner_type node @state))}
            prefix.push(value)
            return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
        }
    }
    return reject(node 'this representation conversion' @state)
}

# Receiver and written arguments are captured before a mutation starts.
# A growable array keeps its descriptor identity while replacing its data;
# shrinking preserves capacity. Only live bytes are copied during growth.
read_word = (descriptor:addr offset:addr node:hir.AST @state:State):>addr => intrinsic('__load_i64__' [address(descriptor offset node @state)] types.primitive('int64' @state.type_nodes) node @state)
store_word = (value:addr descriptor:addr offset:addr node:hir.AST @state:State):>addr => intrinsic('__store_i64__' [value address(descriptor offset node @state)] types.primitive('void' @state.type_nodes) node @state)
sequence = (items:array<addr> node:hir.AST @state:State):>addr => put(hir.Block[node.loc types.primitive('void' @state.type_nodes) items false] @state)
conditional = (condition:addr body:addr node:hir.AST @state:State):>addr => {
    let arm=put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    return put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state)
}
counted_bytes = (source:addr target:addr start:addr stop:addr node:hir.AST @state:State backwards:bool=false):>addr => {
    let prefix:array<addr>=[]
    let cursor=snapshot(start @prefix @state)
    let offset=if backwards word_op('__sub__' cursor word(1 node @state) node @state) else cursor
    let byte=intrinsic('__load_u8__' [word_op('__add__' source offset node @state)] types.primitive('uint8' @state.type_nodes) node @state)
    let store=intrinsic('__store_u8__' [byte word_op('__add__' target offset node @state)] types.primitive('void' @state.type_nodes) node @state)
    let step=word_op(if backwards '__sub__' else '__add__' cursor word(1 node @state) node @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' step] @state)
    let body=sequence([store increment] node @state)
    let condition=intrinsic(if backwards '__gt__' else '__lt__' [cursor stop] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    return sequence(prefix node @state)
}
array_reserve = (descriptor:addr required:addr stride:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return reject(node 'array growth needs the prelude arena allocator' @state)
    let prefix:array<addr>=[]
    let capacity=snapshot(read_word(descriptor layouts.array_descriptor.capacity node @state) @prefix @state)
    let body:array<addr>=[]
    let next=snapshot(word_op('__mul__' capacity word(2 node @state) node @state) @body @state)
    let insufficient=intrinsic('__lt__' [next required] types.primitive('bool' @state.type_nodes) node @state)
    let choose=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) next '=' required] @state)
    body.push(conditional(insufficient choose node @state))
    let data=snapshot(allocation(word_op('__mul__' next word(stride node @state) node @state) node @state) @body @state)
    let source=snapshot(read_word(descriptor layouts.array_descriptor.data node @state) @body @state)
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length node @state) @body @state)
    body.push(counted_bytes(source data word(0 node @state) word_op('__mul__' length word(stride node @state) node @state) node @state))
    # Descriptor ownership describes the data buffer independently of the
    # descriptor's own lifetime. Static/frame views must never be released.
    let release=state.runtime_helpers.get('_arena_release')
    if release isnt? none {
        let name=state.symbols.get(release)
        if name is? none return reject(node 'the arena release helper is absent from the lowered graph' @state)
        let owned=intrinsic('__eq__' [read_word(descriptor layouts.array_descriptor.owner node @state) word(1 node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let freed=intrinsic(name [source word_op('__mul__' capacity word(stride node @state) node @state)] types.primitive('void' @state.type_nodes) node @state)
        body.push(conditional(owned freed node @state))
    }
    body.push(store_word(data descriptor layouts.array_descriptor.data node @state))
    body.push(store_word(next descriptor layouts.array_descriptor.capacity node @state))
    let pinned=compare('__lt__' read_word(descriptor layouts.array_descriptor.owner node @state) word(0 node @state) node @state)
    let next_owner=put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) pinned word(-1 node @state)] @state)] word(1 node @state)] @state)
    body.push(store_word(next_owner descriptor layouts.array_descriptor.owner node @state))
    let condition=intrinsic('__lt__' [capacity required] types.primitive('bool' @state.type_nodes) node @state)
    prefix.push(conditional(condition sequence(body node @state) node @state))
    return sequence(prefix node @state)
}
array_trim = (descriptor:addr length:addr element:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[array_unique(descriptor element node @state)]
    if releasable(element @state) {
        let cursor=snapshot(length @prefix @state)
        let stop=snapshot(read_word(descriptor layouts.array_descriptor.length node @state) @prefix @state)
        let value=dict_element(descriptor cursor element node @state)
        prefix.push(loop_while(compare('__lt__' cursor stop node @state) [release_value(value element node @state) assign_value(cursor word_op('__add__' cursor word(1 node @state) node @state) node @state)] node @state))
    }
    prefix.push(store_word(length descriptor layouts.array_descriptor.length node @state))
    return sequence(prefix node @state)
}
array_method_call = (call:hir.FunctionCall method:hir.ArrayMethod @state:State):>addr => {
    if method.name =? 'join' return string_join(call method @state)
    if method.name =? 'sort' return array_sort(call method @state)
    if method.name not in? ['push' 'pop' 'clear' 'truncate' 'reserve' 'insert'] return reject(call "array {method.name} lowering" @state)
    let type=array_type(hir.node_at(state.input.nodes method.array).value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(call layout.detail @state)
    let prefix:array<addr>=[]
    let descriptor=snapshot(write_route(method.array @state) @prefix @state)
    prefix.push(array_unique(descriptor type.element call @state))
    let arguments:dict<string addr>=[]
    let names:array<string>=[]
    if method.name in? ['push' 'insert'] {names.push('value')}
    if method.name in? ['pop' 'insert'] {names.push('idx')}
    if method.name in? ['truncate' 'reserve'] {names.push('count')}
    loop i in 0.. and i <? call.pos_args.length {
        $runtime_assert i <? names.length
        arguments[names[i]]=snapshot(owned_value(call.pos_args[i] @state) @prefix @state)
    }
    loop [name argument] in call.kw_args {arguments[name]=snapshot(owned_value(argument @state) @prefix @state)}
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length call @state) @prefix @state)
    let new_length=length
    let result:addr?=none
    let void_type=types.primitive('void' @state.type_nodes)
    if method.name =? 'reserve' {
        $runtime_assert 'count' in? arguments
        prefix.push(array_reserve(descriptor arguments['count'] layout.size call @state))
    }
    else if method.name =? 'clear' {new_length=word(0 call @state) prefix.push(array_trim(descriptor new_length type.element call @state))}
    else if method.name =? 'truncate' {
        $runtime_assert 'count' in? arguments
        let condition=intrinsic('__lt__' [arguments['count'] length] types.primitive('bool' @state.type_nodes) call @state)
        let store=array_trim(descriptor arguments['count'] type.element call @state)
        prefix.push(conditional(condition store call @state))
    } else if method.name =? 'push' or method.name =? 'insert' {
        new_length=snapshot(word_op('__add__' length word(1 call @state) call @state) @prefix @state)
        prefix.push(array_reserve(descriptor new_length layout.size call @state))
        let data=snapshot(read_word(descriptor layouts.array_descriptor.data call @state) @prefix @state)
        let index=arguments.get('idx')
        if method.name =? 'push' {index=length}
        $runtime_assert index isnt? none
        let offset=word_op('__mul__' index word(layout.size call @state) call @state)
        if method.name =? 'insert' {
            let bytes=word_op('__mul__' length word(layout.size call @state) call @state)
            prefix.push(counted_bytes(data address(data layout.size call @state) bytes offset call @state backwards=true))
        }
        $runtime_assert 'value' in? arguments
        prefix.push(array_store(arguments['value'] word_op('__add__' data offset call @state) type.element call @state))
    } else {
        new_length=snapshot(word_op('__sub__' length word(1 call @state) call @state) @prefix @state)
        let index=arguments.get('idx')
        if index is? none {index=new_length}
        $runtime_assert index isnt? none
        let data=snapshot(read_word(descriptor layouts.array_descriptor.data call @state) @prefix @state)
        let offset=word_op('__mul__' index word(layout.size call @state) call @state)
        result=snapshot(array_load(word_op('__add__' data offset call @state) type.element call @state) @prefix @state)
        let start=word_op('__add__' offset word(layout.size call @state) call @state)
        let stop=word_op('__mul__' length word(layout.size call @state) call @state)
        prefix.push(counted_bytes(data word_op('__sub__' data word(layout.size call @state) call @state) start stop call @state))
    }
    if method.name not in? ['truncate' 'reserve'] {prefix.push(store_word(new_length descriptor layouts.array_descriptor.length call @state))}
    if result is? none {prefix.push(put(hir.Void[call.loc void_type] @state))}
    else {prefix.push(result)}
    return put(hir.Block[call.loc runtime_type(call.value_type call @state) prefix false] @state)
}

# Sort records carry a normalized unsigned key and the original element bits.
# Keys are evaluated once, in source order, before rearranging the array.
# Stable insertion keeps equal keys in their original order in either direction.
# The hosted large-array radix path can share this record format in a later
# optimization; the native path currently uses insertion for every length.
sort_record = (base:addr index:addr node:hir.AST @state:State):>addr => word_op('__add__' base word_op('__mul__' index word(16 node @state) node @state) node @state)
assign_value = (target:addr value:addr node:hir.AST @state:State):>addr => put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) target '=' value] @state)
loop_while = (condition:addr body:array<addr> node:hir.AST @state:State):>addr => {
    let type=types.primitive('void' @state.type_nodes)
    let arm=put(hir.LoopArm[node.loc type condition sequence(body node @state)] @state)
    return put(hir.Flow[node.loc type [arm] none] @state)
}
sort_key = (value:addr type:addr mask:addr node:hir.AST @state:State):>addr => {
    let layout=views.fixed_integer_layout(type state.type_nodes)
    if layout is? none return reject(node 'a sort key must return a fixed-width integer' @state)
    let unsigned=types.primitive('uint64' @state.type_nodes)
    let wide=put(hir.ValueCast[node.loc types.primitive(if layout.signed 'int64' else 'uint64' @state.type_nodes) value] @state)
    let key=put(hir.Transmute[node.loc unsigned wide] @state)
    if layout.signed {
        let sign=put(hir.Transmute[node.loc unsigned word(-9223372036854775808 node @state)] @state)
        key=intrinsic('__xor__' [key sign] unsigned node @state)
    }
    return intrinsic('__xor__' [key mask] unsigned node @state)
}
array_sort = (call:hir.FunctionCall method:hir.ArrayMethod @state:State):>addr => {
    let type=array_type(hir.node_at(state.input.nodes method.array).value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(call layout.detail @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let unsigned=types.primitive('uint64' @state.type_nodes)
    let prefix:array<addr>=[]
    let descriptor=snapshot(write_route(method.array @state) @prefix @state)
    prefix.push(array_unique(descriptor type.element call @state))
    let key_function:addr?=none
    let key_signature:types.FunctionType?=none
    let key_type=type.element
    let reverse=put(hir.Bool[call.loc boolean false] @state)
    # Options are ordinary arguments: even an empty array evaluates them.
    loop [name argument] in call.kw_args {
        let value=snapshot(expression(argument @state) @prefix @state)
        if name =? 'reverse' {reverse=value}
        else if name =? 'key' {
            key_function=value
            let signature=types.node_at(state.type_nodes types.strip_refinement(hir.node_at(state.input.nodes argument).value_type state.type_nodes))
            if signature isnt? types.FunctionType return reject(call 'a sort key must be a single function' @state)
            key_signature=signature key_type=signature.ret
        }
    }
    if views.fixed_integer_layout(key_type state.type_nodes) is? none return reject(call 'a sort key must return a fixed-width integer' @state)
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length call @state) @prefix @state)
    let data=snapshot(read_word(descriptor layouts.array_descriptor.data call @state) @prefix @state)
    let size=snapshot(word_op('__mul__' length word(16 call @state) call @state) @prefix @state)
    let records=snapshot(allocation(size call @state) @prefix @state)
    let mask=snapshot(put(hir.Transmute[call.loc unsigned word(0 call @state)] @state) @prefix @state)
    let descending=put(hir.Transmute[call.loc unsigned word(-1 call @state)] @state)
    prefix.push(conditional(reverse assign_value(mask descending call @state) call @state))
    let index=snapshot(word(0 call @state) @prefix @state)
    let record=sort_record(records index call @state)
    let element_pointer=word_op('__add__' data word_op('__mul__' index word(layout.size call @state) call @state) call @state)
    let building:array<addr>=[]
    let element=snapshot(array_load(element_pointer type.element call @state) @building @state)
    let key=element
    if key_function isnt? none and key_signature isnt? none {
        let args:array<addr>=[]
        let first=true
        loop parameter in key_signature.pos_or_kw {
            let argument:addr?=none
            if first {argument=snapshot(owned_copy(element type.element call @state) @building @state)}
            call_slot(argument parameter.value_type parameter.required call @args @state)
            first=false
        }
        loop parameter in key_signature.kw_only {call_slot(none parameter.value_type parameter.required call @args @state)}
        key=snapshot(put(hir.FunctionCall[call.loc runtime_type(key_type call @state) key_function args []] @state) @building @state)
    }
    let normalized=sort_key(key key_type mask call @state)
    building.push(store_word(put(hir.Transmute[call.loc types.primitive('int64' @state.type_nodes) normalized] @state) record 0 call @state))
    building.push(array_store(element address(record 8 call @state) type.element call @state))
    building.push(assign_value(index word_op('__add__' index word(1 call @state) call @state) call @state))
    prefix.push(loop_while(intrinsic('__lt__' [index length] boolean call @state) building call @state))

    let outer=snapshot(word(1 call @state) @prefix @state)
    let inserting:array<addr>=[]
    let held_record=sort_record(records outer call @state)
    let held_key=snapshot(read_word(held_record 0 call @state) @inserting @state)
    let held_element=snapshot(read_word(held_record 8 call @state) @inserting @state)
    let inner=snapshot(outer @inserting @state)
    let previous=word_op('__sub__' inner word(1 call @state) call @state)
    let before=sort_record(records previous call @state)
    let current=sort_record(records inner call @state)
    let before_key=put(hir.Transmute[call.loc unsigned read_word(before 0 call @state)] @state)
    let comparison=intrinsic('__gt__' [before_key put(hir.Transmute[call.loc unsigned held_key] @state)] boolean call @state)
    let condition=put(hir.ShortCircuit[call.loc boolean 'and' intrinsic('__gt__' [inner word(0 call @state)] boolean call @state) comparison] @state)
    let moving:array<addr>=[
        store_word(read_word(before 0 call @state) current 0 call @state)
        store_word(read_word(before 8 call @state) current 8 call @state)
        assign_value(inner previous call @state)
    ]
    inserting.push(loop_while(condition moving call @state))
    inserting.push(store_word(held_key current 0 call @state))
    inserting.push(store_word(held_element current 8 call @state))
    inserting.push(assign_value(outer word_op('__add__' outer word(1 call @state) call @state) call @state))
    prefix.push(loop_while(intrinsic('__lt__' [outer length] boolean call @state) inserting call @state))

    prefix.push(assign_value(index word(0 call @state) call @state))
    let restored=array_load(address(record 8 call @state) type.element call @state)
    prefix.push(loop_while(intrinsic('__lt__' [index length] boolean call @state) [
        array_store(restored element_pointer type.element call @state)
        assign_value(index word_op('__add__' index word(1 call @state) call @state) call @state)
    ] call @state))
    # Record movement transfers existing handles. Only the scratch buffer is
    # owned by this operation; array elements retain their existing owners.
    let release=state.runtime_helpers.get('_arena_release')
    if state.allocator isnt? none and release isnt? none {
        let name=state.symbols.get(release)
        if name is? none return reject(call 'the arena release helper is absent from the lowered graph' @state)
        prefix.push(intrinsic(name [records size] types.primitive('void' @state.type_nodes) call @state))
    }
    return sequence(prefix call @state)
}

# Record fields embed other records, but store arrays and callable values as
# handles. Copy fields through the selected dynamic brand's schema rather
# than blindly reading the maximum reserved size of a parent: a smaller
# child need not contain the storage reserved for one of its siblings.
# Boolean storage queries inspect the arena in place. Returning an optional
# ObjectType just to test for presence would copy its fields, methods and
# identity strings, then discard all of that metadata at every value use.
object_valued = (id:addr state:State):>bool => {
    let plain=views.structural_base(id state.type_nodes)
    $runtime_assert plain <? state.type_nodes.entries.length
    return state.type_nodes.entries[plain] is? types.ObjectType
}
array_valued = (id:addr state:State):>bool => {
    let plain=views.structural_base(id state.type_nodes)
    $runtime_assert plain <? state.type_nodes.entries.length
    return state.type_nodes.entries[plain] is? types.ArrayType
}
object_type = (id:addr state:State):>types.ObjectType? => {
    let type=types.node_at(state.type_nodes views.structural_base(id state.type_nodes))
    return if type is? types.ObjectType type else none
}
aggregate = (id:addr state:State):>bool => {
    let plain=types.node_at(state.type_nodes views.structural_base(id state.type_nodes))
    return (plain is? types.TypeOr and enum_members(id state) is? none) or string_type(id state) or array_valued(id state) or object_valued(id state)
}
object_layout = (id:addr node:hir.AST @state:State):>layouts.Record => {
    # Lowering only appends types, and the compilation's brand registry is
    # already complete. A normalized record's offsets cannot change while
    # legalizing another expression; retain them across loads and copy helpers.
    let plain=views.structural_base(id state.type_nodes)
    let cached=state.record_layouts.get(plain)
    if cached isnt? none return cached
    let layout=layouts.record(plain state.layout_context @state.type_nodes)
    if layout is? layouts.Pending {reject(node layout.detail @state); return layouts.Record[1 1 []]}
    state.record_layouts[plain]=layout
    return layout
}
brand_number = (name:string state:State):>brands.NumberedBrand? => state.brand_numbers.get(name)
field_pointer = (node:hir.MemberAccess @state:State writable:bool=false):>addr => {
    let value=if writable write_route(node.value @state) else expression(node.value @state)
    return field_address(value node @state)
}
field_address = (value:addr node:hir.MemberAccess @state:State):>addr => {
    let type=hir.node_at(state.input.nodes node.value).value_type
    let layout=object_layout(type node @state)
    let offset=layout.offsets.get(node.name)
    if offset is? none return reject(node 'a checked field is absent from its record layout' @state)
    return address(value offset node @state)
}
field_read = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    if cell_members(type @state) isnt? none or object_valued(type state) return pointer
    if array_valued(type state) return read_word(pointer 0 node @state)
    let plain=types.node_at(state.type_nodes types.strip_refinement(type state.type_nodes))
    if plain is? types.FunctionType {
        return put(hir.Transmute[node.loc runtime_type(type node @state) read_word(pointer 0 node @state)] @state)
    }
    return array_load(pointer type node @state)
}
field_write = (pointer:addr value:addr type:addr node:hir.AST @state:State):>addr => {
    if cell_members(type @state) isnt? none return cell_write(pointer value type node @state)
    if object_valued(type state) return object_write(pointer value type node @state)
    if array_valued(type state) return store_word(value pointer 0 node @state)
    let plain=types.node_at(state.type_nodes types.strip_refinement(type state.type_nodes))
    if plain is? types.FunctionType {
        let word=put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) value] @state)
        return store_word(word pointer 0 node @state)
    }
    return array_store(value pointer type node @state)
}

# Return-by-value remains the fallback. The initial projection rule accepts
# one terminal route read, preserving every preceding guard and side effect.
# It does not select a field out of a constructor or change an indirect call.
getter_read = (body:addr nodes:array<hir.AST>):>addr? => {
    let terminal=body
    let node=hir.node_at(nodes terminal)
    let prefix_nodes:set<addr>=set[]
    if node is? hir.Block {
        if node.items.length =? 0 return none
        terminal=node.items[node.items.length-1]
        let pending:array<addr>=[]
        loop i in 0.. and i <? node.items.length-1 {pending.push(node.items[i])}
        loop pending.length >? 0 {
            let child=pending.pop
            if child in? prefix_nodes continue
            prefix_nodes.add(child)
            let current=hir.node_at(nodes child)
            if current is? hir.FunctionLiteral continue
            if current is? hir.Return return none
            loop child in hir.children(current) {pending.push(child)}
        }
        node=hir.node_at(nodes terminal)
        # A block's implicit aggregate result needs its own type rewrite;
        # keep that shape on the ordinary path in this first native slice.
        if node isnt? hir.Return return none
    }
    if node is? hir.Return {
        if node.item is? none return none
        terminal=node.item
        node=hir.node_at(nodes terminal)
    }
    if node isnt? hir.Index|hir.MemberAccess|hir.ExpressedIdentifier return none
    # HIR is an arena and may share nodes. The result override must not also
    # change a use of this record read in the unchanged prefix.
    if terminal in? prefix_nodes return none
    let pending=hir.children(node)
    loop pending.length >? 0 {
        let current=hir.node_at(nodes pending.pop)
        if current is? hir.FunctionLiteral continue
        if current is? hir.Return return none
        loop child in hir.children(current) {pending.push(child)}
    }
    return terminal
}
scalar_getter_projection = (node:hir.MemberAccess @state:State):>ScalarProjection? => {
    let call=hir.node_at(state.input.nodes node.value)
    if call isnt? hir.FunctionCall return none
    let direct=captures.resolve(call.func call.selected_method_index state.capture_plan state.input.nodes)
    if direct is? none return none
    let literal=hir.node_at(state.input.nodes direct)
    if literal isnt? hir.FunctionLiteral or literal.object_receiver return none
    let record=object_type(literal.rettype state)
    if record is? none or literal.rettype not=? call.value_type return none
    let field=types.object_field(record node.name)
    if field is? none or field.value_type not=? node.value_type return none
    let array=array_type(node.value_type state)
    let owned_handle=state.allocator isnt? none and (owned_string(node.value_type state) or array isnt? none and array.length is? none)
    if not types.is_primitive(types.node_at(state.type_nodes node.value_type) 'bool') and views.fixed_integer_layout(node.value_type state.type_nodes) is? none and not owned_handle return none
    if direct not in? state.getter_reads {state.getter_reads[direct]=getter_read(literal.body state.input.nodes)}
    let read=state.getter_reads.get(direct default=none)
    if read is? none return none
    let key="{direct}:{node.name}"
    let existing=state.scalar_projections.get(key)
    if existing isnt? none return existing
    let projection=ScalarProjection[direct read node.name node.value_type fresh('project' @state)]
    state.scalar_projections[key]=projection
    state.pending_projections.push(projection)
    return projection
}
# Exact field operations and dynamic-family dispatch have different sharing
# boundaries. A family's copy/release calls one field helper for its selected
# brand; embedding every child's fields at every parent view expands the same
# work many times. Helpers operate on existing storage and never free its
# enclosing record. Arena-free code keeps its frame allocations in the caller.
RecordOperation:type = 'copy_fields' | 'write_record' | 'release_fields' | 'release_record' | 'release_cell'
record_operation_body = (operation:RecordOperation arguments:array<addr> type:addr node:hir.AST @state:State):>addr => {
    $runtime_assert arguments.length >? 0
    if operation is? 'copy_fields'|'write_record' {
        $runtime_assert arguments.length =? 2
        if operation =? 'copy_fields' return object_fields_body(arguments[0] arguments[1] type node @state)
        return object_write_body(arguments[0] arguments[1] type node @state)
    }
    if operation =? 'release_fields' return release_record_fields_body(arguments[0] type node @state)
    if operation =? 'release_record' return release_record_body(arguments[0] type node @state)
    return release_cell_body(arguments[0] type node @state)
}
record_operation = (operation:RecordOperation arguments:array<addr> type:addr node:hir.AST @state:State):>addr => {
    let storage=views.structural_base(type state.type_nodes)
    if state.allocator is? none return record_operation_body(operation arguments storage node @state)
    let key="{operation}:{storage}"
    let name=state.copy_helpers.get(key)
    let empty=types.primitive('void' @state.type_nodes)
    if name is? none {
        let generated=fresh(operation @state)
        name=generated state.copy_helpers[key]=generated
        let word_type=types.primitive('int64' @state.type_nodes)
        let parameters:array<hir.Param>=[]
        let slots:array<types.PosOrKwArg>=[]
        let inputs:array<addr>=[]
        loop argument in arguments {
            let parameter=fresh('record_storage' @state)
            parameters.push(hir.Param[parameter word_type])
            slots.push(types.PosOrKwArg[parameter word_type])
            inputs.push(put(hir.ExpressedIdentifier[node.loc word_type parameter] @state))
        }
        # Reserve first: recursive records through array/union handles can
        # refer back to this operation while its body is being constructed.
        let body=record_operation_body(operation inputs storage node @state)
        let signature=types.function_type(slots [] none empty [] @state.type_nodes)
        let literal=put(hir.FunctionLiteral[node.loc signature parameters [] none empty body source=state.source_index] @state)
        state.generated.push(program.Function[generated literal])
    }
    $runtime_assert name isnt? none
    return intrinsic(name arguments empty node @state)
}
object_fields = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => record_operation('copy_fields' [destination source] type node @state)
object_fields_body = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => {
    let record=object_type(type state)
    $runtime_assert record isnt? none
    runtime_type(type node @state);
    if state.problem isnt? none return sequence([] node @state)
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    loop field in record.fields {
        let offset=layout.offsets.get(field.name)
        $runtime_assert offset isnt? none
        let pointer=address(source offset node @state)
        let value=field_read(pointer field.value_type node @state)
        let array=array_type(field.value_type state)
        if array isnt? none {value=array_copy(value array node @state)}
        if owned_string(field.value_type state) {value=string_runtime('_native_string_copy' [value] node @state)}
        prefix.push(field_write(address(destination offset node @state) value field.value_type node @state))
    }
    let brand=layout.offsets.get(layouts.brand_field)
    if brand isnt? none {prefix.push(store_word(read_word(source brand node @state) destination brand node @state))}
    return sequence(prefix node @state)
}
object_write = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => record_operation('write_record' [destination source] type node @state)
object_write_body = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => {
    let storage=views.structural_base(type state.type_nodes)
    let record=object_type(type state)
    $runtime_assert record isnt? none
    let layout=object_layout(type node @state)
    let tag_offset=layout.offsets.get(layouts.brand_field)
    if tag_offset is? none return object_fields(destination source type node @state)
    let prefix:array<addr>=[]
    let tag=snapshot(read_word(source tag_offset node @state) @prefix @state)
    let arms:array<addr>=[]
    # Dispatch by the exact runtime brand within the storage family. Record
    # includes Child as a type, yet an exact Record value still belongs to
    # Token & ~Child and must keep all Record fields when copied.
    loop entry in state.layout_context.brands.entries {
        let candidate=types.node_at(state.type_nodes entry.value_type)
        $runtime_assert candidate is? types.ObjectType
        if not subtyping.is_subtype(entry.value_type storage state.links @state.type_nodes) continue
        let brand=brand_number(entry.name state)
        $runtime_assert brand isnt? none
        let condition=intrinsic('__eq__' [tag word(brand.first node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let body=object_fields(destination source entry.value_type node @state)
        arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state))
    }
    let plain=object_fields(destination source type node @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms plain] @state))
    return sequence(prefix node @state)
}
object_copy_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let destination=snapshot(allocation(word(layout.size node @state) node @state) @prefix @state)
    prefix.push(object_write(destination source type node @state))
    prefix.push(destination)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
object_literal = (node:hir.ObjectLiteral @state:State):>addr => {
    let layout=object_layout(node.value_type node @state)
    let record=object_type(node.value_type state)
    $runtime_assert record isnt? none
    let prefix:array<addr>=[]
    let temporary:array<OwnedLocal>=[]
    let destination=snapshot(allocation(word(layout.size node @state) node @state) @prefix @state)
    loop item in node.fields {
        let field=types.object_field(record item.name)
        let offset=layout.offsets.get(item.name)
        $runtime_assert field isnt? none and offset isnt? none
        let value=owned_value(item.value @state)
        if item.binding_id isnt? none {
            let name=symbol(item.name item.binding_id @state)
            let type=runtime_type(field.value_type node @state)
            prefix.push(put(hir.Declare[item.loc types.primitive('void' @state.type_nodes) 'let' name type value item.binding_id] @state))
            value=put(hir.ExpressedIdentifier[item.loc type name item.binding_id] @state)
        }
        if inline_place(field.value_type @state) {
            value=snapshot(value @prefix @state)
            temporary.push(OwnedLocal[value field.value_type])
        }
        prefix.push(field_write(address(destination offset node @state) value field.value_type node @state))
    }
    let offset=layout.offsets.get(layouts.brand_field)
    if offset isnt? none {
        let number:addr=0
        if record.brand isnt? none {
            let brand=brand_number(record.brand state)
            if brand is? none return reject(node 'a minted record has no runtime brand number' @state)
            number=brand.first
        }
        prefix.push(store_word(word(number node @state) destination offset node @state))
    }
    loop item in temporary {prefix.push(release_value(item.value item.value_type node @state))}
    prefix.push(destination)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# Boolean type expressions combine predicates on the same runtime brand.
# Evaluate the source once; a tagged union must also select its record payload
# before reading that brand, since an inactive payload may be none or a scalar.
object_predicate = (tag:addr actual:addr tested:addr node:hir.AST @state:State):>addr => {
    let boolean=types.primitive('bool' @state.type_nodes)
    let type=types.node_at(state.type_nodes types.unfold(tested state.type_nodes))
    if type is? types.TypeOr|types.TypeAnd {
        let conjunction=type is? types.TypeAnd
        let result=put(hir.Bool[node.loc boolean conjunction] @state)
        loop member in type.items {
            let matches=object_predicate(tag actual member node @state)
            result=put(hir.ShortCircuit[node.loc boolean if conjunction 'and' else 'or' result matches] @state)
        }
        return result
    }
    if type is? types.TypeNot return intrinsic('__not__' [object_predicate(tag actual type.item node @state)] boolean node @state)
    let decided=type_tests.decide(actual tested state.links @state.type_nodes)
    if decided isnt? none return put(hir.Bool[node.loc boolean decided] @state)
    let record=object_type(tested state)
    if record is? none return reject(node 'this runtime type test representation' @state)
    if record.brand is? none return reject(node 'a structural runtime record test' @state)
    let brand=brand_number(record.brand state)
    if brand is? none return reject(node 'the tested type has no runtime brand number' @state)
    let lower=intrinsic('__ge__' [tag word(brand.first node @state)] boolean node @state)
    let upper=intrinsic('__lt__' [tag word(brand.end node @state)] boolean node @state)
    return put(hir.ShortCircuit[node.loc boolean 'and' lower upper] @state)
}
object_matches = (value:addr actual:addr tested:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let decided=type_tests.decide(actual tested state.links @state.type_nodes)
    if decided isnt? none {
        prefix.push(put(hir.Bool[node.loc boolean decided] @state))
        return put(hir.Block[node.loc boolean prefix false] @state)
    }
    if not object_valued(actual state) return reject(node 'this runtime type test representation' @state)
    let layout=object_layout(actual node @state)
    let offset=layout.offsets.get(layouts.brand_field)
    if offset is? none return reject(node 'the tested value has no brand storage' @state)
    let tag=snapshot(read_word(source offset node @state) @prefix @state)
    prefix.push(object_predicate(tag actual tested node @state))
    return put(hir.Block[node.loc boolean prefix false] @state)
}
object_test = (operand:addr node:hir.TypeTest @state:State):>addr => {
    let actual=hir.node_at(state.input.nodes node.value).value_type
    let result=object_matches(operand actual node.test_type node @state)
    return if node.negated intrinsic('__not__' [result] types.primitive('bool' @state.type_nodes) node @state) else result
}

# Function defaults are callee expressions. The ABI passes an ordinary value
# plus a presence flag; only the absent branch evaluates the default. Keyword
# spelling disappears here, after preserving the source evaluation order.
fresh = (hint:string @state:State):>string => {
    state.serial+=1
    return "__dewy_{hint}_{state.serial}"
}
snapshot = (value:addr @prefix:array<addr> @state:State):>addr => {
    let node=hir.node_at(state.nodes value)
    let name=fresh('argument' @state)
    prefix.push(put(hir.Declare[node.loc types.primitive('void' @state.type_nodes) 'let' name node.value_type value] @state))
    return put(hir.ExpressedIdentifier[node.loc node.value_type name] @state)
}
placeholder = (type:addr node:hir.AST @state:State):>addr => {
    let target=types.node_at(state.type_nodes type)
    if types.is_primitive(target 'bool') return put(hir.Bool[node.loc type false] @state)
    if target is? types.FunctionType {
        let word=put(hir.Integer[node.loc types.primitive('int64' @state.type_nodes) '0d' 0] @state)
        return put(hir.Transmute[node.loc type word] @state)
    }
    return put(hir.Integer[node.loc type '0d' 0] @state)
}
call_slot = (value:addr? type:addr required:bool node:hir.AST @args:array<addr> @state:State):>void => {
    if value isnt? none {args.push(value)}
    else {
        if required {reject(node 'a checked call is missing a required argument' @state);}
        let storage=runtime_type(type node @state)
        args.push(placeholder(storage node @state))
    }
    if not required {args.push(put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) value isnt? none] @state))}
}
# A variant changes only the output ABI. Argument evaluation, default flags,
# ownership decisions, and lifted captures follow the original checked call.
ordinary_call = (id:addr node:hir.FunctionCall result_type:addr @state:State projection:ScalarProjection?=none):>addr => {
    let callee=hir.node_at(state.input.nodes node.func)
    let direct=captures.resolve(node.func node.selected_method_index state.capture_plan state.input.nodes)
    let signature_type=if direct is? none callee.value_type else hir.node_at(state.input.nodes direct).value_type
    let signature=types.node_at(state.type_nodes types.strip_refinement(signature_type state.type_nodes))
    if signature isnt? types.FunctionType return reject(node 'a call requires its selected concrete signature' @state)
    if signature.rest isnt? none return reject(node 'rest argument legalization' @state)
    let prefix:array<addr>=[]
    let function=if direct is? none snapshot(expression(node.func @state) @prefix @state) else code_reference(direct callee @state)
    if projection isnt? none {function=put(hir.ExpressedIdentifier[node.loc code_type(projection.function node @state result=projection.result) projection.symbol] @state)}
    let borrowed=state.borrowed_arguments.get(id set[])
    let disposable=state.disposable_arguments.get(id set[])-borrowed
    let temporary:array<OwnedLocal>=[]
    let positional:array<addr>=[]
    loop argument in node.pos_args {
        let value=snapshot((if argument in? borrowed expression(argument @state) else owned_value(argument @state)) @prefix @state)
        positional.push(value)
        let source=hir.node_at(state.input.nodes argument)
        if argument in? disposable and source isnt? hir.Place and releasable(source.value_type @state) {temporary.push(OwnedLocal[value source.value_type])}
    }
    let keywords:dict<string addr>=[]
    loop [name argument] in node.kw_args {
        let value=snapshot((if argument in? borrowed expression(argument @state) else owned_value(argument @state)) @prefix @state)
        keywords[name]=value
        let source=hir.node_at(state.input.nodes argument)
        if argument in? disposable and source isnt? hir.Place and releasable(source.value_type @state) {temporary.push(OwnedLocal[value source.value_type])}
    }
    let args:array<addr>=[]
    let index:addr=0
    loop parameter in signature.pos_or_kw {
        let value:addr?=none
        if index <? positional.length {value=positional[index]}
        else if parameter.name isnt? none and parameter.name in? keywords {value=keywords.pop(parameter.name)}
        call_slot(value parameter.value_type parameter.required node @args @state)
        index+=1
    }
    if positional.length >? signature.pos_or_kw.length return reject(node 'too many arguments in a checked call' @state)
    loop parameter in signature.kw_only {
        let value:addr?=none
        if parameter.name in? keywords {value=keywords.pop(parameter.name)}
        call_slot(value parameter.value_type parameter.required node @args @state)
    }
    if keywords.length >? 0 return reject(node 'unknown keywords in a checked call' @state)
    if direct isnt? none {
        let capture=state.capture_plan.functions.get(direct)
        $runtime_assert capture isnt? none
        loop binding in capture.captures {
            let stored=state.storage_types.get(binding)
            $runtime_assert stored isnt? none
            let read=hir.ExpressedIdentifier[node.loc stored symbol('capture' binding @state) binding]
            # Captures are read at the call, after the explicit arguments.
            # Aggregate handles are borrowed, matching the hosted lifting
            # contract; captured writes are rejected when the unit is built.
            args.push(snapshot(binding_storage(read stored @state) @prefix @state))
        }
    }
    let called=put(hir.FunctionCall[node.loc result_type function args [] node.selected_method_index node.integer_operation] @state)
    let result=types.node_at(state.type_nodes result_type)
    if temporary.length =? 0 or types.is_primitive(result 'never') {prefix.push(called)}
    else {
        # The callee has finished using these private argument snapshots.
        # Keep the call result alive before reclaiming their aggregate trees.
        let value:addr?=none
        if types.is_primitive(result 'void') {prefix.push(called)}
        else {value=snapshot(called @prefix @state)}
        loop item in temporary {prefix.push(release_value(item.value item.value_type node @state))}
        if value isnt? none {prefix.push(value)}
    }
    return put(hir.Block[node.loc result_type prefix false] @state)
}
# Only the lifted code signature contains captures. Ordinary function values
# retain the source callable ABI, so a capturing unit cannot masquerade as
# a plain function pointer merely because its visible parameters match.
code_type = (id:addr node:hir.AST @state:State result:addr?=none):>addr => {
    let literal=hir.node_at(state.input.nodes id)
    let capture=state.capture_plan.functions.get(id)
    $runtime_assert literal is? hir.FunctionLiteral and capture isnt? none
    let runtime=runtime_type(literal.value_type node @state)
    let signature=types.node_at(state.type_nodes runtime)
    $runtime_assert signature is? types.FunctionType
    let arguments=signature.pos_or_kw
    loop binding in capture.captures {
        let stored=state.storage_types.get(binding)
        $runtime_assert stored isnt? none
        let type=if binding in? state.boxed types.primitive('int64' @state.type_nodes) else runtime_type(stored node @state)
        arguments.push(types.PosOrKwArg[none type])
    }
    return types.function_type(arguments [] none if result is? none signature.ret else runtime_type(result node @state) [] @state.type_nodes)
}
code_reference = (id:addr node:hir.AST @state:State):>addr => {
    let name=state.code_symbols.get(id)
    $runtime_assert name isnt? none
    return put(hir.ExpressedIdentifier[node.loc code_type(id node @state) name] @state)
}
function_value = (id:addr node:hir.AST @state:State):>addr => {
    let capture=state.capture_plan.functions.get(id)
    $runtime_assert capture isnt? none
    if capture.captures.length >? 0 return reject(node 'a capturing function used as a value needs closure storage' @state)
    return code_reference(id node @state)
}
function = (id:addr node:hir.FunctionLiteral @state:State projection:ScalarProjection?=none):>addr => {
    if node.rest_args isnt? none return reject(node 'rest parameter legalization' @state)
    if aggregate(node.rettype state) and state.allocator is? none return reject(node 'aggregate results need the prelude arena allocator' @state)
    let arguments:array<hir.Param>=[]
    let prologue:array<addr>=[]
    let void_type=types.primitive('void' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let capture=state.capture_plan.functions.get(id)
    $runtime_assert capture isnt? none
    if node.object_receiver and capture.captures.length >? 0 return reject(node 'an object method reading enclosing locals needs closure storage' @state)
    loop binding in capture.captures {
        if binding in? capture.writes return reject(node 'writing to a binding from an enclosing function needs closure storage' @state)
    }
    # An implicit result crosses the same value boundary as `return`. This
    # matters when a read-only parameter was borrowed: a returned aggregate
    # must own its storage even when the caller immediately mutates the result.
    let enabled=state.allocator isnt? none and '_arena_release' in? state.runtime_helpers
    let excluded=state.cleanup_excluded
    let rebound:set<addr>=set[]
    let pending:array<addr>=[node.body]
    loop parameter in parameters(node) {if parameter is? hir.BoundParam {pending.push(parameter.value)}}
    let visited:set<addr>=set[]
    loop pending.length >? 0 {
        let child=pending.pop
        if child in? visited continue
        visited.add(child)
        let current=hir.node_at(state.input.nodes child)
        if current is? hir.FunctionLiteral continue
        if current is? hir.Assign {
            let target=hir.node_at(state.input.nodes current.target)
            if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {rebound.add(target.binding_id)}
        }
        # Installed failure reporting uses raw I/O internally. It does not
        # expose the successful path's locals; only source message effects
        # participate in this lifetime decision, as in borrow analysis.
        if current is? hir.RuntimeFailure {
            if current.message isnt? none {pending.push(current.message)}
            continue
        }
        if current is? hir.Transmute and (aggregate(current.value_type state) or aggregate(hir.node_at(state.input.nodes current.expr).value_type state)) {enabled=false}
        if current is? hir.FunctionCall {
            let callee=hir.node_at(state.input.nodes current.func)
            if callee is? hir.ExpressedIdentifier and (callee.name.startswith('__load_') or callee.name.startswith('__store_') or callee.name.startswith('__syscall') or callee.name in? ['__load__' '__store__']) {
                loop argument in current.pos_args {if aggregate(hir.node_at(state.input.nodes argument).value_type state) {enabled=false}}
            }
        }
        loop item in hir.children(current) {pending.push(item)}
    }
    state.cleanup_enabled=enabled state.cleanup_owned=set[]
    let frame_start=state.cleanup_frames.length
    state.cleanup_frames.push([])
    loop argument in parameters(node) {
        if not argument.place and aggregate(argument.value_type state) and state.allocator is? none return reject(node 'aggregate arguments need the prelude arena allocator' @state)
        let type=runtime_type(argument.value_type node @state)
        let name=symbol(argument.name argument.binding_id @state)
        let boxed=argument.binding_id isnt? none and argument.binding_id in? state.boxed
        if argument.place {
            if argument is? hir.BoundParam return reject(node 'a default place parameter' @state)
            arguments.push(hir.Param[name types.primitive('int64' @state.type_nodes) argument.binding_id argument.position_only false])
            continue
        }
        let private=boxed or releasable(argument.value_type @state) and argument.binding_id isnt? none and argument.binding_id in? rebound
        let condition:addr?=none
        if argument is? hir.BoundParam {
            let incoming=fresh('incoming' @state)
            let present=fresh('present' @state)
            arguments.push(hir.Param[incoming type])
            arguments.push(hir.Param[present boolean])
            let present_value=put(hir.ExpressedIdentifier[node.loc boolean present] @state)
            if not private {condition=intrinsic('__not__' [present_value] boolean node @state)}
            let supplied=put(hir.ExpressedIdentifier[node.loc type incoming] @state)
            if private {supplied=copy_value(supplied argument.value_type node @state)}
            let default=owned_value(argument.value @state)
            let arm=put(hir.IfArm[node.loc type present_value supplied] @state)
            let selected=put(hir.Flow[node.loc type [arm] default] @state)
            if boxed {selected=box_value(selected argument.value_type node @state) type=types.primitive('int64' @state.type_nodes)}
            prologue.push(put(hir.Declare[node.loc void_type 'let' name type selected argument.binding_id] @state))
        } else if private {
            let incoming=fresh('incoming' @state)
            arguments.push(hir.Param[incoming type position_only=argument.position_only])
            let value=copy_value(put(hir.ExpressedIdentifier[node.loc type incoming] @state) argument.value_type node @state)
            if boxed {value=box_value(value argument.value_type node @state) type=types.primitive('int64' @state.type_nodes)}
            prologue.push(put(hir.Declare[node.loc void_type 'let' name type value argument.binding_id] @state))
        } else {arguments.push(hir.Param[name type argument.binding_id argument.position_only false])}
        # A missing default is owned here; an explicit read-only argument is
        # still owned by its caller. Boxed/rebound parameters own their local
        # copy on both paths. The condition is the existing ABI presence bit.
        if enabled and (private or argument is? hir.BoundParam) and (boxed or releasable(argument.value_type @state)) and (argument.binding_id is? none or argument.binding_id not in? excluded) {
            let value=put(hir.ExpressedIdentifier[node.loc type name argument.binding_id] @state)
            let box:addr?=none
            if boxed {box=value value=array_load(value argument.value_type node @state)}
            $runtime_assert state.cleanup_frames.length >? 0
            let frame=state.cleanup_frames.pop
            frame.push(OwnedLocal[value argument.value_type box condition])
            state.cleanup_frames.push(frame)
            if private and argument.binding_id isnt? none {state.cleanup_owned.add(argument.binding_id)}
        }
    }
    loop binding in capture.captures {
        let stored=state.storage_types.get(binding)
        $runtime_assert stored isnt? none
        let type=if binding in? state.boxed types.primitive('int64' @state.type_nodes) else runtime_type(stored node @state)
        arguments.push(hir.Param[symbol('capture' binding @state) type binding])
    }
    state.result_projection=projection
    let body=owned_value(node.body @state)
    state.result_projection=none
    let result_type=runtime_type(if projection is? none node.rettype else projection.result node @state)
    let cleanup=cleanup_since(frame_start node @state)
    $runtime_assert state.cleanup_frames.length >? frame_start and state.cleanup_frames.length >? 0
    state.cleanup_frames.pop;
    state.cleanup_enabled=false
    if prologue.length >? 0 or cleanup.length >? 0 {
        let actual=types.node_at(state.type_nodes hir.node_at(state.nodes body).value_type)
        let result:addr?=none
        if types.is_primitive(actual 'void') or types.is_primitive(actual 'never') {prologue.push(body)}
        else {result=snapshot(body @prologue @state)}
        loop release in cleanup {prologue.push(release)}
        if result isnt? none {prologue.push(result)}
        body=put(hir.Block[node.loc result_type prologue false] @state)
    }
    return put(hir.FunctionLiteral[node.loc code_type(id node @state result=if projection is? none none else projection.result) arguments [] none result_type body source=node.source] @state)
}

lower = (root:addr input:emit.Input source:SrcFile allocator:addr?=none layout_context:layouts.Context=layouts.Context[] entry_binding:addr?=none infer_entry:bool=true source_by_item:dict<addr addr>=[] runtime_helpers:dict<string addr>=[] links:array<subtyping.Link>=subtyping.default_links):>Result|Error => {
    let state=State[input source type_nodes=input.types allocator=allocator runtime_helpers=runtime_helpers layout_context=layout_context links=links]
    loop brand in brands.numbered(layout_context.brands) {state.brand_numbers[brand.name]=brand}
    let block=hir.node_at(input.nodes root)
    if block isnt? hir.Block return Error[srcfile=source title='lowering requires a module block']
    discover(root @state)
    state.capture_plan=captures.analyze(root input.nodes state.symbols.keys)
    let borrowed=borrowing.details(root input.nodes input.types state.capture_plan state.links)
    state.borrowed_arguments=borrowed.arguments
    state.disposable_arguments=borrowed.disposable_arguments
    state.cleanup_excluded=borrowed.escaping_places
    loop unit in state.capture_plan.functions.values {
        loop binding in unit.captures {state.cleanup_excluded.add(binding)}
    }
    let units=state.capture_plan.functions
    let named=state.capture_plan.named
    loop [id capture] in units {state.code_symbols[id]="__dewy_function_{id}"}
    loop [binding id] in named {
        let name=state.code_symbols.get(id)
        $runtime_assert name isnt? none
        state.symbols[binding]=name
    }
    let functions:array<program.Function>=[]
    let globals:array<addr>=[]
    let startup:array<addr>=[]
    let main:string?=none
    let entry_literal:addr?=none
    let void_type=types.primitive('void' @state.type_nodes)
    loop id in block.items {
        state.source_index=source_by_item.get(id)
        state.source=if state.source_index is? none source else hir.source_at(state.source_index input.source_files)
        let node=hir.node_at(input.nodes id)
        if node is? hir.Declare {
            let value=hir.node_at(input.nodes node.expr)
            # Aliases are already resolved in the type arena. Any runtime
            # type value is an explicit TypeValue expression at its use site.
            if value is? hir.GenericFunction|hir.TypeValue|hir.OverloadedFunction or compile_time_binding(node state) continue
            let name=symbol(node.name node.binding_id @state)
            if value is? hir.FunctionLiteral {
                if entry_binding isnt? none and node.binding_id =? entry_binding or entry_binding is? none and infer_entry and node.name =? 'main' {main=name entry_literal=node.expr}
                continue
            }
            if aggregate(value.value_type state) and state.allocator is? none {reject(node 'global aggregates need the prelude arena allocator' @state); continue}
            let declared=expression(id @state)
            let declaration=hir.node_at(state.nodes declared)
            if declaration isnt? hir.Declare continue
            let type=declaration.annotation
            $runtime_assert type isnt? none
            let zero=if types.is_primitive(types.node_at(state.type_nodes type) 'bool') put(hir.Bool[node.loc type false] @state) else put(hir.Integer[node.loc type '0d' 0] @state)
            globals.push(put(hir.Declare[node.loc void_type 'let' name type zero node.binding_id] @state))
            let target=put(hir.ExpressedIdentifier[node.loc type name node.binding_id] @state)
            startup.push(put(hir.Assign[node.loc void_type target '=' declaration.expr] @state))
        } else {startup.push(expression(id @state))}
    }
    loop [id capture] in units {
        let node=hir.node_at(input.nodes id)
        $runtime_assert node is? hir.FunctionLiteral
        let name=state.code_symbols.get(id)
        $runtime_assert name isnt? none
        state.source_index=node.source
        state.source=if node.source is? none source else hir.source_at(node.source input.source_files)
        functions.push(program.Function[name function(id node @state)])
    }
    # Never lower a variant inside the active caller's cleanup state. New
    # variants are registered before their bodies, so recursion stays finite.
    let projection_index:addr=0
    loop projection_index <? state.pending_projections.length {
        let projection=state.pending_projections[projection_index]
        projection_index+=1
        let node=hir.node_at(input.nodes projection.function)
        $runtime_assert node is? hir.FunctionLiteral
        state.source_index=node.source
        state.source=if node.source is? none source else hir.source_at(node.source input.source_files)
        functions.push(program.Function[projection.symbol function(projection.function node @state projection=projection)])
    }
    if state.problem isnt? none return state.problem
    if entry_binding isnt? none and main is? none return Error[srcfile=source title='the entry binding is not a concrete function']
    let argv:CommandLine?=none
    if entry_literal isnt? none {
        let entry=hir.node_at(input.nodes entry_literal)
        $runtime_assert entry is? hir.FunctionLiteral
        if entry.pos_or_kw_args.length >? 0 {argv=command_line(entry @state)}
    }
    if state.problem isnt? none return state.problem
    loop function in state.generated {functions.push(function)}
    let normalized=statements.normalize(program.Program[functions globals startup main needs_startup=true source=source argv_prologue=if argv is? none none else argv.prologue argv_value=if argv is? none none else argv.value] emit.Input[state.nodes state.type_nodes input.source_files])
    return Result[normalized.program normalized.input]
}

# C argv is process-lifetime byte storage. Describe each validated UTF-8
# argument as a Dewy string, including argv[0], and place the handles in an
# independently mutable array. This setup runs after library startup.
CommandLine:type = const [prologue:array<addr> value:addr]
command_line = (entry:hir.FunctionLiteral @state:State):>CommandLine => {
    let prefix:array<addr>=[]
    let integer=types.primitive('int64' @state.type_nodes)
    let empty=types.primitive('void' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let argc=put(hir.ExpressedIdentifier[entry.loc integer '__dewy_argc'] @state)
    let argv=put(hir.ExpressedIdentifier[entry.loc integer '__dewy_argv'] @state)
    let output=array_memory(argc 8 entry @state)
    loop item in output.prefix {prefix.push(item)}
    let cursor=snapshot(word(0 entry @state) @prefix @state)
    let body:array<addr>=[]
    let offset=word_op('__mul__' cursor word(8 entry @state) entry @state)
    let data=snapshot(read_word(word_op('__add__' argv offset entry @state) 0 entry @state) @body @state)
    let length=snapshot(word(0 entry @state) @body @state)
    let byte=intrinsic('__load_u8__' [word_op('__add__' data length entry @state)] types.primitive('uint8' @state.type_nodes) entry @state)
    let more=intrinsic('__ne__' [byte put(hir.Integer[entry.loc types.primitive('uint8' @state.type_nodes) '0d' 0] @state)] boolean entry @state)
    let next=put(hir.Assign[entry.loc empty length '=' word_op('__add__' length word(1 entry @state) entry @state)] @state)
    let scan=put(hir.LoopArm[entry.loc empty more sequence([next] entry @state)] @state)
    body.push(put(hir.Flow[entry.loc empty [scan] none] @state))
    # argv bytes belong to the process startup stack, not the arena.
    let owned_data=snapshot(allocation(length entry @state) @body @state)
    body.push(counted_bytes(data owned_data word(0 entry @state) length entry @state))
    let decoded=snapshot(segmented_string(owned_data length entry true @state) @body @state)
    let failed=intrinsic('__eq__' [read_word(decoded 0 entry @state) word(0 entry @state)] boolean entry @state)
    let exit=state.runtime_helpers.get('exit')
    if exit is? none return CommandLine[[] reject(entry 'command-line decoding needs the prelude exit helper' @state)]
    let name=state.symbols.get(exit)
    if name is? none return CommandLine[[] reject(entry 'the command-line exit helper is absent from the graph' @state)]
    body.push(conditional(failed intrinsic(name [word(1 entry @state)] types.primitive('never' @state.type_nodes) entry @state) entry @state))
    body.push(store_word(read_word(decoded 8 entry @state) word_op('__add__' output.data offset entry @state) 0 entry @state))
    body.push(release_block(decoded word(16 entry @state) entry @state))
    body.push(put(hir.Assign[entry.loc empty cursor '=' word_op('__add__' cursor word(1 entry @state) entry @state)] @state))
    let condition=intrinsic('__lt__' [cursor argc] boolean entry @state)
    let iteration=put(hir.LoopArm[entry.loc empty condition sequence(body entry @state)] @state)
    prefix.push(put(hir.Flow[entry.loc empty [iteration] none] @state))
    return CommandLine[prefix output.descriptor]
}

# Iterator setup belongs to the point where its flow arm is reached, not the
# containing function. The condition advances the cursor so `continue`
# advances exactly once as well. An exhausted sequence never reads an item.
IteratorStep:type = [prefix:array<addr> condition:addr]
iterator_step = (node:hir.IteratorExpression @sources:dict<addr DictParts> @state:State):>IteratorStep => {
    let prefix:array<addr>=[]
    let bool_type=types.primitive('bool' @state.type_nodes)
    let void_type=types.primitive('void' @state.type_nodes)
    let source=hir.node_at(state.input.nodes node.iterable)
    let target=hir.node_at(state.input.nodes node.target)
    $runtime_assert target is? hir.ExpressedIdentifier
    let target_type=runtime_type(target.value_type target @state)
    let target_name=symbol(target.name target.binding_id @state)
    let initial=placeholder(target_type node @state)
    let boxed=target.binding_id isnt? none and target.binding_id in? state.boxed
    if boxed {initial=box_value(initial target.value_type node @state) target_type=types.primitive('int64' @state.type_nodes)}
    prefix.push(put(hir.Declare[node.loc void_type 'let' target_name target_type initial target.binding_id] @state))
    let into=put(hir.ExpressedIdentifier[node.loc target_type target_name target.binding_id] @state)
    let cursor=snapshot(word(-1 node @state) @prefix @state)
    let length:addr?=none
    let wide_last:addr?=none
    let wide_more:addr?=none
    let value:addr=0
    let view_owner:addr?=none
    if source is? hir.Range {
        if node.count isnt? none {
            if node.count >? 9223372036854775807 {
                if node.count >? 18446744073709551616 return IteratorStep[prefix reject(node 'range cardinality requiring an arbitrary-precision cursor' @state)]
                # A range may have 2^64 entries, even though every cursor bit
                # pattern fits one word. Its count does not fit a signed
                # length (or, at 2^64, any word). Compare with count-1 after
                # consuming an entry and retain a sticky exhaustion flag.
                wide_last=word(node.count-1 node @state)
                wide_more=snapshot(put(hir.Bool[node.loc bool_type true] @state) @prefix @state)
            } else {length=word(node.count node @state)}
        }
        value=word_op('__add__' word(node.first node @state) word_op('__mul__' cursor word(node.step node @state) node @state) node @state)
    } else {
        let sequence:addr=0
        if source is? hir.DictEntries {
            # Key/value iterator leaves share one evaluated receiver. Keep a
            # fresh receiver alive for the arm, including early returns, rather
            # than losing it behind its borrowed entry-array descriptor.
            let parts=sources.get(source.dictionary)
            if parts is? none {
                parts=dict_parts(source.dictionary @prefix @state)
                prefix.push(dict_ensure(parts node @state compact=true))
                sources[source.dictionary]=parts
                if parts.owner_type isnt? none {
                    $runtime_assert state.cleanup_frames.length >? 0
                    let frame=state.cleanup_frames.pop
                    frame.push(OwnedLocal[parts.pointer parts.owner_type])
                    state.cleanup_frames.push(frame)
                }
            }
            sequence=dict_field(parts source.name node @state)
        } else {sequence=snapshot(expression(node.iterable @state) @prefix @state)}
        if source isnt? hir.DictEntries and temporary_owner(node.iterable @state) {
            # lower_flow gives iterator setup its own cleanup frame. Body
            # continues keep this owner; leaving the arm or returning from
            # the function releases it after the last borrowed element use.
            $runtime_assert state.cleanup_frames.length >? 0
            let frame=state.cleanup_frames.pop
            frame.push(OwnedLocal[sequence source.value_type])
            state.cleanup_frames.push(frame)
        }
        let array=array_type(source.value_type state)
        if array isnt? none {
            let layout=layouts.element(array.element @state.type_nodes nominals=state.layout_context.nominals)
            if layout is? layouts.Pending return IteratorStep[prefix reject(node layout.detail @state)]
            length=snapshot(read_word(sequence layouts.array_descriptor.length node @state) @prefix @state)
            let data=snapshot(read_word(sequence 0 node @state) @prefix @state)
            let pointer=word_op('__add__' data word_op('__mul__' cursor word(layout.size node @state) node @state) node @state)
            value=array_load(pointer array.element node @state)
        } else if string_type(source.value_type state) {
            length=snapshot(read_word(sequence layouts.string_descriptor.grapheme_length node @state) @prefix @state)
            value=string_view(sequence cursor word(1 node @state) node @state)
            let owner=if boxed array_load(into target.value_type node @state) else into
            view_owner=owner
            if state.cleanup_enabled {
                $runtime_assert state.cleanup_frames.length >? 0
                let frame=state.cleanup_frames.pop
                frame.push(OwnedLocal[owner target.value_type])
                state.cleanup_frames.push(frame)
            }
        } else return IteratorStep[prefix reject(node 'this iterator sequence representation' @state)]
    }
    let increment=put(hir.Assign[node.loc void_type cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let available=if length is? none put(hir.Bool[node.loc bool_type true] @state) else intrinsic('__lt__' [cursor length] bool_type node @state)
    let store=if boxed array_store(value into target.value_type node @state) else put(hir.Assign[node.loc void_type into '=' value] @state)
    let yes=put(hir.Bool[node.loc bool_type true] @state)
    let no=put(hir.Bool[node.loc bool_type false] @state)
    if wide_more isnt? none and wide_last isnt? none {
        let next=intrinsic('__ne__' [cursor wide_last] bool_type node @state)
        let update=put(hir.Assign[node.loc void_type wide_more '=' next] @state)
        let body=put(hir.Block[node.loc bool_type [increment update store yes] false] @state)
        let arm=put(hir.IfArm[node.loc bool_type wide_more body] @state)
        return IteratorStep[prefix put(hir.Flow[node.loc bool_type [arm] no] @state)]
    }
    let stores:array<addr>=[]
    if view_owner isnt? none {stores.push(string_runtime('_native_string_release' [view_owner] node @state result_void=true))}
    stores.push(store) stores.push(yes)
    let body=put(hir.Block[node.loc bool_type stores false] @state)
    let arm=put(hir.IfArm[node.loc bool_type available body] @state)
    let condition=put(hir.Flow[node.loc bool_type [arm] no] @state)
    return IteratorStep[prefix put(hir.Block[node.loc bool_type [increment condition] false] @state)]
}
# Nested defaults retain lazy setup for later loop arms and the existing
# rule that `else` runs only when that loop arm never entered.
flow_value = (id:addr expected:addr @state:State):>addr => {
    let source=hir.node_at(state.input.nodes id)
    let value=if state.cleanup_enabled cleanup_scoped(id @state) else expression(id @state)
    if source.value_type =? expected return value
    if types.is_primitive(types.node_at(state.type_nodes expected) 'void') return value
    let actual=types.node_at(state.type_nodes types.unfold(source.value_type state.type_nodes))
    if types.is_primitive(actual 'void') or types.is_primitive(actual 'never') return value
    # Inferred joins need the same representation on every returning path.
    # A narrowed optional payload is a word; the other arm may still be a
    # cell. The flow result must materialize the word into the joined cell.
    if enum_members(expected state) isnt? none return enum_pack(value source.value_type expected source @state)
    if cell_members(expected @state) isnt? none return cell_pack(value source.value_type expected source @state owned=state.cleanup_enabled)
    return read_value(value source.value_type expected source @state)
}
lower_flow = (node:hir.Flow position:addr @state:State):>addr => {
    let type=runtime_type(node.value_type node @state)
    if position >=? node.arms.length return if node.default is? none put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state) else flow_value(node.default node.value_type @state)
    let arm=hir.node_at(state.input.nodes node.arms[position])
    $runtime_assert arm is? hir.IfArm|hir.LoopArm
    let test=hir.node_at(state.input.nodes arm.condition)
    let iterator=arm is? hir.LoopArm and test is? hir.IteratorExpression|hir.MultiIteratorExpression
    let cleanup_start=state.cleanup_frames.length
    let scoped=state.cleanup_enabled and iterator
    if scoped {state.cleanup_frames.push([])}
    let prefix:array<addr>=[]
    let condition:addr=0
    if iterator {
        let step=iterator_condition(test @state)
        prefix=step.prefix condition=step.condition
    } else {condition=expression(arm.condition @state)}
    if state.cleanup_enabled and arm is? hir.LoopArm {state.cleanup_loops.push(state.cleanup_frames.length)}
    let body=flow_value(arm.body node.value_type @state)
    if state.cleanup_enabled and arm is? hir.LoopArm {
        $runtime_assert state.cleanup_loops.length >? 0
        state.cleanup_loops.pop;
    }
    # The fallback runs after setup when this arm never enters. Lower it
    # with the iterator frame still active so a return there cleans it too.
    let fallback:addr?=none
    if position+1 <? node.arms.length or node.default isnt? none {fallback=lower_flow(node position+1 @state)}
    let arm_type=runtime_type(arm.value_type arm @state)
    let lowered=put(if arm is? hir.IfArm hir.IfArm[arm.loc arm_type condition body] else hir.LoopArm[arm.loc arm_type condition body] @state)
    let flow=put(hir.Flow[node.loc type [lowered] fallback] @state)
    if scoped {
        let result:addr?=none
        if types.is_primitive(types.node_at(state.type_nodes type) 'void') or types.is_primitive(types.node_at(state.type_nodes type) 'never') {prefix.push(flow)}
        else {result=snapshot(flow @prefix @state)}
        loop released in cleanup_since(cleanup_start node @state) {prefix.push(released)}
        $runtime_assert state.cleanup_frames.length >? 0
        state.cleanup_frames.pop;
        if result isnt? none {prefix.push(result)}
    } else {
        if prefix.length =? 0 return flow
        prefix.push(flow)
    }
    return put(hir.Block[node.loc type prefix false] @state)
}

# A zip/formula advances all its leaves eagerly, then combines their boolean
# availability. Computing the formula must not short-circuit an iterator's
# advancement: otherwise a later leaf would resume at a different position.
iterator_condition = (node:hir.AST @state:State):>IteratorStep => {
    let sources:dict<addr DictParts>=[]
    if node is? hir.IteratorExpression return iterator_step(node @sources @state)
    if node isnt? hir.MultiIteratorExpression return IteratorStep[[] reject(node 'this iterator condition' @state)]
    if node.repeats_when_exhausted return IteratorStep[[] reject(node 'repeating exhausted iterator formulas' @state)]
    let prefix:array<addr>=[]
    let advance:array<addr>=[]
    let values:array<addr>=[]
    loop id in node.iterators {
        let iterator=hir.node_at(state.input.nodes id)
        $runtime_assert iterator is? hir.IteratorExpression
        let step=iterator_step(iterator @sources @state)
        loop setup in step.prefix {prefix.push(setup)}
        values.push(snapshot(step.condition @advance @state))
    }
    let stack:array<addr>=[]
    let boolean=types.primitive('bool' @state.type_nodes)
    loop token in node.formula {
        if token is? addr {
            $runtime_assert token <? values.length
            stack.push(values[token])
        } else {
            if stack.length <? 2 return IteratorStep[prefix reject(node 'an invalid iterator formula' @state)]
            let right=stack.pop
            let left=stack.pop
            if token is? 'xor'|'xnor' {
                let value=intrinsic('__xor__' [left right] boolean node @state)
                stack.push(if token =? 'xnor' intrinsic('__not__' [value] boolean node @state) else value)
            } else {stack.push(put(hir.ShortCircuit[node.loc boolean token left right] @state))}
        }
    }
    if stack.length not=? 1 return IteratorStep[prefix reject(node 'an invalid iterator formula' @state)]
    advance.push(stack[0])
    return IteratorStep[prefix put(hir.Block[node.loc boolean advance false] @state)]
}

# Literal enums use one word. As with union cells, program-wide tags keep
# narrowing and widening independent of the declaration's member order.
# An enum tag is distinct from its integer member's mathematical value.
enum_members = (id:addr state:State):>array<addr>|none => views.enum_members(types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes) state.type_nodes)
enum_tag = (id:addr @state:State):>addr => {
    let key="enum:{types.shape_of(id state.type_nodes)}"
    let tag=state.union_tags.get(key)
    if tag isnt? none return tag
    let fresh:addr=state.next_tag
    state.next_tag+=1
    state.union_tags[key]=fresh
    return fresh
}
enum_literal = (id:addr node:hir.AST @state:State):>addr => {
    let value=types.node_at(state.type_nodes types.strip_refinement(id state.type_nodes))
    if value is? types.IntegerLiteralType return word(value.value node @state)
    if value is? types.StringLiteralType return string_literal(hir.String[node.loc id value.value] @state)
    return reject(node 'a nonliteral enum member' @state)
}
enum_pack = (value:addr actual:addr expected:addr node:hir.AST @state:State):>addr => {
    if enum_members(actual state) isnt? none return value
    let members=enum_members(expected state)
    $runtime_assert members isnt? none
    loop member in members {
        if not types.same_type(types.strip_refinement(actual state.type_nodes) member state.type_nodes) continue
        let prefix:array<addr>=[]
        snapshot(value @prefix @state);
        prefix.push(word(enum_tag(member @state) node @state))
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    return reject(node 'converting a runtime value into a literal enum' @state)
}
enum_read = (value:addr stored:addr view:addr node:hir.AST @state:State):>addr => {
    if enum_members(view state) isnt? none return value
    let members=enum_members(stored state)
    $runtime_assert members isnt? none
    let prefix:array<addr>=[]
    let tag=snapshot(value @prefix @state)
    let arms:array<addr>=[]
    let fallback:addr?=none
    let type=runtime_type(view node @state)
    loop member in members {
        if not subtyping.is_subtype(member view state.links @state.type_nodes) continue
        let literal=enum_literal(member node @state)
        if fallback isnt? none {
            # Every arm has a literal result. The final member is the default
            # once the checker has excluded all alternatives outside this view.
            let prior=hir.node_at(state.nodes fallback)
            $runtime_assert prior is? hir.IfArm
            arms.push(fallback)
        }
        let condition=intrinsic('__eq__' [tag word(enum_tag(member @state) node @state)] types.primitive('bool' @state.type_nodes) node @state)
        fallback=put(hir.IfArm[node.loc type condition literal] @state)
    }
    if fallback is? none return reject(node 'an empty literal enum read view' @state)
    let last=hir.node_at(state.nodes fallback)
    $runtime_assert last is? hir.IfArm
    prefix.push(put(hir.Flow[node.loc type arms last.body] @state))
    return put(hir.Block[node.loc type prefix false] @state)
}

# Literal-string tests compare bytes; string/grapheme shape tests read the
# descriptor's length. This helper also handles the string payload group in
# a general union, and its caller guards that group before dereferencing it.
string_type_test = (value:addr tested:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let result=put(hir.Bool[node.loc boolean false] @state)
    loop member in type_tests.members(tested state.type_nodes) {
        let type=types.node_at(state.type_nodes types.unfold(member state.type_nodes))
        let matches:addr?=none
        if type is? types.StringLiteralType {
            let literal=string_literal(hir.String[node.loc member type.value] @state)
            matches=string_equal_values(source literal node false @state)
        } else if type is? types.StringType {
            if type.length is? none {matches=put(hir.Bool[node.loc boolean true] @state)}
            else {matches=intrinsic('__eq__' [read_word(source layouts.string_descriptor.grapheme_length node @state) word(type.length node @state)] boolean node @state)}
        } else if types.is_primitive(type 'string') {matches=put(hir.Bool[node.loc boolean true] @state)}
        else if types.is_primitive(type 'char') or types.is_primitive(type 'grapheme') {
            matches=intrinsic('__eq__' [read_word(source layouts.string_descriptor.grapheme_length node @state) word(1 node @state)] boolean node @state)
        }
        if matches isnt? none {result=put(hir.ShortCircuit[node.loc boolean 'or' result matches] @state)}
    }
    prefix.push(result)
    return put(hir.Block[node.loc boolean prefix false] @state)
}


# A union field read evaluates its receiver once. Each record alternative
# uses its own layout, and exception alternatives pass through unchanged.
# The result then adopts the same enum/cell representation as an ordinary
# value conversion; the receiver's tag is never reused as the field's tag.
forwarding_field = (node:hir.ForwardingAccess @state:State):>addr => {
    let source_type=hir.node_at(state.input.nodes node.value).value_type
    let members=cell_members(source_type @state)
    if members is? none return reject(node 'forwarded fields require a tagged record union' @state)
    let prefix:array<addr>=[]
    let receiver=snapshot(expression(node.value @state) @prefix @state)
    let tag=snapshot(read_word(receiver 0 node @state) @prefix @state)
    let output=runtime_type(node.value_type node @state)
    let arms:array<addr>=[]
    loop member in members {
        let actual=member
        let value=cell_payload(receiver member node @state)
        if not subtyping.is_subtype(member node.exception_type state.links @state.type_nodes) {
            let record=object_type(member state)
            if record is? none return reject(node 'a forwarded member is not a record or exception' @state)
            let field=types.object_field(record node.field)
            if field is? none return reject(node 'a checked forwarded field is absent from its record' @state)
            let layout=object_layout(member node @state)
            let offset=layout.offsets.get(node.field)
            if offset is? none return reject(node 'a forwarded field has no storage offset' @state)
            value=field_read(address(value offset node @state) field.value_type node @state)
            actual=field.value_type
        }
        if enum_members(node.value_type state) isnt? none {value=enum_pack(value actual node.value_type node @state)}
        else if enum_members(actual state) isnt? none {value=enum_read(value actual node.value_type node @state)}
        else if cell_members(node.value_type @state) isnt? none {value=cell_pack(value actual node.value_type node @state)}
        else {value=read_value(value actual node.value_type node @state)}
        let condition=intrinsic('__eq__' [tag word(member_tag(member @state) node @state)] types.primitive('bool' @state.type_nodes) node @state)
        arms.push(put(hir.IfArm[node.loc output condition value] @state))
    }
    if arms.length =? 0 return reject(node 'a forwarded field has no reachable member' @state)
    let last=hir.node_at(state.nodes arms.pop)
    $runtime_assert last is? hir.IfArm
    prefix.push(put(hir.Flow[node.loc output arms last.body] @state))
    return put(hir.Block[node.loc output prefix false] @state)
}

# Dictionaries and sets retain the hosted insertion-ordered entry layout.
# Hashes belong to entries; sparse probe slots contain entry positions, -1
# for empty, and -2 for a removed slot. Rebuilding moves live handles inside
# the same owning arrays, so it must not turn those moves into value copies.
DictParts:type = const [pointer:addr layout:layouts.Record key:addr value:addr? owner_type:addr?=none]
DictProbe:type = const [found:addr position:addr slot:addr hash:addr]
dict_parts = (dictionary:addr @prefix:array<addr> @state:State copy:bool=false):>DictParts => {
    let source=hir.node_at(state.input.nodes dictionary)
    let entries=views.container_entry_types(types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes) state.type_nodes)
    $runtime_assert entries isnt? none
    let pointer=snapshot((if copy owned_value(dictionary @state) else write_route(dictionary @state)) @prefix @state)
    let owner:addr?=if copy or temporary_owner(dictionary @state) source.value_type else none
    return DictParts[pointer object_layout(source.value_type source @state) entries.key entries.value owner]
}
dict_from_keys = (keys:addr @prefix:array<addr> @state:State):>DictParts => {
    let member=hir.node_at(state.input.nodes keys)
    $runtime_assert member is? hir.MemberAccess
    return dict_parts(member.value @prefix @state)
}
# Container operations retain a temporary receiver until their result has
# been materialized. Iteration instead keeps this owner for the whole arm.
finish_dictionary = (value:addr parts:DictParts node:hir.AST @prefix:array<addr> @state:State copy_result:bool=false):>addr => {
    if parts.owner_type isnt? none {
        if copy_result {value=copy_value(value node.value_type node @state)}
        value=snapshot(value @prefix @state)
        prefix.push(release_value(parts.pointer parts.owner_type node @state))
    }
    prefix.push(value)
    return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
}
dict_field = (parts:DictParts name:string node:hir.AST @state:State):>addr => {
    let offset=parts.layout.offsets.get(name)
    $runtime_assert offset isnt? none
    return read_word(parts.pointer offset node @state)
}
dict_set_field = (parts:DictParts name:string value:addr node:hir.AST @state:State):>addr => {
    let offset=parts.layout.offsets.get(name)
    $runtime_assert offset isnt? none
    return store_word(value parts.pointer offset node @state)
}
dict_element_pointer = (descriptor:addr index:addr element:addr node:hir.AST @state:State):>addr => {
    let layout=layouts.element(element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    return word_op('__add__' read_word(descriptor layouts.array_descriptor.data node @state) word_op('__mul__' index word(layout.size node @state) node @state) node @state)
}
dict_element = (descriptor:addr index:addr element:addr node:hir.AST @state:State):>addr => array_load(dict_element_pointer(descriptor index element node @state) element node @state)
dict_store_element = (descriptor:addr index:addr value:addr element:addr node:hir.AST @state:State):>addr => {
    return sequence([array_unique(descriptor element node @state) array_store(value dict_element_pointer(descriptor index element node @state) element node @state)] node @state)
}
dict_push = (descriptor:addr value:addr element:addr node:hir.AST @state:State):>addr => {
    let layout=layouts.element(element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let prefix:array<addr>=[]
    # Detaching shared storage can reduce capacity to the live length.
    # Reserve against that new capacity before appending, just as ordinary
    # array push does; detaching at the final store would invalidate reserve.
    prefix.push(array_unique(descriptor element node @state))
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length node @state) @prefix @state)
    let next=word_op('__add__' length word(1 node @state) node @state)
    prefix.push(array_reserve(descriptor next layout.size node @state))
    prefix.push(dict_store_element(descriptor length value element node @state))
    prefix.push(store_word(next descriptor layouts.array_descriptor.length node @state))
    return sequence(prefix node @state)
}
set_local = (target:addr value:addr node:hir.AST @state:State):>addr => put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) target '=' value] @state)
while_loop = (condition:addr body:array<addr> node:hir.AST @state:State):>addr => {
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition sequence(body node @state)] @state)
    return put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state)
}
compare = (name:string left:addr right:addr node:hir.AST @state:State):>addr => intrinsic(name [left right] types.primitive('bool' @state.type_nodes) node @state)
uword = (value:bigint node:hir.AST @state:State):>addr => put(hir.Integer[node.loc types.primitive('uint64' @state.type_nodes) '0d' value] @state)
uword_op = (name:string left:addr right:addr node:hir.AST @state:State):>addr => intrinsic(name [left right] types.primitive('uint64' @state.type_nodes) node @state)
dict_hash = (key:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let hash:addr=0
    let unsigned=types.primitive('uint64' @state.type_nodes)
    if string_type(type state) {
        hash=snapshot(uword(14695981039346656037 node @state) @prefix @state)
        let data=snapshot(string_data(key node @state) @prefix @state)
        let length=snapshot(read_word(key layouts.string_descriptor.byte_length node @state) @prefix @state)
        let cursor=snapshot(word(0 node @state) @prefix @state)
        let byte=intrinsic('__load_u8__' [word_op('__add__' data cursor node @state)] types.primitive('uint8' @state.type_nodes) node @state)
        let widened=put(hir.Transmute[node.loc unsigned byte] @state)
        let mixed=uword_op('__mul__' uword_op('__xor__' hash widened node @state) uword(1099511628211 node @state) node @state)
        prefix.push(while_loop(compare('__lt__' cursor length node @state) [set_local(hash mixed node @state) set_local(cursor word_op('__add__' cursor word(1 node @state) node @state) node @state)] node @state))
    } else {
        let layout=views.fixed_integer_layout(type state.type_nodes)
        let atom=types.node_at(state.type_nodes types.strip_refinement(type state.type_nodes))
        if layout is? none and not types.is_primitive(atom 'bool') and enum_members(type state) is? none return reject(node 'hashing this dictionary key representation' @state)
        let bits=put(hir.Transmute[node.loc unsigned key] @state)
        let mixed=snapshot(uword_op('__mul__' bits uword(11400714819323198485 node @state) node @state) @prefix @state)
        hash=uword_op('__xor__' mixed uword_op('__rshift__' mixed uword(29 node @state) node @state) node @state)
    }
    let masked=uword_op('__and__' hash uword(9223372036854775807 node @state) node @state)
    prefix.push(put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) masked] @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
dict_advance = (cursor:addr perturb:addr mask:addr node:hir.AST @state:State):>array<addr> => {
    let shifted=word_op('__rshift__' perturb word(5 node @state) node @state)
    let next=word_op('__and__' word_op('__add__' word_op('__add__' word_op('__mul__' cursor word(5 node @state) node @state) perturb node @state) word(1 node @state) node @state) mask node @state)
    return [set_local(perturb shifted node @state) set_local(cursor next node @state)]
}
dict_rebuild = (parts:DictParts room:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let word_type=types.primitive('int64' @state.type_nodes)
    let keys=snapshot(dict_field(parts 'keys' node @state) @prefix @state)
    let hashes=snapshot(dict_field(parts 'hashes' node @state) @prefix @state)
    let slots=snapshot(dict_field(parts 'indices' node @state) @prefix @state)
    prefix.push(array_unique(keys parts.key node @state))
    prefix.push(array_unique(hashes word_type node @state))
    prefix.push(array_unique(slots word_type node @state))
    if parts.value isnt? none {prefix.push(array_unique(dict_field(parts 'values' node @state) parts.value node @state))}
    let count=snapshot(read_word(keys layouts.array_descriptor.length node @state) @prefix @state)
    let hashed=snapshot(read_word(hashes layouts.array_descriptor.length node @state) @prefix @state)
    prefix.push(array_reserve(hashes count 8 node @state))
    let writer=snapshot(word(0 node @state) @prefix @state)
    let reader=snapshot(word(0 node @state) @prefix @state)
    let has_hash=compare('__lt__' reader hashed node @state)
    let stored_hash=dict_element(hashes reader word_type node @state)
    let dead=put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'and' has_hash compare('__eq__' stored_hash word(-1 node @state) node @state)] @state)
    let live:array<addr>=[]
    let key=snapshot(dict_element(keys reader parts.key node @state) @live @state)
    let hash_arm=put(hir.IfArm[node.loc word_type has_hash stored_hash] @state)
    let moved_hash=snapshot(put(hir.Flow[node.loc word_type [hash_arm] dict_hash(key parts.key node @state)] @state) @live @state)
    live.push(dict_store_element(keys writer key parts.key node @state))
    if parts.value isnt? none {
        let values=dict_field(parts 'values' node @state)
        live.push(dict_store_element(values writer dict_element(values reader parts.value node @state) parts.value node @state))
    }
    live.push(dict_store_element(hashes writer moved_hash word_type node @state))
    live.push(set_local(writer word_op('__add__' writer word(1 node @state) node @state) node @state))
    let discarded:array<addr>=[release_value(dict_element(keys reader parts.key node @state) parts.key node @state)]
    if parts.value isnt? none {discarded.push(release_value(dict_element(dict_field(parts 'values' node @state) reader parts.value node @state) parts.value node @state))}
    let arm=put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) dead sequence(discarded node @state)] @state)
    let body:array<addr>=[put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] sequence(live node @state)] @state)]
    body.push(set_local(reader word_op('__add__' reader word(1 node @state) node @state) node @state))
    prefix.push(while_loop(compare('__lt__' reader count node @state) body node @state))
    prefix.push(store_word(writer keys layouts.array_descriptor.length node @state))
    prefix.push(store_word(writer hashes layouts.array_descriptor.length node @state))
    if parts.value isnt? none {prefix.push(store_word(writer dict_field(parts 'values' node @state) layouts.array_descriptor.length node @state))}
    prefix.push(dict_set_field(parts 'live' writer node @state))
    let capacity=snapshot(word(8 node @state) @prefix @state)
    let needed=word_op('__mul__' word_op('__add__' writer word(room node @state) node @state) word(3 node @state) node @state)
    prefix.push(while_loop(compare('__le__' word_op('__mul__' capacity word(2 node @state) node @state) needed node @state) [set_local(capacity word_op('__mul__' capacity word(2 node @state) node @state) node @state)] node @state))
    prefix.push(array_reserve(slots capacity 8 node @state))
    prefix.push(store_word(capacity slots layouts.array_descriptor.length node @state))
    prefix.push(set_local(reader word(0 node @state) node @state))
    prefix.push(while_loop(compare('__lt__' reader capacity node @state) [dict_store_element(slots reader word(-1 node @state) word_type node @state) set_local(reader word_op('__add__' reader word(1 node @state) node @state) node @state)] node @state))
    prefix.push(set_local(reader word(0 node @state) node @state))
    let entries:array<addr>=[]
    let hash=snapshot(dict_element(hashes reader word_type node @state) @entries @state)
    let mask=word_op('__sub__' capacity word(1 node @state) node @state)
    let cursor=snapshot(word_op('__and__' hash mask node @state) @entries @state)
    let perturb=snapshot(hash @entries @state)
    entries.push(while_loop(compare('__ge__' dict_element(slots cursor word_type node @state) word(0 node @state) node @state) dict_advance(cursor perturb mask node @state) node @state))
    entries.push(dict_store_element(slots cursor reader word_type node @state))
    entries.push(set_local(reader word_op('__add__' reader word(1 node @state) node @state) node @state))
    prefix.push(while_loop(compare('__lt__' reader writer node @state) entries node @state))
    return sequence(prefix node @state)
}
dict_ensure = (parts:DictParts node:hir.AST @state:State room:addr=0 compact:bool=false):>addr => {
    let slots=read_word(dict_field(parts 'indices' node @state) layouts.array_descriptor.length node @state)
    let entries=read_word(dict_field(parts 'keys' node @state) layouts.array_descriptor.length node @state)
    let condition=compare('__eq__' slots word(0 node @state) node @state)
    let crowded=compare('__gt__' word_op('__mul__' word_op('__add__' entries word(room node @state) node @state) word(3 node @state) node @state) word_op('__mul__' slots word(2 node @state) node @state) node @state)
    condition=put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'or' condition crowded] @state)
    if compact {
        let dead=compare('__gt__' entries dict_field(parts 'live' node @state) node @state)
        condition=put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'or' condition dead] @state)
    }
    return conditional(condition dict_rebuild(parts room node @state) node @state)
}
dict_probe = (parts:DictParts key:addr node:hir.AST @prefix:array<addr> @state:State):>DictProbe => {
    let word_type=types.primitive('int64' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let slots=snapshot(dict_field(parts 'indices' node @state) @prefix @state)
    let keys=snapshot(dict_field(parts 'keys' node @state) @prefix @state)
    let hashes=snapshot(dict_field(parts 'hashes' node @state) @prefix @state)
    let hash=snapshot(dict_hash(key parts.key node @state) @prefix @state)
    let mask=snapshot(word_op('__sub__' read_word(slots layouts.array_descriptor.length node @state) word(1 node @state) node @state) @prefix @state)
    let cursor=snapshot(word_op('__and__' hash mask node @state) @prefix @state)
    let perturb=snapshot(hash @prefix @state)
    let found=snapshot(put(hir.Bool[node.loc boolean false] @state) @prefix @state)
    let searching=snapshot(put(hir.Bool[node.loc boolean true] @state) @prefix @state)
    let position=snapshot(word(-1 node @state) @prefix @state)
    let slot=snapshot(word(-1 node @state) @prefix @state)
    let dummy=snapshot(word(-1 node @state) @prefix @state)
    let body:array<addr>=[]
    let entry=snapshot(dict_element(slots cursor word_type node @state) @body @state)
    let use_dummy=put(hir.IfArm[node.loc word_type compare('__ge__' dummy word(0 node @state) node @state) dummy] @state)
    let selected=put(hir.Flow[node.loc word_type [use_dummy] cursor] @state)
    let stop=set_local(searching put(hir.Bool[node.loc boolean false] @state) node @state)
    let empty=sequence([set_local(slot selected node @state) stop] node @state)
    let deleted=conditional(compare('__lt__' dummy word(0 node @state) node @state) set_local(dummy cursor node @state) node @state)
    let existing=dict_element(keys entry parts.key node @state)
    let equal=if string_type(parts.key state) string_equal_values(existing key node false @state) else compare('__eq__' existing key node @state)
    let same_hash=compare('__eq__' dict_element(hashes entry word_type node @state) hash node @state)
    let same=put(hir.ShortCircuit[node.loc boolean 'and' same_hash equal] @state)
    let hit=sequence([set_local(found put(hir.Bool[node.loc boolean true] @state) node @state) set_local(position entry node @state) set_local(slot cursor node @state) stop] node @state)
    let arms:array<addr>=[put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) compare('__eq__' entry word(-1 node @state) node @state) empty] @state) put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) compare('__eq__' entry word(-2 node @state) node @state) deleted] @state)]
    body.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms conditional(same hit node @state)] @state))
    loop step in dict_advance(cursor perturb mask node @state) {body.push(step)}
    prefix.push(while_loop(searching body node @state))
    return DictProbe[found position slot hash]
}

dict_contains = (node:hir.DictContains @state:State):>addr => {
    let prefix:array<addr>=[]
    let parts=dict_from_keys(node.keys @prefix @state)
    let key=snapshot(owned_value(node.key @state) @prefix @state)
    prefix.push(dict_ensure(parts node @state))
    let probe=dict_probe(parts key node @prefix @state)
    prefix.push(release_value(key parts.key node @state))
    if node.position isnt? none {prefix.push(put(hir.Declare[node.loc types.primitive('void' @state.type_nodes) 'let' node.position types.primitive('int64' @state.type_nodes) probe.position] @state))}
    return finish_dictionary(probe.found parts node @prefix @state)
}
dict_lookup = (node:hir.DictLookup @state:State):>addr => {
    let prefix:array<addr>=[]
    let parts=dict_from_keys(node.keys @prefix @state)
    $runtime_assert parts.value isnt? none
    let key=snapshot(owned_value(node.key @state) @prefix @state)
    let fallback:addr?=none
    if node.default isnt? none {fallback=snapshot(owned_value(node.default @state) @prefix @state)}
    let position:addr?=none
    let found:addr?=none
    if node.proven and node.static_position isnt? none {position=word(node.static_position node @state)}
    else if node.proven and node.position isnt? none {position=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) node.position] @state)}
    else {
        prefix.push(dict_ensure(parts node @state))
        let probe=dict_probe(parts key node @prefix @state)
        position=probe.position found=probe.found
    }
    prefix.push(release_value(key parts.key node @state))
    $runtime_assert position isnt? none
    let value=dict_element(dict_field(parts 'values' node @state) position parts.value node @state)
    if node.proven {value=read_value(value parts.value node.value_type node @state)}
    else {
        $runtime_assert found isnt? none
        if fallback is? none {
            let absent=types.primitive('none' @state.type_nodes)
            fallback=cell_pack(word(0 node @state) absent node.value_type node @state)
            value=cell_pack(value parts.value node.value_type node @state)
            # An already-optional stored element uses its existing cell;
            # a lookup result must independently own that payload too.
            if cell_members(parts.value @state) isnt? none {value=copy_value(value node.value_type node @state)}
        } else {
            let selected:array<addr>=[]
            if cell_members(parts.value @state) is? none and cell_members(node.value_type @state) isnt? none {
                value=cell_pack(value parts.value node.value_type node @state)
            } else {value=copy_value(read_value(value parts.value node.value_type node @state) node.value_type node @state)}
            value=snapshot(value @selected @state)
            $runtime_assert node.default isnt? none
            selected.push(release_value(fallback hir.node_at(state.input.nodes node.default).value_type node @state))
            selected.push(value)
            value=put(hir.Block[node.loc runtime_type(node.value_type node @state) selected false] @state)
        }
        let arm=put(hir.IfArm[node.loc runtime_type(node.value_type node @state) found value] @state)
        value=put(hir.Flow[node.loc runtime_type(node.value_type node @state) [arm] fallback] @state)
    }
    return finish_dictionary(value parts node @prefix @state copy_result=node.proven)
}
dict_insert = (parts:DictParts key:addr value:addr? node:hir.AST @prefix:array<addr> @state:State):>addr => {
    prefix.push(dict_ensure(parts node @state room=1))
    let probe=dict_probe(parts key node @prefix @state)
    let word_type=types.primitive('int64' @state.type_nodes)
    let added:array<addr>=[]
    let keys=dict_field(parts 'keys' node @state)
    added.push(set_local(probe.position read_word(keys layouts.array_descriptor.length node @state) node @state))
    added.push(dict_push(keys key parts.key node @state))
    if value isnt? none and parts.value isnt? none {added.push(dict_push(dict_field(parts 'values' node @state) value parts.value node @state))}
    added.push(dict_push(dict_field(parts 'hashes' node @state) probe.hash word_type node @state))
    added.push(dict_store_element(dict_field(parts 'indices' node @state) probe.slot probe.position word_type node @state))
    added.push(dict_set_field(parts 'live' word_op('__add__' dict_field(parts 'live' node @state) word(1 node @state) node @state) node @state))
    let changed=put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
    if value isnt? none and parts.value isnt? none {
        let values=dict_field(parts 'values' node @state)
        changed=sequence([array_unique(values parts.value node @state) release_value(dict_element(values probe.position parts.value node @state) parts.value node @state) dict_store_element(values probe.position value parts.value node @state)] node @state)
    }
    changed=sequence([changed release_value(key parts.key node @state)] node @state)
    let arm=put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) probe.found changed] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] sequence(added node @state)] @state))
    return probe.position
}
dict_store = (node:hir.DictStore @state:State):>addr => {
    let prefix:array<addr>=[]
    let parts=dict_from_keys(node.keys @prefix @state)
    let key=snapshot(owned_value(node.key @state) @prefix @state)
    let value:addr?=none
    if node.value isnt? none {value=snapshot(owned_value(node.value @state) @prefix @state)}
    let position=dict_insert(parts key value node @prefix @state)
    if node.position isnt? none {prefix.push(put(hir.Declare[node.loc types.primitive('void' @state.type_nodes) 'let' node.position types.primitive('int64' @state.type_nodes) position] @state))}
    if parts.owner_type isnt? none {prefix.push(release_value(parts.pointer parts.owner_type node @state))}
    return sequence(prefix node @state)
}
dict_remove = (node:hir.DictRemove @state:State):>addr => {
    let prefix:array<addr>=[]
    let parts=dict_from_keys(node.keys @prefix @state)
    if node.key is? none {
        let fields:array<string>=['keys' 'hashes' 'indices']
        if parts.value isnt? none {fields.push('values')}
        loop name in fields {
            let element:addr?=if name =? 'keys' parts.key else if name =? 'values' parts.value else types.primitive('int64' @state.type_nodes)
            $runtime_assert element isnt? none
            prefix.push(array_trim(dict_field(parts name node @state) word(0 node @state) element node @state))
        }
        prefix.push(dict_set_field(parts 'live' word(0 node @state) node @state))
        if parts.owner_type isnt? none {prefix.push(release_value(parts.pointer parts.owner_type node @state))}
        return sequence(prefix node @state)
    }
    let key=snapshot(owned_value(node.key @state) @prefix @state)
    let fallback:addr?=none
    if node.default isnt? none {
        let actual=hir.node_at(state.input.nodes node.default).value_type
        let value=owned_value(node.default @state)
        # A lenient set pop can return an optional even though its written
        # default is plain `none`. Both paths must produce the result's cell;
        # a bare zero is not an empty optional descriptor.
        if cell_members(actual @state) is? none and cell_members(node.value_type @state) isnt? none {
            value=cell_pack(value actual node.value_type node @state owned=true)
        }
        fallback=snapshot(value @prefix @state)
    }
    prefix.push(dict_ensure(parts node @state))
    let probe=dict_probe(parts key node @prefix @state)
    prefix.push(release_value(key parts.key node @state))
    let word_type=types.primitive('int64' @state.type_nodes)
    let removed:array<addr>=[]
    let element=if parts.value is? none parts.key else parts.value
    let field=if parts.value is? none 'keys' else 'values'
    let value=snapshot(dict_element(dict_field(parts field node @state) probe.position element node @state) @removed @state)
    removed.push(dict_store_element(dict_field(parts 'hashes' node @state) probe.position word(-1 node @state) word_type node @state))
    removed.push(dict_store_element(dict_field(parts 'indices' node @state) probe.slot word(-2 node @state) word_type node @state))
    removed.push(dict_set_field(parts 'live' word_op('__sub__' dict_field(parts 'live' node @state) word(1 node @state) node @state) node @state))
    if fallback isnt? none {removed.push(release_value(fallback node.value_type node @state))}
    let copied=owned_copy(value element node @state)
    if cell_members(element @state) is? none and cell_members(node.value_type @state) isnt? none {
        copied=cell_pack(copied element node.value_type node @state owned=true)
    } else {copied=read_value(copied element node.value_type node @state)}
    removed.push(copied)
    let result=put(hir.Block[node.loc runtime_type(node.value_type node @state) removed false] @state)
    if fallback isnt? none {
        let arm=put(hir.IfArm[node.loc runtime_type(node.value_type node @state) probe.found result] @state)
        result=put(hir.Flow[node.loc runtime_type(node.value_type node @state) [arm] fallback] @state)
    }
    return finish_dictionary(result parts node @prefix @state)
}
dict_entries = (node:hir.DictEntries @state:State):>addr => {
    let prefix:array<addr>=[]
    let parts=dict_parts(node.dictionary @prefix @state)
    prefix.push(dict_ensure(parts node @state compact=true))
    return finish_dictionary(dict_field(parts node.name node @state) parts node @prefix @state copy_result=true)
}
dict_view = (node:hir.DictView @state:State):>addr => {
    let prefix:array<addr>=[]
    let parts=dict_parts(node.dictionary @prefix @state)
    prefix.push(dict_ensure(parts node @state compact=true))
    if node.name =? 'values' {
        let element=if parts.value is? none parts.key else parts.value
        let field=if parts.value is? none 'keys' else 'values'
        let array=array_type(types.array_type(element none @state.type_nodes) state)
        $runtime_assert array isnt? none
        prefix.push(array_copy(dict_field(parts field node @state) array node @state))
    } else {
        # A key view is an independent set, not an alias of the source's
        # entry array. Its hash table is rebuilt lazily like a set literal's.
        let layout=object_layout(node.value_type node @state)
        let destination=snapshot(allocation(word(layout.size node @state) node @state) @prefix @state)
        let output=DictParts[destination layout parts.key none]
        let keys=array_type(types.array_type(parts.key none @state.type_nodes) state)
        let hashes=array_type(types.array_type(types.primitive('int64' @state.type_nodes) none @state.type_nodes) state)
        $runtime_assert keys isnt? none and hashes isnt? none
        prefix.push(dict_set_field(output 'keys' array_copy(dict_field(parts 'keys' node @state) keys node @state) node @state))
        prefix.push(dict_set_field(output 'hashes' array_copy(dict_field(parts 'hashes' node @state) hashes node @state) node @state))
        let empty=array_memory(word(0 node @state) 8 node @state)
        loop item in empty.prefix {prefix.push(item)}
        prefix.push(dict_set_field(output 'indices' empty.descriptor node @state))
        prefix.push(dict_set_field(output 'live' dict_field(parts 'live' node @state) node @state))
        prefix.push(destination)
    }
    let result=prefix.pop
    return finish_dictionary(result parts node @prefix @state)
}

# Set algebra and dictionary union share insertion/probing with individual
# stores. Iterating the left then the right preserves source insertion order;
# a dictionary union replaces a repeated value without moving its key.
dict_empty = (type:addr node:hir.AST @prefix:array<addr> @state:State):>DictParts => {
    let entries=views.container_entry_types(type state.type_nodes)
    $runtime_assert entries isnt? none
    let layout=object_layout(type node @state)
    let destination=snapshot(allocation(word(layout.size node @state) node @state) @prefix @state)
    let parts=DictParts[destination layout entries.key entries.value]
    let fields:array<string>=['keys' 'hashes' 'indices']
    if entries.value isnt? none {fields.push('values')}
    loop field in fields {
        let element=types.primitive('int64' @state.type_nodes)
        if field =? 'keys' {element=entries.key}
        else if field =? 'values' and entries.value isnt? none {element=entries.value}
        let storage=layouts.element(element @state.type_nodes nominals=state.layout_context.nominals)
        if storage is? layouts.Pending {reject(node storage.detail @state); return parts}
        let memory=array_memory(word(0 node @state) storage.size node @state)
        loop statement in memory.prefix {prefix.push(statement)}
        prefix.push(dict_set_field(parts field memory.descriptor node @state))
    }
    prefix.push(dict_set_field(parts 'live' word(0 node @state) node @state))
    return parts
}
copy_stored = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if owned_string(type state) return string_runtime('_native_string_copy' [value] node @state)
    if cell_members(type @state) isnt? none return cell_copy(value type node @state)
    let array=array_type(type state)
    if array isnt? none return array_copy(value array node @state)
    if object_valued(type state) return object_copy(value type node @state)
    return value
}
algebra_entries = (source:DictParts other:DictParts destination:DictParts mode:string node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    prefix.push(dict_ensure(source node @state compact=true))
    if mode not=? 'all' {prefix.push(dict_ensure(other node @state))}
    let keys=snapshot(dict_field(source 'keys' node @state) @prefix @state)
    let length=snapshot(read_word(keys layouts.array_descriptor.length node @state) @prefix @state)
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let body:array<addr>=[]
    let key=snapshot(dict_element(keys cursor source.key node @state) @body @state)
    let wanted:addr?=none
    if mode not=? 'all' {
        let probe=dict_probe(other key node @body @state)
        wanted=if mode =? 'present' probe.found else intrinsic('__not__' [probe.found] types.primitive('bool' @state.type_nodes) node @state)
    }
    let insert:array<addr>=[]
    let copied=snapshot(copy_stored(key source.key node @state) @insert @state)
    let value:addr?=none
    if source.value isnt? none {
        let stored=dict_element(dict_field(source 'values' node @state) cursor source.value node @state)
        value=snapshot(copy_stored(stored source.value node @state) @insert @state)
    }
    dict_insert(destination copied value node @insert @state);
    let statements=sequence(insert node @state)
    body.push(if wanted is? none statements else conditional(wanted statements node @state))
    body.push(set_local(cursor word_op('__add__' cursor word(1 node @state) node @state) node @state))
    prefix.push(while_loop(compare('__lt__' cursor length node @state) body node @state))
    return sequence(prefix node @state)
}
set_algebra = (node:hir.SetAlgebra @state:State):>addr => {
    let prefix:array<addr>=[]
    # Keep the left value before a later operand can mutate its binding.
    let left=dict_parts(node.left @prefix @state copy=true)
    let right=dict_parts(node.right @prefix @state copy=true)
    let output=dict_empty(node.value_type node @prefix @state)
    if node.op =? 'union' {
        prefix.push(algebra_entries(left right output 'all' node @state))
        prefix.push(algebra_entries(right left output 'all' node @state))
    } else if node.op =? 'intersection' {prefix.push(algebra_entries(left right output 'present' node @state))}
    else if node.op =? 'difference' {prefix.push(algebra_entries(left right output 'absent' node @state))}
    else if node.op =? 'symmetric' {
        prefix.push(algebra_entries(left right output 'absent' node @state))
        prefix.push(algebra_entries(right left output 'absent' node @state))
    } else return reject(node 'an unknown container algebra operation' @state)
    prefix.push(release_value(left.pointer hir.node_at(state.input.nodes node.left).value_type node @state))
    prefix.push(release_value(right.pointer hir.node_at(state.input.nodes node.right).value_type node @state))
    prefix.push(output.pointer)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}


# Ordinary values own their record/array/cell storage or a private string
# descriptor retaining immutable backing. Raw exposure pins that storage.
releasable = (type:addr @state:State):>bool => owned_string(type state) or cell_members(type @state) isnt? none or array_valued(type state) or object_valued(type state)
release_block = (pointer:addr size:addr node:hir.AST @state:State):>addr => {
    let binding=state.runtime_helpers.get('_arena_release')
    if state.allocator is? none or binding is? none return sequence([] node @state)
    let name=state.symbols.get(binding)
    $runtime_assert name isnt? none
    return intrinsic(name [pointer size] types.primitive('void' @state.type_nodes) node @state)
}
release_value = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    if not releasable(type @state) return sequence([] node @state)
    if owned_string(type state) return string_runtime('_native_string_release' [pointer] node @state result_void=true)
    let key=types.shape_of(type state.type_nodes)
    let name=state.release_helpers.get(key)
    if name is? none {
        let generated=fresh('release' @state)
        name=generated state.release_helpers[key]=generated
        let parameter=fresh('released' @state)
        let word_type=types.primitive('int64' @state.type_nodes)
        let empty=types.primitive('void' @state.type_nodes)
        let source=put(hir.ExpressedIdentifier[node.loc word_type parameter] @state)
        let body=release_body(source type node @state)
        let signature=types.function_type([types.PosOrKwArg[parameter word_type]] [] none empty [] @state.type_nodes)
        let literal=put(hir.FunctionLiteral[node.loc signature [hir.Param[parameter word_type]] [] none empty body source=state.source_index] @state)
        state.generated.push(program.Function[generated literal])
    }
    $runtime_assert name isnt? none
    return intrinsic(name [pointer] types.primitive('void' @state.type_nodes) node @state)
}
release_record_fields = (pointer:addr type:addr node:hir.AST @state:State):>addr => record_operation('release_fields' [pointer] type node @state)
release_record_fields_body = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    let record=object_type(type state)
    $runtime_assert record isnt? none
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    loop field in record.fields {
        let offset=layout.offsets.get(field.name)
        $runtime_assert offset isnt? none
        let value=field_read(address(pointer offset node @state) field.value_type node @state)
        if object_valued(field.value_type state) {prefix.push(release_record(value field.value_type node @state))}
        else if cell_members(field.value_type @state) isnt? none {prefix.push(release_cell(value field.value_type node @state))}
        else if releasable(field.value_type @state) {prefix.push(release_value(value field.value_type node @state))}
    }
    return sequence(prefix node @state)
}
release_record = (pointer:addr type:addr node:hir.AST @state:State):>addr => record_operation('release_record' [pointer] type node @state)
release_record_body = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    let storage=views.structural_base(type state.type_nodes)
    let layout=object_layout(type node @state)
    let brand=layout.offsets.get(layouts.brand_field)
    if brand is? none return release_record_fields(pointer type node @state)
    let prefix:array<addr>=[]
    let tag=snapshot(read_word(pointer brand node @state) @prefix @state)
    let arms:array<addr>=[]
    loop entry in state.layout_context.brands.entries {
        if not subtyping.is_subtype(entry.value_type storage state.links @state.type_nodes) continue
        let number=brand_number(entry.name state)
        $runtime_assert number isnt? none
        let condition=intrinsic('__eq__' [tag word(number.first node @state)] types.primitive('bool' @state.type_nodes) node @state)
        arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition release_record_fields(pointer entry.value_type node @state)] @state))
    }
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms release_record_fields(pointer type node @state)] @state))
    return sequence(prefix node @state)
}
release_cell = (pointer:addr type:addr node:hir.AST @state:State):>addr => record_operation('release_cell' [pointer] type node @state)
release_cell_body = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    let members=cell_members(type @state)
    $runtime_assert members isnt? none
    let prefix:array<addr>=[]
    let tag=snapshot(read_word(pointer 0 node @state) @prefix @state)
    let payload=snapshot(read_word(pointer 8 node @state) @prefix @state)
    let arms:array<addr>=[]
    let optional=views.optional_payload(type @state.type_nodes)
    loop member in members {
        if not releasable(member @state) continue
        let condition=intrinsic(if optional isnt? none '__ne__' else '__eq__' [tag word(if optional isnt? none 0 else member_tag(member @state) node @state)] types.primitive('bool' @state.type_nodes) node @state)
        arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition release_value(payload member node @state)] @state))
    }
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms none] @state))
    return sequence(prefix node @state)
}
release_body = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let array=array_type(type state)
    if array isnt? none {
        let data=snapshot(read_word(pointer layouts.array_descriptor.data node @state) @prefix @state)
        let owner=snapshot(read_word(pointer layouts.array_descriptor.owner node @state) @prefix @state)
        let shared:array<addr>=[]
        let count=snapshot(word_op('__sub__' read_word(owner 0 node @state) word(1 node @state) node @state) @shared @state)
        shared.push(store_word(count owner 0 node @state))
        shared.push(conditional(compare('__eq__' count word(0 node @state) node @state) release_block(owner word(8 node @state) node @state) node @state))
        shared.push(assign_value(owner (put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) compare('__eq__' count word(0 node @state) node @state) word(1 node @state)] @state)] word(0 node @state)] @state)) node @state))
        prefix.push(conditional(array_shared(pointer owner node @state) sequence(shared node @state) node @state))
        let owned:array<addr>=[]
        if releasable(array.element @state) {
            let length=snapshot(read_word(pointer layouts.array_descriptor.length node @state) @owned @state)
            let index=snapshot(word(0 node @state) @owned @state)
            let element=array_load(word_op('__add__' data word_op('__mul__' index word(8 node @state) node @state) node @state) array.element node @state)
            owned.push(loop_while(intrinsic('__lt__' [index length] types.primitive('bool' @state.type_nodes) node @state) [release_value(element array.element node @state) assign_value(index word_op('__add__' index word(1 node @state) node @state) node @state)] node @state))
        }
        let size=word_op('__mul__' read_word(pointer layouts.array_descriptor.capacity node @state) read_word(pointer layouts.array_descriptor.stride node @state) node @state)
        owned.push(release_block(data size node @state))
        prefix.push(conditional(intrinsic('__ne__' [owner word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state) sequence(owned node @state) node @state))
        let flags=read_word(pointer layouts.array_descriptor.flags node @state)
        let arena=word_op('__and__' flags word(layouts.array_flags.arena_descriptor node @state) node @state)
        prefix.push(conditional(intrinsic('__ne__' [arena word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state) release_block(pointer word(layouts.array_descriptor.size node @state) node @state) node @state))
        return conditional(compare('__ge__' read_word(pointer layouts.array_descriptor.owner node @state) word(0 node @state) node @state) sequence(prefix node @state) node @state)
    } else if object_valued(type state) {
        prefix.push(release_record(pointer type node @state))
        prefix.push(release_block(pointer word(object_layout(type node @state).size node @state) node @state))
    } else if cell_members(type @state) isnt? none {
        prefix.push(release_cell(pointer type node @state))
        prefix.push(release_block(pointer word(16 node @state) node @state))
    }
    return sequence(prefix node @state)
}

# Cleanup entries refer only to declarations already evaluated on this path.
# The outer frames survive loop exits; returns unwind every active frame.
cleanup_since = (first:addr node:hir.AST @state:State):>array<addr> => {
    let prefix:array<addr>=[]
    let cursor=state.cleanup_frames.length
    loop cursor >? first {
        cursor-=1
        $runtime_assert cursor <? state.cleanup_frames.length
        let frame=state.cleanup_frames[cursor]
        let index=frame.length
        loop index >? 0 {
            index-=1
            $runtime_assert index <? frame.length
            let owned=frame[index]
            let release=release_value(owned.value owned.value_type node @state)
            if owned.condition isnt? none {release=conditional(owned.condition release node @state)}
            prefix.push(release)
            if owned.box isnt? none {prefix.push(release_block(owned.box word(8 node @state) node @state))}
        }
    }
    return prefix
}
# Suppression changes the expression's visible type to void, but does not
# remove ownership of its underlying result. Reclaim that result too.
discarded_value = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Suppress return discarded_value(node.item @state)
    let value=expression(id @state)
    if temporary_owner(id @state) return release_value(value node.value_type node @state)
    return value
}
cleanup_block = (node:hir.Block @state:State):>addr => {
    let start=state.cleanup_frames.length
    state.cleanup_frames.push([])
    let prefix:array<addr>=[]
    let result:addr?=none
    loop index in 0.. and index <? node.items.length {
        let item=node.items[index]
        if index+1 =? node.items.length and not types.is_primitive(types.node_at(state.type_nodes node.value_type) 'void') {
            let value=owned_value(item @state)
            let actual=hir.node_at(state.nodes value)
            if types.is_primitive(types.node_at(state.type_nodes actual.value_type) 'never') {prefix.push(value)}
            else {result=snapshot(value @prefix @state)}
        } else {
            prefix.push(discarded_value(item @state))
        }
    }
    loop released in cleanup_since(start node @state) {prefix.push(released)}
    $runtime_assert state.cleanup_frames.length >? 0
    state.cleanup_frames.pop;
    if result isnt? none {prefix.push(result)}
    return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix node.scoped] @state)
}
cleanup_return = (node:hir.Return @state:State):>addr => {
    let prefix:array<addr>=[]
    let result:addr?=none
    if node.item isnt? none {
        let value=owned_value(node.item @state)
        let type=types.node_at(state.type_nodes hir.node_at(state.nodes value).value_type)
        if types.is_primitive(type 'void') or types.is_primitive(type 'never') {prefix.push(value)}
        else {result=snapshot(value @prefix @state)}
    }
    loop released in cleanup_since(0 node @state) {prefix.push(released)}
    prefix.push(put(hir.Return[node.loc runtime_type(node.value_type node @state) result] @state))
    return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
}

cleanup_scoped = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Block return expression(id @state)
    return cleanup_block(hir.Block[node.loc node.value_type [id] false] @state)
}

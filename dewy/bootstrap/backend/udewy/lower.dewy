    let target_name=symbol(target.name target.binding_id @state)
    let initial=placeholder(target_type node @state)
    let boxed=target.binding_id isnt? none and target.binding_id in? state.boxed
    # A leaf that a formula lets run past its end binds an optional target:
    # one frame cell per loop site, written with the element on each step
    # and with `none` once the leaf is exhausted. The cell never owns its
    # payload; the body borrows the element like an ordinary target.
    let payload=views.optional_payload(target.value_type @state.type_nodes)
    let element_semantic:addr?=none
    if source isnt? hir.Range {
        let array=array_type(source.value_type state)
        if array isnt? none {element_semantic=array.element}
    }
    let optional_target=payload isnt? none and (source is? hir.Range or (element_semantic isnt? none and cell_members(payload @state) is? none))
    let element_cell=optional_target and element_semantic isnt? none and cell_members(element_semantic @state) isnt? none
    if optional_target {
        if boxed return IteratorStep[prefix reject(node 'captured optional iterator targets' @state)]
        if string_type(source.value_type state) return IteratorStep[prefix reject(node 'optional string iterator targets' @state)]
        target_type=types.primitive('int64' @state.type_nodes)
        initial=intrinsic_call('__static_alloca__' [word(16 node @state)] target_type node @state)
    }
    if boxed {initial=box_value(initial target.value_type node @state) target_type=types.primitive('int64' @state.type_nodes)}
    prefix.push(put(hir.Declare[node.loc void_type 'let' target_name target_type initial target.binding_id] @state))
    let into=put(hir.ExpressedIdentifier[node.loc target_type target_name target.binding_id] @state)
    if optional_target {prefix.push(store_word(word(0 node @state) into 0 node @state))}
    let cursor=snapshot(word(-1 node @state) @prefix @state)
    let length:addr?=none
    let wide_last:addr?=none
    let wide_more:addr?=none
    let value:addr=0
    let view_owner:addr?=none
    if source is? hir.Range {
        if node.count is? none and not node.guarded return IteratorStep[prefix reject(node 'unproven unbounded range storage' @state)]
        if node.count isnt? none {
            if node.count >? 9223372036854775807 {
                if node.count >? 18446744073709551616 return IteratorStep[prefix reject(node 'range cardinality requiring an arbitrary-precision cursor' @state)]
                # A range may have 2^64 entries, even though every cursor bit
                # pattern fits one word. Its count does not fit a signed
                # length (or, at 2^64, any word). Compare with count-1 after
                # consuming an entry and retain a sticky exhaustion flag.
                wide_last=word(node.count-1 node @state)
                wide_more=snapshot(put(hir.Bool[node.loc bool_type true] @state) @prefix @state)
            } else {length=word(node.count node @state)}
        }
        value=word_op('__add__' word(node.first node @state) word_op('__mul__' cursor word(node.step node @state) node @state) node @state)

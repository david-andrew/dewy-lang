            let loaded=snapshot(value @writes @state)
            writes.push(store_word(read_word(loaded 0 node @state) into 0 node @state))
            writes.push(store_word(read_word(loaded 8 node @state) into 8 node @state))
        } else {
            writes.push(store_word(word(member_tag(payload @state) node @state) into 0 node @state))
            writes.push(store_word(put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) value] @state) into 8 node @state))
        }

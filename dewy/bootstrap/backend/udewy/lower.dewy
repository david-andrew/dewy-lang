from reporting import Error, Pointer, Span, SrcFile
import p"emit.dewy" as emit
import p"program.dewy" as program
import p"statements.dewy" as statements
import p"layouts.dewy" as layouts
import p"copy_policy.dewy" as copy_policy
import p"captures.dewy" as captures
import p"borrowing.dewy" as borrowing
import p"moves.dewy" as moves
import p"../../semantic/analyze/effects.dewy" as effects
import p"../../semantic/placement.dewy" as placement
import p"../../semantic/hir.dewy" as hir
import p"../../semantic/bindings.dewy" as bindings
import p"../../semantic/ty.dewy" as types
import p"../../semantic/type_queries.dewy" as views
import p"../../semantic/builtins.dewy" as builtins
import p"../../semantic/brands.dewy" as brands
import p"../../semantic/subtyping.dewy" as subtyping
import p"../../semantic/type_tests.dewy" as type_tests

doc"""
Legalize validated semantic HIR into concrete µDewy function units.

Binding ids choose symbols, so source shadowing and imported names cannot
silently capture each other during hoisting. Input nodes remain immutable;
the output arena has its own indices and shares only the type arena values.

Scalar and aggregate storage preserves independent value copies through
arguments, defaults, returns, records, and nested arrays. Cached recursive
copy helpers preserve dynamic brands and the active payload of union cells.
Strings use immutable UTF-8 views with grapheme boundary tables; byte-array
conversions create independent storage. Iterator setup remains local to its
flow arm, and advancing happens before each condition, including continue.

Places share binding slots or inline record/cell storage through fields,
indices, and forwarded parameters. Local functions are hoisted; direct calls
pass read-only captures as hidden arguments, as in the hosted backend.
Escaping closures remain a subsequent step. An unsupported representation reports a
pending-implementation diagnostic before program emission.
"""
OwnedLocal:type = const [value:addr value_type:addr box:addr?=none condition:addr?=none]
ProjectionField:type = const [name:string owner:addr result:addr]
ScalarProjection:type = const [function:addr read:addr fields:array<ProjectionField> result:addr symbol:string borrowed:bool=false]
# One dynamic aggregate copy the lowering decided, for `dewy analyze`: what
# was copied, at which kind of site, and why no borrow or move applied.
CopyNote:type = const [kind:string type:string site:string reason:string loc:Span source:addr? explicit:bool=false runtime_sized:bool=true]
State:type = [
    input:emit.Input
    source:SrcFile
    source_index:addr?=none
    copy_notes:array<CopyNote>=[]
    copy_names:dict<addr string>=[]
    copy_bound_memo:dict<addr bool>=[]
    explicit_copy_sources:set<addr>=set[]
    borrow_rejections:dict<addr string>=[]
    # The owned local a `return` is transferring: its reads own the value.
    transferred_binding:addr?=none
    # Identifier uses that move their local (moves.compute), and the locals
    # they empty, which must be declared `let` for the emptying store.
    moved_uses:set<addr>=set[]
    moved_bindings:set<addr>=set[]
    nodes:array<hir.AST>=[]
    type_nodes:types.Table=types.Table[]
    symbols:dict<addr string>=[]
    serial:addr=0
    # The driver identifies the prelude allocator by binding, not spelling.
    allocator:addr?=none
    runtime_helpers:dict<string addr>=[]
    shared_string_descriptors:bool=false
    layout_context:layouts.Context=layouts.Context[]
    record_layouts:dict<addr layouts.Record>=[]
    links:subtyping.Graph=subtyping.default_links
    brand_numbers:dict<string brands.NumberedBrand>=[]
    # Checked descriptions stay stable while lowering only appends runtime
    # types. Each successful representation is validated once in this state.
    runtime_types:dict<addr addr>=[]
    # A real cell has alternatives; an empty cached list means no cell.
    cell_types:dict<addr array<addr>>=[]
    storage_types:dict<addr addr>=[]
    capture_plan:captures.Plan=captures.Plan[]
    # The enclosing receiver method: its hidden receiver parameter, its
    # record type, and the sibling field bindings read through it.
    receiver_symbol:string?=none
    receiver_type:addr?=none
    receiver_fields:dict<addr string>=[]
    borrowed_arguments:dict<addr set<addr>>=[]
    # Value-boundary ownership transfers (see borrowing.Consumed): arguments
    # the caller donates without releasing, and the parameter reads that
    # adopt them instead of copying.
    consumed_arguments:dict<addr set<addr>>=[]
    consumed_uses:set<addr>=set[]
    # Direct-only mutable parameters receive the caller's prepared owner.
    # They release it normally; their reads never implicitly consume it.
    owned_parameters:set<addr>=set[]
    stable_bindings:set<addr>=set[]
    scoped_views:set<addr>=set[]
    view_scopes:dict<addr addr>=[]
    view_regions:dict<addr array<addr>>=[]
    stable_parameters:dict<addr effects.ParameterEffects>=[]
    array_snapshots:set<addr>=set[]
    view_writes:array<addr>=[]
    disposable_arguments:dict<addr set<addr>>=[]
    code_symbols:dict<addr string>=[]
    # A place is an address of the binding's storage, including the handle
    # slot for an aggregate. Replacing a record/array through @ must replace
    # that slot rather than merely mutate the old object's contents.
    boxed:set<addr>=set[]
    # Nonescaping scalar places use one slot in the function frame, reused
    # on loop iterations. Their addresses cannot outlive this invocation.
    frame_boxes:dict<addr addr>=[]
    # Fixed scalar arrays proven local share reusable function-frame storage.
    frame_arrays:dict<addr ArrayMemory>=[]
    frame_records:dict<addr addr>=[]
    frame_record_bindings:set<addr>=set[]
    nonescaping_places:set<addr>=set[]
    fixed_places:set<addr>=set[]
    addressed:set<addr>=set[]
    place_parameters:set<addr>=set[]
    union_tags:dict<string addr>=[]
    next_tag:addr=1
    copy_helpers:dict<string string>=[]
    debug_names:bool=false
    release_helpers:dict<string string>=[]
    cleanup_enabled:bool=false
    cleanup_frames:array<array<OwnedLocal>>=[]
    cleanup_loops:array<addr>=[]
    loop_depth:addr=0
    loop_levels:addr?=none
    loop_kind:addr?=none
    loop_prologue:array<addr>=[]
    # Program-wide capture/place exclusions are computed once. Rebuilding
    # this set in every function revisited the entire function graph N times.
    cleanup_excluded:set<addr>=set[]
    cleanup_owned:set<addr>=set[]
    # Bindings that are the root of a write route (mutation, dictionary
    # operation, place argument or raw exposure) in the current function.
    mutated_roots:set<addr>=set[]
    generated:array<program.Function>=[]
    getter_reads:dict<addr addr?>=[]
    scalar_projections:dict<string ScalarProjection>=[]
    pending_projections:array<ScalarProjection>=[]
    result_projection:ScalarProjection?=none
    # One immortal `none` cell (tag 0, payload 0) shared by every optional.
    none_cell:string?=none
    problem:Error?=none
]
Result:type = const [program:program.Program input:emit.Input notes:array<CopyNote>=[]]
copy_name = (type:addr @state:State):>string => {
    # Checked type descriptions are immutable during lowering. Render once,
    # even when thousands of sites copy the same arena-node or context type.
    let cached=state.copy_names.get(type)
    if cached isnt? none return cached
    # A minted type describes as its name followed by its structure; the name
    # alone identifies it in a report.
    let name=types.describe(type state.type_nodes)
    let space=name.find(' [')
    if space isnt? none and space >? 0 and space <? name.length and name[0] not=? '[' {name=name[0..space)}
    if name.length >? 48 {name="{name[0..45)}..."}
    state.copy_names[type]=name
    return name
}
note_copy = (kind:string type:addr site:string reason:string node:hir.AST @state:State explicit:bool=false):>void => {
    let name=copy_name(type @state)
    let dynamic=copy_policy.runtime_sized(type state.type_nodes state.layout_context.brands @state.copy_bound_memo)
    state.copy_notes.push(CopyNote[kind name site reason node.loc state.source_index explicit dynamic])
}
copy_kind = (type:addr @state:State):>string? => {
    if owned_string(type state) return 'string'
    if cell_members(type @state) isnt? none return 'cell'
    if array_type(type state) isnt? none return 'array'
    if object_valued(type state) return 'record'
    return none
}
# A payload packed into a cell keeps the layout of the member it was packed
# as, and a moved-out payload is released with the layout of the type that
# receives it. Moving is safe only when every member the read may come from
# has the receiving record's layout; a parent member read as a child, or a
# child member read as its parent, keeps the ordinary copy.
payload_movable = (stored:addr read:addr node:hir.AST @state:State):>bool => {
    let members=cell_members(stored @state)
    if members is? none return false
    # Array, string and word payloads are handles of one shape each.
    if not object_valued(read state) return true
    let size=object_layout(read node @state).size
    loop member in members {
        if not object_valued(member state) continue
        if type_tests.disjoint(member read state.links @state.type_nodes) continue
        if object_layout(member node @state).size not=? size return false
    }
    return true
}
# Whether reading a cell local as a narrower cell hands back the local's own
# cell (`read_value` retags into a fresh cell only when a record member of
# the stored union must split into the read's children).
cell_read_keeps_handle = (stored:addr read:addr @state:State):>bool => {
    if stored =? read return true
    let original=cell_members(stored @state)
    let narrowed=cell_members(read @state)
    if original is? none or narrowed is? none return false
    let tags:set<addr>=set[]
    loop target in narrowed {tags.add(member_tag(target @state))}
    loop member in original {
        if member_tag(member @state) in? tags continue
        if object_valued(member state) and not type_tests.disjoint(member read state.links @state.type_nodes) return false
    }
    return true
}
# Why `owned_value` could not borrow or move the expression it copies.
owned_reason = (id:addr @state:State):>string => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Index|hir.MemberAccess|hir.DictEntries|hir.DictLookup return 'the value stays owned by its container, and nothing borrows it as a read-only view here'
    if node is? hir.ExpressedIdentifier {
        let binding=node.binding_id
        if binding isnt? none and binding in? state.borrow_rejections return "`{node.name}` is not borrowed here: {state.borrow_rejections[binding]}"
        return "`{node.name}` may be used again, and no proven last-use move applies here"
    }
    if node is? hir.FunctionCall return 'the call result is a borrowed view of its receiver'
    return 'the expression reads storage that belongs to something else'
}
put = (node:hir.AST @state:State):>addr => hir.append_node(@state.nodes node)
reject = (node:hir.AST detail:string @state:State):>addr => {
    if state.problem is? none {state.problem=Error[srcfile=state.source title='native lowering implementation pending' pointers=[Pointer[node.loc detail]]]}
    return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
}
symbol = (name:string binding:addr? @state:State):>string => {
    if binding is? none return name
    let existing=state.symbols.get(binding)
    if existing isnt? none return existing
    # Intrinsics have no runtime declarations; discovery preinstalls symbols
    # for every source declaration, including a declaration shadowing one.
    return name
}
# Unit error mints occupy one zero payload word. Their identity travels in
# a surrounding union's tag; the compilation supplies the nominal registry
# and links so a test against the exception/error family selects those tags.
unit_type = (id:addr state:State):>bool => {
    let plain=types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes)
    return plain in? state.layout_context.nominals or types.is_primitive(types.node_at(state.type_nodes plain) 'none')
}
runtime_type = (id:addr node:hir.AST @state:State):>addr => {
    let cached=state.runtime_types.get(id)
    if cached isnt? none return cached
    let result=runtime_type_uncached(id node @state)
    # Failure locations belong to their source use. Do not memoize a fallback
    # representation from a failed validation as if it were a supported type.
    if state.problem is? none {state.runtime_types[id]=result}
    return result
}
runtime_type_uncached = (id:addr node:hir.AST @state:State):>addr => {
    # A negative type test restricts values without changing the positive
    # family's storage. Keep those exclusions out of representation queries.
    let plain=views.structural_base(id state.type_nodes)
    let type=types.node_at(state.type_nodes plain)
    if type is? types.QuantityType return runtime_type(type.number node @state)
    if type is? types.IntegerLiteralType {
        if type.value <? -9223372036854775808 or type.value >? 9223372036854775807 {reject(node 'arbitrary-precision integer storage' @state);}
        return types.primitive('int64' @state.type_nodes)
    }
    if unit_type(plain state) return types.primitive('int64' @state.type_nodes)
    if type is? types.Primitive {
        if type.name in? ['int' 'uint'] return types.primitive(if type.name =? 'int' 'int64' else 'uint64' @state.type_nodes)
        if type.name in? ['bool' 'void' 'never'] or views.fixed_integer_layout(plain state.type_nodes) isnt? none return plain
    }
    if enum_members(id state) isnt? none return types.primitive('int64' @state.type_nodes)
    if cell_members(id @state) isnt? none or types.is_primitive(type 'none') return types.primitive('int64' @state.type_nodes)
    if string_type(id state) return types.primitive('int64' @state.type_nodes)
    if type is? types.BinaryLiteralType return types.primitive('int64' @state.type_nodes)
    if type is? types.ArrayType {
        let element=types.node_at(state.type_nodes types.unfold(types.strip_refinement(type.element state.type_nodes) state.type_nodes))
        if element isnt? types.ObjectType|types.ArrayType|types.FunctionType|types.MetaType and cell_members(type.element @state) is? none and enum_members(type.element state) is? none and not string_type(type.element state) and not types.is_primitive(element 'bool') and not unit_type(type.element state) and views.fixed_integer_layout(type.element state.type_nodes) is? none {reject(node 'array elements requiring owned aggregate storage' @state);}
        return types.primitive('int64' @state.type_nodes)
    }
    if type is? types.MetaType return types.primitive('int64' @state.type_nodes)   # a type value is its brand id
    if type is? types.ObjectType {
        loop field in type.fields {runtime_type(field.value_type node @state);}
        return types.primitive('int64' @state.type_nodes)
    }
    if type is? types.FunctionType {
        if type.type_params.length >? 0 or type.rest isnt? none {reject(node 'generic or rest function signatures' @state);}
        let arguments:array<types.PosOrKwArg>=[]
        loop argument in type.pos_or_kw {
            arguments.push(types.PosOrKwArg[argument.name if argument.place types.primitive('int64' @state.type_nodes) else runtime_type(argument.value_type node @state)])
            if not argument.required {arguments.push(types.PosOrKwArg[none types.primitive('bool' @state.type_nodes)])}
        }
        loop argument in type.kw_only {
            arguments.push(types.PosOrKwArg[argument.name if argument.place types.primitive('int64' @state.type_nodes) else runtime_type(argument.value_type node @state)])
            if not argument.required {arguments.push(types.PosOrKwArg[none types.primitive('bool' @state.type_nodes)])}
        }
        return types.function_type(arguments [] none runtime_type(type.ret node @state) [] @state.type_nodes)
    }
    reject(node 'selecting a concrete representation for this value type' @state);
    return types.primitive('void' @state.type_nodes)
}

# Discover before lowering any initializer/body, preserving forward function
# references. A later capture pass can use the same binding-to-symbol map.
parameters = (node:hir.FunctionLiteral):>array<hir.Param> => {
    let result=node.pos_or_kw_args
    loop parameter in node.kw_only_args {result.push(parameter)}
    return result
}
discover = (id:addr @state:State):>void => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Place {
        let target=hir.node_at(state.input.nodes node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            state.addressed.add(target.binding_id)
            if not inline_place(node.value_type @state) {state.boxed.add(target.binding_id)}
        }
    }
    if node is? hir.Declare and node.binding_id isnt? none {
        state.symbols[node.binding_id]=binding_symbol(node.binding_id node.name state)
        state.storage_types[node.binding_id]=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
    }
    if node is? hir.ObjectLiteral {
        loop field in node.fields {
            if field.binding_id isnt? none {
                state.symbols[field.binding_id]=binding_symbol(field.binding_id field.name state)
                state.storage_types[field.binding_id]=hir.node_at(state.input.nodes field.value).value_type
            }
        }
    }
    if node is? hir.FunctionLiteral {
        loop parameter in parameters(node) {
            if parameter.binding_id isnt? none {state.symbols[parameter.binding_id]=binding_symbol(parameter.binding_id parameter.name state) state.storage_types[parameter.binding_id]=parameter.value_type}
            if parameter.place and parameter.binding_id isnt? none {
                state.addressed.add(parameter.binding_id)
                state.place_parameters.add(parameter.binding_id)
                if not inline_place(parameter.value_type @state) {state.boxed.add(parameter.binding_id)}
            }
        }
    }
    if node is? hir.IteratorExpression {
        let target=hir.node_at(state.input.nodes node.target)
        if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {
            state.symbols[target.binding_id]=binding_symbol(target.binding_id target.name state)
            state.storage_types[target.binding_id]=target.value_type
        }
    }
    loop child in hir.children(node) {discover(child @state)}
}
items = (ids:array<addr> @state:State):>array<addr> => {
    let result:array<addr>=[]
    loop id in ids {result.push(expression(id @state))}
    return result
}
# Exact rational scales and ranges remain compile-time bindings, as in the
# hosted backend. Checking resolves their supported uses; a surviving runtime
# read still receives the ordinary unsupported-representation diagnostic.
compile_time_binding = (node:hir.Declare state:State):>bool => {
    let id=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes))
    if type is? types.QuantityType {type=types.node_at(state.type_nodes type.number)}
    return type is? types.RationalLiteralType or types.is_primitive(type 'range')
}
expression = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if state.problem isnt? none return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
    if node is? hir.CopyValue {
        # A dying fresh result already is independent. Otherwise retain the
        # receiver before any surrounding operation can mutate its source.
        if expression_owns(node.value @state) return owned_value(node.value @state 'explicit copy')
        let kind=if owned_string(node.value_type state) 'string' else copy_kind(node.value_type @state)
        if kind isnt? none {note_copy(kind node.value_type 'explicit copy' 'requested with `.copy()`' node @state explicit=true)}
        return copy_value(expression(node.value @state) node.value_type node @state)
    }
    if node is? hir.ValueCast {
        let actual=hir.node_at(state.input.nodes node.expr).value_type
        if object_valued(actual state) and object_valued(node.value_type state) and expression_owns(node.expr @state) return owned_record(expression(node.expr @state) actual node.value_type node @state)
        if temporary_owner(node.expr @state) {
            if cell_members(actual @state) isnt? none return owned_cell_cast(node actual @state)
            if cell_members(node.value_type @state) isnt? none return cell_pack(owned_value(node.expr @state 'packed into a cell') actual node.value_type node @state owned=true)
        }
        if enum_members(node.value_type state) isnt? none return enum_pack(expression(node.expr @state) actual node.value_type node @state)
        if enum_members(actual state) isnt? none return enum_read(expression(node.expr @state) actual node.value_type node @state)
        # A logical upcast can leave a narrowed union representation behind:
        # (Record & ~Child) | Child fits Record, but its cell must be unpacked
        # before a caller reads Record fields or makes an owned record copy.
        return read_value(expression(node.expr @state) actual node.value_type node @state)
    }
    if node is? hir.Suppress return expression(node.item @state)
    if node is? hir.Place return place_address(node.target @state)
    if node is? hir.GenericFunction|hir.OverloadedFunction return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
    let type=runtime_type(node.value_type node @state)
    if node is? hir.String return string_literal(node @state)
    if node is? hir.BasedString return binary_literal(node @state)
    if node is? hir.StringConcat return string_concat(node @state)
    if node is? hir.InterpolatedString return interpolated_string(node @state)
    if node is? hir.StringLength {
        let prefix:array<addr>=[]
        let receiver=read_operand(node.string @prefix @state)
        # A closed string-literal union is an enum word. Decode its active
        # literal before reading descriptor fields; the enum itself owns no
        # string storage. Open string alternatives already use descriptors.
        let stored=hir.node_at(state.input.nodes node.string).value_type
        let value=if enum_members(stored state) is? none receiver.value else enum_read(receiver.value stored types.primitive('string' @state.type_nodes) node @state)
        let source=snapshot(value @prefix @state)
        prefix.push(ensure_length(source node @state))
        return finish_read(read_word(source layouts.string_descriptor.grapheme_length node @state) ReadOperand[source receiver.owner_type] node @prefix @state)
    }
    if node is? hir.StringIndex return string_index(node @state)
    if node is? hir.StringSlice return string_slice(node @state)
    if node is? hir.StringEqual return string_equal(node @state)
    if node is? hir.RuntimeFailure {
        if node.lowered is? none return reject(node 'runtime failure without installed reporting helpers' @state)
        return expression(node.lowered @state)
    }
    if node is? hir.RepresentationCast return representation(node @state)
    if node is? hir.ObjectLiteral return object_literal(id node @state)
    if node is? hir.TypeTest return runtime_test(node @state)
    if node is? hir.ForwardingAccess return forwarding_field(node @state)
    if node is? hir.DictContains return dict_contains(node @state)
    if node is? hir.DictLookup return dict_lookup(node @state)
    if node is? hir.DictStore return dict_store(node @state)
    if node is? hir.DictRemove return dict_remove(node @state)
    if node is? hir.DictEntries return dict_entries(node @state)
    if node is? hir.DictView return dict_view(node @state)
    if node is? hir.SetAlgebra return set_algebra(node @state)
    if node is? hir.NoneValue|hir.ErrorValue return word(0 node @state)
    if node is? hir.BrandValue {
        # a type as a runtime value: its brand id
        let brand=brand_number(node.brand state)
        if brand is? none return reject(node 'a type value of a type without a runtime brand number' @state)
        return word(brand.first node @state)
    }
    if node is? hir.TypeOf return type_of_value(node @state)
    if node is? hir.MemberAccess {
        # Most fields read a local, not a call result. Inspect its brand in
        # place before asking for a variant, avoiding a record/cell snapshot
        # on every ordinary field access just to rule this optimization out.
        $runtime_assert node.value <? state.input.nodes.length
        if state.input.nodes[node.value] is? hir.FunctionCall|hir.MemberAccess {
            let call_id=projection_call(node.value state.input.nodes)
            if call_id isnt? none {
                let projection=scalar_getter_projection(node call_id @state)
                if projection isnt? none {
                    let call=hir.node_at(state.input.nodes call_id)
                    $runtime_assert call is? hir.FunctionCall
                    return ordinary_call(call_id call runtime_type(node.value_type node @state) @state projection=projection)
                }
            }
        }
        let stored=stored_type(id state)
        let prefix:array<addr>=[]
        let receiver=read_operand(node.value @prefix @state)
        let pointer=field_address(receiver.value node @state)
        let value=read_value(field_read(pointer stored node @state) stored node.value_type node @state)
        return finish_read(value receiver node @prefix @state)
    }
    if node is? hir.MemberAssign {
        let target=hir.node_at(state.input.nodes node.target)
        if target isnt? hir.MemberAccess return reject(node 'a non-record member assignment' @state)
        let prefix:array<addr>=[]
        let pointer=snapshot(field_pointer(target @state writable=true) @prefix @state)
        let stored=stored_type(node.target state)
        # The RHS must be evaluated and retained before releasing the old
        # field. Distinct binding ids are not a disjointness proof: a place
        # parameter can alias a global, and index evaluation can read or
        # change the target. Literal construction has no old field to release;
        # assignment keeps this snapshot until a lifetime/alias proof applies.
        let source=snapshot(owned_value(node.value @state 'stored in a field') @prefix @state)
        if object_valued(stored state) {prefix.push(release_record(pointer stored node @state))}
        else if cell_members(stored @state) isnt? none {prefix.push(release_cell(pointer stored node @state))}
        else if releasable(stored @state) {prefix.push(release_value(field_read(pointer stored node @state) stored node @state))}
        prefix.push(field_write(pointer source stored node @state))
        # Inline record/cell writes copy into the field; the temporary wrapper
        # and its independent contents are no longer needed after that copy.
        if object_valued(stored state) or cell_members(stored @state) isnt? none {prefix.push(release_value(source stored node @state))}
        return sequence(prefix node @state)
    }
    if node is? hir.ArrayLiteral return array_literal(id node @state)
    if node is? hir.ArrayLength {
        let prefix:array<addr>=[]
        let receiver=read_operand(node.array @prefix @state)
        let value=read_word(receiver.value layouts.array_descriptor.length node @state)
        return finish_read(value receiver node @prefix @state)
    }
    if node is? hir.Index {
        let prefix:array<addr>=[]
        let receiver=read_operand(node.array @prefix @state)
        if id in? state.array_snapshots and receiver.owner_type is? none {
            # Saving the descriptor address alone does not keep its buffer
            # alive across index evaluation. Acquire a private descriptor;
            # shared data detaches if the index writes the original array.
            let type=hir.node_at(state.input.nodes node.array).value_type
            let kind=copy_kind(type @state)
            if kind isnt? none {note_copy(kind type 'snapshotted before indexing' 'the index expression may write the array being read' node @state)}
            receiver=ReadOperand[snapshot(copy_value(receiver.value type node @state) @prefix @state) type]
        }
        let descriptor=snapshot(receiver.value @prefix @state)
        let pointer=array_element_address(descriptor expression(node.index @state) node @state)
        let stored=stored_type(id state)
        let value=read_value(array_load(pointer stored node @state) stored node.value_type node @state)
        return finish_read(value receiver node @prefix @state)
    }
    if node is? hir.IndexAssign {
        let target=hir.node_at(state.input.nodes node.target)
        if target isnt? hir.Index return reject(node 'a non-array index assignment' @state)
        let prefix:array<addr>=[]
        let route=array_route(target.array @prefix @state)
        let index=snapshot(expression(target.index @state) @prefix @state)
        let stored=stored_type(node.target state)
        let descriptor=detach_array(route stored node @prefix @state)
        let pointer=snapshot(array_element_address(descriptor index target @state) @prefix @state)
        let replacement=snapshot(owned_value(node.value @state 'stored in an element') @prefix @state)
        # Raw exposure pins the entire container tree. An untracked pointer
        # can still name the previous record or cell after this replacement.
        let tracked=compare('__ne__' read_word(descriptor layouts.array_descriptor.owner node @state) word(-1 node @state) node @state)
        prefix.push(conditional(tracked release_value(array_load(pointer stored node @state) stored node @state) node @state))
        prefix.push(array_store(replacement pointer stored node @state))
        return put(hir.Block[node.loc type prefix false] @state)
    }
    if node is? hir.Void return put(hir.Void[node.loc type] @state)
    if node is? hir.Integer return put(hir.Integer[node.loc type node.prefix node.value] @state)
    if node is? hir.Bool return put(hir.Bool[node.loc type node.value] @state)
    if node is? hir.ExpressedIdentifier {
        let receiver_symbol=state.receiver_symbol
        let receiver_type=state.receiver_type
        let sibling:string?=if node.binding_id is? none none else state.receiver_fields.get(node.binding_id)
        if sibling isnt? none and receiver_symbol isnt? none and receiver_type isnt? none {
            # A sibling field read inside a receiver method: that field of the receiver.
            let handle=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) receiver_symbol] @state)
            let layout=object_layout(receiver_type node @state)
            let offset=layout.offsets.get(sibling)
            if offset is? none return reject(node 'a sibling field is absent from its record layout' @state)
            let stored=stored_type(id state)
            let pointer=address(handle offset node @state)
            return read_value(field_read(pointer stored node @state) stored node.value_type node @state)
        }
        let function=if node.binding_id is? none none else state.capture_plan.named.get(node.binding_id)
        if function isnt? none return function_value(function node @state)
        let stored=stored_type(id state)
        let raw=binding_storage(node stored @state)
        if node.binding_id isnt? none and node.binding_id in? state.boxed {raw=array_load(raw stored node @state)}
        return read_value(raw stored node.value_type node @state)
    }
    if node is? hir.Transmute {
        let source=hir.node_at(state.input.nodes node.expr)
        let value=if aggregate(source.value_type state) and not aggregate(node.value_type state) exposed_value(node.expr node @state) else expression(node.expr @state)
        return put(hir.Transmute[node.loc type value] @state)
    }
    if node is? hir.Return and state.cleanup_enabled return cleanup_return(node @state)
    if node is? hir.Return return put(hir.Return[node.loc type if node.item is? none none else owned_value(node.item @state 'returned')] @state)
    if node is? hir.Declare {
        if compile_time_binding(node state) return put(hir.Void[node.loc type] @state)
        if hir.node_at(state.input.nodes node.expr) is? hir.FunctionLiteral|hir.OverloadedFunction return put(hir.Void[node.loc type] @state)
        let projection=borrowed_getter_local(node @state)
        let borrowed=projection isnt? none
        let value:addr=0
        if projection isnt? none {
            let call=hir.node_at(state.input.nodes node.expr)
            $runtime_assert call is? hir.FunctionCall
            value=ordinary_call(node.expr call runtime_type(call.value_type call @state) @state projection=projection)
        } else if borrowed_route_local(node @state) {value=expression(node.expr @state) borrowed=true}
        else {
            if node.view return required_view_error(node @state)
            value=owned_value(node.expr @state "bound to `{node.name}`")
        }
        if node.binding_id isnt? none and (node.binding_id in? state.frame_record_bindings or node.expr in? state.frame_arrays) {borrowed=true}
        # An addressed optional local is written through its own cell, which
        # must therefore never be the shared static `none` cell.
        if state.none_cell isnt? none and node.binding_id isnt? none and node.binding_id in? state.addressed and node.binding_id not in? state.boxed and not borrowed {
            let stored=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
            if views.optional_payload(stored @state.type_nodes) isnt? none {value=cell_private(value stored node @state)}
        }
        # An addressed record local is written in place through its block, so
        # that block must not be shared with any other handle.
        if state.allocator isnt? none and node.binding_id isnt? none and node.binding_id in? state.addressed and node.binding_id not in? state.boxed and not borrowed {
            let stored=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
            if object_valued(stored state) {value=record_unique(value stored node @state)}
        }
        let annotation=runtime_type(if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation node @state)
        if node.binding_id isnt? none and node.binding_id in? state.boxed {
            value=box_value(value if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation node @state binding=node.binding_id)
            annotation=types.primitive('int64' @state.type_nodes)
        }
        if not borrowed and state.cleanup_enabled and node.binding_id isnt? none and node.binding_id not in? state.cleanup_excluded and state.cleanup_frames.length >? 0 {
            let stored=if node.annotation is? none hir.node_at(state.input.nodes node.expr).value_type else node.annotation
            if releasable(stored @state) {
                let read=put(hir.ExpressedIdentifier[node.loc annotation symbol(node.name node.binding_id @state) node.binding_id] @state)
                $runtime_assert state.cleanup_frames.length >? 0
                let frame=state.cleanup_frames.pop
                let box:addr?=none
                if node.binding_id in? state.boxed {box=read read=array_load(read stored node @state)}
                frame.push(OwnedLocal[read stored box])
                state.cleanup_owned.add(node.binding_id)
                state.cleanup_frames.push(frame)
            }
        }
        # A detached replacement is stored back into the declared local.
        let decltype=if node.binding_id isnt? none and (node.binding_id in? state.mutated_roots or node.binding_id in? state.moved_bindings) 'let' else node.decltype
        return put(hir.Declare[node.loc type decltype symbol(node.name node.binding_id @state) annotation value node.binding_id] @state)
    }
    if node is? hir.Assign {
        let original=hir.node_at(state.input.nodes node.target)
        if original isnt? hir.ExpressedIdentifier return reject(node 'a non-binding assignment target' @state)
        if original.binding_id isnt? none and state.receiver_symbol isnt? none and state.receiver_fields.get(original.binding_id) isnt? none return reject(node 'assigning a sibling field from a method' @state)
        let stored=stored_type(node.target state)
        let target=binding_storage(original stored @state)
        let boxed=original.binding_id isnt? none and original.binding_id in? state.boxed
        let value=owned_value(node.value @state "assigned to `{original.name}`")
        if node.op not=? '=' {
            if node.op.length <? 2 return reject(node 'invalid compound assignment spelling' @state)
            let operator=node.op[0..node.op.length-1)
            let name=builtins.binary_operators.get(operator)
            if name is? none return reject(node 'this compound assignment operator' @state)
            let operand_type=runtime_type(stored node @state)
            let signature=types.function_type([types.PosOrKwArg[none operand_type] types.PosOrKwArg[none operand_type]] [] none operand_type [] @state.type_nodes)
            let function=put(hir.ExpressedIdentifier[node.loc signature name] @state)
            value=put(hir.FunctionCall[node.loc operand_type function [if boxed array_load(target stored node @state) else target value] []] @state)
        }
        if state.cleanup_enabled and original.binding_id isnt? none and (original.binding_id in? state.cleanup_owned or original.binding_id in? state.place_parameters) {
            let prefix:array<addr>=[]
            let replacement=snapshot(value @prefix @state)
            if original.binding_id in? state.addressed and inline_place(stored @state) {
                if object_valued(stored state) {prefix.push(release_record(target stored node @state))}
                else {prefix.push(release_cell(target stored node @state))}
                prefix.push(field_write(target replacement stored node @state))
                prefix.push(release_value(replacement stored node @state))
            } else {
                prefix.push(release_value((if boxed array_load(target stored node @state) else target) stored node @state))
                prefix.push(if boxed array_store(replacement target stored node @state) else put(hir.Assign[node.loc type target '=' replacement] @state))
            }
            return sequence(prefix node @state)
        }
        if boxed return array_store(value target stored node @state)
        if original.binding_id isnt? none and original.binding_id in? state.addressed and inline_place(stored @state) return field_write(target value stored node @state)
        return put(hir.Assign[node.loc type target '=' value] @state)
    }
    if node is? hir.FunctionCall {
        if node.implicit_copy {
            let copied_shape=types.node_at(state.type_nodes views.structural_base(node.value_type state.type_nodes))
            let kind=if copied_shape is? types.TypeOr 'cell' else if copied_shape is? types.ArrayType 'array' else 'record'
            note_copy(kind node.value_type 'implicit resource copy' 'the source remains live and an independent owner is required' node @state)
        }
        let args:array<addr>=[]
        let callee=hir.node_at(state.input.nodes node.func)
        if callee is? hir.ArrayMethod return array_method_call(node callee @state)
        let function:addr=0
        if node.kw_args.length =? 0 and callee is? hir.ExpressedIdentifier and (callee.binding_id is? none or callee.binding_id not in? state.symbols) and (callee.name in? emit.binary or callee.name in? emit.prefix or callee.name in? emit.intrinsics) {
            if callee.name =? '__unreachable__' {
                # µDewy has no unreachable opcode. As in the hosted backend,
                # an empty infinite loop closes a path after an exit syscall.
                let empty=types.primitive('void' @state.type_nodes)
                let yes=put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) true] @state)
                let body=put(hir.Block[node.loc empty [] true] @state)
                let arm=put(hir.LoopArm[node.loc empty yes body] @state)
                return put(hir.Flow[node.loc types.primitive('never' @state.type_nodes) [arm] none] @state)
            }
            # Builtins and intrinsics have already converted their operands. Their
            # concrete runtime signature records the selected word width;
            # the original overload set has no runtime representation.
            let raw=callee.name.startswith('__load_') or callee.name.startswith('__store_') or callee.name.startswith('__syscall') or callee.name in? ['__load__' '__store__']
            loop argument in node.pos_args {
                let source=hir.node_at(state.input.nodes argument)
                let value=if raw and aggregate(source.value_type state) exposed_value(argument node @state) else expression(argument @state)
                args.push(value)
            }
            let parameters:array<types.PosOrKwArg>=[]
            loop argument in args {parameters.push(types.PosOrKwArg[none hir.node_at(state.nodes argument).value_type])}
            let signature=types.function_type(parameters [] none type [] @state.type_nodes)
            function=put(hir.ExpressedIdentifier[callee.loc signature callee.name callee.binding_id] @state)
        } else {return ordinary_call(id node type @state)}
        return put(hir.FunctionCall[node.loc type function args [] node.selected_method_index node.integer_operation] @state)
    }
    if node is? hir.FunctionLiteral return function_value(id node @state)
    if node is? hir.ShortCircuit return put(hir.ShortCircuit[node.loc type node.op expression(node.left @state) expression(node.right @state)] @state)
    if node is? hir.Block and (state.cleanup_enabled or not types.is_primitive(types.node_at(state.type_nodes node.value_type) 'void')) return cleanup_block(node @state)
    if node is? hir.Block return put(hir.Block[node.loc type items(node.items @state) node.scoped] @state)
    if node is? hir.IfArm return put(hir.IfArm[node.loc type expression(node.condition @state) expression(node.body @state)] @state)
    if node is? hir.LoopArm return put(hir.LoopArm[node.loc type expression(node.condition @state) expression(node.body @state)] @state)
    if node is? hir.Flow return lower_flow(node 0 @state)
    if node is? hir.ScopeMetatag return put(hir.Void[node.loc type] @state)
    if node is? hir.Break|hir.Continue return loop_exit(node @state)
    return reject(node "{node.typename} legalization" @state)
}
# Scalar arrays use the hosted six-word descriptors. Without a runtime
# allocator they stay within one function frame. The driver can supply the
# prelude allocator binding for independent values that cross frames or grow.
# Copies own their elements recursively. Growth returns the old owned byte
# buffer to the arena; element handles move into the replacement buffer.
# Releasing complete values at their last use remains a lifetime pass.
array_type = (id:addr state:State):>types.ArrayType? => {
    let type=types.node_at(state.type_nodes views.structural_base(id state.type_nodes))
    return if type is? types.ArrayType type else none
}
word = (value:bigint node:hir.AST @state:State):>addr => put(hir.Integer[node.loc types.primitive('int64' @state.type_nodes) '0d' value] @state)
intrinsic_call = (name:string arguments:array<addr> result:addr node:hir.AST @state:State):>addr => {
    let params:array<addr>=[]
    loop id in arguments {params.push(hir.node_at(state.nodes id).value_type)}
    let type=types.positional_function(params result @state.type_nodes)
    let function=put(hir.ExpressedIdentifier[node.loc type name] @state)
    return put(hir.FunctionCall[node.loc result function arguments []] @state)
}
word_op = (name:string left:addr right:addr node:hir.AST @state:State):>addr => intrinsic_call(name [left right] types.primitive('int64' @state.type_nodes) node @state)
address = (base:addr offset:addr node:hir.AST @state:State):>addr => if offset =? 0 base else word_op('__add__' base word(offset node @state) node @state)
# A provided allocator makes descriptors and element bytes survive the
# creating frame. The caller copies an ordinary array argument before any
# later argument is evaluated, so callee mutation cannot affect the caller.
# Frame storage remains available for small compiler-kernel tests without a
# prelude; values using it are forbidden from escaping that frame.
# Sizes up to 256 bytes cover cells, descriptors and records; the arena
# offers class-specialized entries for them (see `_arena_alloc_16`).
arena_class_helper = (size:addr prefix:string @state:State):>string? => {
    if state.allocator is? none return none
    let constant=hir.node_at(state.nodes size)
    if constant isnt? hir.Integer or constant.value <=? 0 or constant.value >? 264 return none
    # Power-of-two classes, plus one-word-larger classes for headed records.
    # Constant and computed sizes must never mix for one block (see the
    # arena in library/linux/system.dewy).
    let value=constant.value
    let width=if value <=? 8 8 else if value <=? 16 16 else if value <=? 24 24 else if value <=? 32 32 else if value <=? 40 40 else if value <=? 64 64 else if value <=? 72 72 else if value <=? 128 128 else if value <=? 136 136 else if value <=? 256 256 else 264
    let binding=state.runtime_helpers.get("{prefix}{width}")
    if binding is? none return none
    return state.symbols.get(binding)
}
allocation = (size:addr node:hir.AST @state:State):>addr => {
    let name:string='__alloca__'
    if state.allocator isnt? none {
        let selected=state.symbols.get(state.allocator)
        if selected is? none return reject(node 'the requested arena allocator has no declaration' @state)
        name=selected
        let specialized=arena_class_helper(size '_arena_alloc_' @state)
        if specialized isnt? none return intrinsic_call(specialized [] types.primitive('int64' @state.type_nodes) node @state)
    }
    return intrinsic_call(name [size] types.primitive('int64' @state.type_nodes) node @state)
}
# Records and tagged cells occupy inline storage in fields. Their existing
# storage is itself the place; scalar values and array handles need a slot.
inline_place = (type:addr @state:State):>bool => object_valued(type state) or cell_members(type @state) isnt? none
binding_storage = (node:hir.ExpressedIdentifier stored:addr @state:State):>addr => {
    let type=if node.binding_id isnt? none and node.binding_id in? state.boxed types.primitive('int64' @state.type_nodes) else runtime_type(stored node @state)
    return put(hir.ExpressedIdentifier[node.loc type symbol(node.name node.binding_id @state) node.binding_id] @state)
}
box_value = (value:addr stored:addr node:hir.AST @state:State binding:addr?=none):>addr => {
    let prefix:array<addr>=[]
    let initial=snapshot(value @prefix @state)
    let slot=if binding is? none none else state.frame_boxes.get(binding)
    let pointer=if slot isnt? none slot else snapshot(allocation(word(8 node @state) node @state) @prefix @state)
    prefix.push(array_store(initial pointer stored node @state))
    prefix.push(pointer)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
place_address = (id:addr @state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.DictLookup and node.proven {
        # Lifecycle helpers borrow a proven entry instead of duplicating it.
        # Array parameters address a handle slot; records/unions address the
        # payload itself, matching the ordinary indexed-place ABI.
        let prefix:array<addr>=[]
        let parts=dict_from_keys(node.keys @prefix @state mutate=true)
        $runtime_assert parts.value isnt? none
        let key=snapshot(owned_value(node.key @state) @prefix @state)
        prefix.push(dict_ensure(parts node @state))
        let probe=dict_probe(parts key node @prefix @state)
        let values=dict_array(parts 'values' parts.value node @prefix @state)
        let address=dict_element_pointer(values probe.position parts.value node @state)
        if inline_place(node.value_type @state) {address=read_value(array_load(address parts.value node @state) parts.value node.value_type node @state)}
        prefix.push(release_value(key parts.key node @state))
        prefix.push(address)
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    # A narrowed record occupies the payload, not the enclosing union cell.
    if object_valued(node.value_type state) and cell_members(stored_type(id state) @state) isnt? none return write_route(id @state)
    if node is? hir.ExpressedIdentifier return binding_storage(node stored_type(id state) @state)
    if node is? hir.MemberAccess return field_pointer(node @state writable=true)
    if node is? hir.Index {
        if state.allocator isnt? none and object_valued(node.value_type state) return write_route(id @state)
        let pointer=array_index(node @state writable=true)
        return if inline_place(stored_type(id state) @state) array_load(pointer stored_type(id state) node @state) else pointer
    }
    return reject(node 'an addressable place route' @state)
}
# This describes the storage produced by expression, not the source type's
# mutability. Keep adoption and temporary reclamation on the same rule: a
# borrowed binding/field cannot be released merely because it is aggregate.
# True when read_operand would lower this call through its getter borrow
# instead of the ordinary copying call.
borrowed_getter_receiver = (id:addr @state:State):>bool => {
    if not state.cleanup_enabled return false
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.RepresentationCast and binary_array_view(node state) return borrowed_getter_receiver(node.expr @state)
    if node isnt? hir.FunctionCall return false
    return getter_borrow_projection(id node @state) isnt? none
}
expression_owns = (id:addr @state:State):>bool => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.CopyValue return true
    if node is? hir.Suppress return expression_owns(node.item @state)
    # The single consuming read of a donated parameter adopts the value.
    if node is? hir.ExpressedIdentifier and id in? state.consumed_uses return true
    if node is? hir.RepresentationCast and array_valued(node.value_type state) {
        let source=hir.node_at(state.input.nodes node.expr)
        let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes))
        # These conversions construct an independent array. Value boundaries
        # adopt it; temporary reads/discarded conversions must reclaim it.
        if type is? types.BinaryLiteralType or string_type(source.value_type state) return true
    }
    if node is? hir.ValueCast|hir.RepresentationCast {
        let source=hir.node_at(state.input.nodes node.expr)
        if cell_members(source.value_type @state) isnt? none and temporary_owner(node.expr @state) return true
        if node is? hir.ValueCast {
            if object_valued(source.value_type state) and object_valued(node.value_type state) return expression_owns(node.expr @state)
            if array_valued(source.value_type state) and array_valued(node.value_type state) return expression_owns(node.expr @state)
        }
    }
    if node is? hir.StringConcat|hir.InterpolatedString|hir.StringIndex|hir.StringSlice return true
    if node is? hir.ValueCast|hir.RepresentationCast and owned_string(node.value_type state) {
        let source=hir.node_at(state.input.nodes node.expr)
        if owned_string(source.value_type state) return expression_owns(node.expr @state)
        if node is? hir.RepresentationCast and array_valued(source.value_type state) return true
    }
    if node is? hir.ObjectLiteral|hir.ArrayLiteral|hir.DictView|hir.SetAlgebra return true
    # Safe navigation constructs an independent result on every tag path.
    if node is? hir.ForwardingAccess return true
    # A receiver read through a getter borrow is a view of arena storage,
    # so a field or element taken from it is not a fresh temporary either.
    if node is? hir.DictEntries and temporary_owner(node.dictionary @state) and not borrowed_getter_receiver(node.dictionary @state) return true
    if node is? hir.MemberAccess and temporary_owner(node.value @state) and not borrowed_getter_receiver(node.value @state) return true
    if node is? hir.Index and (id in? state.array_snapshots or (temporary_owner(node.array @state) and not borrowed_getter_receiver(node.array @state))) return true
    if node is? hir.Block|hir.Flow and state.cleanup_enabled return true
    # Packing a non-cell value already creates an independent payload and
    # cell. Copying that result again abandons the first owned allocation.
    if node is? hir.ValueCast|hir.RepresentationCast and cell_members(node.value_type @state) isnt? none {
        let source=hir.node_at(state.input.nodes node.expr)
        if cell_members(source.value_type @state) is? none return true
    }
    if node is? hir.DictLookup {
        if not node.proven return true
        let keys=hir.node_at(state.input.nodes node.keys)
        if keys is? hir.MemberAccess and temporary_owner(keys.value @state) return true
    }
    if node is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index and cell_members(node.value_type @state) isnt? none {
        if cell_members(stored_type(id state) @state) is? none return true
    }
    if node is? hir.DictRemove return true
    # Ordinary Dewy calls already return independent aggregate storage: both
    # explicit returns and implicit function results pass through this value
    # boundary. Adopt that result instead of cloning it and abandoning its
    # original allocation. Intrinsics and array methods have separate ABIs.
    if node is? hir.FunctionCall {
        let callee=hir.node_at(state.input.nodes node.func)
        # Pop transfers the removed element; it no longer belongs to the
        # shortened array. This applies to discarded pops as well as locals.
        if callee is? hir.ArrayMethod and callee.name in? ['pop' 'join'] return true
        if callee is? hir.FunctionLiteral return true
        if callee is? hir.ExpressedIdentifier and callee.name not in? emit.intrinsics and callee.name not in? emit.binary and callee.name not in? emit.prefix return true
    }
    return false
}
binding_symbol = (id:addr name:string state:State):>string => if state.debug_names "_b{id}_{emit.name(name)}" else "_b{id}"
# A string literal, through the casts contextual typing wraps it in.
static_literal = (id:addr state:State):>bool => {
    let current=id
    loop true {
        let node=hir.node_at(state.input.nodes current)
        if node is? hir.String return true
        if node is? hir.ValueCast|hir.RepresentationCast {current=node.expr continue}
        if node is? hir.Suppress {current=node.item continue}
        return false
    }
}
temporary_owner = (id:addr @state:State):>bool => state.cleanup_enabled and releasable(hir.node_at(state.input.nodes id).value_type @state) and expression_owns(id @state)

# A read borrows its receiver until the result is evaluated. When that
# receiver was fresh, copy any aggregate result before releasing the owner.
# The returned expression contains its own setup/cleanup, so skipped flow
# arms and short-circuit operands never execute either half accidentally.
ReadOperand:type = [value:addr owner_type:addr?]
read_operand = (id:addr @prefix:array<addr> @state:State):>ReadOperand => {
    let original=hir.node_at(state.input.nodes id)
    if original is? hir.RepresentationCast and binary_array_view(original state) {
        # Binary literals already use the byte-array descriptor layout. A
        # read needs only that view, not a mutable copy of the entire table.
        # Actual value conversions still materialize independent storage.
        return read_operand(original.expr @prefix @state)
    }
    # A transient read of a getter's record (field, test, index) borrows the
    # arena element instead of copying it and releasing the copy afterwards.
    if original is? hir.FunctionCall and state.cleanup_enabled {
        let projection=getter_borrow_projection(id original @state)
        if projection isnt? none return ReadOperand[snapshot(ordinary_call(id original runtime_type(original.value_type original @state) @state projection=projection) @prefix @state) none]
    }
    let owner:addr?=if temporary_owner(id @state) hir.node_at(state.input.nodes id).value_type else none
    let value=expression(id @state)
    if owner isnt? none {value=snapshot(value @prefix @state)}
    return ReadOperand[value owner]
}
finish_read = (value:addr receiver:ReadOperand node:hir.AST @prefix:array<addr> @state:State):>addr => {
    if receiver.owner_type isnt? none {
        if releasable(node.value_type @state) {
            let kind=copy_kind(node.value_type @state)
            if kind isnt? none {note_copy(kind node.value_type 'read from a temporary' 'the temporary that holds it is released after the read' node @state)}
            value=copy_value(value node.value_type node @state)
        }
        value=snapshot(value @prefix @state)
        prefix.push(release_value(receiver.value receiver.owner_type node @state))
    }
    if prefix.length =? 0 return value
    prefix.push(value)
    return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
}
copy_value = (value:addr type:addr node:hir.AST @state:State shared:bool=false):>addr => {
    if owned_string(type state) return string_runtime('_native_string_copy' [value] node @state)
    if cell_members(type @state) isnt? none return cell_copy(value type node @state)
    let array=array_type(type state)
    if array isnt? none return array_copy(value array node @state)
    if object_valued(type state) return object_copy(value type node @state shared=shared)
    return value
}
# A fresh flow can carry a union of differently refined arrays even when
# the enclosing result is one ordinary array type. Extracting the payload
# must not abandon that cell. Retagging may itself create a new cell on only
# some paths; release that intermediate only when it differs from the source.
owned_cell_cast = (node:hir.ValueCast|hir.RepresentationCast actual:addr @state:State):>addr => {
    return convert_owned_cell(expression(node.expr @state) actual node.value_type node @state)
}
# A checked cast and an inferred flow join have the same ownership boundary.
# Consume the already evaluated cell, keeping the result in its destination
# layout before releasing the original payload and any temporary retagging.
convert_owned_cell = (value:addr actual:addr expected:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let converted=if enum_members(expected state) isnt? none enum_pack(source actual expected node @state) else read_value(source actual expected node @state)
    converted=snapshot(converted @prefix @state)
    if cell_members(expected @state) isnt? none {
        # read_value either retains this cell or constructs an independent
        # retagged cell. Transfer that result directly, releasing the original
        # only on paths that replaced it. No extra payload copy is necessary.
        prefix.push(conditional(compare('__ne__' converted source node @state) release_value(source actual node @state) node @state))
        prefix.push(converted)
        return put(hir.Block[node.loc runtime_type(expected node @state) prefix false] @state)
    }
    let result=snapshot(copy_value(converted expected node @state) @prefix @state)
    prefix.push(release_value(source actual node @state))
    prefix.push(result)
    return put(hir.Block[node.loc runtime_type(expected node @state) prefix false] @state)
}
note_parameter_copy = (argument:hir.Param|hir.BoundParam boxed:bool rebound:set<addr> mutated:set<addr> written:set<addr> node:hir.AST @state:State):>void => {
    let kind=copy_kind(argument.value_type @state)
    if kind is? none return
    let binding=argument.binding_id
    let reason="the body writes the elements of `{argument.name}`"
    if boxed {reason="the body needs a writable slot for `{argument.name}`"}
    else if binding isnt? none {
        if binding in? rebound {reason="the body rebinds `{argument.name}`"}
        else if binding in? written {reason="the body writes the fields of `{argument.name}`"}
    }
    note_copy(kind argument.value_type "copied on entry as `{argument.name}`" reason node @state)
}
owned_value = (id:addr @state:State site:string='kept'):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if state.result_projection isnt? none and state.result_projection.read =? id {
        let projection=state.result_projection
        # A proven scope borrow returns the route's existing storage. Its
        # source is an explicitly supplied, borrowed, unrebound parameter;
        # caller and callee proofs keep it alive beyond this return cleanup.
        if projection.borrowed {
            if node is? hir.FunctionCall {
                let inner=getter_borrow_projection(id node @state)
                if inner isnt? none return ordinary_call(id node runtime_type(node.value_type node @state) @state projection=inner)
            }
            return expression(id @state)
        }
        # Keep the selected field while the route and all enclosing locals
        # are alive. Scalars pass through; aggregate handles acquire their
        # own lifetime before ordinary return cleanup releases the source.
        let prefix:array<addr>=[]
        let receiver=read_operand(id @prefix @state)
        let value=receiver.value
        loop field in projection.fields {
            let layout=object_layout(field.owner node @state)
            let offset=layout.offsets.get(field.name)
            if offset is? none return reject(node 'a projected field is absent from its record layout' @state)
            value=field_read(address(value offset node @state) field.result node @state)
        }
        # Keep only the leaf, before finish_read releases the complete owner.
        # No intermediate record acquires an independent lifetime.
        let selected=hir.MemberAccess[node.loc projection.result id '']
        if receiver.owner_type is? none {value=copy_value(value projection.result selected @state)}
        return finish_read(value receiver selected @prefix @state)
    }
    if node is? hir.Suppress return owned_value(node.item @state site)
    # A statement block around a transferred local is transparent to
    # ownership. An unresolved proof obligation is not: it still has to reach
    # the legalization that rejects it.
    if node is? hir.Block and not node.scoped and node.items.length =? 1 and state.transferred_binding isnt? none return owned_value(node.items[0] @state site)
    if node is? hir.ValueCast {
        let source=hir.node_at(state.input.nodes node.expr)
        # A logical record upcast preserves the owned allocation, including
        # its dynamic child fields. Do not abandon a constructor/call result
        # merely because contextual typing inserted a transparent cast.
        if object_valued(source.value_type state) and object_valued(node.value_type state) return owned_record(owned_value(node.expr @state site) source.value_type node.value_type node @state)
        if cell_members(source.value_type @state) is? none and cell_members(node.value_type @state) isnt? none return cell_pack(owned_value(node.expr @state site) source.value_type node.value_type node @state owned=true)
    }
    # A record read out of a moved cell local moves the payload out: the
    # cell is emptied (tag none, never the shared static `none` cell) and
    # its block is freed at scope exit as usual. Only the local's own cell
    # can be emptied: a read that narrows the stored type first (a parent
    # record to a child union, a cell to a narrower cell) builds a temporary
    # cell around a copy, and that copy is still the ordinary owned value.
    if node is? hir.ValueCast|hir.RepresentationCast and object_valued(node.value_type state) {
        let inner=hir.node_at(state.input.nodes node.expr)
        if inner is? hir.ExpressedIdentifier and node.expr in? state.moved_uses and cell_members(inner.value_type @state) isnt? none and stored_type(node.expr state) =? inner.value_type and payload_movable(inner.value_type node.value_type node @state) {
            let binding=inner.binding_id
            if binding isnt? none and binding in? state.cleanup_owned and binding not in? state.boxed and binding not in? state.addressed {
                let prefix:array<addr>=[]
                let cell=snapshot(expression(node.expr @state) @prefix @state)
                let payload=snapshot(read_value(cell inner.value_type node.value_type node @state) @prefix @state)
                let word_type=types.primitive('int64' @state.type_nodes)
                let empty_cell=store_word(word(0 node @state) cell 0 node @state)
                let shared_none=state.none_cell
                if shared_none isnt? none {
                    let shared=put(hir.ExpressedIdentifier[node.loc word_type shared_none] @state)
                    empty_cell=conditional(intrinsic_call('__ne__' [cell shared] types.primitive('bool' @state.type_nodes) node @state) empty_cell node @state)
                }
                prefix.push(empty_cell)
                prefix.push(payload)
                return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
            }
        }
    }
    let value=expression(id @state)
    if node is? hir.Place or expression_owns(id @state) return value
    # A returned local's block is transferred to the caller, not copied.
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none and state.transferred_binding isnt? none and node.binding_id =? state.transferred_binding return value
    # A last use at a transfer site moves the local: take its handle and
    # empty it, so the scope-exit release finds nothing to release.
    if node is? hir.ExpressedIdentifier and id in? state.moved_uses {
        let binding=node.binding_id
        let stored=stored_type(id state)
        # A narrowed read of a cell local moves only when the read is the
        # cell's own payload with its packed layout (see `payload_movable`).
        let narrowed=cell_members(stored @state) isnt? none and cell_members(node.value_type @state) is? none
        # Otherwise the whole handle moves, so the read must hand back the
        # local's own block: a cell narrowed to a narrower cell may be a
        # temporary, and a record read as a differently sized relative
        # would be released with the wrong layout.
        let movable=if narrowed payload_movable(stored node.value_type node @state)
            else if cell_members(stored @state) isnt? none cell_read_keeps_handle(stored node.value_type @state)
            else if object_valued(stored state) and object_valued(node.value_type state) object_layout(stored node @state).size =? object_layout(node.value_type node @state).size
            else true
        if movable and binding isnt? none and binding in? state.cleanup_owned and binding not in? state.boxed and binding not in? state.addressed and releasable(node.value_type @state) {
            let prefix:array<addr>=[]
            let taken=snapshot(value @prefix @state)
            let word_type=types.primitive('int64' @state.type_nodes)
            if narrowed {
                # The read narrowed the local's cell to its payload: the
                # payload moves and the cell is emptied (never the shared
                # static `none` cell); the cell's block is freed as usual.
                let cell=snapshot(binding_storage(node stored @state) @prefix @state)
                let empty_cell=store_word(word(0 node @state) cell 0 node @state)
                let shared_none=state.none_cell
                if shared_none isnt? none {
                    let shared=put(hir.ExpressedIdentifier[node.loc word_type shared_none] @state)
                    empty_cell=conditional(intrinsic_call('__ne__' [cell shared] types.primitive('bool' @state.type_nodes) node @state) empty_cell node @state)
                }
                prefix.push(empty_cell)
            } else {
                prefix.push(assign_value(put(hir.ExpressedIdentifier[node.loc word_type symbol(node.name binding @state) binding] @state) word(0 node @state) node @state))
            }
            prefix.push(taken)
            return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
        }
    }
    # A string literal is static data with owner zero: retain returns it
    # and drop ignores it, so an owning slot may hold the descriptor itself.
    if static_literal(id state) return value
    if owned_string(node.value_type state) {
        note_copy('string' node.value_type site owned_reason(id @state) node @state)
        return string_runtime('_native_string_copy' [value] node @state)
    }
    if cell_members(node.value_type @state) isnt? none {
        note_copy('cell' node.value_type site owned_reason(id @state) node @state)
        return cell_copy(value node.value_type node @state)
    }
    let array=array_type(node.value_type state)
    if array isnt? none and node isnt? hir.ArrayLiteral {
        note_copy('array' node.value_type site owned_reason(id @state) node @state)
        return array_copy(value array node @state)
    }
    if object_valued(node.value_type state) and node isnt? hir.ObjectLiteral {
        note_copy('record' node.value_type site owned_reason(id @state) node @state)
        return object_copy(value node.value_type node @state shared=shareable_read(id @state))
    }
    return value
}
# An element slot or an owned, unaddressed local holds a handle to a whole
# block. A field of record type is inline storage, a parameter may have been
# passed such a field, and an addressed local must stay privately owned.
shareable_read = (id:addr @state:State):>bool => {
    if state.allocator is? none return false
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.Index return true
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
        return node.binding_id in? state.cleanup_owned and node.binding_id not in? state.addressed and node.binding_id not in? state.boxed
    }
    return false
}
# Parent storage reserves room for every possible descendant. An owned
# child's allocation may be smaller; cleanup needs the destination's size.
# Preserve equal layouts and resize differing ones without abandoning the
# independent source. This also applies when packing a record into a cell.
owned_record = (value:addr actual:addr expected:addr node:hir.AST @state:State):>addr => {
    if object_layout(actual node @state).size =? object_layout(expected node @state).size return value
    let prefix:array<addr>=[]
    let original=snapshot(value @prefix @state)
    let result=snapshot(object_copy(original expected node @state) @prefix @state)
    prefix.push(release_value(original actual node @state))
    prefix.push(result)
    return put(hir.Block[node.loc runtime_type(expected node @state) prefix false] @state)
}
ArrayMemory:type = [descriptor:addr data:addr prefix:array<addr>]
# Fresh descriptors and union cells are built by one generated helper per
# program (`_new_array`, `_new_cell`) rather than an allocate-and-store
# sequence at every construction site: the same work, a call's worth of
# text instead of seven lines. Programs without an arena keep the inline
# form, as the record helpers do.
construction_helper = (key:string arity:addr node:hir.AST @state:State):>string? => {
    if state.allocator is? none return none
    let existing=state.copy_helpers.get(key)
    if existing isnt? none return existing
    let generated=fresh(key @state)
    state.copy_helpers[key]=generated
    let word_type=types.primitive('int64' @state.type_nodes)
    let parameters:array<hir.Param>=[]
    let slots:array<types.PosOrKwArg>=[]
    let inputs:array<addr>=[]
    loop i in 0.. and i <? arity {
        let parameter=fresh('field' @state)
        parameters.push(hir.Param[parameter word_type])
        slots.push(types.PosOrKwArg[parameter word_type])
        inputs.push(put(hir.ExpressedIdentifier[node.loc word_type parameter] @state))
    }
    let prefix:array<addr>=[]
    let size=if key =? 'new_array' layouts.array_descriptor.size else 16
    let block=snapshot(allocation(word(size node @state) node @state) @prefix @state)
    let offset:addr=0
    loop input in inputs {prefix.push(store_word(input block offset node @state)) offset+=8}
    prefix.push(block)
    let body=put(hir.Block[node.loc word_type prefix false] @state)
    let signature=types.function_type(slots [] none word_type [] @state.type_nodes)
    let literal=put(hir.FunctionLiteral[node.loc signature parameters [] none word_type body source=state.source_index] @state)
    state.generated.push(program.Function[generated literal])
    return generated
}
array_memory = (length:addr stride:addr node:hir.AST @state:State):>ArrayMemory => {
    let prefix:array<addr>=[]
    let size=word_op('__mul__' length word(stride node @state) node @state)
    # An empty array owns no data block: growth allocates from a zero
    # capacity and release ignores a null pointer, so `[]` costs only its
    # descriptor instead of a second allocation for zero bytes.
    let count=hir.node_at(state.nodes length)
    let data=if count is? hir.Integer and count.value =? 0 snapshot(word(0 node @state) @prefix @state) else snapshot(allocation(size node @state) @prefix @state)
    let fields:array<addr>=[data length length word(stride node @state) word(layouts.array_flags.mutable + (if state.allocator is? none 0 else layouts.array_flags.arena_descriptor) node @state) word(if state.allocator is? none 0 else 1 node @state)]
    let helper=construction_helper('new_array' 6 node @state)
    if helper isnt? none {
        let descriptor=snapshot(intrinsic_call(helper fields types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
        return ArrayMemory[descriptor data prefix]
    }
    let descriptor=snapshot(allocation(word(layouts.array_descriptor.size node @state) node @state) @prefix @state)
    let offset:addr=0
    loop value in fields {
        prefix.push(intrinsic_call('__store_i64__' [value address(descriptor offset node @state)] types.primitive('void' @state.type_nodes) node @state))
        offset+=8
    }
    return ArrayMemory[descriptor data prefix]
}
array_store = (value:addr pointer:addr element:addr node:hir.AST @state:State):>addr => {
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(element state.type_nodes) state.type_nodes))
    if type is? types.ObjectType|types.ArrayType|types.MetaType or cell_members(element @state) isnt? none or enum_members(element state) isnt? none or string_type(element state) or unit_type(element state) return store_word(value pointer 0 node @state)
    if type is? types.FunctionType {
        let word=put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) value] @state)
        return store_word(word pointer 0 node @state)
    }
    if types.is_primitive(type 'bool') {
        let byte=put(hir.Transmute[node.loc types.primitive('uint8' @state.type_nodes) value] @state)
        return intrinsic_call('__store_u8__' [byte pointer] types.primitive('void' @state.type_nodes) node @state)
    }
    let layout=views.fixed_integer_layout(element state.type_nodes)
    if layout is? none return reject(node 'array element store representation' @state)
    return intrinsic_call("__store_{if layout.signed 'i' else 'u'}{layout.bits}__" [value pointer] types.primitive('void' @state.type_nodes) node @state)
}
array_load = (pointer:addr element:addr node:hir.AST @state:State):>addr => {
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(element state.type_nodes) state.type_nodes))
    if type is? types.ObjectType|types.ArrayType|types.MetaType or cell_members(element @state) isnt? none or enum_members(element state) isnt? none or string_type(element state) or unit_type(element state) return read_word(pointer 0 node @state)
    if type is? types.FunctionType return put(hir.Transmute[node.loc runtime_type(element node @state) read_word(pointer 0 node @state)] @state)
    if types.is_primitive(type 'bool') {
        let byte=intrinsic_call('__load_i8__' [pointer] types.primitive('int8' @state.type_nodes) node @state)
        return put(hir.Transmute[node.loc types.primitive('bool' @state.type_nodes) byte] @state)
    }
    let layout=views.fixed_integer_layout(element state.type_nodes)
    if layout is? none return reject(node 'array element load representation' @state)
    return intrinsic_call("__load_{if layout.signed 'i' else 'u'}{layout.bits}__" [pointer] runtime_type(element node @state) node @state)
}
array_literal = (id:addr node:hir.ArrayLiteral @state:State):>addr => {
    let type=array_type(node.value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let spread=false
    loop item in node.items { if hir.node_at(state.input.nodes item) is? hir.Spread { spread=true } }
    if spread return spread_array_literal(node type.element layout.size @state)
    let frame=state.frame_arrays.get(id)
    let memory=if frame is? none array_memory(word(node.items.length node @state) layout.size node @state) else frame
    if frame isnt? none {
        # owner=0 means the frame owns both blocks; mutable element writes
        # need no COW detachment and ordinary release cannot free the frame.
        let length=word(node.items.length node @state)
        let fields:array<addr>=[memory.data length length word(layout.size node @state) word(layouts.array_flags.mutable node @state) word(0 node @state)]
        let offset:addr=0
        loop value in fields {memory.prefix.push(store_word(value memory.descriptor offset node @state)) offset+=8}
    }
    let offset:addr=0
    loop item in node.items {
        memory.prefix.push(array_store(owned_value(item @state 'placed in an array literal') address(memory.data offset node @state) type.element node @state))
        offset+=layout.size
    }
    memory.prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) memory.prefix false] @state)
}
# `[xs... 0 ys...]`: sum the lengths, allocate once, then copy element by
# element behind a running cursor. Spread elements are copied as owned
# values; written elements are stored as in a plain literal.
spread_array_literal = (node:hir.ArrayLiteral element:addr stride:addr @state:State):>addr => {
    let prefix:array<addr>=[]
    let empty=types.primitive('void' @state.type_nodes)
    let bool_type=types.primitive('bool' @state.type_nodes)
    let sources:array<addr?>=[]
    let plain_count:addr=0
    loop item in node.items { if hir.node_at(state.input.nodes item) isnt? hir.Spread { plain_count+=1 } }
    let total=snapshot(word(plain_count node @state) @prefix @state)
    loop item in node.items {
        let current=hir.node_at(state.input.nodes item)
        if current isnt? hir.Spread { sources.push(none) continue }
        let source=snapshot(expression(current.value @state) @prefix @state)
        sources.push(source)
        prefix.push(put(hir.Assign[node.loc empty total '=' word_op('__add__' total read_word(source layouts.array_descriptor.length node @state) node @state)] @state))
    }
    let memory=array_memory(total stride node @state)
    loop statement in memory.prefix { prefix.push(statement) }
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let stride_word=word(stride node @state)
    loop i in 0.. and i <? node.items.length and i <? sources.length {
        let item=node.items[i]
        let source=sources[i]
        let destination=word_op('__add__' memory.data word_op('__mul__' cursor stride_word node @state) node @state)
        let advance=put(hir.Assign[node.loc empty cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
        if source is? none {
            prefix.push(array_store(owned_value(item @state 'placed in an array literal') destination element node @state))
            prefix.push(advance)
            continue
        }
        let index=snapshot(word(0 node @state) @prefix @state)
        let count=read_word(source layouts.array_descriptor.length node @state)
        let running=intrinsic_call('__lt__' [index count] bool_type node @state)
        let origin=word_op('__add__' read_word(source 0 node @state) word_op('__mul__' index stride_word node @state) node @state)
        let value=copy_value(array_load(origin element node @state) element node @state)
        let step=put(hir.Assign[node.loc empty index '=' word_op('__add__' index word(1 node @state) node @state)] @state)
        let body=sequence([array_store(value destination element node @state) step advance] node @state)
        prefix.push(put(hir.Flow[node.loc empty [put(hir.LoopArm[node.loc empty running body] @state)] none] @state))
    }
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
array_index = (node:hir.Index @state:State writable:bool=false):>addr => {
    let prefix:array<addr>=[]
    if writable {
        let route=array_route(node.array @prefix @state)
        let index=snapshot(expression(node.index @state) @prefix @state)
        let type=array_type(hir.node_at(state.input.nodes node.array).value_type state)
        $runtime_assert type isnt? none
        let descriptor=detach_array(route type.element node @prefix @state)
        prefix.push(array_element_address(descriptor index node @state))
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    let descriptor=snapshot(expression(node.array @state) @prefix @state)
    let index=snapshot(expression(node.index @state) @prefix @state)
    prefix.push(array_element_address(descriptor index node @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
array_element_address = (descriptor:addr index:addr node:hir.Index @state:State):>addr => {
    let type=array_type(hir.node_at(state.input.nodes node.array).value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let data=read_word(descriptor 0 node @state)
    let offset=word_op('__mul__' index word(layout.size node @state) node @state)
    return word_op('__add__' data offset node @state)
}
# Copy helpers are monomorphic in storage type and shared by every use.
# Reserve the symbol before generating its body: a recursive record through
# array handles calls the reserved helper rather than recursively expanding
# the compiler's own lowering stack. These helpers require arena storage;
# a stack allocation inside a returning helper would immediately dangle.
finish_copy = (name:string parameter:string body:addr node:hir.AST @state:State):>void => {
    let word_type=types.primitive('int64' @state.type_nodes)
    # Helpers end in a descriptor/handle value. Statement sequences default
    # to void, so restore that fallthrough type before scalar normalization.
    let block=hir.node_at(state.nodes body)
    if block is? hir.Block {body=put(hir.Block[block.loc word_type block.items block.scoped] @state)}
    let type=types.function_type([types.PosOrKwArg[parameter word_type]] [] none word_type [] @state.type_nodes)
    let literal=put(hir.FunctionLiteral[node.loc type [hir.Param[parameter word_type]] [] none word_type body source=state.source_index] @state)
    state.generated.push(program.Function[name literal])
}
array_copy = (value:addr type:types.ArrayType node:hir.AST @state:State):>addr => {
    if state.allocator is? none return array_copy_body(value type node @state)
    let key="array:{layout_key(type.element node @state)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated_name=fresh('copy_array' @state)
        name=generated_name
        state.copy_helpers[key]=generated_name
        let parameter=fresh('copy_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=array_copy_body(source type node @state)
        finish_copy(generated_name parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
# A top-level record block carries one header word before its fields: the
# count of handles sharing it in the low 32 bits and its allocated size in
# the high 32 bits. Copying a whole block from a handle that is known to
# address a block (not an inline field record) bumps the count when the
# block's size is the copy's own layout size, so every owned handle frees
# with its static size class; a mutation through a shared handle detaches a
# private block first and stores it back through the mutating route. Inline
# field records, addressed locals and place parameters are never shared.
record_header = (pointer:addr node:hir.AST @state:State):>addr => word_op('__sub__' pointer word(8 node @state) node @state)
record_count = (header_word:addr node:hir.AST @state:State):>addr => word_op('__and__' header_word word(4294967295 node @state) node @state)
record_size = (header_word:addr node:hir.AST @state:State):>addr => word_op('__rshift__' header_word word(32 node @state) node @state)
record_allocation = (layout:layouts.Record node:hir.AST @state:State):>addr => {
    if state.allocator is? none return allocation(word(layout.size node @state) node @state)
    # One generated helper per record size writes the header word and
    # returns the field block, instead of two lines at every allocation.
    let key="headed:{layout.size}"
    let existing=state.copy_helpers.get(key)
    if existing isnt? none return intrinsic_call(existing [] types.primitive('int64' @state.type_nodes) node @state)
    let generated=fresh('alloc' @state)
    state.copy_helpers[key]=generated
    let word_type=types.primitive('int64' @state.type_nodes)
    let prefix:array<addr>=[]
    let header=snapshot(allocation(word(layout.size+8 node @state) node @state) @prefix @state)
    prefix.push(store_word(word(1+layout.size*4294967296 node @state) header 0 node @state))
    prefix.push(address(header 8 node @state))
    let body=put(hir.Block[node.loc word_type prefix false] @state)
    let signature=types.function_type([] [] none word_type [] @state.type_nodes)
    state.generated.push(program.Function[generated put(hir.FunctionLiteral[node.loc signature [] [] none word_type body source=state.source_index] @state)])
    return intrinsic_call(generated [] word_type node @state)
}
record_share_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let word_type=types.primitive('int64' @state.type_nodes)
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let header=snapshot(record_header(source node @state) @prefix @state)
    let current=snapshot(read_word(header 0 node @state) @prefix @state)
    let shared:array<addr>=[store_word(word_op('__add__' current word(1 node @state) node @state) header 0 node @state) source]
    let counted=compare('__ge__' record_count(current node @state) word(1 node @state) node @state)
    let sized=compare('__eq__' record_size(current node @state) word(layout.size node @state) node @state)
    let condition=intrinsic_call('__and__' [counted sized] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.IfArm[node.loc word_type condition sequence(shared node @state)] @state)
    prefix.push(put(hir.Flow[node.loc word_type [arm] object_copy(source type node @state)] @state))
    return put(hir.Block[node.loc word_type prefix false] @state)
}
# A mutation may reach a block through a narrowed handle whose layout is
# smaller than the block's. The private replacement keeps the block's own
# recorded size, so the slot that holds it still frees with its static class.
record_unique_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let word_type=types.primitive('int64' @state.type_nodes)
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let header=snapshot(record_header(source node @state) @prefix @state)
    let current=snapshot(read_word(header 0 node @state) @prefix @state)
    let detached:array<addr>=[store_word(word_op('__sub__' current word(1 node @state) node @state) header 0 node @state)]
    let size=snapshot(record_size(current node @state) @detached @state)
    let fresh_header=snapshot(allocation(word_op('__add__' size word(8 node @state) node @state) node @state) @detached @state)
    detached.push(store_word(word_op('__add__' word_op('__lshift__' size word(32 node @state) node @state) word(1 node @state) node @state) fresh_header 0 node @state))
    let destination=snapshot(address(fresh_header 8 node @state) @detached @state)
    detached.push(object_write(destination source type node @state))
    detached.push(destination)
    let arm=put(hir.IfArm[node.loc word_type compare('__gt__' record_count(current node @state) word(1 node @state) node @state) sequence(detached node @state)] @state)
    prefix.push(put(hir.Flow[node.loc word_type [arm] source] @state))
    return put(hir.Block[node.loc word_type prefix false] @state)
}
# The layout a generated helper's body depends on: offsets and field kinds
# (a word of some width, a string, an array of a layout, a record layout, a
# cell of tagged layouts), not field names. Two types with one layout share
# one helper. A minted record stays its own: releasing it dispatches over
# its brand family.
layout_key = (type:addr node:hir.AST @state:State):>string => layout_key_inner(type node set[] @state)
layout_key_inner = (type:addr node:hir.AST visiting:set<addr> @state:State):>string => {
    let plain=types.unfold(types.strip_refinement(type state.type_nodes) state.type_nodes)
    if plain in? visiting return "@{plain}"
    if owned_string(plain state) return 's'
    let array=array_type(plain state)
    if array isnt? none {visiting.add(plain) return "a<{layout_key_inner(array.element node visiting @state)}>"}
    let members=cell_members(plain @state)
    if members isnt? none {
        visiting.add(plain)
        let parts:array<string>=[]
        loop member in members {parts.push("{member_tag(member @state)}:{layout_key_inner(member node visiting @state)}")}
        return "c<{parts.join(' ')}>"
    }
    if object_valued(plain state) {
        let record=object_type(plain state)
        $runtime_assert record isnt? none
        if record.minted and record.brand isnt? none return "o#{record.brand}"
        visiting.add(plain)
        let layout=object_layout(plain node @state)
        let parts:array<string>=[]
        loop field in record.fields {
            let offset=layout.offsets.get(field.name)
            $runtime_assert offset isnt? none
            parts.push("{offset}:{layout_key_inner(field.value_type node visiting @state)}")
        }
        return "o{layout.size}[{parts.join(' ')}]"
    }
    return "w{types.shape_of(runtime_type(plain node @state) state.type_nodes)}"
}
record_helper = (kind:string value:addr type:addr node:hir.AST @state:State):>addr => {
    let key="{kind}:{layout_key(type node @state)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated=fresh(kind @state)
        state.copy_helpers[key]=generated name=generated
        let parameter=fresh("{kind}_source" @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=if kind =? 'share_object' record_share_body(source type node @state) else record_unique_body(source type node @state)
        finish_copy(generated parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
record_unique = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return value
    return record_helper('unique_object' value type node @state)
}
object_copy = (value:addr type:addr node:hir.AST @state:State shared:bool=false):>addr => {
    if state.allocator is? none return object_copy_body(value type node @state)
    if shared return record_helper('share_object' value type node @state)
    let key="object:{layout_key(type node @state)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated_name=fresh('copy_object' @state)
        name=generated_name
        state.copy_helpers[key]=generated_name
        let parameter=fresh('copy_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=object_copy_body(source type node @state)
        finish_copy(generated_name parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
owned_copy = (value:addr type:addr node:hir.AST @state:State shared:bool=false):>addr => {
    if owned_string(type state) return string_runtime('_native_string_copy' [value] node @state)
    if cell_members(type @state) isnt? none return cell_copy(value type node @state)
    let array=array_type(type state)
    if array isnt? none return array_copy(value array node @state)
    if object_valued(type state) return object_copy(value type node @state shared=shared)
    return value
}

# Copy-on-write is a provisional storage strategy, not a source-level alias.
# One arena descriptor is shared by reference count: owner 0 is a borrowed
# or static view, owner >= 1 counts the handles sharing the descriptor and
# its data, and -1 is raw-exposed pinned storage. Copying bumps the count;
# a mutation detaches a shared descriptor into a fresh private one and the
# mutating route stores that replacement back into its place.
array_copy_body = (value:addr type:types.ArrayType node:hir.AST @state:State):>addr => {
    if state.allocator is? none return array_copy_storage(value type node @state)
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let owner=snapshot(read_word(source layouts.array_descriptor.owner node @state) @prefix @state)
    let shared:array<addr>=[store_word(word_op('__add__' owner word(1 node @state) node @state) source layouts.array_descriptor.owner node @state) source]
    let arm=put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) compare('__ge__' owner word(1 node @state) node @state) sequence(shared node @state)] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [arm] array_copy_storage(source type node @state)] @state))
    return sequence(prefix node @state)
}
array_unique = (descriptor:addr element:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return descriptor
    let key="unique:{layout_key(element node @state)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated=fresh('unique_array' @state)
        state.copy_helpers[key]=generated name=generated
        let parameter=fresh('unique_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=array_unique_body(source element node @state)
        finish_copy(generated parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [descriptor] types.primitive('int64' @state.type_nodes) node @state)
}
# The private descriptor to mutate: the source itself unless it is shared,
# in which case one reference moves to an independent copy of the storage.
array_unique_body = (source:addr element:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let owner=snapshot(read_word(source layouts.array_descriptor.owner node @state) @prefix @state)
    let storage_type=array_type(types.array_type(element none @state.type_nodes) state)
    $runtime_assert storage_type isnt? none
    let detached:array<addr>=[store_word(word_op('__sub__' owner word(1 node @state) node @state) source layouts.array_descriptor.owner node @state)]
    detached.push(array_copy_storage(source storage_type node @state))
    let arm=put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) compare('__gt__' owner word(1 node @state) node @state) sequence(detached node @state)] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [arm] source] @state))
    return sequence(prefix node @state)
}
# A mutable array route names where its descriptor handle lives: a local
# (possibly boxed) binding, or a field/element slot address. Detaching a
# shared descriptor stores the replacement through that same route.
ArrayRoute:type = [place:addr? target:addr? fallback:addr?]
array_route = (id:addr @prefix:array<addr> @state:State):>ArrayRoute => {
    let node=hir.node_at(state.input.nodes id)
    if array_valued(stored_type(id state) state) {
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            let target=binding_storage(node stored_type(id state) @state)
            if node.binding_id in? state.boxed return ArrayRoute[snapshot(target @prefix @state) none none]
            return ArrayRoute[none target none]
        }
        if node is? hir.MemberAccess return ArrayRoute[snapshot(field_pointer(node @state writable=true) @prefix @state) none none]
        if node is? hir.Index return ArrayRoute[snapshot(array_index(node @state writable=true) @prefix @state) none none]
    }
    # An array narrowed out of an optional/union cell lives in the cell's
    # payload word; the cell itself is the stable place.
    let stored=stored_type(id state)
    if cell_members(stored @state) isnt? none and array_valued(node.value_type state) {
        let cell:addr?=none
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            let raw=binding_storage(node stored @state)
            cell=if node.binding_id in? state.boxed array_load(raw stored node @state) else raw
        } else if node is? hir.MemberAccess {cell=field_pointer(node @state writable=true)}
        else if node is? hir.Index {cell=array_load(array_index(node @state writable=true) stored node @state)}
        if cell isnt? none return ArrayRoute[snapshot(address(cell 8 node @state) @prefix @state) none none]
    }
    return ArrayRoute[none none snapshot(write_route(id @state) @prefix @state)]
}
route_descriptor = (route:ArrayRoute node:hir.AST @prefix:array<addr> @state:State):>addr => {
    if route.place isnt? none return snapshot(read_word(route.place 0 node @state) @prefix @state)
    if route.target isnt? none return route.target
    $runtime_assert route.fallback isnt? none
    return route.fallback
}
route_store = (route:ArrayRoute descriptor:addr node:hir.AST @prefix:array<addr> @state:State):>void => {
    if route.place isnt? none {prefix.push(store_word(descriptor route.place 0 node @state))}
}
detach_array = (route:ArrayRoute element:addr node:hir.AST @prefix:array<addr> @state:State):>addr => {
    let descriptor=route_descriptor(route node @prefix @state)
    if state.allocator is? none return descriptor
    prefix.push(assign_value(descriptor array_unique(descriptor element node @state) node @state))
    route_store(route descriptor node @prefix @state)
    return descriptor
}
# Raw pointers have no tracked lifetime. Detach existing snapshots and pin
# the exposed tree: later ordinary copies must use the recursive fallback.
pin_value = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none or not aggregate(type state) return value
    if owned_string(type state) return string_runtime('_native_string_pin' [value] node @state)
    let key="pin:{type}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated=fresh('pin_value' @state)
        state.copy_helpers[key]=generated name=generated
        let parameter=fresh('pin_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=pin_body(source type node @state)
        finish_copy(generated parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
# Exposing an array through a stable route may replace its descriptor with
# a private pinned one, so the route's place must receive that replacement.
exposed_value = (id:addr node:hir.AST @state:State):>addr => {
    let source=hir.node_at(state.input.nodes id)
    if state.allocator isnt? none and array_valued(source.value_type state) and source is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index and array_valued(stored_type(id state) state) and not temporary_owner(id @state) {
        let prefix:array<addr>=[]
        let route=array_route(id @prefix @state)
        let descriptor=route_descriptor(route node @prefix @state)
        prefix.push(assign_value(descriptor pin_value(descriptor source.value_type node @state) node @state))
        route_store(route descriptor node @prefix @state)
        prefix.push(descriptor)
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    return pin_value(expression(id @state) source.value_type node @state)
}
pin_record = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let record=object_type(type state)
    $runtime_assert record isnt? none
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    loop field in record.fields {
        if not aggregate(field.value_type state) continue
        let offset=layout.offsets.get(field.name)
        $runtime_assert offset isnt? none
        let member=field_read(address(value offset node @state) field.value_type node @state)
        let pinned=pin_value(member field.value_type node @state)
        prefix.push(if array_valued(field.value_type state) store_word(pinned address(value offset node @state) 0 node @state) else pinned)
    }
    return sequence(prefix node @state)
}
pin_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let array=array_type(type state)
    if array isnt? none {
        # A shared or borrowed descriptor is replaced by a private copy of
        # its storage; the pinned descriptor is then never released.
        let body:array<addr>=[]
        let owner=snapshot(read_word(value layouts.array_descriptor.owner node @state) @body @state)
        let copied:array<addr>=[conditional(compare('__gt__' owner word(1 node @state) node @state) store_word(word_op('__sub__' owner word(1 node @state) node @state) value layouts.array_descriptor.owner node @state) node @state)]
        copied.push(assign_value(value array_copy_storage(value array node @state) node @state))
        body.push(conditional(compare('__ne__' owner word(1 node @state) node @state) sequence(copied node @state) node @state))
        body.push(store_word(word(-1 node @state) value layouts.array_descriptor.owner node @state))
        if aggregate(array.element state) {
            let index=snapshot(word(0 node @state) @body @state)
            let child=array_load(dict_element_pointer(value index array.element node @state) array.element node @state)
            let pinned=pin_value(child array.element node @state)
            let step=if array_valued(array.element state) store_word(pinned dict_element_pointer(value index array.element node @state) 0 node @state) else pinned
            body.push(loop_while(compare('__lt__' index read_word(value layouts.array_descriptor.length node @state) node @state) [step assign_value(index word_op('__add__' index word(1 node @state) node @state) node @state)] node @state))
        }
        prefix.push(conditional(compare('__ne__' read_word(value layouts.array_descriptor.owner node @state) word(-1 node @state) node @state) sequence(body node @state) node @state))
    } else if object_valued(type state) {
        let storage=views.structural_base(type state.type_nodes)
        let layout=object_layout(type node @state)
        let brand=layout.offsets.get(layouts.brand_field)
        let arms:array<addr>=[]
        if brand isnt? none {
            let tag=snapshot(read_word(value brand node @state) @prefix @state)
            loop entry in state.layout_context.brands.entries {
                if not subtyping.is_subtype(entry.value_type storage state.links @state.type_nodes) continue
                let numbered=brand_number(entry.name state)
                $runtime_assert numbered isnt? none
                arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) compare('__eq__' tag word(numbered.first node @state) node @state) pin_record(value entry.value_type node @state)] @state))
            }
        }
        prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms pin_record(value type node @state)] @state))
    } else {
        let members=cell_members(type @state)
        $runtime_assert members isnt? none
        let tag=snapshot(read_word(value 0 node @state) @prefix @state)
        let payload=snapshot(read_word(value 8 node @state) @prefix @state)
        let optional=views.optional_payload(type @state.type_nodes)
        let arms:array<addr>=[]
        loop member in members {
            if not aggregate(member state) continue
            let condition=compare((if optional isnt? none '__ne__' else '__eq__') tag word(if optional isnt? none 0 else member_tag(member @state) node @state) node @state)
            let pinned=pin_value(payload member node @state)
            let step=if array_valued(member state) store_word(pinned value 8 node @state) else pinned
            arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition step] @state))
        }
        prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms none] @state))
    }
    prefix.push(value)
    return sequence(prefix node @state)
}

# Follow a mutable route through arrays before exposing the nested value.
# Plain reads keep sharing; taking a place makes each enclosing buffer unique.
# Where a record handle lives for a mutation: a local (boxed or direct), an
# element slot, or a cell payload. A field of record type is inline in its
# parent, so the parent's route detaches; a temporary has no place at all.
record_route = (id:addr @prefix:array<addr> @state:State):>ArrayRoute => {
    let node=hir.node_at(state.input.nodes id)
    let stored=stored_type(id state)
    if object_valued(stored state) {
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            let target=binding_storage(node stored @state)
            # Only a binding that owns its block may detach it. A borrowed
            # parameter or view can address an inline field of another
            # record, which has no header to inspect; such bindings are
            # never shared, so writes through them need no detach.
            let owner=node.binding_id in? state.cleanup_owned or node.binding_id in? state.capture_plan.globals
            if node.binding_id in? state.addressed or not owner {
                let kept=snapshot(target @prefix @state)
                return ArrayRoute[none none kept]
            }
            if node.binding_id in? state.boxed return ArrayRoute[snapshot(target @prefix @state) none none]
            return ArrayRoute[none target none]
        }
        if node is? hir.Index return ArrayRoute[snapshot(array_index(node @state writable=true) @prefix @state) none none]
        if node is? hir.MemberAccess {
            let inline=snapshot(field_pointer(node @state writable=true) @prefix @state)
            return ArrayRoute[none none inline]
        }
    }
    if cell_members(stored @state) isnt? none and object_valued(node.value_type state) {
        let cell:addr?=none
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
            let raw=binding_storage(node stored @state)
            cell=if node.binding_id in? state.boxed array_load(raw stored node @state) else raw
        } else if node is? hir.MemberAccess {cell=field_pointer(node @state writable=true)}
        else if node is? hir.Index {cell=array_load(array_index(node @state writable=true) stored node @state)}
        if cell isnt? none return ArrayRoute[snapshot(address(cell 8 node @state) @prefix @state) none none]
    }
    let temporary=snapshot(expression(id @state) @prefix @state)
    return ArrayRoute[none none temporary]
}
detach_record = (route:ArrayRoute type:addr node:hir.AST @prefix:array<addr> @state:State):>addr => {
    if route.place isnt? none {
        let handle=snapshot(read_word(route.place 0 node @state) @prefix @state)
        prefix.push(assign_value(handle record_unique(handle type node @state) node @state))
        prefix.push(store_word(handle route.place 0 node @state))
        return handle
    }
    if route.target isnt? none {
        prefix.push(assign_value(route.target record_unique(route.target type node @state) node @state))
        return route.target
    }
    $runtime_assert route.fallback isnt? none
    return route.fallback
}
write_route = (id:addr @state:State detach:bool=true):>addr => {
    let node=hir.node_at(state.input.nodes id)
    let stored=stored_type(id state)
    if detach and state.allocator isnt? none and object_valued(node.value_type state) {
        let prefix:array<addr>=[]
        let route=record_route(id @prefix @state)
        prefix.push(detach_record(route node.value_type node @prefix @state))
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    if node is? hir.Index return read_value(array_load(array_index(node @state writable=true) stored node @state) stored node.value_type node @state)
    if node is? hir.MemberAccess return read_value(field_read(field_pointer(node @state writable=true detach=detach) stored node @state) stored node.value_type node @state)
    return expression(id @state)
}

array_copy_storage = (value:addr type:types.ArrayType node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let descriptor=snapshot(value @prefix @state)
    let source=snapshot(intrinsic_call('__load_i64__' [descriptor] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let length=snapshot(intrinsic_call('__load_i64__' [address(descriptor layouts.array_descriptor.length node @state)] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(node layout.detail @state)
    let memory=array_memory(length layout.size node @state)
    loop item in memory.prefix {prefix.push(item)}
    let counter=state.runtime_helpers.get('_arena_note_copy')
    if counter isnt? none {
        let symbol=state.symbols.get(counter)
        if symbol isnt? none {prefix.push(intrinsic_call(symbol [word_op('__mul__' length word(layout.size node @state) node @state)] types.primitive('void' @state.type_nodes) node @state))}
    }
    if aggregate(type.element state) {
        if state.allocator is? none return reject(node 'owned aggregate array elements need the prelude arena allocator' @state)
        let cursor=snapshot(word(0 node @state) @prefix @state)
        let offset=word_op('__mul__' cursor word(layout.size node @state) node @state)
        let item=array_load(word_op('__add__' source offset node @state) type.element node @state)
        let copied=owned_copy(item type.element node @state shared=true)
        let store=array_store(copied word_op('__add__' memory.data offset node @state) type.element node @state)
        let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
        let body=sequence([store increment] node @state)
        let condition=intrinsic_call('__lt__' [cursor length] types.primitive('bool' @state.type_nodes) node @state)
        let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
        prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
        prefix.push(memory.descriptor)
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    let count=snapshot(word_op('__mul__' length word(layout.size node @state) node @state) @prefix @state)
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let source_pointer=word_op('__add__' source cursor node @state)
    let into=word_op('__add__' memory.data cursor node @state)
    # Copy whole words when the element width allows it: the C compiler does
    # not vectorize the byte loop, and detaching a shared word array is hot.
    let width=if layout.size % 8 =? 0 8 else 1
    let unit=intrinsic_call("__load_u{width*8}__" [source_pointer] types.primitive("uint{width*8}" @state.type_nodes) node @state)
    let store=intrinsic_call("__store_u{width*8}__" [unit into] types.primitive('void' @state.type_nodes) node @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(width node @state) node @state)] @state)
    let body=put(hir.Block[node.loc types.primitive('void' @state.type_nodes) [store increment] true] @state)
    let condition=intrinsic_call('__lt__' [cursor count] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Optional and general union cells share two words: a program-wide member
# tag, then a scalar payload or an owned aggregate handle. None is tag zero.
# Views retain tags when their alternatives remain the same. Splitting or
# combining record families converts the tags at the read/cast boundary.
cell_members = (id:addr @state:State):>array<addr>|none => {
    # Most calls ask about a non-cell type. Cache negative answers too, while
    # distinguishing them from a type that has not been queried yet.
    let cached=state.cell_types.get(id)
    if cached isnt? none return if cached.length =? 0 none else cached
    let plain=types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes)
    let payload=views.optional_payload(plain @state.type_nodes)
    let result:array<addr>|none=if payload isnt? none [types.primitive('none' @state.type_nodes) payload] else views.runtime_union_members(plain @state.type_nodes)
    state.cell_types[id]=if result is? none [] else result
    return result
}
member_tag = (type:addr @state:State):>addr => {
    let plain=types.unfold(types.strip_refinement(type state.type_nodes) state.type_nodes)
    if types.is_primitive(types.node_at(state.type_nodes plain) 'none') return 0
    let key=if string_type(plain state) 'string' else types.shape_of(plain state.type_nodes)
    let tag=state.union_tags.get(key)
    if tag isnt? none return tag
    let fresh:addr=state.next_tag
    state.next_tag+=1
    state.union_tags[key]=fresh
    return fresh
}
# The read type may be narrower than a binding or field's physical slot.
# Preserve the declared type separately; only a single-member read loads
# the payload. A read that still has several alternatives remains a cell.
stored_type = (id:addr state:State):>addr => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {
        let type=state.storage_types.get(node.binding_id)
        if type isnt? none return type
    }
    if node is? hir.MemberAccess {
        let record=object_type(hir.node_at(state.input.nodes node.value).value_type state)
        if record isnt? none {
            let field=types.object_field(record node.name)
            if field isnt? none return field.value_type
        }
    }
    if node is? hir.Index {
        let array=array_type(hir.node_at(state.input.nodes node.array).value_type state)
        if array isnt? none return array.element
    }
    return node.value_type
}
cell_payload = (cell:addr type:addr node:hir.AST @state:State):>addr => {
    let value=read_word(cell 8 node @state)
    let runtime=runtime_type(type node @state)
    if types.is_primitive(types.node_at(state.type_nodes runtime) 'int64') return value
    return put(hir.Transmute[node.loc runtime value] @state)
}
read_value = (value:addr stored:addr read:addr node:hir.AST @state:State):>addr => {
    # Most reads keep their declared type. In particular, do not compare all
    # pairs of alternatives in a large AST union when no narrowing occurred.
    if stored =? read return value
    if enum_members(stored state) isnt? none return enum_read(value stored read node @state)
    if enum_members(read state) isnt? none and views.fixed_integer_layout(views.structural_base(stored state.type_nodes) state.type_nodes) isnt? none return enum_pack(value stored read node @state)
    # Narrowing a branded parent to several children changes the read's
    # representation: the parent is one record handle, the child union is a
    # tagged cell. Its first record field must never be mistaken for a tag.
    if object_valued(stored state) and cell_members(read @state) isnt? none return cell_pack(value stored read node @state)
    let original=cell_members(stored @state)
    let narrowed=cell_members(read @state)
    let selected_enum=enum_members(read state)
    if original isnt? none and selected_enum isnt? none {
        # A cell's tag and an enum's tag use different vocabularies. A
        # narrowed read must select the enum tag, not return the cell address
        # or mistake the mathematical payload for that tag.
        let prefix:array<addr>=[]
        let source=snapshot(value @prefix @state)
        let tag=snapshot(read_word(source 0 node @state) @prefix @state)
        let boolean=types.primitive('bool' @state.type_nodes)
        let output=types.primitive('int64' @state.type_nodes)
        let arms:array<addr>=[]
        loop target in selected_enum {
            let matches=put(hir.Bool[node.loc boolean false] @state)
            loop member in original {
                if type_tests.disjoint(member target state.links @state.type_nodes) continue
                let active=compare('__eq__' tag word(member_tag(member @state) node @state) node @state)
                let test:addr?=none
                if subtyping.is_subtype(member target state.links @state.type_nodes) {test=active}
                else if string_type(member state) {
                    test=put(hir.ShortCircuit[node.loc boolean 'and' active string_type_test(cell_payload(source member node @state) target node @state)] @state)
                } else if views.fixed_integer_layout(views.structural_base(member state.type_nodes) state.type_nodes) isnt? none {
                    test=put(hir.ShortCircuit[node.loc boolean 'and' active integer_predicate(cell_payload(source member node @state) member target node @state)] @state)
                }
                if test isnt? none {matches=put(hir.ShortCircuit[node.loc boolean 'or' matches test] @state)}
            }
            arms.push(put(hir.IfArm[node.loc output matches word(enum_tag(target @state) node @state)] @state))
        }
        $runtime_assert arms.length >? 0
        let last=hir.node_at(state.nodes arms.pop)
        $runtime_assert last is? hir.IfArm
        prefix.push(put(hir.Flow[node.loc output arms last.body] @state))
        return put(hir.Block[node.loc output prefix false] @state)
    }
    if original isnt? none and narrowed isnt? none {
        # A parent may itself occupy a union cell (e.g. Token|none). Keeping
        # several child alternatives then needs new tags, not just the old
        # parent tag with a narrower logical annotation.
        let retag:set<addr>=set[]
        let tags:set<addr>=set[]
        loop target in narrowed {tags.add(member_tag(target @state))}
        loop member in original {
            if member_tag(member @state) in? tags continue
            # Array length facts refine a read without changing its physical
            # payload or presence tag. Only record family conversions need
            # to split a parent tag into children (or widen children back).
            if object_valued(member state) and not type_tests.disjoint(member read state.links @state.type_nodes) {retag.add(member)}
        }
        if retag.length >? 0 {
            let prefix:array<addr>=[]
            let source=snapshot(value @prefix @state)
            let tag=snapshot(read_word(source 0 node @state) @prefix @state)
            let arms:array<addr>=[]
            let output=types.primitive('int64' @state.type_nodes)
            loop member in original {
                if member not in? retag continue
                let converted=cell_pack(cell_payload(source member node @state) member read node @state)
                let condition=compare('__eq__' tag word(member_tag(member @state) node @state) node @state)
                arms.push(put(hir.IfArm[node.loc output condition converted] @state))
            }
            $runtime_assert arms.length >? 0
            # Other alternatives retain their original cell, including a
            # refined array alongside a record family in the same union.
            prefix.push(put(hir.Flow[node.loc output arms source] @state))
            return put(hir.Block[node.loc output prefix false] @state)
        }
    }
    if original isnt? none and narrowed is? none return cell_payload(value read node @state)
    return value
}
cell_copy = (value:addr type:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return cell_copy_body(value type node @state)
    let key="cell:{types.shape_of(type state.type_nodes)}"
    let name=state.copy_helpers.get(key)
    if name is? none {
        let generated_name=fresh('copy_cell' @state)
        name=generated_name
        state.copy_helpers[key]=generated_name
        let parameter=fresh('copy_source' @state)
        let source=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) parameter] @state)
        let body=cell_copy_body(source type node @state)
        finish_copy(generated_name parameter body node @state)
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] types.primitive('int64' @state.type_nodes) node @state)
}
cell_write = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => {
    let members=cell_members(type @state)
    $runtime_assert members isnt? none
    let prefix:array<addr>=[]
    source=snapshot(source @prefix @state)
    let tag=snapshot(read_word(source 0 node @state) @prefix @state)
    let payload=snapshot(read_word(source 8 node @state) @prefix @state)
    let arms:array<addr>=[]
    let optional=views.optional_payload(type @state.type_nodes)
    loop member in members {
        if not aggregate(member state) continue
        # An optional has one possible present payload. Its read may retain
        # a more precise length/shape than its stored tag; any nonzero tag
        # still denotes that payload, which must receive an independent copy.
        let condition=if optional isnt? none intrinsic_call('__ne__' [tag word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state) else intrinsic_call('__eq__' [tag word(member_tag(member @state) node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let copy=owned_copy(payload member node @state shared=true)
        arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition store_word(copy destination 8 node @state)] @state))
    }
    let fallback=store_word(payload destination 8 node @state)
    prefix.push(store_word(tag destination 0 node @state))
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms fallback] @state))
    return sequence(prefix node @state)
}
# Copy a cell into fresh storage unconditionally (see addressed locals).
cell_private = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let word_type=types.primitive('int64' @state.type_nodes)
    let source=snapshot(value @prefix @state)
    let shared_none=state.none_cell
    if shared_none is? none return source
    let shared=put(hir.ExpressedIdentifier[node.loc word_type shared_none] @state)
    let fresh_cell:array<addr>=[]
    let cell=snapshot(allocation(word(16 node @state) node @state) @fresh_cell @state)
    fresh_cell.push(cell_write(cell source type node @state))
    fresh_cell.push(cell)
    let allocated=put(hir.Block[node.loc word_type fresh_cell false] @state)
    let same=intrinsic_call('__eq__' [source shared] types.primitive('bool' @state.type_nodes) node @state)
    prefix.push(put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type same allocated] @state)] source] @state))
    return put(hir.Block[node.loc word_type prefix false] @state)
}
cell_copy_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let word_type=types.primitive('int64' @state.type_nodes)
    let source=snapshot(value @prefix @state)
    let fresh_cell:array<addr>=[]
    let cell=snapshot(allocation(word(16 node @state) node @state) @fresh_cell @state)
    fresh_cell.push(cell_write(cell source type node @state))
    fresh_cell.push(cell)
    let allocated=put(hir.Block[node.loc word_type fresh_cell false] @state)
    let shared_none=state.none_cell
    if shared_none isnt? none and views.optional_payload(type @state.type_nodes) isnt? none {
        let absent=intrinsic_call('__eq__' [read_word(source 0 node @state) word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let shared=put(hir.ExpressedIdentifier[node.loc word_type shared_none] @state)
        prefix.push(put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type absent shared] @state)] allocated] @state))
    } else {prefix.push(allocated)}
    return put(hir.Block[node.loc word_type prefix false] @state)
}
# `shared`: a record payload read from a container slot may share the block
# (a refcount bump on a headed block) rather than copy it, as `d[k]` does.
cell_pack = (value:addr actual:addr expected:addr node:hir.AST @state:State owned:bool=false shared:bool=false):>addr => {
    let members=cell_members(expected @state)
    $runtime_assert members isnt? none
    if cell_members(actual @state) isnt? none return read_value(value actual expected node @state)
    let selected:addr?=none
    # Preserve an existing member before considering other types it fits.
    # Proof joins can retain both a narrowed record arm and a broader arm;
    # repacking the former keeps its own tag. This does not select between
    # ambiguous source conversions that have no exact member identity.
    loop member in members {
        if actual =? member {selected=member break}
    }
    if selected is? none {
        loop member in members {
            if subtyping.is_subtype(actual member state.links @state.type_nodes) {
                if selected isnt? none return reject(node 'overlapping union payload representations' @state)
                selected=member
            }
        }
    }
    if selected is? none {
        # A checked parent-to-child-union read needs dynamic brand selection.
        # Every branch packs the chosen child's layout and the union's tag;
        # this also preserves fields whose offsets differ between children.
        if not object_valued(actual state) return reject(node 'the value has no member in this union storage' @state)
        let prefix:array<addr>=[]
        let source=snapshot(value @prefix @state)
        let arms:array<addr>=[]
        let output=types.primitive('int64' @state.type_nodes)
        loop member in members {
            if type_tests.disjoint(actual member state.links @state.type_nodes) continue
            if not object_valued(member state) return reject(node 'a narrowed record union has a non-record payload' @state)
            let condition=object_matches(source actual member node @state)
            let payload=if owned owned_record(source actual member node @state) else source
            let packed=cell_pack(payload member expected node @state owned=owned)
            arms.push(put(hir.IfArm[node.loc output condition packed] @state))
        }
        if arms.length =? 0 return reject(node 'the value has no member in this union storage' @state)
        # The checked read/representation conversion already proves coverage.
        let last=hir.node_at(state.nodes arms.pop)
        $runtime_assert last is? hir.IfArm
        prefix.push(put(hir.Flow[node.loc output arms last.body] @state))
        return put(hir.Block[node.loc output prefix false] @state)
    }
    let shared_none=state.none_cell
    if shared_none isnt? none and views.optional_payload(expected @state.type_nodes) isnt? none and types.is_primitive(types.node_at(state.type_nodes types.unfold(selected state.type_nodes)) 'none') {
        return put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) shared_none] @state)
    }
    let prefix:array<addr>=[]
    let content=value
    if not owned {content=owned_copy(value selected node @state shared=shared and object_valued(selected state))}
    else if object_valued(actual state) and object_valued(selected state) {content=owned_record(value actual selected node @state)}
    let payload=snapshot(content @prefix @state)
    let word_value=put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) payload] @state)
    let tag=word(member_tag(selected @state) node @state)
    let helper=construction_helper('new_cell' 2 node @state)
    if helper isnt? none {
        prefix.push(intrinsic_call(helper [tag word_value] types.primitive('int64' @state.type_nodes) node @state))
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    let cell=snapshot(allocation(word(16 node @state) node @state) @prefix @state)
    prefix.push(store_word(tag cell 0 node @state))
    prefix.push(store_word(word_value cell 8 node @state))
    prefix.push(cell)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# Runtime predicate lowering must not silently erase refinements while
# distributing a tested union into its storage alternatives.
test_has_refinement = (id:addr state:State):>bool => {
    let type=types.node_at(state.type_nodes types.unfold(id state.type_nodes))
    if type is? types.RefinedType return true
    if type is? types.TypeOr|types.TypeAnd {
        loop member in type.items {if test_has_refinement(member state) return true}
    }
    if type is? types.TypeNot return test_has_refinement(type.item state)
    return false
}
test_refinements_implied = (actual:addr tested:addr @state:State):>bool => {
    let required=types.node_at(state.type_nodes types.unfold(tested state.type_nodes))
    if required is? types.RefinedType {
        # Storage alternatives omit facts, but the read's logical alternatives
        # still carry them. An addr | Record tested for addr needs only a tag;
        # an int64 | Record tested for addr still needs a payload predicate.
        let input=types.node_at(state.type_nodes types.unfold(actual state.type_nodes))
        let variants:array<addr>=if input is? types.TypeOr input.items else [actual]
        loop variant in variants {
            if not type_tests.covers(variant tested state.links @state.type_nodes) and not type_tests.disjoint(variant required.base state.links @state.type_nodes) return false
        }
        return test_refinements_implied(actual required.base @state)
    }
    if required is? types.TypeOr|types.TypeAnd {
        loop member in required.items {if not test_refinements_implied(actual member @state) return false}
    }
    if required is? types.TypeNot return test_refinements_implied(actual required.item @state)
    return true
}
# `typeof(value)`: the brand word of a minted record.
type_of_value = (node:hir.TypeOf @state:State):>addr => {
    let actual=hir.node_at(state.input.nodes node.value).value_type
    if not object_valued(actual state) return reject(node '`typeof` of a value without brand storage' @state)
    let prefix:array<addr>=[]
    let receiver=read_operand(node.value @prefix @state)
    let source=snapshot(receiver.value @prefix @state)
    let layout=object_layout(actual node @state)
    let offset=layout.offsets.get(layouts.brand_field)
    if offset is? none return reject(node '`typeof` of a value without brand storage' @state)
    return finish_read(read_word(source offset node @state) ReadOperand[source receiver.owner_type] node @prefix @state)
}
# `kind is? Whitespace` on a `type<Family>` value: the value is the brand id
# itself, tested against the brand's range (or a boolean type expression
# over branded types).
metatype_test = (operand:addr node:hir.TypeTest @state:State):>addr => {
    let boolean=types.primitive('bool' @state.type_nodes)
    let prefix:array<addr>=[]
    let tag=snapshot(operand @prefix @state)
    let result=brand_predicate(tag node.test_type node @state)
    if node.negated {result=intrinsic_call('__not__' [result] boolean node @state)}
    prefix.push(result)
    return put(hir.Block[node.loc boolean prefix false] @state)
}
brand_predicate = (tag:addr tested:addr node:hir.AST @state:State):>addr => {
    let boolean=types.primitive('bool' @state.type_nodes)
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(tested state.type_nodes) state.type_nodes))
    if type is? types.TypeOr|types.TypeAnd {
        let conjunction=type is? types.TypeAnd
        let result=put(hir.Bool[node.loc boolean conjunction] @state)
        loop member in type.items {
            let matches=brand_predicate(tag member node @state)
            result=put(hir.ShortCircuit[node.loc boolean if conjunction 'and' else 'or' result matches] @state)
        }
        return result
    }
    if type is? types.TypeNot return intrinsic_call('__not__' [brand_predicate(tag type.item node @state)] boolean node @state)
    if type isnt? types.ObjectType or type.brand is? none return reject(node 'a type value tested against an unbranded type' @state)
    let brand=brand_number(type.brand state)
    if brand is? none return reject(node 'the tested type has no runtime brand number' @state)
    let lower=intrinsic_call('__ge__' [tag word(brand.first node @state)] boolean node @state)
    let upper=intrinsic_call('__lt__' [tag word(brand.limit node @state)] boolean node @state)
    return put(hir.ShortCircuit[node.loc boolean 'and' lower upper] @state)
}
runtime_test = (node:hir.TypeTest @state:State):>addr => {
    let prefix:array<addr>=[]
    let view=string_frame_view(node.value @prefix @state)
    if view isnt? none {
        prefix.push(runtime_test_value(view node @state))
        return put(hir.Block[node.loc runtime_type(node.value_type node @state) prefix false] @state)
    }
    let receiver=read_operand(node.value @prefix @state)
    let value=runtime_test_value(receiver.value node @state)
    return finish_read(value receiver node @prefix @state)
}
# A tested word type whose refinement is a closed set of bounds and gaps on
# the value itself: comparable at runtime, unlike a general predicate.
closed_word_set = (test_type:addr actual:addr state:State):>bool => {
    if views.fixed_integer_layout(actual state.type_nodes) is? none return false
    let refined_test=types.node_at(state.type_nodes types.unfold(test_type state.type_nodes))
    if refined_test isnt? types.RefinedType or refined_test.propositions.length =? 0 return false
    if views.fixed_integer_layout(refined_test.base state.type_nodes) is? none return false
    loop p in refined_test.propositions { if p.subject not=? 'self' or p.projection not=? 'value' or p.term isnt? none or p.tested_type isnt? none or p.when isnt? none or p.op not in? ['>=?' '<=?' 'not=?' '=?'] return false }
    return true
}
runtime_test_value = (operand:addr node:hir.TypeTest @state:State):>addr => {
    let actual=hir.node_at(state.input.nodes node.value).value_type
    if types.node_at(state.type_nodes types.unfold(types.strip_refinement(actual state.type_nodes) state.type_nodes)) is? types.MetaType return metatype_test(operand node @state)
    if test_has_refinement(node.test_type state) and not closed_word_set(node.test_type actual state) {
        if not test_refinements_implied(actual node.test_type @state) return reject(node 'runtime refinement predicates' @state)
        node=hir.TypeTest[node.loc node.value_type node.value views.strip_all_refinements(node.test_type @state.type_nodes) node.negated]
    }
    # A word tested against a closed set of integer literals (`x is? Sign`
    # where `Sign = -1|1`) compares the word with each member.
    let unfolded_test=types.unfold(node.test_type state.type_nodes)
    let set_type=types.node_at(state.type_nodes types.strip_refinement(unfolded_test state.type_nodes))
    let set_members:array<addr>=if set_type is? types.TypeOr set_type.items else [types.strip_refinement(unfolded_test state.type_nodes)]
    let literal_set=set_members.length >? 0 and views.fixed_integer_layout(actual state.type_nodes) isnt? none
    loop member in set_members { if types.node_at(state.type_nodes member) isnt? types.IntegerLiteralType {literal_set=false} }
    # A word tested against a refined word of bounds and gaps (`Sign` as the
    # word `int64<>=? -1, <=? 1, not=? 0>`) compares against each promise.
    let refined_test=types.node_at(state.type_nodes unfolded_test)
    if not literal_set and refined_test is? types.RefinedType and views.fixed_integer_layout(refined_test.base state.type_nodes) isnt? none and views.fixed_integer_layout(actual state.type_nodes) isnt? none and refined_test.propositions.length >? 0 {
        let closed=true
        loop p in refined_test.propositions { if p.subject not=? 'self' or p.projection not=? 'value' or p.term isnt? none or p.tested_type isnt? none or p.when isnt? none or p.op not in? ['>=?' '<=?' 'not=?' '=?'] {closed=false} }
        if closed {
            let prefix:array<addr>=[]
            let boolean=types.primitive('bool' @state.type_nodes)
            let source=snapshot(operand @prefix @state)
            let result:addr?=none
            loop p in refined_test.propositions {
                let name=if p.op =? '>=?' '__ge__' else if p.op =? '<=?' '__le__' else if p.op =? 'not=?' '__ne__' else '__eq__'
                let part=intrinsic_call(name [source word(p.value node @state)] boolean node @state)
                result=if result is? none part else put(hir.ShortCircuit[node.loc boolean 'and' result part] @state)
            }
            $runtime_assert result isnt? none
            prefix.push(if node.negated intrinsic_call('__not__' [result] boolean node @state) else result)
            return put(hir.Block[node.loc boolean prefix false] @state)
        }
    }
    if literal_set {
        let prefix:array<addr>=[]
        let boolean=types.primitive('bool' @state.type_nodes)
        let source=snapshot(operand @prefix @state)
        let result:addr?=none
        loop member in set_members {
            let literal=types.node_at(state.type_nodes member)
            $runtime_assert literal is? types.IntegerLiteralType
            let same=intrinsic_call('__eq__' [source word(literal.value node @state)] boolean node @state)
            result=if result is? none same else put(hir.ShortCircuit[node.loc boolean 'or' result same] @state)
        }
        $runtime_assert result isnt? none
        prefix.push(if node.negated intrinsic_call('__not__' [result] boolean node @state) else result)
        return put(hir.Block[node.loc boolean prefix false] @state)
    }
    # A value whose static type already decides the test (a local narrowed to
    # one literal, a member that is a subtype of the tested type) has no
    # tag to read: fold the answer and keep only the operand's evaluation.
    let decided=subtyping.is_subtype(actual node.test_type state.links @state.type_nodes)
    if decided or type_tests.disjoint(actual node.test_type state.links @state.type_nodes) {
        let prefix:array<addr>=[]
        let evaluated=snapshot(operand @prefix @state)
        prefix.push(put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) decided not=? node.negated] @state))
        return put(hir.Block[node.loc types.primitive('bool' @state.type_nodes) prefix false] @state)
    }
    let optional=views.optional_payload(actual @state.type_nodes)
    if optional isnt? none {
        let present=subtyping.is_subtype(optional node.test_type state.links @state.type_nodes)
        if present or type_tests.disjoint(optional node.test_type state.links @state.type_nodes) {
            # Shape facts about the sole payload do not replace the tag
            # already written into this optional's storage. Tests that cover
            # or exclude that payload need only presence, as in hosted
            # optional lowering. Preserve evaluation of the source once.
            let absent=subtyping.is_subtype(types.primitive('none' @state.type_nodes) node.test_type state.links @state.type_nodes)
            let prefix:array<addr>=[]
            let source=snapshot(operand @prefix @state)
            let boolean=types.primitive('bool' @state.type_nodes)
            let result=if present =? absent put(hir.Bool[node.loc boolean present] @state) else intrinsic_call(if present '__ne__' else '__eq__' [read_word(source 0 node @state) word(0 node @state)] boolean node @state)
            if node.negated {result=intrinsic_call('__not__' [result] boolean node @state)}
            prefix.push(result)
            return put(hir.Block[node.loc boolean prefix false] @state)
        }
    }
    let enum=enum_members(actual state)
    if enum isnt? none {
        let prefix:array<addr>=[]
        let tag=snapshot(operand @prefix @state)
        let boolean=types.primitive('bool' @state.type_nodes)
        let result=put(hir.Bool[node.loc boolean false] @state)
        loop member in enum {
            if not subtyping.is_subtype(member node.test_type state.links @state.type_nodes) continue
            let matches=intrinsic_call('__eq__' [tag word(enum_tag(member @state) node @state)] boolean node @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result matches] @state)
        }
        if node.negated {result=intrinsic_call('__not__' [result] boolean node @state)}
        prefix.push(result)
        return put(hir.Block[node.loc boolean prefix false] @state)
    }
    # A narrowing join can give a read a union type (`3 | int64<1..3>`)
    # while its storage is one integer word: the storage decides.
    let storage=stored_type(node.value state)
    if cell_members(storage @state) is? none and views.fixed_integer_layout(views.structural_base(storage state.type_nodes) state.type_nodes) isnt? none {
        let prefix:array<addr>=[]
        let source=snapshot(operand @prefix @state)
        let result=integer_predicate(source storage node.test_type node @state)
        if node.negated {result=intrinsic_call('__not__' [result] types.primitive('bool' @state.type_nodes) node @state)}
        prefix.push(result)
        return put(hir.Block[node.loc node.value_type prefix false] @state)
    }
    let members=cell_members(actual @state)
    if members is? none {
        if views.fixed_integer_layout(views.structural_base(actual state.type_nodes) state.type_nodes) isnt? none {
            let prefix:array<addr>=[]
            let source=snapshot(operand @prefix @state)
            let result=integer_predicate(source actual node.test_type node @state)
            if node.negated {result=intrinsic_call('__not__' [result] types.primitive('bool' @state.type_nodes) node @state)}
            prefix.push(result)
            return put(hir.Block[node.loc node.value_type prefix false] @state)
        }
        if string_type(actual state) {
            let result=string_type_test(operand node.test_type node @state)
            return if node.negated intrinsic_call('__not__' [result] types.primitive('bool' @state.type_nodes) node @state) else result
        }
        return object_test(operand node @state)
    }
    let prefix:array<addr>=[]
    let source=snapshot(operand @prefix @state)
    let tag=snapshot(read_word(source 0 node @state) @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let result=put(hir.Bool[node.loc boolean false] @state)
    let seen:set<addr>=set[]
    loop member in members {
        let tag_number=member_tag(member @state)
        if tag_number in? seen continue
        seen.add(tag_number)
        # String alternatives share the descriptor representation and tag.
        # Their literal spelling is in the payload, never in that shared tag.
        if string_type(member state) {
            let active=intrinsic_call('__eq__' [tag word(tag_number node @state)] boolean node @state)
            let payload=cell_payload(source types.primitive('string' @state.type_nodes) node @state)
            let matches=string_type_test(payload node.test_type node @state)
            let selected=put(hir.ShortCircuit[node.loc boolean 'and' active matches] @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result selected] @state)
        } else if subtyping.is_subtype(member node.test_type state.links @state.type_nodes) {
            let matches=intrinsic_call('__eq__' [tag word(member_tag(member @state) node @state)] boolean node @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result matches] @state)
        } else if views.fixed_integer_layout(views.structural_base(member state.type_nodes) state.type_nodes) isnt? none {
            let active=intrinsic_call('__eq__' [tag word(tag_number node @state)] boolean node @state)
            let matches=integer_predicate(cell_payload(source member node @state) member node.test_type node @state)
            let selected=put(hir.ShortCircuit[node.loc boolean 'and' active matches] @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result selected] @state)
        } else if object_valued(member state) and not type_tests.disjoint(member node.test_type state.links @state.type_nodes) {
            let active=intrinsic_call('__eq__' [tag word(tag_number node @state)] boolean node @state)
            let matches=object_matches(cell_payload(source member node @state) member node.test_type node @state)
            let selected=put(hir.ShortCircuit[node.loc boolean 'and' active matches] @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result selected] @state)
        } else if views.integer_valued(member state.type_nodes) and views.fixed_integer_layout(views.structural_base(node.test_type state.type_nodes) state.type_nodes) isnt? none {
            # An abstract `int`/`uint` alternative occupies the 64-bit word
            # (`dict<string int|none>`); every present value fits the word,
            # so a fixed-width test is the presence of that alternative.
            let active=intrinsic_call('__eq__' [tag word(tag_number node @state)] boolean node @state)
            result=put(hir.ShortCircuit[node.loc boolean 'or' result active] @state)
        } else if not type_tests.disjoint(member node.test_type state.links @state.type_nodes) {
            return reject(node 'a runtime test within one union payload alternative' @state)
        }
    }
    if node.negated {result=intrinsic_call('__not__' [result] boolean node @state)}
    prefix.push(result)
    return put(hir.Block[node.loc boolean prefix false] @state)
}

# Strings are immutable views over UTF-8 bytes and a table of grapheme byte
# boundaries. A slice advances the boundary pointer but retains the original
# byte base. The start word is therefore an absolute offset into that base.
# Owned descriptors retain shared backing; releasing the last descriptor
# returns the bytes and boundary table to the arena.
string_type = (id:addr state:State):>bool => {
    let plain=types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes)
    return views.string_valued(plain state.type_nodes)
}
# Compact string enums are integers, not descriptor pointers.
owned_string = (id:addr state:State):>bool => string_type(id state) and enum_members(id state) is? none
string_runtime = (helper:string arguments:array<addr> node:hir.AST @state:State result_void:bool=false):>addr => {
    let binding=state.runtime_helpers.get(helper)
    # Prelude-free kernels only have frame/static storage, with no reclamation.
    if state.allocator is? none {
        if result_void return sequence([] node @state)
        if helper in? ['_native_string_copy' '_native_string_pin'] and arguments.length >? 0 return arguments[0]
        return word(0 node @state)
    }
    if binding is? none return reject(node "native string storage needs {helper}" @state)
    let name=state.symbols.get(binding)
    if name is? none return reject(node "native string helper {helper} is absent" @state)
    return intrinsic_call(name arguments types.primitive(if result_void 'void' else 'int64' @state.type_nodes) node @state)
}
string_memory = (data:addr byte_length:addr boundaries:addr length:addr start:addr node:hir.AST @state:State static_storage:bool=false owner:addr?=none):>addr => {
    let prefix:array<addr>=[]
    if not static_storage {
        data=snapshot(data @prefix @state) byte_length=snapshot(byte_length @prefix @state)
        boundaries=snapshot(boundaries @prefix @state) length=snapshot(length @prefix @state)
    }
    let size=word(layouts.string_descriptor.size node @state)
    let storage=if static_storage intrinsic_call('__static_alloca__' [size] types.primitive('int64' @state.type_nodes) node @state) else if state.shared_string_descriptors string_runtime('_native_string_descriptor' [] node @state) else allocation(size node @state)
    let descriptor=snapshot(storage @prefix @state)
    let control=if static_storage word(0 node @state) else if owner isnt? none owner else string_runtime('_native_string_owner' [data byte_length boundaries word_op('__mul__' word_op('__add__' length word(1 node @state) node @state) word(4 node @state) node @state)] node @state)
    let fields:array<addr>=[data byte_length boundaries length start control]
    let offset:addr=0
    loop value in fields {prefix.push(store_word(value descriptor offset node @state)) offset+=8}
    prefix.push(descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_literal = (node:hir.String @state:State):>addr => {
    let bytes=node.content as array<uint8>
    if bytes.length >? uint32.max return reject(node 'a string literal exceeding the runtime boundary offset range' @state)
    # Segment at compile time using Dewy's own grapheme indexing. Emit the
    # final uint32 offsets as bytes, rather than an allocation and one runtime
    # store per boundary. Runtime joins still segment their combined bytes.
    let packed:array<uint8>=[0 0 0 0]
    let offset:addr=0
    loop i in 0.. and i <? node.content.length {
        let grapheme=node.content[i] as array<uint8>
        offset+=grapheme.length
        let remaining=offset
        loop shift in 0..3 {
            packed.push((remaining % 256) as uint8)
            remaining //=256
        }
    }
    let word_type=types.primitive('int64' @state.type_nodes)
    let boundaries=put(hir.BasedString[node.loc word_type '0x' '' packed none] @state)
    let data=put(hir.String[node.loc word_type node.content] @state)
    # All six descriptor words are compile-time stable. The existing µDewy
    # primitive emits the pointer relocations as static data, preserving one
    # descriptor per literal site without rebuilding it on every evaluation.
    return intrinsic_call('__static_words__' [data word(bytes.length node @state) boundaries word(node.content.length node @state) word(0 node @state) word(0 node @state)] word_type node @state)
}
string_data = (value:addr node:hir.AST @state:State):>addr => word_op('__add__' read_word(value layouts.string_descriptor.data node @state) read_word(value layouts.string_descriptor.start node @state) node @state)
string_view = (value:addr first:addr count:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[ensure_segmented(value node @state)]
    let boundaries=snapshot(word_op('__add__' read_word(value layouts.string_descriptor.boundaries node @state) word_op('__mul__' first word(4 node @state) node @state) node @state) @prefix @state)
    let start=snapshot(intrinsic_call('__load_u32__' [boundaries] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let end_pointer=word_op('__add__' boundaries word_op('__mul__' count word(4 node @state) node @state) node @state)
    let stop=snapshot(intrinsic_call('__load_u32__' [end_pointer] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    prefix.push(string_memory(read_word(value layouts.string_descriptor.data node @state) word_op('__sub__' stop start node @state) boundaries count start node @state owner=string_runtime('_native_string_view_owner' [value] node @state)))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# A string index or slice whose base stays alive for the enclosing statement
# can be read through a frame-resident descriptor: no arena allocation and
# no owner reference. The slot is reserved once per function (hoisted with
# the loop prologue), so loops reuse it. Only consumers that neither retain
# nor release the value (comparisons, tests, hashing) may request one; the
# control word stays zero and the descriptor must never escape the statement.
string_frame_view = (id:addr @prefix:array<addr> @state:State immediate:bool=false):>addr? => {
    if state.allocator is? none or not state.cleanup_enabled return none
    let node=hir.node_at(state.input.nodes id)
    # Contextual typing wraps an index in representation-preserving casts
    # and single-item blocks; the storage read underneath is the same.
    loop true {
        if node is? hir.Suppress {id=node.item node=hir.node_at(state.input.nodes id) continue}
        if node is? hir.Obligation {id=node.value node=hir.node_at(state.input.nodes id) continue}
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {id=node.items[0] node=hir.node_at(state.input.nodes id) continue}
        if node is? hir.ValueCast|hir.RepresentationCast and owned_string(node.value_type state) and owned_string(hir.node_at(state.input.nodes node.expr).value_type state) {id=node.expr node=hir.node_at(state.input.nodes id) continue}
        break
    }
    # A string literal, or a string read through a route whose owner stays
    # read-only for the whole function, needs neither a retained handle nor
    # a release around a comparison: the descriptor itself is the operand.
    # Consumers read the operand several times, so bind it once.
    if node is? hir.String return snapshot(expression(id @state) @prefix @state)
    if node is? hir.ExpressedIdentifier|hir.MemberAccess|hir.Index {
        if not owned_string(node.value_type state) or stored_type(id state) not=? node.value_type return none
        if id in? state.array_snapshots return none
        let source=borrowing.route(id state.input.nodes)
        if source is? none or source.binding in? state.boxed return none
        # An immediate builtin consumer runs no user code after this read.
        # A local/parameter string handle survives that interval even when
        # a later statement replaces it. Longer intervals still require the
        # whole-function stability proof (notably lookup defaults).
        if not (immediate and node is? hir.ExpressedIdentifier) and not borrowing.stable_owner(source state.stable_bindings state.stable_parameters) return none
        return snapshot(expression(id @state) @prefix @state)
    }
    if node isnt? hir.StringIndex|hir.StringSlice return none
    let base=hir.node_at(state.input.nodes node.string)
    if not owned_string(base.value_type state) return none
    if base isnt? hir.String {
        let route=borrowing.route(node.string state.input.nodes)
        if route is? none or route.binding in? state.boxed return none
        if not borrowing.stable_owner(route state.stable_bindings state.stable_parameters) return none
    }
    let word_type=types.primitive('int64' @state.type_nodes)
    let first:addr=0
    let count:addr=0
    let value=snapshot(expression(node.string @state) @prefix @state)
    prefix.push(ensure_segmented(value node @state))
    if node is? hir.StringIndex {
        first=snapshot(expression(node.index @state) @prefix @state)
        count=word(1 node @state)
    } else {
        let range=hir.node_at(state.input.nodes node.range)
        if range isnt? hir.Range or range.step_pair isnt? none return none
        let bounds=if range.bounds is? none '[]' else range.bounds
        let start=if range.left is? none word(0 node @state) else expression(range.left @state)
        if range.left isnt? none and bounds in? ['()' '(]'] {start=word_op('__add__' start word(1 node @state) node @state)}
        first=snapshot(start @prefix @state)
        let stop=if range.right is? none read_word(value layouts.string_descriptor.grapheme_length node @state) else expression(range.right @state)
        if range.right isnt? none and bounds in? ['[]' '(]'] {stop=word_op('__add__' stop word(1 node @state) node @state)}
        stop=snapshot(stop @prefix @state)
        count=snapshot(word_op('__sub__' stop first node @state) @prefix @state)
        let negative=intrinsic_call('__lt__' [count word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let zero=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) count '=' word(0 node @state)] @state)
        prefix.push(conditional(negative zero node @state))
    }
    let hoisted:array<addr>=[]
    let slot=snapshot(intrinsic_call('__alloca__' [word(layouts.string_descriptor.size node @state)] word_type node @state) @hoisted @state)
    loop item in hoisted {state.loop_prologue.push(item)}
    let boundaries=snapshot(word_op('__add__' read_word(value layouts.string_descriptor.boundaries node @state) word_op('__mul__' first word(4 node @state) node @state) node @state) @prefix @state)
    let start=snapshot(intrinsic_call('__load_u32__' [boundaries] word_type node @state) @prefix @state)
    let stop=snapshot(intrinsic_call('__load_u32__' [word_op('__add__' boundaries word_op('__mul__' count word(4 node @state) node @state) node @state)] word_type node @state) @prefix @state)
    prefix.push(store_word(read_word(value layouts.string_descriptor.data node @state) slot layouts.string_descriptor.data node @state))
    prefix.push(store_word(word_op('__sub__' stop start node @state) slot layouts.string_descriptor.byte_length node @state))
    prefix.push(store_word(boundaries slot layouts.string_descriptor.boundaries node @state))
    prefix.push(store_word(count slot layouts.string_descriptor.grapheme_length node @state))
    prefix.push(store_word(start slot layouts.string_descriptor.start node @state))
    prefix.push(store_word(word(0 node @state) slot layouts.string_descriptor.owner node @state))
    return slot
}
string_index = (node:hir.StringIndex @state:State):>addr => {
    let prefix:array<addr>=[]
    let value=snapshot(owned_value(node.string @state) @prefix @state)
    let index=snapshot(expression(node.index @state) @prefix @state)
    let result=snapshot(string_view(value index word(1 node @state) node @state) @prefix @state)
    prefix.push(string_runtime('_native_string_release' [value] node @state result_void=true))
    prefix.push(result)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
StringBounds:type = const [first:addr count:addr]
string_bounds = (range:hir.Range length:addr node:hir.AST @prefix:array<addr> @state:State):>StringBounds => {
    let bounds=if range.bounds is? none '[]' else range.bounds
    let first=if range.left is? none word(0 node @state) else expression(range.left @state)
    if range.left isnt? none and bounds in? ['()' '(]'] {first=word_op('__add__' first word(1 node @state) node @state)}
    first=snapshot(first @prefix @state)
    let stop=if range.right is? none length else expression(range.right @state)
    if range.right isnt? none and bounds in? ['[]' '(]'] {stop=word_op('__add__' stop word(1 node @state) node @state)}
    stop=snapshot(stop @prefix @state)
    let count=snapshot(word_op('__sub__' stop first node @state) @prefix @state)
    let negative=intrinsic_call('__lt__' [count word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
    let zero=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) count '=' word(0 node @state)] @state)
    prefix.push(conditional(negative zero node @state))
    return StringBounds[first count]
}
string_slice = (node:hir.StringSlice @state:State):>addr => {
    let range=hir.node_at(state.input.nodes node.range)
    if range isnt? hir.Range or range.step_pair isnt? none return reject(node 'stepped string slicing' @state)
    let prefix:array<addr>=[]
    let value=snapshot(owned_value(node.string @state) @prefix @state)
    let bounds=string_bounds(range read_word(value layouts.string_descriptor.grapheme_length node @state) node @prefix @state)
    let result=snapshot(string_view(value bounds.first bounds.count node @state) @prefix @state)
    prefix.push(string_runtime('_native_string_release' [value] node @state result_void=true))
    prefix.push(result)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# An immediately consumed view needs byte boundaries and an owning root,
# not a separately allocated string descriptor. Keeping that root until the
# whole comparison finishes preserves the left value across right-hand calls
# that replace its source. Bounds still execute once, in source order.
StringSpan:type = const [root:addr data:addr boundaries:addr start:addr byte_length:addr length:addr]
string_span = (id:addr @prefix:array<addr> @state:State offsets:bool=false):>StringSpan => {
    let node=hir.node_at(state.input.nodes id)
    if node is? hir.ValueCast|hir.RepresentationCast and owned_string(node.value_type state) and owned_string(hir.node_at(state.input.nodes node.expr).value_type state) {
        return string_span(node.expr @prefix @state offsets=offsets)
    }
    if node is? hir.StringSlice|hir.StringIndex {
        let source=string_span(node.string @prefix @state offsets=true)
        let first:addr=0
        let count:addr=0
        if node is? hir.StringSlice {
            let range=hir.node_at(state.input.nodes node.range)
            if range isnt? hir.Range or range.step_pair isnt? none {
                reject(node 'stepped string slicing' @state);
                return source
            }
            let bounds=string_bounds(range source.length node @prefix @state)
            first=bounds.first count=bounds.count
        } else {
            first=snapshot(expression(node.index @state) @prefix @state)
            count=word(1 node @state)
        }
        let boundaries=snapshot(word_op('__add__' source.boundaries word_op('__mul__' first word(4 node @state) node @state) node @state) @prefix @state)
        let start=snapshot(intrinsic_call('__load_u32__' [boundaries] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
        let stop_pointer=word_op('__add__' boundaries word_op('__mul__' count word(4 node @state) node @state) node @state)
        let stop=snapshot(intrinsic_call('__load_u32__' [stop_pointer] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
        let length=snapshot(word_op('__sub__' stop start node @state) @prefix @state)
        return StringSpan[source.root source.data boundaries start length count]
    }
    let root=snapshot(owned_value(id @state) @prefix @state)
    if offsets {prefix.push(ensure_segmented(root node @state))}
    return StringSpan[root read_word(root layouts.string_descriptor.data node @state) read_word(root layouts.string_descriptor.boundaries node @state) read_word(root layouts.string_descriptor.start node @state) read_word(root layouts.string_descriptor.byte_length node @state) read_word(root layouts.string_descriptor.grapheme_length node @state)]
}
string_equal = (node:hir.StringEqual @state:State):>addr => {
    let prefix:array<addr>=[]
    let left=string_span(node.left @prefix @state)
    let right=string_span(node.right @prefix @state)
    let a=word_op('__add__' left.data left.start node @state)
    let b=word_op('__add__' right.data right.start node @state)
    let result=snapshot(string_equal_bytes(a left.byte_length b right.byte_length node node.negated @state) @prefix @state)
    prefix.push(string_runtime('_native_string_release' [left.root] node @state result_void=true))
    prefix.push(string_runtime('_native_string_release' [right.root] node @state result_void=true))
    prefix.push(result)
    return put(hir.Block[node.loc types.primitive('bool' @state.type_nodes) prefix false] @state)
}
string_equal_values = (a_value:addr b_value:addr node:hir.AST negated:bool @state:State):>addr => {
    let prefix:array<addr>=[]
    let left=snapshot(a_value @prefix @state)
    let right=snapshot(b_value @prefix @state)
    prefix.push(string_equal_bytes(string_data(left node @state) read_word(left layouts.string_descriptor.byte_length node @state) string_data(right node @state) read_word(right layouts.string_descriptor.byte_length node @state) node negated @state))
    return put(hir.Block[node.loc types.primitive('bool' @state.type_nodes) prefix false] @state)
}
# Byte comparison is one generated helper per program, not a loop at every
# `=?` on strings (a dozen lines each, over a thousand sites in the compiler).
string_equal_bytes = (left:addr left_length:addr right:addr right_length:addr node:hir.AST negated:bool @state:State):>addr => {
    let boolean=types.primitive('bool' @state.type_nodes)
    let helper=bytes_equal_helper(node @state)
    if helper isnt? none {
        let same=intrinsic_call(helper [left left_length right right_length] boolean node @state)
        return if negated intrinsic_call('__not__' [same] boolean node @state) else same
    }
    return string_equal_bytes_inline(left left_length right right_length node negated @state)
}
bytes_equal_helper = (node:hir.AST @state:State):>string? => {
    if state.allocator is? none return none
    let existing=state.copy_helpers.get('bytes_equal')
    if existing isnt? none return existing
    let generated=fresh('bytes_equal' @state)
    state.copy_helpers['bytes_equal']=generated
    let word_type=types.primitive('int64' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let parameters:array<hir.Param>=[]
    let slots:array<types.PosOrKwArg>=[]
    let names=[fresh('bytes' @state) fresh('bytes' @state) fresh('bytes' @state) fresh('bytes' @state)]
    loop parameter in names {
        parameters.push(hir.Param[parameter word_type])
        slots.push(types.PosOrKwArg[parameter word_type])
    }
    let a=put(hir.ExpressedIdentifier[node.loc word_type names[0]] @state)
    let a_length=put(hir.ExpressedIdentifier[node.loc word_type names[1]] @state)
    let b=put(hir.ExpressedIdentifier[node.loc word_type names[2]] @state)
    let b_length=put(hir.ExpressedIdentifier[node.loc word_type names[3]] @state)
    let body=string_equal_bytes_inline(a a_length b b_length node false @state)
    let signature=types.function_type(slots [] none boolean [] @state.type_nodes)
    let literal=put(hir.FunctionLiteral[node.loc signature parameters [] none boolean body source=state.source_index] @state)
    state.generated.push(program.Function[generated literal])
    return generated
}
string_equal_bytes_inline = (left:addr left_length:addr right:addr right_length:addr node:hir.AST negated:bool @state:State):>addr => {
    let prefix:array<addr>=[]
    let length=snapshot(left_length @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let same=snapshot(intrinsic_call('__eq__' [length right_length] boolean node @state) @prefix @state)
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let a=snapshot(left @prefix @state)
    let b=snapshot(right @prefix @state)
    let byte_type=types.primitive('uint8' @state.type_nodes)
    let av=intrinsic_call('__load_u8__' [word_op('__add__' a cursor node @state)] byte_type node @state)
    let bv=intrinsic_call('__load_u8__' [word_op('__add__' b cursor node @state)] byte_type node @state)
    let comparison=intrinsic_call('__eq__' [av bv] boolean node @state)
    let assign=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) same '=' comparison] @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let running=intrinsic_call('__lt__' [cursor length] boolean node @state)
    let condition=put(hir.ShortCircuit[node.loc boolean 'and' same running] @state)
    let body=sequence([assign increment] node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    prefix.push(if negated intrinsic_call('__not__' [same] boolean node @state) else same)
    return put(hir.Block[node.loc boolean prefix false] @state)
}
string_bytes = (value:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let length=snapshot(read_word(source layouts.string_descriptor.byte_length node @state) @prefix @state)
    let memory=array_memory(length 1 node @state)
    loop item in memory.prefix {prefix.push(item)}
    prefix.push(counted_bytes(string_data(source node @state) memory.data word(0 node @state) length node @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Materialize an independent array of immutable one-grapheme views. Reuse
# the string's boundary table (including a slice's shifted boundary pointer),
# rather than decoding scalars or segmenting the same UTF-8 bytes again.
# Each element owns its view descriptor and retains the shared string backing.
string_graphemes = (value:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    prefix.push(ensure_segmented(source node @state))
    let length=snapshot(read_word(source layouts.string_descriptor.grapheme_length node @state) @prefix @state)
    let memory=array_memory(length 8 node @state)
    loop item in memory.prefix {prefix.push(item)}
    let index=snapshot(word(0 node @state) @prefix @state)
    let destination=word_op('__add__' memory.data word_op('__mul__' index word(8 node @state) node @state) node @state)
    let store=store_word(string_view(source index word(1 node @state) node @state) destination 0 node @state)
    let advance=assign_value(index word_op('__add__' index word(1 node @state) node @state) node @state)
    prefix.push(loop_while(compare('__lt__' index length node @state) [store advance] node @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Strings already contain valid UTF-8. Decode scalar values, not grapheme
# clusters: a combining sequence yields several uint32 elements. A slice's
# data starts at its byte offset, and its byte length bounds this traversal.
Utf8Width:type = const [limit:int64 width:int64 mask:int64]
string_scalars = (value:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let data=snapshot(string_data(source node @state) @prefix @state)
    let length=snapshot(read_word(source layouts.string_descriptor.byte_length node @state) @prefix @state)
    # The byte count is a safe capacity; the final length counts scalars.
    let memory=array_memory(length 4 node @state)
    loop item in memory.prefix {prefix.push(item)}
    let cursor=snapshot(word(0 node @state) @prefix @state)
    let count=snapshot(word(0 node @state) @prefix @state)
    let scalar=snapshot(word(0 node @state) @prefix @state)
    let empty=types.primitive('void' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let pointer=word_op('__add__' data cursor node @state)
    let leading=intrinsic_call('__load_u8__' [pointer] types.primitive('int64' @state.type_nodes) node @state)
    let arms:array<addr>=[]
    loop encoding in [Utf8Width[128 1 127] Utf8Width[224 2 31] Utf8Width[240 3 15] Utf8Width[256 4 7]] {
        let limit=encoding.limit
        let width=encoding.width
        let mask=encoding.mask
        let decoded=word_op('__and__' leading word(mask node @state) node @state)
        loop delta in 1.. and delta <? width {
            let byte=intrinsic_call('__load_u8__' [word_op('__add__' pointer word(delta node @state) node @state)] types.primitive('int64' @state.type_nodes) node @state)
            decoded=word_op('__add__' word_op('__lshift__' decoded word(6 node @state) node @state) word_op('__and__' byte word(63 node @state) node @state) node @state)
        }
        let save=put(hir.Assign[node.loc empty scalar '=' decoded] @state)
        let advance=put(hir.Assign[node.loc empty cursor '=' word_op('__add__' cursor word(width node @state) node @state)] @state)
        let selected=intrinsic_call('__lt__' [leading word(limit node @state)] boolean node @state)
        arms.push(put(hir.IfArm[node.loc empty selected sequence([save advance] node @state)] @state))
    }
    let decode=put(hir.Flow[node.loc empty arms none] @state)
    let destination=word_op('__add__' memory.data word_op('__mul__' count word(4 node @state) node @state) node @state)
    let store=intrinsic_call('__store_u32__' [scalar destination] empty node @state)
    let advance=put(hir.Assign[node.loc empty count '=' word_op('__add__' count word(1 node @state) node @state)] @state)
    let running=intrinsic_call('__lt__' [cursor length] boolean node @state)
    let loop_arm=put(hir.LoopArm[node.loc empty running sequence([decode store advance] node @state)] @state)
    prefix.push(put(hir.Flow[node.loc empty [loop_arm] none] @state))
    prefix.push(store_word(count memory.descriptor layouts.array_descriptor.length node @state))
    prefix.push(memory.descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Raw literal bytes and compiler-created borrowed byte views use the same
# descriptor as arrays. A later value copy makes independently mutable
# storage; merely describing embedded data must not allocate a second copy.
byte_descriptor = (data:addr length:addr node:hir.AST @state:State static_storage:bool=false frame_storage:bool=false):>addr => {
    let prefix:array<addr>=[]
    let size=word(layouts.array_descriptor.size node @state)
    let storage=if static_storage intrinsic_call('__static_alloca__' [size] types.primitive('int64' @state.type_nodes) node @state) else if frame_storage intrinsic_call('__alloca__' [size] types.primitive('int64' @state.type_nodes) node @state) else allocation(size node @state)
    let descriptor=snapshot(storage @prefix @state)
    let flags=layouts.array_flags.borrowed_static + if static_storage or frame_storage 0 else layouts.array_flags.arena_descriptor
    let fields:array<addr>=[data length length word(1 node @state) word(flags node @state) word(0 node @state)]
    let offset:addr=0
    loop field in fields {prefix.push(store_word(field descriptor offset node @state)) offset+=8}
    prefix.push(descriptor)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
binary_literal = (node:hir.BasedString @state:State):>addr => {
    let data=put(hir.BasedString[node.loc types.primitive('int64' @state.type_nodes) node.prefix node.digits node.content node.include_path] @state)
    return byte_descriptor(data word(node.content.length node @state) node @state static_storage=true)
}
binary_array_view = (node:hir.RepresentationCast state:State):>bool => {
    let source=hir.node_at(state.input.nodes node.expr)
    let type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes))
    let target=array_type(node.value_type state)
    return type is? types.BinaryLiteralType and target isnt? none and types.is_primitive(types.node_at(state.type_nodes target.element) 'uint8')
}

# Materialized strings resegment all bytes, including a cluster crossing a
# concatenation boundary. The library returns validated word offsets; the
# runtime string layout stores those offsets as uint32, as the hosted one
# does. Call by installed helper identity to preserve lexical shadowing.
# The current runtime can fill the final uint32 table directly. Reserve its
# byte-count upper bound once and retain that allocation size in the backing
# control; the actual grapheme count may be much smaller for Unicode text.
segmented_string_into = (data:addr length:addr node:hir.AST optional:bool @state:State):>addr => {
    let prefix:array<addr>=[]
    data=snapshot(data @prefix @state) length=snapshot(length @prefix @state)
    # Reject oversized inputs through the helper without overflowing the
    # table's capacity arithmetic or allocating an unusable giant table.
    let fits=intrinsic_call('__le__' [length word(uint32.max node @state)] types.primitive('bool' @state.type_nodes) node @state)
    let word_type=types.primitive('int64' @state.type_nodes)
    let capacity_arm=put(hir.IfArm[node.loc word_type fits word_op('__add__' length word(1 node @state) node @state)] @state)
    let capacity=put(hir.Flow[node.loc word_type [capacity_arm] word(0 node @state)] @state)
    let size=snapshot(word_op('__mul__' capacity word(4 node @state) node @state) @prefix @state)
    let boundaries=snapshot(allocation(size node @state) @prefix @state)
    let bytes=snapshot(byte_descriptor(data length node @state) @prefix @state)
    let checked=snapshot(string_runtime('_utf8_boundaries_into' [bytes boundaries] node @state) @prefix @state)
    prefix.push(release_block(bytes word(layouts.array_descriptor.size node @state) node @state))
    let valid=intrinsic_call('__ne__' [read_word(checked 0 node @state) word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
    let success:array<addr>=[]
    let count=snapshot(read_word(checked 8 node @state) @success @state)
    let owner=string_runtime('_native_string_owner' [data length boundaries size] node @state)
    let result=string_memory(data length boundaries count word(0 node @state) node @state owner=owner)
    let empty=types.primitive('void' @state.type_nodes)
    if optional {
        let cell=snapshot(allocation(word(16 node @state) node @state) @prefix @state)
        prefix.push(store_word(word(0 node @state) cell 0 node @state))
        prefix.push(store_word(word(0 node @state) cell 8 node @state))
        success.push(store_word(result cell 8 node @state))
        success.push(store_word(word(member_tag(types.primitive('string' @state.type_nodes) @state) node @state) cell 0 node @state))
        let discard=sequence([release_block(data length node @state) release_block(boundaries size node @state)] node @state)
        let arm=put(hir.IfArm[node.loc empty valid sequence(success node @state)] @state)
        prefix.push(put(hir.Flow[node.loc empty [arm] discard] @state))
        prefix.push(cell)
    } else {
        # Concatenation starts with valid strings; invalid joined UTF-8 is
        # unreachable. Retain the existing backend policy for that boundary.
        let yes=put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) true] @state)
        let forever=put(hir.LoopArm[node.loc empty yes sequence([] node @state)] @state)
        let impossible=put(hir.Flow[node.loc types.primitive('never' @state.type_nodes) [forever] none] @state)
        success.push(result)
        let body=put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) success false] @state)
        let selected=put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) valid body] @state)
        prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [selected] impossible] @state))
    }
    $runtime_assert prefix.length >? 0
    let selected=prefix.pop
    let output=snapshot(selected @prefix @state)
    # The helper returns only an optional word, with no scratch array tree.
    let checked_block=release_block(checked word(16 node @state) node @state)
    let shared_none=state.none_cell
    if shared_none isnt? none {
        let shared=put(hir.ExpressedIdentifier[node.loc types.primitive('int64' @state.type_nodes) shared_none] @state)
        checked_block=conditional(intrinsic_call('__ne__' [checked shared] types.primitive('bool' @state.type_nodes) node @state) checked_block node @state)
    }
    prefix.push(checked_block)
    prefix.push(output)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}

# Joined strings are valid UTF-8 by construction, so their grapheme table
# is built only when a consumer needs offsets (index, slice, iteration).
# Length/shape reads count without allocating that table. Initially boundaries
# are zero and length is -1; the count and table are independently cached in
# the descriptor and backing control so other handles can adopt them.
lazy_strings = (state:State):>bool => state.allocator isnt? none and state.shared_string_descriptors and '_utf8_boundaries_into' in? state.runtime_helpers and '_utf8_grapheme_scan' in? state.runtime_helpers
lazy_string = (data:addr length:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    data=snapshot(data @prefix @state) length=snapshot(length @prefix @state)
    let owner=string_runtime('_native_string_owner' [data length word(0 node @state) word(0 node @state)] node @state)
    prefix.push(string_memory(data length word(0 node @state) word(-1 node @state) word(0 node @state) node @state owner=owner))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# A scalar query must not allocate a boundary table as a hidden consequence
# of lazy string construction. Share the same UTF-8/UAX #29 scanner, supplying
# nonescaping frame descriptors and a scalar result rather than an optional
# cell. The ordinary segmentation path still constructs offsets on demand.
ensure_length = (value:addr node:hir.AST @state:State):>addr => {
    if not lazy_strings(state) return sequence([] node @state)
    let key='string:count'
    let name=state.copy_helpers.get(key)
    let empty=types.primitive('void' @state.type_nodes)
    if name is? none {
        let generated=fresh('count_string' @state)
        name=generated state.copy_helpers[key]=generated
        let word_type=types.primitive('int64' @state.type_nodes)
        let parameter=fresh('counted' @state)
        let source=put(hir.ExpressedIdentifier[node.loc word_type parameter] @state)
        let body=ensure_length_body(source node @state)
        let signature=types.function_type([types.PosOrKwArg[parameter word_type]] [] none empty [] @state.type_nodes)
        let literal=put(hir.FunctionLiteral[node.loc signature [hir.Param[parameter word_type]] [] none empty body source=state.source_index] @state)
        state.generated.push(program.Function[generated literal])
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] empty node @state)
}
ensure_length_body = (value:addr node:hir.AST @state:State):>addr => {
    let word_type=types.primitive('int64' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let body:array<addr>=[]
    let owner=snapshot(read_word(value layouts.string_descriptor.owner node @state) @body @state)
    let compute:array<addr>=[]
    let bytes=snapshot(byte_descriptor(string_data(value node @state) read_word(value layouts.string_descriptor.byte_length node @state) node @state frame_storage=true) @compute @state)
    let scratch=snapshot(byte_descriptor(word(0 node @state) word(0 node @state) node @state frame_storage=true) @compute @state)
    compute.push(store_word(word(8 node @state) scratch layouts.array_descriptor.stride node @state))
    let slot=snapshot(intrinsic_call('__alloca__' [word(8 node @state)] word_type node @state) @compute @state)
    compute.push(store_word(scratch slot 0 node @state))
    let checked=snapshot(string_runtime('_utf8_grapheme_scan' [bytes slot word(-1 node @state)] node @state) @compute @state)
    # Preserve the previous internal invalid-UTF-8 fallback. Ordinary typed
    # strings are valid; this path does not establish a new failure policy.
    let count=snapshot(put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type compare('__ge__' checked word(0 node @state) node @state) checked] @state)] word(0 node @state)] @state) @compute @state)
    compute.push(store_word(count value layouts.string_descriptor.grapheme_length node @state))
    compute.push(conditional(compare('__ne__' owner word(0 node @state) node @state) store_word(count owner 40 node @state) node @state))
    let known=put(hir.ShortCircuit[node.loc boolean 'and' compare('__ne__' owner word(0 node @state) node @state) compare('__ge__' read_word(owner 40 node @state) word(0 node @state) node @state)] @state)
    let adopt=store_word(read_word(owner 40 node @state) value layouts.string_descriptor.grapheme_length node @state)
    body.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) known adopt] @state)] sequence(compute node @state)] @state))
    return conditional(compare('__lt__' read_word(value layouts.string_descriptor.grapheme_length node @state) word(0 node @state) node @state) sequence(body node @state) node @state)
}

ensure_segmented = (value:addr node:hir.AST @state:State):>addr => {
    if not lazy_strings(state) return sequence([] node @state)
    let key='string:segment'
    let name=state.copy_helpers.get(key)
    let empty=types.primitive('void' @state.type_nodes)
    if name is? none {
        let generated=fresh('segment_string' @state)
        name=generated state.copy_helpers[key]=generated
        let word_type=types.primitive('int64' @state.type_nodes)
        let parameter=fresh('segmented' @state)
        let source=put(hir.ExpressedIdentifier[node.loc word_type parameter] @state)
        let body=ensure_segmented_body(source node @state)
        let signature=types.function_type([types.PosOrKwArg[parameter word_type]] [] none empty [] @state.type_nodes)
        let literal=put(hir.FunctionLiteral[node.loc signature [hir.Param[parameter word_type]] [] none empty body source=state.source_index] @state)
        state.generated.push(program.Function[generated literal])
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [value] empty node @state)
}
ensure_segmented_body = (value:addr node:hir.AST @state:State):>addr => {
    let word_type=types.primitive('int64' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let body:array<addr>=[]
    let length=snapshot(read_word(value layouts.string_descriptor.byte_length node @state) @body @state)
    let owner=snapshot(read_word(value layouts.string_descriptor.owner node @state) @body @state)
    # Another handle of the same backing may have segmented it already.
    let adopt:array<addr>=[store_word(read_word(owner 24 node @state) value layouts.string_descriptor.boundaries node @state) store_word(read_word(owner 40 node @state) value layouts.string_descriptor.grapheme_length node @state)]
    let compute:array<addr>=[]
    let size=snapshot(word_op('__mul__' word_op('__add__' length word(1 node @state) node @state) word(4 node @state) node @state) @compute @state)
    let table=snapshot(allocation(size node @state) @compute @state)
    let bytes=snapshot(byte_descriptor(read_word(value layouts.string_descriptor.data node @state) length node @state) @compute @state)
    let checked=snapshot(string_runtime('_utf8_boundaries_into' [bytes table] node @state) @compute @state)
    compute.push(release_block(bytes word(layouts.array_descriptor.size node @state) node @state))
    let valid=intrinsic_call('__ne__' [read_word(checked 0 node @state) word(0 node @state)] boolean node @state)
    let count=snapshot(put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type valid read_word(checked 8 node @state)] @state)] word(0 node @state)] @state) @compute @state)
    let checked_block=release_block(checked word(16 node @state) node @state)
    let shared_none=state.none_cell
    if shared_none isnt? none {
        let shared=put(hir.ExpressedIdentifier[node.loc word_type shared_none] @state)
        checked_block=conditional(intrinsic_call('__ne__' [checked shared] boolean node @state) checked_block node @state)
    }
    compute.push(checked_block)
    compute.push(store_word(table value layouts.string_descriptor.boundaries node @state))
    compute.push(store_word(count value layouts.string_descriptor.grapheme_length node @state))
    let record:array<addr>=[store_word(table owner 24 node @state) store_word(size owner 32 node @state) store_word(count owner 40 node @state)]
    compute.push(conditional(intrinsic_call('__ne__' [owner word(0 node @state)] boolean node @state) sequence(record node @state) node @state))
    let known=put(hir.ShortCircuit[node.loc boolean 'and' intrinsic_call('__ne__' [owner word(0 node @state)] boolean node @state) intrinsic_call('__ne__' [read_word(owner 24 node @state) word(0 node @state)] boolean node @state)] @state)
    let arm=put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) known sequence(adopt node @state)] @state)
    body.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] sequence(compute node @state)] @state))
    let pending=intrinsic_call('__eq__' [read_word(value layouts.string_descriptor.boundaries node @state) word(0 node @state)] boolean node @state)
    return conditional(pending sequence(body node @state) node @state)
}

segmented_string = (data:addr length:addr node:hir.AST optional:bool @state:State):>addr => {
    if not optional and lazy_strings(state) return lazy_string(data length node @state)
    if state.allocator isnt? none and '_utf8_boundaries_into' in? state.runtime_helpers return segmented_string_into(data length node optional @state)
    let binding=state.runtime_helpers.get('_utf8_boundaries')
    if binding is? none return reject(node 'runtime UTF-8 materialization needs the prelude segmentation helper' @state)
    let name=state.symbols.get(binding)
    if name is? none return reject(node 'the segmentation helper is absent from the lowered graph' @state)
    let prefix:array<addr>=[]
    data=snapshot(data @prefix @state) length=snapshot(length @prefix @state)
    let bytes=snapshot(byte_descriptor(data length node @state) @prefix @state)
    let checked=snapshot(intrinsic_call(name [bytes] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    # The helper borrows the byte view for this call. Its optional offsets
    # are owned scratch storage, independent of the final uint32 table.
    prefix.push(release_block(bytes word(layouts.array_descriptor.size node @state) node @state))
    let valid=intrinsic_call('__ne__' [read_word(checked 0 node @state) word(0 node @state)] types.primitive('bool' @state.type_nodes) node @state)
    let fits=intrinsic_call('__le__' [length word(uint32.max node @state)] types.primitive('bool' @state.type_nodes) node @state)
    valid=put(hir.ShortCircuit[node.loc types.primitive('bool' @state.type_nodes) 'and' fits valid] @state)
    let success:array<addr>=[]
    let offsets=snapshot(read_word(checked 8 node @state) @success @state)
    let count=snapshot(read_word(offsets layouts.array_descriptor.length node @state) @success @state)
    let boundaries=snapshot(allocation(word_op('__mul__' count word(4 node @state) node @state) node @state) @success @state)
    let cursor=snapshot(word(0 node @state) @success @state)
    let source=word_op('__add__' read_word(offsets 0 node @state) word_op('__mul__' cursor word(8 node @state) node @state) node @state)
    let target=word_op('__add__' boundaries word_op('__mul__' cursor word(4 node @state) node @state) node @state)
    let narrowed=put(hir.Transmute[node.loc types.primitive('uint32' @state.type_nodes) read_word(source 0 node @state)] @state)
    let write=intrinsic_call('__store_u32__' [narrowed target] types.primitive('void' @state.type_nodes) node @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let condition=intrinsic_call('__lt__' [cursor count] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition sequence([write increment] node @state)] @state)
    success.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    let result=string_memory(data length boundaries word_op('__sub__' count word(1 node @state) node @state) word(0 node @state) node @state)
    if optional {
        let cell=snapshot(allocation(word(16 node @state) node @state) @prefix @state)
        prefix.push(store_word(word(0 node @state) cell 0 node @state))
        prefix.push(store_word(word(0 node @state) cell 8 node @state))
        success.push(store_word(result cell 8 node @state))
        success.push(store_word(word(member_tag(types.primitive('string' @state.type_nodes) @state) node @state) cell 0 node @state))
        prefix.push(conditional(valid sequence(success node @state) node @state))
        prefix.push(conditional(intrinsic_call('__not__' [valid] types.primitive('bool' @state.type_nodes) node @state) release_block(data length node @state) node @state))
        prefix.push(cell)
    } else {
        # Both inputs of concatenation are already valid strings. A failed
        # validation here is unreachable, not an invented empty-string value.
        let yes=put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) true] @state)
        let forever=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) yes sequence([] node @state)] @state)
        let impossible=put(hir.Flow[node.loc types.primitive('never' @state.type_nodes) [forever] none] @state)
        success.push(result)
        let body=put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) success false] @state)
        let selected=put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) valid body] @state)
        prefix.push(put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [selected] impossible] @state))
    }
    # Preserve the selected result before destroying the helper's optional
    # cell and growable offsets array, on success and on invalid UTF-8.
    $runtime_assert prefix.length >? 0
    let selected=prefix.pop
    let output=snapshot(selected @prefix @state)
    let offsets_type=types.array_type(types.primitive('int64' @state.type_nodes) none @state.type_nodes)
    let checked_type=types.union([offsets_type types.primitive('none' @state.type_nodes)] @state.type_nodes)
    prefix.push(release_value(checked checked_type node @state))
    prefix.push(output)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_concat = (node:hir.StringConcat @state:State):>addr => {
    let prefix:array<addr>=[]
    let left=snapshot(owned_value(node.left @state) @prefix @state)
    let right=snapshot(owned_value(node.right @state) @prefix @state)
    let first=snapshot(read_word(left layouts.string_descriptor.byte_length node @state) @prefix @state)
    let second=snapshot(read_word(right layouts.string_descriptor.byte_length node @state) @prefix @state)
    let length=snapshot(word_op('__add__' first second node @state) @prefix @state)
    let data=snapshot(allocation(length node @state) @prefix @state)
    prefix.push(counted_bytes(string_data(left node @state) data word(0 node @state) first node @state))
    prefix.push(counted_bytes(string_data(right node @state) word_op('__add__' data first node @state) word(0 node @state) second node @state))
    prefix.push(string_runtime('_native_string_release' [left] node @state result_void=true))
    prefix.push(string_runtime('_native_string_release' [right] node @state result_void=true))
    prefix.push(segmented_string(data length node false @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# Formatting produces byte views first. Only the final joined buffer is
# segmented, so combining marks can cross interpolation fields too.
TextBytes:type = const [data:addr length:addr]
integer_text = (value:addr type:addr node:hir.AST @prefix:array<addr> @state:State):>TextBytes => {
    let layout=views.fixed_integer_layout(runtime_type(type node @state) state.type_nodes)
    if layout is? none return TextBytes[reject(node 'formatting a non-word integer' @state) word(0 node @state)]
    let uint=types.primitive('uint64' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let actual=snapshot(value @prefix @state)
    let negative=snapshot(if layout.signed intrinsic_call('__lt__' [actual put(hir.Integer[node.loc hir.node_at(state.nodes actual).value_type '0d' 0] @state)] boolean node @state) else put(hir.Bool[node.loc boolean false] @state) @prefix @state)
    let magnitude=snapshot(put(hir.Transmute[node.loc uint actual] @state) @prefix @state)
    let zero=put(hir.Integer[node.loc uint '0d' 0] @state)
    # Unsigned subtraction also represents abs(int64.min), whose magnitude
    # does not fit a signed word. No signed negation or division overflows.
    let negate=intrinsic_call('__sub__' [zero magnitude] uint node @state)
    prefix.push(conditional(negative put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) magnitude '=' negate] @state) node @state))
    # Formatting consumes these bytes inside this expression; they never
    # escape into the materialized string. Reserve fixed frame scratch.
    let buffer=snapshot(intrinsic_call('__alloca__' [word(21 node @state)] types.primitive('int64' @state.type_nodes) node @state) @prefix @state)
    let cursor=snapshot(word(21 node @state) @prefix @state)
    let body:array<addr>=[]
    body.push(put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__sub__' cursor word(1 node @state) node @state)] @state))
    let ten=put(hir.Integer[node.loc uint '0d' 10] @state)
    let digit=intrinsic_call('__mod__' [magnitude ten] uint node @state)
    let ascii=intrinsic_call('__add__' [digit put(hir.Integer[node.loc uint '0d' 48] @state)] uint node @state)
    let byte=put(hir.Transmute[node.loc types.primitive('uint8' @state.type_nodes) ascii] @state)
    body.push(intrinsic_call('__store_u8__' [byte word_op('__add__' buffer cursor node @state)] types.primitive('void' @state.type_nodes) node @state))
    body.push(put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) magnitude '=' intrinsic_call('__floordiv__' [magnitude ten] uint node @state)] @state))
    let more=intrinsic_call('__ne__' [magnitude zero] boolean node @state)
    let first=intrinsic_call('__eq__' [cursor word(21 node @state)] boolean node @state)
    let condition=put(hir.ShortCircuit[node.loc boolean 'or' first more] @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition sequence(body node @state)] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    let sign:array<addr>=[put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' word_op('__sub__' cursor word(1 node @state) node @state)] @state)]
    sign.push(intrinsic_call('__store_u8__' [put(hir.Integer[node.loc types.primitive('uint8' @state.type_nodes) '0d' 45] @state) word_op('__add__' buffer cursor node @state)] types.primitive('void' @state.type_nodes) node @state))
    prefix.push(conditional(negative sequence(sign node @state) node @state))
    return TextBytes[snapshot(word_op('__add__' buffer cursor node @state) @prefix @state) snapshot(word_op('__sub__' word(21 node @state) cursor node @state) @prefix @state)]
}
interpolated_string = (node:hir.InterpolatedString @state:State):>addr => {
    let prefix:array<addr>=[]
    let pieces:array<TextBytes>=[]
    let owners:array<addr>=[]
    let total=word(0 node @state)
    loop id in node.parts {
        let original=hir.node_at(state.input.nodes id)
        let plain=types.node_at(state.type_nodes types.unfold(types.strip_refinement(original.value_type state.type_nodes) state.type_nodes))
        let value=snapshot(owned_value(id @state) @prefix @state)
        if owned_string(original.value_type state) {owners.push(value)}
        let part:TextBytes=[word(0 node @state) word(0 node @state)]
        if string_type(original.value_type state) {
            if enum_members(original.value_type state) isnt? none {value=enum_read(value original.value_type types.primitive('string' @state.type_nodes) original @state)}
            part=TextBytes[snapshot(string_data(value node @state) @prefix @state) snapshot(read_word(value layouts.string_descriptor.byte_length node @state) @prefix @state)]
        } else if types.is_primitive(plain 'bool') {
            let word_type=types.primitive('int64' @state.type_nodes)
            let yes=put(hir.String[node.loc word_type 'true'] @state)
            let false_value=put(hir.String[node.loc word_type 'false'] @state)
            let pointer=put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type value yes] @state)] false_value] @state)
            let length=put(hir.Flow[node.loc word_type [put(hir.IfArm[node.loc word_type value word(4 node @state)] @state)] word(5 node @state)] @state)
            part=TextBytes[snapshot(pointer @prefix @state) snapshot(length @prefix @state)]
        } else {part=integer_text(value original.value_type original @prefix @state)}
        pieces.push(part)
        total=word_op('__add__' total part.length node @state)
    }
    total=snapshot(total @prefix @state)
    let buffer=snapshot(allocation(total node @state) @prefix @state)
    let cursor=word(0 node @state)
    loop part in pieces {
        prefix.push(counted_bytes(part.data word_op('__add__' buffer cursor node @state) word(0 node @state) part.length node @state))
        cursor=word_op('__add__' cursor part.length node @state)
    }
    loop owner in owners {prefix.push(string_runtime('_native_string_release' [owner] node @state result_void=true))}
    prefix.push(segmented_string(buffer total node false @state))
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
string_join = (call:hir.FunctionCall method:hir.ArrayMethod @state:State):>addr => {
    let prefix:array<addr>=[]
    let array=snapshot(owned_value(method.array @state) @prefix @state)
    let argument=call.kw_args.get('sep')
    if call.pos_args.length >? 0 {argument=call.pos_args[0]}
    let separator=if argument is? none string_literal(hir.String[call.loc types.string_literal('' @state.type_nodes) ''] @state) else owned_value(argument @state)
    separator=snapshot(separator @prefix @state)
    let separator_length=snapshot(read_word(separator layouts.string_descriptor.byte_length call @state) @prefix @state)
    let count=snapshot(read_word(array layouts.array_descriptor.length call @state) @prefix @state)
    let data=snapshot(read_word(array 0 call @state) @prefix @state)
    let total=snapshot(word(0 call @state) @prefix @state)
    let cursor=snapshot(word(0 call @state) @prefix @state)
    let piece=read_word(word_op('__add__' data word_op('__mul__' cursor word(8 call @state) call @state) call @state) 0 call @state)
    let length=read_word(piece layouts.string_descriptor.byte_length call @state)
    let empty=types.primitive('void' @state.type_nodes)
    let increment=put(hir.Assign[call.loc empty cursor '=' word_op('__add__' cursor word(1 call @state) call @state)] @state)
    let running=intrinsic_call('__lt__' [cursor count] types.primitive('bool' @state.type_nodes) call @state)
    let separated=intrinsic_call('__gt__' [cursor word(0 call @state)] types.primitive('bool' @state.type_nodes) call @state)
    let sum=put(hir.Assign[call.loc empty total '=' word_op('__add__' total length call @state)] @state)
    let gap=put(hir.Assign[call.loc empty total '=' word_op('__add__' total separator_length call @state)] @state)
    let measure=put(hir.LoopArm[call.loc empty running sequence([sum conditional(separated gap call @state) increment] call @state)] @state)
    prefix.push(put(hir.Flow[call.loc empty [measure] none] @state))
    let buffer=snapshot(allocation(total call @state) @prefix @state)
    prefix.push(put(hir.Assign[call.loc empty cursor '=' word(0 call @state)] @state))
    let offset=snapshot(word(0 call @state) @prefix @state)
    let separator_copy=counted_bytes(string_data(separator call @state) word_op('__add__' buffer offset call @state) word(0 call @state) separator_length call @state)
    let advance_gap=put(hir.Assign[call.loc empty offset '=' word_op('__add__' offset separator_length call @state)] @state)
    let copy=counted_bytes(string_data(piece call @state) word_op('__add__' buffer offset call @state) word(0 call @state) length call @state)
    let advance=put(hir.Assign[call.loc empty offset '=' word_op('__add__' offset length call @state)] @state)
    let fill=put(hir.LoopArm[call.loc empty running sequence([conditional(separated sequence([separator_copy advance_gap] call @state) call @state) copy advance increment] call @state)] @state)
    prefix.push(put(hir.Flow[call.loc empty [fill] none] @state))
    prefix.push(release_value(array hir.node_at(state.input.nodes method.array).value_type call @state))
    prefix.push(string_runtime('_native_string_release' [separator] call @state result_void=true))
    prefix.push(segmented_string(buffer total call false @state))
    return put(hir.Block[call.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
representation = (node:hir.RepresentationCast @state:State):>addr => {
    let source=hir.node_at(state.input.nodes node.expr)
    let source_type=types.node_at(state.type_nodes types.unfold(types.strip_refinement(source.value_type state.type_nodes) state.type_nodes))
    let target_array=array_type(node.value_type state)
    if source_type is? types.BinaryLiteralType and target_array isnt? none return array_copy(expression(node.expr @state) target_array node @state)
    let source_array=array_type(source.value_type state)
    let optional=views.optional_payload(node.value_type @state.type_nodes)
    let target=if optional is? none node.value_type else optional
    if source_array isnt? none and types.is_primitive(types.node_at(state.type_nodes source_array.element) 'uint8') and string_type(target state) {
        let prefix:array<addr>=[]
        let bytes=read_operand(node.expr @prefix @state)
        let source=snapshot(bytes.value @prefix @state)
        let length=snapshot(read_word(source layouts.array_descriptor.length node @state) @prefix @state)
        let data=snapshot(allocation(length node @state) @prefix @state)
        prefix.push(counted_bytes(read_word(source 0 node @state) data word(0 node @state) length node @state))
        if bytes.owner_type isnt? none {prefix.push(release_value(source bytes.owner_type node @state))}
        let result=snapshot(segmented_string(data length node optional isnt? none @state) @prefix @state)
        prefix.push(result)
        return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
    }
    # `array<grapheme> as string` (or any string-valued elements): the
    # concatenation of the elements, which is a join with no separator.
    if source_array isnt? none and optional is? none and string_type(target state) and string_type(source_array.element state) {
        let method=hir.ArrayMethod[node.loc node.value_type node.expr 'join']
        let call=hir.FunctionCall[node.loc node.value_type put(method @state) [] []]
        return string_join(call method @state)
    }
    # Both logical and representation conversions can consume a fresh union
    # result. Preserve its payload before retiring the source cell instead
    # of treating that result as a borrowed binding and abandoning it.
    if cell_members(source.value_type @state) isnt? none and temporary_owner(node.expr @state) return owned_cell_cast(node source.value_type @state)
    if enum_members(node.value_type state) isnt? none return enum_pack(expression(node.expr @state) source.value_type node.value_type node @state)
    if enum_members(source.value_type state) isnt? none return enum_read(expression(node.expr @state) source.value_type node.value_type node @state)
    if cell_members(node.value_type @state) isnt? none {
        # Packing is itself an ownership boundary. Constructors and calls
        # already own their payload; borrowing reads acquire a copy here.
        # Copying expression(...) indiscriminately leaked fresh payloads.
        if cell_members(source.value_type @state) is? none return cell_pack(owned_value(node.expr @state 'packed into a cell') source.value_type node.value_type node @state owned=true)
        return cell_pack(expression(node.expr @state) source.value_type node.value_type node @state)
    }
    # Checking may prove one alternative without a syntactic type-test read,
    # for example a known nonzero bigint packed by contextual conversion.
    # Preserve evaluation and load the already validated active payload.
    if cell_members(source.value_type @state) isnt? none return cell_payload(expression(node.expr @state) node.value_type node @state)
    if string_type(source.value_type state) {
        if string_type(node.value_type state) return expression(node.expr @state)
        let prefix:array<addr>=[]
        let receiver=read_operand(node.expr @prefix @state)
        let array=array_type(node.value_type state)
        let result:addr?=none
        if array isnt? none and types.is_primitive(types.node_at(state.type_nodes array.element) 'uint8') {result=string_bytes(receiver.value node @state)}
        if array isnt? none and types.is_primitive(types.node_at(state.type_nodes array.element) 'uint32') {result=string_scalars(receiver.value node @state)}
        if array isnt? none and (types.is_primitive(types.node_at(state.type_nodes array.element) 'grapheme') or types.is_primitive(types.node_at(state.type_nodes array.element) 'char')) {result=string_graphemes(receiver.value node @state)}
        if result isnt? none {
            let value=snapshot(result @prefix @state)
            if receiver.owner_type isnt? none {prefix.push(release_value(receiver.value receiver.owner_type node @state))}
            prefix.push(value)
            return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
        }
    }
    return reject(node 'this representation conversion' @state)
}

# Receiver and written arguments are captured before a mutation starts.
# A growable array keeps its descriptor identity while replacing its data;
# shrinking preserves capacity. Only live bytes are copied during growth.
read_word = (descriptor:addr offset:addr node:hir.AST @state:State):>addr => intrinsic_call('__load_i64__' [address(descriptor offset node @state)] types.primitive('int64' @state.type_nodes) node @state)
store_word = (value:addr descriptor:addr offset:addr node:hir.AST @state:State):>addr => intrinsic_call('__store_i64__' [value address(descriptor offset node @state)] types.primitive('void' @state.type_nodes) node @state)
sequence = (items:array<addr> node:hir.AST @state:State):>addr => put(hir.Block[node.loc types.primitive('void' @state.type_nodes) items false] @state)
conditional = (condition:addr body:addr node:hir.AST @state:State):>addr => {
    let arm=put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    return put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state)
}
counted_bytes = (source:addr target:addr start:addr stop:addr node:hir.AST @state:State backwards:bool=false):>addr => {
    let prefix:array<addr>=[]
    let cursor=snapshot(start @prefix @state)
    let offset=if backwards word_op('__sub__' cursor word(1 node @state) node @state) else cursor
    let byte=intrinsic_call('__load_u8__' [word_op('__add__' source offset node @state)] types.primitive('uint8' @state.type_nodes) node @state)
    let store=intrinsic_call('__store_u8__' [byte word_op('__add__' target offset node @state)] types.primitive('void' @state.type_nodes) node @state)
    let step=word_op(if backwards '__sub__' else '__add__' cursor word(1 node @state) node @state)
    let increment=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) cursor '=' step] @state)
    let body=sequence([store increment] node @state)
    let condition=intrinsic_call(if backwards '__gt__' else '__lt__' [cursor stop] types.primitive('bool' @state.type_nodes) node @state)
    let arm=put(hir.LoopArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) [arm] none] @state))
    return sequence(prefix node @state)
}
array_reserve = (descriptor:addr required:addr stride:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return reject(node 'array growth needs the prelude arena allocator' @state)
    let key="reserve_array:{stride}"
    let name=state.copy_helpers.get(key)
    let empty=types.primitive('void' @state.type_nodes)
    if name is? none {
        let generated=fresh('reserve_array' @state)
        name=generated state.copy_helpers[key]=generated
        let word_type=types.primitive('int64' @state.type_nodes)
        let source=fresh('descriptor' @state)
        let count=fresh('required' @state)
        let pointer=put(hir.ExpressedIdentifier[node.loc word_type source] @state)
        let needed=put(hir.ExpressedIdentifier[node.loc word_type count] @state)
        let body=array_reserve_body(pointer needed stride node @state)
        let signature=types.function_type([types.PosOrKwArg[source word_type] types.PosOrKwArg[count word_type]] [] none empty [] @state.type_nodes)
        let literal=put(hir.FunctionLiteral[node.loc signature [hir.Param[source word_type] hir.Param[count word_type]] [] none empty body source=state.source_index] @state)
        state.generated.push(program.Function[generated literal])
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name [descriptor required] empty node @state)
}
array_reserve_body = (descriptor:addr required:addr stride:addr node:hir.AST @state:State):>addr => {
    if state.allocator is? none return reject(node 'array growth needs the prelude arena allocator' @state)
    let prefix:array<addr>=[]
    let capacity=snapshot(read_word(descriptor layouts.array_descriptor.capacity node @state) @prefix @state)
    let body:array<addr>=[]
    let next=snapshot(word_op('__mul__' capacity word(2 node @state) node @state) @body @state)
    # Grow from a small floor: arrays built by pushes otherwise reallocate
    # at one, two and four elements before reaching a useful size.
    let tiny=intrinsic_call('__lt__' [next word(8 node @state)] types.primitive('bool' @state.type_nodes) node @state)
    body.push(conditional(tiny put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) next '=' word(8 node @state)] @state) node @state))
    let insufficient=intrinsic_call('__lt__' [next required] types.primitive('bool' @state.type_nodes) node @state)
    let choose=put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) next '=' required] @state)
    body.push(conditional(insufficient choose node @state))
    let data=snapshot(allocation(word_op('__mul__' next word(stride node @state) node @state) node @state) @body @state)
    let source=snapshot(read_word(descriptor layouts.array_descriptor.data node @state) @body @state)
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length node @state) @body @state)
    # New storage is disjoint. Move one stored element's bits at a time;
    # record/cell/array handles have word width and retain their ownership.
    # Other byte-copy sites may overlap and keep their directional loops.
    if stride in? [1 2 4 8] {
        let cursor=snapshot(word(0 node @state) @body @state)
        let offset=word_op('__mul__' cursor word(stride node @state) node @state)
        let value=intrinsic_call("__load_u{stride*8}__" [word_op('__add__' source offset node @state)] types.primitive("uint{stride*8}" @state.type_nodes) node @state)
        let stored=intrinsic_call("__store_u{stride*8}__" [value word_op('__add__' data offset node @state)] types.primitive('void' @state.type_nodes) node @state)
        body.push(while_loop(compare('__lt__' cursor length node @state) [stored set_local(cursor word_op('__add__' cursor word(1 node @state) node @state) node @state)] node @state))
    } else {body.push(counted_bytes(source data word(0 node @state) word_op('__mul__' length word(stride node @state) node @state) node @state))}
    # Descriptor ownership describes the data buffer independently of the
    # descriptor's own lifetime. Static/frame views must never be released.
    let release=state.runtime_helpers.get('_arena_release')
    if release isnt? none {
        let name=state.symbols.get(release)
        if name is? none return reject(node 'the arena release helper is absent from the lowered graph' @state)
        let owned=intrinsic_call('__eq__' [read_word(descriptor layouts.array_descriptor.owner node @state) word(1 node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let freed=intrinsic_call(name [source word_op('__mul__' capacity word(stride node @state) node @state)] types.primitive('void' @state.type_nodes) node @state)
        body.push(conditional(owned freed node @state))
    }
    body.push(store_word(data descriptor layouts.array_descriptor.data node @state))
    body.push(store_word(next descriptor layouts.array_descriptor.capacity node @state))
    let pinned=compare('__lt__' read_word(descriptor layouts.array_descriptor.owner node @state) word(0 node @state) node @state)
    let next_owner=put(hir.Flow[node.loc types.primitive('int64' @state.type_nodes) [put(hir.IfArm[node.loc types.primitive('int64' @state.type_nodes) pinned word(-1 node @state)] @state)] word(1 node @state)] @state)
    body.push(store_word(next_owner descriptor layouts.array_descriptor.owner node @state))
    let condition=intrinsic_call('__lt__' [capacity required] types.primitive('bool' @state.type_nodes) node @state)
    prefix.push(conditional(condition sequence(body node @state) node @state))
    return sequence(prefix node @state)
}
# Callers detach the descriptor before trimming it.
array_trim = (descriptor:addr length:addr element:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    if releasable(element @state) {
        let cursor=snapshot(length @prefix @state)
        let stop=snapshot(read_word(descriptor layouts.array_descriptor.length node @state) @prefix @state)
        let value=dict_element(descriptor cursor element node @state)
        prefix.push(loop_while(compare('__lt__' cursor stop node @state) [release_value(value element node @state) assign_value(cursor word_op('__add__' cursor word(1 node @state) node @state) node @state)] node @state))
    }
    prefix.push(store_word(length descriptor layouts.array_descriptor.length node @state))
    return sequence(prefix node @state)
}
push_helper = (element:addr stride:addr call:hir.AST @state:State):>string => {
    let key="push:{layout_key(element call @state)}"
    let existing=state.copy_helpers.get(key)
    if existing isnt? none return existing
    let generated=fresh('push' @state)
    state.copy_helpers[key]=generated
    let word_type=types.primitive('int64' @state.type_nodes)
    let void_type=types.primitive('void' @state.type_nodes)
    let value_type=runtime_type(element call @state)
    let descriptor_name=fresh('array' @state)
    let value_name=fresh('element' @state)
    let descriptor=put(hir.ExpressedIdentifier[call.loc word_type descriptor_name] @state)
    let value=put(hir.ExpressedIdentifier[call.loc value_type value_name] @state)
    let prefix:array<addr>=[]
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length call @state) @prefix @state)
    let new_length=snapshot(word_op('__add__' length word(1 call @state) call @state) @prefix @state)
    prefix.push(array_reserve(descriptor new_length stride call @state))
    let data=read_word(descriptor layouts.array_descriptor.data call @state)
    prefix.push(array_store(value word_op('__add__' data word_op('__mul__' length word(stride call @state) call @state) call @state) element call @state))
    prefix.push(store_word(new_length descriptor layouts.array_descriptor.length call @state))
    let body=put(hir.Block[call.loc void_type prefix false] @state)
    let signature=types.function_type([types.PosOrKwArg[descriptor_name word_type] types.PosOrKwArg[value_name value_type]] [] none void_type [] @state.type_nodes)
    let literal=put(hir.FunctionLiteral[call.loc signature [hir.Param[descriptor_name word_type] hir.Param[value_name value_type]] [] none void_type body source=state.source_index] @state)
    state.generated.push(program.Function[generated literal])
    return generated
}
array_method_call = (call:hir.FunctionCall method:hir.ArrayMethod @state:State):>addr => {
    if method.name =? 'join' return string_join(call method @state)
    if method.name =? 'sort' return array_sort(call method @state)
    if method.name not in? ['push' 'pop' 'clear' 'truncate' 'reserve' 'insert'] return reject(call "array {method.name} lowering" @state)
    let type=array_type(hir.node_at(state.input.nodes method.array).value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(call layout.detail @state)
    let prefix:array<addr>=[]
    let route=array_route(method.array @prefix @state)
    let descriptor=detach_array(route type.element call @prefix @state)
    let arguments:dict<string addr>=[]
    let names:array<string>=[]
    if method.name in? ['push' 'insert'] {names.push('value')}
    if method.name in? ['pop' 'insert'] {names.push('idx')}
    if method.name in? ['truncate' 'reserve'] {names.push('count')}
    loop i in 0.. and i <? call.pos_args.length {
        $runtime_assert i <? names.length
        arguments[names[i]]=snapshot(owned_value(call.pos_args[i] @state 'passed to a call') @prefix @state)
    }
    loop [name argument] in call.kw_args {arguments[name]=snapshot(owned_value(argument @state 'passed to a call') @prefix @state)}
    let void_type=types.primitive('void' @state.type_nodes)
    if method.name =? 'push' and state.allocator isnt? none {
        # One generated helper per element type grows the array and stores
        # the element, instead of five lines at every push site.
        $runtime_assert 'value' in? arguments
        let helper=push_helper(type.element layout.size call @state)
        prefix.push(intrinsic_call(helper [descriptor arguments['value']] void_type call @state))
        prefix.push(put(hir.Void[call.loc void_type] @state))
        return put(hir.Block[call.loc runtime_type(call.value_type call @state) prefix false] @state)
    }
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length call @state) @prefix @state)
    let new_length=length
    let result:addr?=none
    if method.name =? 'reserve' {
        $runtime_assert 'count' in? arguments
        prefix.push(array_reserve(descriptor arguments['count'] layout.size call @state))
    }
    else if method.name =? 'clear' {new_length=word(0 call @state) prefix.push(array_trim(descriptor new_length type.element call @state))}
    else if method.name =? 'truncate' {
        $runtime_assert 'count' in? arguments
        let condition=intrinsic_call('__lt__' [arguments['count'] length] types.primitive('bool' @state.type_nodes) call @state)
        let store=array_trim(descriptor arguments['count'] type.element call @state)
        prefix.push(conditional(condition store call @state))
    } else if method.name =? 'push' or method.name =? 'insert' {
        new_length=snapshot(word_op('__add__' length word(1 call @state) call @state) @prefix @state)
        prefix.push(array_reserve(descriptor new_length layout.size call @state))
        let data=snapshot(read_word(descriptor layouts.array_descriptor.data call @state) @prefix @state)
        let index=arguments.get('idx')
        if method.name =? 'push' {index=length}
        $runtime_assert index isnt? none
        let offset=word_op('__mul__' index word(layout.size call @state) call @state)
        if method.name =? 'insert' {
            let bytes=word_op('__mul__' length word(layout.size call @state) call @state)
            prefix.push(counted_bytes(data address(data layout.size call @state) bytes offset call @state backwards=true))
        }
        $runtime_assert 'value' in? arguments
        prefix.push(array_store(arguments['value'] word_op('__add__' data offset call @state) type.element call @state))
    } else {
        new_length=snapshot(word_op('__sub__' length word(1 call @state) call @state) @prefix @state)
        let index=arguments.get('idx')
        if index is? none {index=new_length}
        $runtime_assert index isnt? none
        let data=snapshot(read_word(descriptor layouts.array_descriptor.data call @state) @prefix @state)
        let offset=word_op('__mul__' index word(layout.size call @state) call @state)
        result=snapshot(array_load(word_op('__add__' data offset call @state) type.element call @state) @prefix @state)
        let start=word_op('__add__' offset word(layout.size call @state) call @state)
        let stop=word_op('__mul__' length word(layout.size call @state) call @state)
        prefix.push(counted_bytes(data word_op('__sub__' data word(layout.size call @state) call @state) start stop call @state))
    }
    if method.name not in? ['truncate' 'reserve'] {prefix.push(store_word(new_length descriptor layouts.array_descriptor.length call @state))}
    if result is? none {prefix.push(put(hir.Void[call.loc void_type] @state))}
    else {prefix.push(result)}
    return put(hir.Block[call.loc runtime_type(call.value_type call @state) prefix false] @state)
}

# Sort records carry a normalized unsigned key and the original element bits.
# Keys are evaluated once, in source order, before rearranging the array.
# Stable insertion keeps equal keys in their original order in either direction.
# The hosted large-array radix path can share this record format in a later
# optimization; the native path currently uses insertion for every length.
sort_record = (base:addr index:addr node:hir.AST @state:State):>addr => word_op('__add__' base word_op('__mul__' index word(16 node @state) node @state) node @state)
assign_value = (target:addr value:addr node:hir.AST @state:State):>addr => put(hir.Assign[node.loc types.primitive('void' @state.type_nodes) target '=' value] @state)
loop_while = (condition:addr body:array<addr> node:hir.AST @state:State):>addr => {
    let type=types.primitive('void' @state.type_nodes)
    let arm=put(hir.LoopArm[node.loc type condition sequence(body node @state)] @state)
    return put(hir.Flow[node.loc type [arm] none] @state)
}
sort_key = (value:addr type:addr mask:addr node:hir.AST @state:State):>addr => {
    let layout=views.fixed_integer_layout(type state.type_nodes)
    if layout is? none return reject(node 'a sort key must return a fixed-width integer' @state)
    let unsigned=types.primitive('uint64' @state.type_nodes)
    let wide=put(hir.ValueCast[node.loc types.primitive(if layout.signed 'int64' else 'uint64' @state.type_nodes) value] @state)
    let key=put(hir.Transmute[node.loc unsigned wide] @state)
    if layout.signed {
        let sign=put(hir.Transmute[node.loc unsigned word(-9223372036854775808 node @state)] @state)
        key=intrinsic_call('__xor__' [key sign] unsigned node @state)
    }
    return intrinsic_call('__xor__' [key mask] unsigned node @state)
}
array_sort = (call:hir.FunctionCall method:hir.ArrayMethod @state:State):>addr => {
    let type=array_type(hir.node_at(state.input.nodes method.array).value_type state)
    $runtime_assert type isnt? none
    let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
    if layout is? layouts.Pending return reject(call layout.detail @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let unsigned=types.primitive('uint64' @state.type_nodes)
    let prefix:array<addr>=[]
    let route=array_route(method.array @prefix @state)
    let descriptor=detach_array(route type.element call @prefix @state)
    let key_function:addr?=none
    let key_signature:types.FunctionType?=none
    let key_type=type.element
    let reverse=put(hir.Bool[call.loc boolean false] @state)
    # Options are ordinary arguments: even an empty array evaluates them.
    loop [name argument] in call.kw_args {
        let value=snapshot(expression(argument @state) @prefix @state)
        if name =? 'reverse' {reverse=value}
        else if name =? 'key' {
            key_function=value
            let signature=types.node_at(state.type_nodes types.strip_refinement(hir.node_at(state.input.nodes argument).value_type state.type_nodes))
            if signature isnt? types.FunctionType return reject(call 'a sort key must be a single function' @state)
            key_signature=signature key_type=signature.ret
        }
    }
    if views.fixed_integer_layout(key_type state.type_nodes) is? none return reject(call 'a sort key must return a fixed-width integer' @state)
    let length=snapshot(read_word(descriptor layouts.array_descriptor.length call @state) @prefix @state)
    let data=snapshot(read_word(descriptor layouts.array_descriptor.data call @state) @prefix @state)
    let size=snapshot(word_op('__mul__' length word(16 call @state) call @state) @prefix @state)
    let records=snapshot(allocation(size call @state) @prefix @state)
    let mask=snapshot(put(hir.Transmute[call.loc unsigned word(0 call @state)] @state) @prefix @state)
    let descending=put(hir.Transmute[call.loc unsigned word(-1 call @state)] @state)
    prefix.push(conditional(reverse assign_value(mask descending call @state) call @state))
    let index=snapshot(word(0 call @state) @prefix @state)
    let record=sort_record(records index call @state)
    let element_pointer=word_op('__add__' data word_op('__mul__' index word(layout.size call @state) call @state) call @state)
    let building:array<addr>=[]
    let element=snapshot(array_load(element_pointer type.element call @state) @building @state)
    let key=element
    if key_function isnt? none and key_signature isnt? none {
        let args:array<addr>=[]
        let first=true
        loop parameter in key_signature.pos_or_kw {
            let argument:addr?=none
            if first {argument=snapshot(owned_copy(element type.element call @state shared=true) @building @state)}
            call_slot(argument parameter.value_type parameter.required call @args @state)
            first=false
        }
        loop parameter in key_signature.kw_only {call_slot(none parameter.value_type parameter.required call @args @state)}
        key=snapshot(put(hir.FunctionCall[call.loc runtime_type(key_type call @state) key_function args []] @state) @building @state)
    }
    let normalized=sort_key(key key_type mask call @state)
    building.push(store_word(put(hir.Transmute[call.loc types.primitive('int64' @state.type_nodes) normalized] @state) record 0 call @state))
    building.push(array_store(element address(record 8 call @state) type.element call @state))
    building.push(assign_value(index word_op('__add__' index word(1 call @state) call @state) call @state))
    prefix.push(loop_while(intrinsic_call('__lt__' [index length] boolean call @state) building call @state))

    let outer=snapshot(word(1 call @state) @prefix @state)
    let inserting:array<addr>=[]
    let held_record=sort_record(records outer call @state)
    let held_key=snapshot(read_word(held_record 0 call @state) @inserting @state)
    let held_element=snapshot(read_word(held_record 8 call @state) @inserting @state)
    let inner=snapshot(outer @inserting @state)
    let previous=word_op('__sub__' inner word(1 call @state) call @state)
    let before=sort_record(records previous call @state)
    let current=sort_record(records inner call @state)
    let before_key=put(hir.Transmute[call.loc unsigned read_word(before 0 call @state)] @state)
    let comparison=intrinsic_call('__gt__' [before_key put(hir.Transmute[call.loc unsigned held_key] @state)] boolean call @state)
    let condition=put(hir.ShortCircuit[call.loc boolean 'and' intrinsic_call('__gt__' [inner word(0 call @state)] boolean call @state) comparison] @state)
    let moving:array<addr>=[
        store_word(read_word(before 0 call @state) current 0 call @state)
        store_word(read_word(before 8 call @state) current 8 call @state)
        assign_value(inner previous call @state)
    ]
    inserting.push(loop_while(condition moving call @state))
    inserting.push(store_word(held_key current 0 call @state))
    inserting.push(store_word(held_element current 8 call @state))
    inserting.push(assign_value(outer word_op('__add__' outer word(1 call @state) call @state) call @state))
    prefix.push(loop_while(intrinsic_call('__lt__' [outer length] boolean call @state) inserting call @state))

    prefix.push(assign_value(index word(0 call @state) call @state))
    let restored=array_load(address(record 8 call @state) type.element call @state)
    prefix.push(loop_while(intrinsic_call('__lt__' [index length] boolean call @state) [
        array_store(restored element_pointer type.element call @state)
        assign_value(index word_op('__add__' index word(1 call @state) call @state) call @state)
    ] call @state))
    # Record movement transfers existing handles. Only the scratch buffer is
    # owned by this operation; array elements retain their existing owners.
    let release=state.runtime_helpers.get('_arena_release')
    if state.allocator isnt? none and release isnt? none {
        let name=state.symbols.get(release)
        if name is? none return reject(call 'the arena release helper is absent from the lowered graph' @state)
        prefix.push(intrinsic_call(name [records size] types.primitive('void' @state.type_nodes) call @state))
    }
    return sequence(prefix call @state)
}

# Record fields embed other records, but store arrays and callable values as
# handles. Copy fields through the selected dynamic brand's schema rather
# than blindly reading the maximum reserved size of a parent: a smaller
# child need not contain the storage reserved for one of its siblings.
# Boolean storage queries inspect the arena in place. Returning an optional
# ObjectType just to test for presence would copy its fields, methods and
# identity strings, then discard all of that metadata at every value use.
object_valued = (id:addr state:State):>bool => {
    let plain=views.structural_base(id state.type_nodes)
    $runtime_assert plain <? state.type_nodes.entries.length
    return state.type_nodes.entries[plain] is? types.ObjectType
}
array_valued = (id:addr state:State):>bool => {
    let plain=views.structural_base(id state.type_nodes)
    $runtime_assert plain <? state.type_nodes.entries.length
    return state.type_nodes.entries[plain] is? types.ArrayType
}
object_type = (id:addr state:State):>types.ObjectType? => {
    let type=types.node_at(state.type_nodes views.structural_base(id state.type_nodes))
    return if type is? types.ObjectType type else none
}
aggregate = (id:addr state:State):>bool => {
    let plain=types.node_at(state.type_nodes views.structural_base(id state.type_nodes))
    return (plain is? types.TypeOr and enum_members(id state) is? none) or string_type(id state) or array_valued(id state) or object_valued(id state)
}
object_layout = (id:addr node:hir.AST @state:State):>layouts.Record => {
    # Lowering only appends types, and the compilation's brand registry is
    # already complete. A normalized record's offsets cannot change while
    # legalizing another expression; retain them across loads and copy helpers.
    let plain=views.structural_base(id state.type_nodes)
    let cached=state.record_layouts.get(plain)
    if cached isnt? none return cached
    let layout=layouts.record(plain state.layout_context @state.type_nodes)
    if layout is? layouts.Pending {reject(node layout.detail @state); return layouts.Record[1 1 []]}
    state.record_layouts[plain]=layout
    return layout
}
brand_number = (name:string state:State):>brands.NumberedBrand? => state.brand_numbers.get(name)
field_pointer = (node:hir.MemberAccess @state:State writable:bool=false detach:bool=true):>addr => {
    let value=if writable write_route(node.value @state detach=detach) else expression(node.value @state)
    return field_address(value node @state)
}
field_address = (value:addr node:hir.MemberAccess @state:State):>addr => {
    let type=hir.node_at(state.input.nodes node.value).value_type
    let layout=object_layout(type node @state)
    let offset=layout.offsets.get(node.name)
    if offset is? none return reject(node 'a checked field is absent from its record layout' @state)
    return address(value offset node @state)
}
field_read = (pointer:addr type:addr node:hir.AST @state:State):>addr => {
    if cell_members(type @state) isnt? none or object_valued(type state) return pointer
    if array_valued(type state) return read_word(pointer 0 node @state)
    let plain=types.node_at(state.type_nodes types.strip_refinement(type state.type_nodes))
    if plain is? types.FunctionType {
        return put(hir.Transmute[node.loc runtime_type(type node @state) read_word(pointer 0 node @state)] @state)
    }
    return array_load(pointer type node @state)
}
field_write = (pointer:addr value:addr type:addr node:hir.AST @state:State):>addr => {
    if cell_members(type @state) isnt? none return cell_write(pointer value type node @state)
    if object_valued(type state) return object_write(pointer value type node @state)
    if array_valued(type state) return store_word(value pointer 0 node @state)
    let plain=types.node_at(state.type_nodes types.strip_refinement(type state.type_nodes))
    if plain is? types.FunctionType {
        let word=put(hir.Transmute[node.loc types.primitive('int64' @state.type_nodes) value] @state)
        return store_word(word pointer 0 node @state)
    }
    return array_store(value pointer type node @state)
}

# Return-by-value remains the fallback. The initial projection rule accepts
# one terminal route read, preserving every preceding guard and side effect.
# It does not select a field out of a constructor or change an indirect call.
getter_read = (body:addr nodes:array<hir.AST>):>addr? => {
    let terminal=body
    let node=hir.node_at(nodes terminal)
    let prefix_nodes:set<addr>=set[]
    if node is? hir.Block {
        if node.items.length =? 0 return none
        terminal=node.items[node.items.length-1]
        let pending:array<addr>=[]
        loop i in 0.. and i <? node.items.length-1 {pending.push(node.items[i])}
        loop pending.length >? 0 {
            let child=pending.pop
            if child in? prefix_nodes continue
            prefix_nodes.add(child)
            let current=hir.node_at(nodes child)
            if current is? hir.FunctionLiteral continue
            if current is? hir.Return return none
            hir.push_children(current @pending)
        }
        node=hir.node_at(nodes terminal)
        # A block's implicit aggregate result needs its own type rewrite;
        # keep that shape on the ordinary path in this first native slice.
        if node isnt? hir.Return return none
    }
    if node is? hir.Return {
        if node.item is? none return none
        terminal=node.item
        node=hir.node_at(nodes terminal)
    }
    # A wrapper returning another getter's call is itself a getter when the
    # inner call's route argument is a route of this function's parameter;
    # getter_route resolves that below. Ordinary getters return a route.
    if node isnt? hir.Index|hir.MemberAccess|hir.ExpressedIdentifier|hir.FunctionCall return none
    # HIR is an arena and may share nodes. The result override must not also
    # change a use of this record read in the unchanged prefix.
    if terminal in? prefix_nodes return none
    let pending=hir.children(node)
    loop pending.length >? 0 {
        let current=hir.node_at(nodes pending.pop)
        if current is? hir.FunctionLiteral continue
        if current is? hir.Return return none
        hir.push_children(current @pending)
    }
    return terminal
}
# Follow field syntax only; indices and methods retain their own evaluation
# rules. Ordinary field reads inspect the input arena without copying nodes.
projection_call = (id:addr nodes:array<hir.AST>):>addr? => {
    let current=id
    loop true {
        $runtime_assert current <? nodes.length
        const node=@nodes[current]
        if node is? hir.MemberAccess {current=node.value continue}
        return if node is? hir.FunctionCall current else none
    }
}
scalar_getter_projection = (node:hir.MemberAccess call_id:addr @state:State):>ScalarProjection? => {
    let call=hir.node_at(state.input.nodes call_id)
    if call isnt? hir.FunctionCall return none
    let direct=captures.resolve(call.func call.selected_method_index state.capture_plan state.input.nodes)
    if direct is? none return none
    let literal=hir.node_at(state.input.nodes direct)
    if literal isnt? hir.FunctionLiteral or literal.object_receiver or literal.rettype not=? call.value_type return none
    let reverse:array<hir.MemberAccess>=[node]
    let current=node.value
    loop current not=? call_id {
        let member=hir.node_at(state.input.nodes current)
        if member isnt? hir.MemberAccess return none
        reverse.push(member) current=member.value
    }
    let fields:array<ProjectionField>=[]
    let owner=literal.rettype
    let key="{direct}:"
    loop reverse.length >? 0 {
        let member=reverse.pop
        let record=object_type(owner state)
        if record is? none or hir.node_at(state.input.nodes member.value).value_type not=? owner return none
        let field=types.object_field(record member.name)
        if field is? none or field.value_type not=? member.value_type return none
        fields.push(ProjectionField[member.name owner member.value_type])
        key+="{member.name.length}:{member.name}"
        owner=member.value_type
    }
    let array=array_type(node.value_type state)
    let owned_handle=state.allocator isnt? none and (owned_string(node.value_type state) or array isnt? none and array.length is? none)
    if not types.is_primitive(types.node_at(state.type_nodes node.value_type) 'bool') and views.fixed_integer_layout(node.value_type state.type_nodes) is? none and not owned_handle return none
    if direct not in? state.getter_reads {state.getter_reads[direct]=getter_read(literal.body state.input.nodes)}
    let read=state.getter_reads.get(direct default=none)
    if read is? none return none
    let existing=state.scalar_projections.get(key)
    if existing isnt? none return existing
    let projection=ScalarProjection[direct read fields node.value_type fresh('project' @state)]
    state.scalar_projections[key]=projection
    state.pending_projections.push(projection)
    return projection
}

required_view_error = (node:hir.Declare @state:State):>addr => {
    let pointers:array<Pointer>=[]
    let owner=borrowing.route(node.expr state.input.nodes)
    let within:set<addr>=set[]
    let scope=if node.binding_id is? none none else state.view_scopes.get(node.binding_id)
    if scope isnt? none {
        let pending=if node.binding_id is? none [scope] else state.view_regions.get(node.binding_id [scope])
        loop pending.length >? 0 {
            let id=pending.pop
            if id in? within continue
            within.add(id)
            let value=hir.node_at(state.input.nodes id)
            if value isnt? hir.FunctionLiteral {hir.push_children(value @pending)}
        }
    }
    if owner isnt? none {
        loop write in state.view_writes {
            if scope isnt? none and write not in? within continue
            let current=hir.node_at(state.input.nodes write)
            let conflict=false
            loop target in captures.write_targets(current state.input.nodes) {
                let written=borrowing.route(target state.input.nodes)
                if written isnt? none and borrowing.overlap(owner written) {conflict=true}
            }
            if conflict {pointers.push(Pointer[current.loc 'this write or mutable place conflicts with the required view']) break}
        }
    }
    let notes:array<string>=['A required view needs stable storage through its last use, including derived aliases; captured or exposed owners need additional lifetime evidence.']
    let value=hir.node_at(state.input.nodes node.expr)
    let stored=types.unfold(types.strip_refinement(stored_type(node.expr state) state.type_nodes) state.type_nodes)
    let read=types.unfold(types.strip_refinement(value.value_type state.type_nodes) state.type_nodes)
    if not borrow_storage_matches(stored read state.type_nodes) {notes.push("Stored type: {types.describe(stored state.type_nodes)}; read type: {types.describe(read state.type_nodes)}.")}
    if node.binding_id isnt? none {
        if node.binding_id in? state.boxed {notes.push('The view binding has an exposed address.')}
        if node.binding_id not in? state.stable_bindings {notes.push('The view binding is written, captured, or exposed.')}
        if node.binding_id in? state.mutated_roots {notes.push('The view binding is used as mutable storage.')}
    }
    if owner isnt? none and not borrowing.stable_owner(owner state.stable_bindings state.stable_parameters) {notes.push('The source owner is not proven read-only and nonescaping.')}
    pointers.push(Pointer[node.loc "`{node.name}` requires stable borrowed storage"])
    if state.problem is? none {
        state.problem=Error[srcfile=state.source title='cannot prove required local view' pointers=pointers hint='use `.copy()` for an independent value, or keep the owner stable' notes=notes]
    }
    return put(hir.Void[node.loc types.primitive('void' @state.type_nodes)] @state)
}

# A local initialized from a field or element route of storage that stays
# read-only for the whole function is itself a view of that storage: no copy
# on declaration and no release at scope exit. Both the local and the route's
# owner must be stable (never written, rebound, captured or exposed as a
# place), and the read must keep the stored representation. Escapes through
# returns, stores and ordinary arguments still copy from the view as usual.
# Every native array is a descriptor. An observed length changes its facts,
# not its element encoding or the handle borrowed by a local declaration.
borrow_storage_matches = (stored:addr read:addr nodes:types.Table):>bool => {
    let source=types.unfold(types.strip_refinement(stored nodes) nodes)
    let target=types.unfold(types.strip_refinement(read nodes) nodes)
    if types.same_type(source target nodes) return true
    let a=types.node_at(nodes source)
    let b=types.node_at(nodes target)
    return a is? types.ArrayType and b is? types.ArrayType and types.same_type(a.element b.element nodes)
}
borrowed_route_local = (node:hir.Declare @state:State):>bool => {
    if state.allocator is? none and not node.view return false
    let expr=hir.node_at(state.input.nodes node.expr)
    if expr isnt? hir.Index|hir.MemberAccess|hir.DictLookup and not (node.view and expr is? hir.ExpressedIdentifier) return false
    # Proven array entries hand out the stored descriptor, just as records
    # expose their stored block. Optional/fallback lookups may rebuild storage.
    if expr is? hir.DictLookup and not object_valued(expr.value_type state) {
        if not expr.proven or types.node_at(state.type_nodes types.strip_refinement(expr.value_type state.type_nodes)) isnt? types.ArrayType return false
    }
    # An unproven lookup may select a temporary fallback. Its lifetime is
    # independent of the dictionary's, so a stable dictionary is insufficient.
    if expr is? hir.DictLookup and expr.default isnt? none and not expr.proven return false
    # An explicit string/union view may use an immediate enum word. A
    # stable read then needs no owning storage or release in either form.
    if not node.view and not releasable(expr.value_type @state) return false
    if node.binding_id is? none return false
    if node.binding_id in? state.boxed return false
    if node.binding_id not in? state.stable_bindings return false
    if node.binding_id in? state.mutated_roots return false
    # Checked facts restrict values without changing the storage being read.
    # Do not confuse a refined word/aggregate with a representation conversion.
    let read_type=types.unfold(types.strip_refinement(expr.value_type state.type_nodes) state.type_nodes)
    if node.annotation isnt? none and not borrow_storage_matches(node.annotation read_type state.type_nodes) return false
    if not borrow_storage_matches(stored_type(node.expr state) read_type state.type_nodes) return false
    if node.expr in? state.array_snapshots return false
    let route=borrowing.route(node.expr state.input.nodes)
    if route is? none return false
    # Taking an owner's address for a later call does not invalidate an
    # earlier view. The whole-function or scoped proof below checks storage
    # stability; expression lowering loads the current box value.
    return borrowing.stable_owner(route state.stable_bindings state.stable_parameters) or node.binding_id in? state.scoped_views
}
mark_mutated = (id:addr @mutated:set<addr> state:State):>void => {
    let source=borrowing.route(id state.input.nodes)
    if source isnt? none {mutated.add(source.binding)}
}
# The storage route a getter's result refers to, in terms of the getter's
# own parameters. A terminal call to another getter contributes the route of
# the argument bound to that getter's route parameter, provided the call
# borrows it. Depth is bounded so recursive wrappers stay finite.
getter_route = (read:addr depth:addr @state:State):>borrowing.Route? => {
    let node=hir.node_at(state.input.nodes read)
    if node isnt? hir.FunctionCall return borrowing.route(read state.input.nodes)
    if depth >? 4 or not object_valued(node.value_type state) return none
    let direct=captures.resolve(node.func node.selected_method_index state.capture_plan state.input.nodes)
    if direct is? none return none
    let literal=hir.node_at(state.input.nodes direct)
    if literal isnt? hir.FunctionLiteral or literal.object_receiver or literal.rettype not=? node.value_type return none
    let capture=state.capture_plan.functions.get(direct)
    if capture is? none or capture.captures.length >? 0 return none
    if direct not in? state.getter_reads {state.getter_reads[direct]=getter_read(literal.body state.input.nodes)}
    let inner=state.getter_reads.get(direct default=none)
    if inner is? none or inner in? state.array_snapshots return none
    let inner_route=getter_route(inner depth+1 @state)
    if inner_route is? none return none
    let parameter:hir.Param?=none
    loop candidate in parameters(literal) {if candidate.binding_id isnt? none and candidate.binding_id =? inner_route.binding {parameter=candidate}}
    if parameter is? none or parameter.place or parameter is? hir.BoundParam return none
    let pairs=effects.pair_arguments(node literal)
    if pairs is? none return none
    let source:addr?=none
    loop pair in pairs {if pair.parameter isnt? none and pair.parameter =? inner_route.binding {source=pair.argument}}
    if source is? none or source not in? state.borrowed_arguments.get(read set[]) return none
    let argument=hir.node_at(state.input.nodes source)
    if argument isnt? hir.ExpressedIdentifier|hir.MemberAccess return none
    if argument.value_type not=? parameter.value_type return none
    return borrowing.route(source state.input.nodes)
}
# The callee/argument half of a getter borrow: a direct, capture-free getter
# returning a record route of one read-only parameter, called with a route
# argument whose owner stays stable for the whole calling function.
getter_borrow_projection = (id:addr call:hir.FunctionCall @state:State):>ScalarProjection? => {
    if not object_valued(call.value_type state) return none
    let direct=captures.resolve(call.func call.selected_method_index state.capture_plan state.input.nodes)
    if direct is? none return none
    let literal=hir.node_at(state.input.nodes direct)
    if literal isnt? hir.FunctionLiteral or literal.object_receiver or literal.rettype not=? call.value_type return none
    let capture=state.capture_plan.functions.get(direct)
    if capture is? none or capture.captures.length >? 0 return none
    if direct not in? state.getter_reads {state.getter_reads[direct]=getter_read(literal.body state.input.nodes)}
    let read=state.getter_reads.get(direct default=none)
    if read is? none or read in? state.array_snapshots return none
    let route=getter_route(read 0 @state)
    if route is? none or route.binding not in? state.stable_bindings return none
    let parameter:hir.Param?=none
    loop candidate in parameters(literal) {if candidate.binding_id isnt? none and candidate.binding_id =? route.binding {parameter=candidate}}
    if parameter is? none or parameter.place or parameter is? hir.BoundParam return none
    let pairs=effects.pair_arguments(call literal)
    if pairs is? none return none
    let source:addr?=none
    loop pair in pairs {if pair.parameter isnt? none and pair.parameter =? route.binding {source=pair.argument}}
    if source is? none or source not in? state.borrowed_arguments.get(id set[]) return none
    let argument=hir.node_at(state.input.nodes source)
    if argument isnt? hir.ExpressedIdentifier|hir.MemberAccess return none
    let owner=borrowing.route(source state.input.nodes)
    if owner is? none or not borrowing.stable_owner(owner state.stable_bindings state.stable_parameters) return none
    if argument.value_type not=? parameter.value_type return none
    let key="borrow:{direct}"
    let existing=state.scalar_projections.get(key)
    if existing isnt? none return existing
    let projection=ScalarProjection[direct read [] literal.rettype fresh('borrow' @state) true]
    state.scalar_projections[key]=projection
    state.pending_projections.push(projection)
    return projection
}
# Keep a getter's returned record as a local view only when both the view
# binding and its owner remain read-only for their whole lexical function.
# Ordinary calls/returns still establish value boundaries and copy as needed.
borrowed_getter_local = (node:hir.Declare @state:State):>ScalarProjection? => {
    if node.binding_id is? none or node.binding_id not in? state.stable_bindings or node.binding_id in? state.boxed return none
    $runtime_assert node.expr <? state.input.nodes.length
    if state.input.nodes[node.expr] isnt? hir.FunctionCall return none
    let call=hir.node_at(state.input.nodes node.expr)
    $runtime_assert call is? hir.FunctionCall
    if node.annotation isnt? none and node.annotation not=? call.value_type return none
    return getter_borrow_projection(node.expr call @state)
}
# Exact field operations and dynamic-family dispatch have different sharing
# boundaries. A family's copy/release calls one field helper for its selected
# brand; embedding every child's fields at every parent view expands the same
# work many times. Helpers operate on existing storage and never free its
# enclosing record. Arena-free code keeps its frame allocations in the caller.
RecordOperation:type = 'copy_fields' | 'write_record' | 'release_fields' | 'release_record' | 'release_cell'
record_operation_body = (operation:RecordOperation arguments:array<addr> type:addr node:hir.AST @state:State):>addr => {
    $runtime_assert arguments.length >? 0
    if operation is? 'copy_fields'|'write_record' {
        $runtime_assert arguments.length =? 2
        if operation =? 'copy_fields' return object_fields_body(arguments[0] arguments[1] type node @state)
        return object_write_body(arguments[0] arguments[1] type node @state)
    }
    if operation =? 'release_fields' return release_record_fields_body(arguments[0] type node @state)
    if operation =? 'release_record' return release_record_body(arguments[0] type node @state)
    return release_cell_body(arguments[0] type node @state)
}
record_operation = (operation:RecordOperation arguments:array<addr> type:addr node:hir.AST @state:State):>addr => {
    let storage=views.structural_base(type state.type_nodes)
    if state.allocator is? none return record_operation_body(operation arguments storage node @state)
    let key="{operation}:{layout_key(storage node @state)}"
    let name=state.copy_helpers.get(key)
    let empty=types.primitive('void' @state.type_nodes)
    if name is? none {
        let generated=fresh(operation @state)
        name=generated state.copy_helpers[key]=generated
        let word_type=types.primitive('int64' @state.type_nodes)
        let parameters:array<hir.Param>=[]
        let slots:array<types.PosOrKwArg>=[]
        let inputs:array<addr>=[]
        loop argument in arguments {
            let parameter=fresh('record_storage' @state)
            parameters.push(hir.Param[parameter word_type])
            slots.push(types.PosOrKwArg[parameter word_type])
            inputs.push(put(hir.ExpressedIdentifier[node.loc word_type parameter] @state))
        }
        # Reserve first: recursive records through array/union handles can
        # refer back to this operation while its body is being constructed.
        let body=record_operation_body(operation inputs storage node @state)
        let signature=types.function_type(slots [] none empty [] @state.type_nodes)
        let literal=put(hir.FunctionLiteral[node.loc signature parameters [] none empty body source=state.source_index] @state)
        state.generated.push(program.Function[generated literal])
    }
    $runtime_assert name isnt? none
    return intrinsic_call(name arguments empty node @state)
}
object_fields = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => record_operation('copy_fields' [destination source] type node @state)
object_fields_body = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => {
    let record=object_type(type state)
    $runtime_assert record isnt? none
    runtime_type(type node @state);
    if state.problem isnt? none return sequence([] node @state)
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    loop field in record.fields {
        let offset=layout.offsets.get(field.name)
        $runtime_assert offset isnt? none
        let pointer=address(source offset node @state)
        let value=field_read(pointer field.value_type node @state)
        let array=array_type(field.value_type state)
        if array isnt? none {value=array_copy(value array node @state)}
        if owned_string(field.value_type state) {value=string_runtime('_native_string_copy' [value] node @state)}
        prefix.push(field_write(address(destination offset node @state) value field.value_type node @state))
    }
    let brand=layout.offsets.get(layouts.brand_field)
    if brand isnt? none {prefix.push(store_word(read_word(source brand node @state) destination brand node @state))}
    return sequence(prefix node @state)
}
object_write = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => record_operation('write_record' [destination source] type node @state)
object_write_body = (destination:addr source:addr type:addr node:hir.AST @state:State):>addr => {
    let storage=views.structural_base(type state.type_nodes)
    let record=object_type(type state)
    $runtime_assert record isnt? none
    let layout=object_layout(type node @state)
    let tag_offset=layout.offsets.get(layouts.brand_field)
    if tag_offset is? none return object_fields(destination source type node @state)
    let prefix:array<addr>=[]
    let tag=snapshot(read_word(source tag_offset node @state) @prefix @state)
    let arms:array<addr>=[]
    # Dispatch by the exact runtime brand within the storage family. Record
    # includes Child as a type, yet an exact Record value still belongs to
    # Token & ~Child and must keep all Record fields when copied.
    loop entry in state.layout_context.brands.entries {
        let candidate=types.node_at(state.type_nodes entry.value_type)
        $runtime_assert candidate is? types.ObjectType
        if not subtyping.is_subtype(entry.value_type storage state.links @state.type_nodes) continue
        let brand=brand_number(entry.name state)
        $runtime_assert brand isnt? none
        let condition=intrinsic_call('__eq__' [tag word(brand.first node @state)] types.primitive('bool' @state.type_nodes) node @state)
        let body=object_fields(destination source entry.value_type node @state)
        arms.push(put(hir.IfArm[node.loc types.primitive('void' @state.type_nodes) condition body] @state))
    }
    let plain=object_fields(destination source type node @state)
    prefix.push(put(hir.Flow[node.loc types.primitive('void' @state.type_nodes) arms plain] @state))
    return sequence(prefix node @state)
}
object_copy_body = (value:addr type:addr node:hir.AST @state:State):>addr => {
    let layout=object_layout(type node @state)
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let destination=snapshot(record_allocation(layout node @state) @prefix @state)
    prefix.push(object_write(destination source type node @state))
    prefix.push(destination)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# A read of existing storage (a field, an element, a local) that owns no
# fresh storage: an inline record or cell write copies from it directly.
view_source = (id:addr @state:State):>bool => {
    let node=hir.node_at(state.input.nodes id)
    return node is? hir.MemberAccess|hir.Index|hir.ExpressedIdentifier and not expression_owns(id @state)
}
# Every literal field binds its name for the fields after it. Only a field
# some later field actually reads needs a local of its own.
field_binding_referenced = (literal:hir.ObjectLiteral binding:addr? @state:State):>bool => {
    if binding is? none return false
    let pending:array<addr>=[]
    loop item in literal.fields {pending.push(item.value)}
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(state.input.nodes id)
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none and node.binding_id =? binding return true
        hir.push_children(node @pending)
    }
    return false
}
# The expression under the statement wrappers that keep its storage.
peel_statement = (id:addr @state:State):>addr => {
    let current=id
    loop true {
        let node=hir.node_at(state.input.nodes current)
        if node is? hir.Suppress {current=node.item continue}
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=node.items[0] continue}
        return current
    }
}
object_literal = (id:addr node:hir.ObjectLiteral @state:State):>addr => {
    let layout=object_layout(node.value_type node @state)
    let record=object_type(node.value_type state)
    $runtime_assert record isnt? none
    let prefix:array<addr>=[]
    let temporary:array<OwnedLocal>=[]
    let frame=state.frame_records.get(id)
    let destination=if frame is? none snapshot(record_allocation(layout node @state) @prefix @state) else frame
    loop item in node.fields {
        let field=types.object_field(record item.name)
        let offset=layout.offsets.get(item.name)
        $runtime_assert field isnt? none and offset isnt? none
        # A record field is inline storage: the write copies the source's
        # fields (retaining what they own) straight into the literal's block.
        # A source that is a view of existing storage (a field, an element,
        # a local) is read at the write; only a source that owns fresh
        # storage needs the owned value, which is released after the write.
        let source=peel_statement(item.value @state)
        if not field_binding_referenced(node item.binding_id @state) and inline_place(field.value_type @state) and view_source(source @state) {
            prefix.push(field_write(address(destination offset node @state) expression(item.value @state) field.value_type node @state))
            continue
        }
        let value=owned_value(item.value @state 'placed in a record literal')
        if item.binding_id isnt? none {
            let name=symbol(item.name item.binding_id @state)
            let type=runtime_type(field.value_type node @state)
            prefix.push(put(hir.Declare[item.loc types.primitive('void' @state.type_nodes) 'let' name type value item.binding_id] @state))
            value=put(hir.ExpressedIdentifier[item.loc type name item.binding_id] @state)
        }
        if inline_place(field.value_type @state) {
            value=snapshot(value @prefix @state)
            temporary.push(OwnedLocal[value field.value_type])
        }
        prefix.push(field_write(address(destination offset node @state) value field.value_type node @state))
    }
    let offset=layout.offsets.get(layouts.brand_field)
    if offset isnt? none {
        let number:addr=0
        if record.brand isnt? none {
            let brand=brand_number(record.brand state)
            if brand is? none return reject(node 'a minted record has no runtime brand number' @state)
            number=brand.first
        }
        prefix.push(store_word(word(number node @state) destination offset node @state))
    }
    loop item in temporary {prefix.push(release_value(item.value item.value_type node @state))}
    prefix.push(destination)
    return put(hir.Block[node.loc types.primitive('int64' @state.type_nodes) prefix false] @state)
}
# A word's singleton tests compare its value, not an enum tag. Boolean type
# expressions combine those comparisons without changing the word's ABI.
# The caller snapshots the receiver and guards any enclosing union payload.
integer_predicate = (value:addr actual:addr tested:addr node:hir.AST @state:State):>addr => {
    let boolean=types.primitive('bool' @state.type_nodes)
    let type=types.node_at(state.type_nodes types.unfold(tested state.type_nodes))
    if type is? types.TypeOr|types.TypeAnd {
        let conjunction=type is? types.TypeAnd
        let result=put(hir.Bool[node.loc boolean conjunction] @state)
        loop member in type.items {
            let matches=integer_predicate(value actual member node @state)
            result=put(hir.ShortCircuit[node.loc boolean if conjunction 'and' else 'or' result matches] @state)
        }
        return result
    }
    if type is? types.TypeNot return intrinsic_call('__not__' [integer_predicate(value actual type.item node @state)] boolean node @state)
    if type is? types.IntegerLiteralType {
        let layout=views.fixed_integer_layout(views.structural_base(actual state.type_nodes) state.type_nodes)
        $runtime_assert layout isnt? none
        if not subtyping.integer_fits(type.value layout.name) return put(hir.Bool[node.loc boolean false] @state)
        return intrinsic_call('__eq__' [value word(type.value node @state)] boolean node @state)
    }
    let decided=type_tests.decide(actual tested state.links @state.type_nodes)
    if decided isnt? none return put(hir.Bool[node.loc boolean decided] @state)
    return reject(node 'this runtime integer type test' @state)
}

# Boolean type expressions combine predicates on the same runtime brand.
# Evaluate the source once; a tagged union must also select its record payload
# before reading that brand, since an inactive payload may be none or a scalar.
object_predicate = (tag:addr actual:addr tested:addr node:hir.AST @state:State):>addr => {
    let boolean=types.primitive('bool' @state.type_nodes)
    let type=types.node_at(state.type_nodes types.unfold(tested state.type_nodes))
    if type is? types.TypeOr|types.TypeAnd {
        let conjunction=type is? types.TypeAnd
        let result=put(hir.Bool[node.loc boolean conjunction] @state)
        loop member in type.items {
            let matches=object_predicate(tag actual member node @state)
            result=put(hir.ShortCircuit[node.loc boolean if conjunction 'and' else 'or' result matches] @state)
        }
        return result
    }
    if type is? types.TypeNot return intrinsic_call('__not__' [object_predicate(tag actual type.item node @state)] boolean node @state)
    let decided=type_tests.decide(actual tested state.links @state.type_nodes)
    if decided isnt? none return put(hir.Bool[node.loc boolean decided] @state)
    let record=object_type(tested state)
    if record is? none return reject(node 'this runtime type test representation' @state)
    if record.brand is? none return reject(node 'a structural runtime record test' @state)
    let brand=brand_number(record.brand state)
    if brand is? none return reject(node 'the tested type has no runtime brand number' @state)
    let lower=intrinsic_call('__ge__' [tag word(brand.first node @state)] boolean node @state)
    let upper=intrinsic_call('__lt__' [tag word(brand.limit node @state)] boolean node @state)
    return put(hir.ShortCircuit[node.loc boolean 'and' lower upper] @state)
}
object_matches = (value:addr actual:addr tested:addr node:hir.AST @state:State):>addr => {
    let prefix:array<addr>=[]
    let source=snapshot(value @prefix @state)
    let boolean=types.primitive('bool' @state.type_nodes)
    let decided=type_tests.decide(actual tested state.links @state.type_nodes)
    if decided isnt? none {
        prefix.push(put(hir.Bool[node.loc boolean decided] @state))
        return put(hir.Block[node.loc boolean prefix false] @state)
    }
    if not object_valued(actual state) return reject(node 'this runtime type test representation' @state)
    let layout=object_layout(actual node @state)
    let offset=layout.offsets.get(layouts.brand_field)
    if offset is? none return reject(node 'the tested value has no brand storage' @state)
    let tag=snapshot(read_word(source offset node @state) @prefix @state)
    prefix.push(object_predicate(tag actual tested node @state))
    return put(hir.Block[node.loc boolean prefix false] @state)
}
object_test = (operand:addr node:hir.TypeTest @state:State):>addr => {
    let actual=hir.node_at(state.input.nodes node.value).value_type
    let result=object_matches(operand actual node.test_type node @state)
    return if node.negated intrinsic_call('__not__' [result] types.primitive('bool' @state.type_nodes) node @state) else result
}

# Function defaults are callee expressions. The ABI passes an ordinary value
# plus a presence flag; only the absent branch evaluates the default. Keyword
# spelling disappears here, after preserving the source evaluation order.
# Snapshot temporaries are the bulk of the emitted identifiers; their short
# spelling cannot collide with user bindings (`__dewy_binding_...`),
# generated helpers (`__dewy_..._N`) or lifted functions.
fresh = (hint:string @state:State):>string => {
    state.serial+=1
    if hint =? 'argument' return "_a{state.serial}"
    return "_{hint}{state.serial}"
}
snapshot = (value:addr @prefix:array<addr> @state:State):>addr => {
    let node=hir.node_at(state.nodes value)
    let name=fresh('argument' @state)
    prefix.push(put(hir.Declare[node.loc types.primitive('void' @state.type_nodes) 'let' name node.value_type value] @state))
    return put(hir.ExpressedIdentifier[node.loc node.value_type name] @state)
}
placeholder = (type:addr node:hir.AST @state:State):>addr => {
    let target=types.node_at(state.type_nodes type)
    if types.is_primitive(target 'bool') return put(hir.Bool[node.loc type false] @state)
    if target is? types.FunctionType {
        let word=put(hir.Integer[node.loc types.primitive('int64' @state.type_nodes) '0d' 0] @state)
        return put(hir.Transmute[node.loc type word] @state)
    }
    return put(hir.Integer[node.loc type '0d' 0] @state)
}
call_slot = (value:addr? type:addr required:bool node:hir.AST @args:array<addr> @state:State):>void => {
    if value isnt? none {args.push(value)}
    else {
        if required {reject(node 'a checked call is missing a required argument' @state);}
        let storage=runtime_type(type node @state)
        args.push(placeholder(storage node @state))
    }
    if not required {args.push(put(hir.Bool[node.loc types.primitive('bool' @state.type_nodes) value isnt? none] @state))}
}
# A variant changes only the output ABI. Argument evaluation, default flags,
# ownership decisions, and lifted captures follow the original checked call.
ordinary_call = (id:addr node:hir.FunctionCall result_type:addr @state:State projection:ScalarProjection?=none):>addr => {
    let callee=hir.node_at(state.input.nodes node.func)
    let direct=captures.resolve(node.func node.selected_method_index state.capture_plan state.input.nodes)
    let signature_type=if direct is? none callee.value_type else hir.node_at(state.input.nodes direct).value_type
    let signature=types.node_at(state.type_nodes types.strip_refinement(signature_type state.type_nodes))
    if signature isnt? types.FunctionType return reject(node 'a call requires its selected concrete signature' @state)
    if signature.rest isnt? none return reject(node 'rest argument legalization' @state)
    let prefix:array<addr>=[]
    # A record's function field is a receiver method: the record is its
    # hidden first argument, as the hosted backend passes it. Evaluate the
    # record once, for the field read and for the argument.
    let receiver:addr?=none
    if direct is? none and callee is? hir.MemberAccess and object_type(hir.node_at(state.input.nodes callee.value).value_type state) isnt? none {
        receiver=snapshot(expression(callee.value @state) @prefix @state)
    }
    let function:addr=0
    if receiver isnt? none {
        $runtime_assert callee is? hir.MemberAccess
        let stored=stored_type(node.func state)
        let pointer=field_address(receiver callee @state)
        function=snapshot(read_value(field_read(pointer stored callee @state) stored callee.value_type callee @state) @prefix @state)
    } else if direct is? none {function=snapshot(expression(node.func @state) @prefix @state)}
    else {function=code_reference(direct callee @state)}
    if projection isnt? none {function=put(hir.ExpressedIdentifier[node.loc code_type(projection.function node @state result=projection.result) projection.symbol] @state)}
    let borrowed=state.borrowed_arguments.get(id set[])
    let disposable=state.disposable_arguments.get(id set[])-borrowed
    let temporary:array<OwnedLocal>=[]
    let positional:array<addr>=[]
    let views_allowed=string_free_type(signature.ret @state)
    let consumed=state.consumed_arguments.get(id set[])
    loop argument in node.pos_args {
        let value=call_argument(argument borrowed disposable consumed views_allowed @temporary @prefix @state)
        positional.push(value)
    }
    let keywords:dict<string addr>=[]
    loop [name argument] in node.kw_args {
        keywords[name]=call_argument(argument borrowed disposable consumed views_allowed @temporary @prefix @state)
    }
    let args:array<addr>=[]
    if receiver isnt? none {args.push(receiver)}
    let index:addr=0
    loop parameter in signature.pos_or_kw {
        let value:addr?=none
        if index <? positional.length {value=positional[index]}
        else if parameter.name isnt? none and parameter.name in? keywords {value=keywords.pop(parameter.name)}
        call_slot(value parameter.value_type parameter.required node @args @state)
        index+=1
    }
    if positional.length >? signature.pos_or_kw.length return reject(node 'too many arguments in a checked call' @state)
    loop parameter in signature.kw_only {
        let value:addr?=none
        if parameter.name in? keywords {value=keywords.pop(parameter.name)}
        call_slot(value parameter.value_type parameter.required node @args @state)
    }
    if keywords.length >? 0 return reject(node 'unknown keywords in a checked call' @state)
    if direct isnt? none {
        let capture=state.capture_plan.functions.get(direct)
        $runtime_assert capture isnt? none
        loop binding in capture.captures {
            let stored=state.storage_types.get(binding)
            $runtime_assert stored isnt? none
            let read=hir.ExpressedIdentifier[node.loc stored symbol('capture' binding @state) binding]
            # Captures are read at the call, after the explicit arguments.
            # Aggregate handles are borrowed, matching the hosted lifting
            # contract; captured writes are rejected when the unit is built.
            args.push(snapshot(binding_storage(read stored @state) @prefix @state))
        }
    }
    let called=put(hir.FunctionCall[node.loc result_type function args [] node.selected_method_index node.integer_operation] @state)
    let result=types.node_at(state.type_nodes result_type)
    if temporary.length =? 0 or types.is_primitive(result 'never') {prefix.push(called)}
    else {
        # The callee has finished using these private argument snapshots.
        # Keep the call result alive before reclaiming their aggregate trees.
        let value:addr?=none
        if types.is_primitive(result 'void') {prefix.push(called)}
        else {value=snapshot(called @prefix @state)}
        loop item in temporary {prefix.push(release_value(item.value item.value_type node @state))}
        if value isnt? none {prefix.push(value)}
    }
    return put(hir.Block[node.loc result_type prefix false] @state)
}
# Borrowing looks through the wrappers contextual typing puts around an
# argument: single-item blocks, proof obligations and string casts. A
# borrowed argument lowers the storage read underneath those wrappers: a
# block would otherwise yield an owned copy that nobody releases. The
# casts keep the descriptor only between owned strings; a compact string
# enum or a union cell would need a real conversion, so those copy.
peel_borrowed = (id:addr @state:State):>addr? => {
    let current=id
    loop true {
        let node=hir.node_at(state.input.nodes current)
        if node is? hir.Suppress {current=node.item continue}
        if node is? hir.Obligation {current=node.value continue}
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=node.items[0] continue}
        if node is? hir.ValueCast|hir.RepresentationCast {
            let inner=hir.node_at(state.input.nodes node.expr)
            if owned_string(node.value_type state) and owned_string(inner.value_type state) {current=node.expr continue}
            # A record read as a relative is the same block; the borrowing
            # callee reads the fields both layouts share.
            if node is? hir.ValueCast and object_valued(node.value_type state) and object_valued(inner.value_type state) {current=node.expr continue}
            return none
        }
        return current
    }
}
# A borrowed argument passes the callee's read-only view; anything else is
# an owned copy the caller reclaims after the call when the callee does not
# keep it (a borrowable argument that needed a conversion is such a copy).
# The effects summary does not treat a returned value as an escape, so a
# frame view may only be passed when the callee's result cannot carry a
# string (a returned slice of the view would outlive the frame slot).
string_free_type = (id:addr @state:State depth:addr=0):>bool => {
    if depth >? 6 return false
    let plain=types.node_at(state.type_nodes types.unfold(types.strip_refinement(id state.type_nodes) state.type_nodes))
    if string_type(id state) return false
    if plain is? types.ArrayType return string_free_type(plain.element @state depth=depth+1)
    if plain is? types.ObjectType {
        loop field in plain.fields {if not string_free_type(field.value_type @state depth=depth+1) return false}
        return true
    }
    if plain is? types.TypeOr {
        loop member in plain.items {if not string_free_type(member @state depth=depth+1) return false}
        return true
    }
    if plain is? types.FunctionType return false
    return true
}
call_argument = (argument:addr borrowed:set<addr> disposable:set<addr> consumed:set<addr> views_allowed:bool @temporary:array<OwnedLocal> @prefix:array<addr> @state:State):>addr => {
    # A donated argument is an owned value the callee takes over: a fresh
    # temporary passes as is, a kept value is copied, and nothing is
    # released here.
    if argument in? consumed return snapshot(owned_value(argument @state 'donated to a call') @prefix @state)
    let peeled:addr?=if argument in? borrowed peel_borrowed(argument @state) else none
    if peeled isnt? none return snapshot(expression(peeled @state) @prefix @state)
    let source=hir.node_at(state.input.nodes argument)
    # A one-grapheme or slice temporary of a stable string, passed to a
    # callee that neither keeps nor exposes it, is read through the
    # statement's frame descriptor: no allocation, no owner reference.
    if views_allowed and argument in? disposable and owned_string(source.value_type state) {
        let inner=peel_borrowed(argument @state)
        if inner isnt? none and hir.node_at(state.input.nodes inner) is? hir.StringIndex|hir.StringSlice {
            let view=string_frame_view(argument @prefix @state)
            if view isnt? none return view
        }
    }
    let value=snapshot(owned_value(argument @state 'passed to a call') @prefix @state)
    # A literal argument is static: nothing to release after the call.
    if (argument in? disposable or argument in? borrowed) and source isnt? hir.Place and not static_literal(argument state) and releasable(source.value_type @state) {temporary.push(OwnedLocal[value source.value_type])}
    return value
}
# Only the lifted code signature contains captures. Ordinary function values
# retain the source callable ABI, so a capturing unit cannot masquerade as
# a plain function pointer merely because its visible parameters match.
code_type = (id:addr node:hir.AST @state:State result:addr?=none):>addr => {
    let literal=hir.node_at(state.input.nodes id)
    let capture=state.capture_plan.functions.get(id)
    $runtime_assert literal is? hir.FunctionLiteral and capture isnt? none
    let runtime=runtime_type(literal.value_type node @state)
    let signature=types.node_at(state.type_nodes runtime)
    $runtime_assert signature is? types.FunctionType
    let arguments=signature.pos_or_kw
    loop binding in capture.captures {
        let stored=state.storage_types.get(binding)
        $runtime_assert stored isnt? none
        let type=if binding in? state.boxed types.primitive('int64' @state.type_nodes) else runtime_type(stored node @state)
        arguments.push(types.PosOrKwArg[none type])
    }
    return types.function_type(arguments [] none if result is? none signature.ret else runtime_type(result node @state) [] @state.type_nodes)
}
code_reference = (id:addr node:hir.AST @state:State):>addr => {
    let name=state.code_symbols.get(id)
    $runtime_assert name isnt? none
    return put(hir.ExpressedIdentifier[node.loc code_type(id node @state) name] @state)
}
function_value = (id:addr node:hir.AST @state:State):>addr => {
    let capture=state.capture_plan.functions.get(id)
    $runtime_assert capture isnt? none
    if capture.captures.length >? 0 return reject(node 'a capturing function used as a value needs closure storage' @state)
    return code_reference(id node @state)
}
function = (id:addr node:hir.FunctionLiteral @state:State projection:ScalarProjection?=none):>addr => {
    if node.rest_args isnt? none return reject(node 'rest parameter legalization' @state)
    if aggregate(node.rettype state) and state.allocator is? none return reject(node 'aggregate results need the prelude arena allocator' @state)
    let arguments:array<hir.Param>=[]
    let prologue:array<addr>=[]
    let void_type=types.primitive('void' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let capture=state.capture_plan.functions.get(id)
    $runtime_assert capture isnt? none
    if node.object_receiver and capture.captures.length >? 0 return reject(node 'an object method reading enclosing locals needs closure storage' @state)
    let previous_receiver=state.receiver_symbol
    let previous_receiver_type=state.receiver_type
    let previous_receiver_fields=state.receiver_fields
    if node.object_receiver {
        let receiver=fresh('self' @state)
        arguments.push(hir.Param[receiver types.primitive('int64' @state.type_nodes)])
        let names:dict<addr string>=[]
        loop field in node.object_fields {names[field.id]=field.name}
        state.receiver_symbol=receiver state.receiver_type=node.object_type state.receiver_fields=names
    } else {state.receiver_symbol=none state.receiver_type=none state.receiver_fields=[]}
    loop binding in capture.captures {
        if binding in? capture.writes return reject(node 'writing to a binding from an enclosing function needs closure storage' @state)
    }
    # An implicit result crosses the same value boundary as `return`. This
    # matters when a read-only parameter was borrowed: a returned aggregate
    # must own its storage even when the caller immediately mutates the result.
    let enabled=state.allocator isnt? none and '_arena_release' in? state.runtime_helpers
    let excluded=state.cleanup_excluded
    let rebound:set<addr>=set[]
    let mutated:set<addr>=set[]
    # Roots of genuine writes (field/element/dictionary stores, container
    # methods, place passing): a record parameter written this way owns a
    # private handle. Lookups only maintain a dictionary's index, which a
    # borrowed inline field pointer may do in place.
    let written:set<addr>=set[]
    let local_declarations:array<addr>=[]
    let pending:array<addr>=[node.body]
    loop parameter in parameters(node) {if parameter is? hir.BoundParam {pending.push(parameter.value)}}
    let visited:set<addr>=set[]
    loop pending.length >? 0 {
        let child=pending.pop
        if child in? visited continue
        visited.add(child)
        let current=hir.node_at(state.input.nodes child)
        if current is? hir.FunctionLiteral continue
        if current is? hir.Declare {local_declarations.push(child)}
        if current is? hir.Assign {
            let target=hir.node_at(state.input.nodes current.target)
            if target is? hir.ExpressedIdentifier and target.binding_id isnt? none {rebound.add(target.binding_id)}
        } else {
            loop target in captures.write_targets(current state.input.nodes) {
                let root=captures.root_binding(target state.input.nodes)
                if root isnt? none {written.add(root)}
            }
        }
        # A shared array descriptor is detached through the route that
        # mutates it, so the binding at that route's root must own its
        # reference: mutated parameters are private and such locals are
        # never borrowed views.
        if current is? hir.IndexAssign {
            let target=hir.node_at(state.input.nodes current.target)
            if target is? hir.Index {mark_mutated(target.array @mutated state)}
        }
        if current is? hir.MemberAssign {
            let target=hir.node_at(state.input.nodes current.target)
            if target is? hir.MemberAccess {mark_mutated(target.value @mutated state)}
        }
        if current is? hir.DictStore|hir.DictRemove {
            let keys=hir.node_at(state.input.nodes current.keys)
            if keys is? hir.MemberAccess {mark_mutated(keys.value @mutated state)}
        }
        # Read-only dictionary operations may maintain the shared index,
        # but never replace the dictionary handle. They do not need an owned
        # binding slot; dict_parts deliberately uses detach=false for reads.
        if current is? hir.DictMethod {mark_mutated(current.dictionary @mutated state)}
        if current is? hir.Place {mark_mutated(current.target @mutated state)}
        if current is? hir.Transmute {mark_mutated(current.expr @mutated state)}
        # Installed failure reporting uses raw I/O internally. It does not
        # expose the successful path's locals; only source message effects
        # participate in this lifetime decision, as in borrow analysis.
        if current is? hir.RuntimeFailure {
            if current.message isnt? none {pending.push(current.message)}
            continue
        }
        if current is? hir.Transmute and (aggregate(current.value_type state) or aggregate(hir.node_at(state.input.nodes current.expr).value_type state)) {enabled=false}
        if current is? hir.FunctionCall {
            let callee=hir.node_at(state.input.nodes current.func)
            if callee is? hir.ArrayMethod and callee.name not=? 'join' {mark_mutated(callee.array @mutated state)}
            if callee is? hir.ExpressedIdentifier and (callee.name.startswith('__load_') or callee.name.startswith('__store_') or callee.name.startswith('__syscall') or callee.name in? ['__load__' '__store__']) {
                loop argument in current.pos_args {if aggregate(hir.node_at(state.input.nodes argument).value_type state) {enabled=false}}
                loop argument in current.pos_args {mark_mutated(argument @mutated state)}
            }
        }
        hir.push_children(current @pending)
    }
    state.cleanup_enabled=enabled state.cleanup_owned=set[] state.mutated_roots=mutated
    state.frame_boxes=[]
    state.frame_arrays=[] state.frame_records=[] state.frame_record_bindings=set[]
    let frame_array_bindings:set<addr>=set[]
    loop [binding declaration_id] in placement.local_values(node state.input.nodes state.type_nodes state.nonescaping_places state.fixed_places state.borrowed_arguments) {
        let declaration=hir.node_at(state.input.nodes declaration_id)
        $runtime_assert declaration is? hir.Declare
        let literal=hir.node_at(state.input.nodes declaration.expr)
        if literal is? hir.ObjectLiteral {
            # No whole-value copy, capture or call can outlive this record.
            # It owns only scalar fields, so no release/header is required.
            let layout=object_layout(literal.value_type literal @state)
            let name=fresh('record_frame' @state)
            let word_type=types.primitive('int64' @state.type_nodes)
            let allocated=intrinsic_call('__alloca__' [word(layout.size literal @state)] word_type literal @state)
            prologue.push(put(hir.Declare[literal.loc void_type 'const' name word_type allocated] @state))
            state.frame_records[declaration.expr]=put(hir.ExpressedIdentifier[literal.loc word_type name] @state)
            state.frame_record_bindings.add(binding)
            continue
        }
        $runtime_assert literal is? hir.ArrayLiteral
        let type=array_type(literal.value_type state)
        $runtime_assert type isnt? none
        let layout=layouts.element(type.element @state.type_nodes nominals=state.layout_context.nominals)
        if layout is? layouts.Pending return reject(literal layout.detail @state)
        let name=fresh('array_frame' @state)
        let word_type=types.primitive('int64' @state.type_nodes)
        let size=layouts.array_descriptor.size+literal.items.length*layout.size
        let allocated=intrinsic_call('__alloca__' [word(size literal @state)] word_type literal @state)
        prologue.push(put(hir.Declare[literal.loc void_type 'const' name word_type allocated] @state))
        let descriptor=put(hir.ExpressedIdentifier[literal.loc word_type name] @state)
        state.frame_arrays[declaration.expr]=ArrayMemory[descriptor address(descriptor layouts.array_descriptor.size literal @state) []]
        frame_array_bindings.add(binding)
    }
    loop binding in capture.locals {
        if binding not in? state.boxed or binding in? excluded or binding in? state.place_parameters continue
        let stored=state.storage_types.get(binding)
        if stored is? none or (not borrowing.word_value(stored state.type_nodes) and binding not in? frame_array_bindings) continue
        let word_type=types.primitive('int64' @state.type_nodes)
        let name=fresh('place_slot' @state)
        let slot=intrinsic_call('__alloca__' [word(8 node @state)] word_type node @state)
        prologue.push(put(hir.Declare[node.loc void_type 'const' name word_type slot] @state))
        state.frame_boxes[binding]=put(hir.ExpressedIdentifier[node.loc word_type name] @state)
    }
    state.view_writes=[]
    if local_declarations.length >? 0 {
        let has_view=false
        loop declaration_id in local_declarations {
            let declaration=hir.node_at(state.input.nodes declaration_id)
            if declaration is? hir.Declare and declaration.view {has_view=true}
        }
        if has_view {
            loop child in visited {
                let current=hir.node_at(state.input.nodes child)
                if captures.write_targets(current state.input.nodes).length >? 0 {state.view_writes.push(child)}
            }
        }
    }
    # Borrow selection precedes moves. A borrowed field/element/getter is
    # still a use of its owner's storage after the owner's last spelled read.
    # Moving that owner into a mutable destination while the view lives would
    # let mutation of the destination change an ordinary value snapshot.
    let borrow_dependents:dict<addr set<addr>>=[]
    if enabled {
        loop declaration_id in local_declarations {
            let declaration=hir.node_at(state.input.nodes declaration_id)
            $runtime_assert declaration is? hir.Declare
            if declaration.binding_id is? none continue
            let route:borrowing.Route?=none
            if borrowed_route_local(declaration @state) {route=borrowing.route(declaration.expr state.input.nodes)}
            else if borrowed_getter_local(declaration @state) isnt? none {route=getter_route(declaration.expr 0 @state)}
            if route isnt? none {
                let dependents=borrow_dependents.get(route.binding set[])
                dependents.add(declaration.binding_id)
                borrow_dependents[route.binding]=dependents
            }
        }
    }
    state.moved_uses=if enabled moves.compute(id state.input.nodes borrow_dependents) else set[]
    state.moved_bindings=set[]
    loop use in state.moved_uses {
        let moved=hir.node_at(state.input.nodes use)
        if moved is? hir.ExpressedIdentifier and moved.binding_id isnt? none {state.moved_bindings.add(moved.binding_id)}
    }
    state.loop_depth=0 state.loop_levels=none state.loop_kind=none state.loop_prologue=[]
    let frame_start=state.cleanup_frames.length
    state.cleanup_frames.push([])
    loop argument in parameters(node) {
        if not argument.place and aggregate(argument.value_type state) and state.allocator is? none return reject(node 'aggregate arguments need the prelude arena allocator' @state)
        let type=runtime_type(argument.value_type node @state)
        let name=symbol(argument.name argument.binding_id @state)
        let boxed=argument.binding_id isnt? none and argument.binding_id in? state.boxed
        if argument.place {
            if argument is? hir.BoundParam return reject(node 'a default place parameter' @state)
            arguments.push(hir.Param[name types.primitive('int64' @state.type_nodes) argument.binding_id argument.position_only false])
            continue
        }
        let whole=argument.binding_id isnt? none and argument.binding_id in? written and object_valued(argument.value_type state)
        let owned=argument.binding_id isnt? none and argument.binding_id in? state.owned_parameters
        # The plan may only transfer ownership when this function can release
        # it. Keep a checked internal boundary rather than silently leaking if
        # a new raw operation is added to one analysis but not the other.
        if owned and (not enabled or (argument.binding_id isnt? none and argument.binding_id in? excluded)) return reject(node 'an owning parameter without a proven cleanup lifetime' @state)
        let private=owned or boxed or releasable(argument.value_type @state) and argument.binding_id isnt? none and (argument.binding_id in? rebound or (argument.binding_id in? mutated and array_valued(argument.value_type state)) or whole)
        let condition:addr?=none
        if argument is? hir.BoundParam {
            let incoming=fresh('incoming' @state)
            let present=fresh('present' @state)
            arguments.push(hir.Param[incoming type])
            arguments.push(hir.Param[present boolean])
            let present_value=put(hir.ExpressedIdentifier[node.loc boolean present] @state)
            if not private {condition=intrinsic_call('__not__' [present_value] boolean node @state)}
            let supplied=put(hir.ExpressedIdentifier[node.loc type incoming] @state)
            if private {
                note_parameter_copy(argument boxed rebound mutated written node @state)
                supplied=copy_value(supplied argument.value_type node @state shared=whole)
            }
            let default=owned_value(argument.value @state)
            let arm=put(hir.IfArm[node.loc type present_value supplied] @state)
            let selected=put(hir.Flow[node.loc type [arm] default] @state)
            if boxed {selected=box_value(selected argument.value_type node @state binding=argument.binding_id) type=types.primitive('int64' @state.type_nodes)}
            prologue.push(put(hir.Declare[node.loc void_type 'let' name type selected argument.binding_id] @state))
        } else if private {
            let incoming=fresh('incoming' @state)
            arguments.push(hir.Param[incoming type position_only=argument.position_only])
            let value=put(hir.ExpressedIdentifier[node.loc type incoming] @state)
            if not owned {
                note_parameter_copy(argument boxed rebound mutated written node @state)
                value=copy_value(value argument.value_type node @state shared=whole)
            }
            if boxed {value=box_value(value argument.value_type node @state binding=argument.binding_id) type=types.primitive('int64' @state.type_nodes)}
            prologue.push(put(hir.Declare[node.loc void_type 'let' name type value argument.binding_id] @state))
        } else {arguments.push(hir.Param[name type argument.binding_id argument.position_only false])}
        # A missing default is owned here; an explicit read-only argument is
        # still owned by its caller. Boxed/rebound parameters own their local
        # copy on both paths. The condition is the existing ABI presence bit.
        if enabled and (private or argument is? hir.BoundParam) and (boxed or releasable(argument.value_type @state)) and (argument.binding_id is? none or argument.binding_id not in? excluded and argument.binding_id not in? state.frame_boxes) {
            let value=put(hir.ExpressedIdentifier[node.loc type name argument.binding_id] @state)
            let box:addr?=none
            if boxed {box=value value=array_load(value argument.value_type node @state)}
            $runtime_assert state.cleanup_frames.length >? 0
            let frame=state.cleanup_frames.pop
            frame.push(OwnedLocal[value argument.value_type box condition])
            state.cleanup_frames.push(frame)
            if private and argument.binding_id isnt? none {state.cleanup_owned.add(argument.binding_id)}
        }
    }
    loop binding in capture.captures {
        let stored=state.storage_types.get(binding)
        $runtime_assert stored isnt? none
        let type=if binding in? state.boxed types.primitive('int64' @state.type_nodes) else runtime_type(stored node @state)
        arguments.push(hir.Param[symbol('capture' binding @state) type binding])
    }
    state.result_projection=projection
    let body=owned_value(node.body @state)
    state.result_projection=none
    if state.loop_prologue.length >? 0 {
        let initialized=state.loop_prologue
        loop item in prologue {initialized.push(item)}
        prologue=initialized
    }
    let result_type=runtime_type(if projection is? none node.rettype else projection.result node @state)
    let cleanup=cleanup_since(frame_start node @state)
    $runtime_assert state.cleanup_frames.length >? frame_start and state.cleanup_frames.length >? 0
    state.cleanup_frames.pop;
    state.cleanup_enabled=false
    if prologue.length >? 0 or cleanup.length >? 0 {
        let actual=types.node_at(state.type_nodes hir.node_at(state.nodes body).value_type)
        let result:addr?=none
        if types.is_primitive(actual 'void') or types.is_primitive(actual 'never') {prologue.push(body)}
        else {result=snapshot(body @prologue @state)}
        loop release in cleanup {prologue.push(release)}
        if result isnt? none {prologue.push(result)}
        body=put(hir.Block[node.loc result_type prologue false] @state)
    }
    state.receiver_symbol=previous_receiver state.receiver_type=previous_receiver_type state.receiver_fields=previous_receiver_fields
    return put(hir.FunctionLiteral[node.loc code_type(id node @state result=if projection is? none none else projection.result) arguments [] none result_type body source=node.source] @state)
}

lower = (root:addr input:emit.Input source:SrcFile allocator:addr?=none layout_context:layouts.Context=layouts.Context[] entry_binding:addr?=none infer_entry:bool=true source_by_item:dict<addr addr>=[] runtime_helpers:dict<string addr>=[] links:subtyping.Graph=subtyping.default_links debug_names:bool=false explicit_copy_sources:set<addr>=set[] source_registry:bindings.Registry=bindings.Registry[]):>Result|Error => {
    let state=State[input source type_nodes=input.types allocator=allocator runtime_helpers=runtime_helpers layout_context=layout_context links=links debug_names=debug_names explicit_copy_sources=explicit_copy_sources]
    # Older seeds and prelude-free kernels retain the six-word allocation
    # ABI. Install retain/drop together with prefix allocation, once per
    # lowering, so every value boundary agrees about descriptor ownership.
    let descriptor=runtime_helpers.get('_native_string_descriptor')
    let retain=runtime_helpers.get('_native_string_retain')
    let drop=runtime_helpers.get('_native_string_drop')
    if allocator isnt? none and descriptor isnt? none and retain isnt? none and drop isnt? none {
        state.shared_string_descriptors=true
        state.runtime_helpers['_native_string_copy']=retain
        state.runtime_helpers['_native_string_release']=drop
    }
    loop brand in brands.numbered(layout_context.brands) {state.brand_numbers[brand.name]=brand}
    let block=hir.node_at(input.nodes root)
    if block isnt? hir.Block return Error[srcfile=source title='lowering requires a module block']
    discover(root @state)
    state.capture_plan=captures.analyze(root input.nodes state.symbols.keys)
    # Entrypoints and compiler-emitted runtime calls do not go through source
    # argument preparation. Exclude their ABI from ownership specialization.
    let external:set<addr>=set[]
    loop [binding id] in state.capture_plan.named {
        let source_name=state.capture_plan.names.get(binding)
        if (entry_binding isnt? none and binding =? entry_binding) or (infer_entry and source_name isnt? none and source_name =? 'main') {external.add(id)}
    }
    loop binding in runtime_helpers.values {
        let id=state.capture_plan.named.get(binding)
        if id isnt? none {external.add(id)}
    }
    let borrowed=borrowing.details(root input.nodes input.types state.capture_plan state.links external=external owned_parameter_protocol=state.allocator isnt? none and '_arena_release' in? runtime_helpers registry=source_registry)
    state.borrowed_arguments=borrowed.arguments
    state.nonescaping_places=borrowed.nonescaping_places
    state.fixed_places=borrowed.fixed_places
    state.stable_bindings=borrowed.stable_bindings
    state.scoped_views=borrowed.scoped_views
    state.view_scopes=borrowed.view_scopes
    state.view_regions=borrowed.view_regions
    state.stable_parameters=borrowed.stable_parameters
    state.array_snapshots=borrowed.array_snapshots
    state.disposable_arguments=borrowed.disposable_arguments
    state.consumed_arguments=borrowed.consumed_arguments
    state.consumed_uses=borrowed.consumed_uses
    state.owned_parameters=borrowed.owned_parameters
    state.borrow_rejections=borrowed.rejections
    state.cleanup_excluded=borrowed.escaping_places
    loop unit in state.capture_plan.functions.values {
        loop binding in unit.captures {state.cleanup_excluded.add(binding)}
    }
    let units=state.capture_plan.functions
    let named=state.capture_plan.named
    loop [id capture] in units {state.code_symbols[id]="_f{id}"}
    # Source names on symbols are for reading the emitted program and for
    # the debugger; an ordinary build carries the identity alone.
    # Carry the source name of a named function into its symbol so stack
    # traces, profiles and emitted text identify it. Unique ids stay in front.
    loop [binding id] in named {
        let source_name=state.capture_plan.names.get(binding)
        if source_name isnt? none and state.debug_names {state.code_symbols[id]="_f{id}_{emit.name(source_name)}"}
    }
    loop [binding id] in named {
        let name=state.code_symbols.get(id)
        $runtime_assert name isnt? none
        state.symbols[binding]=name
    }
    let functions:array<program.Function>=[]
    let globals:array<addr>=[]
    let startup:array<addr>=[]
    let main:string?=none
    let entry_literal:addr?=none
    let void_type=types.primitive('void' @state.type_nodes)
    if state.allocator isnt? none {
        # Packing or copying `none` into an optional yields this static cell
        # instead of a fresh allocation; releases skip it by identity.
        let word_type=types.primitive('int64' @state.type_nodes)
        let name=fresh('none_cell' @state)
        globals.push(put(hir.Declare[block.loc void_type 'let' name word_type put(hir.Integer[block.loc word_type '0d' 0] @state)] @state))
        let target=put(hir.ExpressedIdentifier[block.loc word_type name] @state)
        let cell=intrinsic_call('__static_words__' [word(0 block @state) word(0 block @state)] word_type block @state)
        startup.push(put(hir.Assign[block.loc void_type target '=' cell] @state))
        state.none_cell=name
    }
    # A module item desugared into a statement group (an unpacking
    # assignment) contributes its declarations as globals in order.
    let items:array<addr>=[]
    loop id in block.items {
        let item=hir.node_at(input.nodes id)
        if item is? hir.Block and not item.scoped {loop inner in item.items {items.push(inner)}}
        else {items.push(id)}
    }
    loop id in items {
        let owner=source_by_item.get(id)
        if owner isnt? none {state.source_index=owner}
        state.source=if state.source_index is? none source else hir.source_at(state.source_index input.source_files)
        let node=hir.node_at(input.nodes id)
        if node is? hir.Declare {
            let value=hir.node_at(input.nodes node.expr)
            # Aliases are already resolved in the type arena. Any runtime
            # type value is an explicit TypeValue expression at its use site.
            if value is? hir.GenericFunction|hir.TypeValue|hir.OverloadedFunction or compile_time_binding(node state) continue
            let name=symbol(node.name node.binding_id @state)
            if value is? hir.FunctionLiteral {
                if entry_binding isnt? none and node.binding_id =? entry_binding or entry_binding is? none and infer_entry and node.name =? 'main' {main=name entry_literal=node.expr}
                continue
            }
            if aggregate(value.value_type state) and state.allocator is? none {reject(node 'global aggregates need the prelude arena allocator' @state); continue}
            let declared=expression(id @state)
            let declaration=hir.node_at(state.nodes declared)
            if declaration isnt? hir.Declare continue
            let type=declaration.annotation
            $runtime_assert type isnt? none
            let zero=if types.is_primitive(types.node_at(state.type_nodes type) 'bool') put(hir.Bool[node.loc type false] @state) else put(hir.Integer[node.loc type '0d' 0] @state)
            globals.push(put(hir.Declare[node.loc void_type 'let' name type zero node.binding_id] @state))
            let target=put(hir.ExpressedIdentifier[node.loc type name node.binding_id] @state)
            startup.push(put(hir.Assign[node.loc void_type target '=' declaration.expr] @state))
        } else {startup.push(expression(id @state))}
    }
    # Module statements run in the generated initializer. Its nonlocal
    # exits need their own initialized signals before function lowering resets
    # the control state for each independently emitted body.
    if state.loop_prologue.length >? 0 {
        let initialized=state.loop_prologue
        loop item in startup {initialized.push(item)}
        startup=initialized
    }
    loop [id capture] in units {
        let node=hir.node_at(input.nodes id)
        $runtime_assert node is? hir.FunctionLiteral
        let name=state.code_symbols.get(id)
        $runtime_assert name isnt? none
        state.source_index=node.source
        state.source=if node.source is? none source else hir.source_at(node.source input.source_files)
        functions.push(program.Function[name function(id node @state)])
    }
    # Never lower a variant inside the active caller's cleanup state. New
    # variants are registered before their bodies, so recursion stays finite.
    let projection_index:addr=0
    loop projection_index <? state.pending_projections.length {
        let projection=state.pending_projections[projection_index]
        projection_index+=1
        let node=hir.node_at(input.nodes projection.function)
        $runtime_assert node is? hir.FunctionLiteral
        state.source_index=node.source
        state.source=if node.source is? none source else hir.source_at(node.source input.source_files)
        functions.push(program.Function[projection.symbol function(projection.function node @state projection=projection)])
    }
    if state.problem isnt? none return state.problem
    if entry_binding isnt? none and main is? none return Error[srcfile=source title='the entry binding is not a concrete function']
    let argv:CommandLine?=none
    if entry_literal isnt? none {
        let entry=hir.node_at(input.nodes entry_literal)
        $runtime_assert entry is? hir.FunctionLiteral
        if entry.pos_or_kw_args.length >? 0 {argv=command_line(entry @state)}
    }
    if state.problem isnt? none return state.problem
    loop function in state.generated {functions.push(function)}
    let normalized=statements.normalize(program.Program[functions globals startup main needs_startup=true source=source argv_prologue=if argv is? none none else argv.prologue argv_value=if argv is? none none else argv.value] emit.Input[state.nodes state.type_nodes input.source_files])
    loop note in state.copy_notes {
        if note.explicit or not note.runtime_sized or note.source is? none or note.source not in? state.explicit_copy_sources {continue}
        $runtime_assert note.source <? state.input.source_files.length
        return Error[srcfile=state.input.source_files[note.source] title='unproven copy'
            pointers=[Pointer[note.loc "{note.kind} copied when {note.site}: {note.reason}"]]
            hint='use `.copy()` for an independent value, or a required read-only view when the source can stay stable'
            notes=['This module enables `$explicit_copies`; COW sharing does not prove that a logical copy is free.']]
    }
    return Result[normalized.program normalized.input state.copy_notes]
}

# C argv is process-lifetime byte storage. Describe each validated UTF-8
# argument as a Dewy string, including argv[0], and place the handles in an
# independently mutable array. This setup runs after library startup.
CommandLine:type = const [prologue:array<addr> value:addr]
command_line = (entry:hir.FunctionLiteral @state:State):>CommandLine => {
    let prefix:array<addr>=[]
    let integer=types.primitive('int64' @state.type_nodes)
    let empty=types.primitive('void' @state.type_nodes)
    let boolean=types.primitive('bool' @state.type_nodes)
    let argc=put(hir.ExpressedIdentifier[entry.loc integer '__dewy_argc'] @state)
    let argv=put(hir.ExpressedIdentifier[entry.loc integer '__dewy_argv'] @state)
    let output=array_memory(argc 8 entry @state)
    loop item in output.prefix {prefix.push(item)}
    let cursor=snapshot(word(0 entry @state) @prefix @state)
    let body:array<addr>=[]
    let offset=word_op('__mul__' cursor word(8 entry @state) entry @state)
    let data=snapshot(read_word(word_op('__add__' argv offset entry @state) 0 entry @state) @body @state)
    let length=snapshot(word(0 entry @state) @body @state)
    let byte=intrinsic_call('__load_u8__' [word_op('__add__' data length entry @state)] types.primitive('uint8' @state.type_nodes) entry @state)
    let more=intrinsic_call('__ne__' [byte put(hir.Integer[entry.loc types.primitive('uint8' @state.type_nodes) '0d' 0] @state)] boolean entry @state)
    let next=put(hir.Assign[entry.loc empty length '=' word_op('__add__' length word(1 entry @state) entry @state)] @state)
    let scan=put(hir.LoopArm[entry.loc empty more sequence([next] entry @state)] @state)
    body.push(put(hir.Flow[entry.loc empty [scan] none] @state))
    # argv bytes belong to the process startup stack, not the arena.
    let owned_data=snapshot(allocation(length entry @state) @body @state)
    body.push(counted_bytes(data owned_data word(0 entry @state) length entry @state))
    let decoded=snapshot(segmented_string(owned_data length entry true @state) @body @state)
    let failed=intrinsic_call('__eq__' [read_word(decoded 0 entry @state) word(0 entry @state)] boolean entry @state)
    let exit=state.runtime_helpers.get('exit')
    if exit is? none return CommandLine[[] reject(entry 'command-line decoding needs the prelude exit helper' @state)]
    let name=state.symbols.get(exit)
    if name is? none return CommandLine[[] reject(entry 'the command-line exit helper is absent from the graph' @state)]
    body.push(conditional(failed intrinsic_call(name [word(1 entry @state)] types.primitive('never' @state.type_nodes) entry @state) entry @state))
    body.push(store_word(read_word(decoded 8 entry @state) word_op('__add__' output.data offset entry @state) 0 entry @state))
    body.push(release_block(decoded word(16 entry @state) entry @state))
    body.push(put(hir.Assign[entry.loc empty cursor '=' word_op('__add__' cursor word(1 entry @state) entry @state)] @state))
    let condition=intrinsic_call('__lt__' [cursor argc] boolean entry @state)
    let iteration=put(hir.LoopArm[entry.loc empty condition sequence(body entry @state)] @state)
    prefix.push(put(hir.Flow[entry.loc empty [iteration] none] @state))
    return CommandLine[prefix output.descriptor]
}

# Iterator setup belongs to the point where its flow arm is reached, not the
# containing function. The condition advances the cursor so `continue`
# advances exactly once as well. An exhausted sequence never reads an item.
# `entry` holds the element store of a plain single iterator: it runs at
# the top of the body, so the condition itself stays a comparison instead of
# a flow writing a flag slot. Formula leaves keep the store in the condition.
IteratorStep:type = [prefix:array<addr> condition:addr entry:array<addr>=[]]
# A character range target: a frame-resident one-scalar string, rebuilt on
# every step from the counter's dense ordinal (the surrogate gap skipped),
# with a control word of zero so it is never released. Its storage is
# reserved once per loop site.
scalar_string = (ordinal:addr node:hir.AST @prefix:array<addr> @state:State):>addr => {
    let word_type=types.primitive('int64' @state.type_nodes)
    let void_type=types.primitive('void' @state.type_nodes)
    let bool_type=types.primitive('bool' @state.type_nodes)
    let byte_type=types.primitive('uint8' @state.type_nodes)
    let u32_type=types.primitive('uint32' @state.type_nodes)
    let data=snapshot(intrinsic_call('__static_alloca__' [word(4 node @state)] word_type node @state) @prefix @state)
    let boundaries=snapshot(intrinsic_call('__static_alloca__' [word(8 node @state)] word_type node @state) @prefix @state)
    prefix.push(intrinsic_call('__store_u32__' [put(hir.Transmute[node.loc u32_type word(0 node @state)] @state) boundaries] void_type node @state))
    let descriptor=snapshot(string_memory(data word(0 node @state) boundaries word(1 node @state) word(0 node @state) node @state static_storage=true) @prefix @state)
    let steps:array<addr>=[]
    let scalar=snapshot(ordinal @steps @state)
    steps.push(conditional(intrinsic_call('__ge__' [scalar word(0xD800 node @state)] bool_type node @state) put(hir.Assign[node.loc void_type scalar '=' word_op('__add__' scalar word(0x800 node @state) node @state)] @state) node @state))
    let length=snapshot(word(1 node @state) @steps @state)
    # UTF-8 encoding by scalar magnitude: a leading byte plus continuation
    # bytes of six bits each.
    let b0=word_op('__add__' data word(0 node @state) node @state)
    let b1=word_op('__add__' data word(1 node @state) node @state)
    let b2=word_op('__add__' data word(2 node @state) node @state)
    let b3=word_op('__add__' data word(3 node @state) node @state)
    let mask=word(0x3F node @state)
    let cont0=word_op('__add__' word(0x80 node @state) word_op('__and__' scalar mask node @state) node @state)
    let cont6=word_op('__add__' word(0x80 node @state) word_op('__and__' word_op('__rshift__' scalar word(6 node @state) node @state) mask node @state) node @state)
    let cont12=word_op('__add__' word(0x80 node @state) word_op('__and__' word_op('__rshift__' scalar word(12 node @state) node @state) mask node @state) node @state)
    let one=sequence([intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type scalar] @state) b0] void_type node @state)] node @state)
    let two=sequence([
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type word_op('__add__' word(0xC0 node @state) word_op('__rshift__' scalar word(6 node @state) node @state) node @state)] @state) b0] void_type node @state)
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type cont0] @state) b1] void_type node @state)
        put(hir.Assign[node.loc void_type length '=' word(2 node @state)] @state)] node @state)
    let three=sequence([
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type word_op('__add__' word(0xE0 node @state) word_op('__rshift__' scalar word(12 node @state) node @state) node @state)] @state) b0] void_type node @state)
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type cont6] @state) b1] void_type node @state)
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type cont0] @state) b2] void_type node @state)
        put(hir.Assign[node.loc void_type length '=' word(3 node @state)] @state)] node @state)
    let four=sequence([
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type word_op('__add__' word(0xF0 node @state) word_op('__rshift__' scalar word(18 node @state) node @state) node @state)] @state) b0] void_type node @state)
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type cont12] @state) b1] void_type node @state)
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type cont6] @state) b2] void_type node @state)
        intrinsic_call('__store_u8__' [put(hir.Transmute[node.loc byte_type cont0] @state) b3] void_type node @state)
        put(hir.Assign[node.loc void_type length '=' word(4 node @state)] @state)] node @state)
    let arms=[
        put(hir.IfArm[node.loc void_type intrinsic_call('__lt__' [scalar word(0x80 node @state)] bool_type node @state) one] @state)
        put(hir.IfArm[node.loc void_type intrinsic_call('__lt__' [scalar word(0x800 node @state)] bool_type node @state) two] @state)
        put(hir.IfArm[node.loc void_type intrinsic_call('__lt__' [scalar word(0x10000 node @state)] bool_type node @state) three] @state)]
    steps.push(put(hir.Flow[node.loc void_type arms four] @state))
    steps.push(intrinsic_call('__store_u32__' [put(hir.Transmute[node.loc u32_type length] @state) word_op('__add__' boundaries word(4 node @state) node @state)] void_type node @state))
    steps.push(store_word(length descriptor layouts.string_descriptor.byte_length node @state))
    steps.push(descriptor)
    return put(hir.Block[node.loc word_type steps false] @state)
}
iterator_step = (node:hir.IteratorExpression @sources:dict<addr DictParts> @state:State plain:bool=false):>IteratorStep => {
    let prefix:array<addr>=[]
    let bool_type=types.primitive('bool' @state.type_nodes)
    let void_type=types.primitive('void' @state.type_nodes)
    let source=hir.node_at(state.input.nodes node.iterable)
    let target=hir.node_at(state.input.nodes node.target)
    $runtime_assert target is? hir.ExpressedIdentifier

                prefix.push(dict_ensure(parts node @state compact=true))
                sources[source.dictionary]=parts
                if parts.owner_type isnt? none {
                    $runtime_assert state.cleanup_frames.length >? 0
                    let frame=state.cleanup_frames.pop
                    frame.push(OwnedLocal[parts.pointer parts.owner_type])
                    state.cleanup_frames.push(frame)
                }
            }
            sequence=dict_field(parts source.name node @state)
        } else {sequence=snapshot(expression(node.iterable @state) @prefix @state)}
        if source isnt? hir.DictEntries and temporary_owner(node.iterable @state) {
            # lower_flow gives iterator setup its own cleanup frame. Body
            # continues keep this owner; leaving the arm or returning from
            # the function releases it after the last borrowed element use.
            $runtime_assert state.cleanup_frames.length >? 0
            let frame=state.cleanup_frames.pop
            frame.push(OwnedLocal[sequence source.value_type])
            state.cleanup_frames.push(frame)
        }
        let array=array_type(source.value_type state)
        if array isnt? none {
            let layout=layouts.element(array.element @state.type_nodes nominals=state.layout_context.nominals)
            if layout is? layouts.Pending return IteratorStep[prefix reject(node layout.detail @state)]
            length=snapshot(read_word(sequence layouts.array_descriptor.length node @state) @prefix @state)
            let data=snapshot(read_word(sequence 0 node @state) @prefix @state)
            let pointer=word_op('__add__' data word_op('__mul__' cursor word(layout.size node @state) node @state) node @state)
            value=array_load(pointer array.element node @state)
        } else if string_type(source.value_type state) {
            prefix.push(ensure_segmented(sequence node @state))
            length=snapshot(read_word(sequence layouts.string_descriptor.grapheme_length node @state) @prefix @state)
            value=string_view(sequence cursor word(1 node @state) node @state)
            let owner=if boxed array_load(into target.value_type node @state) else into
            view_owner=owner
            if state.cleanup_enabled {
                $runtime_assert state.cleanup_frames.length >? 0
                let frame=state.cleanup_frames.pop
                frame.push(OwnedLocal[owner target.value_type])
                state.cleanup_frames.push(frame)
            }
        } else return IteratorStep[prefix reject(node 'this iterator sequence representation' @state)]
    }
    let increment=put(hir.Assign[node.loc void_type cursor '=' word_op('__add__' cursor word(1 node @state) node @state)] @state)
    let available=if length is? none put(hir.Bool[node.loc bool_type true] @state) else intrinsic_call('__lt__' [cursor length] bool_type node @state)
    let store=if boxed array_store(value into target.value_type node @state) else put(hir.Assign[node.loc void_type into '=' value] @state)
    if optional_target {
        $runtime_assert payload isnt? none
        let writes:array<addr>=[]

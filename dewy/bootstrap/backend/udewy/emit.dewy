from reporting import SrcFile, Error, Pointer
import p"debug.dewy" as debug
import p"../../semantic/hir.dewy" as hir
import p"../../semantic/ty.dewy" as types
import p"../../semantic/type_display.dewy" as display
import p"../../semantic/builtins.dewy" as builtins

doc"""
Emit the HIR subset produced by µDewy lowering. Semantic HIR must first
legalize captures, overloads, aggregate storage, defaults, keyword slots,
and labeled loop exits. Reaching an unlowered node is an explicit error.

Operand parentheses preserve the hosted emitter's conservative policy.
Precedence-aware minimization remains an optional later improvement.
Debug locations and variable formatters belong to the program emitter;
this module handles expressions, statements, and concrete function units.
"""

Input:type = const [nodes:array<hir.AST> types:types.Table source_files:array<SrcFile>=[]]
Scope:type = [
    direct_functions:set<string>=set[]
    locals:set<string>=set[]
    source:SrcFile=SrcFile['input' '']
    debug_locations:bool=false
    debug_source:debug.Source?=none
    # Locals that are only ever another never-reassigned local or a literal:
    # their declarations are not written and their reads name the source.
    forwards:dict<string string>=[]
]
State:type = [
    includes:dict<string string>=[]
    problem:Error?=none
    # Names of the program's global declarations: never alias sources.
    globals:set<string>=set[]
]
const binary:dict<string string>=[
    '__add__'->'+' '__sub__'->'-' '__mul__'->'*'
    '__floordiv__'->'//' '__mod__'->'%'
    '__lshift__'->'<<' '__rshift__'->'>>'
    '__eq__'->'=?' '__ne__'->'not=?' '__lt__'->'<?' '__gt__'->'>?'
    '__le__'->'<=?' '__ge__'->'>=?'
    '__and__'->'and' '__or__'->'or' '__xor__'->'xor'
    '__nand__'->'nand' '__nor__'->'nor' '__xnor__'->'xnor'
]
const prefix:dict<string string>=['__unary_sub__'->'-' '__not__'->'not']
const unsigned:dict<string string>=[
    '__floordiv__'->'__unsigned_idiv__' '__mod__'->'__unsigned_mod__'
    '__lt__'->'__unsigned_lt__' '__le__'->'__unsigned_lte__'
    '__gt__'->'__unsigned_gt__' '__ge__'->'__unsigned_gte__'
]
const widths:dict<string uint8>=[
    'int8'->8 'int16'->16 'int32'->32 'int64'->64
    'uint8'->8 'uint16'->16 'uint32'->32 'uint64'->64
]
const wrapping:set<string>=set[
    '__add__' '__sub__' '__mul__' '__floordiv__' '__mod__'
    '__and__' '__or__' '__xor__' '__nand__' '__nor__' '__xnor__'
]
const derived:dict<string string>=['__nand__'->'and' '__nor__'->'or' '__xnor__'->'xor']
const alphabet='0123456789abcdef'
# µDewy identifiers stay ASCII even when a Dewy debug symbol carries a source
# name. Escaping the prefix too makes this encoding injective. Ordinary native
# symbols already use binding ids, so they need no encoding on the hot path.
name = (text:string):>string => {
    let bytes=text as array<uint8>
    let plain=not text.startswith('__dewy_encoded_')
    loop byte in bytes {
        if not (byte >=? 65 and byte <=? 90 or byte >=? 97 and byte <=? 122 or byte >=? 48 and byte <=? 57 or byte =? 95) {plain=false; break}
    }
    if plain return text
    let parts:array<string>=['__dewy_encoded_']
    loop byte in bytes {parts.push(hex_byte(byte))}
    return parts.join('')
}
intrinsic_names = ():>set<string> => {
    let nodes:types.Table=types.Table[]
    let functions=builtins.intrinsic_types(@nodes)
    return functions.keys
}
const intrinsics=intrinsic_names()

# µDewy's include preprocessor reads the path literally, unlike an ordinary
# runtime string. Paths needing quote/escape syntax can still embed their
# bytes directly; they must not be emitted as a different filesystem name.
include_path_literal = (path:string):>bool => {
    let bytes=path as array<uint8>
    loop byte in bytes {if byte in? [10 13 34 92] return false}
    return true
}

reject = (node:hir.AST message:string scope:Scope @state:State):>void => {
    if state.problem is? none {
        state.problem=Error[srcfile=scope.source title='unlowered HIR reached µDewy emission' pointers=[Pointer[span=node.loc message=message]]]
    }
}
annotation = (id:addr input:Input):>string => {
    let node=types.node_at(input.types id)
    return if types.is_primitive(node 'never') 'void' else display.type_to_dewy(id input.types)
}
hex_byte = (byte:uint8):>string => alphabet[byte // 16] + alphabet[byte % 16]
# Build one ASCII buffer for each literal. Escaping every printable byte
# expanded text fourfold, and formatting one string per byte multiplied both
# allocation traffic and the writer's fragment count.
# µDewy rejects interpolation syntax, so braces remain escaped too.
const hex_digits=0x"30313233343536373839616263646566" as array<uint8>
text_literal = (text:string):>string => {
    let bytes=text as array<uint8>
    let encoded:array<uint8>=[34]
    loop byte in bytes {
        if byte >=? 32 and byte <=? 126 and byte not=? 34 and byte not=? 92 and byte not=? 123 and byte not=? 125 {encoded.push(byte)}
        else {
            encoded.push(92) encoded.push(120)
            encoded.push(hex_digits[byte // 16]) encoded.push(hex_digits[byte % 16])
        }
    }
    encoded.push(34)
    let result=encoded as string|none
    $runtime_assert result isnt? none
    return result
}
binary_literal = (bytes:array<uint8>):>string => {
    let encoded:array<uint8>=[48 120 34]
    loop byte in bytes {
        encoded.push(hex_digits[byte // 16]) encoded.push(hex_digits[byte % 16])
    }
    encoded.push(34)
    let result=encoded as string|none
    $runtime_assert result isnt? none
    return result
}
integer_literal = (node:hir.Integer):>string => {
    if node.prefix not in? ['0x' '0b'] return _bigint_as_string(node.value)
    let radix:bigint & ~0=if node.prefix =? '0x' 16 else 2
    let remaining=node.value
    let negative=remaining <? 0
    if negative {remaining = -remaining}
    let reversed:array<string>=[]
    loop remaining >? 0 {
        let digit=remaining % radix
        $runtime_assert digit >=? 0 and digit <? 16
        reversed.push(alphabet[digit as int64])
        remaining //= radix
    }
    if reversed.length =? 0 {reversed.push('0')}
    let parts:array<string>=[if negative '-' else '' node.prefix]
    loop reversed.length >? 0 {parts.push(reversed.pop)}
    return parts.join
}
# All recursive visits share one writer. In particular, a block never joins
# and re-indents its children's complete strings. Indentation is emitted once
# per nonempty line, and the final output is joined only at the public boundary.
Writer:type = [parts:array<string>=[] indents:array<string>=[''] depth:addr=0 line_start:bool=true]
# Fragments are single-line syntax (source string contents are escaped).
# Only newline changes line state, so empty lines acquire no trailing spaces.
write = (text:string @out:Writer):>void => {
    if text.length =? 0 return
    if out.line_start {
        $runtime_assert out.depth <? out.indents.length
        if out.depth >? 0 {out.parts.push(out.indents[out.depth])}
        out.line_start=false
    }
    out.parts.push(text)
}
newline = (@out:Writer):>void => {out.parts.push('\n') out.line_start=true}
nest = (@out:Writer):>void => {
    out.depth+=1
    if out.depth =? out.indents.length {
        $runtime_assert out.depth >? 0 and out.depth-1 <? out.indents.length
        out.indents.push(out.indents[out.depth-1]+'    ')
    }
}
unnest = (@out:Writer):>void => {$runtime_assert out.depth >? 0 out.depth-=1}
first_parameter = (call:hir.FunctionCall input:Input):>string? => {
    let function=hir.node_at(input.nodes call.func)
    if function isnt? hir.ExpressedIdentifier return none
    let type=types.node_at(input.types function.value_type)
    if type isnt? types.FunctionType or type.pos_or_kw.length =? 0 return none
    let operand=types.node_at(input.types type.pos_or_kw[0].value_type)
    if operand isnt? types.Primitive return none
    if operand.name =? 'int' return 'int64'
    if operand.name =? 'uint' return 'uint64'
    return operand.name
}
# Narrow integer wrapping surrounds a streamed operand without materializing
# its text. Prefix and suffix must agree with the selected parameter width.
wrap_open = (type:string? @out:Writer):>void => {
    if type is? none return
    let width=widths.get(type)
    if width is? none or width =? 64 return
    $runtime_assert width >? 0 and width <? 64
    write(if type.startswith('u') '(' else '__signed_shr__((' @out)
}
wrap_close = (type:string? @out:Writer):>void => {
    if type is? none return
    let width=widths.get(type)
    if width is? none or width =? 64 return
    $runtime_assert width >? 0 and width <? 64
    if type.startswith('u') {write(") and {(1 << width)-1}" @out) return}
    let shift=64-(width as int64)
    write(") << {shift} {shift})" @out)
}
is_binary = (node:hir.AST input:Input):>bool => {
    if node isnt? hir.FunctionCall or node.pos_args.length not=? 2 or node.kw_args.length >? 0 return false
    let function=hir.node_at(input.nodes node.func)
    return function is? hir.ExpressedIdentifier and function.name in? binary
}
is_prefix = (node:hir.AST input:Input):>bool => {
    if node isnt? hir.FunctionCall or node.pos_args.length not=? 1 or node.kw_args.length >? 0 return false
    let function=hir.node_at(input.nodes node.func)
    return function is? hir.ExpressedIdentifier and function.name in? prefix
}
write_operand = (id:addr @scope:Scope input:Input @state:State @out:Writer):>void => {
    let node=hir.node_at(input.nodes id)
    let parens=is_binary(node input) or node is? hir.Transmute|hir.ShortCircuit
    if parens {write('(' @out)}
    write_ast(id @scope input @state @out)
    if parens {write(')' @out)}
}
write_argument = (id:addr @scope:Scope input:Input @state:State @out:Writer):>void => {
    let node=hir.node_at(input.nodes id)
    let parens=node is? hir.Transmute or node is? hir.Integer and node.value <? 0 or is_prefix(node input)
    if parens {write('(' @out)}
    write_ast(id @scope input @state @out)
    if parens {write(')' @out)}
}
# A call spelled by name: a declared function or an intrinsic that no local
# shadows. Anything else calls through a function value.
direct_call = (call:hir.FunctionCall @scope:Scope input:Input):>bool => {
    let function=hir.node_at(input.nodes call.func)
    if function isnt? hir.ExpressedIdentifier return false
    return (function.name in? scope.direct_functions or function.name in? intrinsics) and function.name not in? scope.locals
}
write_call = (call:hir.FunctionCall @scope:Scope input:Input @state:State @out:Writer):>void => {
    if call.kw_args.length >? 0 {reject(call 'keyword arguments require positional legalization' scope @state) return}
    let function=hir.node_at(input.nodes call.func)
    if function is? hir.ExpressedIdentifier {
        let name=function.name
        let type=first_parameter(call input)
        if call.pos_args.length =? 2 {
            let left=call.pos_args[0] let right=call.pos_args[1]
            if name in? ['__dewy_raw_lshift__' '__dewy_raw_rshift__'] {
                write('(' @out) write_operand(left @scope input @state @out)
                write(if name =? '__dewy_raw_lshift__' ' << ' else ' >> ' @out)
                write_operand(right @scope input @state @out) write(')' @out) return
            }
            let helper:string?=none
            if name in? unsigned and type isnt? none and type in? widths and type.startswith('u') {helper=unsigned[name]}
            if name =? '__rshift__' {
                if type is? none or type not in? widths {reject(call 'right shift requires a selected integer width' scope @state) return}
                if not type.startswith('u') {helper='__signed_shr__'}
            }
            if helper isnt? none {
                write(helper @out) write('(' @out) write_ast(left @scope input @state @out)
                write(' ' @out) write_ast(right @scope input @state @out) write(')' @out) return
            }
            if name in? binary {
                if name in? wrapping {wrap_open(type @out)}
                if name in? derived {write('not (' @out)}
                write_operand(left @scope input @state @out)
                write(' ' @out) write(if name in? derived derived[name] else binary[name] @out) write(' ' @out)
                write_operand(right @scope input @state @out)
                if name in? derived {write(')' @out)}
                if name in? wrapping {wrap_close(type @out)}
                return
            }
        }
        if call.pos_args.length =? 1 and name in? prefix {
            wrap_open(type @out) write(prefix[name] @out)
            if name =? '__not__' {write(' ' @out)}
            write_operand(call.pos_args[0] @scope input @state @out)
            wrap_close(type @out) return
        }
    }
    if function is? hir.ExpressedIdentifier {
        let direct=direct_call(call @scope input)
        if not direct {write('(@' @out)}
        write(function.name @out)
        if not direct {write(')' @out)}
    } else {
        let parens=function isnt? hir.Block or function.scoped
        if parens {write('(' @out)}
        write_ast(call.func @scope input @state @out)
        if parens {write(')' @out)}
    }
    write('(' @out)
    let first=true
    loop item in call.pos_args {
        if not first {write(' ' @out)} first=false
        write_argument(item @scope input @state @out)
    }
    write(')' @out)
}

# A statement list owns separators, but leaves its final line open. This
# preserves empty blocks, debug markers, and declaration shadowing exactly.
# Forwarding: a `let` whose initializer is a never-reassigned local, a
# parameter or an integer/bool literal, and that is itself never reassigned,
# is an alias. Writing the source at each read instead removes about an
# eighth of the emitted statements and the backend's stack slots for them.
collect_forwards = (root:addr input:Input @assigned:set<string> @candidates:array<addr>):>void => {
    let pending:array<addr>=[root]
    loop pending.length >? 0 {
        let id=pending.pop
        let node=hir.node_at(input.nodes id)
        if node is? hir.FunctionLiteral continue
        if node is? hir.Assign {
            let target=hir.node_at(input.nodes node.target)
            if target is? hir.ExpressedIdentifier {assigned.add(target.name)}
        }
        if node is? hir.Declare and node.decltype =? 'let' {
            let expr=hir.node_at(input.nodes node.expr)
            if expr is? hir.ExpressedIdentifier|hir.Integer|hir.Bool and node.annotation isnt? none and node.annotation =? expr.value_type and types.node_at(input.types expr.value_type) isnt? types.CallableType {candidates.push(id)}
        }
        hir.push_children(node @pending)
    }
    return void
}
function_forwards = (function:hir.FunctionLiteral input:Input state:State):>dict<string string> => {
    let assigned:set<string>=set[]
    let candidates:array<addr>=[]
    collect_forwards(function.body input @assigned @candidates)
    # The worklist visits declarations out of source order, so record each
    # alias's immediate source first and resolve chains afterwards: a read
    # must name a local that is actually written out, never a dropped alias.
    let sources:dict<string string>=[]
    loop id in candidates {
        let node=hir.node_at(input.nodes id)
        $runtime_assert node is? hir.Declare
        if node.name in? assigned continue
        let expr=hir.node_at(input.nodes node.expr)
        if expr is? hir.ExpressedIdentifier {
            # Only this function's own never-reassigned locals and parameters:
            # a global may be written by any callee between the snapshot and
            # its use. Every non-global name read here is such a local.
            if expr.name in? assigned or expr.name in? state.globals continue
            sources[node.name]=expr.name
        } else if expr is? hir.Integer {
            # A bare negative literal in operand position would read as a
            # binary minus; the parenthesized form is an atom everywhere.
            let literal=integer_literal(expr)
            sources[node.name]=if literal.startswith('-') "({literal})" else literal
        }
        else if expr is? hir.Bool {sources[node.name]=if expr.value 'true' else 'false'}
    }
    let forwards:dict<string string>=[]
    loop [name source] in sources {
        let target=source
        let hops=0
        loop target in? sources and hops <? 64 {
            let next=sources.get(target)
            if next is? none break
            target=next hops+=1
        }
        forwards[name]=target
    }
    return forwards
}
write_statements = (items:array<addr> @scope:Scope input:Input @state:State @out:Writer):>void => {
    let first=true
    let count:int64=items.length
    let index:int64=0
    loop id in items {
        index+=1
        let node=hir.node_at(input.nodes id)
        if node is? hir.Declare and node.name in? scope.forwards continue
        if node is? hir.Void and index <? count continue
        if not first {newline(@out)} first=false
        if scope.debug_source isnt? none {
            let marker=debug.marker(hir.node_at(input.nodes id).loc scope.debug_source)
            if marker isnt? none {write(marker @out) newline(@out)}
        }
        write_ast(id @scope input @state @out)
        if node is? hir.Declare {scope.locals.add(node.name)}
    }
}
write_flow_body = (id:addr @scope:Scope input:Input @state:State @out:Writer):>void => {
    let node=hir.node_at(input.nodes id)
    if node is? hir.Block and node.scoped {write_ast(id @scope input @state @out) return}
    write(r'{' @out) newline(@out) nest(@out)
    write_ast(id @scope input @state @out)
    unnest(@out) newline(@out) write(r'}' @out)
}
write_ast = (id:addr @scope:Scope input:Input @state:State @out:Writer):>void => {
    if state.problem isnt? none return
    let node=hir.node_at(input.nodes id)
    if node is? hir.Integer {write(integer_literal(node) @out) return}
    if node is? hir.String {write(text_literal(node.content) @out) return}
    if node is? hir.Bool {write(if node.value 'true' else 'false' @out) return}
    if node is? hir.Void {write('void' @out) return}
    if node is? hir.BasedString {
        if node.include_path isnt? none and include_path_literal(node.include_path) {
            let path=node.include_path
            let existing=state.includes.get(path)
            if existing isnt? none {write(existing @out) return}
            let name="__dewy_include_{state.includes.length+1}"
            state.includes[path]=name
            write(name @out) return
        }
        write(binary_literal(node.content) @out) return
    }
    if node is? hir.ExpressedIdentifier {
        let forwarded=scope.forwards.get(node.name)
        if forwarded isnt? none {write(forwarded @out) return}
        if types.node_at(input.types node.value_type) is? types.CallableType {write('@' @out)}
        write(node.name @out) return
    }
    if node is? hir.FunctionCall {write_call(node @scope input @state @out) return}
    if node is? hir.ValueCast {write_ast(node.expr @scope input @state @out) return}
    if node is? hir.Transmute {
        # µDewy reads `(@f)(x) transmute T` as a call followed by a stray
        # token; an indirect call operand needs its own parentheses.
        let inner=hir.node_at(input.nodes node.expr)
        let indirect=inner is? hir.FunctionCall and not direct_call(inner @scope input)
        let parens=inner is? hir.Transmute or indirect
        if parens {write('(' @out)} write_ast(node.expr @scope input @state @out)
        if parens {write(')' @out)}
        write(' transmute ' @out) write(annotation(node.value_type input) @out) return
    }
    if node is? hir.Return {
        write('return ' @out)
        if node.item is? none {write('void' @out)} else {write_ast(node.item @scope input @state @out)}
        return
    }
    if node is? hir.Break|hir.Continue {
        if node.label isnt? none or node.loop_levels not=? 0 {reject(node 'labeled loop exits require legalization' scope @state) return}
        write(if node is? hir.Break 'break' else 'continue' @out) return
    }
    if node is? hir.Declare {
        if node.name in? scope.forwards return
        if hir.node_at(input.nodes node.expr) is? hir.FunctionLiteral {reject(node 'local functions require hoisting' scope @state) return}
        let type=if node.annotation is? none hir.node_at(input.nodes node.expr).value_type else node.annotation
        write("{node.decltype} {node.name}:{annotation(type input)} = " @out)
        write_ast(node.expr @scope input @state @out) return
    }
    if node is? hir.Assign {
        let target=hir.node_at(input.nodes node.target)
        if target isnt? hir.ExpressedIdentifier {reject(node 'a projected assignment requires storage lowering' scope @state) return}
        write("{target.name} {node.op} " @out) write_ast(node.value @scope input @state @out) return
    }
    if node is? hir.ShortCircuit {
        let left_parens=hir.node_at(input.nodes node.left) is? hir.ShortCircuit
        let right_parens=hir.node_at(input.nodes node.right) is? hir.ShortCircuit
        if left_parens {write('(' @out)} write_ast(node.left @scope input @state @out)
        if left_parens {write(')' @out)}
        write(" {node.op} " @out)
        if right_parens {write('(' @out)} write_ast(node.right @scope input @state @out)
        if right_parens {write(')' @out)} return
    }
    if node is? hir.Block {
        if not node.scoped and node.items.length =? 1 {
            let item=hir.node_at(input.nodes node.items[0])
            let parens=item isnt? hir.Assign|hir.MemberAssign|hir.IndexAssign|hir.DictStore|hir.Declare|hir.Return|hir.Break|hir.Continue
            if parens {write('(' @out)} write_ast(node.items[0] @scope input @state @out)
            if parens {write(')' @out)} return
        }
        write(if node.scoped r'{' else '(' @out) newline(@out) nest(@out)
        if node.scoped {
            let child=scope
            write_statements(node.items @child input @state @out)
        } else {write_statements(node.items @scope input @state @out)}
        unnest(@out) newline(@out) write(if node.scoped r'}' else ')' @out) return
    }
    if node is? hir.Flow {
        let first=true
        loop id in node.arms {
            let arm=hir.node_at(input.nodes id)
            if arm isnt? hir.IfArm|hir.LoopArm {reject(arm 'a flow arm must be conditional or a loop' scope @state) return}
            if not first {write(' else ' @out)} first=false
            write(if arm is? hir.IfArm 'if ' else 'loop ' @out)
            write_ast(arm.condition @scope input @state @out) write(' ' @out)
            write_flow_body(arm.body @scope input @state @out)
        }
        if node.default isnt? none {
            if not first {write(' else ' @out)}
            write_flow_body(node.default @scope input @state @out)
        }
        return
    }
    reject(node "{node.typename} needs lowering" scope @state)
}

# Convenient expression boundary for tools and tests. Program rendering uses
# write_ast directly so a whole compilation shares its output buffer.
ast = (id:addr @scope:Scope input:Input @state:State):>string => {
    let out=Writer[]
    write_ast(id @scope input @state @out)
    return out.parts.join
}

contains_return = (id:addr input:Input):>bool => {
    let node=hir.node_at(input.nodes id)
    if node is? hir.Return return true
    if node is? hir.Suppress return contains_return(node.item input)
    if node is? hir.Block {
        loop item in node.items {if contains_return(item input) return true}
    }
    if node is? hir.Flow {
        loop id in node.arms {
            let arm=hir.node_at(input.nodes id)
            if arm is? hir.IfArm|hir.LoopArm and contains_return(arm.body input) return true
        }
        if node.default isnt? none return contains_return(node.default input)
    }
    return false
}
write_function = (name:string function:hir.FunctionLiteral scope:Scope input:Input @state:State @out:Writer):>void => {
    if function.kw_only_args.length >? 0 or function.rest_args isnt? none {reject(function 'function parameters require positional legalization' scope @state) return}
    let inner=Scope[scope.direct_functions set[] if function.source is? none scope.source else hir.source_at(function.source input.source_files)]
    inner.forwards=function_forwards(function input state)
    if scope.debug_locations and function.source isnt? none {inner.debug_locations=true inner.debug_source=debug.prepare(hir.source_at(function.source input.source_files))}
    write("let {name} = (" @out)
    let first=true
    loop arg in function.pos_or_kw_args {
        if arg is? hir.BoundParam {reject(function 'default parameters require legalization' scope @state) return}
        if not first {write(' ' @out)} first=false
        write("{arg.name}:{annotation(arg.value_type input)}" @out)
        inner.locals.add(arg.name)
    }
    write("):>{annotation(function.rettype input)} => " @out)
    let body=hir.node_at(input.nodes function.body)
    # An early return in one branch does not close the other branch. Void
    # functions always have an explicit fallthrough return for the µDewy ABI.
    if types.is_primitive(types.node_at(input.types function.rettype) 'void') or types.is_primitive(types.node_at(input.types function.rettype) 'never') {
        let items:array<addr>=if body is? hir.Block body.items else [function.body]
        write(r'{' @out) newline(@out) nest(@out)
        write_statements(items @inner input @state @out)
        if items.length >? 0 {newline(@out)}
        write('return void' @out) unnest(@out) newline(@out) write(r'}' @out)
    } else if contains_return(function.body input) {write_ast(function.body @inner input @state @out)}
    else {
        write(r'{' @out) newline(@out) nest(@out) write('return ' @out)
        write_ast(function.body @inner input @state @out)
        unnest(@out) newline(@out) write(r'}' @out)
    }
}
function_decl = (name:string function:hir.FunctionLiteral scope:Scope input:Input @state:State):>string => {
    let out=Writer[]
    write_function(name function scope input @state @out)
    return out.parts.join
}

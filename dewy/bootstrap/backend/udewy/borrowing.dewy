import p"../../semantic/hir.dewy" as hir
import p"../../semantic/ty.dewy" as types
import p"../../semantic/analyze/effects.dewy" as effects
import p"captures.dewy" as captures
import p"emit.dewy" as emit
import p"callbacks.dewy" as callbacks
import p"../../semantic/subtyping.dewy" as subtyping

# Value copies remain the default. A direct callee may borrow a read-only
# aggregate argument when no later argument or place can change its storage.
# This makes arena readers practical without weakening value semantics.
Route:type = const [binding:addr fields:array<string>]
route = (id:addr nodes:array<hir.AST>):>Route? => {
    let current=id
    let reverse:array<string>=[]
    loop true {
        let node=hir.node_at(nodes current)
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=node.items[0] continue}
        if node is? hir.MemberAccess {reverse.push(node.name) current=node.value continue}
        # Unknown indices may alias; only fields above the index distinguish
        # storage. Do not infer that two different index expressions differ.
        if node is? hir.Index {reverse.clear current=node.array continue}
        if node isnt? hir.ExpressedIdentifier or node.binding_id is? none return none
        let fields:array<string>=[]
        loop reverse.length >? 0 {fields.push(reverse.pop)}
        return Route[node.binding_id fields]
    }
}
overlap = (a:Route b:Route):>bool => {
    if a.binding not=? b.binding return false
    loop i in 0.. and i <? a.fields.length and i <? b.fields.length {
        if a.fields[i] not=? b.fields[i] return false
    }
    return true
}
arguments = (call:hir.FunctionCall):>array<addr> => {
    let result=call.pos_args
    loop value in call.kw_args.values {result.push(value)}
    return result
}
# A receiver's value is evaluated before its index or later call arguments.
# Borrow it only while those expressions cannot replace or mutate its storage.
# An unknown source route (including an aliasing place parameter) overlaps all
# writes. Merely calculating an integer index does not require a snapshot.
expression_conflicts = (root:addr source:Route? nodes:array<hir.AST> plan:captures.Plan ambient:set<addr> deep:bool=true):>bool => {
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionLiteral|hir.GenericFunction continue
        if deep and node is? hir.FunctionCall {
            let direct=captures.resolve(node.func node.selected_method_index plan nodes)
            if direct isnt? none {
                if direct in? ambient return true
                let function=plan.functions.get(direct)
                if function isnt? none and source isnt? none and source.binding in? function.writes return true
            } else {
                let callee=hir.node_at(nodes node.func)
                # Only operators without runtime bindings are intrinsics. A source
                # function or callback with the same spelling still has effects.
                let pure=callee is? hir.ExpressedIdentifier and (callee.binding_id is? none or callee.binding_id not in? plan.source_bindings) and (callee.name in? emit.binary or callee.name in? emit.prefix)
                if callee is? hir.ArrayMethod {
                    if callee.name =? 'sort' and 'key' in? node.kw_args return true
                } else if not pure return true
            }
        }
        let targets:array<addr>=[]
        if node is? hir.Place {targets=[node.target]}
        else if deep {targets=captures.write_targets(node nodes)}
        loop target in targets {
            let exposed=route(target nodes)
            if source is? none or exposed is? none or overlap(source exposed) return true
        }
        if deep {loop child in hir.children(node) {pending.push(child)}}
    }
    return false
}
conflicts = (call:hir.FunctionCall position:addr source:Route nodes:array<hir.AST> plan:captures.Plan ambient:set<addr>):>bool => {
    let args=arguments(call)
    loop i in 0.. and i <? args.length {
        # Earlier evaluation has finished; only a directly passed place remains
        # live. Later arguments can mutate even when their result is an integer.
        if expression_conflicts(args[i] source nodes plan ambient deep=(i >? position)) return true
    }
    return false
}

# A place parameter can refer to caller storage that also has a global name.
# Conservatively exclude callees with ambient writes/unknown callbacks. The
# semantic parameter summaries alone cannot establish that global boundary.
word_value = (id:addr type_nodes:types.Table):>bool => {
    let type=types.node_at(type_nodes types.unfold(types.strip_refinement(id type_nodes) type_nodes))
    if type is? types.IntegerLiteralType return type.value >=? -9223372036854775808 and type.value <=? 18446744073709551615
    return type is? types.Primitive and type.name in? ['int' 'uint' 'int8' 'int16' 'int32' 'int64' 'uint8' 'uint16' 'uint32' 'uint64' 'float32' 'float64' 'bool' 'true' 'false' 'none']
}
# An ordinary value call is an ownership boundary. If its callee needs raw
# storage, lowering supplies a private copy there. That callee can retain its
# copy without retaining its caller's argument snapshot. Places and lifted
# captures cross the boundary without copying, so they still propagate storage
# exposure. Ambient mutation propagates across every call regardless.
shares_storage = (call:hir.FunctionCall target:addr plan:captures.Plan nodes:array<hir.AST>):>bool => {
    let function=plan.functions.get(target)
    if function is? none or function.captures.length >? 0 return true
    loop argument in arguments(call) {if hir.node_at(nodes argument) is? hir.Place return true}
    return false
}
# These three summaries differ in their initial facts and propagation edges,
# not in which syntax they inspect. Collect the function graph once and keep
# the ownership boundary explicit on a separate reverse edge map.
AmbientGraph:type = const [globals:set<addr> opaque:set<addr> callers:dict<addr array<addr>> shared_callers:dict<addr array<addr>>]
ambient_graph = (plan:captures.Plan nodes:array<hir.AST> type_nodes:types.Table indirect:dict<addr array<addr>>=[]):>AmbientGraph => {
    let globals:set<addr>=set[]
    let opaque:set<addr>=set[]
    let callers:dict<addr array<addr>>=[]
    let shared_callers:dict<addr array<addr>>=[]
    loop [id function] in plan.functions {
        loop binding in function.writes {if binding in? plan.globals {globals.add(id)}}
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let called:set<addr>=set[]
        let shared:set<addr>=set[]
        let pending:array<addr>=[literal.body]
        loop parameter in effects.literal_params(literal) {if parameter is? hir.BoundParam {pending.push(parameter.value)}}
        let seen:set<addr>=set[]
        loop pending.length >? 0 {
            let child=pending.pop
            if child in? seen continue
            seen.add(child)
            let node=hir.node_at(nodes child)
            if node is? hir.FunctionLiteral|hir.GenericFunction continue
            # Reporting is an intrinsic failure operation at the source level.
            # Its installed allocator/I/O calls do not expose a source argument.
            # A user-written message still runs on this path and keeps all of
            # its effects; explicit source calls to reporters remain ordinary.
            if node is? hir.RuntimeFailure {
                if node.message isnt? none {pending.push(node.message)}
                continue
            }
            # Reinterpreting scalar bits does not expose aggregate storage.
            # Pointer/aggregate transmutes and raw memory calls still prevent
            # borrowing: they can escape or mutate an otherwise read-only value.
            if node is? hir.Transmute and (not word_value(node.value_type type_nodes) or not word_value(hir.node_at(nodes node.expr).value_type type_nodes)) {opaque.add(id)}
            if node is? hir.FunctionCall {
                let callee=hir.node_at(nodes node.func)
                let direct=captures.resolve(node.func node.selected_method_index plan nodes)
                let targets:array<addr> | none = if direct is? none indirect.get(node.func) else [direct]
                if targets isnt? none {
                    loop target in targets {
                        called.add(target)
                        if shares_storage(node target plan nodes) {shared.add(target)}
                    }
                } else if callee is? hir.ExpressedIdentifier {
                    if (callee.name not in? emit.intrinsics and callee.name not in? emit.binary and callee.name not in? emit.prefix) or callee.name.startswith('__load_') or callee.name.startswith('__store_') or callee.name.startswith('__syscall') {opaque.add(id)}
                } else if callee is? hir.ArrayMethod {
                    # A sort invokes its key inside the method. In particular
                    # a function-valued parameter can hide ambient writes;
                    # it is not an ordinary HIR call with a known dependency.
                    if callee.name =? 'sort' and 'key' in? node.kw_args {opaque.add(id)}
                } else if callee is? hir.FunctionLiteral {
                    called.add(node.func)
                    if shares_storage(node node.func plan nodes) {shared.add(node.func)}
                }
                else {opaque.add(id)}
            }
            loop next in hir.children(node) {pending.push(next)}
        }
        loop target in called {
            let users=callers.get(target [])
            users.push(id)
            callers[target]=users
        }
        loop target in shared {
            let users=shared_callers.get(target [])
            users.push(id)
            shared_callers[target]=users
        }
    }
    return AmbientGraph[globals opaque callers shared_callers]
}
propagate_ambient = (initial:set<addr> callers:dict<addr array<addr>>):>set<addr> => {
    let dirty=initial
    # Dirtiness is a monotone bit. Propagate each newly dirty function to
    # its callers once; long call chains need no whole-program rescans.
    let pending:array<addr>=[]
    loop id in dirty {pending.push(id)}
    loop pending.length >? 0 {
        let id=pending.pop
        loop caller in callers.get(id []) {
            if caller in? dirty continue
            dirty.add(caller)
            pending.push(caller)
        }
    }
    return dirty
}
# Standalone query used by internal clients. The full borrowing pass below
# shares one graph across its three queries instead of rebuilding it here.
ambient_writers = (plan:captures.Plan nodes:array<hir.AST> type_nodes:types.Table opaque_only:bool=false value_boundaries:bool=false indirect:dict<addr array<addr>>=[]):>set<addr> => {
    let graph=ambient_graph(plan nodes type_nodes indirect)
    let initial=graph.opaque
    if not opaque_only {loop id in graph.globals {initial.add(id)}}
    return propagate_ambient(initial (if value_boundaries graph.shared_callers else graph.callers))
}
Plan:type = const [arguments:dict<addr set<addr>> escaping_places:set<addr> disposable_arguments:dict<addr set<addr>> array_snapshots:set<addr> stable_bindings:set<addr>=set[] stable_parameters:dict<addr effects.ParameterEffects>=[]]

# A write to state.output cannot invalidate a view into state.input. Prefix
# routes deliberately treat indices as possibly overlapping; a shortened
# summary route covers every deeper field. Rebinding/escaping the root covers
# the entire owner. Whole-binding proofs remain the cheapest common case.
stable_owner = (source:Route stable:set<addr> parameters:dict<addr effects.ParameterEffects>):>bool => {
    if source.binding in? stable return true
    let summary=parameters.get(source.binding)
    if summary is? none return false
    let changes=summary.mutates
    loop route in summary.rebinds {changes.push(route)}
    loop route in summary.escapes {changes.push(route)}
    loop route in changes {
        if overlap(source Route[source.binding route.steps]) return false
    }
    return true
}
analyze = (root:addr nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan):>dict<addr set<addr>> => details(root nodes type_nodes plan).arguments
details = (root:addr nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan links:subtyping.Graph=subtyping.default_links):>Plan => {
    let indirect=callbacks.analyze(root nodes type_nodes plan links)
    # Checked value casts borrow while evaluating but do not expose raw
    # storage. At a value boundary lowering supplies an independent owner,
    # including an aggregate wrapped into an optional result.
    let summaries=effects.analyze_effects(root nodes type_nodes indirect value_casts_escape=false)
    let ambient=ambient_graph(plan nodes type_nodes indirect)
    let initial=ambient.opaque
    loop id in ambient.globals {initial.add(id)}
    let dirty=propagate_ambient(initial ambient.callers)
    # Raw address operations and unknown callbacks can expose storage even
    # without a declared place. They always require the ordinary value copy;
    # writes to unrelated globals only matter for an aliasing place source.
    let opaque=propagate_ambient(ambient.opaque ambient.callers)
    # Borrowing must also exclude indirect raw writes that could alias caller
    # storage. Releasing an already independent snapshot only requires proving
    # that this snapshot was not itself exposed beyond the call.
    let retaining=propagate_ambient(ambient.opaque ambient.shared_callers)
    let places:set<addr>=set[]
    loop id in plan.functions.keys {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        loop parameter in effects.literal_params(literal) {
            if parameter.place and parameter.binding_id isnt? none {places.add(parameter.binding_id)}
        }
    }
    # A scope borrow needs a longer guarantee than a call-argument borrow.
    # Start conservatively: storage never written/exposed anywhere in its
    # function, with no opaque operation in that function's call graph.
    # Binding ids are program-unique. Captures, globals and place parameters
    # may have another name outside this scope, so exclude them altogether.
    # This reuses the existing graph instead of rescanning a body per local.
    let captured:set<addr>=set[]
    loop function in plan.functions.values {
        loop binding in function.captures {captured.add(binding)}
    }
    let stable:set<addr>=set[]
    let stable_parameters:dict<addr effects.ParameterEffects>=[]
    loop [id function] in plan.functions {
        if id in? opaque continue
        loop binding in function.locals {
            if binding not in? function.writes and binding not in? places and binding not in? plan.globals and binding not in? captured {stable.add(binding)}
        }
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let parameters=effects.literal_params(literal)
        let place_count:addr=0
        loop parameter in parameters {if parameter.place {place_count+=1}}
        loop parameter in parameters {
            let binding=parameter.binding_id
            if binding is? none or binding in? captured or binding in? plan.globals continue
            # A place owner can also be named by a global. Exclude ambient
            # writes and, conservatively, functions with multiple places.
            if parameter.place and (place_count not=? 1 or id in? dirty) continue
            let summary=summaries.by_param_binding.get(binding)
            if summary isnt? none {stable_parameters[binding]=summary}
        }
    }
    let array_snapshots:set<addr>=set[]
    let result:dict<addr set<addr>>=[]
    let disposable:dict<addr set<addr>>=[]
    let safe_places:set<addr>=set[]
    let unsafe_places:set<addr>=set[]
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.add(id)
        let node=hir.node_at(nodes id)
        loop child in hir.children(node) {pending.push(child)}
        if node is? hir.Index {
            let source=route(node.array nodes)
            # A place may alias a different parameter's route. Its spelling
            # cannot establish disjoint storage from another written route.
            if source isnt? none and source.binding in? places {source=none}
            if expression_conflicts(node.index source nodes plan dirty) {array_snapshots.add(id)}
        }
        if node isnt? hir.FunctionCall continue
        let callee=hir.node_at(nodes node.func)
        let direct=captures.resolve(node.func node.selected_method_index plan nodes)
        let targets:array<addr> | none = if direct is? none indirect.get(node.func) else [direct]
        if targets is? none {
            loop argument in arguments(node) {if hir.node_at(nodes argument) is? hir.Place {unsafe_places.add(argument)}}
            continue
        }
        let allowed_all:set<addr>=set[]
        loop argument in arguments(node) {allowed_all.add(argument)}
        let temporary_all=allowed_all
        loop direct in targets {
            let literal=hir.node_at(nodes direct)
            $runtime_assert literal is? hir.FunctionLiteral
            let pairs=effects.pair_arguments(node literal)
            if pairs is? none {
                loop argument in arguments(node) {if hir.node_at(nodes argument) is? hir.Place {unsafe_places.add(argument)}}
                allowed_all.clear temporary_all.clear
                break
            }
            loop pair in pairs {
                if hir.node_at(nodes pair.argument) isnt? hir.Place continue
                let summary=if pair.parameter is? none none else summaries.by_param_binding.get(pair.parameter)
                if summary isnt? none and summary.escapes.length =? 0 {safe_places.add(pair.argument)}
                else {unsafe_places.add(pair.argument)}
            }
            let allowed:set<addr>=set[]
            let rejected:set<addr>=set[]
            let temporary:set<addr>=set[]
            let retained:set<addr>=set[]
            let position:addr=0
            loop pair in pairs {
                let source=route(pair.argument nodes)
                let summary=if pair.parameter is? none none else summaries.by_param_binding.get(pair.parameter)
                if direct not in? retaining and summary isnt? none and summary.escapes.length =? 0 {temporary.add(pair.argument)}
                else {retained.add(pair.argument)}
                if direct not in? opaque and source isnt? none and source.binding not in? plan.globals and (source.binding not in? places or direct not in? dirty) and summary isnt? none and effects.read_only(summary) and not conflicts(node position source nodes plan dirty) {allowed.add(pair.argument)}
                else {rejected.add(pair.argument)}
                position+=1
            }
            # A shared expression must be safe at every argument position,
            # and an indirect call must be safe for every possible callee.
            allowed_all=allowed_all & (allowed-rejected)
            temporary_all=temporary_all & (temporary-retained)
        }
        result[id]=allowed_all
        disposable[id]=temporary_all
    }
    let escaping:set<addr>=set[]
    loop id in seen {
        let node=hir.node_at(nodes id)
        if node is? hir.Place and (id not in? safe_places or id in? unsafe_places) {
            let source=route(node.target nodes)
            if source isnt? none {escaping.add(source.binding)}
        }
    }
    return Plan[result escaping disposable array_snapshots stable stable_parameters]
}

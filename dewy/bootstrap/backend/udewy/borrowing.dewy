import p"../../semantic/hir.dewy" as hir
import p"../../semantic/bindings.dewy" as bindings
import p"../../semantic/ty.dewy" as types
import p"../../semantic/analyze/effects.dewy" as effects
import p"../../semantic/analyze/storage_borrows.dewy" as storage_borrows
import p"captures.dewy" as captures
import p"emit.dewy" as emit
import p"callbacks.dewy" as callbacks
import p"../../semantic/subtyping.dewy" as subtyping
import p"../../semantic/type_queries.dewy" as views

# Value copies remain the default. A direct callee may borrow a read-only
# aggregate argument when no later argument or place can change its storage.
# This makes arena readers practical without weakening value semantics.
Route:type = const [binding:addr fields:array<string>]
route = (id:addr nodes:array<hir.AST>):>Route? => {
    let current=id
    let reverse:array<string>=[]
    loop true {
        let node=hir.node_at(nodes current)
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=node.items[0] continue}
        # A proof obligation is transparent to storage: it lowers its value.
        if node is? hir.Obligation {current=node.value continue}
        if node is? hir.MemberAccess {reverse.push(node.name) current=node.value continue}
        # Unknown indices may alias; only fields above the index distinguish
        # storage. Do not infer that two different index expressions differ.
        if node is? hir.Index {reverse.clear current=node.array continue}
        # A dictionary value lives in the dictionary's value array.
        if node is? hir.DictLookup {reverse.clear current=node.values continue}
        if node isnt? hir.ExpressedIdentifier or node.binding_id is? none return none
        let fields:array<string>=[]
        loop reverse.length >? 0 {fields.push(reverse.pop)}
        return Route[node.binding_id fields]
    }
}
# Contextual typing wraps an argument in representation-preserving casts
# (a literal or refined string passed as `string`) and single-item blocks.
# The storage read underneath is the same route, so borrowing looks through
# them; the lowering separately confirms the cast keeps the representation.
peel_argument = (id:addr nodes:array<hir.AST> type_nodes:types.Table):>addr => {
    let current=id
    loop true {
        let node=hir.node_at(nodes current)
        if node is? hir.Suppress {current=node.item continue}
        if node is? hir.Obligation {current=node.value continue}
        if node is? hir.Block and not node.scoped and node.items.length =? 1 {current=node.items[0] continue}
        if node is? hir.ValueCast|hir.RepresentationCast {
            let inner=hir.node_at(nodes node.expr)
            let outer_plain=types.unfold(types.strip_refinement(node.value_type type_nodes) type_nodes)
            let inner_plain=types.unfold(types.strip_refinement(inner.value_type type_nodes) type_nodes)
            if views.string_valued(outer_plain type_nodes) and views.string_valued(inner_plain type_nodes) {current=node.expr continue}
            # A record read as a relative (a child passed where its parent
            # is expected) is the same block under another static type.
            if node is? hir.ValueCast and record_value(current nodes type_nodes) and record_value(node.expr nodes type_nodes) {current=node.expr continue}
        }
        return current
    }
}
overlap = (a:Route b:Route):>bool => {
    if a.binding not=? b.binding return false
    loop i in 0.. and i <? a.fields.length and i <? b.fields.length {
        if a.fields[i] not=? b.fields[i] return false
    }
    return true
}
arguments = (call:hir.FunctionCall):>array<addr> => {
    let result=call.pos_args
    loop value in call.kw_args.values {result.push(value)}
    return result
}
# A receiver's value is evaluated before its index or later call arguments.
# Borrow it only while those expressions cannot replace or mutate its storage.
# An unknown source route (including an aliasing place parameter) overlaps all
# writes. Merely calculating an integer index does not require a snapshot.
expression_conflicts = (root:addr source:Route? nodes:array<hir.AST> plan:captures.Plan ambient:set<addr> deep:bool=true):>bool => {
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.push(id)
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionLiteral|hir.GenericFunction continue
        if deep and node is? hir.FunctionCall {
            let direct=captures.resolve(node.func node.selected_method_index plan nodes)
            if direct isnt? none {
                if direct in? ambient return true
                let function=plan.functions.get(direct)
                if function isnt? none and source isnt? none and source.binding in? function.writes return true
            } else {
                let callee=hir.node_at(nodes node.func)
                # Only operators without runtime bindings are intrinsics. A source
                # function or callback with the same spelling still has effects.
                let pure=callee is? hir.ExpressedIdentifier and (callee.binding_id is? none or callee.binding_id not in? plan.source_bindings) and (callee.name in? emit.binary or callee.name in? emit.prefix)
                if callee is? hir.ArrayMethod {
                    if callee.name =? 'sort' and 'key' in? node.kw_args return true
                } else if not pure return true
            }
        }
        let targets:array<addr>=[]
        if node is? hir.Place {targets=[node.target]}
        else if deep {targets=captures.write_targets(node nodes)}
        loop target in targets {
            let exposed=route(target nodes)
            if source is? none or exposed is? none or overlap(source exposed) return true
        }
        if deep {hir.push_children(node @pending)}
    }
    return false
}
conflicts = (call:hir.FunctionCall position:addr source:Route nodes:array<hir.AST> plan:captures.Plan ambient:set<addr>):>bool => {
    let args=arguments(call)
    loop i in 0.. and i <? args.length {
        # Earlier evaluation has finished; only a directly passed place remains
        # live. Later arguments can mutate even when their result is an integer.
        if expression_conflicts(args[i] source nodes plan ambient deep=(i >? position)) return true
    }
    return false
}

record_value = (id:addr nodes:array<hir.AST> type_nodes:types.Table):>bool => {
    let type=hir.node_at(nodes id).value_type
    return types.node_at(type_nodes views.structural_base(type type_nodes)) is? types.ObjectType
}
# A place parameter can refer to caller storage that also has a global name.
# Conservatively exclude callees with ambient writes/unknown callbacks. The
# semantic parameter summaries alone cannot establish that global boundary.
word_value = (id:addr type_nodes:types.Table):>bool => {
    let type=types.node_at(type_nodes types.unfold(types.strip_refinement(id type_nodes) type_nodes))
    if type is? types.IntegerLiteralType return type.value >=? -9223372036854775808 and type.value <=? 18446744073709551615
    return type is? types.Primitive and type.name in? ['int' 'uint' 'int8' 'int16' 'int32' 'int64' 'uint8' 'uint16' 'uint32' 'uint64' 'float32' 'float64' 'bool' 'true' 'false' 'none']
}
# An ordinary value call is an ownership boundary. If its callee needs raw
# storage, lowering supplies a private copy there. That callee can retain its
# copy without retaining its caller's argument snapshot. Places and lifted
# captures cross the boundary without copying, so they still propagate storage
# exposure. Ambient mutation propagates across every call regardless.
shares_storage = (call:hir.FunctionCall target:addr plan:captures.Plan nodes:array<hir.AST>):>bool => {
    let function=plan.functions.get(target)
    if function is? none or function.captures.length >? 0 return true
    loop argument in arguments(call) {if hir.node_at(nodes argument) is? hir.Place return true}
    return false
}
# Storage whose address may reach a raw memory operation, a system call, an
# aggregate transmute, an unknown callee or a keyed sort inside its own
# function. Only such roots can be changed behind a scope borrow: every
# other callee receives the value by copy, or borrows it only when it is
# transitively free of raw operations (see `arguments` below). Binding ids
# are program-unique, so one set covers every function.
exposed_roots = (plan:captures.Plan nodes:array<hir.AST> type_nodes:types.Table):>set<addr> => {
    let exposed:set<addr>=set[]
    let expose = (id:addr @exposed:set<addr>):>void => {
        if word_value(hir.node_at(nodes id).value_type type_nodes) return void
        let binding=captures.root_binding(id nodes)
        if binding isnt? none {exposed.push(binding)}
    }
    loop [id function] in plan.functions {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let pending:array<addr>=[literal.body]
        loop parameter in effects.literal_params(literal) {if parameter is? hir.BoundParam {pending.push(parameter.value)}}
        let seen:set<addr>=set[]
        loop pending.length >? 0 {
            let child=pending.pop
            if child in? seen continue
            seen.push(child)
            let node=hir.node_at(nodes child)
            if node is? hir.FunctionLiteral|hir.GenericFunction continue
            if node is? hir.RuntimeFailure {
                if node.message isnt? none {pending.push(node.message)}
                continue
            }
            if node is? hir.Transmute and (not word_value(node.value_type type_nodes) or not word_value(hir.node_at(nodes node.expr).value_type type_nodes)) {expose(node.expr @exposed)}
            if node is? hir.FunctionCall {
                let callee=hir.node_at(nodes node.func)
                let direct=captures.resolve(node.func node.selected_method_index plan nodes)
                let raw=false
                if direct is? none and callee is? hir.ExpressedIdentifier {
                    let memory=callee.name.startswith('__load_') or callee.name.startswith('__store_')
                    let unknown=(callee.binding_id isnt? none and callee.binding_id in? plan.source_bindings) or (callee.name not in? emit.intrinsics and callee.name not in? emit.binary and callee.name not in? emit.prefix)
                    raw=memory or unknown or callee.name.startswith('__syscall')
                } else if direct is? none and callee is? hir.ArrayMethod {
                    raw=callee.name =? 'sort' and 'key' in? node.kw_args
                } else if direct is? none and callee isnt? hir.FunctionLiteral {raw=true}
                if raw {
                    loop argument in arguments(node) {
                        let value=hir.node_at(nodes argument)
                        expose((if value is? hir.Place value.target else argument) @exposed)
                    }
                    if callee is? hir.ArrayMethod {expose(callee.array @exposed)}
                }
            }
            hir.push_children(node @pending)
        }
    }
    return exposed
}
# Functions whose place parameter may name a global's storage: some caller
# passes a global route as the place, forwards its own such place, or the
# function is reachable through a callback whose call sites are unknown.
# Only then can a global write elsewhere change what the place refers to.
global_placed = (plan:captures.Plan nodes:array<hir.AST> indirect:dict<addr array<addr>>):>set<addr> => {
    let marked:set<addr>=set[]
    let forwards:dict<addr array<addr>>=[]
    loop [callee targets] in indirect {loop target in targets {marked.push(target)}}
    loop [id function] in plan.functions {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let own_places:set<addr>=set[]
        loop parameter in effects.literal_params(literal) {
            if parameter.place and parameter.binding_id isnt? none {own_places.push(parameter.binding_id)}
        }
        let pending:array<addr>=[literal.body]
        loop parameter in effects.literal_params(literal) {if parameter is? hir.BoundParam {pending.push(parameter.value)}}
        let seen:set<addr>=set[]
        loop pending.length >? 0 {
            let child=pending.pop
            if child in? seen continue
            seen.push(child)
            let node=hir.node_at(nodes child)
            if node is? hir.FunctionLiteral|hir.GenericFunction continue
            if node is? hir.FunctionCall {
                let direct=captures.resolve(node.func node.selected_method_index plan nodes)
                loop argument in arguments(node) {
                    let value=hir.node_at(nodes argument)
                    if value isnt? hir.Place continue
                    let source=route(value.target nodes)
                    if direct is? none {
                        # An unresolved callee with a place: mark every possible target.
                        loop target in indirect.get(node.func []) {marked.push(target)}
                        continue
                    }
                    if source is? none or source.binding in? plan.globals {marked.push(direct) continue}
                    if source.binding in? own_places {
                        let users=forwards.get(id [])
                        users.push(direct)
                        forwards[id]=users
                    }
                }
            }
            hir.push_children(node @pending)
        }
    }
    return propagate_ambient(marked forwards)
}
# These three summaries differ in their initial facts and propagation edges,
# not in which syntax they inspect. Collect the function graph once and keep
# the ownership boundary explicit on a separate reverse edge map.
AmbientGraph:type = const [globals:set<addr> opaque:set<addr> exposes_storage:set<addr> callers:dict<addr array<addr>> shared_callers:dict<addr array<addr>>]
ambient_graph = (plan:captures.Plan nodes:array<hir.AST> type_nodes:types.Table indirect:dict<addr array<addr>>=[]):>AmbientGraph => {
    let globals:set<addr>=set[]
    let opaque:set<addr>=set[]
    let exposes_storage:set<addr>=set[]
    let callers:dict<addr array<addr>>=[]
    let shared_callers:dict<addr array<addr>>=[]
    loop [id function] in plan.functions {
        loop binding in function.writes {if binding in? plan.globals {globals.push(id)}}
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let called:set<addr>=set[]
        let shared:set<addr>=set[]
        let pending:array<addr>=[literal.body]
        loop parameter in effects.literal_params(literal) {if parameter is? hir.BoundParam {pending.push(parameter.value)}}
        let seen:set<addr>=set[]
        loop pending.length >? 0 {
            let child=pending.pop
            if child in? seen continue
            seen.push(child)
            let node=hir.node_at(nodes child)
            if node is? hir.FunctionLiteral|hir.GenericFunction continue
            # Reporting is an intrinsic failure operation at the source level.
            # Its installed allocator/I/O calls do not expose a source argument.
            # A user-written message still runs on this path and keeps all of
            # its effects; explicit source calls to reporters remain ordinary.
            if node is? hir.RuntimeFailure {
                if node.message isnt? none {pending.push(node.message)}
                continue
            }
            # Reinterpreting scalar bits does not expose aggregate storage.
            # Pointer/aggregate transmutes and raw memory calls still prevent
            # borrowing: they can escape or mutate an otherwise read-only value.
            if node is? hir.Transmute and (not word_value(node.value_type type_nodes) or not word_value(hir.node_at(nodes node.expr).value_type type_nodes)) {opaque.push(id) exposes_storage.push(id)}
            if node is? hir.FunctionCall {
                let callee=hir.node_at(nodes node.func)
                let direct=captures.resolve(node.func node.selected_method_index plan nodes)
                let targets:array<addr> | none = if direct is? none indirect.get(node.func) else [direct]
                if targets isnt? none {
                    loop target in targets {
                        called.push(target)
                        if shares_storage(node target plan nodes) {shared.push(target)}
                    }
                } else if callee is? hir.ExpressedIdentifier {
                    let memory=callee.name.startswith('__load_') or callee.name.startswith('__store_')
                    let unknown=(callee.binding_id isnt? none and callee.binding_id in? plan.source_bindings) or (callee.name not in? emit.intrinsics and callee.name not in? emit.binary and callee.name not in? emit.prefix)
                    if unknown or callee.name.startswith('__syscall') {opaque.push(id) exposes_storage.push(id)}
                    else if memory {
                        # Raw memory can alias caller storage, so still copy
                        # value arguments. Word-only operands do not expose
                        # the descriptor of that private copy. Aggregate raw
                        # operands and aggregate transmutes keep retention.
                        opaque.push(id)
                        loop argument in arguments(node) {
                            if not word_value(hir.node_at(nodes argument).value_type type_nodes) {exposes_storage.push(id)}
                        }
                    }
                } else if callee is? hir.ArrayMethod {
                    # A sort invokes its key inside the method. In particular
                    # a function-valued parameter can hide ambient writes;
                    # it is not an ordinary HIR call with a known dependency.
                    # A literal key (`(.power)`, `(r)=>r.power`) is a known
                    # function the method calls, analyzed like a direct call.
                    if callee.name =? 'sort' and 'key' in? node.kw_args {
                        let key=node.kw_args['key']
                        if hir.node_at(nodes key) is? hir.FunctionLiteral {
                            called.push(key)
                            if shares_storage(node key plan nodes) {shared.push(key)}
                        } else {opaque.push(id) exposes_storage.push(id)}
                    }
                } else if callee is? hir.FunctionLiteral {
                    called.push(node.func)
                    if shares_storage(node node.func plan nodes) {shared.push(node.func)}
                }
                else {opaque.push(id) exposes_storage.push(id)}
            }
            hir.push_children(node @pending)
        }
        loop target in called {
            let users=callers.get(target [])
            users.push(id)
            callers[target]=users
        }
        loop target in shared {
            let users=shared_callers.get(target [])
            users.push(id)
            shared_callers[target]=users
        }
    }
    return AmbientGraph[globals opaque exposes_storage callers shared_callers]
}
propagate_ambient = (initial:set<addr> callers:dict<addr array<addr>>):>set<addr> => {
    let dirty=initial
    # Dirtiness is a monotone bit. Propagate each newly dirty function to
    # its callers once; long call chains need no whole-program rescans.
    let pending:array<addr>=[]
    loop id in dirty {pending.push(id)}
    loop pending.length >? 0 {
        let id=pending.pop
        loop caller in callers.get(id []) {
            if caller in? dirty continue
            dirty.push(caller)
            pending.push(caller)
        }
    }
    return dirty
}
# Standalone query used by internal clients. The full borrowing pass below
# shares one graph across its three queries instead of rebuilding it here.
ambient_writers = (plan:captures.Plan nodes:array<hir.AST> type_nodes:types.Table opaque_only:bool=false value_boundaries:bool=false indirect:dict<addr array<addr>>=[]):>set<addr> => {
    let graph=ambient_graph(plan nodes type_nodes indirect)
    let initial=if value_boundaries graph.exposes_storage else graph.opaque
    if not opaque_only {loop id in graph.globals {initial.push(id)}}
    return propagate_ambient(initial (if value_boundaries graph.shared_callers else graph.callers))
}
# `rejections` explains, per source binding, why its last considered use as
# an argument was not borrowed (for `dewy analyze`).
Plan:type = const [arguments:dict<addr set<addr>> escaping_places:set<addr> disposable_arguments:dict<addr set<addr>> array_snapshots:set<addr> stable_bindings:set<addr>=set[] stable_parameters:dict<addr effects.ParameterEffects>=[] consumed_arguments:dict<addr set<addr>>=[] consumed_uses:set<addr>=set[] rejections:dict<addr string>=[] owned_parameters:set<addr>=set[] scoped_views:set<addr>=set[] view_scopes:dict<addr addr>=[] view_regions:dict<addr array<addr>>=[] nonescaping_places:set<addr>=set[] fixed_places:set<addr>=set[] indirect:dict<addr array<addr>>=[] reclaimable_arguments:dict<addr set<addr>>=[]]

# Required views can end at the last use of all their derived aliases.
# Statements containing control flow remain indivisible, so a read in a loop
# keeps the view live across that entire loop. Outward, captured or exposed
# aliases retain the lexical lifetime. Inferred const views use this proof
# only when the whole-function stability check could not justify them.
view_nodes = (id:addr nodes:array<hir.AST> dependencies:bool=false):>array<addr> => {
    let found:array<addr>=[]
    let pending:array<addr>=[id]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let current=pending.pop
        if current in? seen {continue}
        seen.push(current) found.push(current)
        let node=hir.node_at(nodes current)
        if node isnt? hir.FunctionLiteral|hir.GenericFunction and not (dependencies and node is? hir.CopyValue) {hir.push_children(node @pending)}
    }
    return found
}
ViewScope:type = const [items:array<addr> references:array<set<addr>> locals:set<addr> dependents:dict<addr set<addr>> starts:dict<addr addr> ends:dict<addr addr>]
# Several views in a block share its statement and alias-dependency scan.
prepare_view_scope = (scope:addr nodes:array<hir.AST> type_nodes:types.Table):>ViewScope => {
    let block=hir.node_at(nodes scope)
    $runtime_assert block is? hir.Block
    let references:array<set<addr>>=[]
    let locals:set<addr>=set[]
    let dependents:dict<addr set<addr>>=[]
    let starts:dict<addr addr>=[]
    let ends:dict<addr addr>=[]
    loop index in 0.. and index <? block.items.length {
        let reads:set<addr>=set[]
        loop id in view_nodes(block.items[index] nodes) {
            let node=hir.node_at(nodes id)
            if node is? hir.ExpressedIdentifier and node.binding_id isnt? none {reads.push(node.binding_id)}
            let target:addr?=none
            let value:addr?=none
            if node is? hir.Declare {
                if id not in? starts {starts[id]=index}
                ends[id]=index
                if node.binding_id isnt? none {locals.push(node.binding_id)}
                if node.view or not word_value(hir.node_at(nodes node.expr).value_type type_nodes) {target=node.binding_id value=node.expr}
            } else if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign and not word_value(hir.node_at(nodes node.value).value_type type_nodes) {
                let path=route(node.target nodes)
                if path isnt? none {target=path.binding value=node.value}
            }
            if target isnt? none and value isnt? none {
                loop read_id in view_nodes(value nodes dependencies=true) {
                    let read=hir.node_at(nodes read_id)
                    if read is? hir.ExpressedIdentifier and read.binding_id isnt? none {
                        let edges=dependents.get(read.binding_id set[])
                        edges.push(target) dependents[read.binding_id]=edges
                    }
                }
            }
        }
        references.push(reads)
    }
    return ViewScope[block.items references locals dependents starts ends]
}
view_region = (scope:ViewScope declaration:addr excluded:set<addr> nodes:array<hir.AST>):>array<addr> => {
    let declared=hir.node_at(nodes declaration)
    $runtime_assert declared is? hir.Declare and declared.binding_id isnt? none
    let start=scope.starts.get(declaration)
    if start is? none return scope.items
    let last=scope.ends.get(declaration)
    $runtime_assert last isnt? none
    let stop:addr=last
    let live:set<addr>=set[declared.binding_id]
    let pending:array<addr>=[declared.binding_id]
    loop pending.length >? 0 {
        let current=pending.pop
        loop target in scope.dependents.get(current set[]) {
            if target not in? live {live.push(target) pending.push(target)}
        }
    }
    loop binding in live {if binding in? excluded or binding not in? scope.locals return scope.items}
    loop index in 0.. and index <? scope.references.length {
        loop binding in scope.references[index] {if binding in? live and index >? stop {stop=index}}
    }
    let result:array<addr>=[]
    loop index in 0.. and index <? scope.items.length {if index >=? start and index <=? stop {result.push(scope.items[index])}}
    return result
}
# Backward liveness inside the interval distinguishes an exiting branch
# from the continuing path. In particular, drop after saving a return value
# cannot change the view used to compute that value.
ViewLiveness:type = const [conflict:bool live:bool]
view_reads = (id:addr aliases:set<addr> nodes:array<hir.AST>):>bool => {
    loop child in view_nodes(id nodes) {
        let node=hir.node_at(nodes child)
        if node is? hir.ExpressedIdentifier and node.binding_id isnt? none and node.binding_id in? aliases return true
    }
    return false
}
view_liveness = (id:addr live:bool aliases:set<addr> source:Route nodes:array<hir.AST> plan:captures.Plan retained:bool=false):>ViewLiveness => {
    let node=hir.node_at(nodes id)
    if node is? hir.Return return if node.item is? none ViewLiveness[false retained] else view_liveness(node.item retained aliases source nodes plan retained=retained)
    if node is? hir.Block {
        let conflict=false
        let index=node.items.length
        loop index >? 0 {
            index-=1
            let prior=view_liveness(node.items[index] live aliases source nodes plan retained=retained)
            conflict=conflict or prior.conflict
            live=prior.live
        }
        return ViewLiveness[conflict live]
    }
    if node is? hir.Flow {
        let previous=if node.default is? none ViewLiveness[false live] else view_liveness(node.default live aliases source nodes plan retained=retained)
        let conflict=previous.conflict
        let remaining=previous.live
        let index=node.arms.length
        loop index >? 0 {
            index-=1
            let arm=hir.node_at(nodes node.arms[index])
            $runtime_assert arm is? hir.IfArm|hir.LoopArm
            let after=live or (arm is? hir.LoopArm and (view_reads(arm.condition aliases nodes) or view_reads(arm.body aliases nodes)))
            let body=view_liveness(arm.body after aliases source nodes plan retained=retained)
            let condition=view_liveness(arm.condition body.live or remaining aliases source nodes plan retained=retained)
            conflict=conflict or body.conflict or condition.conflict
            remaining=condition.live
        }
        return ViewLiveness[conflict remaining]
    }
    let before=live or view_reads(id aliases nodes)
    return ViewLiveness[before and expression_conflicts(id source nodes plan set[]) before]
}
view_conflicts = (region:array<addr> aliases:set<addr> source:Route nodes:array<hir.AST> plan:captures.Plan retained:bool=false):>bool => {
    let live=retained
    let index=region.length
    loop index >? 0 {
        index-=1
        let prior=view_liveness(region[index] live aliases source nodes plan retained=retained)
        if prior.conflict return true
        live=prior.live
    }
    return false
}
ScopedViews:type = [bindings:set<addr>=set[] scopes:dict<addr addr>=[] regions:dict<addr array<addr>>=[]]
ScopeItem:type = const [id:addr scope:addr?]
scoped_views = (demands:set<addr> nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan excluded:set<addr>):>ScopedViews => {
    let result=ScopedViews[]
    if demands.length =? 0 return result
    loop [function_id function] in plan.functions {
        let needed=false
        loop binding in function.locals {if binding in? demands {needed=true break}}
        if not needed continue
        let literal=hir.node_at(nodes function_id)
        $runtime_assert literal is? hir.FunctionLiteral
        let pending:array<ScopeItem>=[ScopeItem[literal.body none]]
        let seen:dict<addr set<addr>>=[]
        let unscoped:set<addr>=set[]
        let candidates:dict<addr set<addr>>=[]
        loop pending.length >? 0 {
            let item=pending.pop
            if item.scope is? none {
                if item.id in? unscoped continue
                unscoped.push(item.id)
            } else {
                let scopes=seen.get(item.id set[])
                if item.scope in? scopes continue
                scopes.push(item.scope) seen[item.id]=scopes
            }
            let node=hir.node_at(nodes item.id)
            if node is? hir.FunctionLiteral continue
            let scope=item.scope
            if node is? hir.Block and node.scoped {scope=item.id}
            if node is? hir.Declare and node.binding_id isnt? none and node.binding_id in? demands and scope isnt? none {
                let known=candidates.get(item.id set[])
                known.push(scope) candidates[item.id]=known
                result.scopes[node.binding_id]=scope
            }
            loop child in hir.children(node) {pending.push(ScopeItem[child scope])}
        }
        let prepared:dict<addr ViewScope>=[]
        loop [declaration scopes] in candidates {
            let declared=hir.node_at(nodes declaration)
            $runtime_assert declared is? hir.Declare and declared.binding_id isnt? none
            let binding=declared.binding_id
            let source=route(declared.expr nodes)
            # This owner is private, uncaptured and unexposed. Ambient writes
            # to unrelated storage cannot reach it; explicit places and
            # unresolved callbacks still conflict through the normal scan.
            let safe=source isnt? none and source.binding in? function.locals and source.binding not in? excluded
            let regions:array<addr>=[]
            loop scope in scopes {
                if scope not in? prepared {prepared[scope]=prepare_view_scope(scope nodes type_nodes)}
                let aliases:set<addr>=set[binding]
                let pending_aliases:array<addr>=[binding]
                loop pending_aliases.length >? 0 {
                    let current=pending_aliases.pop
                    loop dependent in prepared[scope].dependents.get(current set[]) {
                        if dependent not in? aliases {aliases.push(dependent) pending_aliases.push(dependent)}
                    }
                }
                let region=view_region(prepared[scope] declaration excluded nodes)
                loop item in region {regions.push(item)}
                let retained=false
                loop alias in aliases {if alias in? excluded or alias not in? prepared[scope].locals {retained=true}}
                if source isnt? none and view_conflicts(region aliases source nodes plan retained=retained) {safe=false}
            }
            result.regions[binding]=regions
            if safe {result.bindings.push(binding)}
        }
    }
    return result
}

# Ownership transfer at a value boundary. A parameter whose only use, on
# every path and outside any loop, pushes it into an array or passes it on
# to another such parameter takes ownership of its argument: the caller
# donates a temporary (or copies a value it keeps) and never releases it,
# and the callee adopts it at that use instead of copying. Only functions
# that are exclusively called directly qualify, so every caller and the
# callee agree on the transfer.
Consumed:type = [parameters:set<addr>=set[] uses:set<addr>=set[]]
ReadSite:type = const [id:addr parent:addr guarded:bool after_exit:bool]
ReadScan:type = [reads:dict<addr array<ReadSite>>=[] exited:bool=false]
# One pre-order walk per function records every read of its candidate
# parameters: where it is, whether it may run never/many times, and whether
# an earlier return could skip it.
scan_reads = (id:addr parent:addr guarded:bool candidates:set<addr> nodes:array<hir.AST> @scan:ReadScan):>void => {
    let node=hir.node_at(nodes id)
    if node is? hir.ExpressedIdentifier {
        if node.binding_id isnt? none and node.binding_id in? candidates {
            let sites=scan.reads.get(node.binding_id default=[])
            sites.push(ReadSite[id parent guarded scan.exited])
            scan.reads[node.binding_id]=sites
        }
        return void
    }
    # A read inside a nested literal, a flow arm, a loop or a short-circuit
    # operand may run never, once or many times: never a single consumption.
    let nested=guarded or node is? hir.FunctionLiteral|hir.GenericFunction|hir.Flow|hir.IfArm|hir.LoopArm|hir.ShortCircuit
    loop child in hir.children(node) {scan_reads(child id nested candidates nodes @scan)}
    if node is? hir.Return {scan.exited=true}
    return void
}
consuming_use = (sites:array<ReadSite> nodes:array<hir.AST> plan:captures.Plan parameters:set<addr>):>addr? => {
    if sites.length not=? 1 return none
    let read:addr=0
    let parent_id:addr=0
    loop site in sites {
        if site.guarded or site.after_exit return none
        read=site.id parent_id=site.parent
    }
    let parent=hir.node_at(nodes parent_id)
    if parent isnt? hir.FunctionCall return none
    let callee=hir.node_at(nodes parent.func)
    if callee is? hir.ArrayMethod {
        if callee.name in? ['push' 'insert'] and parent.pos_args.length >? 0 and parent.pos_args[0] =? read return read
        return none
    }
    let direct=captures.resolve(parent.func parent.selected_method_index plan nodes)
    if direct is? none return none
    let target=hir.node_at(nodes direct)
    if target isnt? hir.FunctionLiteral return none
    let pairs=effects.pair_arguments(parent target)
    if pairs is? none return none
    loop pair in pairs {
        if pair.argument =? read and pair.parameter isnt? none and pair.parameter in? parameters return read
    }
    return none
}
consumed_parameters = (nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan valued:set<addr>):>Consumed => {
    let result=Consumed[]
    # Candidate parameters and their read sites, scanned once per function.
    let scans:dict<addr ReadScan>=[]
    let candidates:dict<addr array<addr>>=[]
    loop [id function] in plan.functions {
        if id in? valued continue
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        if literal.object_receiver or function.captures.length >? 0 continue
        let bindings:array<addr>=[]
        let wanted:set<addr>=set[]
        loop parameter in effects.literal_params(literal) {
            let binding=parameter.binding_id
            if binding is? none or parameter.place or parameter is? hir.BoundParam continue
            if word_value(parameter.value_type type_nodes) continue
            bindings.push(binding) wanted.push(binding)
        }
        if bindings.length =? 0 continue
        let scan=ReadScan[]
        scan_reads(literal.body id false wanted nodes @scan)
        scans[id]=scan candidates[id]=bindings
    }
    loop true {
        let changed=false
        loop [id bindings] in candidates {
            let scan=scans.get(id)
            if scan is? none continue
            loop binding in bindings {
                if binding in? result.parameters continue
                let use=consuming_use(scan.reads.get(binding default=[]) nodes plan result.parameters)
                if use is? none continue
                result.parameters.push(binding) result.uses.push(use) changed=true
            }
        }
        if not changed break
    }
    return result
}

# A separate ownership protocol for mutable array parameters. The caller
# supplies an independent value (fresh, moved, or copied); the callee owns
# that value until it rebinds the parameter or exits. Unlike the single-use
# protocol above, no parameter read itself consumes the owner. This avoids
# retaining a second descriptor reference only to detach it at the first
# write. Unknown/first-class callers retain the ordinary borrowed ABI.
owned_array_parameters = (nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan summaries:effects.ProgramEffects valued:set<addr> retaining:set<addr> captured:set<addr> consumed:set<addr>):>set<addr> => {
    let result:set<addr>=set[]
    let named:set<addr>=set[]
    loop id in plan.named.values {named.push(id)}
    loop [id function] in plan.functions {
        if id not in? named or id in? valued or id in? retaining continue
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        if literal.object_receiver or function.captures.length >? 0 continue
        loop parameter in effects.literal_params(literal) {
            let binding=parameter.binding_id
            if binding is? none or parameter.place or parameter is? hir.BoundParam or binding in? captured or binding in? consumed continue
            let type=types.node_at(type_nodes types.unfold(types.strip_refinement(parameter.value_type type_nodes) type_nodes))
            if type isnt? types.ArrayType continue
            let summary=summaries.by_param_binding.get(binding)
            if summary isnt? none and summary.escapes.length =? 0 and effects.writes(summary) {result.push(binding)}
        }
    }
    return result
}

# A write to state.output cannot invalidate a view into state.input. Prefix
# routes deliberately treat indices as possibly overlapping; a shortened
# summary route covers every deeper field. Rebinding/escaping the root covers
# the entire owner. Whole-binding proofs remain the cheapest common case.
stable_owner = (source:Route stable:set<addr> parameters:dict<addr effects.ParameterEffects>):>bool => {
    if source.binding in? stable return true
    let summary=parameters.get(source.binding)
    if summary is? none return false
    return effects.read_only_at(summary effects.Route[source.fields])
}
analyze = (root:addr nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan):>dict<addr set<addr>> => details(root nodes type_nodes plan).arguments
details = (root:addr nodes:array<hir.AST> type_nodes:types.Table plan:captures.Plan links:subtyping.Graph=subtyping.default_links external:set<addr>=set[] owned_parameter_protocol:bool=false registry:bindings.Registry=bindings.Registry[]):>Plan => {
    let valued=captures.value_functions(root nodes plan)
    let indirect=callbacks.analyze(root nodes type_nodes plan links function_values=valued)
    # Compiler-generated callers also keep the ordinary ABI. They are not
    # added to source callback targets merely because the runtime calls them.
    loop id in external {valued.push(id)}
    # Checked value casts borrow while evaluating but do not expose raw
    # storage. At a value boundary lowering supplies an independent owner,
    # including an aggregate wrapped into an optional result.
    let analysis=effects.collect(root nodes)
    let summaries=effects.analyze_collected(analysis nodes type_nodes indirect value_casts_escape=false)
    let storage_proofs=storage_borrows.prove(analysis summaries nodes type_nodes registry)
    let forwarded=storage_proofs.arguments
    let ambient=ambient_graph(plan nodes type_nodes indirect)
    let initial=ambient.opaque
    loop id in ambient.globals {initial.push(id)}
    let dirty=propagate_ambient(initial ambient.callers)
    # Raw address operations and unknown callbacks can expose storage even
    # without a declared place. They always require the ordinary value copy;
    # writes to unrelated globals only matter for an aliasing place source.
    let opaque=propagate_ambient(ambient.opaque ambient.callers)
    let aliased=global_placed(plan nodes indirect)
    # Borrowing must also exclude indirect raw writes that could alias caller
    # storage. Releasing an already independent snapshot only requires proving
    # that this snapshot was not itself exposed beyond the call.
    let retaining=propagate_ambient(ambient.exposes_storage ambient.shared_callers)
    let places:set<addr>=set[]
    loop id in plan.functions.keys {
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        loop parameter in effects.literal_params(literal) {
            if parameter.place and parameter.binding_id isnt? none {places.push(parameter.binding_id)}
        }
    }
    # A scope borrow needs a longer guarantee than a call-argument borrow.
    # Start conservatively: storage never written/exposed anywhere in its
    # function, with no opaque operation in that function's call graph.
    # Binding ids are program-unique. Captures, globals and place parameters
    # may have another name outside this scope, so exclude them altogether.
    # This reuses the existing graph instead of rescanning a body per local.
    let captured:set<addr>=set[]
    loop function in plan.functions.values {
        loop binding in function.captures {captured.push(binding)}
    }
    let stable:set<addr>=set[]
    let stable_parameters:dict<addr effects.ParameterEffects>=[]
    # Raw operations elsewhere in a function's call graph cannot reach a
    # local that is never written, exposed, captured or passed as a place:
    # callees with raw operations receive their arguments by copy. Only the
    # function's own raw exposures of that storage disqualify it.
    let exposed=exposed_roots(plan nodes type_nodes)
    # A `const` global never changes after startup initialization, so any
    # function may view its storage (a lookup's index cache aside).
    loop binding in plan.constants {if binding not in? exposed {stable.push(binding)}}
    loop [id function] in plan.functions {
        loop binding in function.locals {
            if binding not in? function.writes and binding not in? places and binding not in? plan.globals and binding not in? captured and binding not in? exposed {stable.push(binding)}
        }
        let literal=hir.node_at(nodes id)
        $runtime_assert literal is? hir.FunctionLiteral
        let parameters=effects.literal_params(literal)
        let place_count:addr=0
        loop parameter in parameters {if parameter.place {place_count+=1}}
        loop parameter in parameters {
            let binding=parameter.binding_id
            if binding is? none or binding in? captured or binding in? plan.globals or binding in? exposed continue
            # A place owner can also be named by a global. Exclude ambient
            # writes and, conservatively, functions with multiple places.
            if parameter.place and (place_count not=? 1 or (id in? dirty and id in? aliased)) continue
            let summary=summaries.by_param_binding.get(binding)
            if summary isnt? none {stable_parameters[binding]=summary}
        }
    }
    let consumed=consumed_parameters(nodes type_nodes plan valued)
    let owned:set<addr>=if owned_parameter_protocol owned_array_parameters(nodes type_nodes plan summaries valued retaining captured consumed.parameters) else set[]
    let consumed_arguments:dict<addr set<addr>>=[]
    let array_snapshots:set<addr>=set[]
    let result:dict<addr set<addr>>=[]
    let disposable:dict<addr set<addr>>=[]
    let reclaimable:dict<addr set<addr>>=[]
    let rejections:dict<addr string>=[]
    let safe_places:set<addr>=set[]
    let unsafe_places:set<addr>=set[]
    let fixed_places:set<addr>=set[] let changed_places:set<addr>=set[]
    let view_demands:set<addr>=set[]
    let pending:array<addr>=[root]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? seen continue
        seen.push(id)
        let node=hir.node_at(nodes id)
        hir.push_children(node @pending)
        if node is? hir.Declare and node.binding_id isnt? none {
            let expr=hir.node_at(nodes node.expr)
            let source=route(node.expr nodes)
            # An unwritten let uses the same lifetime proof as const. Skip
            # excluded owners before preparing per-scope dependency graphs.
            let inferred=not word_value(expr.value_type type_nodes) and expr is? hir.Index|hir.MemberAccess|hir.DictLookup and node.binding_id in? stable and source isnt? none and source.binding not in? plan.globals and source.binding not in? captured and source.binding not in? exposed and source.binding not in? places and not stable_owner(source stable stable_parameters)
            if node.view or inferred {view_demands.push(node.binding_id)}
        }
        if node is? hir.Index {
            let source=route(node.array nodes)
            # A place may alias a different parameter's route. Its spelling
            # cannot establish disjoint storage from another written route.
            if source isnt? none and source.binding in? places {source=none}
            if expression_conflicts(node.index source nodes plan dirty) {array_snapshots.push(id)}
        }
        if node is? hir.DictLookup {
            let source=route(node.values nodes)
            if source isnt? none and source.binding in? places {source=none}
            if expression_conflicts(node.key source nodes plan dirty) {array_snapshots.push(id)}
        }
        if node isnt? hir.FunctionCall continue
        let callee=hir.node_at(nodes node.func)
        let direct=captures.resolve(node.func node.selected_method_index plan nodes)
        let targets:array<addr> | none = if direct is? none indirect.get(node.func) else [direct]
        if targets is? none {targets=effects.direct_targets(node analysis nodes)}
        if targets is? none {
            loop argument in arguments(node) {
                if hir.node_at(nodes argument) is? hir.Place {unsafe_places.push(argument)}
                else {
                    let source=route(peel_argument(argument nodes type_nodes) nodes)
                    if source isnt? none and source.binding not in? rejections {rejections[source.binding]='the callee is not resolved statically'}
                }
            }
            continue
        }
        let allowed_all:set<addr>=set[]
        loop argument in arguments(node) {allowed_all.push(argument)}
        let temporary_all=allowed_all
        let reclaim_all=allowed_all
        let consumed_all=allowed_all
        loop direct in targets {
            let literal=hir.node_at(nodes direct)
            $runtime_assert literal is? hir.FunctionLiteral
            let pairs=effects.pair_arguments(node literal)
            if pairs is? none {
                loop argument in arguments(node) {
                    if hir.node_at(nodes argument) is? hir.Place {unsafe_places.push(argument)}
                    else {
                        let source=route(peel_argument(argument nodes type_nodes) nodes)
                        if source isnt? none and source.binding not in? rejections {rejections[source.binding]='the arguments could not be paired with the parameters'}
                    }
                }
                allowed_all.clear temporary_all.clear consumed_all.clear reclaim_all.clear
                break
            }
            loop pair in pairs {
                if hir.node_at(nodes pair.argument) isnt? hir.Place continue
                let summary=if pair.parameter is? none none else summaries.by_param_binding.get(pair.parameter)
                if summary isnt? none and summary.escapes.length =? 0 {
                    safe_places.push(pair.argument)
                    if effects.preserves_storage(summary hir.node_at(nodes pair.argument).value_type type_nodes) {fixed_places.push(pair.argument)}
                    else {changed_places.push(pair.argument)}
                } else {unsafe_places.push(pair.argument)}
            }
            let allowed:set<addr>=set[]
            let rejected:set<addr>=set[]
            let temporary:set<addr>=set[]
            let retained:set<addr>=set[]
            let reclaim:set<addr>=set[]
            let kept:set<addr>=set[]
            let donated:set<addr>=set[]
            let position:addr=0
            loop pair in pairs {
                if pair.parameter isnt? none and (pair.parameter in? consumed.parameters or pair.parameter in? owned) {
                    donated.push(pair.argument) rejected.push(pair.argument) retained.push(pair.argument) kept.push(pair.argument)
                    position+=1
                    continue
                }
                let source=route(peel_argument(pair.argument nodes type_nodes) nodes)
                let summary=if pair.parameter is? none none else summaries.by_param_binding.get(pair.parameter)
                if direct not in? retaining and summary isnt? none and summary.escapes.length =? 0 {temporary.push(pair.argument)}
                else {retained.push(pair.argument)}
                # A by-value callee that keeps its parameter keeps its own
                # share or copy of it; only raw exposure can keep the caller's
                # snapshot itself. That snapshot is the caller's to release.
                if direct not in? retaining and summary isnt? none {reclaim.push(pair.argument)}
                else {kept.push(pair.argument)}
                # A record borrows on the callee's own summary: raw exposure
                # of its parameter is an escape there (effects.raw_callee),
                # and each deeper boundary decides for itself. Arrays keep
                # the call-graph rule: a callee's value share of a borrowed
                # array made the caller detach on every later write.
                let raw_blocked=direct in? opaque and not record_value(pair.argument nodes type_nodes)
                if not raw_blocked and source isnt? none and source.binding not in? exposed and source.binding not in? plan.globals and (source.binding not in? places or direct not in? dirty) and summary isnt? none and effects.read_only(summary) and not conflicts(node position source nodes plan dirty) {allowed.push(pair.argument)}
                else {
                    rejected.push(pair.argument)
                    if source isnt? none {
                        rejections[source.binding]=if raw_blocked 'the callee exposes raw storage or is not known statically' else if source.binding in? exposed 'its storage has been exposed to raw operations' else if source.binding in? plan.globals 'it is a global' else if source.binding in? places and direct in? dirty 'it is a place argument of a call that writes' else if pair.parameter is? none 'it is passed as a rest argument' else if summary is? none "the callee's effects are unknown" else if not effects.read_only(summary) 'the callee writes or keeps its parameter' else 'another argument of the same call may write it'
                    }
                }
                position+=1
            }
            # A shared expression must be safe at every argument position,
            # and an indirect call must be safe for every possible callee.
            allowed_all=allowed_all & (allowed-rejected)
            temporary_all=temporary_all & (temporary-retained)
            reclaim_all=reclaim_all & (reclaim-kept)
            consumed_all=consumed_all & donated
        }
        result[id]=allowed_all
        disposable[id]=temporary_all
        reclaimable[id]=reclaim_all
        let proven=forwarded.get(id set[])
        if proven.length >? 0 {result[id]=result.get(id set[]) | proven}
        if consumed_all.length >? 0 {consumed_arguments[id]=consumed_all}
    }
    let escaping:set<addr>=set[]
    loop id in seen {
        let node=hir.node_at(nodes id)
        if node is? hir.Place {
            let source=route(node.target nodes)
            if source isnt? none {
                if id not in? safe_places or id in? unsafe_places {escaping.push(source.binding)}
            }
        }
    }
    let excluded=captured
    loop binding in exposed {excluded.push(binding)}
    loop binding in places {excluded.push(binding)}
    # Nonescaping calls only lend storage during the call. Conflicts inside
    # a view's live interval are still checked, including mutable places.
    loop binding in escaping {excluded.push(binding)}
    let scoped=scoped_views(view_demands nodes type_nodes plan excluded)
    loop id in unsafe_places {safe_places.pop(id default=id); fixed_places.pop(id default=id);}
    loop id in changed_places {fixed_places.pop(id default=id);}
    loop binding in storage_proofs.local_views {stable.push(binding)}
    return Plan[result escaping disposable array_snapshots stable stable_parameters consumed_arguments consumed.uses rejections owned (scoped.bindings | storage_proofs.local_views) scoped.scopes scoped.regions safe_places fixed_places indirect reclaimable_arguments=reclaimable]
}

$explicit_copies

import p"layouts.dewy" as layouts
import p"../../semantic/ty.dewy" as types
import p"../../semantic/hir.dewy" as hir
import p"../../semantic/type_queries.dewy" as views

# The first dense representation is deliberately bounded: scalar
# records with no dynamic brand or lifecycle behavior. The plan is made
# once, from checked types and HIR, before runtime lowering erases them.
# Every occurrence of an element type agrees on its physical representation.
Plan:type = const [dense:dict<addr layouts.Storage>=[]]

# A small, structural kernel contract: a place parameter is used only for
# indexed access and length, with no calls that can acquire another array
# owner or change its buffer. Such a kernel can make the buffer unique once
# on entry and retain its data/length throughout the invocation.
const scalar_calls:set<string>=set[
    '__add__' '__sub__' '__mul__' '__floordiv__' '__mod__'
    '__eq__' '__ne__' '__lt__' '__le__' '__gt__' '__ge__'
    '__and__' '__or__' '__xor__' '__not__' '__unary_sub__'
    '__lshift__' '__rshift__' '__nand__' '__nor__' '__xnor__'
]
kernel_parameter = (body:addr binding:addr nodes:array<hir.AST> table:types.Table symbols:dict<addr string>=[]):>bool => {
    let pending:array<addr>=[body]
    let visited:set<addr>=set[]
    let written=false
    loop pending.length >? 0 {
        let id=pending.pop
        if id in? visited continue
        visited.push(id)
        let node=hir.node_at(nodes id)
        if node is? hir.FunctionLiteral|hir.Transmute|hir.AllocatorBlock return false
        if node is? hir.FunctionCall {
            let callee=hir.node_at(nodes node.func)
            if callee isnt? hir.ExpressedIdentifier or callee.name not in? scalar_calls return false
            if callee.binding_id isnt? none and callee.binding_id in? symbols return false
        }
        if node is? hir.ExpressedIdentifier and node.binding_id not=? binding {
            let type=types.node_at(table views.structural_base(node.value_type table))
            if type is? types.ArrayType|types.ObjectType|types.TypeOr return false
        }
        if node is? hir.Assign|hir.MemberAssign|hir.IndexAssign {
            let target=hir.node_at(nodes node.target)
            loop target is? hir.MemberAccess|hir.Index {target=hir.node_at(nodes if target is? hir.MemberAccess target.value else target.array)}
            if target is? hir.ExpressedIdentifier and target.binding_id =? binding {written=true}
        }
        loop child in hir.children(node) {
            let value=hir.node_at(nodes child)
            if value is? hir.ExpressedIdentifier and value.binding_id =? binding {
                if node is? hir.Index {if child not=? node.array return false}
                else if node is? hir.ArrayLength {if child not=? node.array return false}
                else return false
            }
            pending.push(child)
        }
    }
    return written
}

exclude = (id:addr @excluded:set<addr> table:types.Table):>void => {
    excluded.push(views.structural_base(id table))
}

# Raw exposure can observe a record directly, or arrays several fields below
# it. Keep those record types boxed as array elements too: an exposed element
# address must not silently become an address into a relocatable buffer.
exclude_arrays = (id:addr @excluded:set<addr> table:types.Table):>void => {
    let pending:array<addr>=[id]
    let visited:set<addr>=set[]
    loop pending.length >? 0 {
        let plain=views.structural_base(pending.pop table)
        if plain in? visited continue
        visited.push(plain)
        let node=types.node_at(table plain)
        if node is? types.ArrayType {exclude(node.element @excluded table) pending.push(node.element)}
        else if node is? types.ObjectType {excluded.push(plain) loop field in node.fields {pending.push(field.value_type)}}
        else if node is? types.TypeOr {loop item in node.items {pending.push(item)}}
    }
}

array_element = (id:addr table:types.Table):>addr? => {
    let node=types.node_at(table views.structural_base(id table))
    return if node is? types.ArrayType node.element else none
}

# Nested scalar records already have inline field layouts. They need no
# per-element handles, hooks, or release walk either. Check every nested
# shape: an otherwise plain record can be a storage root for branded children.
inline_scalars = (id:addr context:layouts.Context excluded:set<addr> @table:types.Table):>bool => {
    let pending:array<addr>=[id]
    let seen:set<addr>=set[]
    loop pending.length >? 0 {
        let plain=views.structural_base(pending.pop table)
        if plain in? seen continue
        seen.push(plain)
        if plain in? context.nominals return false
        let node=types.node_at(table plain)
        if types.is_primitive(node 'bool') or views.fixed_integer_layout(plain table) isnt? none continue
        if plain in? excluded return false
        if node isnt? types.ObjectType or node.brand isnt? none or node.fields.length =? 0 return false
        loop method in node.methods {if method.lifecycle isnt? none return false}
        let layout=layouts.record(plain context @table)
        if layout is? layouts.Pending or layouts.brand_field in? layout.offsets return false
        loop field in node.fields {pending.push(field.value_type)}
    }
    return true
}

select = (nodes:array<hir.AST> context:layouts.Context @table:types.Table):>Plan => {
    let candidates:set<addr>=set[]
    let excluded:set<addr>=set[]
    loop type in table.entries {
        if type is? types.ArrayType {candidates.push(views.structural_base(type.element table))}
        if type is? types.ObjectType and type.brand in? ['dict' 'set'] {
            # Dictionary compaction currently moves owning handles. Keep
            # the same representation for ordinary arrays of these types.
            loop field in type.fields {
                if field.name not in? ['keys' 'values'] continue
                let element=array_element(field.value_type table)
                if element isnt? none {exclude(element @excluded table)}
            }
        }
    }
    loop node in nodes {
        if node is? hir.ArrayMethod and node.name =? 'sort' {
            let element=array_element(hir.node_at(nodes node.array).value_type table)
            if element isnt? none {exclude(element @excluded table)}
        }
        if node is? hir.Transmute {
            exclude_arrays(node.value_type @excluded table)
            exclude_arrays(hir.node_at(nodes node.expr).value_type @excluded table)
        }
        if node is? hir.ValueCast {
            let source=array_element(hir.node_at(nodes node.expr).value_type table)
            let target=array_element(node.value_type table)
            if source isnt? none and target isnt? none and views.structural_base(source table) not=? views.structural_base(target table) {
                exclude(source @excluded table) exclude(target @excluded table)
            }
        }
        if node is? hir.FunctionCall {
            let callee=hir.node_at(nodes node.func)
            if callee is? hir.ExpressedIdentifier and (callee.name.startswith('__load') or callee.name.startswith('__store') or callee.name.startswith('__syscall')) {
                loop argument in node.pos_args {exclude_arrays(hir.node_at(nodes argument).value_type @excluded table)}
            }
        }
    }
    let dense:dict<addr layouts.Storage>=[]
    loop id in candidates {
        if id in? excluded or id in? context.nominals continue
        let node=types.node_at(table id)
        if node isnt? types.ObjectType or node.brand isnt? none or node.fields.length =? 0 continue
        if not inline_scalars(id context excluded @table) continue
        let record=layouts.record(id context @table)
        if record is? layouts.Pending or layouts.brand_field in? record.offsets continue
        dense[id]=layouts.Storage[record.size record.alignment]
    }
    return Plan[dense]
}

$explicit_copies

import p"layouts.dewy" as layouts
import p"../../semantic/ty.dewy" as types
import p"../../semantic/hir.dewy" as hir
import p"../../semantic/type_queries.dewy" as views

# The first dense representation is deliberately bounded: flat scalar
# records with no dynamic brand or lifecycle behavior. The plan is made
# once, from checked types and HIR, before runtime lowering erases them.
# Every occurrence of an element type agrees on its physical representation.
Plan:type = const [dense:dict<addr layouts.Storage>=[]]

exclude = (id:addr @excluded:set<addr> table:types.Table):>void => {
    excluded.push(views.structural_base(id table))
}

# A raw-exposed aggregate can contain arrays several fields below its root.
# Keep their existing ABI until raw dense storage has its own contract.
exclude_arrays = (id:addr @excluded:set<addr> table:types.Table):>void => {
    let pending:array<addr>=[id]
    let visited:set<addr>=set[]
    loop pending.length >? 0 {
        let plain=views.structural_base(pending.pop table)
        if plain in? visited continue
        visited.push(plain)
        let node=types.node_at(table plain)
        if node is? types.ArrayType {exclude(node.element @excluded table) pending.push(node.element)}
        else if node is? types.ObjectType {loop field in node.fields {pending.push(field.value_type)}}
        else if node is? types.TypeOr {loop item in node.items {pending.push(item)}}
    }
}

array_element = (id:addr table:types.Table):>addr? => {
    let node=types.node_at(table views.structural_base(id table))
    return if node is? types.ArrayType node.element else none
}

select = (nodes:array<hir.AST> context:layouts.Context @table:types.Table):>Plan => {
    let candidates:set<addr>=set[]
    let excluded:set<addr>=set[]
    loop type in table.entries {
        if type is? types.ArrayType {candidates.push(views.structural_base(type.element table))}
        if type is? types.ObjectType and type.brand in? ['dict' 'set'] {
            # Dictionary compaction currently moves owning handles. Keep
            # the same representation for ordinary arrays of these types.
            loop field in type.fields {
                if field.name not in? ['keys' 'values'] continue
                let element=array_element(field.value_type table)
                if element isnt? none {exclude(element @excluded table)}
            }
        }
    }
    loop node in nodes {
        if node is? hir.ArrayMethod and node.name =? 'sort' {
            let element=array_element(hir.node_at(nodes node.array).value_type table)
            if element isnt? none {exclude(element @excluded table)}
        }
        if node is? hir.Transmute {
            exclude_arrays(node.value_type @excluded table)
            exclude_arrays(hir.node_at(nodes node.expr).value_type @excluded table)
        }
        if node is? hir.ValueCast {
            let source=array_element(hir.node_at(nodes node.expr).value_type table)
            let target=array_element(node.value_type table)
            if source isnt? none and target isnt? none and views.structural_base(source table) not=? views.structural_base(target table) {
                exclude(source @excluded table) exclude(target @excluded table)
            }
        }
        if node is? hir.FunctionCall {
            let callee=hir.node_at(nodes node.func)
            if callee is? hir.ExpressedIdentifier and (callee.name.startswith('__load') or callee.name.startswith('__store') or callee.name.startswith('__syscall')) {
                loop argument in node.pos_args {exclude_arrays(hir.node_at(nodes argument).value_type @excluded table)}
            }
        }
    }
    let dense:dict<addr layouts.Storage>=[]
    loop id in candidates {
        if id in? excluded or id in? context.nominals continue
        let node=types.node_at(table id)
        if node isnt? types.ObjectType or node.brand isnt? none or node.fields.length =? 0 continue
        let scalar=true
        loop method in node.methods {if method.lifecycle isnt? none {scalar=false}}
        loop field in node.fields {
            let plain=views.structural_base(field.value_type table)
            if not types.is_primitive(types.node_at(table plain) 'bool') and views.fixed_integer_layout(plain table) is? none {scalar=false}
        }
        if not scalar continue
        let record=layouts.record(id context @table)
        if record is? layouts.Pending or layouts.brand_field in? record.offsets continue
        dense[id]=layouts.Storage[record.size record.alignment]
    }
    return Plan[dense]
}

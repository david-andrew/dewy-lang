# integers
let a = 0
let b = 42
let c = 1_000_000
let d = 0d99          # explicit decimal prefix
let e = 0b1011        # binary
let f = 0t102T        # ternary, and balanced ternary with T
let g = 0q3210        # quaternary
let h = 0s543210      # seximal
let i = 0o777         # octal
let j = 0z1XE         # dozenal (X and E are digits; case-insensitive: 0z1xe)
let k = 0xDEAD_beef   # hexadecimal, case-insensitive, with an underscore
# numeric literals stop at base 16; bases 32, 36, and 64 are written as based strings (see 03_strings)
# reals
let o = 3.14
let p = 1.0
let q = 1.23e4
let r = 1.23E+4
let s = 1.23e-4
let t = 1e10
let u = 2E-23
let v = 0x1.0x8p10    # hex mantissa halves, binary exponent: 1.5 × 2¹⁰
let w = 0x1.0x8p0xA   # the exponent may be based too
let x = 10.25p3       # p on a base-10 number (allowed; the later stage may warn)
# numbers next to identifiers are juxtaposition (units), not one token
let y = 20N * 10m
let z = 3x            # 3 juxtaposed with x
# ranges are numbers around `..`
let r1 = 0..10
let r2 = 1,3..10      # a stepped range: the first pair gives the step
let r3 = [0..10)
let r4 = (0..10]

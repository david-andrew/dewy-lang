# whitespace is spaces, tabs, and newlines; juxtaposition is meaningful later, so keep it exact
let x = 1
let  y  =  2
	let z = 3	# a tab before and after
let snake_case = 4
let camelCase = 5
let CONSTANT_LIKE = 6
let _leading_underscore = 7
let trailing_ = 8
let with_digits_123 = 9
let λ = 10            # identifier characters: ASCII letters, Greek, the math letters ℂℕℤℚℝℙℍ, `_`, `!`, `°`
let ℝ = 11
let Δx = 12
let x² = 13          # decoration characters (superscripts, subscripts, primes, ™) may appear anywhere in an identifier
let vₘₐₓ = 14
let f′ = 15
let ²x = 16          # even leading, as long as one start character follows
let a1b2c3 = 17
let end = 18          # `end` is an identifier with special meaning in an index, not a keyword
let none_like = 19
let voidish = 20
let True = 21          # booleans are case-insensitive identifiers: `true`, `True`, `TRUE` are the boolean
let truthy = TRUE
let falsy = false
let isnt = 22         # `is` is not an operator; `is?` and `isnt?` are, but `isnt` alone is a name
let of_ = 23
let done! = 24        # `!` is an identifier character
let temp° = 25

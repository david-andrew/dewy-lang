# line comments run to the end of the line
#{ block comments are delimited by #{ and }# }#
#{ they may span
   several lines }#
#{ and nest: #{ an inner block }# still inside the outer }#
let a = 1 # a comment after code, with symbols in it: # { } #{ not an opener because it is inside a line comment
let b = 2 #{ a block comment }# let c = 3 #{ code after a block comment on the same line
}# let d = 4
# a comment containing quotes ' " and backticks `
#{}#
#{#{}#}#
# the last line has no newline after it
# last comment, no trailing newline
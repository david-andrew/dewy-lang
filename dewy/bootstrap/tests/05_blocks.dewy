# every bracket kind, nested, with the juxtapositions around them
let a = (1 + 2) * 3
let b = [1 2 3]
let c = [1, 2, 3]
let d = {1  2  3}
let e = <int64>
let f = [ [1 2] [3 4] ]
let g = ([{<x>}])
let h = f(x)(y)[z]{w}
let i = xs[0]
let j = xs[1..3]
let k = xs[1..3)
let l = xs(1..3]
let m = xs(1..3)
let n = xs[i..]
let o = xs[..i]
let p = xs[i..end]
# based blocks: digits inside default to the base
let q = 0x[ff 00 12]
let r = 0b[1010 0101]
let s = 0o[777 123]
# type blocks with comparison operators inside: `>?` inside `<>` is an operator, `>` alone closes
let t = array<int64 length >? 0>
let u = uint64<(<? src.length)>
let v = int64<i => i >=? 0 and i <? 10>
let w = string<length=?1>
let x = dict<string int64>
let y = <(a:int64 b:int64):>int64>
let z = type<Token>
# empty blocks
let aa = ()
let ab = []
let ac = {}
# blocks across lines, with comments inside
let ad = [
    1   # one
    2   #{ two }#
    3
]
let ae = {
    let inner = 1
    inner + 1
}
# a type block nested in a block nested in a type block
let af = array<[x:int64 y:array<int64>]>

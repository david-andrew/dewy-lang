#!/usr/bin/env python3
"""Run this checkout's current native compiler from any working directory."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from tools.core import toolchain


def main():
    try:
        binary = toolchain()
        # Keep the caller's paths, streams and process ID, including for watch/LSP.
        os.execve(binary, [str(binary), *sys.argv[1:]], os.environ.copy())
    except (OSError, RuntimeError) as error:
        print(f'dewy development: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())

<script>
(() => {
  // Mirror the site's theme mode (dewy-theme: auto, light or dark) into mdBook's
  // key before mdBook paints. Auto removes mdbook-theme so mdBook follows the
  // system with its default light/dark themes (dewy-light/dewy-dark).
  const linkKey = "dewy-theme-link";
  const siteKey = "dewy-theme";
  const bookKey = "mdbook-theme";
  const toBook = { light: "dewy-light", dark: "dewy-dark" };
  const oldBook = { light: "dewy-light", navy: "dewy-dark", coal: "dewy-dark" };
  try {
    let book = localStorage.getItem(bookKey);
    if (book && oldBook[book]) {
      book = oldBook[book];
      localStorage.setItem(bookKey, book);
    }
    if (book === "rust" || book === "ayu") {
      localStorage.setItem(linkKey, "off");
      return;
    }
    if (localStorage.getItem(linkKey) === "off") return;
    const site = localStorage.getItem(siteKey);
    if (site === "light" || site === "dark") {
      localStorage.setItem(bookKey, toBook[site]);
    } else if (site === "auto") {
      localStorage.removeItem(bookKey);
    } else if (book === "dewy-light" || book === "dewy-dark") {
      localStorage.setItem(siteKey, book === "dewy-dark" ? "dark" : "light");
    }
  } catch {
    // ignore
  }
})();
</script>

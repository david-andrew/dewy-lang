# The exact `rational`: a normalized fraction (positive denominator, coprime
# parts) over mathematical `int` parts. A part is a machine word while it fits
# and a big integer beyond, so small fractions keep word arithmetic and no
# operation overflows. Reduction strategies are adapted from the old
# library/rational.dewy; representation and error handling use the compact core.
from bigint import BigInt, bigint, parse_bigint, _ratio_float_bits

Rational:type=[numerator:int=0 denominator:int=1]
# The explicit fixed-width form, `rational<int64>`: normalized int64 parts.
# Its arithmetic is the exact result when that fits the parts, else Overflow.
RationalWord:type=[numerator:int64=0 denominator:int64=1]

_integer = ((value:int):>int=>value)
    & ((value:BigInt):>int=>value)
    & ((value:string):>int=>bigint(value))

# Euclid on machine words while both parts are immediate words (below 2^62:
# a wider bound would itself be a big constant), the big-integer gcd beyond.
_gcd=(a:int b:int):>int=>{
    let x=a.abs()
    let y=b.abs()
    if x <=? 4611686018427387903 and y <=? 4611686018427387903 {
        let u:int64=x
        let v:int64=y
        loop v not=? 0 {
            let r=u%v
            u=v
            v=r
        }
        return u
    }
    let big:BigInt=x
    let other:BigInt=y
    return big.gcd(other)
}

_make=(numerator:int denominator:int):>Rational=>{
    if denominator =? 0 panic("rational denominator must be nonzero")
    if denominator <? 0 {numerator=-numerator denominator=-denominator}
    if numerator =? 0 return Rational[]
    if denominator =? 1 return Rational[numerator 1]
    let common=_gcd(numerator denominator)
    if common =? 1 return Rational[numerator denominator]
    return Rational[numerator//common denominator//common]
}
rational = ((numerator denominator=1):>Rational=>_make(_integer(numerator) _integer(denominator)))
    & ((text:string):>Rational=>{
        let parsed=parse_rational(text)
        if parsed is? none panic("invalid rational text")
        return parsed
    })

# `rational(x)` of a float: a finite float is exactly sign * mantissa * 2^exponent,
# and that value is the result, unrounded. NaN and infinity have none, and are
# rejected as the integer conversion rejects them.
_from_float=(value:float64):>Rational=>{
    let bits=f64_bits(value)
    let exponent=((bits >> 52) and 2047).wrap(int64)
    if exponent =? 2047 panic("rational of a NaN or infinite float")
    let mantissa=(bits and 4503599627370495).wrap(int64)
    if exponent =? 0 exponent=1 else mantissa=mantissa+4503599627370496
    if mantissa =? 0 return Rational[]
    if (bits >> 63) =? 1 mantissa=-mantissa
    return _mul(Rational[mantissa 1] pow(Rational[2 1] exponent-1075))
}

parse_rational=(text:string):>Rational|none=>{
    let parts=text.split("/")
    if parts.length <? 1 or parts.length >? 2 return none
    let numerator=parse_bigint(parts[0])
    if numerator is? none return none
    let denominator=bigint(1)
    if parts.length =? 2 {
        let parsed=parse_bigint(parts[1])
        if parsed is? none or parsed =? 0 return none
        denominator=parsed
    }
    return _make(_integer(numerator) _integer(denominator))
}

_neg=(value:Rational):>Rational=>Rational[-value.numerator value.denominator]
# Knuth's addition (TAOCP 4.5.1): with g = gcd(d1 d2) only a gcd against g
# remains, and equal or unit denominators need none of the cross products.
_add=(a:Rational b:Rational):>Rational=>{
    if a.denominator =? b.denominator {
        if a.denominator =? 1 return Rational[a.numerator+b.numerator 1]
        return _make(a.numerator+b.numerator a.denominator)
    }
    if a.denominator =? 1 return Rational[a.numerator*b.denominator+b.numerator b.denominator]
    if b.denominator =? 1 return Rational[a.numerator+b.numerator*a.denominator a.denominator]
    let common=_gcd(a.denominator b.denominator)
    if common =? 1 return Rational[a.numerator*b.denominator+b.numerator*a.denominator a.denominator*b.denominator]
    let left=a.denominator//common
    let right=b.denominator//common
    let total=a.numerator*right+b.numerator*left
    if total =? 0 return Rational[]
    let reduction=_gcd(total common)
    return Rational[total//reduction left*(b.denominator//reduction)]
}
_sub=(a:Rational b:Rational):>Rational=>_add(a _neg(b))
# Cross-reduction keeps the products small and the result coprime.
_mul=(a:Rational b:Rational):>Rational=>{
    if a.denominator =? 1 and b.denominator =? 1 return Rational[a.numerator*b.numerator 1]
    let left=_gcd(a.numerator b.denominator)
    let right=_gcd(b.numerator a.denominator)
    if left =? 0 or right =? 0 return Rational[]
    return Rational[(a.numerator//left)*(b.numerator//right) (a.denominator//right)*(b.denominator//left)]
}
reciprocal=(value:Rational):>Rational=>{
    if value.numerator =? 0 panic("rational division by zero")
    if value.numerator <? 0 return Rational[-value.denominator -value.numerator]
    return Rational[value.denominator value.numerator]
}
_div=(a:Rational b:Rational):>Rational=>_mul(a reciprocal(b))
_eq=(a:Rational b:Rational):>bool=>a.numerator =? b.numerator and a.denominator =? b.denominator
_lt=(a:Rational b:Rational):>bool=>{
    if a.denominator =? b.denominator return a.numerator <? b.numerator
    return a.numerator*b.denominator <? b.numerator*a.denominator
}
floor = ((value:Rational):>int=>value.numerator//value.denominator)
    & ((value:RationalWord):>int=>floor(_widen(value)))
ceil = ((value:Rational):>int=>-((-value.numerator)//value.denominator))
    & ((value:RationalWord):>int=>ceil(_widen(value)))
# The nearest integer; a half goes to the even one, as the float conversions round.
round = ((value:Rational):>int=>{
        let whole=value.numerator//value.denominator
        let twice=(value.numerator-whole*value.denominator)*2
        if twice <? value.denominator return whole
        if twice >? value.denominator or whole%2 =? 1 return whole+1
        return whole
    })
    & ((value:RationalWord):>int=>round(_widen(value)))
# Toward zero: the integer conversion, `int(q)` and `q as int`.
_truncate = ((value:Rational):>int=>if value.numerator <? 0 ceil(value) else floor(value))
    & ((value:RationalWord):>int=>_truncate(_widen(value)))
abs=(value:Rational):>Rational=>if value.numerator <? 0 _neg(value) else value

_widen=(value:RationalWord):>Rational=>Rational[value.numerator value.denominator]
_word_fits=(value:Rational):>bool=>{
    let n=value.numerator
    let d=value.denominator
    if n >=? -4611686018427387904 and n <=? 4611686018427387903 and d <=? 4611686018427387903 return true
    return n >=? -9223372036854775808 and n <=? 9223372036854775807 and d <=? 9223372036854775807
}
_narrow=(value:Rational):>RationalWord|Overflow=>{
    if not _word_fits(value) return Overflow
    let n:int64=value.numerator
    let d:int64=value.denominator
    return RationalWord[n d]
}
# `rational<int64>(value)` and `rational<int64>(numerator denominator)`: the
# explicit narrowing, Overflow when a normalized part leaves int64.
_word_rational = ((value:Rational):>RationalWord|Overflow=>_narrow(value))
    & ((numerator:int denominator:int):>RationalWord|Overflow=>_narrow(_make(numerator denominator)))
# Powers stop at the first factor that leaves the parts: coprime factors never
# shrink again, so the result could not fit either.
_word_pow=(base:RationalWord exponent:int64):>RationalWord|Overflow=>{
    let value=_widen(base)
    let remaining=exponent.wrap(uint64)
    if exponent <? 0 {value=reciprocal(value) remaining=0-remaining}
    let result=Rational[1 1]
    loop remaining >? 0 {
        if (remaining and 1) =? 1 {
            result=Rational[result.numerator*value.numerator result.denominator*value.denominator]
            if not _word_fits(result) return Overflow
        }
        remaining=remaining >> 1
        if remaining >? 0 {
            value=Rational[value.numerator*value.numerator value.denominator*value.denominator]
            if not _word_fits(value) return Overflow
        }
    }
    return _narrow(result)
}

# Exact operands below 2^53 (2^24) make one IEEE division the correctly
# rounded ratio; larger parts round the exact ratio once from their limbs.
_word_float64=(value:RationalWord):>float64=>to_float64(_widen(value))
_word_float32=(value:RationalWord):>float32=>to_float32(_widen(value))
to_float64=(value:Rational):>float64=>{
    let n=value.numerator
    let d=value.denominator
    if n >=? -9007199254740992 and n <=? 9007199254740992 and d <=? 9007199254740992 {
        let x:int64=n
        let y:int64=d
        return float64(x)/float64(y)
    }
    let top:BigInt=n
    let bottom:BigInt=d
    return f64_from_bits(_ratio_float_bits(top._sign <? 0 top._limbs bottom._limbs 52 11))
}
to_float32=(value:Rational):>float32=>{
    let n=value.numerator
    let d=value.denominator
    if n >=? -16777216 and n <=? 16777216 and d <=? 16777216 {
        let x:int64=n
        let y:int64=d
        return float32(x)/float32(y)
    }
    let top:BigInt=n
    let bottom:BigInt=d
    return f32_from_bits(_ratio_float_bits(top._sign <? 0 top._limbs bottom._limbs 23 8).wrap(uint32))
}

pow=(value:Rational exponent:int64):>Rational=>{
    let remaining=exponent.wrap(uint64)
    if exponent <? 0 {value=reciprocal(value) remaining=0-remaining}
    let result=Rational[1 1]
    # Powers of the same reduced fraction remain coprime: no repeated GCD.
    loop remaining >? 0 {
        if (remaining and 1) =? 1 result=Rational[result.numerator*value.numerator result.denominator*value.denominator]
        remaining=remaining >> 1
        if remaining >? 0 value=Rational[value.numerator*value.numerator value.denominator*value.denominator]
    }
    return result
}
RationalDivision:type=[quotient:int remainder:Rational]
divmod=(a:Rational b:Rational):>RationalDivision=>{
    let quotient=floor(_div(a b))
    return RationalDivision[quotient _sub(a _mul(b Rational[quotient 1]))]
}
_floordiv=(a:Rational b:Rational):>int=>floor(_div(a b))
_mod=(a:Rational b:Rational):>Rational=>divmod(a b).remainder

__as__ = ((value:Rational):>string=>{
        if value.denominator =? 1 return "{value.numerator}"
        return "{value.numerator}/{value.denominator}"
    })
    & ((value:RationalWord):>string=>{
        if value.denominator =? 1 return "{value.numerator}"
        return "{value.numerator}/{value.denominator}"
    })
__unary_sub__ = ((value:Rational):>Rational=>_neg(value))
    & ((value:RationalWord):>RationalWord|Overflow=>_narrow(_neg(_widen(value))))

__add__ = ((a:Rational b:Rational):>Rational=>_add(a b))
    & ((a:Rational b:int):>Rational=>_add(a Rational[b 1]))
    & ((a:int b:Rational):>Rational=>_add(Rational[a 1] b))
    & ((a:Rational b:BigInt):>Rational=>_add(a Rational[b 1]))
    & ((a:BigInt b:Rational):>Rational=>_add(Rational[a 1] b))
    & ((a:RationalWord b:RationalWord):>RationalWord|Overflow=>_narrow(_add(_widen(a) _widen(b))))
    & ((a:RationalWord b:int):>RationalWord|Overflow=>_narrow(_add(_widen(a) Rational[b 1])))
    & ((a:int b:RationalWord):>RationalWord|Overflow=>_narrow(_add(Rational[a 1] _widen(b))))

__sub__ = ((a:Rational b:Rational):>Rational=>_sub(a b))
    & ((a:Rational b:int):>Rational=>_sub(a Rational[b 1]))
    & ((a:int b:Rational):>Rational=>_sub(Rational[a 1] b))
    & ((a:Rational b:BigInt):>Rational=>_sub(a Rational[b 1]))
    & ((a:BigInt b:Rational):>Rational=>_sub(Rational[a 1] b))
    & ((a:RationalWord b:RationalWord):>RationalWord|Overflow=>_narrow(_sub(_widen(a) _widen(b))))
    & ((a:RationalWord b:int):>RationalWord|Overflow=>_narrow(_sub(_widen(a) Rational[b 1])))
    & ((a:int b:RationalWord):>RationalWord|Overflow=>_narrow(_sub(Rational[a 1] _widen(b))))

__mul__ = ((a:Rational b:Rational):>Rational=>_mul(a b))
    & ((a:Rational b:int):>Rational=>_mul(a Rational[b 1]))
    & ((a:int b:Rational):>Rational=>_mul(Rational[a 1] b))
    & ((a:Rational b:BigInt):>Rational=>_mul(a Rational[b 1]))
    & ((a:BigInt b:Rational):>Rational=>_mul(Rational[a 1] b))
    & ((a:RationalWord b:RationalWord):>RationalWord|Overflow=>_narrow(_mul(_widen(a) _widen(b))))
    & ((a:RationalWord b:int):>RationalWord|Overflow=>_narrow(_mul(_widen(a) Rational[b 1])))
    & ((a:int b:RationalWord):>RationalWord|Overflow=>_narrow(_mul(Rational[a 1] _widen(b))))

__truediv__ = ((a:Rational b:Rational):>Rational=>_div(a b))
    & ((a:Rational b:int):>Rational=>_div(a Rational[b 1]))
    & ((a:int b:Rational):>Rational=>_div(Rational[a 1] b))
    & ((a:Rational b:BigInt):>Rational=>_div(a Rational[b 1]))
    & ((a:BigInt b:Rational):>Rational=>_div(Rational[a 1] b))
    & ((a:RationalWord b:RationalWord):>RationalWord|Overflow=>_narrow(_div(_widen(a) _widen(b))))
    & ((a:RationalWord b:int):>RationalWord|Overflow=>_narrow(_div(_widen(a) Rational[b 1])))
    & ((a:int b:RationalWord):>RationalWord|Overflow=>_narrow(_div(Rational[a 1] _widen(b))))

__eq__ = ((a:Rational b:Rational):>bool=>_eq(a b))
    & ((a:Rational b:int):>bool=>a.denominator =? 1 and a.numerator =? b)
    & ((a:int b:Rational):>bool=>b.denominator =? 1 and a =? b.numerator)
    & ((a:Rational b:BigInt):>bool=>_eq(a Rational[b 1]))
    & ((a:BigInt b:Rational):>bool=>_eq(Rational[a 1] b))
    & ((a:RationalWord b:RationalWord):>bool=>a.numerator =? b.numerator and a.denominator =? b.denominator)
    & ((a:RationalWord b:int):>bool=>a.denominator =? 1 and a.numerator =? b)
    & ((a:int b:RationalWord):>bool=>b.denominator =? 1 and a =? b.numerator)

__lt__ = ((a:Rational b:Rational):>bool=>_lt(a b))
    & ((a:Rational b:int):>bool=>a.numerator <? b*a.denominator)
    & ((a:int b:Rational):>bool=>a*b.denominator <? b.numerator)
    & ((a:Rational b:BigInt):>bool=>_lt(a Rational[b 1]))
    & ((a:BigInt b:Rational):>bool=>_lt(Rational[a 1] b))
    & ((a:RationalWord b:RationalWord):>bool=>_lt(_widen(a) _widen(b)))
    & ((a:RationalWord b:int):>bool=>_lt(_widen(a) Rational[b 1]))
    & ((a:int b:RationalWord):>bool=>_lt(Rational[a 1] _widen(b)))

__floordiv__ = ((a:Rational b:Rational):>int=>_floordiv(a b))
    & ((a:Rational b:int):>int=>_floordiv(a Rational[b 1]))
    & ((a:int b:Rational):>int=>_floordiv(Rational[a 1] b))
    & ((a:Rational b:BigInt):>int=>_floordiv(a Rational[b 1]))
    & ((a:BigInt b:Rational):>int=>_floordiv(Rational[a 1] b))

__mod__ = ((a:Rational b:Rational):>Rational=>_mod(a b))
    & ((a:Rational b:int):>Rational=>_mod(a Rational[b 1]))
    & ((a:int b:Rational):>Rational=>_mod(Rational[a 1] b))
    & ((a:Rational b:BigInt):>Rational=>_mod(a Rational[b 1]))
    & ((a:BigInt b:Rational):>Rational=>_mod(Rational[a 1] b))

__pow__ = ((base:Rational exponent:int64):>Rational=>pow(base exponent))
    & ((base:RationalWord exponent:int64):>RationalWord|Overflow=>_word_pow(base exponent))

# Quantities in exact turns and seconds reach the system here. A turn count reduces exactly to
# the nearest quarter turn and the rest of a quarter turn (|rest| <= 1/2) before evaluation.
_QuarterTurns:type=[quarter:int64 rest:float64]
_quarter_turns=(turns:Rational):>_QuarterTurns=>{
    let x=turns*4
    let k=floor(x+Rational[1 2])
    let quarter:int64=k%4
    return _QuarterTurns[quarter to_float64(x-Rational[k 1])]
}
_sin_turns=(turns:Rational):>float64=>{let q=_quarter_turns(turns) return __sin_quarters(q.quarter q.rest)}
_cos_turns=(turns:Rational):>float64=>{let q=_quarter_turns(turns) return __sin_quarters(q.quarter+1 q.rest)}
_tan_turns=(turns:Rational):>float64=>{let q=_quarter_turns(turns) return __tan_quarters(q.quarter q.rest)}

# Whole nanoseconds, rounded down: sleep's system boundary.
_whole_nanoseconds=(seconds:Rational):>int64=>{
    let count=floor(seconds*1000000000)
    if count <? 0 return 0
    if count >? 9223372036854775807 return 9223372036854775807
    return count
}

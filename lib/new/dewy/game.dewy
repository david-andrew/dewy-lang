# Run with: dewy-core watch main.dewy
# Edit update or draw and save: the game keeps running with the new code.
window("Dewy game" 1280 720)

let position=vec2(640.0 360.0)
let trail:array<vec2>=[]

update=(dt:float64):>void=>{
    position=approach(position mouse_pos() 10.0 dt)
    trail.push(position)
    if trail.length >? 40 {trail.pop(0);}
}

draw=():>void=>{
    clear(rgb(0.025 0.045 0.08))
    loop point in trail {circle(point 8.0 rgb(0.15 0.4 0.45))}
    circle(position 24.0 rgb(0.3 0.9 0.8))
    text("DEWY / PLAY" vec2(32.0 24.0) 32.0 rgb(0.85 0.95 1.0))
    text("Move the mouse. Edit this file and save to reload." vec2(32.0 68.0) 20.0 rgb(0.5 0.65 0.75))
}

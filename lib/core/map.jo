# Hash map {K: V}: insertion ordered, open addressing over a dense entry list.
# The first two fields must stay `__keys` and `vals` (the compiler iterates them in mutable loops).
# A removed entry stays in place, marked gone (so the others keep theirs), its slot a tombstone
# (entry -1: probes go on past it); when half of them are gone, they are taken out at once.

struct __MapSlot:
    tag: u64
    entry: int       # 0 = empty, -1 = removed, otherwise dense entry index + 1

# Integer tags hold the complete key; other keys use a full hash and equality.
# This avoids a dependent read from the dense key array for integer lookups.
# Keep equality's array access inside the generic overload: evaluating keys[e]
# before calling it would pay that read even when the integer tag is sufficient.
__map_tag = (k: int, h: u64) -> u64: u64(k)
__map_tag = (k: u64, h: u64) -> u64: k
__map_tag[K] = (k: K, h: u64) -> u64: h
__map_slot_equal = (keys: int[], e: int, k: int) -> bool: true
__map_slot_equal = (keys: u64[], e: int, k: u64) -> bool: true
__map_slot_equal[K] = (keys: K[], e: int, k: K) -> bool: __at(keys, e) == k

struct Map[K, V]:
    __keys: K[]
    vals: V[]
    slots: __MapSlot[]
    hashes: u64[]
    gone: bool[]      # (entries removed since the last compaction: true; shorter than keys when
                      # entries were added after the last removal)
    ngone: int

# A dense iteration snapshot needs no hash table, hashes or removal bitmap.
# Its first two fields share the Map loop layout used by the compiler.
struct __MapEntries[K, V]:
    __keys: K[]
    vals: V[]

__map_entries[K, V] = (m: Map[K, V]) -> __MapEntries[K, V]:
    if m.ngone == 0: return __MapEntries(m.__keys, m.vals)
    keys: K[]
    vals: V[]
    keys.reserve(m.len())
    vals.reserve(m.len())
    ng = m.gone.len()
    loop i in 0.. and key in m.__keys:
        if i < ng and __at(m.gone, i): continue
        keys.push(key)
        vals.push(__at(m.vals, i))
    __MapEntries(keys, vals)

len[K, V] = (entries: __MapEntries[K, V]) -> int: entries.__keys.len()
__map_pair_at[K, V] = (entries: __MapEntries[K, V], i: int) -> (K, V):
    (entries.__keys[i], entries.vals[i])

# full 64-bit avalanche (murmur3 finalizer): every key bit affects the low bits used for slots,
# so keys like multiples of 4096 or float bit patterns spread out
hash = (x: int) -> u64: hash(u64(x))

hash = (x: u64) -> u64:
    h = (x xor (x >> 33))
    h = h * 0xFF51AFD7ED558CCD
    h = (h xor (h >> 33))
    h = h * 0xC4CEB9FE1A85EC53
    (h xor (h >> 33))

hash = (x: bool) -> u64:
    if x: return 1
    0

hash = (x): __hash_value(x)
# (a secret's hash is a secret: compiler/secrets.jo; sloppy0 has no secrets)
when not BOOTSTRAP:
    hash[T] = (x: secret[T]) -> secret[u64]: hash(x.reveal)

# ---------------- dictionaries' keyed hash ----------------
# `hash` gives the same value in every run (a game's peers compare them). A dictionary's slots
# instead come from a hash keyed by a secret word k drawn from the operating system once per
# process, and the key is inside the hashing state from the first input word on: an int is
# mum(x ^ k, k ^ C); a string's state starts from k and takes 16 bytes per keyed mum, as wyhash
# does; a record's helper (compiler/lower.jo) chains its members through the same keyed mum.
# mum(a, b) folds the 128-bit product: low half xor high half (the high half by __mul_hi, one
# instruction on x86-64 and arm64).
#
# Why chosen keys cannot collide, in a slot (the low bits) or at all: for any two inputs and a
# uniformly random k, the multiplicands x ^ k and y ^ k are uniformly random (only their xor is
# fixed) and the other factor is an unknown random word, so through the carries of the full
# product every output bit depends on every input bit and on the key, and no input difference
# gives an output difference that holds whatever k is (a multiply alone keeps a top-bit
# difference; the folded high half does not). Two keys share their low bits with probability
# about 2^-bits, and finding better pairs needs k: a program never shows a slot (iteration
# follows insertion order) and k is never stored where a program reads it. Strings and records
# never pass through the unkeyed `hash`, so collisions of FNV or of `hash` do not carry over.
__hash_key: u64 = 0
__hash_key_lock = 0

# A program that wants the same slots every run (the compiler: its instruction counts are
# measured) pins the key before its first dictionary entry; false if one was drawn already.
__hash_key_pin = (k: u64) -> bool:
    lk = &__hash_key_lock
    loop __atomic_cas(lk, 0, 1) != 0: pass
    pinned = __hash_key == 0
    if pinned: __hash_key = k | 1
    __hash_key_lock = 0
    pinned

@noinline
__hash_key_init = () -> u64:
    lk = &__hash_key_lock
    loop __atomic_cas(lk, 0, 1) != 0: pass
    k = __hash_key
    if k == 0:
        k = __entropy_word()
        if k == 0: k = 0x9E3779B97F4A7C15
        __hash_key = k
    __hash_key_lock = 0
    k

# the 128-bit product of a and b, its high half xor its low half
__hk_mum = (a: u64, b: u64) -> u64:
    when __MUL_HI:
        return (a * b) xor __mul_hi(a, b)
    __mul_hi_soft(a, b) xor (a * b)

# the high 64 bits of a 128-bit product from four 32-bit ones (WebAssembly; older compilers)
__mul_hi_soft = (a: u64, b: u64) -> u64:
    a0 = a & 0xFFFFFFFF
    a1 = a >> 32
    b0 = b & 0xFFFFFFFF
    b1 = b >> 32
    p00 = a0 * b0
    p01 = a0 * b1
    p10 = a1 * b0
    mid = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF)
    a1 * b1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)

# x under key k (written out, not through __hk_mum: a leaf, which default builds inline)
__hk_mix = (k: u64, x: u64) -> u64:
    a = x xor k
    b = k xor 0xE7037ED1A0B428DB
    when __MUL_HI:
        return (a * b) xor __mul_hi(a, b)
    (a * b) xor __mul_hi_soft(a, b)

# Only __map_add (and reserve) draw the key: a dictionary's first entry is hashed again there,
# after the key is drawn. Until then every keyed hash uses 0 (a lookup in a dictionary with
# nothing in it finds no entry), and no check slows the ones after.
__hk_word = (x: u64) -> u64:
    k = __hash_key
    a = x xor k
    b = k xor 0xE7037ED1A0B428DB
    when __MUL_HI:
        return (a * b) xor __mul_hi(a, b)
    (a * b) xor __mul_hi_soft(a, b)

# n bytes at p: sixteen at a time (the last sixteen overlapping the ones before), the state
# starting from the key and the length
__hk_bytes = (p: *u8, n: int) -> u64:
    k = __hash_key
    k1 = k xor 0xE7037ED1A0B428DB
    h = k xor (u64(n) * 0x9E3779B97F4A7C15)
    i = 0
    loop n - i > 16:
        h = __hk_mum(((p + i) as *u64)[0] xor k1, ((p + (i + 8)) as *u64)[0] xor h)
        i += 16
    a: u64 = 0
    b: u64 = 0
    if n > 8:
        a = ((p + (n - 16 + (if n < 16: 16 - n else: 0))) as *u64)[0]
        b = ((p + (n - 8)) as *u64)[0]
    else if n >= 4: a = u64((p as *u32)[0]) | (u64(((p + (n - 4)) as *u32)[0]) << 32)
    else if n > 0: a = u64(p[0]) | (u64(p[n >> 1]) << 8) | (u64(p[n - 1]) << 16)
    h = __hk_mum(a xor k1, b xor h)
    __hk_mum(h xor k, u64(n) xor k1)

# The compiler turns this on: its keyed value hash (`__hash_value(x, true)`) mixes every member
# under the key. (Older compilers building this library mix the key into `hash`'s result.)
const __KEYED_HASH = false
const __MUL_HI = false        # (the compiler has __mul_hi)
# (the compiler has secrets: a key is hashed as __map_hash(__secret_value(k)), a secret key as
# its value, with the same code; compiler/secrets.jo)
const __SECRETS = false

__map_hash = (k: int) -> u64: __hk_word(k as u64)
__map_hash = (k: u64) -> u64: __hk_word(k)
__map_hash = (k: str) -> u64: __hk_bytes(data(k), len(k))
__map_hash[K] = (k: K) -> u64:
    when __KEYED_HASH:
        return __hash_value(k, true)
    __hk_word(k.hash())

# xs[i] where the library knows i is in bounds (the compiler leaves out the check; the C
# bootstrap compiler calls this)
__at[T] = (xs: T[], i: int) -> T: xs[i]

# Slots has a power-of-two length when not empty. Positive slot entries index
# keys, vals and hashes, which each have an element per dense entry. Empty and
# removed slots are distinguished independently of the tag (zero is a valid
# key/hash). A differing tag skips equality and its separate key-array read.
# k's entry, or -2 - the empty slot where it would go (-1 when there are no slots yet)
__map_probe[K, V] = (m: Map[K, V], k: K, h: u64) -> int:
    ns = m.slots.len()
    if ns == 0: return -1
    mask = ns - 1
    i = int(h) & mask
    tag = __map_tag(k, h)
    loop true:
        s = __at(m.slots, i)
        if s.entry == 0: return -2 - i
        if s.entry > 0 and s.tag == tag:
            e = s.entry - 1
            if __map_slot_equal(m.__keys, e, k): return e
        i = (i + 1) & mask

__map_find[K, V] = (m: Map[K, V], k: K, h: u64) -> int:
    ns = m.slots.len()
    if ns == 0: return -1
    mask = ns - 1
    i = int(h) & mask
    tag = __map_tag(k, h)
    loop true:
        s = __at(m.slots, i)
        if s.entry == 0: return -1
        if s.entry > 0 and s.tag == tag:
            e = s.entry - 1
            if __map_slot_equal(m.__keys, e, k): return e
        i = (i + 1) & mask

__map_rehash[K, V] = (m: mut Map[K, V], ns: int):
    m.slots.clear()
    m.slots.resize(ns)
    mask = ns - 1
    ng = m.gone.len()
    loop e in 0.. and h in m.hashes:
        if e < ng and __at(m.gone, e): continue
        i = int(h) & mask
        loop m.slots[i].entry != 0: i = (i + 1) & mask
        m.slots[i] = __MapSlot(__map_tag(__at(m.__keys, e), h), e + 1)

# A key's own `hash` (found in the key's defining module, as equality finds its operator
# there) reaches __map_hash through the compiler's keyed value hash.
([]=)[K, V] = (m: mut Map[K, V], k: K, v: V):
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_probe(m, k, h)
    if e >= 0:
        m.vals[e] = v
        return
    __map_add(m, k, v, h, -2 - e)

# Insert only a new key, preserving an existing value and its position. Returns
# whether an entry was added; avoids a second hash/probe after checking absence.
insert_if_absent[K, V] = (m: mut Map[K, V], k: K, v: V) -> bool:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_probe(m, k, h)
    if e >= 0: return false
    __map_add(m, k, v, h, -2 - e)
    true

# the entry of k, for changing m[k] in place (m[k] += 1, m[k].push(x), m[k].hp -= 5): a missing
# key is added, its value starting as V's zero value (or the default d, for a struct with
# default field values)
__map_entry[K, V] = (m: mut Map[K, V], k: K) -> int:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_probe(m, k, h)
    if e >= 0: return e
    z: V
    __map_add(m, k, z, h, -2 - e)
    m.__keys.len() - 1

__map_entry[K, V] = (m: mut Map[K, V], k: K, d: V) -> int:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_probe(m, k, h)
    if e >= 0: return e
    __map_add(m, k, d, h, -2 - e)
    m.__keys.len() - 1

# the entry of k, for changing m[k] in place in Dewy: a missing key fails as reading m[k] does
__map_entry_present[K, V] = (m: mut Map[K, V], k: K) -> int:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_find(m, k, h)
    # (the key is not said, nor any key that is there: either may be a secret)
    if e < 0: panic("the dictionary has no entry for this key to change: d[k] += 1 changes an entry that is there; to count, write `if k in? d \{d[k] += 1} else \{d[k] = 1}`")
    e

# room for n entries without growing (when many are to come)
reserve[K, V] = (m: mut Map[K, V], n: int):
    if __hash_key == 0: __hash_key_init()
    m.__keys.reserve(n)
    m.vals.reserve(n)
    m.hashes.reserve(n)
    ns = 8
    loop ns * 3 < (n + 1) * 4: ns *= 2
    if ns > m.slots.len(): __map_rehash(m, ns)

# a new entry (k is not in m; slot: the empty slot a probe for it ended at, or -1)
__map_add[K, V] = (m: mut Map[K, V], k: K, v: V, h0: u64, slot0: int = -1):
    h = h0
    slot = slot0
    n = m.__keys.len()
    if n == 0:
        # (the first entry: the key drawn if no dictionary has drawn it, and k hashed again, in case
        # its hash was taken before, with 0, here or on another thread)
        if __hash_key == 0: __hash_key_init()
        when __SECRETS: h = __map_hash(__secret_value(k))
        when not __SECRETS: h = __map_hash(k)
        slot = -1
    tag = __map_tag(k, h)
    if (n + 1) * 4 > m.slots.len() * 3 and m.ngone > 0:
        # (what is gone taken out first: there may be room then)
        __map_compact(m)
        n = m.__keys.len()
        slot = -1
    if (n + 1) * 4 > m.slots.len() * 3:
        ns = m.slots.len() * 2
        if ns < 8: ns = 8
        m.__keys.push(k)
        m.vals.push(v)
        m.hashes.push(h)
        __map_rehash(m, ns)
        return
    m.__keys.push(k)
    m.vals.push(v)
    m.hashes.push(h)
    i = slot
    if i < 0:
        mask = m.slots.len() - 1
        i = int(h) & mask
        loop m.slots[i].entry != 0: i = (i + 1) & mask
    m.slots[i] = __MapSlot(tag, n + 1)

([])[K, V] = (m: Map[K, V], k: K) -> V:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_find(m, k, h)
    if e < 0: panic("the dictionary has no entry for this key: `get(key)` gives none for a missing key, and `has(key)` asks whether it is there")
    __at(m.vals, e)

get[K, V] = (m: Map[K, V], k: K) -> V?:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_find(m, k, h)
    if e < 0: return none
    __at(m.vals, e)

get[K, V] = (m: Map[K, V], k: K, default: V) -> V:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    e = __map_find(m, k, h)
    if e < 0: return default
    __at(m.vals, e)

# (the hash first, apart: a call between reading m and the lookup would make m a snapshot)
contains[K, V] = (m: Map[K, V], k: K) -> bool:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    __map_find(m, k, h) >= 0
has[K, V] = (m: Map[K, V], k: K) -> bool:
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    __map_find(m, k, h) >= 0
len[K, V] = (m: Map[K, V]) -> int: m.__keys.len() - m.ngone

# Positional access for a compacted iteration snapshot, not a key lookup.
# Ordinary parameters evaluate each source/index once and retain value copies.
__map_pair_at[K, V] = (m: Map[K, V], i: int) -> (K, V): (m.__keys[i], m.vals[i])
is_empty[K, V] = (m: Map[K, V]) -> bool: m.__keys.len() == m.ngone
keys[K, V] = (m: Map[K, V]) -> K[]:
    if m.ngone == 0: return m.__keys
    # Project only the requested field. Compacting a snapshot would also copy
    # values, hashes and slots, then rebuild a hash table we never use.
    result: K[]
    result.reserve(m.len())
    ng = m.gone.len()
    loop i in 0.. and key in m.__keys:
        if i < ng and __at(m.gone, i): continue
        result.push(key)
    result
values[K, V] = (m: Map[K, V]) -> V[]:
    if m.ngone == 0: return m.vals
    result: V[]
    result.reserve(m.len())
    ng = m.gone.len()
    loop i in 0.. and value in m.vals:
        if i < ng and __at(m.gone, i): continue
        result.push(value)
    result

clear[K, V] = (m: mut Map[K, V]):
    m.__keys.clear()
    m.vals.clear()
    m.slots.clear()
    m.hashes.clear()
    m.gone.clear()
    m.ngone = 0

# remove a key; returns true if it was present. The others keep their order.
remove[K, V] = (m: mut Map[K, V], k: K) -> bool:
    ns = m.slots.len()
    if ns == 0: return false
    when __SECRETS: h = __map_hash(__secret_value(k))
    when not __SECRETS: h = __map_hash(k)
    mask = ns - 1
    i = int(h) & mask
    tag = __map_tag(k, h)
    loop true:
        s = m.slots[i]
        if s.entry == 0: return false
        if s.entry > 0 and s.tag == tag:
            e = s.entry - 1
            if __map_slot_equal(m.__keys, e, k):
                # (a tombstone where its slot was; the entry gone, letting go of what it held)
                m.slots[i] = __MapSlot(0, -1)
                if m.gone.len() < m.__keys.len(): m.gone.resize(m.__keys.len())
                m.gone[e] = true
                __release_at(m.__keys, e)
                __release_at(m.vals, e)
                m.ngone += 1
                if m.ngone * 2 > m.__keys.len(): __map_compact(m)
                return true
        i = (i + 1) & mask
    false

# xs[i] lets go of what it held and is left zero bytes, which nothing reads until the place is
# written again. The compiler makes no T for them, so T's contract need not admit zero; this
# body serves compilers from before that.
__release_at[T] = (xs: mut T[], i: int):
    z: T
    xs[i] = z

# the gone entries taken out, and the slots made again
__map_compact[K, V] = (m: mut Map[K, V]):
    if m.ngone == 0: return
    ng = m.gone.len()
    w = 0
    loop e in [0..m.__keys.len()):
        if e < ng and m.gone[e]: continue
        if w != e:
            __relocate_at(m.__keys, w, e)
            __relocate_at(m.vals, w, e)
            m.hashes[w] = m.hashes[e]
        w += 1
    m.__keys.truncate(w)
    m.vals.truncate(w)
    m.hashes.truncate(w)
    m.gone.clear()
    m.ngone = 0
    __map_rehash(m, m.slots.len())

# the same keys with equal values (in any order)
# (not for sloppy0: it would take the generic (==) for all structs)
when not BOOTSTRAP:
    # Hash each key/value association, then combine entries without depending
    # on insertion order, capacity or removed slots. Keys and values use their
    # own hash methods, matching the equality operations below.
    hash[K, V] = (m: Map[K, V]) -> u64:
        total: u64 = 0
        ng = m.gone.len()
        loop i in 0.. and k in m.__keys:
            if i < ng and __at(m.gone, i): continue
            kh = k.hash()
            vh = __at(m.vals, i).hash()
            total += hash(kh xor ((vh << 1) | (vh >> 63)))
        hash(total xor u64(m.len()))

    (==)[K, V] = (a: Map[K, V], b: Map[K, V]) -> bool:
        if a.len() != b.len(): return false
        ng = a.gone.len()
        loop i in 0.. and k in a.__keys:
            if i < ng and a.gone[i]: continue
            e = __map_find(b, k, __at(a.hashes, i))
            if e < 0 or not (__at(b.vals, e) == __at(a.vals, i)): return false
        true

# Older development compilers call this while building the next compiler from
# its new library snapshot. Current checking uses __map_entries instead.
__map_live[K, V] = (m: Map[K, V]) -> Map[K, V]:
    if m.ngone == 0: return m
    c = m
    __map_compact(c)
    c

# (a `loop mut` over a map: the map itself made so first)
__map_tidy[K, V] = (m: mut Map[K, V]): __map_compact(m)

__fmt[K, V] = (buf: mut u8[], m: Map[K, V]):
    __buf_byte(buf, '{{')
    ng = m.gone.len()
    first = true
    loop i in 0.. and k in m.__keys:
        if i < ng and m.gone[i]: continue
        if not first: __buf_append_str(buf, ", ")
        first = false
        __fmt_elem(buf, k)
        __buf_append_str(buf, ": ")
        __fmt_elem(buf, m.vals[i])
    __buf_byte(buf, '}}')

# (Dewy's dictionary literal: ["a" -> 1 "b" -> 2])
__dewy_fmt[K, V] = (buf: mut u8[], m: Map[K, V]):
    __buf_byte(buf, '[')
    ng = m.gone.len()
    first = true
    loop i in 0.. and k in m.__keys:
        if i < ng and m.gone[i]: continue
        if not first: __buf_byte(buf, ' ')
        first = false
        __dewy_fmt_elem(buf, k)
        __buf_append_str(buf, " -> ")
        __dewy_fmt_elem(buf, m.vals[i])
    __buf_byte(buf, ']')

__dewy_fmt_elem[K, V] = (buf: mut u8[], m: Map[K, V]): __dewy_fmt(buf, m)

# ({loop w in words: w: len(w)}: a map from its (key, value) pairs; a later key replaces an earlier)
__map_of[K, V] = (pairs: (K, V)[]) -> {K: V}:
    m: {K: V}
    loop p in pairs: m[p.0] = p.1
    m

# Mechanical transfer into a vacant compaction slot. Earlier compilers keep
# their copy/release implementation; current compilers transfer live markers.
__relocate_at[T] = (xs: mut T[], dst: int, src: int):
    xs[dst] = xs[src]
    __release_at(xs, src)

# Transfer a live value out, leaving a vacant slot for immediate removal.
__take_at[T] = (xs: mut T[], i: int) -> T:
    value = xs[i]
    __release_at(xs, i)
    value

# Resource key copies may change their value. Insert each copied entry through
# the ordinary hash/equality path rather than reuse the source's hash table.
__map_copy_owners[K, V] = (m: Map[K, V]) -> Map[K, V]:
    result: Map[K, V]
    ng = m.gone.len()
    loop i in 0.. and key in m.__keys:
        if i < ng and __at(m.gone, i): continue
        result[key] = __at(m.vals, i)
    result

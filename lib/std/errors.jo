# Error ancestry is metadata for the Dewy checker; the Sloppy seed sees records.
@nominal(error)
struct FileNotFound:
    pass
@nominal(error)
struct FileAccessDenied:
    pass
@nominal(error)
struct IsDirectory:
    pass
@nominal(error)
struct FileExists:
    pass
@nominal(error)
struct FileError:
    pass
@nominal(error)
struct InvalidUtf8:
    pass
# A search that found nothing (`text.find(part)`, `xs.index_of(x)`): an
# exception, so it forwards like none, but distinct from none and from -1.
@nominal(exception)
struct Missing:
    pass
# Why to_int(text) failed (provisional names): the text is not an integer (empty, a stray
# character, spaces, `_` or 0x), or it has more digits than max_digits= allows.
@nominal(error)
struct NotAnInteger:
    pass
@nominal(error)
struct TooManyDigits:
    pass
# A pattern regex(pattern) cannot read, or too big to match in reasonable time.
@nominal(error)
struct RegexError:
    message: str
# A checked text reader preserves the reason and the original input.
@nominal(error)
struct ValidationError:
    message: str
    input: str

# Time (lib/time): text that does not read, fields no calendar or UTC day has, an exact value
# off a tick's grid or past a width, and a time no pinned table covers.
@nominal(error)
struct ParseError:
    message: str
@nominal(error)
struct InvalidFields:
    message: str
@nominal(error)
struct InvalidDate:
    message: str
@nominal(error)
struct UnknownZone:
    message: str
@nominal(error)
struct MissingContext:
    message: str
# A local time no clock showed (`before` and `after`: the offsets around it, seconds east of UTC).
@nominal(error)
struct Gap:
    message: str
    before: int
    after: int
# A local time clocks showed more than once (`offsets`: each reading's, earliest instant first).
@nominal(error)
struct Ambiguous:
    message: str
    offsets: int[]
@nominal(error)
struct OffGrid:
    pass
@nominal(error)
struct OutOfRange:
    pass
@nominal(error)
struct OutsideCoverage:
    message: str
# A square matrix whose rows are not independent.
@nominal(error)
struct Singular:
    pass
# A fixed-width result that does not fit its parts (rational<int64> arithmetic).
@nominal(error)
struct Overflow:
    pass

# Standard input ended (`input`, `input_int`, `input_float`). Reaching `main`, it is exit 1.
@nominal(error)
struct EndOfInput:
    exit_code: int = 1
# `window` could not open one: no display, or no driver (`message` says which).
@nominal(error)
struct WindowError:
    message: str
# The operating system gave no random bytes (`secure_random_bytes`).
@nominal(error)
struct NoEntropy:
    pass

type InputFailure = EndOfInput | FileError | Canceled
type __FileFailure = FileNotFound | FileAccessDenied | IsDirectory | FileExists | FileError | Canceled

__file_failure = () -> __FileFailure:
    if __task_canceled(): return Canceled
    code = __task_file_code()
    if code == 2: return FileNotFound()
    if code == 13 or code == 1: return FileAccessDenied()
    if code == 21: return IsDirectory()
    if code == 17: return FileExists()
    FileError()

# Error ancestry is metadata for the Dewy checker; the Jo seed sees records.
@nominal(error)
struct FileNotFound:
    pass
@nominal(error)
struct FileAccessDenied:
    pass
@nominal(error)
struct IsDirectory:
    pass
@nominal(error)
struct FileExists:
    pass
@nominal(error)
struct FileError:
    pass
@nominal(error)
struct InvalidUtf8:
    pass
# A search that found nothing (`text.find(part)`, `xs.index_of(x)`): an
# exception, so it forwards like none, but distinct from none and from -1.
@nominal(exception)
struct Missing:
    pass
# A fixed-width result that does not fit its parts (rational<int64> arithmetic).
@nominal(error)
struct Overflow:
    pass

type __FileFailure = FileNotFound | FileAccessDenied | IsDirectory | FileExists | FileError

__file_failure = () -> __FileFailure:
    code = __file_error_code
    if code == 2: return FileNotFound()
    if code == 13 or code == 1: return FileAccessDenied()
    if code == 21: return IsDirectory()
    if code == 17: return FileExists()
    FileError()

# Data parallelism on a pool of worker threads (fork-join).
#
#   squares = parallel_map(nums, (x): x * x)
#   parallel_update(particles, (p): step(p, dt))      # xs[i] = f(xs[i]), in place
#   rows = parallel_range(height, (y): render_row(y))
#
# The function runs on several threads at once: it may read anything, but it must not change
# globals or the variables it captured (that would be a data race); return results instead.
# On the web target everything runs on the calling thread.

# number of hardware threads available to this process
cpu_count = () -> int:
    when TARGET == "wasm":
        return 1
    else when TARGET == "windows":
        return max(int(GetActiveProcessorCount(u16(0xFFFF))), 1)
    else when TARGET == "macos":
        return max(int(__mac_sysconf(i32(58))), 1)                  # _SC_NPROCESSORS_ONLN
    else:
        mask = fill(0, 16)
        r = syscall(204, 0, 128, data(mask))           # sched_getaffinity
        if r <= 0: return 1
        n = 0
        loop w in mask:
            x = w
            loop x != 0:
                n += x & 1
                x = (x >> 1) & 0x7FFFFFFFFFFFFFFF
        if n < 1: n = 1
        n

when TARGET == "windows":
    @lib("kernel32.dll")
    extern GetActiveProcessorCount = (group: u16) -> u32
else when TARGET == "macos":
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("sysconf")
    extern __mac_sysconf = (name: i32) -> int

# Library kernels may explicitly choose their sequential implementation.
__par_serial = false

@parallel
__parallel_run = (total: int, f: (int, int) -> void):
    if total <= 0: return
    __rng_threads()
    when TARGET == "wasm":
        was = __rng_in_job
        __rng_in_job = true
        f(0, total)
        __rng_in_job = was
    else:
        __fj_run(total, (&f) as *int)

# [loop x in xs: f(x)], computed in parallel (f must not change globals or what it captured)
@parallel
parallel_map[T, U] = (xs: T[], f: (T) -> U) -> U[]:
    out: U[]
    n = xs.len()
    if n == 0: return out
    out.resize(n)
    op = data(out)
    ip = data(xs)
    __parallel_run(n, (lo: int, hi: int):
        loop i in [lo..hi): op[i] = f(ip[i])
    )
    out

# xs[i] = f(xs[i]) for every element, in parallel
@parallel
parallel_update[T] = (xs: mut T[], f: (T) -> T):
    n = xs.len()
    if n == 0: return
    xs.reserve(n)                      # make the storage unique before sharing it
    p = data(xs)
    __parallel_run(n, (lo: int, hi: int):
        loop i in [lo..hi): p[i] = f(p[i])
    )

# [loop i in [0..n): f(i)], computed in parallel
@parallel
parallel_range[U] = (n: int, f: (int) -> U) -> U[]:
    out: U[]
    if n <= 0: return out
    out.resize(n)
    op = data(out)
    __parallel_run(n, (lo: int, hi: int):
        loop i in [lo..hi): op[i] = f(i)
    )
    out

# Compiler lowering for `parallel`: arrays and bounded ranges are indexed
# partitions. Collection slots are written once and gathered in source order.
@parallel
__dewy_parallel_collect[T, U] = (xs: T[], f: (T) -> U) -> U[]:
    parallel_map(xs, f)

__parallel_range_count = (r: IntRange) -> int:
    if r._empty: return 0
    if r._count == 0 or r._count > u64(9223372036854775807): panic("parallel range is too large")
    int(r._count)

@parallel
__dewy_parallel_collect[U] = (r: IntRange, f: (int) -> U) -> U[]:
    delta = if r._up: r._stride else: u64(0) - r._stride
    parallel_range(__parallel_range_count(r), (i: int): f(int(u64(r._first) + u64(i) * delta)))

@parallel
__dewy_parallel_each[T] = (xs: T[], f: (T) -> void):
    p = data(xs)
    __parallel_run(xs.len(), (lo: int, hi: int):
        loop i in [lo..hi): f(p[i])
    )

@parallel
__dewy_parallel_each = (r: IntRange, f: (int) -> void):
    delta = if r._up: r._stride else: u64(0) - r._stride
    __parallel_run(__parallel_range_count(r), (lo: int, hi: int):
        loop i in [lo..hi): f(int(u64(r._first) + u64(i) * delta))
    )

# ---------------- atomics ----------------
# Shared identity is explicit. The allocation owns the cell, copied handles
# retain it, and every access (including loads) is atomic. Backends may use a
# stronger order than requested; these portable primitives are seq_cst.
struct Atomic[T]:
    __cell: int[]
    __p: *int

struct CachePadded[T]:
    value: T

atomic[T] = (v: T) -> Atomic[T]:
    cell = fill(v as int, 1)
    p = data(cell)
    Atomic[T](cell, p)

atomic = (v: int = 0) -> Atomic[int]:
    cell = fill(v, 1)
    p = data(cell)
    Atomic[int](cell, p)

load[T] = (a: Atomic[T], order: str = "seq_cst") -> T:
    when TARGET == "wasm": return a.__p[0] as T
    else: return __atomic_add(a.__p, 0) as T

get[T] = (a: Atomic[T], order: str = "seq_cst") -> T: load(a, order)

# Add and return the new value, preserving the established atomic API.
add[T] = (a: Atomic[T], v: T, order: str = "seq_cst") -> T:
    when TARGET == "wasm":
        a.__p[0] += (v as int)
        return a.__p[0] as T
    else:
        when size_of(T) == 8:
            return (__atomic_add(a.__p, (v as int)) + (v as int)) as T
        else:
            loop:
                old = __atomic_add(a.__p, 0)
                next = ((old as T) + v) as T
                if __atomic_cas(a.__p, old, next as int) == old: return next

store[T] = (a: Atomic[T], v: T, order: str = "seq_cst"):
    loop:
        old = load(a)
        if compare_swap(a, old, v): return

set[T] = (a: Atomic[T], v: T, order: str = "seq_cst"): store(a, v, order)

compare_swap[T] = (a: Atomic[T], expected: T, v: T, order: str = "seq_cst") -> bool:
    when TARGET == "wasm":
        if a.__p[0] != (expected as int): return false
        a.__p[0] = v as int
        return true
    else: return __atomic_cas(a.__p, (expected as int), (v as int)) == (expected as int)

set_max[T] = (a: Atomic[T], v: T, order: str = "seq_cst"):
    loop:
        old = load(a)
        if old >= v or compare_swap(a, old, v): return

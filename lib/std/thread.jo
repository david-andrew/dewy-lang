# Data parallelism on a pool of worker threads (fork-join).
#
#   squares = parallel_map(nums, (x): x * x)
#   parallel_update(particles, (p): step(p, dt))      # xs[i] = f(xs[i]), in place
#   rows = parallel_range(height, (y): render_row(y))
#
# The function runs on several threads at once: it may read anything, but it must not change
# globals or the variables it captured (that would be a data race); return results instead.
# On the web target everything runs on the calling thread.

# number of hardware threads available to this process
cpu_count = () -> int:
    when TARGET == "wasm":
        return 1
    else when TARGET == "windows":
        return max(int(GetActiveProcessorCount(u16(0xFFFF))), 1)
    else when TARGET == "macos":
        return max(int(__mac_sysconf(i32(58))), 1)                  # _SC_NPROCESSORS_ONLN
    else:
        mask = fill(0, 16)
        r = syscall(204, 0, 128, data(mask))           # sched_getaffinity
        if r <= 0: return 1
        n = 0
        loop w in mask:
            x = w
            loop x != 0:
                n += x & 1
                x = (x >> 1) & 0x7FFFFFFFFFFFFFFF
        if n < 1: n = 1
        n

when TARGET == "windows":
    @lib("kernel32.dll")
    extern GetActiveProcessorCount = (group: u16) -> u32
else when TARGET == "macos":
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("sysconf")
    extern __mac_sysconf = (name: i32) -> int

# Library kernels may explicitly choose their sequential implementation.
__par_serial = false

@parallel
__parallel_run = (total: int, f: (int, int) -> void):
    if total <= 0: return
    __rng_threads()
    when TARGET == "wasm":
        was = __rng_in_job
        __rng_in_job = true
        f(0, total)
        __rng_in_job = was
    else:
        __fj_run(total, (&f) as *int)

# [loop x in xs: f(x)], computed in parallel (f must not change globals or what it captured)
@parallel
parallel_map[T, U] = (xs: T[], f: (T) -> U) -> U[]:
    out: U[]
    n = xs.len()
    if n == 0: return out
    out.resize(n)
    op = data(out)
    ip = data(xs)
    __parallel_run(n, (lo: int, hi: int):
        loop i in [lo..hi): op[i] = f(ip[i])
    )
    out

# xs[i] = f(xs[i]) for every element, in parallel
@parallel
parallel_update[T] = (xs: mut T[], f: (T) -> T):
    n = xs.len()
    if n == 0: return
    xs.reserve(n)                      # make the storage unique before sharing it
    p = data(xs)
    __parallel_run(n, (lo: int, hi: int):
        loop i in [lo..hi): p[i] = f(p[i])
    )

# [loop i in [0..n): f(i)], computed in parallel
@parallel
parallel_range[U] = (n: int, f: (int) -> U) -> U[]:
    out: U[]
    if n <= 0: return out
    out.resize(n)
    op = data(out)
    __parallel_run(n, (lo: int, hi: int):
        loop i in [lo..hi): op[i] = f(i)
    )
    out

# Compiler lowering for `parallel`: arrays and bounded ranges are indexed
# partitions. Collection slots are written once and gathered in source order.
@parallel
__dewy_parallel_collect[T, U] = (xs: T[], f: (T) -> U) -> U[]:
    parallel_map(xs, f)

# (a range of 2^63 or more values counts as 2^63 - 1: collecting it runs out of
# memory, as allocation does, and running it does not end, as counting that far
# cannot; docs/design/assumptions.md)
__parallel_range_count = (r: IntRange) -> int:
    if r._empty: return 0
    if r._count == 0 or r._count > u64(9223372036854775807): return 9223372036854775807
    int(r._count)

@parallel
__dewy_parallel_collect[U] = (r: IntRange, f: (int) -> U) -> U[]:
    delta = if r._up: r._stride else: u64(0) - r._stride
    parallel_range(__parallel_range_count(r), (i: int): f(int(u64(r._first) + u64(i) * delta)))

@parallel
__dewy_parallel_each[T] = (xs: T[], f: (T) -> void):
    p = data(xs)
    __parallel_run(xs.len(), (lo: int, hi: int):
        loop i in [lo..hi): f(p[i])
    )

@parallel
__dewy_parallel_each = (r: IntRange, f: (int) -> void):
    delta = if r._up: r._stride else: u64(0) - r._stride
    __parallel_run(__parallel_range_count(r), (lo: int, hi: int):
        loop i in [lo..hi): f(int(u64(r._first) + u64(i) * delta))
    )

# ---------------- atomics ----------------
# Shared identity is explicit. The allocation owns the cell, copied handles
# retain it, and every access (including loads) is atomic. Backends may use a
# stronger order than requested; these portable primitives are seq_cst.
struct Atomic[T]:
    __cell: int[]
    __p: *int

struct CachePadded[T]:
    value: T

atomic[T] = (v: T) -> Atomic[T]:
    cell = fill(v as int, 1)
    p = data(cell)
    Atomic[T](cell, p)

atomic = (v: int = 0) -> Atomic[int]:
    cell = fill(v, 1)
    p = data(cell)
    Atomic[int](cell, p)

load[T] = (a: Atomic[T], order: str = "seq_cst") -> T:
    when TARGET == "wasm": return a.__p[0] as T
    else: return __atomic_add(a.__p, 0) as T

get[T] = (a: Atomic[T], order: str = "seq_cst") -> T: load(a, order)

# Add and return the new value. Plain storage narrows before publishing;
# policy payloads retain their modular/saturating arithmetic. The machine
# fetch-add is valid only for a full-width modular payload.
add[T] = (a: Atomic[T], v: T, order: str = "seq_cst") -> T:
    when TARGET != "wasm" and size_of(T) == 8 and __integer_mode(T) >= 2 and __integer_mode(T) <= 3:
        return (__atomic_add(a.__p, (v as int)) + (v as int)) as T
    else:
        loop:
            old = load(a)
            next = old + v
            when size_of(T) == 8 and __integer_mode(T) < 2:
                when __integer_mode(T) == 1:
                    if ((old xor next) & (v xor next)) < 0: panic("exact atomic result does not fit int64")
                else:
                    if next < old: panic("exact atomic result does not fit uint64")
            if compare_swap(a, old, next): return next

store[T] = (a: Atomic[T], v: T, order: str = "seq_cst"):
    loop:
        old = load(a)
        if compare_swap(a, old, v): return

set[T] = (a: Atomic[T], v: T, order: str = "seq_cst"): store(a, v, order)

compare_swap[T] = (a: Atomic[T], expected: T, v: T, order: str = "seq_cst") -> bool:
    when TARGET == "wasm":
        if a.__p[0] != (expected as int): return false
        a.__p[0] = v as int
        return true
    else: return __atomic_cas(a.__p, (expected as int), (v as int)) == (expected as int)

set_max[T] = (a: Atomic[T], v: T, order: str = "seq_cst"):
    loop:
        old = load(a)
        if old >= v or compare_swap(a, old, v): return

# ---------------- locks ----------------
# The shared state of Dewy's `Mutex<T>` (lib/prelude/locks.dewy). The allocation
# owns the word and the payload, copied handles retain it, and the word's
# address is the lock's identity: `lock_all` acquires in increasing address
# order, one canonical order for any set of locks. Word: 0 free, 1 held.
struct __LockState[T]:
    word: int
    value: T

struct __Lock[T]:
    __cell: __LockState[T][]
    __p: *__LockState[T]

__lock_new[T] = (v: T) -> __Lock[T]:
    cell: __LockState[T][] = [__LockState[T](0, v)]
    p = data(cell)
    __Lock[T](cell, p)

__lock_word[T] = (l: __Lock[T]) -> int: (&l.__p.word) as int

# (a word compared and set at once; the web runs one thread, so plainly)
__lock_cas = (w: int, expected: int, v: int) -> int:
    p = w as *int
    when TARGET == "wasm":
        old = p[0]
        if old == expected: p[0] = v
        return old
    else: return __atomic_cas(p, expected, v)

__lock_try_word = (w: int) -> bool: __lock_cas(w, 0, 1) == 0

# Waits for the word; not a cancellation point (a holder's critical section has no
# wait that needs the lock: the compiler's lock-order analysis, compiler/deadlock.jo).
__lock_wait_word = (w: int):
    spins = 0
    loop __lock_cas(w, 0, 1) != 0:
        spins += 1
        if spins > 64: __task_pause()

__lock_release_word = (w: int) -> void:
    __lock_cas(w, 1, 0)

# Acquires every word in increasing address order. 0: all held; 1: a word appears
# twice (nothing held); 2: canceled while waiting (everything released).
__lock_all_words = (ws: int[]) -> int:
    n = ws.len()
    order = ws
    order.sort()
    loop i in [1..n):
        if order[i] == order[i - 1]: return 1
    if __task_canceled(): return 2
    loop i in [0..n):
        spins = 0
        loop __lock_cas(order[i], 0, 1) != 0:
            spins += 1
            if spins > 64:
                if __task_canceled():
                    loop j in [0..i): __lock_cas(order[j], 1, 0)
                    return 2
                __task_pause()
    0

# ---------------- channels ----------------
# The shared state of Dewy's `Channel<T>` (lib/prelude/channels.dewy): a ring of `cap`
# slots under one word lock. `seq` changes with every send, receive and close, and
# waiters sleep on it (a futex), so a change wakes them; the 1 ms timeout and the
# cancellation signal let a waiter see its task canceled. The allocation owns the
# ring, and copied handles retain it.
struct __ChanState[T]:
    lock: int
    seq: int
    waiting: int
    closed: int
    head: int
    count: int
    cap: int
    slots: T[]

struct __Chan[T]:
    __cell: __ChanState[T][]
    __p: *__ChanState[T]

__chan_new[T] = (capacity: int) -> __Chan[T]:
    slots: T[]
    slots.resize(max(capacity, 1))
    cell: __ChanState[T][] = [__ChanState[T](0, 0, 0, 0, 0, 0, max(capacity, 1), slots)]
    p = data(cell)
    __Chan[T](cell, p)

# (the web runs one thread: no other holder, no one to wake)
__chan_lock = (p: *int):
    when TARGET == "wasm": p[0] = 1
    else: __task_lock(p)

__chan_unlock = (p: *int):
    when TARGET == "wasm": p[0] = 0
    else: __task_unlock(p)

# A change seen: the lock released and every waiter woken.
__chan_changed = (seq: *int, lock: *int, waiting: *int):
    when TARGET == "wasm":
        seq[0] += 1
        lock[0] = 0
    else:
        __atomic_add(seq, 1)
        w = __atomic_add(waiting, 0)
        __task_unlock(lock)
        when TARGET == "linux":
            if w != 0: syscall(202, seq, 129, 0x7FFFFFFF)

# Sleeps until seq moves on from s (the lock released first), or 1 ms passes.
__chan_park = (seq: *int, s: int, lock: *int, waiting: *int, spins: int):
    when TARGET == "linux":
        if spins < 16:
            __chan_unlock(lock)
            return
        __atomic_add(waiting, 1)
        __chan_unlock(lock)
        timeout = (0, 1000000)
        syscall(202, seq, 128, s, &timeout)
        __atomic_add(waiting, -1)
    else:
        __chan_unlock(lock)
        __task_pause()

# 0: room for one more (the lock held, for __chan_put); 1: closed; 2: canceled.
__chan_send_wait[T] = (c: __Chan[T]) -> int:
    p = c.__p
    spins = 0
    loop:
        if __task_canceled(): return 2
        __chan_lock(&p.lock)
        if p.closed != 0:
            __chan_unlock(&p.lock)
            return 1
        if p.count < p.cap: return 0
        __chan_park(&p.seq, p.seq, &p.lock, &p.waiting, spins)
        spins += 1

__chan_put[T] = (c: __Chan[T], v: T) -> void:
    p = c.__p
    i = p.head + p.count
    if i >= p.cap: i -= p.cap
    p.slots[i] = v
    p.count += 1
    __chan_changed(&p.seq, &p.lock, &p.waiting)

# 0: a value to take (the lock held, for __chan_take); 1: closed and drained; 2: canceled.
__chan_receive_wait[T] = (c: __Chan[T]) -> int:
    p = c.__p
    spins = 0
    loop:
        if __task_canceled(): return 2
        __chan_lock(&p.lock)
        if p.count > 0: return 0
        if p.closed != 0:
            __chan_unlock(&p.lock)
            return 1
        __chan_park(&p.seq, p.seq, &p.lock, &p.waiting, spins)
        spins += 1

# 0: a value to take (the lock held, for __chan_take); 1: none buffered. Never waits and is not a
# cancellation point: what drains a closed channel in cleanup (lib/prelude/protocols.dewy).
__chan_drain_wait[T] = (c: __Chan[T]) -> int:
    p = c.__p
    __chan_lock(&p.lock)
    if p.count > 0: return 0
    __chan_unlock(&p.lock)
    1

__chan_take[T] = (c: __Chan[T]) -> T:
    p = c.__p
    h = p.head
    v = p.slots[h]
    empty: T
    p.slots[h] = empty
    p.head = if h + 1 == p.cap: 0 else: h + 1
    p.count -= 1
    __chan_changed(&p.seq, &p.lock, &p.waiting)
    v

__chan_close[T] = (c: __Chan[T]) -> void:
    p = c.__p
    __chan_lock(&p.lock)
    p.closed = 1
    __chan_changed(&p.seq, &p.lock, &p.waiting)

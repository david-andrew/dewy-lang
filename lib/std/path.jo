# Paths as text: their parts, and joining them (nothing is looked up on the disk). Both / and \
# separate (Windows takes either).
#   file_name("art/hero.png") is "hero.png", dir_name(...) "art", extension(...) ".png",
#   without_extension(...) "art/hero", join_path("art", "hero.png") "art/hero.png"

__is_sep = (c: u8) -> bool: c == '/' or c == '\\'

# the last part: the file's name ("" for a path ending in a separator)
file_name = (path: str) -> str:
    i = len(path)
    loop i > 0 and not __is_sep(path[i - 1]): i -= 1
    path[i..]

# all but the last part ("." for a bare name; "/" for one at the root)
dir_name = (path: str) -> str:
    i = len(path)
    loop i > 0 and not __is_sep(path[i - 1]): i -= 1
    if i == 0: return "."
    j = i - 1
    loop j > 0 and __is_sep(path[j - 1]): j -= 1
    if j == 0: return path[..1)
    path[..j)

# the file name's extension with its dot (".png"; "" when it has none, or is like ".bashrc")
extension = (path: str) -> str:
    n = file_name(path)
    d = rfind(n, ".")
    if d <= 0: return ""
    n[d..]

# the path without its file name's extension ("art/hero.png" -> "art/hero")
without_extension = (path: str) -> str: path[..len(path) - len(extension(path)))

# a then b, with one separator between them (b as it is when it starts at the root)
join_path = (a: str, b: str) -> str:
    if len(a) == 0 or (len(b) > 0 and __is_sep(b[0])): return b
    if len(b) == 0: return a
    if __is_sep(a[len(a) - 1]): return a + b
    a + "/" + b

# the path from the root: a relative one from the working directory, with `.` and `..` worked
# out ("../x" in /home/me/src is /home/me/x; links are not followed). On Windows, with \
abs_path = (path: str) -> str:
    p = path
    drive = ""
    if len(p) > 1 and p[1] == ':':
        drive = p[..2)
        p = p[2..]
    if len(drive) == 0 and (len(p) == 0 or not __is_sep(p[0])): return abs_path(join_path(cwd(), p))
    parts: str[]
    start = 0
    loop i in [0..len(p) + 1):
        if i == len(p) or __is_sep(p[i]):
            part = p[start..i)
            start = i + 1
            if len(part) == 0 or part == ".": continue
            if part == "..":
                if parts.len() > 0: parts.pop()
                continue
            parts.push(part)
    when TARGET == "windows":
        return drive + "\\" + join(parts, "\\")      # (C:\Users\me, as Windows writes it)
    else:
        return drive + "/" + join(parts, "/")

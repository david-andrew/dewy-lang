# the program's end: what print collected written out, then what C's stdio holds (printf's
# output, which C writes out only at its own exit, which a Sloppy program does not go through)
@noinline
__end_flush = ():
    __run_end_fns()
    __out_flush()
    when TARGET == "macos":
        __mac_fflush(null)
    else when TARGET != "windows" and TARGET != "wasm":
        if __c_fflush != null: __c_fflush(null)
    when TARGET != "wasm":
        if __stdout_failed:
            __stdout_failed = false
            __write_err("error: could not write standard output\n")
            __exit_raw(1)

when TARGET == "macos":
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("fflush")
    extern __mac_fflush = (f: *u8) -> i32

__c_fflush: cfn(*u8) -> i32 = null

# (what parts of the library do as the program ends, once: net tells its peers it is going, so
# they know at once, not after some seconds of silence)
__end_fns: (() -> void)[]
__end_ran = false
__at_end = (f: () -> void): __end_fns.push(f)
__run_end_fns = ():
    if __end_ran: return
    __end_ran = true
    loop f in __end_fns: f()

# Where a panic goes instead of ending the process, while it is set: back to the prompt (in
# the compiler: an error in an input; in the session on Windows: an input that panicked), which
# puts memory back as it was (lib/std/snapshot.jo)
__repl_jmp: *u8 = null

__repl_unwind = ():
    when TARGET != "wasm":
        if __repl_jmp == null or __tid() != 0: return
        j = __repl_jmp
        __repl_jmp = null
        __longjmp(j, 1)

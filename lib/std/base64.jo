# Base64: bytes as text (A-Z a-z 0-9 + /, padded with =), and back.

__B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

base64_encode = (b: u8[]) -> str:
    out: u8[]
    i = 0
    loop i + 2 < b.len():
        v = (int(b[i]) << 16) | (int(b[i + 1]) << 8) | int(b[i + 2])
        out.push(__B64[v >> 18])
        out.push(__B64[(v >> 12) & 63])
        out.push(__B64[(v >> 6) & 63])
        out.push(__B64[v & 63])
        i += 3
    rest = b.len() - i
    if rest == 1:
        v = int(b[i]) << 16
        out.push(__B64[v >> 18])
        out.push(__B64[(v >> 12) & 63])
        out.push('=')
        out.push('=')
    else if rest == 2:
        v = (int(b[i]) << 16) | (int(b[i + 1]) << 8)
        out.push(__B64[v >> 18])
        out.push(__B64[(v >> 12) & 63])
        out.push(__B64[(v >> 6) & 63])
        out.push('=')
    str_from_bytes(out)

__b64_value = (c: u8) -> int:
    if c >= 'A' and c <= 'Z': return int(c) - int('A')
    if c >= 'a' and c <= 'z': return int(c) - int('a') + 26
    if c >= '0' and c <= '9': return int(c) - int('0') + 52
    if c == '+' or c == '-': return 62          # (also the URL-safe alphabet's - and _)
    if c == '/' or c == '_': return 63
    -1

# the bytes, or none if s is not base64 (spaces and line breaks in it are skipped)
base64_decode = (s: str) -> u8[]?:
    out: u8[]
    acc = 0
    bits = 0
    loop k in [0..len(s)):
        c = s[k]
        if c == '=': break
        if is_space(c): continue
        v = __b64_value(c)
        if v < 0: return none
        acc = (acc << 6) | v
        bits += 6
        if bits >= 8:
            bits -= 8
            out.push(u8((acc >> bits) & 255))
    out

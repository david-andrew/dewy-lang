# Unicode 16 extended grapheme clusters, adapted from library/unicode/graphemes.dewy.
# Strings keep the compact byte representation. This cursor streams boundaries;
# no per-string boundary descriptor or host Unicode service is required.
struct __GraphemeCursor:
    offset: int
    previous: int
    regional_run: int
    indic_context: int
    pictographic_chain: bool
    zwj_after_pictographic: bool

__grapheme_word = (table: u8[], offset: int) -> int:
    # Current native and web targets are little-endian and support unaligned
    # loads. Check the whole word once before reading packed table records.
    assert(offset >= 0 and offset <= table.len() - 4, "grapheme table word out of bounds")
    int(((data(table) + offset) as *u32)[0])

# Sorted nine-byte records: little-endian start, end, property.
__grapheme_property = (table: u8[], scalar: int) -> int:
    lo = 0
    hi = table.len() / 9
    loop lo < hi:
        mid = (lo + hi) / 2
        at = mid * 9
        if scalar < __grapheme_word(table, at): hi = mid
        else if scalar > __grapheme_word(table, at + 4): lo = mid + 1
        else: return int(table[at + 8])
    0

# Two table reads replace three binary searches. Each byte combines the
# grapheme-break class (bits 0..3), Indic class (4..5), and pictographic bit (6).
# The 4,352 little-endian u16 page IDs precede deduplicated 256-byte pages.
__grapheme_property_bits = (scalar: int) -> int:
    if scalar < 0 or scalar >= 0x110000: return 0
    __grapheme_page_lookup(embed("unicode/grapheme_pages.bin"), scalar)

# A read-only parameter keeps data(table) on the immutable view. A mutable
# local holding an embedded array would detach the whole table on every read.
__grapheme_page_lookup = (table: u8[], scalar: int) -> int:
    page = int(((data(table) + (scalar >> 8) * 2) as *u16)[0])
    int(table[8704 + page * 256 + (scalar & 255)])

# The next boundary, or -1 for malformed UTF-8. Context is retained across
# boundaries (notably for regional-indicator pairs). The scalar at the next
# boundary is consumed on the following call.
__grapheme_next = (s: str, c: mut __GraphemeCursor) -> int:
    start = c.offset
    # Adjacent ASCII bytes always break, except CR/LF. Require ASCII (or EOF)
    # at the next boundary too: a following combining scalar can extend the
    # cluster, and malformed lookahead must still use the checked decoder.
    if start < len(s):
        ascii_first = int(s[start])
        if ascii_first < 128:
            ascii_end = start + 1
            ascii_last = ascii_first
            if ascii_first == 13 and ascii_end < len(s) and s[ascii_end] == 10:
                ascii_end += 1
                ascii_last = 10
            if ascii_end == len(s) or s[ascii_end] < 128:
                c.previous = 0
                if ascii_last == 13: c.previous = 1
                else if ascii_last == 10: c.previous = 2
                else if ascii_last < 32 or ascii_last == 127: c.previous = 3
                c.regional_run = 0
                c.indic_context = 0
                c.pictographic_chain = false
                c.zwj_after_pictographic = false
                c.offset = ascii_end
                return ascii_end
    __grapheme_next_unicode(s, c)

# Keep the general decoder separate so its register requirements do not make
# the common ASCII case pay for the full Unicode state machine.
__grapheme_next_unicode = (s: str, c: mut __GraphemeCursor) -> int:
    start = c.offset
    loop c.offset < len(s):
        offset = c.offset
        first = int(s[offset])
        scalar = first
        count = 1
        minimum = 0
        if first >= 0xc2 and first <= 0xdf: scalar = first & 0x1f; count = 2; minimum = 0x80
        else if first >= 0xe0 and first <= 0xef: scalar = first & 0x0f; count = 3; minimum = 0x800
        else if first >= 0xf0 and first <= 0xf4: scalar = first & 0x07; count = 4; minimum = 0x10000
        else if first >= 0x80: return -1
        if count > len(s) - offset: return -1
        loop i in [1..count):
            next = int(s[offset + i])
            if next < 0x80 or next > 0xbf: return -1
            scalar = (scalar << 6) + (next & 0x3f)
        if scalar < minimum or scalar > 0x10ffff or scalar >= 0xd800 and scalar <= 0xdfff: return -1
        current = 0
        indic = 0
        pictographic = false
        if scalar < 128:
            if scalar == 13: current = 1
            else if scalar == 10: current = 2
            else if scalar < 32 or scalar == 127: current = 3
        else:
            properties = __grapheme_property_bits(scalar)
            current = properties & 15
            indic = (properties >> 4) & 3
            pictographic = properties & 64 != 0
        previous = c.previous
        boundary = true
        if previous == 1 and current == 2: boundary = false
        else if previous == 1 or previous == 2 or previous == 3 or current == 1 or current == 2 or current == 3: boundary = true
        else if previous == 4 and (current == 4 or current == 5 or current == 7 or current == 8): boundary = false
        else if (previous == 7 or previous == 5) and (current == 5 or current == 6): boundary = false
        else if (previous == 8 or previous == 6) and current == 6: boundary = false
        else if current == 9 or current == 10 or current == 11: boundary = false
        else if previous == 12: boundary = false
        else if indic == 1 and c.indic_context == 2: boundary = false
        else if pictographic and previous == 10 and c.zwj_after_pictographic: boundary = false
        else if previous == 13 and current == 13 and c.regional_run % 2 == 1: boundary = false
        if offset > start and boundary: return offset
        c.regional_run = if current == 13: c.regional_run + 1 else: 0
        c.zwj_after_pictographic = current == 10 and c.pictographic_chain
        if current != 9: c.pictographic_chain = pictographic
        if indic == 1: c.indic_context = 1
        else if indic == 3 and c.indic_context > 0: c.indic_context = 2
        else if indic != 2: c.indic_context = 0
        c.previous = current
        c.offset += count
    c.offset

# Byte offsets, including zero and the final byte length; none for invalid UTF-8.
grapheme_boundaries = (s: str) -> int[]?:
    c = __GraphemeCursor()
    out = [0]
    loop c.offset < len(s):
        next_byte = __grapheme_next(s, c)
        if next_byte < 0: return none
        out.push(next_byte)
    out

# An explicit, eagerly collected array of grapheme strings.
graphemes = (s: str) -> str[]:
    c = __GraphemeCursor()
    out: str[]
    loop c.offset < len(s):
        start = c.offset
        next_byte = __grapheme_next(s, c)
        assert(next_byte >= 0, "invalid UTF-8 in grapheme operation")
        out.push(s[start..next_byte))
    out

# Checked decoding retains an independent byte-string value. There is no host
# decoder or replacement-character policy: malformed input returns none.
# (well-formed UTF-8 is all that decides it: ASCII a word at a time, then each scalar's bytes,
# as __grapheme_next_unicode reads them)
__dewy_decode_utf8 = (source: u8[]) -> str?:
    n = source.len()
    p = data(source)
    i = 0
    loop i < n:
        if i + 8 <= n and ((p + i) as *u64)[0] & 0x8080808080808080 == 0:
            i += 8
            # (an ASCII tail: its last eight bytes, overlapping, at once)
            if i < n and i + 8 > n and ((p + n - 8) as *u64)[0] & 0x8080808080808080 == 0: i = n
            continue
        first = int(p[i])
        if first < 0x80:
            i += 1
            continue
        scalar = 0
        count = 0
        minimum = 0
        if first >= 0xc2 and first <= 0xdf:
            scalar = first & 0x1f
            count = 2
            minimum = 0x80
        else if first >= 0xe0 and first <= 0xef:
            scalar = first & 0x0f
            count = 3
            minimum = 0x800
        else if first >= 0xf0 and first <= 0xf4:
            scalar = first & 0x07
            count = 4
            minimum = 0x10000
        else: return none
        if count > n - i: return none
        loop k in [1..count):
            next = int(p[i + k])
            if next < 0x80 or next > 0xbf: return none
            scalar = (scalar << 6) + (next & 0x3f)
        if scalar < minimum or scalar > 0x10ffff or scalar >= 0xd800 and scalar <= 0xdfff: return none
        i += count
    str_from_bytes(source)

__dewy_string_length = (s: str) -> int:
    n = len(s)
    p = data(s)
    offset = 0
    count = 0
    last = 0
    # Eight ASCII bytes without CR are eight clusters. Read only full words;
    # CR/LF and the short tail use the scalar prefix loop below.
    loop offset + 8 <= n:
        word = ((p + offset) as *u64)[0]
        cr = word xor 0x0d0d0d0d0d0d0d0d
        if word & 0x8080808080808080 != 0 or (cr - 0x0101010101010101) & (cr xor 0xffffffffffffffff) & 0x8080808080808080 != 0: break
        last = offset + 7
        offset += 8
        count += 8
    loop offset < n and p[offset] < 128:
        last = offset
        first = p[offset]
        offset += 1
        if first == 13 and offset < n and p[offset] == 10: offset += 1
        count += 1
    if offset == n: return count
    # A non-ASCII combining scalar may extend the final ASCII cluster.
    # Revisit that cluster, restoring Unicode context from its first byte;
    # every earlier ASCII cluster is already complete.
    c = __GraphemeCursor()
    if offset > 0:
        c.offset = last
        count -= 1
    loop c.offset < n:
        assert(__grapheme_next(s, c) >= 0, "invalid UTF-8 in grapheme operation")
        count += 1
    count

# Dewy's text.find and text.rfind: grapheme positions, as indexing uses, or Missing
__dewy_find = (s: str, sub: str) -> int | Missing:
    at = find(s, sub)
    if at < 0: return Missing()
    __dewy_string_length(s[0..at))
__dewy_find = (s: str, sub: str, start: int) -> int | Missing:
    if start < 0: panic("find start {start} is before the string")
    from = len(__dewy_string_slice(s, 0, start, false, true))
    at = find(s, sub, from)
    if at < 0: return Missing()
    start + __dewy_string_length(s[from..at))
__dewy_rfind = (s: str, sub: str) -> int | Missing:
    at = rfind(s, sub)
    if at < 0: return Missing()
    __dewy_string_length(s[0..at))

__dewy_string_index = (s: str, index: int) -> str:
    if index < 0: panic("string index out of bounds")
    c = __GraphemeCursor()
    at = 0
    loop c.offset < len(s):
        start = c.offset
        next_byte = __grapheme_next(s, c)
        assert(next_byte >= 0, "invalid UTF-8 in grapheme operation")
        if at == index: return s[start..next_byte)
        at += 1
    panic("string index out of bounds")

__dewy_string_slice = (s: str, lo: int, hi: int, inclusive: bool, has_stop: bool) -> str:
    if lo < 0 or has_stop and (hi < 0 and not (inclusive and hi == -1) or inclusive and hi == 9223372036854775807): panic("string slice out of bounds")
    stop = hi
    if has_stop and inclusive: stop += 1
    if has_stop and lo > stop: panic("string slice out of bounds")
    c = __GraphemeCursor()
    at = 0
    start_byte = -1
    loop true:
        if at == lo: start_byte = c.offset
        if has_stop and at == stop:
            if start_byte < 0: panic("string slice out of bounds")
            return s[start_byte..c.offset)
        if c.offset == len(s): break
        assert(__grapheme_next(s, c) >= 0, "invalid UTF-8 in grapheme operation")
        at += 1
    if has_stop or start_byte < 0: panic("string slice out of bounds")
    s[start_byte..]

# Dewy loops retain only the input snapshot and a boundary cursor. The current
# cluster is an independent string value; breaking does not scan the tail.
struct __DewyGraphemeIter:
    text: str
    cursor: __GraphemeCursor

__dewy_grapheme_iter = (text: str) -> __DewyGraphemeIter:
    __DewyGraphemeIter(text, __GraphemeCursor())

__dewy_grapheme_done = (it: __DewyGraphemeIter) -> bool:
    it.cursor.offset >= len(it.text)

__dewy_grapheme_value = (it: mut __DewyGraphemeIter) -> str:
    start = it.cursor.offset
    next_byte = __grapheme_next(it.text, it.cursor)
    assert(next_byte >= 0, "invalid UTF-8 in grapheme operation")
    it.text[start..next_byte)

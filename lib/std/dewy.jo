# Numeric operations whose Dewy contract differs from the implementation language.
# Fixed-width powers wrap like multiplication; negative integer exponents require
# an explicit rational or floating base, never silently truncate to zero.
__dewy_power = (base: int, exponent: int) -> int:
    if exponent < 0: panic("negative integer exponent: use a rational or floating base")
    let base = base
    let exponent = exponent
    result = 1
    loop exponent > 0:
        if exponent & 1 == 1: result *= base
        exponent = exponent >> 1
        if exponent > 0: base *= base
    result

__dewy_power = (base: u64, exponent: int) -> u64:
    if exponent < 0: panic("negative integer exponent: use a rational or floating base")
    let base = base
    let exponent = exponent
    result: u64 = 1
    loop exponent > 0:
        if exponent & 1 == 1: result *= base
        exponent = exponent >> 1
        if exponent > 0: base *= base
    result

__dewy_power = (base: f64, exponent: f64) -> f64: pow(base, exponent)
__dewy_power = (base: f32, exponent: f32) -> f32: pow(base, exponent)

# Dewy's `d.pop(key)` removes an entry and gives its value; a missing key
# fails as `d[key]` does. `d.pop(key default=v)` gives v for a missing key (`default=none`:
# the value is optional).
pop[K, V] = (m: mut Map[K, V], k: K) -> V:
    entry = __map_entry_present(m, k)
    v = __take_at(m.vals, entry)
    m.remove(k)
    v

pop[K, V] = (m: mut Map[K, V], k: K, default: V?) -> V?:
    e = __map_find(m, k, __map_hash(k))
    if e < 0: return default
    v = __take_at(m.vals, e)
    m.remove(k)
    v

pop[K, V] = (m: mut Map[K, V], k: K, default: V) -> V:
    e = __map_find(m, k, __map_hash(k))
    if e < 0: return default
    v = __take_at(m.vals, e)
    m.remove(k)
    v

# Dewy's `xs.insert(value index)` names the value first.
# (a position past either end is the caller's to rule out: `panics` counts it)
__dewy_insert[T] = (xs: mut T[], value: T, index: int):
    if index < 0 or index > xs.len(): panic("insert index {index} out of bounds (length {xs.len()})")
    xs.insert(index, value)

# Dewy's xs.index_of(x): the first position holding x, or Missing
__dewy_index_of[T] = (xs: T[], x: T) -> int | Missing:
    loop i in 0.. and e in xs:
        if e == x: return i
    Missing()

# Dewy's helpers (docs/LANGUAGE.md, "Loops, text and optional values").
# `xs.count(value)`: how many elements are value (`xs.count(f)` counts those f accepts)
count[T] = (xs: T[], value: T) -> int:
    n = 0
    loop x in xs:
        if x == value: n += 1
    n

# `any(flags)` and `all(flags)` without a predicate: only of an array of bools
# (`all(xs .>? 0)`); with one, any element (`xs.any(f)`)
any = (xs: bool[]) -> bool:
    loop x in xs:
        if x: return true
    false
all = (xs: bool[]) -> bool:
    loop x in xs:
        if not x: return false
    true

is_empty = (s: str) -> bool: len(s) == 0

# text without a prefix or suffix it has, else the text as it is (once, not repeatedly)
remove_prefix = (s: str, prefix: str) -> str:
    if starts_with(s, prefix): return s[len(prefix)..]
    s
remove_suffix = (s: str, suffix: str) -> str:
    if ends_with(s, suffix): return s[..len(s) - len(suffix))
    s

# Dewy's `text.byte_slice(start stop)`: the text's bytes [start..stop) as a string, without
# reading its graphemes. Both ends are char boundaries (0, the byte length, or a byte that
# starts a UTF-8 sequence): the caller's obligation, proven or checked here.
__dewy_byte_slice = (s: str, start: int, stop: int) -> str:
    n = len(s)
    if start < 0 or start > stop or stop > n: panic("byte_slice({start} {stop}) is out of bounds: the text has {n} bytes")
    p = data(s)
    if start < n and int(p[start]) & 0xc0 == 0x80 or stop < n and int(p[stop]) & 0xc0 == 0x80: panic("byte_slice({start} {stop}) does not start and end on char boundaries")
    s[start..stop)

# Dewy's `bytes.read<uint64>(i)`, `read<uint32>`, `read<uint16>`: the word at byte offset i,
# little-endian (every target's order), at any alignment. `0 <=? i` and `i + 8 <=? bytes.length`
# (4, 2) are the caller's obligation, proven or checked here.
__dewy_read_u64 = (b: u8[], i: int) -> u64:
    if i < 0 or i > b.len() - 8: panic("read<uint64>({i}) is out of bounds: the array has {b.len()} bytes")
    ((data(b) + i) as *u64)[0]
__dewy_read_u32 = (b: u8[], i: int) -> u32:
    if i < 0 or i > b.len() - 4: panic("read<uint32>({i}) is out of bounds: the array has {b.len()} bytes")
    ((data(b) + i) as *u32)[0]
__dewy_read_u16 = (b: u8[], i: int) -> u16:
    if i < 0 or i > b.len() - 2: panic("read<uint16>({i}) is out of bounds: the array has {b.len()} bytes")
    ((data(b) + i) as *u16)[0]

# Keep the overflow policy in each product rather than erasing it at a helper call.
__dewy_policy_power[T] = (base: T, exponent: int) -> T:
    if exponent < 0: panic("negative integer exponent: use a rational or floating base")
    let base = base
    let exponent = exponent
    result: T = 1
    loop exponent > 0:
        if exponent & 1 == 1: result *= base
        exponent = exponent >> 1
        if exponent > 0: base *= base
    result

__dewy_policy_abs[T] = (value: T) -> T: if value < 0: -value else: value

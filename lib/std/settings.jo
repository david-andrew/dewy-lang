# Dynamic settings are immutable frames. A scope owns one reference; a task
# owns another until it has finished. Unrelated programs compile these paths out.
struct __SettingsFrame:
    parent: *__SettingsFrame
    refs: int
    kind: int
    cores: int
    entry: bool
    value: str

__settings_machine = 0
__settings_machine_cores = () -> int:
    when TARGET == "wasm": return 1
    found = __atomic_add(&__settings_machine, 0)
    if found == 0:
        __atomic_cas(&__settings_machine, 0, cpu_count())
        found = __atomic_add(&__settings_machine, 0)
    found

__settings_current = () -> *__SettingsFrame:
    when not __setting_read("__runtime_settings"): return null
    else: return __ts()[__TS_SETTINGS] as *__SettingsFrame

__settings_install = (p: *__SettingsFrame):
    when __setting_read("__runtime_settings"): __ts()[__TS_SETTINGS] = p as int

__settings_retain = (p: *__SettingsFrame):
    if p != null: __settings_refs(p, 1)

__settings_release = (p: *__SettingsFrame):
    let current = p
    loop current != null:
        if __settings_refs(current, -1) != 1: return
        parent = current.parent
        current.value = ""
        __free(current as *u8)
        current = parent

__settings_capture = () -> *__SettingsFrame:
    p = __settings_current()
    __settings_retain(p)
    p

__settings_default_cores = () -> int:
    n = __settings_machine_cores()
    cap: str? = __setting_read("program.max_cores")
    if let text = cap: n = min(n, to_int(text) ?? n)
    max(n, 1)

__settings_cores_at = (p: *__SettingsFrame) -> int:
    let current = p
    loop current != null:
        if current.kind == 0: return current.cores
        current = current.parent
    __settings_default_cores()

available_cores = () -> int: __settings_cores_at(__settings_current())

__settings_cores_unchecked = (cores: int, entry: bool) -> *__SettingsFrame:
    parent = __settings_current()
    limit = __settings_machine_cores()
    let held = parent
    has_entry = false
    loop held != null:
        if held.entry and held.kind == 0: has_entry = true
        held = held.parent
    if not entry or has_entry: limit = __settings_cores_at(parent)
    limit = min(limit, cores)
    t = __ts()
    arena = t[__TS_ARENA]
    t[__TS_ARENA] = 0
    p = __alloc(size_of(__SettingsFrame)) as *__SettingsFrame
    t[__TS_ARENA] = arena
    __settings_retain(parent)
    p[0] = __SettingsFrame(parent, 1, 0, limit, entry, "")
    __settings_install(p)
    p

__settings_enter_policy = (kind: int, value: str) -> *__SettingsFrame:
    parent = __settings_current()
    t = __ts()
    arena = t[__TS_ARENA]
    t[__TS_ARENA] = 0
    p = __alloc(size_of(__SettingsFrame)) as *__SettingsFrame
    text = __settings_heap_text(value)
    t[__TS_ARENA] = arena
    __settings_retain(parent)
    p[0] = __SettingsFrame(parent, 1, kind, 0, false, text)
    __settings_install(p)
    p

__settings_leave = (p: *__SettingsFrame):
    __settings_install(p.parent)
    __settings_release(p)

__settings_policy_read = (kind: int, fallback: str?) -> str?:
    let p = __settings_current()
    loop p != null:
        if p.kind == kind: return p.value
        p = p.parent
    fallback

# The current backends emit identical strict and fast bodies; merge them.
# Keep the boolean contract and evaluate its expression once at scope entry.
__settings_fast_math = (enabled: bool): pass

# Restore scopes abandoned by the explicit allocation-failure jump.
__settings_unwind = (saved: *__SettingsFrame):
    let p = __settings_current()
    loop p != saved and p != null:
        parent = p.parent
        __settings_release(p)
        p = parent
    __settings_install(saved)

__settings_refs = (p: *__SettingsFrame, delta: int) -> int:
    when TARGET == "wasm":
        old = p.refs
        p.refs += delta
        return old
    else: return __atomic_add(&p.refs, delta)

__settings_heap_text = (value: str) -> str:
    if len(value) == 0: return ""
    p = __str_new(len(value))
    mem_copy(p + 24, data(value), len(value))
    p as str

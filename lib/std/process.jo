# Child processes, every outcome a value. `program` is a path: there is no PATH search
# (`run("/usr/bin/env" ["python3" ...])` does one), and `args` are the arguments after it. A
# child inherits the environment; one whose program cannot be run ends with 127, as a shell
# says. A status is the exit code, or 128 + n when signal n ended the child; SpawnError means
# no child could be started. Web pages have no processes: SpawnError there.
#   run(program args): the status, the child sharing this program's standard streams
#   run_silent(program args): the same, its stdout and stderr sent to /dev/null
#   spawn(program args): the Child, started (`child.wait` gives its status)
#   capture(program args): its Output, with stdout and stderr collected (at most
#     __CAPTURE_LIMIT bytes each: past that, or when a pipe cannot be read, the child is ended
#     and the result is a FileError)
@nominal(error)
struct SpawnError:
    pass

struct Child:
    pid: int

struct Output:
    status: int
    stdout: u8[]
    stderr: u8[]

# the output as text; none when it is not UTF-8
stdout_text = (output: Output) -> str?: __dewy_decode_utf8(output.stdout)
stderr_text = (output: Output) -> str?: __dewy_decode_utf8(output.stderr)

wait = (child: Child) -> int | Canceled: __proc_wait(child.pid)

run = (program: str, args: str[]) -> int | SpawnError | Canceled:
    if __task_canceled(): return Canceled
    when TARGET == "wasm":
        return SpawnError()
    else when TARGET == "windows":
        __out_flush()
        code = __w32_run(program, [program] + args, true)
        if code < 0: return 127
        return code
    else:
        pid = __proc_start(program, args, -1, -1)
        if pid < 0: return SpawnError()
        status = __proc_wait(pid)
        if status is Canceled: __proc_cancel_owned(pid)
        return status

run_silent = (program: str, args: str[]) -> int | SpawnError | Canceled:
    if __task_canceled(): return Canceled
    when TARGET == "wasm" or TARGET == "windows":
        return SpawnError()
    else:
        null_fd = syscall(2, data(__zstr("/dev/null")), 0x80001, 0)    # O_WRONLY | O_CLOEXEC
        if null_fd < 0: return SpawnError()
        pid = __proc_start(program, args, null_fd, null_fd)
        syscall(3, null_fd)
        if pid < 0: return SpawnError()
        status = __proc_wait(pid)
        if status is Canceled: __proc_cancel_owned(pid)
        return status

spawn = (program: str, args: str[]) -> Child | SpawnError | Canceled:
    if __task_canceled(): return Canceled
    when TARGET == "wasm" or TARGET == "windows":
        return SpawnError()
    else:
        pid = __proc_start(program, args, -1, -1)
        if pid < 0: return SpawnError()
        return Child(pid = pid)

const __CAPTURE_LIMIT = 64 << 20

# Both pipes are drained as they fill, so a child writing much to either cannot block.
capture = (program: str, args: str[]) -> Output | SpawnError | FileError | Canceled:
    if __task_canceled(): return Canceled
    when TARGET == "wasm" or TARGET == "windows":
        return SpawnError()
    else:
        fds = [0]
        if syscall(293, data(fds), 0x80000) != 0: return SpawnError()      # pipe2(O_CLOEXEC)
        out_read = fds[0] & 0xFFFFFFFF
        out_write = fds[0] >> 32
        if syscall(293, data(fds), 0x80000) != 0:
            syscall(3, out_read)
            syscall(3, out_write)
            return SpawnError()
        err_read = fds[0] & 0xFFFFFFFF
        err_write = fds[0] >> 32
        pid = __proc_start(program, args, out_write, err_write)
        syscall(3, out_write)
        syscall(3, err_write)
        out: u8[]
        err: u8[]
        if pid < 0:
            syscall(3, out_read)
            syscall(3, err_read)
            return SpawnError()
        drained = __proc_drain(out_read, err_read, out, err, __CAPTURE_LIMIT)
        if drained < 0:
            # (too much output, or a pipe that cannot be read: the child is ended, not waited on
            # for ever)
            syscall(62, pid, 9)
            __task_shield_enter()
            __proc_wait(pid)
            __task_shield_leave()
            if __task_canceled(): return Canceled
            __task_file_begin()
            __ferr(drained)
            return FileError()
        status = __proc_wait(pid)
        if status is Canceled:
            __proc_cancel_owned(pid)
            return Canceled
        return Output(status = status, stdout = out, stderr = err)

# fork and exec: the child's pid, or -1. Its stdout and stderr are out_fd and err_fd unless
# they are -1. What this program printed before is shown first.
__proc_start = (program: str, args: str[], out_fd: int, err_fd: int) -> int:
    argv = [program] + args
    __out_flush()
    pid = syscall(57)                                # fork
    if pid < 0: return -1
    if pid == 0:
        if out_fd >= 0: syscall(33, out_fd, 1)       # dup2
        if err_fd >= 0: syscall(33, err_fd, 2)
        exec(program, argv)
        syscall(60, 127)                             # exit: exec failed
    pid

# The status of a child, once it has ended: its exit code, or 128 + the signal that ended it.
__proc_wait = (pid: int) -> int | Canceled:
    if __task_canceled(): return Canceled
    when TARGET == "wasm" or TARGET == "windows":
        return -1
    else:
        status = [0]
        r = -4
        loop r == -4: r = syscall(61, pid, data(status), 0, 0)      # wait4 (EINTR: again)
        if r == -125: return Canceled
        if r < 0: return -1
        st = status[0] & 0xFFFF
        if st & 127 != 0: return 128 + (st & 127)
        return (st >> 8) & 255

# Read two pipes to their ends, whichever has something first (poll; a struct pollfd per word:
# the descriptor, POLLIN asked, what happened): 0, or why it stopped early: -27 (EFBIG) when
# either has over limit bytes, or a read error (-errno).
__proc_drain = (out_fd: int, err_fd: int, out: mut u8[], err: mut u8[], limit: int) -> int:
    fds = [0, 0]
    out_open = true
    err_open = true
    why = 0
    loop (out_open or err_open) and why == 0:
        fds[0] = ((if out_open: out_fd else: -1) & 0xFFFFFFFF) | (1 << 32)
        fds[1] = ((if err_open: err_fd else: -1) & 0xFFFFFFFF) | (1 << 32)
        r = syscall(7, data(fds), 2, -1)
        if r == -4: continue
        if r < 0:
            why = r
            break
        if out_open and (fds[0] >> 48) & 0xFFFF != 0:
            got = __proc_read(out_fd, out, limit)
            if got <= 0: out_open = false
            if got < 0: why = got
        if err_open and (fds[1] >> 48) & 0xFFFF != 0 and why == 0:
            got = __proc_read(err_fd, err, limit)
            if got <= 0: err_open = false
            if got < 0: why = got
    syscall(3, out_fd)
    syscall(3, err_fd)
    why

# (what a pipe has now, added to into: 1 more may come, 0 at its end, < 0 a read error, or -27
# when into would pass limit bytes)
__proc_read = (fd: int, into: mut u8[], limit: int) -> int:
    n = into.len()
    room = min(65536, limit - n + 1)
    into.resize(n + room)
    r = syscall(0, fd, data(into) + n, room)
    into.resize(n + max(r, 0))
    if r == -4: return 1
    if r < 0: return r
    if into.len() > limit: return -27
    if r > 0: return 1
    0

# Helpers owning a child reap it before cancellation escapes their scope.
__proc_cancel_owned = (pid: int):
    when TARGET == "linux":
        syscall(62, pid, 9)
        __task_shield_enter()
        __proc_wait(pid)
        __task_shield_leave()

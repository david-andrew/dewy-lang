use '../core/overflow.jo'
# A bounded signed-word interval is a small value, never an array of its numbers.
# count == 0 denotes 2^64 elements when empty is false.
struct IntRange:
    _first: int
    _stride: __wrap64
    _count: __wrap64
    _up: bool
    _empty: bool

__dewy_range = (first: int, second: int, last: int, stepped: bool, inclusive: bool) -> IntRange:
    up = not stepped or second > first
    stride: __wrap64 = 1
    if stepped:
        if second == first: panic("range step must be nonzero")
        stride = if up: __wrap64(second) - __wrap64(first) else: __wrap64(first) - __wrap64(second)
    empty = if up: first > last or (first == last and not inclusive) else: first < last or (first == last and not inclusive)
    if empty: return IntRange(first, stride, 0, up, true)
    distance = if up: __wrap64(last) - __wrap64(first) else: __wrap64(first) - __wrap64(last)
    if not inclusive: distance -= 1
    IntRange(first, stride, distance / stride + 1, up, false)

__dewy_range_tail = (r: IntRange) -> IntRange:
    if r._empty or r._stride == 0: return r
    first = int(if r._up: __wrap64(r._first) + r._stride else: __wrap64(r._first) - r._stride)
    count = r._count - 1
    IntRange(first, r._stride, count, r._up, count == 0)

contains = (r: IntRange, value: int) -> bool:
    if r._empty or r._stride == 0: return false
    if r._up and value < r._first or not r._up and value > r._first: return false
    distance = if r._up: __wrap64(value) - __wrap64(r._first) else: __wrap64(r._first) - __wrap64(value)
    distance % r._stride == 0 and (r._count == 0 or distance / r._stride < r._count)

struct __DewyRangeIter:
    cursor: int
    delta: int
    remaining: __wrap64
    done: bool

__dewy_range_iter = (r: IntRange) -> __DewyRangeIter:
    delta = int(if r._up: r._stride else: __wrap64(0) - r._stride)
    __DewyRangeIter(r._first, delta, r._count, r._empty or r._stride == 0)

__dewy_range_done = (it: __DewyRangeIter) -> bool: it.done

__dewy_range_value = (it: mut __DewyRangeIter) -> int:
    value = it.cursor
    it.remaining -= 1
    it.done = it.remaining == 0
    # Wrapping the cursor after the final value is harmless: done guards it.
    it.cursor += it.delta
    value

# (Dewy's range literal, its bounds included: [0..2], [1,3..9]; an empty one as [0..0))
__dewy_fmt = (buf: mut u8[], r: IntRange):
    __buf_byte(buf, '[')
    __fmt(buf, r._first)
    if r._empty or r._stride == 0:
        __buf_append_str(buf, "..")
        __fmt(buf, r._first)
        __buf_byte(buf, ')')
        return
    delta = if r._up: r._stride else: __wrap64(0) - r._stride
    if r._stride != 1 or not r._up:
        __buf_byte(buf, ',')
        __fmt(buf, int(__wrap64(r._first) + delta))
    __buf_append_str(buf, "..")
    __fmt(buf, int(__wrap64(r._first) + (r._count - 1) * delta))
    __buf_byte(buf, ']')

__dewy_fmt_elem = (buf: mut u8[], r: IntRange): __dewy_fmt(buf, r)

# Open counters can accompany a finite sequence or a condition. Keep exhaustion
# separate from ordinary iterator completion: requesting another value must
# diagnose overflow, while stopping the combined loop needs no extra value.
struct __DewyOpenRangeIter:
    range: __DewyRangeIter

__dewy_open_range_iter = (first: int, second: int) -> __DewyOpenRangeIter:
    last = if second > first: 9223372036854775807 else: -9223372036854775807 - 1
    __DewyOpenRangeIter(__dewy_range_iter(__dewy_range(first, second, last, true, true)))

__dewy_open_range_done = (it: __DewyOpenRangeIter) -> bool: false

__dewy_open_range_value = (it: mut __DewyOpenRangeIter) -> int:
    if it.range.done: panic("range exhausted its integer type")
    __dewy_range_value(it.range)

# Validate every selected index without constructing an index array. Dividing
# the available distance avoids overflow in (count - 1) * stride, even for a
# full-width interval or an explicitly constructed IntRange value.
__dewy_range_indices = (size: int, r: IntRange) -> int:
    if r._empty or r._stride == 0: return 0
    if r._first < 0 or r._first >= size: panic("range index {r._first} is out of bounds for {size} elements")
    distance = if r._up: __wrap64(size - 1 - r._first) else: __wrap64(r._first)
    if r._count == 0 or r._count - 1 > distance / r._stride:
        panic("range indexes are out of bounds for {size} elements")
    int(r._count)

__pick[A, T] = (xs: A, r: IntRange) -> T[]:
    count = __dewy_range_indices(xs.len(), r)
    # (pushed, not zero-filled: a refined element, as a rational, has no zero to start from)
    out: T[]
    out.reserve(count)
    index = r._first
    delta = int(if r._up: r._stride else: __wrap64(0) - r._stride)
    loop j in [0..count):
        out.push(__at(xs, index))
        index += delta
    out

__put[A, T] = (xs: mut A, r: IntRange, value: T):
    count = __dewy_range_indices(xs.len(), r)
    index = r._first
    delta = int(if r._up: r._stride else: __wrap64(0) - r._stride)
    loop j in [0..count):
        __at(xs, index) = value
        index += delta

__put[A, T] = (xs: mut A, r: IntRange, values: T[]):
    count = __dewy_range_indices(xs.len(), r)
    if values.len() != count: panic("{values.len()} values for {count} range indexes")
    index = r._first
    delta = int(if r._up: r._stride else: __wrap64(0) - r._stride)
    loop j in [0..count):
        __at(xs, index) = __at(values, j)
        index += delta

__dewy_slice_range = (size: int, first: int, second: int, last: int, inclusive: bool, bounded: bool, stepped: bool) -> IntRange:
    stop = if bounded: last else if not stepped or second > first: size - 1 else: 0
    __dewy_range(first, second, stop, stepped, inclusive or not bounded)

__dewy_pick_slice[A, T] = (xs: A, first: int, second: int, last: int, inclusive: bool, bounded: bool, stepped: bool) -> T[]:
    __pick[A, T](xs, __dewy_slice_range(xs.len(), first, second, last, inclusive, bounded, stepped))

__dewy_put_slice[A, T] = (xs: mut A, first: int, second: int, last: int, inclusive: bool, bounded: bool, stepped: bool, value: T):
    __put[A, T](xs, __dewy_slice_range(xs.len(), first, second, last, inclusive, bounded, stepped), value)

__dewy_put_slice[A, T] = (xs: mut A, first: int, second: int, last: int, inclusive: bool, bounded: bool, stepped: bool, values: T[]):
    __put[A, T](xs, __dewy_slice_range(xs.len(), first, second, last, inclusive, bounded, stepped), values)

# Internal counted-range state is modular: zero remaining represents 2^64.
__dewy_range_cursor = (value: int) -> __wrapi64: __wrapi64(value)
__dewy_range_remaining = (value: __wrap64) -> __wrap64: __wrap64(value)
__dewy_range_word = (value: __wrapi64) -> int: int(value)

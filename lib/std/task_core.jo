# The part of tasks other library code asks about: the running task's slot, its
# random stream and cleanup shield, its file error code, and whether it is canceled.
# Loaded on demand, as lib/std/tasks.jo (groups, spawn, within, race), which sets it
# up, and lib/std/task_input.jo (cancelable standard input and file opening) are;
# what every program's runtime reads (the task stacks) is in lib/core/rt.jo.

# Integration contract for scoped parallel blocks (tasks.jo owns the backend):
# - Make/enter an ordinary group to establish a signal owner. Its body context
#   is live until join; owned task slots start as ordinary/runnable.
# - Publish operation/frontier transitions under __task_frontier_lock. An owned
#   join points at its child group; inherited helpers call
#   __task_inherit_signal_owner before starting children. A deadline is ordinary.
# - Publish ready continuations before completing their prerequisites. Future
#   dependency scheduling must include unresolved same-owner prerequisites in
#   this frontier; independently owned task waits remain ordinary/opaque.
# - Run __task_cleanup on every exit, after owned work and body cleanup. It
#   releases subscriptions after joining. Descriptor copies own no registration.
# Signal closure is demand-driven in signal_core.jo, with no compiler knowledge
# of signal names, syntax, or future statements.

# A group's scope; tasks.jo makes and joins them.
struct TaskGroup:
    __state: int[]
    __p: *__TaskScope

struct __TaskScope:
    parent: TaskGroup
    jobs: int[][]
    addresses: *__TaskJob[]
    lock: int
    canceled: int
    deadline: int
    pending: int
    closed: bool
    failed: bool
    first: exception = none
    owner: int
    # The signal owner is this scope for an explicit group, or an ancestor for
    # structured race/deadline helpers. The body remains live until join starts.
    signal_owner: *__TaskScope
    signal_root_context: *__TaskContext
    signal_is_root: bool
    background: bool
    body_joined: bool
    body_context: *__TaskContext
    signals_closed: bool
    signal_views: int[][]

struct __TaskJob:
    run: () -> void
    group: TaskGroup
    alive: int = 1
    tid: int
    slot: int
    finished: bool

# Context is separate from the backend stack. The first backend reserves
# virtual stacks and uses a stack-range lookup, avoiding platform TLS in the
# compiler's freestanding executables. Slots are reused only after kernel exit.
struct __TaskContext:
    scope: TaskGroup
    signal_root: TaskGroup
    # Published current operation, including the entry task/group body.
    activity: int
    waiting: *__TaskScope
    signal_wait: *__TaskScope
    job: int[]
    address: *__TaskJob
    rng: Rng
    shield: int
    grace: int

__task_contexts: __TaskContext[]

# One publication lock covers the live frontier, admission and signal views.
# OS handlers never take it. No signal use: the callback stays a no-op.
__task_frontier_lock = 0
__task_signal_frontier = false
__task_signal_noop = (p: *__TaskScope) -> void: pass
__task_signal_release_hook: (*__TaskScope) -> void = __task_signal_noop
__task_root_interrupted = 0

__task_context = () -> *__TaskContext:
    if __task_contexts.len() == 0: return null
    __task_data(__task_contexts) + __task_slot() + 1

__task_scope_canceled = (g: TaskGroup) -> bool:
    if __atomic_add(&__task_root_interrupted, 0) != 0: return true
    let current = g
    loop current.__state.len() != 0:
        p = current.__p
        if __atomic_add(&p.canceled, 0) != 0: return true
        if p.deadline != 0 and time_ns() >= p.deadline:
            __atomic_cas(&p.canceled, 0, 2)
            return true
        current = p.parent
    false

# the running task's slot (-1: not on a task's stack)
__task_slot = () -> int:
    if __task_stacks == null: return -1
    sp = __stack_ptr()
    if sp < __task_stacks or sp >= __task_stacks + (__TASK_SLOTS << __TASK_SHIFT): return -1
    (sp - __task_stacks) >> __TASK_SHIFT

__task_canceled = () -> bool:
    c = __task_context()
    if c == null: return __atomic_add(&__task_root_interrupted, 0) != 0
    if c.shield != 0: return c.grace != 0 and time_ns() >= c.grace
    __task_scope_canceled(__task_context().scope)

# Cleanup runs shielded, with a 100 ms grace deadline.
__task_shield_enter = () -> void:
    c = __task_context()
    if c == null: return
    if c.shield == 0: c.grace = time_ns() + 100000000
    c.shield += 1

__task_shield_leave = () -> void:
    c = __task_context()
    if c == null: return
    c.shield -= 1
    if c.shield == 0: c.grace = 0

__task_file_code = () -> int:
    if __task_stacks != null: return __ts()[__TS_FILE_CODE]
    __file_error_code

__task_file_begin = () -> void:
    if __task_stacks != null: __ts()[__TS_FILE_CODE] = 0
    else: __file_error_code = 0

__task_lock = (p: *int):
    loop __atomic_cas(p, 0, 1) != 0: pass
__task_unlock = (p: *int) -> void: __atomic_cas(p, 1, 0)

__task_pause = ():
    when TARGET == "linux":
        when __CORE_CAPS: suspended = __settings_core_suspend()
        ts = (0, 1000000)
        syscall(35, &ts, 0)
        when __CORE_CAPS: __settings_core_resume(suspended)
    else: __sleep_ns(1000000)

# Where Linux waits on a futex (each use spells its own system call): wait while the word at p
# holds v, at most us microseconds, and wake every waiter. macOS has __ulock_wait
# (UL_COMPARE_AND_WAIT64), Windows WaitOnAddress (whole milliseconds); the externs are
# fork_join.jo's. A wake of a word no one waits on, or one since freed, does nothing.
when TARGET == "macos":
    __task_os_wait = (p: *int, v: int, us: int): __mac_ulock_wait(u32(5), p as *u8, v, u32(us))
    __task_os_wake = (p: *int): __mac_ulock_wake(u32(5 | 0x100), p as *u8, 0)
else when TARGET == "windows":
    __task_os_wait = (p: *int, v: int, us: int):
        cmp = v
        WaitOnAddress(p as *u8, (&cmp) as *u8, 8, u32((us + 999) / 1000))
    __task_os_wake = (p: *int): WakeByAddressAll(p as *u8)

# Race helpers inherit their caller's owner; their group body is still tracked.
__task_inherit_signal_owner = (g: TaskGroup):
    p = g.__p
    p.signal_owner = null
    p.signal_root_context = __task_context()
    if p.parent.__state.len() != 0:
        p.signal_owner = p.parent.__p.signal_owner
        if not p.parent.__p.background: p.signal_root_context = p.parent.__p.signal_root_context

# Selection preflight registers every active leaf before any ready receive can
# commit. Leaf runtime hooks return a missed probe without taking a payload.
# Disabled waits contribute nothing; timers contribute ordinary activity.
__wait_probe_begin = (ordinary: bool):
    s = __ts()
    s[__TS_WAIT_PROBE] = 1
    s[__TS_WAIT_FLAGS] = if ordinary: 2 else: 0
    s[__TS_WAIT_OWNER] = 0

__wait_frontier_enabled = () -> bool: __task_signal_frontier

__wait_probe_active = () -> bool: __ts()[__TS_WAIT_PROBE] != 0

__wait_probe_ordinary = () -> bool:
    if not __task_signal_frontier: return false
    s = __ts()
    if s[__TS_WAIT_PROBE] == 0: return false
    s[__TS_WAIT_FLAGS] = s[__TS_WAIT_FLAGS] | 2
    __select_missed()
    true

__wait_probe_signal = (owner: *__TaskScope, timed: bool):
    s = __ts()
    s[__TS_WAIT_FLAGS] = s[__TS_WAIT_FLAGS] | 1
    if timed or s[__TS_WAIT_OWNER] != 0 and s[__TS_WAIT_OWNER] != owner as int:
        s[__TS_WAIT_FLAGS] = s[__TS_WAIT_FLAGS] | 2
    s[__TS_WAIT_OWNER] = owner as int
    __select_missed()

__wait_probe_end = ():
    s = __ts()
    s[__TS_WAIT_PROBE] = 0
    c = __task_context()
    if c == null: return
    __task_lock(&__task_frontier_lock)
    c.activity = 0
    if s[__TS_WAIT_FLAGS] == 1:
        c.signal_wait = s[__TS_WAIT_OWNER] as *__TaskScope
        c.activity = 1
    __task_unlock(&__task_frontier_lock)

__wait_frontier_end = ():
    if not __task_signal_frontier: return
    c = __task_context()
    if c == null: return
    __task_lock(&__task_frontier_lock)
    c.activity = 0
    __task_unlock(&__task_frontier_lock)

# Insertion-ordered sets share the dictionary's hashing and COW value storage.
struct Set[T]:
    _entries: {T: bool}
    # Exclusive upper bound for the last live entry. Backward scans during pop
    # consume each removed tail once; compaction/removal can lower this bound.
    _tail: int

__dewy_make_set[T] = (values: T[]) -> Set[T]:
    result: Set[T]
    if values.len() > 0: result._entries.reserve(values.len())
    loop value in values: result._entries.insert_if_absent(value, true)
    result._tail = result._entries.__keys.len()
    result

# set(values): the set of an array's elements, in first-occurrence order
set[T] = (values: T[]) -> Set[T]: __dewy_make_set(values)

__dewy_set_values[T] = (s: Set[T]) -> T[]: s._entries.keys()
len[T] = (s: Set[T]) -> int: s._entries.len()
is_empty[T] = (s: Set[T]) -> bool: s._entries.is_empty()
contains[T] = (s: Set[T], value: T) -> bool: s._entries.has(value)
has[T] = (s: Set[T], value: T) -> bool: s._entries.has(value)
push[T] = (s: mut Set[T], value: T):
    if s._entries.insert_if_absent(value, true): s._tail = s._entries.__keys.len()
remove[T] = (s: mut Set[T], value: T) -> bool:
    removed = s._entries.remove(value)
    # Removal may compact the entry arrays and renumber their indices.
    if removed: s._tail = min(s._tail, s._entries.__keys.len())
    removed
clear[T] = (s: mut Set[T]):
    s._entries.clear()
    s._tail = 0
reserve[T] = (s: mut Set[T], count: int): s._entries.reserve(count)

pop[T] = (s: mut Set[T], value: T) -> T:
    if not s.remove(value): panic("the set has no member {value}")
    value

pop[T] = (s: mut Set[T], value: T, default: T?) -> T?:
    if s.remove(value): return value
    default

pop[T] = (s: mut Set[T]) -> T:
    if s.is_empty(): panic("cannot pop an empty set")
    i = s._tail - 1
    ng = s._entries.gone.len()
    loop i < ng and s._entries.gone[i]: i -= 1
    value = s._entries.__keys[i]
    s.pop(value)
    s._tail = min(i, s._entries.__keys.len())
    value

pop[T] = (s: mut Set[T], default: T?) -> T?:
    if s.is_empty(): return default
    s.pop()

(==)[T] = (a: Set[T], b: Set[T]) -> bool: a._entries == b._entries

# Equal sets can have different insertion orders and capacities. Hash their
# members commutatively so a set can itself be a dictionary key or set member.
hash[T] = (s: Set[T]) -> u64:
    total: u64 = 0
    loop value in __dewy_set_values(s): total += value.hash()
    hash(total xor u64(s.len()))

(|)[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    result = a
    loop value in __dewy_set_values(b): result.push(value)
    result

(&)[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    result: Set[T]
    loop value in __dewy_set_values(a):
        if b.has(value): result.push(value)
    result

(-)[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    result: Set[T]
    loop value in __dewy_set_values(a):
        if not b.has(value): result.push(value)
    result

(^)[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    result = a - b
    loop value in __dewy_set_values(b):
        if not a.has(value): result.push(value)
    result

__fmt[T] = (buf: mut u8[], s: Set[T]):
    __buf_append_str(buf, "set")
    __fmt(buf, __dewy_set_values(s))

__dewy_fmt[T] = (buf: mut u8[], s: Set[T]):
    __buf_append_str(buf, "set")
    __dewy_fmt(buf, __dewy_set_values(s))

__dewy_fmt_elem[T] = (buf: mut u8[], s: Set[T]): __dewy_fmt(buf, s)

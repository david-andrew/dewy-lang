# Dewy's console: `console.print`/`printl`/`info` on standard output, `warn`/`error`
# on standard error (coloured on a terminal) and `debug` on standard error (left out
# of release builds); `print(x file=stderr)` for either stream. The checker turns the
# calls into its print intrinsic, which formats as Dewy does; these are the streams.

# a standard stream, for print's `file=`
struct Stream:
    fd: int
const stdout = Stream(1)
const stderr = Stream(2)

# console.color: 'auto' (colour on a terminal), 'always' or 'never'
struct Console:
    color: str
console = Console("auto")

# standard error is a terminal (not a file or a pipe)
__stderr_tty = () -> bool:
    when TARGET == "windows":
        m = [u32(0)]
        return GetConsoleMode(GetStdHandle(u32(0xFFFFFFF4)), data(m)) != 0
    else when TARGET == "macos":
        return __mac_isatty(i32(2)) == 1
    else when TARGET == "wasm":
        return false
    else:
        # (TCGETS writes what it knows of the terminal: a buffer for it)
        b: u8[] = []
        b.resize(64)
        syscall(16, 2, 0x5401, data(b)) == 0

# Colour on stream fd (1 or 2): the program's console.color first ('always', 'never'),
# then NO_COLOR, then FORCE_COLOR or CLICOLOR_FORCE, then whether it is a terminal.
__console_colored = (fd: int) -> bool:
    if console.color == "always": return true
    if console.color == "never": return false
    if len(env("NO_COLOR") ?? "") > 0: return false
    force = env("FORCE_COLOR") ?? ""
    if len(force) == 0: force = env("CLICOLOR_FORCE") ?? ""
    if len(force) > 0 and force != "0" and force != "false": return true
    if fd == 1: return __stdout_tty()
    __stderr_tty()

# text and a line break on stream fd, in an ANSI colour ("" for none) when colour is on
__console_line = (fd: int, s: str, color: str):
    if len(color) > 0 and __console_colored(fd):
        __console_write(fd, "\x1b[{color}m{s}\x1b[0m\n")
    else: __console_write(fd, s + "\n")

# print's text on a stream (`print(x file=stream)`), with a line break or not
__console_put = (stream: Stream, s: str, newline: bool):
    if newline: __console_write(stream.fd, s + "\n")
    else: __console_write(stream.fd, s)

__console_write = (fd: int, s: str):
    if fd == 1: write(s)
    else:
        __out_flush()
        __write_fd(2, data(s), len(s))

# (a release build's text for an error that reached main: its kind and message only)
__main_error_text = (kind: str, message: str) -> str: "{kind}: {message}"

# An error that reached main: said on standard error, and main's exit code.
__main_failed = (message: str, code: int) -> int:
    __console_line(2, "error: {message}", "31")
    code

# Dewy's prelude: time without an import. Each name loads lib/time only when named.
import p"@lib/time/core.dewy" as core
from p"@lib/time/core.dewy" import (instant_error utc_error)
import p"@lib/time/civil.dewy" as civil
from p"@lib/time/civil.dewy" import (date_error time_of_day_error local_error)
import p"@lib/time/zones.dewy" as zones
from p"@lib/time/zones.dewy" import (zone_error zone_scope_error zoned_error local_zone_error policy_gap _FoldPolicy _GapPolicy)

Instant:type=core.Instant
Duration:type=core.Duration
UtcLabel:type=core.UtcLabel

# Onto a grid, with the rounding named: `let [d lost] = quantize(1ns/3 rounding='nearest_even')`.
# A constant tick (1ns unless said) and a constant time cannot fail.
from p"@lib/time/core.dewy" import (tick_error _Rounding compact_instant_error compact_duration_error)
$check_constant tick_error(tick) "not a tick"
quantize=(q:rational*Time rounding:_Rounding tick:rational*Time=1ns):>[Duration rational*Time]|OffGrid=>core.quantize_exact(q rounding tick)
quantize=(x:float64*Time rounding:_Rounding tick:rational*Time=1ns):>[Duration rational*Time]|OffGrid|OutOfRange=>core.quantize_float(x rounding tick)
$check_constant tick_error(tick) "not a tick"
quantize=(d:Duration rounding:_Rounding tick:rational*Time):>[Duration Duration]|OffGrid=>core.quantize_stored(d rounding tick)
$check_constant tick_error(tick) "not a tick"
quantize=(t:Instant rounding:_Rounding tick:rational*Time):>[Instant Duration]|OffGrid=>core.quantize_stored(t rounding tick)
# A time as a stored value, when it is exactly one: `convert<Duration>(q)`.
convert=<T>(q:int*Time):>T|OffGrid|OutOfRange=>core.duration_from(q)
convert=<T>(q:rational*Time):>T|OffGrid|OutOfRange=>core.duration_from(q)
convert=<T>(x:float64*Time):>T|OffGrid|OutOfRange=>core.duration_from(x)

$check_constant compact_instant_error(t) "does not fit"
convert=<T>(t:Instant):>T|OutOfRange=>core.compact_instant(t)
$check_constant compact_duration_error(d) "does not fit"
convert=<T>(d:Duration):>T|OutOfRange=>core.compact_duration(d)

# `Instant<width=64>`, for huge columns; `t as Instant` widens.
Instant_width_64:type=core.Instant_width_64
Duration_width_64:type=core.Duration_width_64
Instant_width_128:type=core.Instant
Duration_width_128:type=core.Duration

# `instant"2026-10-24T12:00:00Z"`: checked while compiling, and then a plain value.
$check_constant instant_error(text) "not an instant"
instant=(text:string):>Instant|ParseError|OffGrid|OutsideCoverage|InvalidFields=>core.instant_parse(text)
$check_constant utc_error(text) "not a UTC label"
utc=(text:string):>UtcLabel|ParseError|OffGrid|OutsideCoverage|InvalidFields=>core.utc_parse(text)

Gregorian:type=civil.Gregorian
Date:type=<C=Gregorian>(civil.Date<C>)
Period:type=core.Period|civil.Span
Span:type=civil.Span

# `1day` and `1week` count calendar days; `1month` and `1year` count months.
const day=core.Days[1]
const week=core.Days[7]
const month=core.Months[1]
const year=core.Months[12]

$check_constant date_error(text) "not a date"
date=(text:string):>Date|ParseError=>civil.date_parse(text)
age=(born:Date on:Date leap_day:civil._LeapDay='march_1'):>int=>civil.age_on(born on leap_day)
$warn_if scope is? none "`age` with no `on=` counts to today, which has no time zone here, so it assumes the zone of the machine it runs on: say so with `$time.zone = 'system'`, or name one: `$time.zone = 'America/New_York'`"
age=(born:Date leap_day:civil._LeapDay='march_1' scope:string|none=$time.zone):>int=>civil.age_on(born today(scope) leap_day)

Zone:type=zones.Zone
ZonedDateTime:type=zones.ZonedDateTime

TimeOfDay:type=civil.TimeOfDay
LocalDateTime:type=<C=Gregorian>(civil.LocalDateTime<C>)
$check_constant time_of_day_error(text) "not a time of day"
time_of_day=(text:string):>TimeOfDay|ParseError=>civil.time_of_day_parse(text)
$check_constant local_error(text) "not a local time"
local=(text:string):>LocalDateTime|ParseError=>civil.local_parse(text)
# A moment as it reads in a zone, or a local time as a moment there.
in_zone=(t:Instant z:Zone):>ZonedDateTime|OutsideCoverage=>zones.in_zone(t z)
$check_constant local_zone_error(l z fold gap) "this local time has no one moment"
$check_constant policy_gap(fold gap) "unused"
in_zone=(l:LocalDateTime z:Zone fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>zones.local_in_zone(l z fold gap)

$check_constant zone_error(name) "not a time zone"
zone=(name:string):>Zone|UnknownZone=>zones.zone_parse(name)
$check_constant zoned_error(text zone fold gap scope) "not a zoned time"
zoned=(text:string zone:Zone|none=none fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap scope:string|none=$time.zone):>ZonedDateTime|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>zones.zoned_parse(text zone fold gap scope)

import p"@lib/time/clock.dewy" as clock
ClockReading:type=clock.ClockReading
MonoPoint:type=clock.MonoPoint
now=():>ClockReading=>clock.now()
monotonic=():>MonoPoint=>clock.monotonic()

# What day it is, where the scope says.
$warn_if scope is? none "`today` has no time zone here, so it assumes the zone of the machine it runs on: say so with `$time.zone = 'system'`, or name one: `$time.zone = 'America/New_York'`"
$check_constant zone_scope_error(scope) "not a time zone"
today=(scope:string|none=$time.zone):>Date=>{
    let z=match zones.scope_zone(scope) {
        found:Zone=>found
        # (a name known only when running: said, and then the machine's)
        e:UnknownZone=>{
            __write_err("warning: {e.message}, so `today` reads the machine's zone instead\n")
            zones.system_zone()
        }
    }
    civil._of_days(zones.local_days(now().nominal z))
}

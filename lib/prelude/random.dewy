# Dewy's prelude: random whole numbers. Every Dewy module sees `random_int` and Rng's
# `next_int` unless it declares its own. A range [lo..hi) with nothing in it has no number to
# give, so `hi >? lo` is an obligation like any refinement: proven where the arguments show it
# (`random_int(1 7)`), a compile error where they do not, unless the caller opts into
# `$runtime_checks`. The result lies in the range: `xs[random_int(0 xs.length)]` is proven.

# a random whole number from lo up to hi, hi left out: random_int(0 xs.length) picks a position
# (its result lies in the range, a contract the caller's index proofs use)
random_int = (lo:int64 hi:int64<(>? lo)>):>int64<r => lo <=? r and r <? hi> => {
    let r = __random_int_from(lo hi)
    if lo <=? r and r <? hi return r
    lo
}

# the same from an Rng of one's own (rng(seed): the same numbers every run)
next_int = (@r:Rng lo:int64 hi:int64<(>? lo)>):>int64<n => lo <=? n and n <? hi> => {
    let n = __next_int_from(@r lo hi)
    if lo <=? n and n <? hi return n
    lo
}

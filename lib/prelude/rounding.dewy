# Dewy's prelude: rounding with an explicit rule. Every Dewy module sees `round`
# unless it declares its own (which replaces the whole family). Exact numbers
# round a half away from zero (`round(5/2)` and `round(2.5)` are 3); floats
# round to nearest with ties to even (IEEE 754). `rounding=` names another rule for
# either.

# A complete rounding rule: nearest (with its half rule), or directed.
_Rounding:type='nearest_away'|'nearest_even'|'nearest_toward_zero'|'nearest_up'|'nearest_down'|'floor'|'ceil'|'toward_zero'|'away_from_zero'

# (finite and below 2^52 in magnitude: every larger float is already whole)
round = ((x:float64 rounding:_Rounding='nearest_even'):>float64=>{
        if not (x >? -4503599627370496.0 and x <? 4503599627370496.0) return x
        let low=floor(x)
        let part=x-low
        let up=part >? 0.5
        if rounding =? 'floor' {up=false}
        else if rounding =? 'ceil' {up=part >? 0.0}
        else if rounding =? 'toward_zero' {up=x <? 0.0 and part >? 0.0}
        else if rounding =? 'away_from_zero' {up=x >? 0.0 and part >? 0.0}
        else if part =? 0.5 {
            up=match rounding {
                <'nearest_even'>=>floor(low*0.5)*2.0 not=? low
                <'nearest_away'>=>x >? 0.0
                <'nearest_toward_zero'>=>x <? 0.0
                <'nearest_up'>=>true
                <'nearest_down'>=>false
                _=>false
            }
        }
        let result=if up low+1.0 else low
        # (a zero keeps the sign of x: round(-0.25) is -0.0)
        if result =? 0.0 return x*0.0
        return result
    })
    & ((x:float32 rounding:_Rounding='nearest_even'):>float32=>float32(round(float64(x) rounding)))
    & ((value:rational rounding:_Rounding='nearest_away'):>int=>{
        # (a rational's denominator is positive)
        let low=value.numerator//value.denominator
        let twice=(value.numerator-low*value.denominator)*2
        if twice =? 0 return low
        if rounding =? 'floor' return low
        if rounding =? 'ceil' return low+1
        if rounding =? 'toward_zero' return if value.numerator <? 0 low+1 else low
        if rounding =? 'away_from_zero' return if value.numerator >? 0 low+1 else low
        if twice <? value.denominator return low
        if twice >? value.denominator return low+1
        let up=match rounding {
            <'nearest_away'>=>value.numerator >? 0
            <'nearest_even'>=>low%2 =? 1
            <'nearest_toward_zero'>=>value.numerator <? 0
            <'nearest_up'>=>true
            <'nearest_down'>=>false
            _=>false
        }
        return if up low+1 else low
    })
    & ((value:rational<int64> rounding:_Rounding='nearest_away'):>int=>{
        let wide:rational=value
        return round(wide rounding)
    })

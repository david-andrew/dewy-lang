# Dewy's prelude: the exact fraction's constructor (the type and its arithmetic
# are lib/rational.dewy's). Every Dewy module sees it unless it declares its own.
import p"@lib/rational.dewy" as exact

# `rational(numerator denominator)` of integers, big integers or their decimal
# text; `rational(text)` of `n` or `n/d`; `rational(f)` of a float, its exact
# binary value.
rational = ((numerator denominator=1):>rational=>exact.rational(numerator denominator))
    & ((text:string):>rational=>exact.rational(text))
    & ((value:float64):>rational=>exact._from_float(value))
    & ((value:float32):>rational=>exact._from_float(float64(value)))

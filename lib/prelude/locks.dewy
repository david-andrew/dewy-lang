# Dewy's prelude: locks. `mutex(value)` makes a `Mutex<T>` holding the value; tasks
# share it by copying the handle. `@(m.lock())` lends the payload as a place,
# held until the place's last use; `@(m.try_lock())` gives `Busy` when another
# holder has it:
#
#     let total = mutex(0)
#     let t = @(total.lock())
#     t += 1                                  # released after this last use
#     match @(total.try_lock()) { <Busy> => ...  n:int64 => n += 1 }
#
# `let [a b] = @(lock_all(from to)) or_throw` takes several at once, in one
# canonical order (compiler/deadlock.jo checks the order of nested locks).

Busy:type = type of error
DuplicateLock:type = type of error

__Held:type = type of [
    word:int64
    $__drop__
    release = ():>void => __lock_release_word(word)
]

# (the payload lives in the shared allocation, reached through the handle's pointer)
$unsafe
Mutex:type = <T>[
    __h:__Lock<T>
    lock = () :> @T => {
        __lock_wait_word(__lock_word(__h))
        let held = __Held[__lock_word(__h)]
        return @__h.__p.value
    }
    try_lock = () :> @T | Busy => {
        if not __lock_try_word(__lock_word(__h)) return Busy
        let held = __Held[__lock_word(__h)]
        return @__h.__p.value
    }
    # (lock_all, compiler/place_methods.jo: the lock's identity, every lock acquired at once,
    # and the place of one already held)
    __word = ():>int64 => __lock_word(__h)
    __lock_all = (words:array<int64>):>bool | DuplicateLock | Canceled => {
        let code = __lock_all_words(words)
        if code =? 1 return DuplicateLock
        if code =? 2 return Canceled
        true
    }
    __take = () :> @T => {
        let held = __Held[__lock_word(__h)]
        return @__h.__p.value
    }
]

mutex = <T>(value:T):>Mutex<T> => Mutex<T>[__lock_new(value)]

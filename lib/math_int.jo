# Mathematical integers preserve their semantic identity across word and
# BigInt storage. Arithmetic never routes through a wrapping conversion.
__int_overflow = (): panic("integer overflow: value does not fit the requested fixed width")


# Positive floor remainder of a signed double word. The remainder remains
# below a positive signed-word divisor, so its doubled unsigned value fits.
# This allocation-free helper is the cold path of overflow-flag versioning.
@noinline
__exact_i128_mod_pos = (low: int, high: int, divisor: int) -> int:
    negative = high < 0
    lo = u64(low)
    hi = u64(high)
    if negative:
        lo = u64(0) - lo
        hi = ~hi + u64(lo == 0)
    d = u64(divisor)
    r: u64 = 0
    bit = 127
    loop bit >= 0:
        digit = if bit >= 64: (hi >> (bit - 64)) & 1 else: (lo >> bit) & 1
        r = (r << 1) | digit
        if r >= d: r -= d
        bit -= 1
    if negative and r != 0: int(d - r) else: int(r)

# Convert an exact two-word signed integer without allocating a bigint.
# Retain a full word plus a sticky bit before the one floating conversion;
# power-of-two scaling is exact. The common word-sized path needs no loop.
__exact_i128_f64 = (low: int, high: int) -> f64:
    negative = high < 0
    lo = u64(low)
    hi = u64(high)
    if negative:
        lo = u64(0) - lo
        hi = ~hi + u64(lo == 0)
    shift = 0
    sticky: u64 = 0
    loop hi != 0:
        sticky |= lo & 1
        lo = (lo >> 1) | (hi << 63)
        hi = hi >> 1
        shift += 1
    lo |= u64(sticky != 0)
    scale = f64_from_bits(u64(shift + 1023) << 52)
    result = f64(lo) * scale
    if negative: -result else: result

__exact_i128_f32 = (low: int, high: int) -> f32:
    negative = high < 0
    lo = u64(low)
    hi = u64(high)
    if negative:
        lo = u64(0) - lo
        hi = ~hi + u64(lo == 0)
    shift = 0
    sticky: u64 = 0
    loop hi != 0:
        sticky |= lo & 1
        lo = (lo >> 1) | (hi << 63)
        hi = hi >> 1
        shift += 1
    lo |= u64(sticky != 0)
    scale = f32_from_bits(u32(shift + 127) << 23)
    result = f32(lo) * scale
    if negative: -result else: result


abs = (x: __dewy_int) -> __dewy_int: if x < 0: -x else: x
min = (a: __dewy_int, b: __dewy_int) -> __dewy_int: if a < b: a else: b
max = (a: __dewy_int, b: __dewy_int) -> __dewy_int: if a > b: a else: b

__dewy_power = (base: __dewy_int, exponent: __dewy_int) -> __dewy_int:
    if exponent < 0: panic("negative integer exponent: use a rational or floating base")
    let base = base
    let exponent = exponent
    result: __dewy_int = 1
    loop exponent > 0:
        if exponent & 1 == 1: result *= base
        exponent = exponent >> 1
        if exponent > 0: base *= base
    result

pow = (base: __dewy_int, exponent: __dewy_int) -> __dewy_int: __dewy_power(base, exponent)

__floor_div = (a: __dewy_int, b: __dewy_int) -> __dewy_int:
    q = a / b
    # q*b and a-q*b are representable for a truncating quotient.
    if a - q * b != 0 and (a < 0) != (b < 0): q -= 1
    q

__floor_mod = (a: __dewy_int, b: __dewy_int) -> __dewy_int:
    r = a % b
    if r != 0 and (r < 0) != (b < 0): r += b
    r

__floor_div_pow2 = (a: __dewy_int, shift: int) -> __dewy_int: a >> shift
__floor_mod_pow2 = (a: __dewy_int, mask: __dewy_int) -> __dewy_int: a & mask

__fmt = (buf: mut u8[], a: __dewy_int): __mi_format(buf, a)
__json_write_value = (b: mut u8[], x: __dewy_int, indent: int, level: int): __mi_format(b, x)
hash = (x: __dewy_int) -> u64: hash(u64(__mi_hash(x)))
__fmt_spec = (buf: mut u8[], x: __dewy_int, spec: str): __mi_format_spec(buf, x, spec)
__map_tag = (k: __dewy_int, h: u64) -> u64: h
__map_hash = (k: __dewy_int) -> u64: __mi_khash(k) as u64
__read = (r: mut __TextIn, x: mut __dewy_int):
    __tx_word_at(r, true)
    value = __mi_parse(r.s[r.n0..r.n1))
    if value is __dewy_int: x = value
    else: __tx_bad(r, "expected a whole number")
format = (value: __dewy_int, spec: str) -> str:
    sp = __format_checked(spec, "dxXbofeEgG%", true)
    buf: u8[]
    if sp.prec >= 0 or find_byte("feEgG%", u8(sp.kind)) >= 0: __fmt_spec(buf, f64(value), spec)
    else: __fmt_spec(buf, value, spec)
    str_from_bytes(buf)

    __xdpy: *u8 = null
    __xwin = 0
    __wm_delete = 0
    __egl_dpy: *u8 = null
    __egl_surf: *u8 = null
    __egl_ctx: *u8 = null
    __xev: *u8 = null
    __xscr: i32 = 0
    __xproto = false             # connected through x11.jo instead of libX11
    __wayland = false            # connected through wayland.jo

    # a missing display or driver is an environment problem, not a program bug: say so and exit
    __need = (ok: bool, what: str):
        if not ok:
            eprint("error: cannot open a window: {what}")
            exit(1)

    __platform_open = ():
        __soft = __soft_kept or (env("SLOPPY_SOFTWARE") ?? "") == "1"
        # (the software renderer with no display to show it on: frames drawn, no window, as for
        # a benchmark with SLOPPY_FRAMES and SLOPPY_STATS)
        no_display = env("WAYLAND_DISPLAY") == none and env("DISPLAY") == none
        headless = __soft and (env("SLOPPY_SCREENSHOT") != none or no_display)
        # (a screenshot run through Vulkan needs no display: no window, frames are only drawn)
        if not __soft and __vk_wanted() and env("SLOPPY_SCREENSHOT") != none and env("WAYLAND_DISPLAY") == none and env("DISPLAY") == none:
            why = __vk_open("", () -> int: 0)
            if len(why) == 0:
                __vk = true
                return
            __vk_note("{why}; using the software renderer")
            __soft = true
            headless = true
        # Wayland first where it is running (SLOPPY_PLATFORM=x11 or wayland chooses)
        plat = env("SLOPPY_PLATFORM") ?? ""
        if plat != "x11" and (env("WAYLAND_DISPLAY") != none or plat == "wayland") and not headless:
            why = __wl_open(__win_title, __win_w, __win_h)
            if len(why) == 0:
                __wayland = true
                if not __soft and __lw_on and __vk_wanted():
                    why2 = __vk_open("VK_KHR_wayland_surface", __vk_wayland_surface)
                    if len(why2) == 0: __vk = true
                    else: __vk_note("{why2}; using OpenGL")
                if not __soft and not __vk:
                    # (GPU arrays may have made the context already: keep it, their data lives there)
                    why2 = ""
                    if __egl_dpy == null: why2 = __egl_open_surfaceless()
                    else: __gl_screen_resize(__win_w, __win_h)
                    if len(why2) > 0:
                        eprint("note: {why2}; using the software renderer")
                        __soft = true
                if __soft: __sw_init_window(__win_w, __win_h)
                return
            if plat == "wayland": __need(false, why)
        if not lib_available("libX11.so.6") or (env("SLOPPY_X11") ?? "") == "protocol":
            # no Xlib: talk to the X server directly and render in software
            __soft = true
            why = __xp_open(__win_title, __win_w, __win_h)
            if len(why) == 0:
                __xproto = true
                # (the request must fit in the server's longest)
                icon = __icon_argb(__xp_maxreq - 8)
                if icon.len() > 0:
                    v: u8[]
                    loop x in icon: __put32(v, x)
                    __xp_property(__xp_intern("_NET_WM_ICON"), 6, 32, v)     # CARDINAL
            # a screenshot run can render without any display
            else if not headless: __need(false, "libX11 is not available and {why}")
            __sw_init_window(__win_w, __win_h)
            return
        __xdpy = XOpenDisplay(null)
        if __xdpy == null and headless:
            __sw_init_window(__win_w, __win_h)
            return
        __need(__xdpy != null, "cannot connect to the X server (is DISPLAY set?)")
        __xscr = XDefaultScreen(__xdpy)
        root = XRootWindow(__xdpy, __xscr)
        __xwin = XCreateSimpleWindow(__xdpy, root, 0, 0, u32(__win_w), u32(__win_h), 0, 0, 0)
        XStoreName(__xdpy, __xwin, data(__zstr(__win_title)))
        icon = __icon_argb(1 << 20)
        # (Xlib takes 32-bit values as C longs: ints)
        if icon.len() > 0: XChangeProperty(__xdpy, __xwin, XInternAtom(__xdpy, data("_NET_WM_ICON"), 0), 6, 32, 0, data(icon) as *u8, i32(icon.len()))
        # key, button, motion, structure and focus events
        XSelectInput(__xdpy, __xwin, 0x1 | 0x2 | 0x4 | 0x8 | 0x40 | 0x20000 | 0x200000)
        __wm_delete = XInternAtom(__xdpy, data("WM_DELETE_WINDOW"), 0)
        XSetWMProtocols(__xdpy, __xwin, &__wm_delete, 1)
        XkbSetDetectableAutoRepeat(__xdpy, 1, null)       # (a held key repeats presses only)
        XMapWindow(__xdpy, __xwin)
        XFlush(__xdpy)
        __xev = __alloc(256)
        if not __soft and __vk_wanted():
            why = __vk_open("VK_KHR_xlib_surface", __vk_xlib_surface)
            if len(why) == 0: __vk = true
            else: __vk_note("{why}; using OpenGL")
        if not __soft and not __vk:
            why = __egl_open()
            if len(why) > 0:
                eprint("note: {why}; using the software renderer")
                __soft = true
        if __soft: __sw_init_window(__win_w, __win_h)

    __platform_title = ():
        if __wayland: __wl_set_title(__win_title)
        else if __xproto: __xp_property(39, 31, 8, bytes(__win_title))         # WM_NAME, STRING
        else if __xdpy != null:
            XStoreName(__xdpy, __xwin, data(__zstr(__win_title)))
            XFlush(__xdpy)

    # OpenGL ES without a window surface: drawing goes to an offscreen framebuffer that is
    # copied into the Wayland window's buffers
    __egl_open_surfaceless = () -> str:
        if not lib_available("libEGL.so.1") or not lib_available("libGLESv2.so.2"): return "no OpenGL ES driver (libEGL/libGLESv2) found"
        __egl_dpy = eglGetPlatformDisplay(0x31DD, null, null)        # EGL_PLATFORM_SURFACELESS_MESA
        if __egl_dpy == null: return "no surfaceless EGL display"
        maj: i32 = 0
        mn: i32 = 0
        if eglInitialize(__egl_dpy, &maj, &mn) == 0: return "eglInitialize failed"
        eglBindAPI(0x30A0)
        attrs: i32[] = [0x3033, 0, 0x3040, 0x40, 0x3038]               # any surface type; ES3
        cfg: *u8 = null
        n: i32 = 0
        if eglChooseConfig(__egl_dpy, data(attrs), &cfg, 1, &n) == 0 or n == 0: return "no suitable EGL config"
        cattrs: i32[] = [0x3098, 3, 0x30FB, 0, 0x3038]
        ctx = eglCreateContext(__egl_dpy, cfg, null, data(cattrs))
        if ctx == null: return "eglCreateContext failed (OpenGL ES 3 needed)"
        __egl_ctx = ctx
        if eglMakeCurrent(__egl_dpy, null, null, ctx) == 0: return "the GL driver cannot render without a window surface"
        __gl_screen_resize(__win_w, __win_h)
        ""

    # set up OpenGL ES on the window; returns why that is impossible, or ""
    __egl_open = () -> str:
        if not lib_available("libEGL.so.1") or not lib_available("libGLESv2.so.2"): return "no OpenGL ES driver (libEGL/libGLESv2) found"
        __egl_dpy = eglGetPlatformDisplay(0x31D5, __xdpy, null)      # EGL_PLATFORM_X11_KHR
        if __egl_dpy == null: __egl_dpy = eglGetDisplay(__xdpy)
        if __egl_dpy == null: return "eglGetDisplay failed"
        maj: i32 = 0
        mn: i32 = 0
        if eglInitialize(__egl_dpy, &maj, &mn) == 0: return "eglInitialize failed"
        eglBindAPI(0x30A0)             # EGL_OPENGL_ES_API
        attrs: i32[] = [0x3024, 8, 0x3023, 8, 0x3022, 8, 0x3025, 24, 0x3040, 0x40, 0x3033, 4, 0x3038]
        cfg: *u8 = null
        n: i32 = 0
        if eglChooseConfig(__egl_dpy, data(attrs), &cfg, 1, &n) == 0 or n == 0: return "no suitable EGL config"
        __egl_surf = eglCreateWindowSurface(__egl_dpy, cfg, __xwin, null)
        if __egl_surf == null:
            # try the platform-specific entry point, which takes a pointer to the window id
            __egl_surf = eglCreatePlatformWindowSurface(__egl_dpy, cfg, &__xwin, null)
        if __egl_surf == null: return "eglCreateWindowSurface failed (EGL error 0x{eglGetError():x})"
        cattrs: i32[] = [0x3098, 3, 0x30FB, 0, 0x3038]
        ctx = eglCreateContext(__egl_dpy, cfg, null, data(cattrs))
        if ctx == null: return "eglCreateContext failed (OpenGL ES 3 needed)"
        if eglMakeCurrent(__egl_dpy, __egl_surf, __egl_surf, ctx) == 0: return "eglMakeCurrent failed"
        eglSwapInterval(__egl_dpy, 1)
        ""

    __ximg: *u8 = null
    __ximg_buf: u8[]
    __ximg_w = 0
    __ximg_h = 0

    # show the software renderer's frame
    __sw_present = ():
        w = __win_w
        h = __win_h
        if __xproto:
            if __ximg_buf.len() != w * h * 4: __ximg_buf = fill(u8(0), w * h * 4)
            __sw_present_pixels(data(__ximg_buf), w, h)
            __xp_put_image(__ximg_buf, w, h)
            return
        if __xdpy == null: return
        if __ximg == null or __ximg_w != w or __ximg_h != h:
            if __ximg != null: XFree(__ximg)       # frees the header only; the pixels are ours
            __ximg_buf = fill(u8(0), w * h * 4)
            __ximg = XCreateImage(__xdpy, XDefaultVisual(__xdpy, __xscr), u32(XDefaultDepth(__xdpy, __xscr)), 2, 0, data(__ximg_buf), u32(w), u32(h), 32, 0)
            __ximg_w = w
            __ximg_h = h
        __sw_present_pixels(data(__ximg_buf), w, h)
        XPutImage(__xdpy, __xwin, XDefaultGC(__xdpy, __xscr), __ximg, 0, 0, 0, 0, u32(w), u32(h))
        XSync(__xdpy, 0)

    __xkey = (sym: int) -> int:
        if sym >= 0x61 and sym <= 0x7a: return int(Key.a) + sym - 0x61
        if sym >= 0x41 and sym <= 0x5a: return int(Key.a) + sym - 0x41
        if sym >= 0x30 and sym <= 0x39: return int(Key.n0) + sym - 0x30
        if sym >= 0xffbe and sym <= 0xffc9: return int(Key.f1) + sym - 0xffbe
        if sym >= 0xffb0 and sym <= 0xffb9: return int(Key.kp0) + sym - 0xffb0
        match sym:
            # (the number pad, its NumLock off or on: kp7 is 7 and Home)
            0xff95: int(Key.kp7)
            0xff96: int(Key.kp4)
            0xff97: int(Key.kp8)
            0xff98: int(Key.kp6)
            0xff99: int(Key.kp2)
            0xff9a: int(Key.kp9)
            0xff9b: int(Key.kp3)
            0xff9c: int(Key.kp1)
            0xff9d: int(Key.kp5)
            0xff9e: int(Key.kp0)
            0xff9f, 0xffae: int(Key.kp_period)
            0xffab: int(Key.kp_plus)
            0xffad: int(Key.kp_minus)
            0xffaa: int(Key.kp_star)
            0xffaf: int(Key.kp_slash)
            0x20: int(Key.space)
            0xff0d: int(Key.enter)
            0xff8d: int(Key.enter)
            0xff1b: int(Key.escape)
            0xff09: int(Key.tab)
            0xff08: int(Key.backspace)
            0xffff: int(Key.delete)
            0xff63: int(Key.insert)
            0xff50: int(Key.home)
            0xff57: int(Key.end)
            0xff55: int(Key.page_up)
            0xff56: int(Key.page_down)
            0xff51: int(Key.left)
            0xff52: int(Key.up)
            0xff53: int(Key.right)
            0xff54: int(Key.down)
            0xffe1, 0xffe2: int(Key.shift)
            0xffe3, 0xffe4: int(Key.ctrl)
            0xffe9, 0xffea: int(Key.alt)
            0xffeb, 0xffec: int(Key.super)
            0x2d: int(Key.minus)
            0x3d: int(Key.equals)
            0x2c: int(Key.comma)
            0x2e: int(Key.period)
            0x2f: int(Key.slash)
            0x3b: int(Key.semicolon)
            0x27: int(Key.quote)
            0x5b: int(Key.lbracket)
            0x5d: int(Key.rbracket)
            0x5c: int(Key.backslash)
            0x60: int(Key.grave)
            _: 0

    __platform_poll = ():
        if __wayland:
            __wl_poll()
            # (a lock asked for before the seat had a pointer)
            if __mouse_lock_want and __wl_locked == 0 and __wl_pointer != 0 and __wl_constraints != 0: __wl_pointer_lock(true)
            return
        if __xproto:
            __xp_poll()
            return
        if __xdpy == null: return
        loop XPending(__xdpy) > 0:
            XNextEvent(__xdpy, __xev)
            __x_event(__xev)

    __x_event = (evp: *u8):
        ev = evp as *i32
        kind = int(ev[0])
        if kind == 2 or kind == 3:
            sym = XLookupKeysym(evp, 0)
            k = __xkey(sym)
            # (a press of a key already down: held, repeating)
            __key_event(k, kind == 2, kind == 2 and k > 0 and __key_down[k])
            if kind == 2 and int(ev[20]) & 4 == 0:
                buf = __alloc(16)
                ks = [0]
                n = XLookupString(evp, buf, 15, data(ks), null)
                # (the keysym the layout gives: Latin-1 as itself, others as 0x1000000 + Unicode)
                c = 0
                if (ks[0] >= 0x20 and ks[0] < 0x7F) or (ks[0] >= 0xA0 and ks[0] <= 0xFF): c = ks[0]
                else if ks[0] >= 0x1000100 and ks[0] <= 0x110FFFF: c = ks[0] - 0x1000000
                else if ks[0] == 0x20AC: c = 0x20AC
                else if n == 1 and buf[0] >= 32 and buf[0] < 127: c = int(buf[0])
                if c > 0: __text_input += chr(c)
                __free(buf)
        else if kind == 4 or kind == 5:
            btn = int(ev[21])
            if btn == 1: __mouse_event(0, kind == 4)
            else if btn == 2: __mouse_event(1, kind == 4)
            else if btn == 3: __mouse_event(2, kind == 4)
            else if btn == 4 and kind == 4: __mouse_wheel += 1.0
            else if btn == 5 and kind == 4: __mouse_wheel -= 1.0
        else if kind == 6:
            x = f64(ev[16])
            y = f64(ev[17])
            __mouse_dx += x - __mouse_x
            __mouse_dy += y - __mouse_y
            __mouse_x = x
            __mouse_y = y
            # (locked: back to the middle, so the motion never stops at the window's edge)
            if __x_locked and (int(x) != __win_w / 2 or int(y) != __win_h / 2): __x_recenter()
        else if kind == 22:
            __win_w = int(ev[14])
            __win_h = int(ev[15])
        else if kind == 33:
            if (evp as *int)[7] == __wm_delete: __win_close = true
        else if kind == 10:
            __win_focused = false
            loop mut kd in __key_down: kd = false
            # (focus elsewhere: the pointer is free there, and locked again on return)
            if __x_locked:
                XUngrabPointer(__xdpy, 0)
                __x_locked = false
        else if kind == 9:
            __win_focused = true
            if __mouse_lock_want and not __x_locked: __x_mouse_lock(true)
        else if kind == 30: __x_selection_request(evp)
        else if kind == 31:
            __x_sel_done = true
            __x_sel_prop = (evp as *int)[7]

    # ---- fullscreen and the clipboard (libX11) ----
    __x_atoms: {str: int} = {}
    __x_atom = (name: str) -> int:
        if let a = __x_atoms.get(name): return a
        a = XInternAtom(__xdpy, data(__zstr(name)), 0)
        __x_atoms[name] = a
        a

    __x_fullscreen = (on: bool):
        ev = fill(0, 24)                       # an XClientMessageEvent to the root window
        ev[0] = 33
        ev[4] = __xwin
        ev[5] = __x_atom("_NET_WM_STATE")
        ev[6] = 32
        ev[7] = int(on)
        ev[8] = __x_atom("_NET_WM_STATE_FULLSCREEN")
        ev[10] = 1
        XSendEvent(__xdpy, XRootWindow(__xdpy, __xscr), 0, 0x180000, data(ev) as *u8)
        XFlush(__xdpy)

    __x_clip_text = ""
    __x_sel_done = false
    __x_sel_prop = 0

    __x_set_clipboard = (s: str):
        __x_clip_text = s
        XSetSelectionOwner(__xdpy, __x_atom("CLIPBOARD"), __xwin, 0)
        XFlush(__xdpy)

    # another program asks for the clipboard we own: put the text on its window, and say so
    __x_selection_request = (evp: *u8):
        e = evp as *int
        requestor = e[5]
        target = e[7]
        prop = e[8]
        if prop == 0: prop = target
        utf8 = __x_atom("UTF8_STRING")
        if target == __x_atom("TARGETS"):
            ts = [__x_atom("TARGETS"), utf8, 31]
            XChangeProperty(__xdpy, requestor, prop, 4, 32, 0, data(ts) as *u8, 3)
        else if target == utf8 or target == 31:
            b = bytes(__x_clip_text)
            XChangeProperty(__xdpy, requestor, prop, target, 8, 0, data(b), i32(b.len()))
        else: prop = 0
        r = fill(0, 24)                        # an XSelectionEvent
        r[0] = 31
        r[4] = requestor
        r[5] = e[6]
        r[6] = target
        r[7] = prop
        r[8] = e[9]
        XSendEvent(__xdpy, requestor, 0, 0, data(r) as *u8)
        XFlush(__xdpy)

    __x_get_clipboard = () -> str:
        cb = __x_atom("CLIPBOARD")
        owner = XGetSelectionOwner(__xdpy, cb)
        if owner == __xwin: return __x_clip_text
        if owner == 0: return ""
        prop = __x_atom("SLOPPY_CLIPBOARD")
        __x_sel_done = false
        XConvertSelection(__xdpy, cb, __x_atom("UTF8_STRING"), prop, __xwin, 0)
        XFlush(__xdpy)
        t0 = time()
        loop not __x_sel_done and time() - t0 < 0.5:
            if XPending(__xdpy) > 0:
                XNextEvent(__xdpy, __xev)
                __x_event(__xev)
            else: sleep(0.002)
        if not __x_sel_done or __x_sel_prop == 0: return ""
        ty = 0
        fmt: i32 = 0
        n = 0
        after = 0
        p: *u8 = null
        XGetWindowProperty(__xdpy, __xwin, prop, 0, 1 << 24, 1, 0, &ty, &fmt, &n, &after, &p)
        if p == null: return ""
        out = fill(u8(0), n)
        mem_copy(data(out), p, n)
        XFree(p)
        str_from_bytes(out)

    # the clipboard where the platform has none of its own (the X11 protocol path): this program's
    __local_clip = ""
    __platform_fullscreen = (on: bool):
        if __wayland: __wl_set_fullscreen(on)
        else if __xproto: __xp_fullscreen(on)
        else if __xdpy != null: __x_fullscreen(on)
    __platform_mouse_lock = (on: bool) -> bool:
        if __wayland: return __wl_pointer_lock(on)
        if __xdpy != null and not __xproto: return __x_mouse_lock(on)
        false
    __platform_mouse_locked = () -> bool:
        if __wayland: return __wl_locked != 0
        __x_locked
    __platform_show_cursor = (on: bool):
        if __wayland: __wl_show_cursor(on)
        else if __xdpy != null and not __xproto: __x_show_cursor(on)

    # ---- mouse lock (libX11): the pointer grabbed, hidden and put back in the middle ----
    @lib("libX11.so.6")
    extern XGrabPointer = (d: *u8, w: int, owner: i32, mask: u32, pmode: i32, kmode: i32, confine: int, cursor: int, time: int) -> i32
    @lib("libX11.so.6")
    extern XUngrabPointer = (d: *u8, time: int) -> i32
    @lib("libX11.so.6")
    extern XWarpPointer = (d: *u8, src: int, dst: int, sx: i32, sy: i32, sw: u32, sh: u32, dx: i32, dy: i32) -> i32
    @lib("libX11.so.6")
    extern XCreateBitmapFromData = (d: *u8, w: int, bits: *u8, width: u32, height: u32) -> int
    @lib("libX11.so.6")
    extern XCreatePixmapCursor = (d: *u8, src: int, mask: int, fg: *u8, bg: *u8, x: u32, y: u32) -> int
    @lib("libX11.so.6")
    extern XDefineCursor = (d: *u8, w: int, c: int) -> i32
    @lib("libX11.so.6")
    extern XUndefineCursor = (d: *u8, w: int) -> i32

    __x_locked = false
    __x_blank = 0

    __x_mouse_lock = (on: bool) -> bool:
        if not on:
            if __x_locked: XUngrabPointer(__xdpy, 0)
            __x_locked = false
            __x_show_cursor(not __cursor_hidden)
            return true
        __x_make_blank()
        XDefineCursor(__xdpy, __xwin, __x_blank)
        # (pointer motion and buttons, both async, confined to the window)
        __x_locked = XGrabPointer(__xdpy, __xwin, 1, 0x4 | 0x8 | 0x40, 1, 1, __xwin, __x_blank, 0) == 0
        if __x_locked: __x_recenter()
        XFlush(__xdpy)
        __x_locked

    # (an invisible cursor: a 1x1 bitmap with nothing in its mask)
    __x_make_blank = ():
        if __x_blank != 0: return
        bits = fill(u8(0), 8)
        color = fill(u8(0), 16)
        bm = XCreateBitmapFromData(__xdpy, __xwin, data(bits), 1, 1)
        __x_blank = XCreatePixmapCursor(__xdpy, bm, bm, data(color), data(color), 0, 0)

    __x_show_cursor = (on: bool):
        if __x_locked: return
        if on: XUndefineCursor(__xdpy, __xwin)
        else:
            __x_make_blank()
            XDefineCursor(__xdpy, __xwin, __x_blank)
        XFlush(__xdpy)

    __x_recenter = ():
        XWarpPointer(__xdpy, 0, __xwin, 0, 0, 0, 0, i32(__win_w / 2), i32(__win_h / 2))
        __mouse_x = f64(__win_w / 2)
        __mouse_y = f64(__win_h / 2)
    __platform_clipboard = () -> str:
        if __wayland: return __wl_get_clipboard()
        if __xdpy != null: return __x_get_clipboard()
        __local_clip
    __platform_set_clipboard = (s: str):
        if __wayland: __wl_set_clipboard(s)
        else if __xdpy != null: __x_set_clipboard(s)
        else: __local_clip = s
    __platform_paste = (): pass
    __platform_pasted = () -> bool: (key_down(.ctrl) or key_down(.super)) and key_pressed(.v)
    __platform_can_share = () -> bool: false
    __platform_share = (s: str): pass
    __platform_finger = () -> bool: false

    # (Vulkan surfaces for the window: the libX11 window, or the libwayland surface)
    __vk_xlib_surface = () -> int:
        info = VkXlibSurfaceCreateInfo(stype = 1000004000, dpy = __xdpy, window = __xwin)
        s = 0
        if vkCreateXlibSurfaceKHR(__vk_inst, (&info) as *u8, null, &s) != 0: return 0
        s

    __vk_wayland_surface = () -> int:
        info = VkWaylandSurfaceCreateInfo(stype = 1000006000, display = __lw_display, surface = __lw_proxy(__wl_surface))
        s = 0
        if vkCreateWaylandSurfaceKHR(__vk_inst, (&info) as *u8, null, &s) != 0: return 0
        s

    __platform_present = ():
        if __vk:
            if __wayland:
                # (the title bar the window draws itself, if it does; the viewport's size goes with
                # the frame the swapchain commits)
                __vk_bar_h = __wl_bar_px
                if __wl_bar_px > 0:
                    key = "{__win_w} {__wl_bar_px} {__wl_lw} {__win_title}"
                    if key != __wl_bar_key:
                        __wl_bar_key = key
                        __vk_bar = fill(u8(0), __win_w * __wl_bar_px * 4)
                        __wl_draw_bar(data(__vk_bar), __win_w, false)
                        loop i in [0..__win_w * __wl_bar_px): __vk_bar[i * 4 + 3] = 255
                __wl_set_size()
                __wl_flush()
            __vk_present()
            return
        if __wayland:
            if __soft: __wl_present((out: *u8, w: int, h: int): __sw_present_pixels(out, w, h))
            else if not __wl_present_gpu(): __wl_present((out: *u8, w: int, h: int): __gl_screen_copy(out, w, h))
        else if __soft: __sw_present()
        else: eglSwapBuffers(__egl_dpy, __egl_surf)

    __game_run = (update: (f64) -> void, draw: () -> void):
        window(__win_title, __win_w, __win_h)
        __fixed_step = env("SLOPPY_SCREENSHOT") != none
        when WATCH:
            __watch_init()
        last = time()
        loop not __win_close:
            when WATCH:
                __watch_frame()
            __platform_poll()
            now = time()
            dt = clamp(now - last, 0.0, 0.1)
            last = now
            if __fixed_step: dt = 1.0 / 60.0
            if __soft: __sw_init_window(__win_w, __win_h)
            else if __wayland and not __vk: __gl_screen_resize(__win_w, __win_h)
            __run_frame(dt, update, draw)
            t0 = time()
            __platform_present()
            __last_present = time() - t0
            __frame_present += __last_present
            # without vsync, software frames are paced to 60 per second
            if (__soft and not __fixed_step) or (__fixed_step and __pace_real_time):
                left = 1.0 / 60.0 - (time() - now)
                if left > 0.0: sleep(left)
        __game_quit()
        exit(0)

# (render_image before any window: the software renderer, with none)
__is_game = false               # (set first thing by a program with update or draw)
__offscreen = false
__soft_kept = false
__open_offscreen = ():
    when TARGET != "wasm":
        __input_init()
        __offscreen = true
        __soft = true
        __soft_scale = 1.0
        __win_w = 1
        __win_h = 1
        __design_w = 1
        __design_h = 1
        __sw_init_window(1, 1)
        __win_open = true
        __time0 = time()

__no_update = (dt: f64): pass
__no_draw = (): pass

# the game's on_quit = (): run once as it ends: its window closed (or quit() called), or a
# test's frames are done
# (a page: as it is closed or left)
__quit_fn: () -> void = __no_draw
__quit_done = false
__set_quit = (f: () -> void): __quit_fn = f
__game_quit = ():
    if __quit_done: return
    __quit_done = true
    __quit_fn()
    # (a page closed does not reach the program's end: its goodbyes now)
    when TARGET == "wasm": __run_end_fns()

__fps_acc = 0.0
__fps_n = 0

# testing aid: SLOPPY_INPUT="5:space+,7:space-,10:right+" (commas or spaces between) presses (+) / releases (-) keys at
# frames (the names of Key: a, n1, space, escape, left, shift...); mouse_left+ (and mouse_right,
# mouse_middle) the mouse's buttons, 3:wheel=1 turns the wheel a notch (-1: back), and
# 12:mouse=400x300 moves the mouse there (in the screen's
# units, as mouse_pos); 5:touch1=400x300 puts finger 1 down there or moves it, 9:touch1- lifts it
# (the first finger down is the mouse too, as on a phone); a letter, digit, space or punctuation key pressed is typed (text_input; with shift, as a US keyboard does), and 9:text=ACE types text;
# a gamepad (pad 0): 5:pad_a+ and 9:pad_a- (PadButton's names: pad_start, pad_up...), 5:lstick=1x0
# and rstick=XxY (x right, y down, -1 to 1), 5:lt=1 and rt=V (the triggers, 0 to 1)
__script: (int, int, bool, vec2)[]          # (frame, key (-1 - button: a mouse button; -100: a move), down, where)
__script_loaded = false
__script_mouse_placed = false
__script_text: (int, str)[]                 # (frame, text typed then: 5:text=ACE)
# (SLOPPY_INPUT's gamepad, pad 0: there from the first item that uses it)
__scripted_pad = ():
    loop e in __script:
        if e.0 != __frame_count or e.1 > -300 or e.1 <= -500: continue
        if not __pad_on[0]:
            __pad_on[0] = true
            __pad_names[0] = "SLOPPY_INPUT"
        if e.1 > -400:
            __pad_down[-300 - e.1] = e.2
        else:
            ax = -400 - e.1
            if ax == 0 or ax == 1:
                __pad_axes[ax * 2] = f64(e.3.x)
                __pad_axes[ax * 2 + 1] = f64(e.3.y)
            else: __pad_axes[2 + ax] = f64(e.3.x)

__scripted_input = ():
    if __fixed_step: __ignore_real_input()
    if not __script_loaded:
        __script_loaded = true
        # (a screenshot run's mouse starts in the middle of the window, as one resting there,
        # not in the corner, where a game that scrolls at the screen's edge would scroll)
        if __fixed_step:
            __mouse_x = f64(__win_w) / 2.0
            __mouse_y = f64(__win_h) / 2.0
        if let s = env("SLOPPY_INPUT"):
            # (items between commas or spaces; text=... runs on, spaces and all, to the next
            # comma or the next word that starts with a frame number and a colon)
            items: str[]
            loop part in split(s, ","):
                in_text = false
                loop w in words(part):
                    c0 = find(w, ":")
                    starts_item = c0 > 0 and to_int(w[..c0)) != none
                    if in_text and not starts_item:
                        items[items.len() - 1] = items[items.len() - 1] + " " + w
                        continue
                    items.push(w)
                    in_text = starts_item and starts_with(w[c0 + 1..], "text=")
            loop item in items:
                c = find(item, ":")
                if c < 0 or len(item) < c + 3: continue
                fr = to_int(item[..c)) ?? 0
                if starts_with(item[c + 1..], "text="):
                    __script_text.push((fr, item[c + 6..]))
                    continue
                if starts_with(item[c + 1..], "wheel="):
                    if let wv = to_float(item[c + 7..]):
                        __script.push((fr, -101, false, vec2(f32(wv), 0)))
                        continue
                # (5:touch1=400x300 puts finger 1 down there, or moves it; 9:touch1- lifts it)
                if starts_with(item[c + 1..], "touch"):
                    rest = item[c + 6..]
                    eq = find(rest, "=")
                    if eq > 0:
                        xy = split(rest[eq + 1..], "x")
                        if let fid = to_int(rest[..eq)):
                            if xy.len() == 2:
                                if let tx = to_float(xy[0]):
                                    if let ty = to_float(xy[1]):
                                        __script.push((fr, -200 - fid, true, vec2(f32(tx), f32(ty))))
                                        continue
                    else if ends_with(rest, "-"):
                        if let fid = to_int(rest[..len(rest) - 1)):
                            __script.push((fr, -200 - fid, false, vec2(0, 0)))
                            continue
                # (a gamepad, pad 0: its sticks and triggers set, its buttons pressed and let go)
                pv = item[c + 1..]
                ax = -1
                if starts_with(pv, "lstick="): ax = 0
                else if starts_with(pv, "rstick="): ax = 1
                else if starts_with(pv, "lt="): ax = 2
                else if starts_with(pv, "rt="): ax = 3
                if ax >= 0:
                    vs = pv[find(pv, "=") + 1..]
                    if ax < 2:
                        xy = split(vs, "x")
                        if xy.len() == 2:
                            if let sx = to_float(xy[0]):
                                if let sy = to_float(xy[1]):
                                    __script.push((fr, -400 - ax, false, vec2(f32(sx), f32(sy))))
                                    continue
                    else if let tv = to_float(vs):
                        __script.push((fr, -400 - ax, false, vec2(f32(tv), 0)))
                        continue
                if starts_with(pv, "pad_") and len(pv) > 5 and (ends_with(pv, "+") or ends_with(pv, "-")):
                    bn = pv[4..len(pv) - 1)
                    bi = -1
                    loop b in [0..15):
                        if "{b as PadButton}" == bn: bi = b
                    if bi >= 0:
                        __script.push((fr, -300 - bi, ends_with(pv, "+"), vec2(0, 0)))
                        continue
                if starts_with(item[c + 1..], "mouse="):
                    xy = split(item[c + 7..], "x")
                    if xy.len() == 2:
                        if let mx = to_float(xy[0]):
                            if let my = to_float(xy[1]):
                                __script.push((fr, -100, false, vec2(f32(mx), f32(my))))
                                continue
                name = item[c + 1..len(item) - 1)
                down = item[len(item) - 1] == '+'
                found = -1000
                loop k in [0..__NKEYS):
                    if "{k as Key}" == name: found = k
                loop b in [0..3):
                    if "mouse_{b as Mouse}" == name: found = -1 - b
                if found == -1000 or (item[len(item) - 1] != '+' and item[len(item) - 1] != '-'):
                    eprint("SLOPPY_INPUT: '{item}' is not frame:key+ or frame:key- (keys as Key names them: a, n1, space, enter, escape, left, shift; mouse_left), frame:mouse=XxY, frame:wheel=N, frame:text=..., frame:touch1=XxY or frame:touch1-, frame:pad_a+ (a gamepad's buttons), frame:lstick=XxY, rstick=XxY, lt=V nor rt=V")
                    continue
                __script.push((fr, found, down, vec2(0, 0)))
    loop e in __script_text:
        if e.0 == __frame_count: __text_input += e.1
    loop e in __script:
        if e.0 != __frame_count: continue
        if e.1 >= 0:
            __key_event(e.1, e.2)
            # (a letter, digit, space or punctuation key pressed types it too, as a keyboard does; not with ctrl
            # or alt held: a shortcut, ctrl+z, types nothing)
            if e.2 and not key_down(.ctrl) and not key_down(.alt):
                kn = "{e.1 as Key}"
                if len(kn) == 1:
                    if key_down(.shift): __text_input += upper(kn)
                    else: __text_input += kn
                else if len(kn) == 2 and kn[0] == 'n' and is_digit(kn[1]):
                    # (shift+n1 is !, as on a US keyboard)
                    if key_down(.shift): __text_input += ")!@#$%^&*("[int(kn[1]) - 48..int(kn[1]) - 47)
                    else: __text_input += kn[1..]
                else if kn == "space": __text_input += " "
                else:
                    # punctuation, shifted as on a US keyboard (shift+period is >)
                    k = find(__SCRIPT_PUNCT, " {kn} ")
                    if k >= 0:
                        j = k + len(kn) + 2
                        if key_down(.shift): __text_input += __SCRIPT_PUNCT[j + 1..j + 2)
                        else: __text_input += __SCRIPT_PUNCT[j..j + 1)
        else if e.1 <= -300 and e.1 > -500: pass       # (a gamepad's: __scripted_pad, after the pads are read)
        else if e.1 == -101: __mouse_wheel += f64(e.3.x)
        else if e.1 == -100: __script_move_mouse(e.3)
        else if e.1 <= -200:
            # a finger: as on a phone, the first one down is also the mouse, its left button held
            fid = -200 - e.1
            if e.2:
                __screen_layout()
                nx = f32(f64(e.3.x) * __map_sx + __map_x0)
                ny = f32(f64(e.3.y) * __map_sy + __map_y0)
                kind = 0
                if __touch_ids.index_of(fid) < 0: kind = 1
                __touch_event(fid, kind, nx, ny)
                if kind == 1 and __script_finger < 0:
                    __script_finger = fid
                    __script_move_mouse(e.3)
                    __mouse_event(0, true)
                else if fid == __script_finger: __script_move_mouse(e.3)
            else:
                __touch_event(fid, 2, 0.0, 0.0)
                if fid == __script_finger:
                    __mouse_event(0, false)
                    __script_finger = -1
        else: __mouse_event(-1 - e.1, e.2)

__script_finger = -1                        # (the finger that is the mouse)
# move the mouse to p (in the screen's units), as a pointer moving there: mouse_delta, drags and
# mouse look see it; the first move only says where it is, as a pointer that has been there all along
__script_move_mouse = (p: vec2):
    __screen_layout()
    nx = f64(p.x) * __map_sx + __map_x0
    ny = f64(p.y) * __map_sy + __map_y0
    if __script_mouse_placed:
        __mouse_dx += nx - __mouse_x
        __mouse_dy += ny - __mouse_y
    __script_mouse_placed = true
    __mouse_x = nx
    __mouse_y = ny

__run_frame = (dt: f64, update: (f64) -> void, draw: () -> void):
    __out_flush()                   # (what the last frame printed)
    __scripted_input()
    __pad_frame()
    __scripted_pad()
    __fps_acc += dt
    __fps_n += 1
    if __fps_acc >= 0.5:
        __fps = f64(__fps_n) / __fps_acc
        __fps_acc = 0.0
        __fps_n = 0
    sdt = dt * __time_scale
    __dt = sdt
    t0 = time()
    __gfx_begin_frame()
    when WATCH:
        zone("update and draw")
        __watch_update_draw(sdt, update, draw)
        zone_end()
    else:
        zone("update")
        update(sdt)
        zone_end()
        zone("draw")
        draw()
        zone_end()
    __sideways_draw()
    __gfx_end_frame()
    __audio_update()
    __frame_cpu += time() - t0
    __stats_record(time() - t0)
    __stats_draw()
    __maybe_screenshot()
    __input_end_frame()
    __frame_count += 1

# (sideways_hint's note: a phone upright on the left, an arrow, the phone sideways, and words,
# sized by the screen's width)
__sideways_draw = ():
    if not __sideways_on or __win_h <= __win_w or __design_w <= __design_h or not __platform_finger(): return
    reset_transform()
    r = visible_rect()
    rect(r, rgba(0.03, 0.04, 0.06, 0.85))
    w = f64(r.w)
    cx = f64(r.x) + w / 2.0
    cy = f64(r.y + r.h / 2.0)
    col = rgba(1, 1, 1, 0.9)
    t = w * 0.012
    ph = w * 0.2
    pw = ph * 0.52
    rect_rounded_outline(cx - w * 0.22 - pw / 2.0, cy - ph / 2.0, pw, ph, pw * 0.15, t, col)
    rect_rounded_outline(cx + w * 0.22 - ph / 2.0, cy - pw / 2.0, ph, pw, pw * 0.15, t, col)
    a = vec2(f32(cx - w * 0.07), f32(cy))
    b = vec2(f32(cx + w * 0.05), f32(cy))
    line(a, b, t, col)
    triangle(b + vec2(f32(w * 0.04), 0), b + vec2(0, f32(-w * 0.03)), b + vec2(0, f32(w * 0.03)), col)
    text_centered("Turn your phone sideways", vec2(f32(cx), f32(cy + ph * 0.5 + w * 0.12)), w * 0.06, col)

__frame_cpu = 0.0
__frame_present = 0.0         # time spent handing frames to the screen (and waiting for vsync)

# how frames reach the screen (for diagnostics)
__present_how = () -> str:
    when TARGET == "wasm": return "webgl"
    else when TARGET == "windows":
        if __soft: return "software renderer (StretchDIBits)"
        if __vk: return "vulkan ({__vk_device_name})"
        return "wgl"
    else when TARGET == "macos":
        if __soft: return "software renderer (layer contents)"
        if __vk: return "metal ({__vk_device_name})"
        return "opengl (nsopengl)"
    else:
        if __soft: return "software renderer"
        if __vk: return "vulkan ({__vk_device_name})"
        if __wayland:
            how = "wayland"
            if not __lw_on: how = "wayland protocol"
            else if __ld_frame != null: how = "wayland+libdecor"
            if __wl_gpu > 0: return "{how} dma-buf, scale {__wl_scale:.3}"
            return "{how} shared memory copy, scale {__wl_scale:.3}"
        "egl window surface"

# testing aid: SLOPPY_SCREENSHOT=out.png [SLOPPY_FRAMES=n] saves frame n and exits (SLOPPY_WINDOW=WxH
# for a window of another size)
# (SLOPPY_FRAME_STATS=1 also reports the average CPU time of a frame: update + draw + submit)
__maybe_screenshot = ():
    when TARGET != "wasm":
        if let path = env("SLOPPY_SCREENSHOT"):
            n = to_int(env("SLOPPY_FRAMES") ?? "5") ?? 5
            if __frame_count == n:
                save_png(screenshot(), path)
                if env("SLOPPY_FRAME_STATS") != none:
                    eprint("frame cpu: {__frame_cpu * 1000.0 / f64(n + 1):.2} ms average over {n + 1} frames, present {__frame_present * 1000.0 / f64(n):.2} ms; {__win_w}x{__win_h} pixels, {__present_how()}")
                __game_quit()
                exit(0)
        # (SLOPPY_FRAMES alone: that many frames, then the program ends, with no picture)
        else if let fr = env("SLOPPY_FRAMES"):
            if __frame_count == (to_int(fr) ?? -1):
                __game_quit()
                exit(0)

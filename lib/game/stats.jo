# A frame statistics overlay: frame times as a graph, CPU time, time handing frames to the
# screen, frames that took much longer than usual (stutter), and the time each zone of the frame
# takes (zone("physics") ... zone_end(): update and draw are zones already, as are the 3D scene,
# its shadows and post-processing), on the CPU and, through Vulkan, on the GPU. show_stats() turns it
# on, as do SLOPPY_STATS=1 and, in a web page, ?stats in the URL. SLOPPY_STATS=log (?stats=log)
# prints the same numbers every two seconds instead, and each long frame as it happens.

const __STATS_N = 240
__stats_on = false
__stats_log = false
__stats_log_at = -1.0           # (when the last summary was written, and at which frame)
__stats_log_i = 0
__stats_checked = false
__stats_interval: f64[]       # the time between consecutive frames (a ring)
__stats_cpu: f64[]            # update + draw + submitting the drawing
__stats_present: f64[]        # handing the frame to the screen (including waiting for vsync)
__stats_i = 0
__stats_last = -1.0
__last_present = 0.0

show_stats = (on: bool = true): __stats_on = on
stats_shown = () -> bool: __stats_on

# ---------------- zones: named parts of a frame, timed ----------------
const __ZONES_MAX = 32
__zone_names: str[]
__zone_ids: {str: int} = {}
__zone_depth: int[]             # (how deep in other zones each was first: for indenting)
__zone_t: f64[]                 # this frame's time in each zone
__zone_hist: f64[]              # each zone's time in the last __STATS_N frames (zone * __STATS_N + frame)
__zone_open: int[]              # the zones open now, innermost last (-1: one past __ZONES_MAX)
__zone_start: f64[]
# GPU time (Vulkan): it comes back a frame or two late, from timestamps among the commands
__zone_gpu_t: f64[]
__zone_gpu_hist: f64[]
__zone_gpu_q: (int, int)[]      # (each open zone: its timestamp's query and recording, vk.jo)
__stats_gpu_t = 0.0             # (the frame's)
__stats_gpu: f64[]
__gpu_seen = false              # (GPU time has come back: the overlay shows it)

# (vk.jo: what took the GPU dt seconds: a zone, or -1 the frame)
__gpu_time = (what: int, dt: f64):
    __gpu_seen = true
    if what < 0: __stats_gpu_t += dt
    else if what < __zone_gpu_t.len(): __zone_gpu_t[what] += dt

# start timing a part of the frame, until zone_end() (zones nest; their times show in the
# overlay; a zone entered several times in a frame shows their total); costs a check when the
# statistics are off
zone = (name: str):
    if not __stats_on and not __stats_log: return
    id = __zone_ids.get(name) ?? -1
    if id < 0 and __zone_names.len() < __ZONES_MAX:
        id = __zone_names.len()
        __zone_ids[name] = id
        __zone_names.push(name)
        __zone_depth.push(__zone_open.len())
        __zone_t.push(0.0)
        __zone_hist.resize((id + 1) * __STATS_N)
        __zone_gpu_t.push(0.0)
        __zone_gpu_hist.resize((id + 1) * __STATS_N)
    __zone_open.push(id)
    __zone_start.push(time())
    q = -1
    s = 0
    when TARGET != "wasm":
        if __vk:
            __vk_ts_want()
            if __vk_ts_pool != 0 and id >= 0:
                __vk_begin_frame()      # (the frame's commands may not have begun yet)
                flush()                 # (what was drawn before goes before the timestamp)
                q = __vk_ts_mark()
                s = __vk_ts_session
    __zone_gpu_q.push((q, s))

zone_end = ():
    if __zone_open.len() == 0: return
    id = __zone_open.pop()
    t0 = __zone_start.pop()
    if id >= 0: __zone_t[id] += time() - t0
    q = __zone_gpu_q.pop()
    when TARGET != "wasm":
        if q.0 >= 0:
            flush()
            __vk_ts_pair(id, q.0, q.1)

# f, timed as a zone
zone = (name: str, f: () -> void):
    zone(name)
    f()
    zone_end()

# (at the end of a frame: zones left open end, and the frame's times go into the history)
__zones_frame_end = (k: int):
    loop __zone_open.len() > 0: zone_end()
    loop id in [0..__zone_names.len()):
        __zone_hist[id * __STATS_N + k] = __zone_t[id]
        __zone_t[id] = 0.0
        __zone_gpu_hist[id * __STATS_N + k] = __zone_gpu_t[id]
        __zone_gpu_t[id] = 0.0
    __stats_gpu[k] = __stats_gpu_t
    __stats_gpu_t = 0.0

# a zone's average and longest time over the last n frames (gpu: on the GPU)
__zone_stat = (id: int, n: int, gpu: bool = false) -> (f64, f64):
    sum = 0.0
    most = 0.0
    loop j in [0..n):
        k = id * __STATS_N + (__stats_i - 1 - j) % __STATS_N
        t = __zone_hist[k]
        if gpu: t = __zone_gpu_hist[k]
        sum += t
        most = max(most, t)
    (sum / f64(max(n, 1)), most)

__stats_record = (cpu: f64):
    if not __stats_checked:
        __stats_checked = true
        mode = env("SLOPPY_STATS") ?? ""
        __stats_on = mode == "1"
        __stats_log = mode == "log"
    now = time()
    if __stats_interval.len() == 0:
        __stats_interval = fill(0.0, __STATS_N)
        __stats_cpu = fill(0.0, __STATS_N)
        __stats_present = fill(0.0, __STATS_N)
        __stats_gpu = fill(0.0, __STATS_N)
    if __stats_last >= 0.0:
        k = __stats_i % __STATS_N
        __stats_interval[k] = now - __stats_last
        __stats_cpu[k] = cpu
        __stats_present[k] = __last_present
        __zones_frame_end(k)
        __stats_i += 1
        if __stats_log and __stats_i > 1 and now - __stats_last > __stats_typical(min(__stats_i, __STATS_N)) * 1.5 + 0.001:
            eprint("long frame: {(now - __stats_last) * 1000.0:.1} ms (cpu {cpu * 1000.0:.1} ms, present {__last_present * 1000.0:.1} ms)")
        # (a summary every 2 seconds, of the frames since the last)
        if __stats_log and __stats_log_at < 0.0: __stats_log_at = now
        if __stats_log and now - __stats_log_at >= 2.0 and __stats_i > __stats_log_i:
            cnt = min(__stats_i - __stats_log_i, __STATS_N)
            st = __stats_summary(cnt)
            __stats_log_at = now
            __stats_log_i = __stats_i
            eprint("stats: {st.0}; {st.1}; {st.2}")
            if __zone_names.len() > 0:
                zs: str[]
                loop id in 0.. and nm in __zone_names:
                    g = ""
                    if __gpu_seen: g = " (gpu {__zone_stat(id, cnt, true).0 * 1000.0:.2})"
                    zs.push("{nm} {__zone_stat(id, cnt).0 * 1000.0:.2} ms{g}")
                eprint("zones: {zs.join(", ")}")
    __stats_last = now

# three lines about the last n frames (at most __STATS_N)
__stats_summary = (count: int) -> (str, str, str):
    n = min(min(count, __stats_i), __STATS_N)
    recent = min(n, 60)
    sum_i = 0.0
    sum_c = 0.0
    sum_p = 0.0
    sum_g = 0.0
    worst = 0.0
    loop j in [0..recent):
        k = (__stats_i - 1 - j) % __STATS_N
        sum_i += __stats_interval[k]
        sum_c += __stats_cpu[k]
        sum_p += __stats_present[k]
        sum_g += __stats_gpu[k]
    loop j in [0..n): worst = max(worst, __stats_interval[(__stats_i - 1 - j) % __STATS_N])
    avg = sum_i / f64(recent)
    typical = __stats_typical(n)
    long = 0
    loop j in [0..n):
        if __stats_interval[(__stats_i - 1 - j) % __STATS_N] > typical * 1.5 + 0.001: long += 1
    msec = (s: f64) -> str: "{s * 1000.0:.1}"
    ("{1.0 / max(avg, 0.0001):.0} fps   {msec(avg)} ms   (slowest {msec(worst)} ms)",
     "cpu {msec(sum_c / f64(recent))} ms   present {msec(sum_p / f64(recent))} ms" + (if __gpu_seen: "   gpu {msec(sum_g / f64(recent))} ms" else: ""),
     "long frames: {long} of the last {n}")

# the median of the last n frame intervals
__stats_typical = (n: int) -> f64:
    sorted: f64[]
    loop j in [0..n): sorted.push(__stats_interval[(__stats_i - 1 - j) % __STATS_N])
    sorted.sort()
    sorted[n / 2]

# (drawn over everything, in pixels)
__stats_draw = ():
    if not __stats_on or __stats_i == 0: return
    draw_to_screen()
    saved_proj = __proj
    saved_xform = __xform
    __proj = orthographic(0.0, f64(__win_w), f64(__win_h), 0.0, -1.0, 1.0)
    __xform = mat4()
    n = min(__stats_i, __STATS_N)
    st = __stats_summary(n)
    typical = __stats_typical(n)
    u = max(1.0, f64(__win_h) / 900.0)
    size = 15.0 * u
    gw = f64(__STATS_N) * 2.0 * u
    gh = 70.0 * u
    x0 = 10.0 * u
    y0 = 10.0 * u
    nz = __zone_names.len()
    zh = 0.0
    if nz > 0: zh = f64(nz) * size * 1.15 + 8.0 * u
    rect(x0 - 6.0 * u, y0 - 6.0 * u, gw + 12.0 * u, gh + 4.0 * size + 22.0 * u + zh, vec4(0, 0, 0, 0.65))
    white = vec4(1, 1, 1, 1)
    grey = vec4(0.75, 0.75, 0.8, 1)
    text(st.0, vec2(f32(x0), f32(y0)), size, white)
    text(st.1, vec2(f32(x0), f32(y0 + size * 1.2)), size, grey)
    text(st.2, vec2(f32(x0), f32(y0 + size * 2.4)), size, grey)
    text("{__win_w}x{__win_h}  {__present_how()}", vec2(f32(x0), f32(y0 + size * 3.6)), size, grey)
    # the graph: one bar per frame, newest at the right; lines at 1/60 and 1/30 s
    gy = y0 + size * 4.8 + 4.0 * u
    scale = gh / 0.05                      # 50 ms tall
    loop j in [0..n):
        k = (__stats_i - n + j) % __STATS_N
        t = __stats_interval[k]
        c = vec4(0.3, 0.85, 0.4, 1)
        if t > typical * 1.5 + 0.001: c = vec4(1.0, 0.3, 0.25, 1)
        else if t > 1.0 / 50.0: c = vec4(1.0, 0.8, 0.2, 1)
        bh = min(t * scale, gh)
        x = x0 + gw - f64(n - j) * 2.0 * u
        rect(x, gy + gh - bh, 2.0 * u, bh, c)
        cb = min(__stats_cpu[k] * scale, bh)
        rect(x, gy + gh - cb, 2.0 * u, cb, vec4(0.35, 0.55, 1.0, 1))
    loop t in [1.0 / 60.0, 1.0 / 30.0]:
        rect(x0, gy + gh - t * scale, gw, max(1.0, u), vec4(1, 1, 1, 0.35))
    # the zones: each one's average over the last 60 frames (a bar: of 1/60 s) and its longest
    zy = gy + gh + 8.0 * u
    zn = min(n, 60)
    loop id in 0.. and nm in __zone_names:
        avg, most = __zone_stat(id, zn)
        y = zy + f64(id) * size * 1.15
        ind = f64(__zone_depth[id]) * size
        text("{nm}", vec2(f32(x0 + ind), f32(y)), size, white)
        text("{avg * 1000.0:.2} ms  (most {most * 1000.0:.1})", vec2(f32(x0 + gw * 0.34), f32(y)), size, grey)
        if __gpu_seen:
            g = __zone_stat(id, zn, true).0
            text("gpu {g * 1000.0:.2}", vec2(f32(x0 + gw * 0.64), f32(y)), size, grey)
            rect(x0 + gw * 0.84, y + size * 0.55, min(g * 60.0, 1.0) * gw * 0.16, size * 0.3, vec4(0.95, 0.6, 0.25, 0.9))
            rect(x0 + gw * 0.84, y + size * 0.2, min(avg * 60.0, 1.0) * gw * 0.16, size * 0.3, vec4(0.35, 0.55, 1.0, 0.85))
        else: rect(x0 + gw * 0.76, y + size * 0.25, min(avg * 60.0, 1.0) * gw * 0.24, size * 0.6, vec4(0.35, 0.55, 1.0, 0.85))
    flush()
    __proj = saved_proj
    __xform = saved_xform

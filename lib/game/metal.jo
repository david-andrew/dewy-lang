        if mode == GL_LINES: return 1
        if mode == GL_LINE_STRIP: return 2
        if mode == GL_TRIANGLE_STRIP: return 4
        3

    __mg_class = (prim: int) -> int:
        if prim == 0: return 0
        if prim <= 2: return 1
        2

    # ---------------- draws ----------------
    # the constants of a draw (compiler/msl.jo's SlPC)
    struct __VgPush:
        params: int
        verts: int
        insts: int
        vstride: i32
        istride: i32
        flip: f32
        pad: f32

    # bind program p's pipeline and the state for a draw of the given GL mode; false when nothing

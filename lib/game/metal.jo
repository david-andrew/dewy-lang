# The GPU through Metal (macOS): what vk.jo and vkgl.jo are on Linux and Windows, under their
# names, so that gl.jo, gpu.jo, draw2d.jo, gpubuffer.jo and gpuarray.jo draw and compute the same
# way (`__vk` says the library uses the GPU's own API, here Metal). The shaders are compiler/msl.jo's
# translation, made with the same data model as the SPIR-V: one small block of constants per draw
# (the uniforms', vertices' and instances' addresses, strides, depth), and every texture in one
# argument buffer of (texture, sampler) entries, a Texture being its index.
#
# Memory comes from heaps (shared: buffers the CPU writes; private: textures), each made resident
# for every encoder with useHeap, since shaders reach buffers by address and textures through the
# argument buffer. Each frame records into a command buffer of its own; its data (uniforms, 2D
# vertices, staging copies) goes into upload blocks reused when the frame comes around again.
# Frames are drawn into an image of their own ("the screen", rows bottom first as in OpenGL), then
# drawn, turned over, into the window's drawable. Objective-C results the API autoreleases are
# retained inside a short autorelease pool (the game's loop has none).

when TARGET == "macos":
    @lib("/System/Library/Frameworks/Metal.framework/Metal")
    extern MTLCreateSystemDefaultDevice = () -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_ii = (o: *u8, s: *u8, a: int, b: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_iii = (o: *u8, s: *u8, a: int, b: int, c: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_iiii = (o: *u8, s: *u8, a: int, b: int, c: int, d: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_pi = (o: *u8, s: *u8, p: *u8, a: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_pii = (o: *u8, s: *u8, p: *u8, a: int, b: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_piii = (o: *u8, s: *u8, p: *u8, a: int, b: int, c: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_ppp = (o: *u8, s: *u8, a: *u8, b: *u8, c: *u8) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_ipi = (o: *u8, s: *u8, a: int, p: *u8, b: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_iiipii = (o: *u8, s: *u8, a: int, b: int, c: int, p: *u8, d: int, e: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_iipipi = (o: *u8, s: *u8, a: int, b: int, p: *u8, c: int, q: *u8, d: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_pipii = (o: *u8, s: *u8, p: *u8, a: int, q: *u8, b: int, c: int) -> *u8
    # (copyFromBuffer:sourceOffset:sourceBytesPerRow:sourceBytesPerImage:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:)
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_buf_to_tex = (o: *u8, s: *u8, buf: *u8, off: int, row: int, img: int, size: *u8, tex: *u8, slice: int, level: int, origin: *u8) -> *u8
    # (copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toBuffer:destinationOffset:destinationBytesPerRow:destinationBytesPerImage:)
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_tex_to_buf = (o: *u8, s: *u8, tex: *u8, slice: int, level: int, origin: *u8, size: *u8, buf: *u8, off: int, row: int, img: int) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_4d = (o: *u8, s: *u8, a: f64, b: f64, c: f64, d: f64) -> *u8
    @lib("/usr/lib/libobjc.A.dylib")
    @symbol("objc_msgSend")
    extern __mo_d = (o: *u8, s: *u8, a: f64) -> *u8

    # (the names vk.jo's callers use; most mean nothing here)
    const VK_MEM_DEVICE_LOCAL = 0x1
    const VK_MEM_HOST_VISIBLE = 0x2
    const VK_MEM_HOST_COHERENT = 0x4
    const VK_MEM_HOST_CACHED = 0x8
    const __VK_MAX_TEXTURES = 16384

    __vk = false                   # the library draws through Metal
    __vk_device_name = ""
    __vk_headless = false
    __vk_draw_count = false        # (no draw counts read from buffers)
    __vk_multi_draw = false
    __vk_subgroups = true
    __vk_ts_pool = 0               # (no GPU timestamps yet)
    __vk_ts_session = 0
    __vk_bar: u8[]
    __vk_bar_h = 0
    __vk_inst: *u8 = null

    # (opt-in while it is new: DEWY_METAL=1)
    __vk_wanted = () -> bool: (env("DEWY_METAL") ?? "") == "1"
    __vk_note = (msg: str):
        if (env("DEWY_VULKAN") ?? "") == "1" or (env("DEWY_METAL") ?? "") == "1": eprint("note: {msg}")
    __vk_ts_want = (): pass
    __vk_ts_mark = () -> int: 0
    __vk_ts_pair = (what: int, q0: int, session: int): pass

    __mg_dev: *u8 = null
    __mg_queue: *u8 = null
    __mg_layer: *u8 = null

    # retain an object the API autoreleased (inside the caller's pool)
    __mg_keep = (o: *u8) -> *u8:
        if o != null: __oc(o, __sel("retain"))
        o
    __mg_release = (o: *u8):
        if o != null: __oc(o, __sel("release"))

    __mg_err_text = (err: *u8) -> str:
        if err == null: return "unknown error"
        d = __oc(err, __sel("localizedDescription"))
        if d == null: return "unknown error"
        __cstr(__oc(d, __sel("UTF8String")))

    # set up Metal (the window's layer is made by cocoa.jo); "" or why not. surface_ext, make_surface:
    # as vk.jo's (no window: "")
    __vk_open = (surface_ext: str, make_surface: () -> int) -> str:
        if __mg_dev != null:
            __vk_headless = len(surface_ext) == 0
            return ""
        if dl_open("/System/Library/Frameworks/Metal.framework/Metal") == null: return "Metal is missing"
        dl_open("/System/Library/Frameworks/QuartzCore.framework/QuartzCore")
        pool = objc_autoreleasePoolPush()
        __mg_dev = MTLCreateSystemDefaultDevice()
        if __mg_dev == null:
            objc_autoreleasePoolPop(pool)
            return "no Metal device"
        # (Metal 3: buffers by address, textures by resource id in argument buffers)
        if (__oc_i(__mg_dev, __sel("supportsFamily:"), 5001) as int) & 255 == 0:
            objc_autoreleasePoolPop(pool)
            __mg_dev = null
            return "the Metal device lacks Metal 3"
        nm = __oc(__mg_dev, __sel("name"))
        if nm != null: __vk_device_name = __cstr(__oc(nm, __sel("UTF8String")))
        __mg_queue = __oc(__mg_dev, __sel("newCommandQueue"))
        objc_autoreleasePoolPop(pool)
        __vk_headless = len(surface_ext) == 0
        __mg_make_frames()
        __mg_make_textures()
        ""

    # ---------------- heaps ----------------
    struct __MgHeap:
        heap: *u8
        shared: bool

    __mg_heaps: __MgHeap[]
    const __MG_HEAP = 64 << 20

    __mg_new_heap = (size: int, shared: bool) -> int:
        pool = objc_autoreleasePoolPush()
        d = __oc(__oc(__cls("MTLHeapDescriptor"), __sel("alloc")), __sel("init"))
        __oc_i(d, __sel("setSize:"), size)
        # (shared: the CPU writes it; private: textures. Tracked: Metal orders the encoders that use it)
        mode = 2
        if shared: mode = 0
        __oc_i(d, __sel("setStorageMode:"), mode)
        __oc_i(d, __sel("setHazardTrackingMode:"), 2)
        h = __oc_p(__mg_dev, __sel("newHeapWithDescriptor:"), d)
        __mg_release(d)
        objc_autoreleasePoolPop(pool)
        if h == null: __environment_failure("Metal: a heap of {size >> 20} MB could not be made")
        __mg_heaps.push(__MgHeap(h, shared))
        __mg_heaps.len() - 1

    # a buffer of n bytes the CPU can write (and the GPU reach by address)
    __mg_buffer = (n: int) -> *u8:
        size = max(n, 16)
        loop h in __mg_heaps:
            if not h.shared: continue
            b = __mo_ii(h.heap, __sel("newBufferWithLength:options:"), size, 0)
            if b != null: return b
        k = __mg_new_heap(max(__MG_HEAP, size * 2), true)
        b = __mo_ii(__mg_heaps[k].heap, __sel("newBufferWithLength:options:"), size, 0)
        if b == null: __environment_failure("Metal: a buffer of {size} bytes could not be made")
        b

    # a private texture from a descriptor
    __mg_texture_of = (desc: *u8) -> *u8:
        loop h in __mg_heaps:
            if h.shared: continue
            t = __oc_p(h.heap, __sel("newTextureWithDescriptor:"), desc)
            if t != null: return t
        # (how much the texture needs, for the heap's size)
        sa = __oc_p(__mg_dev, __sel("heapTextureSizeAndAlignWithDescriptor:"), desc) as int
        k = __mg_new_heap(max(__MG_HEAP, sa * 2), false)
        t = __oc_p(__mg_heaps[k].heap, __sel("newTextureWithDescriptor:"), desc)
        if t == null: __environment_failure("Metal: a texture could not be made")
        t

    # every heap resident for what an encoder does
    __mg_use_heaps = (enc: *u8):
        loop h in __mg_heaps: __oc_p(enc, __sel("useHeap:"), h.heap)

    # ---------------- buffers (as vk.jo's) ----------------
    struct __VkBuffer:
        buffer: int                # the MTLBuffer
        mem: int
        size: int
        ptr: *u8                   # its contents (every buffer is the CPU's to write)
        addr: int                  # its GPU address

    __vk_buffer = (size: int, usage: u32, want: u32, like: u32) -> __VkBuffer:
        b = __mg_buffer(size)
        __VkBuffer(b as int, 0, size, __oc(b, __sel("contents")), __oc_int(b, __sel("gpuAddress")))

    __vk_free_buffer = (b: __VkBuffer):
        if b.buffer != 0: __mg_release(b.buffer as *u8)

    # ---------------- frames ----------------
    const __VK_FRAMES = 2
    struct __MgFrame:
        cb: *u8                    # the command buffer recorded (then committed), or null
        arena: int[]               # its upload blocks (indices into __vk_blocks), used in order
        block: int
        used: int
        dead: *u8[]                # objects to release once its commands have run

    __mg_frames: __MgFrame[]
    __vk_frame = 0
    __vk_recording = false

    __mg_make_frames = ():
        loop _ in [0..__VK_FRAMES): __mg_frames.push(__MgFrame())

    __vk_cb = () -> *u8: __mg_frames[__vk_frame].cb

    # start recording this frame's commands (after its previous use has finished)
    __vk_begin_frame = ():
        if __vk_recording: return
        f = __mg_frames[__vk_frame]
        if f.cb != null:
            __oc(f.cb, __sel("waitUntilCompleted"))
            __mg_release(f.cb)
        loop o in f.dead: __mg_release(o)
        __mg_frames[__vk_frame].dead.clear()
        # (texture slots the GPU is done with: free again, pointing at the white texture)
        if __vgt.len() > 0:
            loop sl in __mg_dead_slots[__vk_frame]:
                __mg_set_slot(sl, __vgt[0].tex, false, false)
                __vk_slot_free.push(sl)
        __mg_dead_slots[__vk_frame].clear()
        __mg_frames[__vk_frame].block = 0
        __mg_frames[__vk_frame].used = 0
        pool = objc_autoreleasePoolPush()
        __mg_frames[__vk_frame].cb = __mg_keep(__oc(__mg_queue, __sel("commandBuffer")))
        objc_autoreleasePoolPop(pool)
        __vk_recording = true
        __vk_resize_screen(__win_w, __win_h)

    # run what this frame has recorded so far and wait for it (for reading results back)
    __vk_submit_and_wait = ():
        __vg_end_pass()
        cb = __vk_cb()
        __oc(cb, __sel("commit"))
        __oc(cb, __sel("waitUntilCompleted"))
        __mg_release(cb)
        __mg_frames[__vk_frame].cb = null
        __vk_recording = false

    # release o once the GPU is done with what has been recorded
    __mg_defer = (o: *u8):
        if o == null: return
        f = __vk_frame
        if not __vk_recording: f = (__vk_frame + __VK_FRAMES - 1) % __VK_FRAMES
        __mg_frames[f].dead.push(o)

    __vk_defer_buffer = (b: __VkBuffer): __mg_defer(b.buffer as *u8)
    __vk_defer = (kind: int, a: int, b: int):
        if kind == 4:
            __mg_defer_slot(a)
            return
        __mg_defer(a as *u8)

    # ---------------- per-frame upload memory ----------------
    const __VK_BLOCK = 8 << 20
    __vk_blocks: __VkBuffer[]

    # room for n bytes (aligned to `align`) in this frame's upload memory: (block, offset)
    __vk_upload_room = (n: int, align: int) -> (int, int):
        __vk_begin_frame()
        fi = __vk_frame
        loop true:
            f = __mg_frames[fi]
            if f.block < f.arena.len():
                b = f.arena[f.block]
                off = (f.used + align - 1) / align * align
                if off + n <= __vk_blocks[b].size:
                    __mg_frames[fi].used = off + n
                    return (b, off)
                __mg_frames[fi].block += 1
                __mg_frames[fi].used = 0
                continue
            __vk_blocks.push(__vk_buffer(max(__VK_BLOCK, n), 0, 0, 0))
            __mg_frames[fi].arena.push(__vk_blocks.len() - 1)
        (0, 0)

    __vk_upload = (p: *u8, n: int, align: int = 16) -> (int, int):
        b, off = __vk_upload_room(max(n, 4), align)
        if n > 0: mem_copy(__vk_blocks[b].ptr + off, p, n)
        (b, off)

    __vk_addr = (b: int, off: int) -> int: __vk_blocks[b].addr + off

    # ---------------- textures and their slots ----------------
    # The argument buffer holds an entry per slot: the texture's and the sampler's resource ids. A
    # texture takes a new slot whenever its image or sampling changes; the old one is free again
    # once the frames that may use it have run, so draws already recorded keep what they had.
    struct __MgTex:
        tex: *u8
        live: bool
        linear: bool
        repeat: bool
        slot: int
        drawn: bool
        width: int
        height: int
        format: int                # MTLPixelFormat

    __vgt: __MgTex[]               # by GL name (0: white, 1x1, in slot 0)
    __vgt_free: int[]
    __vg_bound: int[] = fill(0, 16)
    __vg_unit = 0
    __mg_args: *u8 = null          # the argument buffer (an MTLBuffer)
    __mg_args_p: *u8 = null
    __mg_samplers: *u8[]           # nearest clamp, nearest repeat, linear clamp, linear repeat
    __vk_slot_free: int[]
    __vk_slot_next = 1

    __mg_make_textures = ():
        __mg_args = __mg_buffer(__VK_MAX_TEXTURES * 16)
        __mg_args_p = __oc(__mg_args, __sel("contents"))
        pool = objc_autoreleasePoolPush()
        loop linear in [0, 1]:
            loop rep in [0, 1]:
                d = __oc(__oc(__cls("MTLSamplerDescriptor"), __sel("alloc")), __sel("init"))
                __oc_i(d, __sel("setMinFilter:"), linear)
                __oc_i(d, __sel("setMagFilter:"), linear)
                mode = 0                                    # clamp to edge
                if rep == 1: mode = 2                       # repeat
                __oc_i(d, __sel("setSAddressMode:"), mode)
                __oc_i(d, __sel("setTAddressMode:"), mode)
                __oc_i(d, __sel("setSupportArgumentBuffers:"), 1)
                __mg_samplers.push(__oc_p(__mg_dev, __sel("newSamplerStateWithDescriptor:"), d))
                __mg_release(d)
        objc_autoreleasePoolPop(pool)
        __vg_init()

    __vg_init = ():
        if __vgt.len() > 0: return
        __vgt.push(__MgTex(live = true))
        __vgf.push(__MgFb())
        __vg_tex_alloc(0, 1, 1, 70)
        white: u8[] = [255, 255, 255, 255]
        __vg_tex_upload(0, 0, 0, 1, 1, data(white), 4)

    __vk_slot_new = () -> int:
        if __vk_slot_free.len() > 0: return __vk_slot_free.pop()
        if __vk_slot_next >= __VK_MAX_TEXTURES: __environment_failure("too many textures (at most {__VK_MAX_TEXTURES})")
        __vk_slot_next += 1
        __vk_slot_next - 1

    # point slot `slot` at texture t (sampled with the given filter and wrapping)
    __mg_set_slot = (slot: int, t: *u8, linear: bool, repeat: bool):
        k = 0
        if linear: k += 2
        if repeat: k += 1
        q = (__mg_args_p + slot * 16) as *int
        q[0] = __oc_int(t, __sel("gpuResourceID"))
        q[1] = __oc_int(__mg_samplers[k], __sel("gpuResourceID"))

    __mg_defer_slot = (slot: int):
        if slot <= 0: return
        f = __vk_frame
        if not __vk_recording: f = (__vk_frame + __VK_FRAMES - 1) % __VK_FRAMES
        __mg_dead_slots[f].push(slot)
    __mg_dead_slots: int[][] = [[], []]

    # texture t sampled from a new slot (the old one free once the GPU is done with it)
    __vg_tex_slot = (t: int):
        if t > 0 and (__vgt[t].slot == 0 or __vgt[t].drawn):
            __mg_defer_slot(__vgt[t].slot)
            __vgt[t].slot = __vk_slot_new()
            __vgt[t].drawn = false
        depth = __vgt[t].format == 252
        __mg_set_slot(__vgt[t].slot, __vgt[t].tex, __vgt[t].linear and not depth, __vgt[t].repeat)

    # the slot a draw samples texture t from (white for no texture)
    __vg_slot_of = (t: int) -> int:
        if t <= 0 or t >= __vgt.len() or __vgt[t].tex == null: return 0
        __vgt[t].drawn = true
        __vgt[t].slot

    # (re)make the image of texture t (format: an MTLPixelFormat)
    __vg_tex_alloc = (t: int, w: int, h: int, format: int):
        if __vgt[t].tex != null: __mg_defer(__vgt[t].tex)
        pool = objc_autoreleasePoolPush()
        d = __mo_iiii(__cls("MTLTextureDescriptor"), __sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), format, max(w, 1), max(h, 1), 0)
        __oc_i(d, __sel("setStorageMode:"), 2)
        __oc_i(d, __sel("setUsage:"), 1 | 4)                        # shader read, render target
        tex = __mg_texture_of(d)
        objc_autoreleasePoolPop(pool)
        __vgt[t].tex = tex
        __vgt[t].live = true
        __vgt[t].width = max(w, 1)
        __vgt[t].height = max(h, 1)
        __vgt[t].format = format
        __vg_tex_slot(t)

    __mg_bpp = (format: int) -> int:
        if format == 115: return 8
        if format == 124 or format == 125: return 16
        if format == 10: return 1
        4

    # copy pixels into part of texture t (rows bottom first, as OpenGL: the image keeps that order)
    __vg_tex_upload = (t: int, x: int, y: int, w: int, h: int, pixels: *u8, bpp: int):
        if pixels == null or w <= 0 or h <= 0: return
        n = w * h * bpp
        blk, off = __vk_upload(pixels, n, 256)
        enc = __mg_blit()
        size: int[] = [w, h, 1]
        origin: int[] = [x, y, 0]
        __mo_buf_to_tex(enc, __sel("copyFromBuffer:sourceOffset:sourceBytesPerRow:sourceBytesPerImage:sourceSize:toTexture:destinationSlice:destinationLevel:destinationOrigin:"),
            __vk_blocks[blk].buffer as *u8, off, w * bpp, n, data(size) as *u8, __vgt[t].tex, 0, 0, data(origin) as *u8)
        __mg_end_blit(enc)

    # ---------------- framebuffers ----------------
    struct __MgFb:
        color: int                 # texture names (0: none)
        depth: int

    __vgf: __MgFb[]                # by GL name (0: the screen)
    __vg_fb = 0
    __vg_rb = 0

    # the screen: what a frame is drawn into before it is shown
    __mg_screen: *u8 = null
    __mg_screen_depth: *u8 = null
    __mg_screen_w = 0
    __mg_screen_h = 0

    __vk_resize_screen = (w: int, h: int):
        if __mg_screen != null and __mg_screen_w == max(w, 1) and __mg_screen_h == max(h, 1): return
        __mg_defer(__mg_screen)
        __mg_defer(__mg_screen_depth)
        __mg_screen_w = max(w, 1)
        __mg_screen_h = max(h, 1)
        pool = objc_autoreleasePoolPush()
        d = __mo_iiii(__cls("MTLTextureDescriptor"), __sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), 70, __mg_screen_w, __mg_screen_h, 0)
        __oc_i(d, __sel("setStorageMode:"), 2)
        __oc_i(d, __sel("setUsage:"), 1 | 4)
        __mg_screen = __mg_texture_of(d)
        dd = __mo_iiii(__cls("MTLTextureDescriptor"), __sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), 252, __mg_screen_w, __mg_screen_h, 0)
        __oc_i(dd, __sel("setStorageMode:"), 2)
        __oc_i(dd, __sel("setUsage:"), 1 | 4)
        __mg_screen_depth = __mg_texture_of(dd)
        objc_autoreleasePoolPop(pool)

    __vg_fb_size = (f: int) -> (int, int):
        if f == 0: return (__mg_screen_w, __mg_screen_h)
        c = __vgf[f].color
        if c > 0: return (__vgt[c].width, __vgt[c].height)
        d = __vgf[f].depth
        if d > 0: return (__vgt[d].width, __vgt[d].height)
        (1, 1)

    # the pixel formats of framebuffer f's attachments (0: none)
    __vg_fb_formats = (f: int) -> (int, int):
        if f == 0: return (70, 252)
        cf = 0
        df = 0
        if __vgf[f].color > 0: cf = __vgt[__vgf[f].color].format
        if __vgf[f].depth > 0: df = __vgt[__vgf[f].depth].format
        (cf, df)

    __mg_fb_textures = (f: int) -> (*u8, *u8):
        if f == 0: return (__mg_screen, __mg_screen_depth)
        c: *u8 = null
        d: *u8 = null
        if __vgf[f].color > 0: c = __vgt[__vgf[f].color].tex
        if __vgf[f].depth > 0: d = __vgt[__vgf[f].depth].tex
        (c, d)

    # ---------------- passes ----------------
    __vg_pass = -1                 # the framebuffer being rendered, or -1
    __mg_enc: *u8 = null           # its render encoder
    __vg_pipeline: *u8 = null
    __mg_depth_state: *u8 = null
    # a clear asked for and not yet done: the next pass on that framebuffer starts with it
    __mg_clear_fb = -1
    __mg_clear_color = false
    __mg_clear_depth = false

    __vg_end_pass = ():
        if __vg_pass < 0: return
        __oc(__mg_enc, __sel("endEncoding"))
        __mg_release(__mg_enc)
        __mg_enc = null
        __vg_pass = -1

    __vg_begin_pass = ():
        __vk_begin_frame()
        if __vg_pass == __vg_fb and __mg_clear_fb != __vg_fb: return
        __vg_end_pass()

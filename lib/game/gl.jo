    # the GL entry points: the driver, or the software renderer (softgl.jo) when there is none
    glClearColor = (r: f32, g: f32, b: f32, a: f32):
        if __vk:
            vgl_clear_color(r, g, b, a)
            return
        if __soft:
            sgl_clear_color(r, g, b, a)
            return
        __glClearColor(r, g, b, a)
    glClear = (mask: u32):
        if __vk:
            vgl_clear(mask)
            return
        if __soft:
            sgl_clear(mask)
            return
        __glClear(mask)
    glViewport = (x: i32, y: i32, w: i32, h: i32):
        if __vk:
            vgl_viewport(x, y, w, h)
            return
        if __soft:
            sgl_viewport(x, y, w, h)
            return
        __glViewport(x, y, w, h)
    glScissor = (x: i32, y: i32, w: i32, h: i32):
        if __vk:
            vgl_scissor(x, y, w, h)
            return
        if __soft:
            sgl_scissor(x, y, w, h)
            return
        __glScissor(x, y, w, h)
    glEnable = (cap: u32):
        if __vk:
            vgl_enable(cap, true)
            return
        if __soft:
            sgl_enable(cap, true)
            return
        __glEnable(cap)
    glDisable = (cap: u32):
        if __vk:
            vgl_enable(cap, false)
            return
        if __soft:
            sgl_enable(cap, false)
            return
        __glDisable(cap)
    glBlendFunc = (s: u32, d: u32):
        if __vk:
            vgl_blend_func(s, d, s, d)
            return
        if __soft:
            sgl_blend_func(s, d, s, d)
            return
        __glBlendFunc(s, d)
    glBlendFuncSeparate = (s: u32, d: u32, sa: u32, da: u32):
        if __vk:
            vgl_blend_func(s, d, sa, da)
            return
        if __soft:
            sgl_blend_func(s, d, sa, da)
            return
        __glBlendFuncSeparate(s, d, sa, da)

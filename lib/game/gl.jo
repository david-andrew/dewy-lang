    __gl_shader = (kind: int, src0: str) -> int:
        if __vk: return 0
        src = src0
        s = __glCreateShader(u32(kind))
        # (macOS's OpenGL 4.1 takes desktop GLSL, which has what GLSL ES 3.00 has)
        when TARGET == "macos":
            if starts_with(src, "#version 300 es"): src = "#version 410 core" + src[15..]
        p = data(src)
        n = i32(len(src))
        __glShaderSource(s, 1, &p, &n)
        __glCompileShader(s)
        ok: i32 = 0
        __glGetShaderiv(s, GL_COMPILE_STATUS, &ok)
        if ok == 0:
            buf = __alloc(4096)
            ln: i32 = 0
            __glGetShaderInfoLog(s, 4095, &ln, buf)
            eprint("shader compile error:\n{__cstr(buf)}\n--- source ---\n{src}")
            __environment_failure("shader compilation failed")
        int(s)

    gl_create_program = (vs: str, fs: str) -> int:

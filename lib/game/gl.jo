    __screen_w = 0
    __screen_h = 0

    # (re)size the offscreen stand-in for the window's framebuffer
    __gl_screen_resize = (w: int, h: int):
        if __vk: return
        if __screen_fbo != 0 and __screen_w == w and __screen_h == h: return
        if __screen_fbo == 0:
            id: u32 = 0
            __glGenFramebuffers(1, &id)
            __screen_fbo = int(id)
            __glGenRenderbuffers(2, data(__screen_rb))
        __glBindRenderbuffer(GL_RENDERBUFFER, __screen_rb[0])
        __glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, i32(w), i32(h))
        __glBindRenderbuffer(GL_RENDERBUFFER, __screen_rb[1])
        __glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, i32(w), i32(h))
        __glBindFramebuffer(GL_FRAMEBUFFER, u32(__screen_fbo))
        __glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, __screen_rb[0])
        __glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, __screen_rb[1])
        __screen_w = w
        __screen_h = h

    # copy the offscreen framebuffer into 32-bit BGRX pixels, top row first
    __screen_tmp: u8[]

        __glReadPixels(0, 0, i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, data(__screen_tmp))
        src = data(__screen_tmp)
        parallel_range(h, (r: int):
            s = src + (h - 1 - r) * w * 4
            d = out + r * w * 4
            loop k in [0..w):
                d[k * 4] = s[k * 4 + 2]
                d[k * 4 + 1] = s[k * 4 + 1]
                d[k * 4 + 2] = s[k * 4]
                d[k * 4 + 3] = 255
        )

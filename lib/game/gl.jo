    extern glCreateFramebuffer = () -> u32
    extern glDeleteFramebuffer = (f: u32)
    extern glBindFramebuffer = (target: u32, f: u32)
    extern glFramebufferTexture2D = (target: u32, attachment: u32, textarget: u32, tex: u32, level: i32)
    extern glCreateRenderbuffer = () -> u32
    extern glDeleteRenderbuffer = (r: u32)
    extern glBindRenderbuffer = (target: u32, r: u32)
    extern glRenderbufferStorage = (target: u32, format: u32, w: i32, h: i32)
    extern glFramebufferRenderbuffer = (target: u32, attachment: u32, rbtarget: u32, rb: u32)
    extern glCheckFramebufferStatus = (target: u32) -> u32
    extern glReadPixels = (x: i32, y: i32, w: i32, h: i32, format: u32, ty: u32, data: *u8, size: i32)

    gl_create_buffer = () -> int: int(glCreateBuffer())
    gl_delete_buffer = (b: int): glDeleteBuffer(u32(b))
    gl_create_vertex_array = () -> int: int(glCreateVertexArray())
    gl_delete_vertex_array = (v: int): glDeleteVertexArray(u32(v))
    gl_create_texture = () -> int: int(glCreateTexture())
    gl_delete_texture = (t: int): glDeleteTexture(u32(t))
    gl_create_framebuffer = () -> int: int(glCreateFramebuffer())
    gl_delete_framebuffer = (f: int): glDeleteFramebuffer(u32(f))
    gl_create_renderbuffer = () -> int: int(glCreateRenderbuffer())
    gl_delete_renderbuffer = (r: int): glDeleteRenderbuffer(u32(r))
    gl_create_program = (vs: str, fs: str) -> int: int(glCreateProgramFrom(data(vs), i32(len(vs)), data(fs), i32(len(fs))))
    gl_uniform_location = (p: int, name: str) -> int: int(glGetUniformLocationStr(u32(p), data(name), i32(len(name))))
    gl_tex_image = (w: int, h: int, internal: int, format: int, ty: int, pixels: *u8, size: int):
        glTexImage2D(GL_TEXTURE_2D, 0, i32(internal), i32(w), i32(h), 0, u32(format), u32(ty), pixels, i32(size))
    gl_tex_sub_image = (x: int, y: int, w: int, h: int, format: int, ty: int, pixels: *u8, size: int):
        glTexSubImage2D(GL_TEXTURE_2D, 0, i32(x), i32(y), i32(w), i32(h), u32(format), u32(ty), pixels, i32(size))
    gl_read_pixels = (x: int, y: int, w: int, h: int, out: *u8):
        glReadPixels(i32(x), i32(y), i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, out, i32(w * h * 4))
    # RGBA f32 pixels of a float render target
    gl_read_pixels_f32 = (x: int, y: int, w: int, h: int, out: *u8):
        glReadPixels(i32(x), i32(y), i32(w), i32(h), GL_RGBA, GL_FLOAT, out, i32(w * h * 16))
    extern glUniform4i = (loc: i32, x: i32, y: i32, z: i32, w: i32)
    gl_uniform4i = (loc: int, x: int, y: int, z: int, w: int): glUniform4i(i32(loc), i32(x), i32(y), i32(z), i32(w))
    extern glGetMaxTextureSize = () -> i32
    gl_max_texture_size = () -> int: int(glGetMaxTextureSize())
    # RGBA i32 pixels of an integer render target
    gl_read_pixels_i32 = (x: int, y: int, w: int, h: int, out: *u8):
        glReadPixels(i32(x), i32(y), i32(w), i32(h), 0x8D99, 0x1404, out, i32(w * h * 16))

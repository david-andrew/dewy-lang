# Remainders and rounding with an explicit rule. `%` is the floored remainder;
# `mod(a b kind='euclid')` names another. Floats round to nearest with ties to
# even (IEEE 754); `round(x ties='away')` names another tie rule. The compiler
# routes a Dewy `mod` of integers, and `round` of a float, here.

# floor: the divisor's sign (`%`); trunc: the dividend's (C's); euclid: never negative
ModKind:type='floor'|'trunc'|'euclid'
# Where a value exactly halfway between two integers goes: away from zero, to
# the even one, toward zero, up (toward +infinity) or down (toward -infinity).
Ties:type='away'|'even'|'zero'|'up'|'down'

mod = ((a:int64 b:int64<d => d not=? 0> kind:ModKind='floor'):>int64=>{
        let r=a % b
        if kind =? 'trunc' and r not=? 0 and (r <? 0) not=? (a <? 0) return r-b
        if kind =? 'euclid' and r <? 0 return r-b
        return r
    })
    & ((a:int b:int<d => d not=? 0> kind:ModKind='floor'):>int=>{
        let r=a % b
        if kind =? 'trunc' and r not=? 0 and (r <? 0) not=? (a <? 0) return r-b
        if kind =? 'euclid' and r <? 0 return r-b
        return r
    })

# (finite and below 2^52 in magnitude: every larger float is already whole)
round = ((x:float64 ties:Ties='even'):>float64=>{
        if not (x >? -4503599627370496.0 and x <? 4503599627370496.0) return x
        let low=floor(x)
        let part=x-low
        let up=part >? 0.5
        if part =? 0.5 {
            up=match ties {
                <'even'>=>floor(low*0.5)*2.0 not=? low
                <'away'>=>x >? 0.0
                <'zero'>=>x <? 0.0
                <'up'>=>true
                <'down'>=>false
            }
        }
        let result=if up low+1.0 else low
        # (a zero keeps the sign of x: round(-0.25) is -0.0)
        if result =? 0.0 return x*0.0
        return result
    })
    & ((x:float32 ties:Ties='even'):>float32=>float32(round(float64(x) ties)))

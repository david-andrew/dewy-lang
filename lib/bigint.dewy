# Exact integers, using ordinary owned arrays on the compact runtime.
# Magnitude arithmetic is adapted from the pre-restart library/bigint.dewy.
# Limbs are little-endian base 2^32, held in uint64 words for full products.
# The representation is internal: construct through bigint / _parse_big.
BigInt:type=[_sign:int64=0 _limbs:array<uint64>=[]]
const _LIMB_BASE:uint64=4294967296
const _LIMB_MASK:uint64=4294967295

let _bigint_trim = (@limbs:array<uint64>):>void => {
    loop limbs.length >? 0 and limbs[limbs.length - 1] =? 0 {
        limbs.pop()
    }
}

let _mag_compare = (a:array<uint64> b:array<uint64>):>int64 => {
    if a.length >? b.length { return 1 }
    if a.length <? b.length { return -1 }
    let i:int64 = a.length
    loop i >? 0 {
        i = i - 1
        if a[i] >? b[i] { return 1 }
        if a[i] <? b[i] { return -1 }
    }
    return 0
}


let _mag_add = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    let result:array<uint64> = []
    let carry:uint64 = 0
    let i:int64 = 0
    loop i <? a.length or i <? b.length {
        let sum:uint64 = carry
        if i <? a.length { sum = sum + a[i] }
        if i <? b.length { sum = sum + b[i] }
        result.push(sum and _LIMB_MASK)
        carry = sum >> 32
        i = i + 1
    }
    if carry not=? 0 { result.push(carry) }
    return result
}

let _mag_sub = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    let result:array<uint64> = []
    let borrow:uint64 = 0
    let i:int64 = 0
    loop i <? a.length {
        let top:uint64 = a[i] + _LIMB_BASE
        let subtract:uint64 = borrow
        if i <? b.length { subtract = subtract + b[i] }
        let diff:uint64 = top - subtract
        result.push(diff and _LIMB_MASK)
        borrow = 1 - (diff >> 32)
        i = i + 1
    }
    _bigint_trim(@result)
    return result
}


let _mag_mul_school = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    let result:array<uint64> = []
    let n:int64 = 0
    loop n <? a.length + b.length { result.push(0)  n = n + 1 }
    let i:int64 = 0
    loop i <? a.length {
        let carry:uint64 = 0
        let ai:uint64 = a[i]
        loop j in [0..b.length) {
            let k:int64 = i + j
            let t:uint64 = ai * b[j] + result[k] + carry
            result[k] = t and _LIMB_MASK
            carry = t >> 32
        }
        # Earlier rows stop before this slot, so it is still zero.
        result[i + b.length] = carry
        i = i + 1
    }
    _bigint_trim(@result)
    return result
}

let _mag_shift_left = (limbs:array<uint64> bits:int64):>array<uint64> => {
    if limbs.length =? 0 { return [] }
    let limb_shift:int64 = bits // 32
    let bit_shift:uint64 = uint64<overflow='wrap'>(bits % 32)
    let result:array<uint64> = []
    let n:int64 = 0
    loop n <? limb_shift { result.push(0)  n = n + 1 }
    let carry:uint64 = 0
    let i:int64 = 0
    loop i <? limbs.length {
        let t:uint64 = (limbs[i] << bit_shift) or carry
        result.push(t and _LIMB_MASK)
        carry = t >> 32
        i = i + 1
    }
    if carry not=? 0 { result.push(carry) }
    return result
}


let _mag_shift_right = (limbs:array<uint64> bits:int64):>array<uint64> => {
    let limb_shift:int64 = bits // 32
    let bit_shift:uint64 = uint64<overflow='wrap'>(bits % 32)
    let result:array<uint64> = []
    let i:int64 = limb_shift
    loop i <? limbs.length {
        let value:uint64 = limbs[i] >> bit_shift
        let next:int64 = i + 1
        if next <? limbs.length {
            if bit_shift not=? 0 { value = value or ((limbs[next] << (32 - bit_shift)) and _LIMB_MASK) }
        }
        result.push(value)
        i = i + 1
    }
    _bigint_trim(@result)
    return result
}

let _mag_trailing_zeros = (limbs:array<uint64>):>int64 => {
    let count:int64 = 0
    let i:int64 = 0
    loop i <? limbs.length {
        let limb:uint64 = limbs[i]
        if limb =? 0 {
            count = count + 32
        } else {
            loop (limb and 1) =? 0 {
                limb = limb >> 1
                count = count + 1
            }
            return count
        }
        i = i + 1
    }
    return 0
}

let _limb_leading_zeros = (limb:uint64):>int64 => {
    let count:int64 = 0
    loop (limb and 2147483648) =? 0 and count <? 32 {
        limb = limb << 1
        count = count + 1
    }
    return count
}

let _MagDivMod:type = [quotient:array<uint64> remainder:array<uint64>]

let _mag_divmod_limb = (a:array<uint64> divisor:uint64):>_MagDivMod => {
    let quotient:array<uint64> = []
    let n:int64 = 0
    loop n <? a.length { quotient.push(0)  n = n + 1 }
    let remainder:uint64 = 0
    let i:int64 = a.length
    loop i >? 0 {
        i = i - 1
        let value:uint64 = (remainder << 32) or a[i]
        quotient[i] = value // divisor
        remainder = value % divisor
    }
    _bigint_trim(@quotient)
    if remainder =? 0 { return [quotient = quotient remainder = []] }
    return [quotient = quotient remainder = [remainder]]
}


let _mag_mod_limb = (a:array<uint64> divisor:uint64):>uint64 => {
    let remainder:uint64 = 0
    let i:int64 = a.length
    loop i >? 0 {
        i = i - 1
        remainder = ((remainder << 32) or a[i]) % divisor
    }
    return remainder
}

# Knuth Algorithm D. Inputs are canonical and b is nonzero; normalization
# leaves its top limb in [2^31, 2^32), and u gets one extra leading limb.
let _mag_divmod = (a:array<uint64> b:array<uint64>):>_MagDivMod => {
    if _mag_compare(a b) <? 0 { return [quotient = [] remainder = a] }
    if b.length =? 1 { return _mag_divmod_limb(a b[0]) }
    let shift:int64 = _limb_leading_zeros(b[b.length - 1])
    let v:array<uint64> = _mag_shift_left(b shift)
    let u:array<uint64> = _mag_shift_left(a shift)
    loop u.length <? a.length + 1 { u.push(0) }
    let n:int64 = v.length
    let m:int64 = u.length - n - 1
    let quotient:array<uint64> = []
    let k:int64 = 0
    loop k <=? m { quotient.push(0)  k = k + 1 }
    let v_top:uint64 = v[n - 1]
    let v_next:uint64 = v[n - 2]
    let j:int64 = m
    loop j >=? 0 {
        # Estimate from the top two remainder limbs over the top divisor limb.
        let top:int64 = j + n
        let numerator:uint64 = (u[top] << 32) or u[top - 1]
        let qhat:uint64 = numerator // v_top
        let rhat:uint64 = numerator % v_top
        loop qhat >=? _LIMB_BASE or qhat * v_next >? ((rhat << 32) or u[top - 2]) {
            qhat = qhat - 1
            rhat = rhat + v_top
            if rhat >=? _LIMB_BASE { break }
        }
        # Multiply and subtract qhat * v from u[j .. j + n].
        let borrow:uint64 = 0
        let carry:uint64 = 0
        let i:int64 = 0
        loop i <? n {
            let at:int64 = i + j
            let product:uint64 = qhat * v[i] + carry
            carry = product >> 32
            let difference:uint64 = u[at] + _LIMB_BASE - (product and _LIMB_MASK) - borrow
            u[at] = difference and _LIMB_MASK
            borrow = 1 - (difference >> 32)
            i = i + 1
        }
        let difference:uint64 = u[top] + _LIMB_BASE - carry - borrow
        u[top] = difference and _LIMB_MASK
        borrow = 1 - (difference >> 32)
        if borrow not=? 0 {
            # The estimate was one too big: add the divisor back.
            qhat = qhat - 1
            let add_carry:uint64 = 0
            i = 0
            loop i <? n {
                let at:int64 = i + j
                let t:uint64 = u[at] + v[i] + add_carry
                u[at] = t and _LIMB_MASK
                add_carry = t >> 32
                i = i + 1
            }
            u[top] = (u[top] + add_carry) and _LIMB_MASK
        }
        quotient[j] = qhat
        j = j - 1
    }
    _bigint_trim(@quotient)
    let remainder:array<uint64> = []
    let low:int64 = 0
    loop low <? n {
        remainder.push(u[low])
        low = low + 1
    }
    return [quotient = quotient remainder = _mag_shift_right(remainder shift)]
}

let _limb_gcd = (a:uint64 b:uint64):>uint64 => {
    loop b not=? 0 {
        let t:uint64 = a % b
        a = b
        b = t
    }
    return a
}


let _mag_gcd = (a:array<uint64> b:array<uint64>):>array<uint64> => {
    if a.length =? 0 { return b }
    if b.length =? 0 { return a }
    if a.length =? 1 {
        let limb:uint64 = a[0]
        return [_limb_gcd(limb _mag_mod_limb(b limb))]
    }
    if b.length =? 1 {
        let limb:uint64 = b[0]
        return [_limb_gcd(limb _mag_mod_limb(a limb))]
    }
    let zeros_a:int64 = _mag_trailing_zeros(a)
    let zeros_b:int64 = _mag_trailing_zeros(b)
    let common:int64 = zeros_a
    if zeros_b <? common { common = zeros_b }
    let x:array<uint64> = _mag_shift_right(a zeros_a)
    let y:array<uint64> = _mag_shift_right(b zeros_b)
    loop y.length >? 0 {
        # both odd: the difference of the larger and the smaller is even
        if _mag_compare(x y) >? 0 {
            x = _mag_sub(x y)
            x = _mag_shift_right(x _mag_trailing_zeros(x))
        } else {
            y = _mag_sub(y x)
            if y.length >? 0 { y = _mag_shift_right(y _mag_trailing_zeros(y)) }
        }
    }
    return _mag_shift_left(x common)
}

# ---------------- subquadratic multiplication and text conversion ----------------
# Karatsuba above _KARATSUBA limbs; decimal text both ways by divide and conquer over a tree
# of powers 10^(9*2^j) (base-10^9 chunks), with Barrett division by each power's reciprocal
# (one Newton step from the reciprocal of its upper half). O(M(n) log n) instead of O(n^2).
const _KARATSUBA:int64=96
const _CONVERT_BASE:int64=600       # (limbs: below it, the schoolbook conversions)

# a[lo..hi) as a magnitude
_mag_slice=(a:array<uint64> lo:int64 hi:int64):>array<uint64>=>{
    let result:array<uint64>=[]
    let stop=hi
    if stop >? a.length stop=a.length
    let i=lo
    loop i <? stop {
        result.push(a[i])
        i=i+1
    }
    _bigint_trim(@result)
    return result
}

# acc += x * 2^(32 shift)
_mag_add_into=(@acc:array<uint64> x:array<uint64> shift:int64):>void=>{
    loop acc.length <? shift+x.length acc.push(0)
    let carry:uint64=0
    let i:int64=0
    loop i <? x.length {
        let t=acc[shift+i]+x[i]+carry
        acc[shift+i]=t and _LIMB_MASK
        carry=t >> 32
        i=i+1
    }
    let k=shift+x.length
    loop carry not=? 0 {
        if k =? acc.length acc.push(0)
        let t=acc[k]+carry
        acc[k]=t and _LIMB_MASK
        carry=t >> 32
        k=k+1
    }
}

_mag_mul=(a:array<uint64> b:array<uint64>):>array<uint64>=>{
    if a.length <? b.length return _mag_mul(b a)
    if b.length <? _KARATSUBA return _mag_mul_school(a b)
    let result:array<uint64>=[]
    if a.length >=? 2*b.length {
        # (unbalanced: the longer cut into pieces as long as the shorter)
        let lo:int64=0
        loop lo <? a.length {
            let piece=_mag_slice(a lo lo+b.length)
            if piece.length >? 0 _mag_add_into(@result _mag_mul(piece b) lo)
            lo=lo+b.length
        }
        _bigint_trim(@result)
        return result
    }
    let m=a.length//2
    let a0=_mag_slice(a 0 m)
    let a1=_mag_slice(a m a.length)
    let b0=_mag_slice(b 0 m)
    let b1=_mag_slice(b m b.length)
    let z0=_mag_mul(a0 b0)
    let z2=_mag_mul(a1 b1)
    let z1=_mag_sub(_mag_sub(_mag_mul(_mag_add(a0 a1) _mag_add(b0 b1)) z0) z2)
    _mag_add_into(@result z0 0)
    _mag_add_into(@result z1 m)
    _mag_add_into(@result z2 2*m)
    _bigint_trim(@result)
    return result
}

# 2^(32 n)
_mag_limb_power=(n:int64):>array<uint64>=>{
    let result:array<uint64>=[]
    loop result.length <? n result.push(0)
    result.push(1)
    return result
}

# floor(x / 2^(32 n))
_mag_drop=(x:array<uint64> n:int64):>array<uint64>=>_mag_slice(x n x.length)

# floor(2^(64 m) / p), m = p's length
_mag_reciprocal=(p:array<uint64>):>array<uint64>=>{
    let m=p.length
    let whole=_mag_limb_power(2*m)
    if m <=? 2*_KARATSUBA return _mag_divmod(whole p).quotient
    # (p's upper h limbs' reciprocal, scaled, is right to about h limbs; one Newton step
    # doubles that, past m + 3, and the rest is a few corrections)
    let h=m//2+2
    let x=_mag_reciprocal(_mag_slice(p m-h m))
    let scaled:array<uint64>=[]
    _mag_add_into(@scaled x m-h)
    x=scaled
    let px=_mag_mul(p x)
    # (Newton: x + x (2^(64 m) - p x) / 2^(64 m), the product from the upper t limbs of each
    # factor: what the rest adds is below 1)
    let below=_mag_compare(px whole) <=? 0
    let e=if below _mag_sub(whole px) else _mag_sub(px whole)
    let t=m//2+4
    let se=if e.length >? t e.length-t else 0
    let sx=if x.length >? t x.length-t else 0
    let step=_mag_drop(_mag_mul(_mag_drop(x sx) _mag_drop(e se)) 2*m-se-sx)
    if below {
        x=_mag_add(x step)
    } else {
        let over=_mag_add(step [1])
        x=if _mag_compare(over x) >=? 0 [] else _mag_sub(x over)
    }
    px=_mag_mul(p x)
    loop _mag_compare(px whole) >? 0 {
        x=_mag_sub(x [1])
        px=_mag_sub(px p)
    }
    let rest=_mag_sub(whole px)
    loop _mag_compare(rest p) >=? 0 {
        x=_mag_add(x [1])
        rest=_mag_sub(rest p)
    }
    return x
}

# x divided by p (x < 2^(64 m), m = p's length), mu = _mag_reciprocal(p): Barrett, whose
# estimate is at most two short
_mag_divmod_by=(x:array<uint64> p:array<uint64> mu:array<uint64>):>_MagDivMod=>{
    if _mag_compare(x p) <? 0 return [quotient=[] remainder=x]
    let m=p.length
    let q=_mag_drop(_mag_mul(_mag_drop(x m-1) mu) m+1)
    let r=_mag_sub(x _mag_mul(q p))
    loop _mag_compare(r p) >=? 0 {
        r=_mag_sub(r p)
        q=_mag_add(q [1])
    }
    return [quotient=q remainder=r]
}

_ConvertTree:type=[powers:array<array<uint64>> reciprocals:array<array<uint64>>]

# 10^(9*2^j) for j below k, and the reciprocals of the long ones
_convert_tree=(k:int64 reciprocals:bool):>_ConvertTree=>{
    let powers:array<array<uint64>>=[[1000000000]]
    loop powers.length <? k {
        let last=powers[powers.length-1]
        powers.push(_mag_mul(last last))
    }
    let mus:array<array<uint64>>=[]
    loop j in [0..k) {
        if reciprocals and powers[j].length >? _CONVERT_BASE mus.push(_mag_reciprocal(powers[j]))
        else mus.push([])
    }
    return [powers=powers reciprocals=mus]
}

# x's 2^k base-10^9 chunks, least significant first (x < 10^(9*2^k)), pushed onto out
_mag_chunks_into=(@out:array<uint64> x:array<uint64> k:int64 tree:_ConvertTree):>void=>{
    if x.length <=? _CONVERT_BASE {
        let chunks=_bigint_decimal_chunks(x)
        let want:int64=1 << k
        loop i in [0..want) out.push(if i <? chunks.length chunks[i] else 0)
        return
    }
    let p=tree.powers[k-1]
    let parts=if tree.reciprocals[k-1].length >? 0 _mag_divmod_by(x p tree.reciprocals[k-1]) else _mag_divmod(x p)
    _mag_chunks_into(@out parts.remainder k-1 tree)
    _mag_chunks_into(@out parts.quotient k-1 tree)
}

# a magnitude's base-10^9 chunks, least significant first, the most significant not zero
_mag_decimal_chunks=(limbs:array<uint64>):>array<uint64>=>{
    if limbs.length <=? _CONVERT_BASE return _bigint_decimal_chunks(limbs)
    # (the smallest k whose 10^(9*2^k) is above the value)
    let k:int64=0
    let bits=limbs.length*32
    loop (1 << k)*29 <? bits k=k+1       # (10^9 > 2^29.89: 2^k chunks hold 29*2^k bits)
    let tree=_convert_tree(k true)
    let out:array<uint64>=[]
    _mag_chunks_into(@out limbs k tree)
    loop out.length >? 1 and out[out.length-1] =? 0 out.pop()
    return out
}

# the magnitude of base-10^9 chunks[lo..lo+2^k) (least significant first; past the end: zeros)
_mag_from_chunks=(chunks:array<uint64> lo:int64 k:int64 tree:_ConvertTree):>array<uint64>=>{
    if lo >=? chunks.length return []
    let count:int64=1 << k
    if k <=? 4 {
        let limbs:array<uint64>=[]
        let i=lo+count
        if i >? chunks.length i=chunks.length
        loop i >? lo {
            i=i-1
            let carry:uint64=chunks[i]
            loop j in [0..limbs.length) {
                let value=limbs[j]*1000000000+carry
                limbs[j]=value and _LIMB_MASK
                carry=value >> 32
            }
            if carry not=? 0 limbs.push(carry)
        }
        _bigint_trim(@limbs)
        return limbs
    }
    let low=_mag_from_chunks(chunks lo k-1 tree)
    let high=_mag_from_chunks(chunks lo+count//2 k-1 tree)
    if high.length =? 0 return low
    return _mag_add(_mag_mul(high tree.powers[k-1]) low)
}

# decimal digits (values 0 to 9, most significant first) as a magnitude
_mag_from_digits=(digits:array<uint8>):>array<uint64>=>{
    let chunks:array<uint64>=[]
    let stop=digits.length
    loop stop >? 0 {
        let start=stop-9
        if start <? 0 start=0
        let chunk:uint64=0
        loop i in [start..stop) chunk=chunk*10+digits[i]
        chunks.push(chunk)
        stop=start
    }
    let k:int64=0
    loop (1 << k) <? chunks.length k=k+1
    let tree=_convert_tree(k false)
    return _mag_from_chunks(chunks 0 k tree)
}

# decimal digit values (most significant first) as a BigInt
_from_digits=(digits:array<uint8> negative:bool):>BigInt=>_pack(negative _mag_from_digits(digits))

let _bigint_decimal_chunks = (limbs:array<uint64>):>array<uint64> => {
    let chunks:array<uint64> = []          # least significant chunk first
    let current:array<uint64> = limbs      # divided in place
    loop current.length >? 0 {
        # short division by 10^9, most significant limb first: each quotient
        # limb depends only on the limb it replaces and the running remainder
        let i:int64 = current.length
        let remainder:uint64 = 0
        loop i >? 0 {
            i = i - 1
            let value:uint64 = (remainder << 32) or current[i]
            current[i] = value // 1000000000
            remainder = value % 1000000000
        }
        _bigint_trim(@current)
        chunks.push(remainder)
    }
    return chunks
}


_pack=(negative:bool limbs:array<uint64>):>BigInt=>{
    _bigint_trim(@limbs)
    if limbs.length =? 0 return BigInt[]
    return BigInt[_sign=if negative -1 else 1 _limbs=limbs]
}

_from_unsigned=(value:uint64 negative:bool=false):>BigInt=>{
    if value =? 0 return BigInt[]
    let low=value and _LIMB_MASK
    let high=value >> 32
    return _pack(negative if high =? 0 [low] else [low high])
}

_big = ((value:BigInt):>BigInt=>value)
       & ((value:int):>BigInt=>value as BigInt)
       & ((value:uint64):>BigInt=>_from_unsigned(value))
       & ((value:int64):>BigInt=>{
            let magnitude=uint64<overflow='wrap'>(value)
            if value <? 0 magnitude=0-magnitude
            return _from_unsigned(magnitude value <? 0)
         })

# Strict decimal text, with an optional leading sign. No float conversion.
_parse_big=(text:string):>BigInt|none=>{
    let digits=bytes(text)
    if digits.length =? 0 return none
    let negative=digits[0] =? 45
    let start:int64=0
    if negative or digits[0] =? 43 start=1
    if start =? digits.length return none
    let values:array<uint8>=[]
    loop i in [start..digits.length) {
        if digits[i] <? 48 or digits[i] >? 57 return none
        values.push(digits[i]-48)
    }
    return _from_digits(values negative)
}

_compare=(a:BigInt b:BigInt):>int64=>{
    if a._sign not=? b._sign return if a._sign <? b._sign -1 else 1
    if a._sign =? 0 return 0
    return a._sign*_mag_compare(a._limbs b._limbs)
}

_neg=(a:BigInt):>BigInt=>BigInt[_sign=-a._sign _limbs=a._limbs]
_add=(a:BigInt b:BigInt):>BigInt=>{
    if a._sign =? 0 return b
    if b._sign =? 0 return a
    if a._sign =? b._sign return _pack(a._sign <? 0 _mag_add(a._limbs b._limbs))
    let order=_mag_compare(a._limbs b._limbs)
    if order =? 0 return BigInt[]
    if order >? 0 return _pack(a._sign <? 0 _mag_sub(a._limbs b._limbs))
    return _pack(b._sign <? 0 _mag_sub(b._limbs a._limbs))
}
_sub=(a:BigInt b:BigInt):>BigInt=>_add(a _neg(b))
_mul=(a:BigInt b:BigInt):>BigInt=>{
    if a._sign =? 0 or b._sign =? 0 return BigInt[]
    return _pack(a._sign not=? b._sign _mag_mul(a._limbs b._limbs))
}

BigIntDivision:type=[quotient:BigInt remainder:BigInt]
divmod=(a:BigInt b:BigInt):>BigIntDivision=>{
    if b._sign =? 0 panic("big integer division by zero")
    if a._sign =? 0 return BigIntDivision[BigInt[] BigInt[]]
    let parts=_mag_divmod(a._limbs b._limbs)
    let negative=a._sign not=? b._sign
    let quotient=_pack(negative parts.quotient)
    let remainder=_pack(a._sign <? 0 parts.remainder)
    if negative and remainder._sign not=? 0 {
        quotient=_sub(quotient _big(1))
        remainder=_add(remainder b)
    }
    return BigIntDivision[quotient remainder]
}

pow=(base:BigInt exponent:int64):>BigInt=>{
    if exponent <? 0 panic("big integer exponent must be nonnegative")
    let result=_big(1)
    let factor=base
    loop exponent >? 0 {
        if (exponent and 1) =? 1 result=_mul(result factor)
        exponent=exponent >> 1
        if exponent >? 0 factor=_mul(factor factor)
    }
    return result
}
abs=(value:BigInt):>BigInt=>{
    if value._sign <? 0 return _neg(value)
    return value
}
gcd=(a:BigInt b:BigInt):>BigInt=>_pack(false _mag_gcd(a._limbs b._limbs))

# Checked conversions; a value outside the requested word does not truncate.
to_uint64=(value:BigInt):>uint64|none=>{
    if value._sign <? 0 or value._limbs.length >? 2 return none
    let word:uint64=0
    if value._limbs.length >? 0 word=value._limbs[0]
    if value._limbs.length >? 1 word=word or (value._limbs[1] << 32)
    return word
}
to_int64=(value:BigInt):>int64|none=>{
    let magnitude=to_uint64(abs(value))
    if magnitude is? none return none
    if value._sign <? 0 {
        if magnitude >? 9223372036854775808 return none
        return int64<overflow='wrap'>(0-magnitude)
    }
    if magnitude >? 9223372036854775807 return none
    return int64<overflow='wrap'>(magnitude)
}

# Round the exact ratio once to an IEEE binary format. Keeping a quotient and
# remainder avoids overflowing either part or losing a tie-breaking low bit.
_ratio_float_bits=(negative:bool numerator:array<uint64> denominator:array<uint64>
                   fraction_bits:int64 exponent_bits:int64):>uint64=>{
    if denominator.length =? 0 panic("floating conversion denominator must be nonzero")
    let sign:uint64=0
    if negative sign=(1 as uint64) << (fraction_bits+exponent_bits)
    if numerator.length =? 0 return sign
    let bias:int64=(1 << (exponent_bits-1))-1
    let minimum:int64=1-bias-fraction_bits
    let infinity:uint64=(((1 as uint64) << exponent_bits)-1) << fraction_bits
    let nb=numerator.length*32-_limb_leading_zeros(numerator[numerator.length-1])
    let db=denominator.length*32-_limb_leading_zeros(denominator[denominator.length-1])
    let exponent=nb-db
    if exponent >? bias+1 return sign or infinity
    if exponent <? minimum-1 return sign
    if exponent >=? 0 {
        if _mag_compare(numerator _mag_shift_left(denominator exponent)) <? 0 exponent-=1
    } else {
        if _mag_compare(_mag_shift_left(numerator -exponent) denominator) <? 0 exponent-=1
    }
    if exponent >? bias return sign or infinity
    if exponent <? minimum-1 return sign
    let unit=exponent-fraction_bits
    if unit <? minimum unit=minimum
    let scaled_n=numerator let scaled_d=denominator
    if unit <? 0 scaled_n=_mag_shift_left(numerator -unit)
    else if unit >? 0 scaled_d=_mag_shift_left(denominator unit)
    let parts=_mag_divmod(scaled_n scaled_d)
    let word:uint64=0
    if parts.quotient.length >? 0 word=parts.quotient[0]
    if parts.quotient.length >? 1 word=word or (parts.quotient[1] << 32)
    let rounding=_mag_compare(_mag_shift_left(parts.remainder 1) scaled_d)
    if rounding >? 0 or (rounding =? 0 and (word and 1) not=? 0) word+=1
    # At the minimum unit, these bits cover subnormals and the first normal
    # binade, including a carry from rounding the largest subnormal.
    if unit =? minimum return sign or word
    let hidden:uint64=(1 as uint64) << fraction_bits
    if word =? hidden << 1 {word=word >> 1 exponent+=1}
    if exponent >? bias return sign or infinity
    return sign or (uint64<overflow='wrap'>(exponent+bias) << fraction_bits) or (word-hidden)
}

to_float64=(value:BigInt):>float64=>
    f64_from_bits(_ratio_float_bits(value._sign <? 0 value._limbs [1] 52 11))
to_float32=(value:BigInt):>float32=>
    f32_from_bits(uint32<overflow='wrap'>(_ratio_float_bits(value._sign <? 0 value._limbs [1] 23 8)))

__as__=(value:BigInt):>string=>{
    if value._sign =? 0 return "0"
    let parts:array<string>=[]
    if value._sign <? 0 parts.push("-")
    let chunks=_mag_decimal_chunks(value._limbs)
    let i=chunks.length
    loop i >? 0 {
        i-=1
        let chunk=chunks[i]
        if i not=? chunks.length-1 {
            let pad:uint64=100000000
            loop pad >? chunk and pad >? 1 {
                parts.push("0")
                pad=pad//10
            }
        }
        parts.push("{chunk}")
    }
    return parts.join("")
}
__unary_sub__=(a:BigInt):>BigInt=>_neg(a)

__add__ = ((a:BigInt b:BigInt):>BigInt=>_add(a b))
    & ((a:BigInt b:int64):>BigInt=>_add(a _big(b)))
    & ((a:int64 b:BigInt):>BigInt=>_add(_big(a) b))
    & ((a:BigInt b:uint64):>BigInt=>_add(a _big(b)))
    & ((a:uint64 b:BigInt):>BigInt=>_add(_big(a) b))

__sub__ = ((a:BigInt b:BigInt):>BigInt=>_sub(a b))
    & ((a:BigInt b:int64):>BigInt=>_sub(a _big(b)))
    & ((a:int64 b:BigInt):>BigInt=>_sub(_big(a) b))
    & ((a:BigInt b:uint64):>BigInt=>_sub(a _big(b)))
    & ((a:uint64 b:BigInt):>BigInt=>_sub(_big(a) b))

__mul__ = ((a:BigInt b:BigInt):>BigInt=>_mul(a b))
    & ((a:BigInt b:int64):>BigInt=>_mul(a _big(b)))
    & ((a:int64 b:BigInt):>BigInt=>_mul(_big(a) b))
    & ((a:BigInt b:uint64):>BigInt=>_mul(a _big(b)))
    & ((a:uint64 b:BigInt):>BigInt=>_mul(_big(a) b))

__eq__ = ((a:BigInt b:BigInt):>bool=>_compare(a b) =? 0)
    & ((a:BigInt b:int64):>bool=>_compare(a _big(b)) =? 0)
    & ((a:int64 b:BigInt):>bool=>_compare(_big(a) b) =? 0)
    & ((a:BigInt b:uint64):>bool=>_compare(a _big(b)) =? 0)
    & ((a:uint64 b:BigInt):>bool=>_compare(_big(a) b) =? 0)

__lt__ = ((a:BigInt b:BigInt):>bool=>_compare(a b) <? 0)
    & ((a:BigInt b:int64):>bool=>_compare(a _big(b)) <? 0)
    & ((a:int64 b:BigInt):>bool=>_compare(_big(a) b) <? 0)
    & ((a:BigInt b:uint64):>bool=>_compare(a _big(b)) <? 0)
    & ((a:uint64 b:BigInt):>bool=>_compare(_big(a) b) <? 0)

__floordiv__ = ((a:BigInt b:BigInt):>BigInt=>divmod(a b).quotient)
    & ((a:BigInt b:int64):>BigInt=>divmod(a _big(b)).quotient)
    & ((a:int64 b:BigInt):>BigInt=>divmod(_big(a) b).quotient)
    & ((a:BigInt b:uint64):>BigInt=>divmod(a _big(b)).quotient)
    & ((a:uint64 b:BigInt):>BigInt=>divmod(_big(a) b).quotient)

__mod__ = ((a:BigInt b:BigInt):>BigInt=>divmod(a b).remainder)
    & ((a:BigInt b:int64):>BigInt=>divmod(a _big(b)).remainder)
    & ((a:int64 b:BigInt):>BigInt=>divmod(_big(a) b).remainder)
    & ((a:BigInt b:uint64):>BigInt=>divmod(a _big(b)).remainder)
    & ((a:uint64 b:BigInt):>BigInt=>divmod(_big(a) b).remainder)

__pow__=(base:BigInt exponent:int64):>BigInt=>pow(base exponent)

# Bit operations use infinite two's-complement sign extension. Convert limbs
# as they are consumed; only the result needs storage. The extra high word
# distinguishes a positive high bit from a negative sign extension.
_bitwise=(a:BigInt b:BigInt operation:int64):>BigInt=>{
    let count=a._limbs.length
    if b._limbs.length >? count count=b._limbs.length
    let carry_a:uint64=if a._sign <? 0 1 else 0
    let carry_b:uint64=if b._sign <? 0 1 else 0
    let result:array<uint64>=[]
    loop i in [0..count] {
        let left:uint64=if i <? a._limbs.length a._limbs[i] else 0
        let right:uint64=if i <? b._limbs.length b._limbs[i] else 0
        if a._sign <? 0 {
            left=(left xor _LIMB_MASK)+carry_a
            carry_a=left >> 32
            left=left and _LIMB_MASK
        }
        if b._sign <? 0 {
            right=(right xor _LIMB_MASK)+carry_b
            carry_b=right >> 32
            right=right and _LIMB_MASK
        }
        let word:uint64=left xor right
        if operation =? 0 word=left and right
        else if operation =? 1 word=left or right
        result.push(word)
    }
    let negative=(result[count] and 2147483648) not=? 0
    if negative {
        let carry:uint64=1
        loop i in [0..result.length) {
            let word=(result[i] xor _LIMB_MASK)+carry
            result[i]=word and _LIMB_MASK
            carry=word >> 32
        }
    }
    return _pack(negative result)
}

__not__=(value:BigInt):>BigInt=>_neg(_add(value _big(1)))
__lshift__=(value:BigInt bits:int64):>BigInt=>{
    if bits <? 0 panic("big integer shift count must be nonnegative")
    if bits =? 0 return value
    return _pack(value._sign <? 0 _mag_shift_left(value._limbs bits))
}
__rshift__=(value:BigInt bits:int64):>BigInt=>{
    if bits <? 0 panic("big integer shift count must be nonnegative")
    if bits =? 0 return value
    let result=_mag_shift_right(value._limbs bits)
    # Arithmetic right shift rounds negative values down, including when all
    # magnitude bits have shifted away. No power-of-two divisor is allocated.
    if value._sign <? 0 and _mag_trailing_zeros(value._limbs) <? bits {
        result=_mag_add(result [1])
    }
    return _pack(value._sign <? 0 result)
}

__and__ = ((a:BigInt b:BigInt):>BigInt=>_bitwise(a b 0))
    & ((a:BigInt b:int64):>BigInt=>_bitwise(a _big(b) 0))
    & ((a:int64 b:BigInt):>BigInt=>_bitwise(_big(a) b 0))
    & ((a:BigInt b:uint64):>BigInt=>_bitwise(a _big(b) 0))
    & ((a:uint64 b:BigInt):>BigInt=>_bitwise(_big(a) b 0))

__or__ = ((a:BigInt b:BigInt):>BigInt=>_bitwise(a b 1))
    & ((a:BigInt b:int64):>BigInt=>_bitwise(a _big(b) 1))
    & ((a:int64 b:BigInt):>BigInt=>_bitwise(_big(a) b 1))
    & ((a:BigInt b:uint64):>BigInt=>_bitwise(a _big(b) 1))
    & ((a:uint64 b:BigInt):>BigInt=>_bitwise(_big(a) b 1))

__xor__ = ((a:BigInt b:BigInt):>BigInt=>_bitwise(a b 2))
    & ((a:BigInt b:int64):>BigInt=>_bitwise(a _big(b) 2))
    & ((a:int64 b:BigInt):>BigInt=>_bitwise(_big(a) b 2))
    & ((a:BigInt b:uint64):>BigInt=>_bitwise(a _big(b) 2))
    & ((a:uint64 b:BigInt):>BigInt=>_bitwise(_big(a) b 2))

# Directive bundles (docs/LANGUAGE.md, "Directives"): one metatag for several
# settings, held throughout the module, function body or block it is written
# in. `$name=false` opts a nested scope out of all of them.

# The strict lane: no hidden allocation, detach or costly copy, and no runtime
# checks. Every obligation is proven or handled as a value, implicit costly
# copies are errors, and a function without an effect row of its own gets
# `no allocates & no panics` (a detach allocates; nothing it calls may panic).
$no_hidden_costs = {
    $explicit_copies
    $runtime_checks=false
    $prototype=false
    $default_row = no allocates & no panics
}

# Floats that are always finite: no operation in the scope may produce a NaN
# or an infinity unless it is proven not to (or checked, under
# `$runtime_checks`).
$finite_floats = {
    $no_nan
    $no_inf
}

# The strictest of everything (docs/design/assumptions.md): every strict lane, and
# every assumption the compiler makes turned off so its proof is demanded instead.
# `$explicit_allocation_failure` is a module policy, so this bundle goes at the top
# of a module; `$bulletproof=false` opts a nested scope out of the rest.
# Not yet enforceable (no opt-out metatag yet; assumptions.md marks them pending):
# library asserts as invariants, the runtime core as environmental, library
# environment failures, library obligations as runtime checks, the library's
# raw memory in arenas, the library's drop hooks, values entering `$no_inf` as
# finite, and the certified protocols `serve` and `pipeline`.
$bulletproof = {
    $no_hidden_costs
    $explicit_allocation_failure
    $finite_floats
    $no_deadlocks
    $no_assumed_bounds
    $assume_local_asserts=false
    $confine_external_paths
}

# Civil time of docs/design/time.md without zones: dates and their calendars, periods, ages.
# Gregorian (arithmetic proleptic Gregorian, astronomical years, year zero) is the only calendar
# so far. It maps no data.
import p"format.dewy" as pattern
from p"core.dewy" import (Instant Days Months _Recipe _DatePeriod days_from_civil civil_from_days days_in_month read_fields _Cursor Fields _year_text _fraction_text pad)

# `_days` counts from 1970-01-01, and the calendar is part of the type: bare `Date` is `Date<Gregorian>`.
Gregorian:type=[]
Date:type=<C=Gregorian>[_days:int64]
const _MONTHS:array<string length=12>=["January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"]
const _WEEKDAYS:array<string length=7>=["Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday" "Sunday"]

_date_too_far=():>never=>{
    __environment_failure("date is outside the int64 day range")
    exit(101)
}
_of_days=(days:int):>Date=>Date<Gregorian>[days.to_int64() ?? _date_too_far()]
date_of=(year:int month:int64 day:int64):>Date=>_of_days(days_from_civil(year month day))
date_parse=(text:string):>Date|ParseError=>{
    let c=_Cursor[text 0]
    let f=read_fields(@c) or_throw
    if f.has_time or c.at not=? (text as array<uint8>).length {return ParseError["a date is written YYYY-MM-DD, with no time"]}
    date_of(f.year f.month f.day)
}
date_error=(text:string):>string?=>{
    let r=date_parse(text)
    match r {
        d:Date=>none
        e:ParseError=>e.message
    }
}

fields=(d:Date):>[int int64<n => n >=? 1 and n <=? 12> int64<n => n >=? 1 and n <=? 31>]=>civil_from_days(int(d._days))
year=(d:Date):>int=>fields(d)[0]
month=(d:Date):>int64<n => n >=? 1 and n <=? 12>=>fields(d)[1]
day=(d:Date):>int64<n => n >=? 1 and n <=? 31>=>fields(d)[2]
# 0 for Monday to 6 for Sunday (1970-01-01 was a Thursday).
weekday=(d:Date):>int64<n => n >=? 0 and n <=? 6>=>(((int(d._days)+3)%7).to_int64() ?? 0)
month_name=(d:Date):>string=>{
    $runtime_checks=false
    _MONTHS[month(d)-1]
}
weekday_name=(d:Date):>string=>_WEEKDAYS[weekday(d)]

__eq__=(a:Date b:Date):>bool=>a._days =? b._days
__lt__=(a:Date b:Date):>bool=>a._days <? b._days
# Dates are discrete: there is no date strictly between adjacent days.
_range_is_empty=<C>(first:Date<C> last:Date<C> includes_first:bool includes_last:bool):>bool=>{
    let count=int(last._days)-int(first._days)+1
    count <=? (if includes_first {0} else {1})+(if includes_last {0} else {1})
}
__as__=(d:Date):>string=>{
    let [y m dd]=fields(d)
    "{_year_text(y)}-{pad(m 2)}-{pad(dd 2)}"
}
__add__=(d:Date p:Days):>Date=>_of_days(int(d._days)+int(p.count))
__sub__=(d:Date p:Days):>Date=>_of_days(int(d._days)-int(p.count))
# `b - a`: the period between two dates, which knows its anchor. `total_days` counts calendar
# successors, so `a + (b - a) =? b`; `years`, `months` and `days` decompose it by completed
# anniversaries and months, a 29 February start counting on 1 March (`age`'s default). It is the
# Period `Date - Date` gives, beside the recipes `1day` (Days) and `1month` (Months).
__sub__=(a:Date b:Date):>_DatePeriod=>{
    let total=int64<overflow='saturate'>(int(a._days)-int(b._days))
    let forward=total >=? 0
    let early=if forward b else a
    let late=if forward a else b
    let years=int64<overflow='saturate'>(age_on(early late 'march_1'))
    let [ey em ed]=fields(early)
    let [ly lm ld]=fields(late)
    let month_count=(ly*12+int(lm))-(ey*12+int(em))-(if ld <? ed {1} else {0})
    let months=int64<overflow='saturate'>(month_count)
    # (a February 29 birthday's anniversary is March 1 in a common year, as `age` counts it)
    let [ay am ad]=_month_add(early months)
    let anchor=if em =? 2 and ed =? 29 and am =? 2 and days_in_month(ay 2) =? 28 {date_of(ay 3 1)} else {_month_clamped(early months)}
    let days=int64<overflow='saturate'>(int(late._days)-int(anchor._days))
    let sign:int64=if forward {1} else {-1}
    _DatePeriod[total sign*years sign*int64<overflow='saturate'>(months%12) sign*days]
}
_month_clamped=(d:Date count:int64):>Date=>{
    let [y m dd]=_month_add(d count)
    date_of(y m min(dd days_in_month(y m)))
}
__add__=(d:Date p:_DatePeriod):>Date=>_of_days(int(d._days)+int(p.total_days))
__sub__=(d:Date p:_DatePeriod):>Date=>_of_days(int(d._days)-int(p.total_days))

# Moves by months, keeping the day; [the date, whether that day exists in the month].
_month_add=(d:Date count:int64):>[int int64 int64]=>{
    let [y m dd]=fields(d)
    let total=y*12+int(m)-1+int(count)
    [total//12 ((total%12).to_int64() ?? 0)+1 dd]
}
# A month's 31st may not exist: a date, or InvalidDate; `add` names what to do instead.
__add__=(d:Date p:Months):>Date|InvalidDate=>{
    let [y m dd]=_month_add(d p.count)
    if dd >? days_in_month(y m) {return InvalidDate["{_year_text(y)}-{pad(m 2)} has no day {dd}"]}
    date_of(y m dd)
}
__sub__=(d:Date p:Months):>Date|InvalidDate=>d+(-p)
__add__=(d:Date p:_Recipe):>Date|InvalidDate=>{
    let current=d
    loop step in p.steps {
        match step {
            days:Days=>{current=current+days}
            months:Months=>{current=(current+months) or_throw}
        }
    }
    current
}
__add__=(d:Date p:Days|Months|_Recipe|_DatePeriod):>Date|InvalidDate=>match p {
    days:Days=>d+days
    months:Months=>d+months
    recipe:_Recipe=>d+recipe
    span:_DatePeriod=>d+span
}

_Overflow:type='clamp'|'next'
# `overflow='clamp'` takes the month's last day; `'next'` the first of the next month.
add=(d:Date p:Months overflow:_Overflow):>Date=>{
    let [y m dd]=_month_add(d p.count)
    let last=days_in_month(y m)
    if dd <=? last {return date_of(y m dd)}
    if overflow =? 'clamp' {return date_of(y m last)}
    let t=y*12+int(m)
    date_of(t//12 ((t%12).to_int64() ?? 0)+1 1)
}
add=(d:Date p:Days):>Date=>d+p

# Completed anniversaries, never elapsed seconds over a year. A 29 February birthday counts on
# 1 March in a common year.

_LeapDay:type='march_1'|'february_28'
age_on=(born:Date on:Date leap_day:_LeapDay):>int=>{
    let [by bm bd]=fields(born)
    let [oy om od]=fields(on)
    let count=oy-by
    let am=bm
    let ad=bd
    if bm =? 2 and bd =? 29 and days_in_month(oy 2) =? 28 {
        if leap_day =? 'march_1' {
            am=3
            ad=1
        } else {ad=28}
    }
    if om <? am or (om =? am and od <? ad) {return count-1}
    count
}

# ---------------- a time of day, and a date with one: no zone, so no moment yet ----------------
TimeOfDay:type=[_ns:int64<n => n >=? 0 and n <? 86400000000000>]
LocalDateTime:type=<C=Gregorian>[date:Date<C> time:TimeOfDay]
const _NS_PER_DAY:int64=86400000000000

hour=(t:TimeOfDay):>int64<n => n >=? 0 and n <=? 23>=>t._ns//3600000000000
minute=(t:TimeOfDay):>int64<n => n >=? 0 and n <=? 59>=>(t._ns%3600000000000)//60000000000
second=(t:TimeOfDay):>int64<n => n >=? 0 and n <=? 59>=>(t._ns%60000000000)//1000000000
nanosecond=(t:TimeOfDay):>int64<n => n >=? 0 and n <=? 999999999>=>t._ns%1000000000
__eq__=(a:TimeOfDay b:TimeOfDay):>bool=>a._ns =? b._ns
__lt__=(a:TimeOfDay b:TimeOfDay):>bool=>a._ns <? b._ns
__as__=(t:TimeOfDay):>string=>"{pad(hour(t) 2)}:{pad(minute(t) 2)}:{pad(second(t) 2)}{_fraction_text(int(nanosecond(t)))}"
time_of_fields=(f:Fields):>TimeOfDay=>TimeOfDay[f.hour*3600000000000+f.minute*60000000000+f.second*1000000000+f.nanosecond]

# (read as the time of an arbitrary date, by the one reader of these fields)
time_of_day_parse=(text:string):>TimeOfDay|ParseError=>{
    let line=_Cursor["2000-01-01T{text}" 0]
    let f=read_fields(@line) or_throw
    if line.at not=? ("2000-01-01T{text}" as array<uint8>).length {return ParseError["a time of day is written hh:mm, hh:mm:ss or hh:mm:ss.fraction"]}
    if f.second =? 60 {return ParseError["a :60 second is a UTC label: use `utc`"]}
    time_of_fields(f)
}
time_of_day_error=(text:string):>string?=>match time_of_day_parse(text) {
    t:TimeOfDay=>none
    e:ParseError=>e.message
}
local_parse=(text:string):>LocalDateTime|ParseError=>{
    let c=_Cursor[text 0]
    let f=read_fields(@c) or_throw
    if not f.has_time {return ParseError["a local time is written YYYY-MM-DDThh:mm, with a time; a date alone is `date`"]}
    if c.at not=? (text as array<uint8>).length {return ParseError["a local time has no offset or zone; one with them is `zoned` or `instant`"]}
    if f.second =? 60 {return ParseError["a :60 second is a UTC label: use `utc`"]}
    LocalDateTime<Gregorian>[date_of(f.year f.month f.day) time_of_fields(f)]
}
local_error=(text:string):>string?=>match local_parse(text) {
    t:LocalDateTime=>none
    e:ParseError=>e.message
}
at=(d:Date t:TimeOfDay):>LocalDateTime=>LocalDateTime<Gregorian>[d t]
__eq__=(a:LocalDateTime b:LocalDateTime):>bool=>a.date =? b.date and a.time =? b.time
__lt__=(a:LocalDateTime b:LocalDateTime):>bool=>a.date <? b.date or (a.date =? b.date and a.time <? b.time)
__as__=(l:LocalDateTime):>string=>"{l.date}T{l.time}"
__add__=(l:LocalDateTime p:Days):>LocalDateTime=>LocalDateTime<Gregorian>[l.date+p l.time]
__sub__=(l:LocalDateTime p:Days):>LocalDateTime=>LocalDateTime<Gregorian>[l.date-p l.time]
__add__=(l:LocalDateTime p:Months):>LocalDateTime|InvalidDate=>LocalDateTime<Gregorian>[(l.date+p) or_throw l.time]
__add__=(l:LocalDateTime p:_Recipe):>LocalDateTime|InvalidDate=>LocalDateTime<Gregorian>[(l.date+p) or_throw l.time]
__add__=(l:LocalDateTime p:Days|Months|_Recipe|_DatePeriod):>LocalDateTime|InvalidDate=>match p {
    days:Days=>l+days
    months:Months=>l+months
    recipe:_Recipe=>l+recipe
    span:_DatePeriod=>LocalDateTime<Gregorian>[l.date+span l.time]
}
add=(l:LocalDateTime p:Months overflow:_Overflow):>LocalDateTime=>LocalDateTime<Gregorian>[add(l.date p overflow) l.time]

# ---------------- by a pattern: `d.format("EEEE d MMMM y")`, `date(text "d/M/y")` ----------------
_date_parts=(d:Date):>pattern.Parts=>{
    let [y m dd]=fields(d)
    pattern.Parts[true false false y m dd weekday(d) 0 0 0 0 0 ""]
}
date_pattern_error=(p:string):>string?=>pattern.pattern_error(p true false false)
time_pattern_error=(p:string):>string?=>pattern.pattern_error(p false true false)
local_pattern_error=(p:string):>string?=>pattern.pattern_error(p true true false)
$check_constant date_pattern_error(p) "not a pattern"
format=(d:Date p:string):>string|ParseError=>{
    let wrong=date_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    pattern.render(_date_parts(d) p)
}
$check_constant time_pattern_error(p) "not a pattern"
format=(t:TimeOfDay p:string):>string|ParseError=>{
    let wrong=time_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    pattern.render(pattern.Parts[false true false 0 1 1 0 hour(t) minute(t) second(t) nanosecond(t) 0 ""] p)
}
$check_constant local_pattern_error(p) "not a pattern"
format=(l:LocalDateTime p:string):>string|ParseError=>{
    let wrong=local_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    let [y m dd]=fields(l.date)
    pattern.render(pattern.Parts[true true false y m dd weekday(l.date) hour(l.time) minute(l.time) second(l.time) nanosecond(l.time) 0 ""] p)
}
# (the time fields of what a pattern read)
_time_of_read=(r:pattern.Read):>TimeOfDay=>TimeOfDay[r.hour*3600000000000+r.minute*60000000000+r.second*1000000000+r.nanosecond]
date_read=(text:string p:string):>Date|ParseError=>{
    let wrong=date_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    let r=pattern.read_pattern(text p) or_throw
    date_of(r.year r.month r.day)
}
time_of_day_read=(text:string p:string):>TimeOfDay|ParseError=>{
    let wrong=time_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    let r=pattern.read_pattern(text p) or_throw
    _time_of_read(r)
}
local_read=(text:string p:string):>LocalDateTime|ParseError=>{
    let wrong=local_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    let r=pattern.read_pattern(text p) or_throw
    LocalDateTime<Gregorian>[date_of(r.year r.month r.day) _time_of_read(r)]
}

# (a constant text by a constant pattern is checked whole; a constant pattern alone only makes a
# bad pattern an error, and empty text promises nothing about the text to come)
date_read_error=(text:string p:string):>string?=>match date_read(text p) {
    d:Date=>none
    e:ParseError=>e.message
}
time_read_error=(text:string p:string):>string?=>match time_of_day_read(text p) {
    t:TimeOfDay=>none
    e:ParseError=>e.message
}
local_read_error=(text:string p:string):>string?=>match local_read(text p) {
    l:LocalDateTime=>none
    e:ParseError=>e.message
}
date_pattern_only=(p:string):>string?=>date_pattern_error(p) ?? ""
time_pattern_only=(p:string):>string?=>time_pattern_error(p) ?? ""
local_pattern_only=(p:string):>string?=>local_pattern_error(p) ?? ""

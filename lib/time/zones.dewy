# Zones of docs/design/time.md: the pinned rule pack (tools/time/gen_rules.py), offsets at a moment,
# local times resolved through gaps and folds, and zoned values. Only a program that reaches a
# zone operation links the pack.
import p"format.dewy" as pattern
import p"zone_cache.jo" as cache
from p"../runtime/settings_zones.jo" import (__settings_rule_id __settings_rule_data __settings_zone_pack __settings_zone_handle __settings_zone_index __settings_rule_dynamic __settings_zone_bound __settings_zone_host)
from p"civil.dewy" import (Date TimeOfDay LocalDateTime Gregorian date_of _of_days _LeapDay _Overflow)
from p"core.dewy" import (Instant Duration Days Months _Recipe _DatePeriod instant_at ns_count read_fields read_offset NO_OFFSET _Cursor Fields _byte _utc_to_axis _axis_to_utc civil_from_days days_from_civil days_in_month _year_text _fraction_text _DAY_NS _NS pad)
import p"core.dewy" as core
# (inside a function, so a program links the pack only if something still reads it when it runs:
# a literal folded while compiling does not)
_rules=(id:int64=__settings_rule_id):>array<uint8>=>{
    const pack=$include_bytes(p"rules/current.bin")
    if id =? 0 {return pack}
    __settings_rule_data(id)
}

Zone:type=[_entry:int64]
# A handle contains both the pack identity and its zone index. The representation
# stays one word; existing values never consult the caller's active rule pack.
_zone_rules=(z:Zone):>array<uint8>=>_rules(__settings_zone_pack(z._entry))
Offset:type=[_seconds:int32]
ZonedDateTime:type=[nominal:Instant zone:Zone offset:Offset]
# A status for a pinned zone whose host rules are known to be newer and differ.
# Its query remains private until the public access spelling is decided.
ZonePackStale:type=[pinned:string host:string]
_UnknownZonePackFreshness:type=[pinned:string host:string]

# ---------------- reading the pack ----------------
# `$time.zone_source = 'host'`: a zone's rules are the machine's, read when it is first reached and
# kept past the pack's end. The pack still names the zones, and a literal cannot fold against them.
_use_host=():>bool=>{
    let source:string|none=$time.zone_source
    source =? 'host'
}
_rule_byte=(at:int64 pack_bytes:array<uint8>):>int64=>$unsafe {
    if at <? 0 {__panic("invalid time rule-pack offset")}
    if at >=? pack_bytes.length {
        let host=at-pack_bytes.length
        return cache.rule_byte(host)
    }
    int64(pack_bytes[at])
}
_u8=(at:int64 pack_bytes:array<uint8>):>int64=>_rule_byte(at pack_bytes)
_u32=(at:int64 pack_bytes:array<uint8>):>int64=>_rule_byte(at pack_bytes) + (_rule_byte(at+1 pack_bytes) << 8) + (_rule_byte(at+2 pack_bytes) << 16) + (_rule_byte(at+3 pack_bytes) << 24)
_i32=(at:int64 pack_bytes:array<uint8>):>int64=>{
    let v=_u32(at pack_bytes)
    if v >=? 2147483648 {v-4294967296} else {v}
}
_i64=(at:int64 pack_bytes:array<uint8>):>int64=>$unsafe {
    let v:int64<overflow='wrap'>=0
    loop i in [0..8) {
        v=v+(int64<overflow='wrap'>(_rule_byte(at+i pack_bytes)) << (8*i))
    }
    int64<overflow='wrap'>(v)
}
_zone_count=(pack_bytes:array<uint8>):>int64=>_u32(4 pack_bytes)
_entry_at=(entry:int64):>int64=>24+entry*12
# (the name's bytes against text: negative, zero or positive)
_compare=(entry:int64 text:string pack_bytes:array<uint8>):>int64=>$unsafe {
    let at=_u32(_entry_at(entry) pack_bytes)
    let len=_u32(_entry_at(entry)+4 pack_bytes)
    let bytes=text as array<uint8>
    let i:int64=0
    loop i <? len and i <? bytes.length {
        let a=int64(pack_bytes[at+i])
        let b=int64(bytes[i])
        if a not=? b {return a-b}
        i=i+1
    }
    len-bytes.length
}
_text_at=(at:int64 len:int64 pack_bytes:array<uint8>):>string=>$unsafe {
    # (pack names and rules are ASCII; this also runs at compile time, for a literal's message)
    let out:array<uint8>=[]
    loop i in [0..len) {out.push(pack_bytes[at+i])}
    str_from_bytes(out)
}
# The rule data this program's zones come from.
rules_version=():>string=>{
    let pack_bytes=_rules
    _text_at(_u32(8 pack_bytes) _u32(12 pack_bytes) pack_bytes)
}

zone_parse=(name:string):>Zone|UnknownZone=>{
    let pack=__settings_rule_id
    let pack_bytes=_rules(pack)
    let lo:int64=0
    let hi=_zone_count(pack_bytes)
    loop lo <? hi {
        let mid=(lo+hi)//2
        let c=_compare(mid name pack_bytes)
        if c =? 0 {return Zone[__settings_zone_handle(mid pack)]}
        if c <? 0 {lo=mid+1} else {hi=mid}
    }
    UnknownZone["no time zone is called {name}"]
}
zone_error=(name:string):>string?=>match zone_parse(name) {
    z:Zone=>none
    e:UnknownZone=>e.message
}
name=(z:Zone):>string=>{
    let pack_bytes=_zone_rules(z)
    _text_at(_u32(_entry_at(__settings_zone_index(z._entry)) pack_bytes) _u32(_entry_at(__settings_zone_index(z._entry))+4 pack_bytes) pack_bytes)
}
__as__=(z:Zone):>string=>name(z)
__eq__=(a:Zone b:Zone):>bool=>a._entry =? b._entry

# A Windows name for a zone (CLDR's table, in the pack): the machine says "Eastern Standard Time".
_windows_zone=(name:string):>Zone|UnknownZone=>$unsafe {
    let pack=__settings_rule_id
    let pack_bytes=_rules(pack)
    let table=_u32(20 pack_bytes)
    let bytes=name as array<uint8>
    let lo:int64=0
    let hi=_u32(16 pack_bytes)
    loop lo <? hi {
        let mid=(lo+hi)//2
        let row=table+mid*12
        let at=_u32(row pack_bytes)
        let len=_u32(row+4 pack_bytes)
        let order:int64=0
        let i:int64=0
        loop order =? 0 and i <? len and i <? bytes.length {
            order=int64(pack_bytes[at+i])-int64(bytes[i])
            i=i+1
        }
        if order =? 0 {order=len-bytes.length}
        if order =? 0 {return Zone[__settings_zone_handle(_u32(row+8 pack_bytes) pack)]}
        if order <? 0 {lo=mid+1} else {hi=mid}
    }
    UnknownZone["no time zone is called {name}"]
}
# What a machine calls its zone: a tz name, or Windows' name for one.
_machine_named=(name:string):>Zone|UnknownZone=>{
    let found=zone_parse(name)
    if found is? Zone {return found}
    _windows_zone(name)
}

# The machine's zone, read once by name; its rules still come from the pack. A machine with no zone
# to read, or a name the pack does not know, is read as UTC, and the program says so once.
system_zone=():>Zone=>{
    let pack=__settings_rule_id
    if not __settings_rule_dynamic {
        let saved=cache.system_get
        if saved >=? 0 {return Zone[saved]}
    }
    let name=__system_zone_name
    let chosen:Zone=match _machine_named(name) {
        z:Zone=>z
        e:UnknownZone=>{
            let why=if name =? "" "this machine names no time zone" else "this machine's time zone is called '{name}', which the time rules do not know"
            if cache.system_warn_once {
                __write_err("warning: {why}, so times here read as UTC: set the TZ variable, or name a zone with `$time.zone = 'America/New_York'`\n")
            }
            zone_parse("UTC") ?? Zone[__settings_zone_handle(0 pack)]
        }
    }
    if not __settings_rule_dynamic {cache.system_set(chosen._entry)}
    chosen
}
# (what is wrong with a `$time.zone` value; only a name can be)
zone_scope_error=(scope:string|none):>string?=>{
    if scope is? none or scope =? 'system' {return none}
    match _machine_named(scope) {
        z:Zone=>none
        e:UnknownZone=>e.message
    }
}
# A named zone or the machine's, as `$time.zone` says.
scope_zone=(scope:string|none):>Zone|UnknownZone=>{
    if scope isnt? none {
        let bound=__settings_zone_bound(scope)
        if bound >=? 0 {return Zone[bound]}
    }
    if scope is? none or scope =? 'system' {return system_zone}
    _machine_named(scope)
}

# ---------------- offsets ----------------
_record=(z:Zone):>int64=>{
    let pack_bytes=_zone_rules(z)
    if __settings_zone_host(z._entry) {_host_record(z)} else {_u32(_entry_at(__settings_zone_index(z._entry))+8 pack_bytes)}
}
_be32=(d:array<uint8> at:int64):>int64=>$unsafe {
    (int64(d[at]) << 24) + (int64(d[at+1]) << 16) + (int64(d[at+2]) << 8) + int64(d[at+3])
}
_be64=(d:array<uint8> at:int64):>int64=>$unsafe {
    let v:int64<overflow='wrap'>=0
    loop i in [0..8) {
        v=(v << 8)+int64<overflow='wrap'>(d[at+i])
    }
    int64<overflow='wrap'>(v)
}
_put32=(v:int64):>void=>{
    loop i in [0..4) {cache.push_rule(uint8((v >> (8*i)) & 255))}
}
_put64=(v:int64):>void=>{
    loop i in [0..8) {cache.push_rule(uint8((v >> (8*i)) & 255))}
}
# A zone's TZif file as a record of the pack's form, kept past its end (tools/time/gen_rules.py makes
# the same from the same files), or -1 when this machine has no such file. O(file).
_host_read=(zone_name:string pack_bytes:array<uint8>):>int64=>$unsafe {
    let d=read_bytes(p("{env("TZDIR") ?? "/usr/share/zoneinfo"}/{zone_name}"))
    if d isnt? array<uint8> or d.length <? 44 or d[0] not=? 84 or d[1] not=? 90 or d[2] not=? 105 or d[3] not=? 102 or d[4] <? 50 {return -1}
    let at=44+_be32(d 32)*5+_be32(d 36)*6+_be32(d 40)+_be32(d 28)*8+_be32(d 24)+_be32(d 20)
    if d.length <? at+44 {return -1}
    let isut=_be32(d at+20)
    let isstd=_be32(d at+24)
    let leap=_be32(d at+28)
    let times=_be32(d at+32)
    let kinds=_be32(d at+36)
    let chars=_be32(d at+40)
    let moments=at+44
    let indexes=moments+times*8
    let types=indexes+times
    let footer=types+kinds*6+chars+leap*12+isstd+isut
    if d.length <? footer or kinds <? 1 {return -1}
    let first=_signed32(_be32(d types))
    let last=first
    let last_dst:int64=-1
    let changes:array<int64>=[]
    let offsets:array<int64>=[]
    let flags:array<int64>=[]
    # (drop the "big bang" sentinel and changes that change nothing)
    loop i in [0..times) {
        let kind=types+int64(d[indexes+i])*6
        if kind+6 >? footer {return -1}
        let moment=_be64(d moments+i*8)
        let offset=_signed32(_be32(d kind))
        let dst=int64(d[kind+4])
        if moment <=? -576460752303423488 {
            first=offset
            last=offset
            continue
        }
        if offset =? last and changes.length >? 0 and last_dst =? dst {continue}
        changes.push(moment)
        offsets.push(offset)
        flags.push(dst)
        last=offset
        last_dst=dst
    }
    let rule_start=footer
    let rule_stop=d.length
    loop rule_start <? rule_stop and d[rule_start] =? 10 {rule_start=rule_start+1}
    loop rule_stop >? rule_start and d[rule_stop-1] =? 10 {rule_stop=rule_stop-1}
    let record=pack_bytes.length+cache.rule_count
    let size=16+changes.length*13
    _put32(first)
    _put32(changes.length)
    _put32(record+size)
    _put32(rule_stop-rule_start)
    loop c in changes {_put64(c)}
    loop o in offsets {_put32(o)}
    loop f in flags {cache.push_rule(uint8(f))}
    loop i in [rule_start..rule_stop) {cache.push_rule(d[i])}
    record
}
_signed32=(v:int64):>int64=>if v >=? 2147483648 {v-4294967296} else {v}
_host_record_raw=(z:Zone):>int64=>$unsafe {
    let pack_bytes=_zone_rules(z)
    let saved=cache.find_record(z._entry)
    if saved isnt? none {return saved}
    let record=_host_read(name(z) pack_bytes)
    cache.save_record(z._entry record)
    record
}
_host_record=(z:Zone):>int64=>{
    let pack_bytes=_zone_rules(z)
    let record=_host_record_raw(z)
    if record <? 0 {
        if cache.warn_once {
            __write_err("warning: `$time.zone_source = 'host'`, but this machine has no rules for {name(z)}, so it keeps those of Dewy's own pack, {rules_version()}\n")
        }
        return _u32(_entry_at(__settings_zone_index(z._entry))+8 pack_bytes)
    }
    record
}

# The host's edition is evidence of ordering only when tzdata.zi names it. A differing host file
# with no known publication order must not be called stale.
_host_revision=():>string|none=>$unsafe {
    let d=read_bytes(p("{env("TZDIR") ?? "/usr/share/zoneinfo"}/tzdata.zi"))
    if d isnt? array<uint8> or d.length <? 16 {return none}
    let prefix="# version " as array<uint8>
    loop i in [0..10) {if d[i] not=? prefix[i] {return none}}
    let last:int64=10
    loop last <? d.length and d[last] not=? 10 {last=last+1}
    if last-10 <? 5 {return none}
    let revision:array<uint8>=[]
    loop i in [10..last) {revision.push(d[i])}
    "iana-{str_from_bytes(revision)}"
}
_rules_differ=(pinned:int64 host:int64 pack_bytes:array<uint8>):>bool=>{
    if _u32(pinned pack_bytes) not=? _u32(host pack_bytes) or _u32(pinned+4 pack_bytes) not=? _u32(host+4 pack_bytes) or _u32(pinned+12 pack_bytes) not=? _u32(host+12 pack_bytes) {return true}
    let bytes=_u32(pinned+4 pack_bytes)*13
    loop i in [0..bytes) {if _rule_byte(pinned+16+i pack_bytes) not=? _rule_byte(host+16+i pack_bytes) {return true}}
    let n=_u32(pinned+12 pack_bytes)
    let a=_u32(pinned+8 pack_bytes)
    let b=_u32(host+8 pack_bytes)
    loop i in [0..n) {if _rule_byte(a+i pack_bytes) not=? _rule_byte(b+i pack_bytes) {return true}}
    false
}
_status_from=(pinned:string host:string differs:bool newer:bool):>ZonePackStale|_UnknownZonePackFreshness|none=>{
    if not differs {return none}
    if newer {return ZonePackStale[pinned host]}
    _UnknownZonePackFreshness[pinned host]
}
_host_identity=(z:Zone revision:string|none):>string=>{
    let bytes=read_bytes(p("{env("TZDIR") ?? "/usr/share/zoneinfo"}/{name(z)}"))
    if bytes isnt? array<uint8> {return "unidentified host rules"}
    let digest=sha256(bytes)
    match revision {
        value:string=>"{value} sha256:{digest}"
        <none>=>"sha256:{digest}"
    }
}
_zone_pack_status=(z:Zone):>ZonePackStale|_UnknownZonePackFreshness|none=>{
    let pack_bytes=_zone_rules(z)
    let host=_host_record_raw(z)
    if host <? 0 {return none}
    let pack=_u32(_entry_at(__settings_zone_index(z._entry))+8 pack_bytes)
    if not _rules_differ(pack host pack_bytes) {return none}
    let pack_version=_text_at(_u32(8 pack_bytes) _u32(12 pack_bytes) pack_bytes)
    let host_version=_host_revision
    let identity=_host_identity(z host_version)
    match host_version {
        edition:string=>_status_from(pack_version identity true pack_version <? edition)
        <none>=>_UnknownZonePackFreshness[pack_version identity]
    }
}
# The number of changes at or before a POSIX second, by binary search.
_changes_before=(record:int64 moment:int pack_bytes:array<uint8>):>int64=>{
    let count=_u32(record+4 pack_bytes)
    let lo:int64=0
    let hi=count
    loop lo <? hi {
        let mid=(lo+hi)//2
        if _i64(record+16+mid*8 pack_bytes) <=? moment {lo=mid+1} else {hi=mid}
    }
    lo
}
_offset_after=(record:int64 changes:int64 pack_bytes:array<uint8>):>int64=>{
    if changes =? 0 {return _i32(record pack_bytes)}
    _i32(record+16+_u32(record+4 pack_bytes)*8+(changes-1)*4 pack_bytes)
}
# Seconds east of UTC at a POSIX second, by the table and then by the zone's POSIX rule.
offset_at=(z:Zone moment:int):>int64=>{
    let pack_bytes=_zone_rules(z)
    let record=_record(z)
    let count=_u32(record+4 pack_bytes)
    let changes=_changes_before(record moment pack_bytes)
    if changes <? count or _u32(record+12 pack_bytes) =? 0 {return _offset_after(record changes pack_bytes)}
    _rule_offset(record moment pack_bytes)
}

# ---------------- the POSIX TZ rule after the table ----------------
# `std offset [dst [offset] [,start[/time],end[/time]]]`, read from the pack in place.
_Rule:type=[at:int64 stop:int64 pack_bytes:array<uint8>]
_skip_name=(@r:_Rule):>void=>{
    if _u8(r.at r.pack_bytes) =? 60 {
        loop r.at <? r.stop and _u8(r.at r.pack_bytes) not=? 62 {r.at=r.at+1}
        r.at=r.at+1
        return
    }
    loop r.at <? r.stop and ((_u8(r.at r.pack_bytes) >=? 65 and _u8(r.at r.pack_bytes) <=? 90) or (_u8(r.at r.pack_bytes) >=? 97 and _u8(r.at r.pack_bytes) <=? 122)) {r.at=r.at+1}
}
_number=(@r:_Rule):>int64=>{
    let v:int64=0
    loop r.at <? r.stop and _u8(r.at r.pack_bytes) >=? 48 and _u8(r.at r.pack_bytes) <=? 57 {
        v=v*10+_u8(r.at r.pack_bytes)-48
        r.at=r.at+1
    }
    v
}
# hh[:mm[:ss]], signed: seconds.
_hms=(@r:_Rule):>int64=>{
    let sign:int64=1
    if r.at <? r.stop and _u8(r.at r.pack_bytes) =? 45 {
        sign=-1
        r.at=r.at+1
    } else if r.at <? r.stop and _u8(r.at r.pack_bytes) =? 43 {r.at=r.at+1}
    let v=_number(@r)*3600
    if r.at <? r.stop and _u8(r.at r.pack_bytes) =? 58 {
        r.at=r.at+1
        v=v+_number(@r)*60
        if r.at <? r.stop and _u8(r.at r.pack_bytes) =? 58 {
            r.at=r.at+1
            v=v+_number(@r)
        }
    }
    sign*v
}
_weekday_of=(days:int):>int64=>((days+4)%7).to_int64() ?? 0
# A `Mm.n.d[/time]`, `Jn` or `n` date in a year: local seconds since 1970 at which it falls.
_rule_date=(@r:_Rule year:int):>int=>{
    let days:int=0
    let b=_u8(r.at r.pack_bytes)
    if b =? 77 {
        r.at=r.at+1
        let month=_number(@r)
        r.at=r.at+1
        let week=_number(@r)
        r.at=r.at+1
        let weekday=_number(@r)
        let first=days_from_civil(year month 1)
        let delta=(weekday-_weekday_of(first)+7)%7
        let day=int(delta)+int(week-1)*7
        let length=int(days_in_month(year month))
        loop day >=? length {day=day-7}
        days=first+day
    } else if b =? 74 {
        r.at=r.at+1
        let n=_number(@r)
        let extra:int64=if days_in_month(year 2) =? 29 and n >=? 60 {1} else {0}
        days=days_from_civil(year 1 1)+int(n)-1+int(extra)
    } else {
        days=days_from_civil(year 1 1)+int(_number(@r))
    }
    let time:int64=7200
    if r.at <? r.stop and _u8(r.at r.pack_bytes) =? 47 {
        r.at=r.at+1
        time=_hms(@r)
    }
    days*86400+int(time)
}
_rule_offset=(record:int64 moment:int pack_bytes:array<uint8>):>int64=>{
    let start=_u32(record+8 pack_bytes)
    let r=_Rule[start start+_u32(record+12 pack_bytes) pack_bytes]
    _skip_name(@r)
    let standard=-_hms(@r)
    if r.at >=? r.stop {return standard}
    _skip_name(@r)
    let daylight=standard+3600
    if r.at <? r.stop and _u8(r.at pack_bytes) not=? 44 {daylight=-_hms(@r)}
    if r.at >=? r.stop {return standard}
    r.at=r.at+1
    let [year _m _d]=civil_from_days(int(moment+standard)//86400)
    let on=_rule_date(@r year)-int(standard)
    r.at=r.at+1
    let off=_rule_date(@r year)-int(daylight)
    let t=int(moment)
    let in_dst=if on <? off {t >=? on and t <? off} else {not (t >=? off and t <? on)}
    if in_dst {daylight} else {standard}
}

# ---------------- moments in a zone, and local times back to moments ----------------
const _MJD_1970:int=40587
_posix_of=(t:Instant):>int64|OutsideCoverage=>{
    let label=_axis_to_utc(ns_count(t))
    if label is? none {return OutsideCoverage["UTC, and so a zone's rules, starts in 1961"]}
    let [mjd in_day]=label
    let seconds=(mjd-_MJD_1970)*86400+(if in_day >=? _DAY_NS {86399} else {in_day//_NS})
    seconds.to_int64() ?? 0
}
# The old coverage-checked projection stays private until its public spelling is decided.
_checked_in_zone=(t:Instant z:Zone):>ZonedDateTime|OutsideCoverage=>ZonedDateTime[t z Offset[int32<overflow='wrap'>(offset_at(z _posix_of(t) or_throw))]]
# Provisional total projection: UTC where defined; otherwise the instant's TT civil label.
# This does not extend the UTC reader or invent a historical UTC standard. The zone's first
# offset is LMT, and its footer governs the future. Keep seconds exact across the whole axis.
_zone_label=(t:Instant):>[int int]=>{
    let axis=ns_count(t)
    let utc=_axis_to_utc(axis)
    if utc isnt? none {return utc}
    let tt=axis+32184000000
    [43144+tt//_DAY_NS tt%_DAY_NS]
}
_zone_seconds=(t:Instant):>int=>{
    let [mjd in_day]=_zone_label(t)
    (mjd-_MJD_1970)*86400+(if in_day >=? _DAY_NS {86399} else {in_day//_NS})
}
in_zone=(t:Instant z:Zone):>ZonedDateTime=>ZonedDateTime[t z Offset[int32<overflow='wrap'>(offset_at(z _zone_seconds(t)))]]
_at=(moment:int64 nanos:int z:Zone offset:int64):>ZonedDateTime|OutsideCoverage|OffGrid|InvalidFields=>{
    let days=int(moment)//86400
    let axis=_utc_to_axis(days+_MJD_1970 (int(moment)%86400)*_NS+nanos) or_throw
    ZonedDateTime[instant_at(axis) z Offset[int32<overflow='wrap'>(offset)]]
}
_local_text=(local:int):>string=>{
    let [y m d]=civil_from_days(int(local)//86400)
    let t=local%86400
    "{_year_text(y)}-{pad(m 2)}-{pad(d 2)}T{pad(t//3600 2)}:{pad((t%3600)//60 2)}:{pad(t%60 2)}"
}
_pair_text=(offset:int64):>string=>{
    let size=if offset <? 0 {-offset} else {offset}
    let sign=if offset <? 0 {"-"} else {"+"}
    # (the seconds of an old local mean time, as Monrovia's -00:44:30, when it has them)
    let seconds=if size%60 =? 0 {""} else {":{pad(size%60 2)}"}
    "{sign}{pad(size//3600 2)}:{pad((size%3600)//60 2)}{seconds}"
}
__as__=(o:Offset):>string=>_pair_text(int64(o._seconds))
__eq__=(a:Offset b:Offset):>bool=>a._seconds =? b._seconds
__lt__=(a:Offset b:Offset):>bool=>a._seconds <? b._seconds
_FoldPolicy:type='earlier'|'later'|'reject'
_GapPolicy:type='preserve_displacement'|'next'|'reject'
_FoldChoice:type=_FoldPolicy|'all'
_GapChoice:type=_GapPolicy|'skip'
# Local seconds in a zone: the moment under the policies, or the Gap or Ambiguous with no policy.
_resolve=(local:int64 nanos:int z:Zone fold:_FoldChoice|none gap:_GapChoice|none):>ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous|OutsideCoverage|OffGrid|InvalidFields=>{
    let pack_bytes=_zone_rules(z)
    let record=_record(z)
    let window:int64=93600
    let early=offset_at(z local-window)
    let late=offset_at(z local+window)
    let seen:array<int64>=[early]
    let first=_changes_before(record local-window pack_bytes)
    let last=_changes_before(record local+window pack_bytes)
    let i=first
    loop i <? last {
        let o=_offset_after(record i+1 pack_bytes)
        if not seen.contains(o) {seen.push(o)}
        i=i+1
    }
    if not seen.contains(late) {seen.push(late)}
    # (each offset whose moment really reads that offset, earliest moment first: largest offset first)
    let found:array<int64>=[]
    loop o in seen {
        if offset_at(z local-o) =? o {found.push(o)}
    }
    found.sort(reverse=true)
    if found.length =? 1 {
        let resolved=_at(local-found[0] nanos z found[0]) or_throw
        if fold =? 'all' {return [resolved]}
        return resolved
    }
    if found.length =? 0 {
        # (a gap: at local-largest the clocks had not yet jumped, and at local-smallest they had)
        let widest=seen[0]
        let narrowest=seen[0]
        loop o in seen {
            if o >? widest {widest=o}
            if o <? narrowest {narrowest=o}
        }
        let before=offset_at(z local-widest)
        let after=offset_at(z local-narrowest)
        if gap =? 'preserve_displacement' {return _at(local-before nanos z after)}
        if gap =? 'next' {
            # (the change itself, whether the table or the zone's rule made it: the first moment
            # after the gap, found between those two moments by the offsets alone)
            let low=local-widest
            let high=local-narrowest
            loop high-low >? 1 {
                let middle=low+(high-low)//2
                if offset_at(z middle) =? before {low=middle} else {high=middle}
            }
            return _at(high 0 z offset_at(z high))
        }
        if gap =? 'skip' {return none}
        return Gap["{_local_text(local)} does not exist in {name(z)}: the clocks jumped from {_pair_text(before)} to {_pair_text(after)}. Add gap='preserve_displacement' or gap='next'" int(before) int(after)]
    }
    if fold =? 'earlier' {return _at(local-found[0] nanos z found[0])}
    if fold =? 'later' {return _at(local-found[found.length-1] nanos z found[found.length-1])}
    if fold =? 'all' {
        let candidates:array<ZonedDateTime>=[]
        loop o in found {candidates.push(_at(local-o nanos z o) or_throw)}
        return candidates
    }
    Ambiguous["{_local_text(local)} happens more than once in {name(z)}. Add fold='earlier' or fold='later'" [loop o in found int(o)]]
}

# The single-result path keeps the narrow policy types and result shape. Constant evaluation of
# a zoned literal can then prove a named policy without widening a literal union during the call.
_resolve_one=(local:int64 nanos:int z:Zone fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous|OutsideCoverage|OffGrid|InvalidFields=>{
    let pack_bytes=_zone_rules(z)
    let record=_record(z)
    let window:int64=93600
    let early=offset_at(z local-window)
    let late=offset_at(z local+window)
    let seen:array<int64>=[early]
    let first=_changes_before(record local-window pack_bytes)
    let last=_changes_before(record local+window pack_bytes)
    let i=first
    loop i <? last {
        let o=_offset_after(record i+1 pack_bytes)
        if not seen.contains(o) {seen.push(o)}
        i=i+1
    }
    if not seen.contains(late) {seen.push(late)}
    let found:array<int64>=[]
    loop o in seen {
        if offset_at(z local-o) =? o {found.push(o)}
    }
    found.sort(reverse=true)
    if found.length =? 1 {return _at(local-found[0] nanos z found[0])}
    if found.length =? 0 {
        let widest=seen[0]
        let narrowest=seen[0]
        loop o in seen {
            if o >? widest {widest=o}
            if o <? narrowest {narrowest=o}
        }
        let before=offset_at(z local-widest)
        let after=offset_at(z local-narrowest)
        if gap =? 'preserve_displacement' {return _at(local-before nanos z after)}
        if gap =? 'next' {
            let low=local-widest
            let high=local-narrowest
            loop high-low >? 1 {
                let middle=low+(high-low)//2
                if offset_at(z middle) =? before {low=middle} else {high=middle}
            }
            return _at(high 0 z offset_at(z high))
        }
        return Gap["{_local_text(local)} does not exist in {name(z)}: the clocks jumped from {_pair_text(before)} to {_pair_text(after)}. Add gap='preserve_displacement' or gap='next'" int(before) int(after)]
    }
    if fold =? 'earlier' {return _at(local-found[0] nanos z found[0])}
    if fold =? 'later' {return _at(local-found[found.length-1] nanos z found[found.length-1])}
    Ambiguous["{_local_text(local)} happens more than once in {name(z)}. Add fold='earlier' or fold='later'" [loop o in found int(o)]]
}

# The zone of a time: written in its text, or given, or the scope's. A literal cannot assume.
_zone_for=(written:Zone|none given:Zone|none scope:string|none running:bool):>Zone|UnknownZone|MissingContext=>{
    if written isnt? none {return written}
    if given isnt? none {return given}
    if not running and (scope is? none or scope =? 'system') {
        return MissingContext["there is no zone to read this in, and a literal cannot assume one: write it in the text, `2026-10-26T09:00[America/New_York]`, pass `zone=`, or set `$time.zone`"]
    }
    # (unspecified means the running machine, and the call has already warned)
    if scope isnt? none {
        let bound=__settings_zone_bound(scope)
        if bound >=? 0 {return Zone[bound]}
    }
    if scope is? none or scope =? 'system' {return system_zone}
    _machine_named(scope)
}
# `2026-10-26T09:00[America/New_York]`, or local text with a `zone`, or the scope's `$time.zone`.
zoned_parse=(text:string zone:Zone|none fold:_FoldChoice|none gap:_GapChoice|none scope:string|none running:bool=true):>ZonedDateTime|array<ZonedDateTime>|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>{
    let c=_Cursor[text 0]
    let f=read_fields(@c) or_throw
    if not f.has_time {return ParseError["a zoned time needs a time of day, as `2026-10-26T09:00[America/New_York]`"]}
    let written=read_offset(@c) or_throw
    let bytes=text as array<uint8>
    let written_zone:Zone|none=none
    if _byte(c c.at) =? 91 {
        let close=c.at
        loop close <? bytes.length and _byte(c close) not=? 93 {close=close+1}
        if close =? bytes.length {return ParseError["a zone in brackets closes with `]`"]}
        written_zone=zone_parse(text[c.at+1..close)) or_throw
        c.at=close+1
    }
    if c.at not=? bytes.length {return ParseError["unexpected text after the time"]}
    let chosen=_zone_for(written_zone zone scope running) or_throw
    if f.second =? 60 {return InvalidFields["a :60 second is a UTC label: use `utc`"]}
    let days=days_from_civil(f.year f.month f.day)
    let local=(days*86400+int(f.hour)*3600+int(f.minute)*60+int(f.second)).to_int64() ?? 0
    if written not=? NO_OFFSET {
        # (an offset beside a zone says which reading: it must be one the zone had)
        let moment=local-written
        if offset_at(chosen moment) not=? written {return ParseError["{name(chosen)} was not at {_pair_text(written)} then"]}
        return _at(moment int(f.nanosecond) chosen written)
    }
    _resolve(local int(f.nanosecond) chosen fold gap)
}
_zoned_one=(r:ZonedDateTime|array<ZonedDateTime>|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields):>ZonedDateTime|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>match r {
    z:ZonedDateTime=>z
    zs:array<ZonedDateTime>=>Ambiguous["a single resolution cannot return every candidate" []]
    <none>=>Gap["a single resolution cannot skip a local time" 0 0]
    e:ParseError=>e
    e:Gap=>e
    e:Ambiguous=>e
    e:UnknownZone=>e
    e:MissingContext=>e
    e:OutsideCoverage=>e
    e:InvalidFields=>e
    <OffGrid>=>OffGrid
}
zoned_parse_one=(text:string zone:Zone|none fold:_FoldPolicy|none gap:_GapPolicy|none scope:string|none running:bool=true):>ZonedDateTime|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>{
    let c=_Cursor[text 0]
    let f=read_fields(@c) or_throw
    if not f.has_time {return ParseError["a zoned time needs a time of day, as `2026-10-26T09:00[America/New_York]`"]}
    let written=read_offset(@c) or_throw
    let bytes=text as array<uint8>
    let written_zone:Zone|none=none
    if _byte(c c.at) =? 91 {
        let close=c.at
        loop close <? bytes.length and _byte(c close) not=? 93 {close=close+1}
        if close =? bytes.length {return ParseError["a zone in brackets closes with `]`"]}
        written_zone=zone_parse(text[c.at+1..close)) or_throw
        c.at=close+1
    }
    if c.at not=? bytes.length {return ParseError["unexpected text after the time"]}
    let chosen=_zone_for(written_zone zone scope running) or_throw
    if f.second =? 60 {return InvalidFields["a :60 second is a UTC label: use `utc`"]}
    let days=days_from_civil(f.year f.month f.day)
    let local=(days*86400+int(f.hour)*3600+int(f.minute)*60+int(f.second)).to_int64() ?? 0
    if written not=? NO_OFFSET {
        let moment=local-written
        if offset_at(chosen moment) not=? written {return ParseError["{name(chosen)} was not at {_pair_text(written)} then"]}
        return _at(moment int(f.nanosecond) chosen written)
    }
    _resolve_one(local int(f.nanosecond) chosen fold gap)
}
_zoned_all=(r:ZonedDateTime|array<ZonedDateTime>|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields):>array<ZonedDateTime>|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>match r {
    z:ZonedDateTime=>[z]
    zs:array<ZonedDateTime>=>zs
    <none>=>Gap["a resolution that returns all candidates cannot skip a local time" 0 0]
    e:ParseError=>e
    e:Gap=>e
    e:Ambiguous=>e
    e:UnknownZone=>e
    e:MissingContext=>e
    e:OutsideCoverage=>e
    e:InvalidFields=>e
    <OffGrid>=>OffGrid
}
_zoned_skip=(r:ZonedDateTime|array<ZonedDateTime>|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields):>ZonedDateTime|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>match r {
    z:ZonedDateTime=>z
    zs:array<ZonedDateTime>=>Ambiguous["a resolution with no fold policy cannot return every candidate" []]
    <none>=>none
    e:ParseError=>e
    e:Gap=>e
    e:Ambiguous=>e
    e:UnknownZone=>e
    e:MissingContext=>e
    e:OutsideCoverage=>e
    e:InvalidFields=>e
    <OffGrid>=>OffGrid
}
zoned_parse_all=(text:string zone:Zone|none gap:_GapPolicy|none scope:string|none running:bool=true):>array<ZonedDateTime>|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>_zoned_all(zoned_parse(text zone 'all' gap scope running))
zoned_parse_skip=(text:string zone:Zone|none fold:_FoldPolicy|none scope:string|none running:bool=true):>ZonedDateTime|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>_zoned_skip(zoned_parse(text zone fold 'skip' scope running))
zoned_parse_all_skip=(text:string zone:Zone|none scope:string|none running:bool=true):>array<ZonedDateTime>|none|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>{
    let r=zoned_parse(text zone 'all' 'skip' scope running)
    if r is? ZonedDateTime {return [r]}
    r
}
# (a literal needs rules while compiling, and `'host'` has none until the program runs)
const _HOST_LITERAL="`$time.zone_source = 'host'` follows this machine's rules when the program runs, so a literal cannot be worked out from them: read it from text at run time, as `zoned(text)`"
zoned_error_one=(text:string zone:Zone|none fold:_FoldPolicy|none gap:_GapPolicy|none scope:string|none):>string?=>{
    if _use_host {return _HOST_LITERAL}
    match zoned_parse_one(text zone fold gap scope false) {
        z:ZonedDateTime=>none
        e:ParseError=>e.message
        e:Gap=>e.message
        e:Ambiguous=>e.message
        e:UnknownZone=>e.message
        e:MissingContext=>e.message
        e:OutsideCoverage=>e.message
        e:InvalidFields=>e.message
        <OffGrid>=>"that label falls between nanoseconds under the UTC rate of its time"
    }
}
zoned_text_error_one=(text:string fold:_FoldPolicy|none gap:_GapPolicy|none scope:string|none):>string?=>zoned_error_one(text none fold gap scope)
zoned_error=(text:string zone:Zone|none fold:_FoldChoice|none gap:_GapChoice|none scope:string|none):>string?=>{
    if _use_host {return _HOST_LITERAL}
    match zoned_parse(text zone fold gap scope false) {
        z:ZonedDateTime=>none
        z:array<ZonedDateTime>=>none
        <none>=>none
        e:ParseError=>e.message
        e:Gap=>e.message
        e:Ambiguous=>e.message
        e:UnknownZone=>e.message
        e:MissingContext=>e.message
        e:OutsideCoverage=>e.message
        e:InvalidFields=>e.message
        <OffGrid>=>"that label falls between nanoseconds under the UTC rate of its time"
    }
}

# (the same with no zone given)
zoned_text_error=(text:string fold:_FoldChoice|none gap:_GapChoice|none scope:string|none):>string?=>zoned_error(text none fold gap scope)

# ---------------- zoned values ----------------
_local=(z:ZonedDateTime):>int=>_zone_seconds(z.nominal)+int(z.offset._seconds)
__as__=(z:ZonedDateTime):>string=>{
    let [_m in_day]=_zone_label(z.nominal)
    "{_local_text(_local(z))}{_fraction_text(in_day%_NS)}{_pair_text(int64(z.offset._seconds))}[{name(z.zone)}]"
}
# Elapsed time: a zoned value moves as its instant does.
__add__=(z:ZonedDateTime d:Duration):>ZonedDateTime=>in_zone(z.nominal+d z.zone)
__sub__=(z:ZonedDateTime d:Duration):>ZonedDateTime=>in_zone(z.nominal-d z.zone)
__add__=(z:ZonedDateTime q:int*Time):>ZonedDateTime=>in_zone(z.nominal+q z.zone)
__sub__=(z:ZonedDateTime q:int*Time):>ZonedDateTime=>in_zone(z.nominal-q z.zone)
__sub__=(a:ZonedDateTime b:ZonedDateTime):>Duration=>a.nominal-b.nominal
__eq__=(a:ZonedDateTime b:ZonedDateTime):>bool=>a.nominal =? b.nominal and a.zone =? b.zone
__lt__=(a:ZonedDateTime b:ZonedDateTime):>bool=>a.nominal <? b.nominal
# The local fields on a date with the same time of day, under the scope's policies.
# (a move past the table, or onto a pre-1972 label between nanoseconds, has no local time either)
_civil=(r:ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous|OutsideCoverage|OffGrid|InvalidFields):>ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous=>match r {
    z:ZonedDateTime=>z
    zs:array<ZonedDateTime>=>zs
    <none>=>none
    e:Gap=>e
    e:Ambiguous=>e
    e:OutsideCoverage=>Gap[e.message 0 0]
    e:InvalidFields=>Gap[e.message 0 0]
    <OffGrid>=>Gap["that label falls between nanoseconds under the UTC rate of its time" 0 0]
}
_day_add=(z:ZonedDateTime p:Days fold:_FoldChoice|none gap:_GapChoice|none):>ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous=>{
    _civil(_resolve((_local(z)+int(p.count)*86400).to_int64() ?? 0 int(_nanos(z)) z.zone fold gap))
}
_month_add=(z:ZonedDateTime p:Months fold:_FoldChoice|none gap:_GapChoice|none):>ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous|InvalidDate=>{
    let local=_local(z)
    let t=(local%86400).to_int64() ?? 0
    let [y m d]=civil_from_days(int(local)//86400)
    let total=y*12+int(m)-1+int(p.count)
    let ny=total//12
    let nm=((total%12).to_int64() ?? 0)+1
    if d >? days_in_month(ny nm) {return InvalidDate["{_year_text(ny)}-{pad(nm 2)} has no day {d}"]}
    _civil(_resolve(((days_from_civil(ny nm d)*86400).to_int64() ?? 0)+t int(_nanos(z)) z.zone fold gap))
}
_month_add_named=(z:ZonedDateTime p:Months overflow:_Overflow fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous=>{
    let local=_local(z)
    let t=(local%86400).to_int64() ?? 0
    let [y m d]=civil_from_days(int(local)//86400)
    let total=y*12+int(m)-1+int(p.count)
    let ny=total//12
    let nm=((total%12).to_int64() ?? 0)+1
    if d >? days_in_month(ny nm) {
        if overflow =? 'clamp' {d=days_in_month(ny nm)}
        else {
            let next=total+1
            ny=next//12
            nm=((next%12).to_int64() ?? 0)+1
            d=1
        }
    }
    let day_start=(days_from_civil(ny nm d)*86400).to_int64() ?? 0
    let resolved=_resolve(day_start+t int(_nanos(z)) z.zone fold gap)
    _civil_one(_civil(resolved))
}
_civil_one=(r:ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous):>ZonedDateTime|Gap|Ambiguous=>match r {
    z:ZonedDateTime=>z
    zs:array<ZonedDateTime>=>Ambiguous["a single resolution cannot return every candidate" []]
    <none>=>Gap["a single resolution cannot skip a local time" 0 0]
    e:Gap=>e
    e:Ambiguous=>e
}
_day_add_one=(z:ZonedDateTime p:Days fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous=>_civil_one(_day_add(z p fold gap))
_month_add_one=(z:ZonedDateTime p:Months fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>match _month_add(z p fold gap) {
    zdt:ZonedDateTime=>zdt
    zs:array<ZonedDateTime>=>Ambiguous["a single resolution cannot return every candidate" []]
    <none>=>Gap["a single resolution cannot skip a local time" 0 0]
    e:Gap=>e
    e:Ambiguous=>e
    e:InvalidDate=>e
}
# (what is wrong with these constants; none when the add resolves)
day_add_error=(z:ZonedDateTime p:Days fold:_FoldChoice|none gap:_GapChoice|none):>string?=>match _day_add(z p fold gap) {
    r:ZonedDateTime=>none
    rs:array<ZonedDateTime>=>none
    <none>=>none
    e:Gap=>e.message
    e:Ambiguous=>e.message
}
# (both policies written: nothing is left to fail. Empty text: no promise, and no error.)
policy_gap=(fold:_FoldChoice|none gap:_GapChoice|none):>string?=>if fold is? none or gap is? none or fold =? 'reject' or gap =? 'reject' {""} else {none}

$check_constant day_add_error(z p fold gap) "this add has no one answer"
$check_constant policy_gap(fold gap) "unused"
__add__=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_day_add_one(z p fold gap)
$check_constant day_add_error(z p fold gap) "this add has no one answer"
$check_constant policy_gap(fold gap) "unused"
__sub__=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_day_add_one(z Days[-p.count] fold gap)
__add__=(z:ZonedDateTime p:Months fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>_month_add_one(z p fold gap)
_recipe_add=(z:ZonedDateTime p:_Recipe fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>{
    let current=z
    loop step in p.steps {
        match step {
            days:Days=>{current=_day_add_one(current days fold gap) or_throw}
            months:Months=>{current=_month_add_one(current months fold gap) or_throw}
        }
    }
    current
}
recipe_add_error=(z:ZonedDateTime p:_Recipe fold:_FoldPolicy|none gap:_GapPolicy|none):>string?=>match _recipe_add(z p fold gap) {
    r:ZonedDateTime=>none
    e:Gap=>e.message
    e:Ambiguous=>e.message
    e:InvalidDate=>e.message
}
$check_constant recipe_add_error(z p fold gap) "this period has no one answer"
$check_constant policy_gap(fold gap) "unused"
__add__=(z:ZonedDateTime p:_Recipe fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>_recipe_add(z p fold gap)
__add__=(z:ZonedDateTime p:Days|Months|_Recipe|_DatePeriod fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>match p {
    days:Days=>_day_add_one(z days fold gap)
    months:Months=>_month_add_one(z months fold gap)
    recipe:_Recipe=>_recipe_add(z recipe fold gap)
    span:_DatePeriod=>_day_add_one(z Days[span.total_days] fold gap)
}
$check_constant day_add_error(z p fold gap) "this add has no one answer"
$check_constant policy_gap(fold gap) "unused"
add=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_day_add_one(z p fold gap)
$check_constant day_add_error(z p fold gap) "this add has no candidates"
add=(z:ZonedDateTime p:Days fold:'all' gap:_GapPolicy|none=$time.gap):>array<ZonedDateTime>|Gap|Ambiguous=>_civil_all(_day_add(z p fold gap))
$check_constant day_add_error(z p fold gap) "this add has no answer"
add=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:'skip'):>ZonedDateTime|none|Gap|Ambiguous=>_civil_skip(_day_add(z p fold gap))
$check_constant day_add_error(z p fold gap) "this add has no answer"
add=(z:ZonedDateTime p:Days fold:'all' gap:'skip'):>array<ZonedDateTime>|none|Gap|Ambiguous=>_civil_all_skip(_day_add(z p fold gap))
add=(z:ZonedDateTime p:Months overflow:_Overflow fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_month_add_named(z p overflow fold gap)

# The local date of an instant in a zone.
local_days=(t:Instant z:Zone):>int=>{
    let moment=_zone_seconds(t)
    (moment+int(offset_at(z moment)))//86400
}

# ---------------- what a zoned time reads as ----------------
_seconds_today=(z:ZonedDateTime):>int64<n => n >=? 0 and n <=? 86399>=>(_local(z)%86400).to_int64() ?? 0
_nanos=(z:ZonedDateTime):>int64=>{
    let [_m in_day]=_zone_label(z.nominal)
    (in_day%_NS).to_int64() ?? 0
}
date=(z:ZonedDateTime):>Date=>_of_days(int(_local(z))//86400)
time_of_day=(z:ZonedDateTime):>TimeOfDay=>TimeOfDay[_seconds_today(z)*1000000000+_nanos(z)]
local=(z:ZonedDateTime):>LocalDateTime=>LocalDateTime<Gregorian>[date(z) time_of_day(z)]
year=(z:ZonedDateTime):>int=>civil_from_days(int(_local(z))//86400)[0]
month=(z:ZonedDateTime):>int64<n => n >=? 1 and n <=? 12>=>civil_from_days(int(_local(z))//86400)[1]
day=(z:ZonedDateTime):>int64<n => n >=? 1 and n <=? 31>=>civil_from_days(int(_local(z))//86400)[2]
hour=(z:ZonedDateTime):>int64<n => n >=? 0 and n <=? 23>=>_seconds_today(z)//3600
minute=(z:ZonedDateTime):>int64<n => n >=? 0 and n <=? 59>=>(_seconds_today(z)%3600)//60
second=(z:ZonedDateTime):>int64<n => n >=? 0 and n <=? 59>=>_seconds_today(z)%60
nanosecond=(z:ZonedDateTime):>int64<n => n >=? 0 and n <=? 999999999>=>_nanos(z)
# 0 for Monday to 6 for Sunday.
weekday=(z:ZonedDateTime):>int64<n => n >=? 0 and n <=? 6>=>((int(_local(z))//86400+3)%7).to_int64() ?? 0

# A local time in a zone: the moment under the policies, or the Gap or Ambiguous with no policy.
local_in_zone=(l:LocalDateTime z:Zone fold:_FoldChoice|none gap:_GapChoice|none):>ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous=>{
    let days=int(l.date._days)
    let whole=l.time._ns//1000000000
    let moment=(days*86400).to_int64() ?? 0
    _civil(_resolve(moment+whole int(l.time._ns%1000000000) z fold gap))
}
local_in_zone_one=(l:LocalDateTime z:Zone fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous=>{
    let moment=(int(l.date._days)*86400).to_int64() ?? 0
    let whole=l.time._ns//1000000000
    match _resolve_one(moment+whole int(l.time._ns%1000000000) z fold gap) {
        value:ZonedDateTime=>value
        e:Gap=>e
        e:Ambiguous=>e
        e:OutsideCoverage=>Gap[e.message 0 0]
        e:InvalidFields=>Gap[e.message 0 0]
        <OffGrid>=>Gap["that label falls between nanoseconds under the UTC rate of its time" 0 0]
    }
}
_civil_all=(r:ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous):>array<ZonedDateTime>|Gap|Ambiguous=>match r {
    z:ZonedDateTime=>[z]
    zs:array<ZonedDateTime>=>zs
    <none>=>Gap["a resolution that returns all candidates cannot skip a local time" 0 0]
    e:Gap=>e
    e:Ambiguous=>e
}
_civil_skip=(r:ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous):>ZonedDateTime|none|Gap|Ambiguous=>match r {
    z:ZonedDateTime=>z
    zs:array<ZonedDateTime>=>Ambiguous["a resolution with no fold policy cannot return every candidate" []]
    <none>=>none
    e:Gap=>e
    e:Ambiguous=>e
}
local_in_zone_all=(l:LocalDateTime z:Zone gap:_GapPolicy|none):>array<ZonedDateTime>|Gap|Ambiguous=>_civil_all(local_in_zone(l z 'all' gap))
local_in_zone_skip=(l:LocalDateTime z:Zone fold:_FoldPolicy|none):>ZonedDateTime|none|Gap|Ambiguous=>_civil_skip(local_in_zone(l z fold 'skip'))
_civil_all_skip=(r:ZonedDateTime|array<ZonedDateTime>|none|Gap|Ambiguous):>array<ZonedDateTime>|none|Gap|Ambiguous=>{
    if r is? ZonedDateTime {return [r]}
    r
}
local_in_zone_all_skip=(l:LocalDateTime z:Zone):>array<ZonedDateTime>|none|Gap|Ambiguous=>_civil_all_skip(local_in_zone(l z 'all' 'skip'))
local_zone_error_one=(l:LocalDateTime z:Zone fold:_FoldPolicy|none gap:_GapPolicy|none):>string?=>match local_in_zone_one(l z fold gap) {
    value:ZonedDateTime=>none
    e:Gap=>e.message
    e:Ambiguous=>e.message
}
local_zone_error=(l:LocalDateTime z:Zone fold:_FoldChoice|none gap:_GapChoice|none):>string?=>match local_in_zone(l z fold gap) {
    r:ZonedDateTime=>none
    rs:array<ZonedDateTime>=>none
    <none>=>none
    e:Gap=>e.message
    e:Ambiguous=>e.message
}

# By a pattern, with `XXX` and `VV` for its offset and zone.
zoned_pattern_error=(p:string):>string?=>pattern.pattern_error(p true true true)
zoned_pattern_only=(p:string):>string?=>zoned_pattern_error(p) ?? ""
zoned_format_error=(z:ZonedDateTime p:string):>string?=>{
    let wrong=zoned_pattern_error(p)
    if wrong isnt? none {return wrong}
    pattern.offset_loss_error(p int64(z.offset._seconds))
}
$check_constant zoned_pattern_only(p) "not a pattern"
$check_constant zoned_format_error(z p) "this pattern loses offset seconds"
format=(z:ZonedDateTime p:string):>string|ParseError=>{
    let wrong=zoned_format_error(z p)
    if wrong isnt? none {return ParseError[wrong]}
    pattern.render(pattern.Parts[true true true year(z) month(z) day(z) weekday(z) hour(z) minute(z) second(z) nanosecond(z) int64(z.offset._seconds) name(z.zone)] p)
}

# The scope's zone, for `today` and `strict_today` (who): a name known only when running, if
# unknown, is said, and then the machine's zone is read instead.
today_zone=(scope:string|none who:string):>Zone=>match scope_zone(scope) {
    found:Zone=>found
    e:UnknownZone=>{
        __write_err("warning: {e.message}, so `{who}` reads the machine's zone instead\n")
        system_zone()
    }
}

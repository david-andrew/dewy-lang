# Zones of docs/design/time.md: the pinned rule pack (tools/time/gen_rules.py), offsets at a moment,
# local times resolved through gaps and folds, and zoned values. Only a program that reaches a
# zone operation links the pack.
import p"format.dewy" as pattern
from p"civil.dewy" import (Date TimeOfDay LocalDateTime Gregorian date_of _of_days _LeapDay)
from p"core.dewy" import (Instant Duration Days Months instant_at ns_count read_fields read_offset NO_OFFSET _Cursor Fields _byte _utc_to_axis _axis_to_utc civil_from_days days_from_civil days_in_month _year_text _fraction_text _DAY_NS _NS pad)
import p"core.dewy" as core
# (inside a function, so a program links the pack only if something still reads it when it runs:
# a literal folded while compiling does not)
_rules=():>array<uint8>=>{
    const pack=$include_bytes(p"rules/current.bin")
    pack
}

Zone:type=[_entry:int64]
ZonedDateTime:type=[nominal:Instant zone:Zone offset:int64]

# ---------------- reading the pack ----------------
# `$time.zone_source = 'host'`: a zone's rules are the machine's, read when it is first reached and
# kept past the pack's end. The pack still names the zones, and a literal cannot fold against them.
const _SOURCE:string|none=$time.zone_source
const _HOST:bool=_SOURCE =? 'host'
_host_rules:array<uint8>=[]
_host_zones:array<int64>=[]
_host_records:array<int64>=[]
_host_said:bool=false
_rule_byte=(at:int64):>int64=>$unsafe {
    if _HOST and at >=? _rules().length {int64(_host_rules[at-_rules().length])} else {int64(_rules()[at])}
}
_u8=(at:int64):>int64=>_rule_byte(at)
_u32=(at:int64):>int64=>_rule_byte(at) + (_rule_byte(at+1) << 8) + (_rule_byte(at+2) << 16) + (_rule_byte(at+3) << 24)
_i32=(at:int64):>int64=>{
    let v=_u32(at)
    if v >=? 2147483648 {v-4294967296} else {v}
}
_i64=(at:int64):>int64=>$unsafe {
    let v:int64<overflow='wrap'>=0
    loop i in [0..8) {
        v=v+(int64<overflow='wrap'>(_rule_byte(at+i)) << (8*i))
    }
    int64<overflow='wrap'>(v)
}
_zone_count=():>int64=>_u32(4)
_entry_at=(entry:int64):>int64=>24+entry*12
# (the name's bytes against text: negative, zero or positive)
_compare=(entry:int64 text:string):>int64=>$unsafe {
    let at=_u32(_entry_at(entry))
    let len=_u32(_entry_at(entry)+4)
    let bytes=text as array<uint8>
    let i:int64=0
    loop i <? len and i <? bytes.length {
        let a=int64(_rules()[at+i])
        let b=int64(bytes[i])
        if a not=? b {return a-b}
        i=i+1
    }
    len-bytes.length
}
_text_at=(at:int64 len:int64):>string=>$unsafe {
    # (pack names and rules are ASCII; this also runs at compile time, for a literal's message)
    let out:array<uint8>=[]
    loop i in [0..len) {out.push(_rules()[at+i])}
    str_from_bytes(out)
}
# The rule data this program's zones come from.
rules_version=():>string=>_text_at(_u32(8) _u32(12))

zone_parse=(name:string):>Zone|UnknownZone=>{
    let lo:int64=0
    let hi=_zone_count()
    loop lo <? hi {
        let mid=(lo+hi)//2
        let c=_compare(mid name)
        if c =? 0 {return Zone[mid]}
        if c <? 0 {lo=mid+1} else {hi=mid}
    }
    UnknownZone["no time zone is called {name}"]
}
zone_error=(name:string):>string?=>match zone_parse(name) {
    z:Zone=>none
    e:UnknownZone=>e.message
}
name=(z:Zone):>string=>_text_at(_u32(_entry_at(z._entry)) _u32(_entry_at(z._entry)+4))
__as__=(z:Zone):>string=>name(z)
__eq__=(a:Zone b:Zone):>bool=>a._entry =? b._entry

# A Windows name for a zone (CLDR's table, in the pack): the machine says "Eastern Standard Time".
_windows_zone=(name:string):>Zone|UnknownZone=>$unsafe {
    let table=_u32(20)
    let bytes=name as array<uint8>
    let lo:int64=0
    let hi=_u32(16)
    loop lo <? hi {
        let mid=(lo+hi)//2
        let row=table+mid*12
        let at=_u32(row)
        let len=_u32(row+4)
        let order:int64=0
        let i:int64=0
        loop order =? 0 and i <? len and i <? bytes.length {
            order=int64(_rules()[at+i])-int64(bytes[i])
            i=i+1
        }
        if order =? 0 {order=len-bytes.length}
        if order =? 0 {return Zone[_u32(row+8)]}
        if order <? 0 {lo=mid+1} else {hi=mid}
    }
    UnknownZone["no time zone is called {name}"]
}
# What a machine calls its zone: a tz name, or Windows' name for one.
_machine_named=(name:string):>Zone|UnknownZone=>{
    let found=zone_parse(name)
    if found is? Zone {return found}
    _windows_zone(name)
}

# The machine's zone, read once by name; its rules still come from the pack. A machine with no zone
# to read, or a name the pack does not know, is read as UTC, and the program says so once.
_system:Zone|none=none
system_zone=():>Zone=>{
    if _system isnt? none {return _system}
    let name=__system_zone_name()
    let chosen:Zone=match _machine_named(name) {
        z:Zone=>z
        e:UnknownZone=>{
            let why=if name =? "" "this machine names no time zone" else "this machine's time zone is called '{name}', which the time rules do not know"
            __write_err("warning: {why}, so times here read as UTC: set the TZ variable, or name a zone with `$time.zone = 'America/New_York'`\n")
            zone_parse("UTC") ?? Zone[0]
        }
    }
    _system=chosen
    chosen
}
# (what is wrong with a `$time.zone` value; only a name can be)
zone_scope_error=(scope:string|none):>string?=>{
    if scope is? none or scope =? 'system' {return none}
    match _machine_named(scope) {
        z:Zone=>none
        e:UnknownZone=>e.message
    }
}
# A named zone or the machine's, as `$time.zone` says.
scope_zone=(scope:string|none):>Zone|UnknownZone=>{
    if scope is? none or scope =? 'system' {return system_zone()}
    _machine_named(scope)
}

# ---------------- offsets ----------------
_record=(z:Zone):>int64=>if _HOST {_host_record(z)} else {_u32(_entry_at(z._entry)+8)}
_be32=(d:array<uint8> at:int64):>int64=>$unsafe {
    (int64(d[at]) << 24) + (int64(d[at+1]) << 16) + (int64(d[at+2]) << 8) + int64(d[at+3])
}
_be64=(d:array<uint8> at:int64):>int64=>$unsafe {
    let v:int64<overflow='wrap'>=0
    loop i in [0..8) {
        v=(v << 8)+int64<overflow='wrap'>(d[at+i])
    }
    int64<overflow='wrap'>(v)
}
_put32=(v:int64):>void=>{
    loop i in [0..4) {_host_rules.push(uint8((v >> (8*i)) & 255))}
}
_put64=(v:int64):>void=>{
    loop i in [0..8) {_host_rules.push(uint8((v >> (8*i)) & 255))}
}
# A zone's TZif file as a record of the pack's form, kept past its end (tools/time/gen_rules.py makes
# the same from the same files), or -1 when this machine has no such file. O(file).
_host_read=(zone_name:string):>int64=>$unsafe {
    let d=read_bytes(p("{env("TZDIR") ?? "/usr/share/zoneinfo"}/{zone_name}"))
    if d isnt? array<uint8> or d.length <? 44 or d[0] not=? 84 or d[1] not=? 90 or d[2] not=? 105 or d[3] not=? 102 or d[4] <? 50 {return -1}
    let at=44+_be32(d 32)*5+_be32(d 36)*6+_be32(d 40)+_be32(d 28)*8+_be32(d 24)+_be32(d 20)
    if d.length <? at+44 {return -1}
    let isut=_be32(d at+20)
    let isstd=_be32(d at+24)
    let leap=_be32(d at+28)
    let times=_be32(d at+32)
    let kinds=_be32(d at+36)
    let chars=_be32(d at+40)
    let moments=at+44
    let indexes=moments+times*8
    let types=indexes+times
    let footer=types+kinds*6+chars+leap*12+isstd+isut
    if d.length <? footer or kinds <? 1 {return -1}
    let first=_signed32(_be32(d types))
    let last=first
    let last_dst:int64=-1
    let changes:array<int64>=[]
    let offsets:array<int64>=[]
    let flags:array<int64>=[]
    # (drop the "big bang" sentinel and changes that change nothing)
    loop i in [0..times) {
        let kind=types+int64(d[indexes+i])*6
        if kind+6 >? footer {return -1}
        let moment=_be64(d moments+i*8)
        let offset=_signed32(_be32(d kind))
        let dst=int64(d[kind+4])
        if moment <=? -576460752303423488 {
            first=offset
            last=offset
            continue
        }
        if offset =? last and changes.length >? 0 and last_dst =? dst {continue}
        changes.push(moment)
        offsets.push(offset)
        flags.push(dst)
        last=offset
        last_dst=dst
    }
    let rule_start=footer
    let rule_stop=d.length
    loop rule_start <? rule_stop and d[rule_start] =? 10 {rule_start=rule_start+1}
    loop rule_stop >? rule_start and d[rule_stop-1] =? 10 {rule_stop=rule_stop-1}
    let record=_rules().length+_host_rules.length
    let size=16+changes.length*13
    _put32(first)
    _put32(changes.length)
    _put32(record+size)
    _put32(rule_stop-rule_start)
    loop c in changes {_put64(c)}
    loop o in offsets {_put32(o)}
    loop f in flags {_host_rules.push(uint8(f))}
    loop i in [rule_start..rule_stop) {_host_rules.push(d[i])}
    record
}
_signed32=(v:int64):>int64=>if v >=? 2147483648 {v-4294967296} else {v}
_host_record=(z:Zone):>int64=>$unsafe {
    let i:int64=0
    loop i <? _host_zones.length {
        if _host_zones[i] =? z._entry {return _host_records[i]}
        i=i+1
    }
    let record=_host_read(name(z))
    if record <? 0 {
        if not _host_said {
            __write_err("warning: `$time.zone_source = 'host'`, but this machine has no rules for {name(z)}, so it keeps those of Dewy's own pack, {rules_version()}\n")
            _host_said=true
        }
        record=_u32(_entry_at(z._entry)+8)
    }
    _host_zones.push(z._entry)
    _host_records.push(record)
    record
}
# The number of changes at or before a POSIX second, by binary search.
_changes_before=(record:int64 moment:int64):>int64=>{
    let count=_u32(record+4)
    let lo:int64=0
    let hi=count
    loop lo <? hi {
        let mid=(lo+hi)//2
        if _i64(record+16+mid*8) <=? moment {lo=mid+1} else {hi=mid}
    }
    lo
}
_offset_after=(record:int64 changes:int64):>int64=>{
    if changes =? 0 {return _i32(record)}
    _i32(record+16+_u32(record+4)*8+(changes-1)*4)
}
# Seconds east of UTC at a POSIX second, by the table and then by the zone's POSIX rule.
offset_at=(z:Zone moment:int64):>int64=>{
    let record=_record(z)
    let count=_u32(record+4)
    let changes=_changes_before(record moment)
    if changes <? count or _u32(record+12) =? 0 {return _offset_after(record changes)}
    _rule_offset(record moment)
}

# ---------------- the POSIX TZ rule after the table ----------------
# `std offset [dst [offset] [,start[/time],end[/time]]]`, read from the pack in place.
_Rule:type=[at:int64 stop:int64]
_skip_name=(@r:_Rule):>void=>{
    if _u8(r.at) =? 60 {
        loop _u8(r.at) not=? 62 {r.at=r.at+1}
        r.at=r.at+1
        return
    }
    loop r.at <? r.stop and ((_u8(r.at) >=? 65 and _u8(r.at) <=? 90) or (_u8(r.at) >=? 97 and _u8(r.at) <=? 122)) {r.at=r.at+1}
}
_number=(@r:_Rule):>int64=>{
    let v:int64=0
    loop r.at <? r.stop and _u8(r.at) >=? 48 and _u8(r.at) <=? 57 {
        v=v*10+_u8(r.at)-48
        r.at=r.at+1
    }
    v
}
# hh[:mm[:ss]], signed: seconds.
_hms=(@r:_Rule):>int64=>{
    let sign:int64=1
    if r.at <? r.stop and _u8(r.at) =? 45 {
        sign=-1
        r.at=r.at+1
    } else if r.at <? r.stop and _u8(r.at) =? 43 {r.at=r.at+1}
    let v=_number(@r)*3600
    if r.at <? r.stop and _u8(r.at) =? 58 {
        r.at=r.at+1
        v=v+_number(@r)*60
        if r.at <? r.stop and _u8(r.at) =? 58 {
            r.at=r.at+1
            v=v+_number(@r)
        }
    }
    sign*v
}
_weekday_of=(days:int):>int64=>((days+4)%7).to_int64() ?? 0
# A `Mm.n.d[/time]`, `Jn` or `n` date in a year: local seconds since 1970 at which it falls.
_rule_date=(@r:_Rule year:int):>int=>{
    let days:int=0
    let b=_u8(r.at)
    if b =? 77 {
        r.at=r.at+1
        let month=_number(@r)
        r.at=r.at+1
        let week=_number(@r)
        r.at=r.at+1
        let weekday=_number(@r)
        let first=days_from_civil(year month 1)
        let delta=(weekday-_weekday_of(first)+7)%7
        let day=int(delta)+int(week-1)*7
        let length=int(days_in_month(year month))
        loop day >=? length {day=day-7}
        days=first+day
    } else if b =? 74 {
        r.at=r.at+1
        let n=_number(@r)
        let extra:int64=if days_in_month(year 2) =? 29 and n >=? 60 {1} else {0}
        days=days_from_civil(year 1 1)+int(n)-1+int(extra)
    } else {
        days=days_from_civil(year 1 1)+int(_number(@r))
    }
    let time:int64=7200
    if r.at <? r.stop and _u8(r.at) =? 47 {
        r.at=r.at+1
        time=_hms(@r)
    }
    days*86400+int(time)
}
_rule_offset=(record:int64 moment:int64):>int64=>{
    let start=_u32(record+8)
    let r=_Rule[start start+_u32(record+12)]
    _skip_name(@r)
    let standard=-_hms(@r)
    if r.at >=? r.stop {return standard}
    _skip_name(@r)
    let daylight=standard+3600
    if r.at <? r.stop and _u8(r.at) not=? 44 {daylight=-_hms(@r)}
    if r.at >=? r.stop {return standard}
    r.at=r.at+1
    let [year _m _d]=civil_from_days(int(moment+standard)//86400)
    let on=_rule_date(@r year)-int(standard)
    r.at=r.at+1
    let off=_rule_date(@r year)-int(daylight)
    let t=int(moment)
    let in_dst=if on <? off {t >=? on and t <? off} else {not (t >=? off and t <? on)}
    if in_dst {daylight} else {standard}
}

# ---------------- moments in a zone, and local times back to moments ----------------
const _MJD_1970:int=40587
_posix_of=(t:Instant):>int64|OutsideCoverage=>{
    let label=_axis_to_utc(ns_count(t))
    if label is? none {return OutsideCoverage["UTC, and so a zone's rules, starts in 1961"]}
    let [mjd in_day]=label
    let seconds=(mjd-_MJD_1970)*86400+(if in_day >=? _DAY_NS {86399} else {in_day//_NS})
    seconds.to_int64() ?? 0
}
in_zone=(t:Instant z:Zone):>ZonedDateTime|OutsideCoverage=>ZonedDateTime[t z offset_at(z _posix_of(t) or_throw)]
_at=(moment:int64 nanos:int z:Zone offset:int64):>ZonedDateTime|OutsideCoverage|OffGrid|InvalidFields=>{
    let days=int(moment)//86400
    let axis=_utc_to_axis(days+_MJD_1970 (int(moment)%86400)*_NS+nanos) or_throw
    ZonedDateTime[instant_at(axis) z offset]
}
_local_text=(local:int64):>string=>{
    let [y m d]=civil_from_days(int(local)//86400)
    let t=local%86400
    "{_year_text(y)}-{pad(m 2)}-{pad(d 2)}T{pad(t//3600 2)}:{pad((t%3600)//60 2)}:{pad(t%60 2)}"
}
_pair_text=(offset:int64):>string=>{
    let size=if offset <? 0 {-offset} else {offset}
    let sign=if offset <? 0 {"-"} else {"+"}
    # (the seconds of an old local mean time, as Monrovia's -00:44:30, when it has them)
    let seconds=if size%60 =? 0 {""} else {":{pad(size%60 2)}"}
    "{sign}{pad(size//3600 2)}:{pad((size%3600)//60 2)}{seconds}"
}
_FoldPolicy:type='earlier'|'later'|'reject'
_GapPolicy:type='preserve_displacement'|'next'|'reject'
# Local seconds in a zone: the moment under the policies, or the Gap or Ambiguous with no policy.
_resolve=(local:int64 nanos:int z:Zone fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous|OutsideCoverage|OffGrid|InvalidFields=>{
    let record=_record(z)
    let window:int64=93600
    let early=offset_at(z local-window)
    let late=offset_at(z local+window)
    let seen:array<int64>=[early]
    let first=_changes_before(record local-window)
    let last=_changes_before(record local+window)
    let i=first
    loop i <? last {
        let o=_offset_after(record i+1)
        if not seen.contains(o) {seen.push(o)}
        i=i+1
    }
    if not seen.contains(late) {seen.push(late)}
    # (each offset whose moment really reads that offset, earliest moment first: largest offset first)
    let found:array<int64>=[]
    loop o in seen {
        if offset_at(z local-o) =? o {found.push(o)}
    }
    found.sort(reverse=true)
    if found.length =? 1 {return _at(local-found[0] nanos z found[0])}
    if found.length =? 0 {
        # (a gap: at local-largest the clocks had not yet jumped, and at local-smallest they had)
        let widest=seen[0]
        let narrowest=seen[0]
        loop o in seen {
            if o >? widest {widest=o}
            if o <? narrowest {narrowest=o}
        }
        let before=offset_at(z local-widest)
        let after=offset_at(z local-narrowest)
        if gap =? 'preserve_displacement' {return _at(local-before nanos z after)}
        if gap =? 'next' {
            # (the change itself, whether the table or the zone's rule made it: the first moment
            # after the gap, found between those two moments by the offsets alone)
            let low=local-widest
            let high=local-narrowest
            loop high-low >? 1 {
                let middle=low+(high-low)//2
                if offset_at(z middle) =? before {low=middle} else {high=middle}
            }
            return _at(high 0 z offset_at(z high))
        }
        return Gap["{_local_text(local)} does not exist in {name(z)}: the clocks jumped from {_pair_text(before)} to {_pair_text(after)}. Add gap='preserve_displacement' or gap='next'" int(before) int(after)]
    }
    if fold =? 'earlier' {return _at(local-found[0] nanos z found[0])}
    if fold =? 'later' {return _at(local-found[found.length-1] nanos z found[found.length-1])}
    Ambiguous["{_local_text(local)} happens more than once in {name(z)}. Add fold='earlier' or fold='later'" [loop o in found int(o)]]
}

# The zone of a time: written in its text, or given, or the scope's. A literal cannot assume.
_zone_for=(written:Zone|none given:Zone|none scope:string|none running:bool):>Zone|UnknownZone|MissingContext=>{
    if written isnt? none {return written}
    if given isnt? none {return given}
    if not running and (scope is? none or scope =? 'system') {
        return MissingContext["there is no zone to read this in, and a literal cannot assume one: write it in the text, `2026-10-26T09:00[America/New_York]`, pass `zone=`, or set `$time.zone`"]
    }
    # (unspecified means the running machine, and the call has already warned)
    if scope is? none or scope =? 'system' {return system_zone()}
    _machine_named(scope)
}
# `2026-10-26T09:00[America/New_York]`, or local text with a `zone`, or the scope's `$time.zone`.
zoned_parse=(text:string zone:Zone|none fold:_FoldPolicy|none gap:_GapPolicy|none scope:string|none running:bool=true):>ZonedDateTime|ParseError|Gap|Ambiguous|UnknownZone|MissingContext|OutsideCoverage|OffGrid|InvalidFields=>{
    let c=_Cursor[text 0]
    let f=read_fields(@c) or_throw
    if not f.has_time {return ParseError["a zoned time needs a time of day, as `2026-10-26T09:00[America/New_York]`"]}
    let written=read_offset(@c) or_throw
    let bytes=text as array<uint8>
    let written_zone:Zone|none=none
    if _byte(c c.at) =? 91 {
        let close=c.at
        loop close <? bytes.length and _byte(c close) not=? 93 {close=close+1}
        if close =? bytes.length {return ParseError["a zone in brackets closes with `]`"]}
        written_zone=zone_parse(text[c.at+1..close)) or_throw
        c.at=close+1
    }
    if c.at not=? bytes.length {return ParseError["unexpected text after the time"]}
    let chosen=_zone_for(written_zone zone scope running) or_throw
    if f.second =? 60 {return InvalidFields["a :60 second is a UTC label: use `utc`"]}
    let days=days_from_civil(f.year f.month f.day)
    let local=(days*86400+int(f.hour)*3600+int(f.minute)*60+int(f.second)).to_int64() ?? 0
    if written not=? NO_OFFSET {
        # (an offset beside a zone says which reading: it must be one the zone had)
        let moment=local-written
        if offset_at(chosen moment) not=? written {return ParseError["{name(chosen)} was not at {_pair_text(written)} then"]}
        return _at(moment int(f.nanosecond) chosen written)
    }
    _resolve(local int(f.nanosecond) chosen fold gap)
}
# (a literal needs rules while compiling, and `'host'` has none until the program runs)
const _HOST_LITERAL="`$time.zone_source = 'host'` follows this machine's rules when the program runs, so a literal cannot be worked out from them: read it from text at run time, as `zoned(text)`"
zoned_error=(text:string zone:Zone|none fold:_FoldPolicy|none gap:_GapPolicy|none scope:string|none):>string?=>{
    if _HOST {return _HOST_LITERAL}
    match zoned_parse(text zone fold gap scope false) {
        z:ZonedDateTime=>none
        e:ParseError=>e.message
        e:Gap=>e.message
        e:Ambiguous=>e.message
        e:UnknownZone=>e.message
        e:MissingContext=>e.message
        e:OutsideCoverage=>e.message
        e:InvalidFields=>e.message
        <OffGrid>=>"that label falls between nanoseconds under the UTC rate of its time"
    }
}

# (the same with no zone given)
zoned_text_error=(text:string fold:_FoldPolicy|none gap:_GapPolicy|none scope:string|none):>string?=>zoned_error(text none fold gap scope)

# ---------------- zoned values ----------------
_local=(z:ZonedDateTime):>int64=>(_posix_of(z.nominal) ?? 0)+z.offset
__as__=(z:ZonedDateTime):>string=>{
    let local=(_posix_of(z.nominal) ?? 0)+z.offset
    let label=_axis_to_utc(ns_count(z.nominal))
    let nanos:int=if label is? none {0} else {
        let [_m in_day]=label
        in_day%_NS
    }
    "{_local_text(local)}{_fraction_text(nanos)}{_pair_text(z.offset)}[{name(z.zone)}]"
}
# Elapsed time: a zoned value moves as its instant does.
__add__=(z:ZonedDateTime d:Duration):>ZonedDateTime=>in_zone(z.nominal+d z.zone) ?? z
__sub__=(z:ZonedDateTime d:Duration):>ZonedDateTime=>in_zone(z.nominal-d z.zone) ?? z
__add__=(z:ZonedDateTime q:int*Time):>ZonedDateTime=>in_zone(z.nominal+q z.zone) ?? z
__sub__=(z:ZonedDateTime q:int*Time):>ZonedDateTime=>in_zone(z.nominal-q z.zone) ?? z
__sub__=(a:ZonedDateTime b:ZonedDateTime):>Duration=>a.nominal-b.nominal
__eq__=(a:ZonedDateTime b:ZonedDateTime):>bool=>a.nominal =? b.nominal and a.zone =? b.zone
__lt__=(a:ZonedDateTime b:ZonedDateTime):>bool=>a.nominal <? b.nominal
# The local fields on a date with the same time of day, under the scope's policies.
# (a move past the table, or onto a pre-1972 label between nanoseconds, has no local time either)
_civil=(r:ZonedDateTime|Gap|Ambiguous|OutsideCoverage|OffGrid|InvalidFields):>ZonedDateTime|Gap|Ambiguous=>match r {
    z:ZonedDateTime=>z
    e:Gap=>e
    e:Ambiguous=>e
    e:OutsideCoverage=>Gap[e.message 0 0]
    e:InvalidFields=>Gap[e.message 0 0]
    <OffGrid>=>Gap["that label falls between nanoseconds under the UTC rate of its time" 0 0]
}
_day_add=(z:ZonedDateTime p:Days fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous=>{
    _civil(_resolve(_local(z)+p.count*86400 int(_nanos(z)) z.zone fold gap))
}
_month_add=(z:ZonedDateTime p:Months fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>{
    let local=_local(z)
    let t=local%86400
    let [y m d]=civil_from_days(int(local)//86400)
    let total=y*12+int(m)-1+int(p.count)
    let ny=total//12
    let nm=((total%12).to_int64() ?? 0)+1
    if d >? days_in_month(ny nm) {return InvalidDate["{_year_text(ny)}-{pad(nm 2)} has no day {d}"]}
    _civil(_resolve(((days_from_civil(ny nm d)*86400).to_int64() ?? 0)+t int(_nanos(z)) z.zone fold gap))
}
# (what is wrong with these constants; none when the add resolves)
day_add_error=(z:ZonedDateTime p:Days fold:_FoldPolicy|none gap:_GapPolicy|none):>string?=>match _day_add(z p fold gap) {
    r:ZonedDateTime=>none
    e:Gap=>e.message
    e:Ambiguous=>e.message
}
# (both policies written: nothing is left to fail. Empty text: no promise, and no error.)
policy_gap=(fold:_FoldPolicy|none gap:_GapPolicy|none):>string?=>if fold is? none or gap is? none or fold =? 'reject' or gap =? 'reject' {""} else {none}

$check_constant day_add_error(z p fold gap) "this add has no one answer"
$check_constant policy_gap(fold gap) "unused"
__add__=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_day_add(z p fold gap)
$check_constant day_add_error(z p fold gap) "this add has no one answer"
$check_constant policy_gap(fold gap) "unused"
__sub__=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_day_add(z Days[-p.count] fold gap)
__add__=(z:ZonedDateTime p:Months fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous|InvalidDate=>_month_add(z p fold gap)
$check_constant day_add_error(z p fold gap) "this add has no one answer"
$check_constant policy_gap(fold gap) "unused"
add=(z:ZonedDateTime p:Days fold:_FoldPolicy|none=$time.fold gap:_GapPolicy|none=$time.gap):>ZonedDateTime|Gap|Ambiguous=>_day_add(z p fold gap)

# The local date of an instant in a zone.
local_days=(t:Instant z:Zone):>int=>{
    let moment=_posix_of(t)
    if moment is? OutsideCoverage {return ns_count(t)//_DAY_NS+2557}
    int(moment+offset_at(z moment))//86400
}

# ---------------- what a zoned time reads as ----------------
_seconds_today=(z:ZonedDateTime):>int64=>_local(z)%86400
_nanos=(z:ZonedDateTime):>int64=>{
    let label=_axis_to_utc(ns_count(z.nominal))
    if label is? none {return 0}
    let [_m in_day]=label
    (in_day%_NS).to_int64() ?? 0
}
date=(z:ZonedDateTime):>Date=>_of_days(int(_local(z))//86400)
time_of_day=(z:ZonedDateTime):>TimeOfDay=>TimeOfDay[_seconds_today(z)*1000000000+_nanos(z)]
local=(z:ZonedDateTime):>LocalDateTime=>LocalDateTime<Gregorian>[date(z) time_of_day(z)]
year=(z:ZonedDateTime):>int=>civil_from_days(int(_local(z))//86400)[0]
month=(z:ZonedDateTime):>int64=>civil_from_days(int(_local(z))//86400)[1]
day=(z:ZonedDateTime):>int64=>civil_from_days(int(_local(z))//86400)[2]
hour=(z:ZonedDateTime):>int64=>_seconds_today(z)//3600
minute=(z:ZonedDateTime):>int64=>(_seconds_today(z)%3600)//60
second=(z:ZonedDateTime):>int64=>_seconds_today(z)%60
nanosecond=(z:ZonedDateTime):>int64=>_nanos(z)
# 0 for Monday to 6 for Sunday.
weekday=(z:ZonedDateTime):>int64=>((int(_local(z))//86400+3)%7).to_int64() ?? 0

# A local time in a zone: the moment under the policies, or the Gap or Ambiguous with no policy.
local_in_zone=(l:LocalDateTime z:Zone fold:_FoldPolicy|none gap:_GapPolicy|none):>ZonedDateTime|Gap|Ambiguous=>{
    let days=int(l.date._days)
    let whole=l.time._ns//1000000000
    let moment=(days*86400).to_int64() ?? 0
    _civil(_resolve(moment+whole int(l.time._ns%1000000000) z fold gap))
}
local_zone_error=(l:LocalDateTime z:Zone fold:_FoldPolicy|none gap:_GapPolicy|none):>string?=>match local_in_zone(l z fold gap) {
    r:ZonedDateTime=>none
    e:Gap=>e.message
    e:Ambiguous=>e.message
}

# By a pattern, with `XXX` and `VV` for its offset and zone.
zoned_pattern_error=(p:string):>string?=>pattern.pattern_error(p true true true)
$check_constant zoned_pattern_error(p) "not a pattern"
format=(z:ZonedDateTime p:string):>string|ParseError=>{
    let wrong=zoned_pattern_error(p)
    if wrong isnt? none {return ParseError[wrong]}
    pattern.render(pattern.Parts[true true true year(z) month(z) day(z) weekday(z) hour(z) minute(z) second(z) nanosecond(z) z.offset name(z.zone)] p)
}

# The scope's zone, for `today` and `strict_today` (who): a name known only when running, if
# unknown, is said, and then the machine's zone is read instead.
today_zone=(scope:string|none who:string):>Zone=>match scope_zone(scope) {
    found:Zone=>found
    e:UnknownZone=>{
        __write_err("warning: {e.message}, so `{who}` reads the machine's zone instead\n")
        system_zone()
    }
}

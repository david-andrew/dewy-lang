# On equal grids compare the signed counts in place. Other grids compare
# cross-products in mathematical integers; no destination width is involved.
_words=((v:Duration):>Duration=>v) & ((v:int64):>Duration=>duration_word(v))
_compare=<N D A B S W>(left:S right:W):>int64=>{
    const u=_tick<N D>()
    const v=_tick<A B>()
    const equal_grid=u =? v
    if equal_grid {
        let x=_words(left)
        let y=_words(right)
        return if x <? y {-1} else if x =? y {0} else {1}
    }
    let x=_count(left)*u.numerator*v.denominator
    let y=_count(right)*v.numerator*u.denominator
    if x <? y {-1} else if x =? y {0} else {1}
}
# Cross-grid comparisons keep both scaled counts exact.
__eq__=<N D S A B W>(a:_GridInstant<N D S> b:_GridInstant<A B W>):>bool=>_compare<N D A B S W>(a._count b._count) =? 0
__eq__=<N D S>(a:_GridInstant<N D S> b:Instant):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:Instant b:_GridInstant<N D S>):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:_GridInstant<N D S> b:Instant_width_64):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:Instant_width_64 b:_GridInstant<N D S>):>bool=>_at(a) =? _at(b)
__lt__=<N D S A B W>(a:_GridInstant<N D S> b:_GridInstant<A B W>):>bool=>_compare<N D A B S W>(a._count b._count) <? 0
__lt__=<N D S>(a:_GridInstant<N D S> b:Instant):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:Instant b:_GridInstant<N D S>):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:_GridInstant<N D S> b:Instant_width_64):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:Instant_width_64 b:_GridInstant<N D S>):>bool=>_at(a) <? _at(b)
__eq__=<N D S A B W>(a:_GridDuration<N D S> b:_GridDuration<A B W>):>bool=>_compare<N D A B S W>(a._count b._count) =? 0
__eq__=<N D S>(a:_GridDuration<N D S> b:Duration):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:Duration b:_GridDuration<N D S>):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:_GridDuration<N D S> b:Duration_width_64):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:Duration_width_64 b:_GridDuration<N D S>):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:_GridDuration<N D S> b:rational*Time):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:_GridDuration<N D S> b:int*Time):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:rational*Time b:_GridDuration<N D S>):>bool=>_at(a) =? _at(b)
__eq__=<N D S>(a:int*Time b:_GridDuration<N D S>):>bool=>_at(a) =? _at(b)
__lt__=<N D S A B W>(a:_GridDuration<N D S> b:_GridDuration<A B W>):>bool=>_compare<N D A B S W>(a._count b._count) <? 0
__lt__=<N D S>(a:_GridDuration<N D S> b:Duration):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:Duration b:_GridDuration<N D S>):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:_GridDuration<N D S> b:Duration_width_64):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:Duration_width_64 b:_GridDuration<N D S>):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:_GridDuration<N D S> b:rational*Time):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:_GridDuration<N D S> b:int*Time):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:rational*Time b:_GridDuration<N D S>):>bool=>_at(a) <? _at(b)
__lt__=<N D S>(a:int*Time b:_GridDuration<N D S>):>bool=>_at(a) <? _at(b)

$check_constant _nonzero_time(q) "not a divisor"
__truediv__=<N D S>(a:_GridDuration<N D S> q:rational*Time):>rational|OutOfRange=>{
    let b=_seconds(q)
    if b.numerator =? 0 {return OutOfRange}
    let v=_at(a)
    rational(v.numerator*b.denominator v.denominator*b.numerator)
}

$check_constant _nonzero_int(k) "not a divisor"
__truediv__=<N D S>(a:_GridDuration<N D S> k:int):>(rational*Time)|OutOfRange=>{
    if k =? 0 {return OutOfRange}
    let v=_at(a)
    rational(v.numerator v.denominator*k)*s
}
_nonzero_stored=<N D S>(d:_GridDuration<N D S>):>string?=>if _count(d._count) =? 0 {"this divides by zero"} else {none}
$check_constant _nonzero_stored(b) "not a divisor"
__truediv__=<N D S A B W>(a:_GridDuration<N D S> b:_GridDuration<A B W>):>rational|OutOfRange=>{
    let y=_at(b)
    if y.numerator =? 0 {return OutOfRange}
    let x=_at(a)
    rational(x.numerator*y.denominator x.denominator*y.numerator)
}
# An exact cast can omit its checks if even the extreme negative count fits.
_bits=(_tag:array<int64>):>int=>64
_bits=(_tag:array<Duration>):>int=>128
_limits=<N D S>(_tag:array<_GridInstant<N D S>>):>[rational int]=>{
    let storage:array<S>=[]
    [_tick<N D>() _bits(storage)]
}
_limits=<N D S>(_tag:array<_GridDuration<N D S>>):>[rational int]=>{
    let storage:array<S>=[]
    [_tick<N D>() _bits(storage)]
}
_limits=(_tag:array<Instant>):>[rational int]=>[rational(1 1000000000) 128]
_limits=(_tag:array<Duration>):>[rational int]=>[rational(1 1000000000) 128]
_limits=(_tag:array<Instant_width_64>):>[rational int]=>[rational(1 1000000000) 64]
_limits=(_tag:array<Duration_width_64>):>[rational int]=>[rational(1 1000000000) 64]
_covers=<T V>():>bool=>{
    let target:array<T>=[]
    let source:array<V>=[]
    let [src src_bits]=_limits(source)
    let [dst dst_bits]=_limits(target)
    let scale=_delta(src dst)
    if scale is? OffGrid {return false}
    (scale << src_bits) <=? (int(1) << dst_bits)
}

# Split exactly at any positive quantum; floor keeps a negative point's
# remainder nonnegative. Remainders may be off the ordinary nanosecond grid.
_positive_tick=(tick:rational*Time):>string?=>if _seconds(tick).numerator <=? 0 {"a tick must be positive"} else {none}
_split=(v:rational q:rational*Time):>[int rational*Time]|OffGrid=>{
    let step=_seconds(q)
    if step.numerator <=? 0 {return OffGrid}
    let count=(v.numerator*step.denominator)//(v.denominator*step.numerator)
    [count (v-count*step)*s]
}
$check_constant _positive_tick(tick) "not a tick"
ticks=<N D S>(x:_GridDuration<N D S> tick:rational*Time):>[int rational*Time]|OffGrid=>_split(_at(x) tick)
$check_constant _positive_tick(tick) "not a tick"
ticks=<N D S>(x:_GridInstant<N D S> tick:rational*Time):>[int rational*Time]|OffGrid=>_split(_at(x) tick)

__as__=<N D S>(d:_GridDuration<N D S>):>string=>"{_at(d)*s}"

# Rounding can move either endpoint by less than one output quantum.
# A constant step settles the range check wherever even that bound fits.
_rounding_bound=<N D S>(tick:rational*Time):>string?=>{
    let ns=_tick_ns(tick)
    if ns is? none {return "a tick here is a positive whole number of nanoseconds"}
    let storage:array<S>=[]
    let magnitude=(int(1) << (_bits(storage)-1))*_tick<N D>()*1000000000
    if magnitude+ns >=? (int(1) << 127) {return ""}
    none
}
# Round onto the ordinary storage grid, retaining signed, exact sub-ns loss.
# Civil rounding of an instant shares the UTC minute shift with the default grid.
_round_ns=(v:rational step:int shift:int rounding:_Rounding):>[int rational*Time]=>{
    if step <=? 0 {return [0 v*s]}
    let ns=v*1000000000
    let shifted=ns-shift
    let count=_rounded(rational(shifted.numerator shifted.denominator*step) rounding)
    let rounded=count*step+shift
    [rounded (v-rational(rounded 1000000000))*s]
}
$check_constant _rounding_bound(tick) "not a tick"
quantize=<N D S>(x:_GridDuration<N D S> tick:rational*Time rounding:_Rounding):>[Duration rational*Time]|OffGrid|OutOfRange=>{
    let step=_tick_ns(tick) ?? return OffGrid
    let [ns loss]=_round_ns(_at(x) step 0 rounding)
    [_wide(ns) or_throw loss]
}
$check_constant _rounding_bound(tick) "not a tick"
quantize=<N D S>(x:_GridInstant<N D S> tick:rational*Time rounding:_Rounding):>[Instant rational*Time]|OffGrid|OutOfRange=>{
    let step=_tick_ns(tick) ?? return OffGrid
    let v=_at(x)
    let shift=_label_shift((v*1000000000).floor() step)
    let [ns loss]=_round_ns(v step shift rounding)
    if not _fits(ns) {return OutOfRange}
    [_instant(ns) loss]
}

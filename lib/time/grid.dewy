__add__=<N D>(q:rational*Time a:_GridDuration<N D Duration>):>_GridDuration<N D Duration>|OffGrid=>{
    let change=_on<N D>(_seconds(q)) or_throw
    _GridDuration<N D Duration>[_duration(change+_count(a._count))]
}
$check_constant _operand_error(q) "off the stored time grid"
__sub__=<N D>(q:rational*Time a:_GridDuration<N D Duration>):>_GridDuration<N D Duration>|OffGrid=>{

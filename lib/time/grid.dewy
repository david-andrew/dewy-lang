    let change=_on<N D>(_seconds(q)) or_throw
    _GridInstant<N D Duration>[_duration(_count(a._count)-change)]
}
$check_constant _operand_error(q) "off the stored time grid"
__add__=<N D>(q:rational*Time a:_GridInstant<N D Duration>):>_GridInstant<N D Duration>|OffGrid=>{
    let change=_on<N D>(_seconds(q)) or_throw
    _GridInstant<N D Duration>[_duration(change+_count(a._count))]
}
$check_constant _operand_error(q) "off the stored time grid"

from p"core.dewy" import (Duration Instant Instant_width_64 Duration_width_64 duration_word _label_shift _Rounding _rounded _instant ns_count _duration _fits _seconds _nonzero_time _tick_ns _word_add _word_sub _nonzero_int)
_GridInstant:type=<N D S>[_count:S]
_GridDuration:type=<N D S>[_count:S]

# The checked constant evaluator can interpolate a word. Emit larger type
# arguments a decimal digit at a time without narrowing the tick itself.
_integer_text=(value:int):>string=>{
    let count=value
    let suffix=""
    loop count >? 9223372036854775807 {
        let digit=(count%10).to_int64() ?? 0
        suffix="{digit}{suffix}"
        count=count//10
    }
    let head=count.to_int64() ?? 0
    "{head}{suffix}"
}
_parts=(tick:rational*Time):>[string string]=>{
    let q=_seconds(tick)
    if q.numerator <=? 0 {return ["" ""]}
    [_integer_text(q.numerator) _integer_text(q.denominator)]
}

# The compiler supplies one normalized integer spelling per type argument.
# The member loop expands to that literal. Parsing happens once at compile time.
_digits=<T>():>string=>{
    loop text in members(T) {return text}
    ""
}
_tick=<N D>():>rational=>{
    const value=rational(_digits<N>() _digits<D>()) ?? rational(0)
    value
}
_count=((x:int64):>int=>int(x)) & ((x:Duration):>int=>ns_count(x))
_at=<N D S>(x:_GridDuration<N D S>):>rational=>_count(x._count)*_tick<N D>()
_at=<N D S>(x:_GridInstant<N D S>):>rational=>_count(x._count)*_tick<N D>()
_at=(x:Duration):>rational=>rational(ns_count(x) 1000000000)
_at=(x:Instant):>rational=>rational(ns_count(x) 1000000000)
_at=(x:Instant_width_64):>rational=>rational(int(x._count) 1000000000)
_at=(x:Duration_width_64):>rational=>rational(int(x._count) 1000000000)
_at=(x:int*Time):>rational=>rational(x transmute int)
_at=(x:rational*Time):>rational=>_seconds(x)

_wide=(n:int):>Duration|OutOfRange=>{
    if not _fits(n) {return OutOfRange}
    _duration(n)
}
_pack=(_kind:array<int64> n:int):>int64|OutOfRange=>n.to_int64() ?? OutOfRange
_pack=(_kind:array<Duration> n:int):>Duration|OutOfRange=>_wide(n)
_integral=(v:rational):>int|OffGrid=>{
    if v.denominator not=? 1 {return OffGrid}
    v.numerator
}
_on=<N D>(seconds:rational):>int|OffGrid=>{
    const unit=_tick<N D>()
    _delta(seconds unit)
}
_store=<N D S>(_target:array<_GridDuration<N D S>> seconds:rational):>_GridDuration<N D S>|OffGrid|OutOfRange=>{
    let kind:array<S>=[]
    _GridDuration<N D S>[_pack(kind _on<N D>(seconds) or_throw) or_throw]
}
_store=<N D S>(_target:array<_GridInstant<N D S>> seconds:rational):>_GridInstant<N D S>|OffGrid|OutOfRange=>{
    let kind:array<S>=[]
    _GridInstant<N D S>[_pack(kind _on<N D>(seconds) or_throw) or_throw]
}
_whole_ns=(v:rational):>int|OffGrid=>_integral(v*1000000000)
_store=(_target:array<Duration> seconds:rational):>Duration|OffGrid|OutOfRange=>_wide(_whole_ns(seconds) or_throw)
_store=(_target:array<Instant> seconds:rational):>Instant|OffGrid|OutOfRange=>{
    let d=_wide(_whole_ns(seconds) or_throw) or_throw
    Instant[d._hi d._lo]
}
_store=(_target:array<Duration_width_64> seconds:rational):>Duration_width_64|OffGrid|OutOfRange=>{
    Duration_width_64[(_whole_ns(seconds) or_throw).to_int64() ?? return OutOfRange]
}
_store=(_target:array<Instant_width_64> seconds:rational):>Instant_width_64|OffGrid|OutOfRange=>{
    Instant_width_64[(_whole_ns(seconds) or_throw).to_int64() ?? return OutOfRange]
}
_convert=<T V>(x:V):>T|OffGrid|OutOfRange=>{
    let target:array<T>=[]
    _store(target _at(x))
}

# Add and subtract counts directly on one grid. Compact operations expose
# their reachable boundary. Wide operations share the default two-word path.
__add__=<N D>(a:_GridInstant<N D Duration> b:_GridDuration<N D Duration>):>_GridInstant<N D Duration>=>_GridInstant<N D Duration>[a._count+b._count]
__add__=<N D>(a:_GridDuration<N D Duration> b:_GridInstant<N D Duration>):>_GridInstant<N D Duration>=>_GridInstant<N D Duration>[a._count+b._count]
__sub__=<N D>(a:_GridInstant<N D Duration> b:_GridDuration<N D Duration>):>_GridInstant<N D Duration>=>_GridInstant<N D Duration>[a._count-b._count]
__sub__=<N D>(a:_GridInstant<N D Duration> b:_GridInstant<N D Duration>):>_GridDuration<N D Duration>=>_GridDuration<N D Duration>[a._count-b._count]
__add__=<N D>(a:_GridDuration<N D Duration> b:_GridDuration<N D Duration>):>_GridDuration<N D Duration>=>_GridDuration<N D Duration>[a._count+b._count]
__sub__=<N D>(a:_GridDuration<N D Duration> b:_GridDuration<N D Duration>):>_GridDuration<N D Duration>=>_GridDuration<N D Duration>[a._count-b._count]
__add__=<N D>(a:_GridInstant<N D int64> b:_GridDuration<N D int64>):>_GridInstant<N D int64>|OutOfRange=>_GridInstant<N D int64>[_word_add(a._count b._count) or_throw]
__add__=<N D>(a:_GridDuration<N D int64> b:_GridInstant<N D int64>):>_GridInstant<N D int64>|OutOfRange=>_GridInstant<N D int64>[_word_add(a._count b._count) or_throw]
__sub__=<N D>(a:_GridInstant<N D int64> b:_GridDuration<N D int64>):>_GridInstant<N D int64>|OutOfRange=>_GridInstant<N D int64>[_word_sub(a._count b._count) or_throw]
__sub__=<N D>(a:_GridInstant<N D int64> b:_GridInstant<N D int64>):>_GridDuration<N D int64>|OutOfRange=>_GridDuration<N D int64>[_word_sub(a._count b._count) or_throw]
__add__=<N D>(a:_GridDuration<N D int64> b:_GridDuration<N D int64>):>_GridDuration<N D int64>|OutOfRange=>_GridDuration<N D int64>[_word_add(a._count b._count) or_throw]
__sub__=<N D>(a:_GridDuration<N D int64> b:_GridDuration<N D int64>):>_GridDuration<N D int64>|OutOfRange=>_GridDuration<N D int64>[_word_sub(a._count b._count) or_throw]

__unary_sub__=<N D>(a:_GridDuration<N D Duration>):>_GridDuration<N D Duration>=>_GridDuration<N D Duration>[-a._count]
__unary_sub__=<N D>(a:_GridDuration<N D int64>):>_GridDuration<N D int64>|OutOfRange=>_GridDuration<N D int64>[_word_sub(0 a._count) or_throw]
__mul__=<N D>(a:_GridDuration<N D Duration> k:int):>_GridDuration<N D Duration>=>_GridDuration<N D Duration>[a._count*k]
__mul__=<N D>(k:int a:_GridDuration<N D Duration>):>_GridDuration<N D Duration>=>a*k
__mul__=<N D>(a:_GridDuration<N D int64> k:int):>_GridDuration<N D int64>|OutOfRange=>_GridDuration<N D int64>[(int(a._count)*k).to_int64() ?? return OutOfRange]
__mul__=<N D>(k:int a:_GridDuration<N D int64>):>_GridDuration<N D int64>|OutOfRange=>a*k

checked_add=<N D S>(t:_GridInstant<N D S> d:_GridDuration<N D S>):>_GridInstant<N D S>|OutOfRange=>{
    let kind:array<S>=[]
    _GridInstant<N D S>[_pack(kind _count(t._count)+_count(d._count)) or_throw]
}
_range_is_empty=<N D S>(first:_GridInstant<N D S> last:_GridInstant<N D S> includes_first:bool includes_last:bool):>bool=>{
    if last <? first {return true}
    if first =? last {return not (includes_first and includes_last)}
    not includes_first and not includes_last and _count(last._count)-_count(first._count) =? 1
}
# The result is checked after exact arithmetic: a large displacement may
# cancel the starting count. Only divisibility depends on the operand alone.
_delta=(seconds:rational unit:rational):>int|OffGrid=>{
    if unit.numerator <=? 0 {return OffGrid}
    _integral(rational(seconds.numerator*unit.denominator seconds.denominator*unit.numerator))
}
# The stored operand supplies N and D even when its count is a run-time value.
_operand_error=<N D>(q:rational*Time):>string?=>{
    if _on<N D>(_seconds(q)) is? OffGrid {return "use quantize with a named rounding or choose a finer tick"}
    none
}
$check_constant _operand_error(q) "off the stored time grid"
__add__=<N D>(a:_GridInstant<N D Duration> q:rational*Time):>_GridInstant<N D Duration>|OffGrid=>{
    let change=_on<N D>(_seconds(q)) or_throw
    _GridInstant<N D Duration>[_duration(_count(a._count)+change)]
}
$check_constant _operand_error(q) "off the stored time grid"

    let change=_on<N D>(_seconds(q)) or_throw
    _GridInstant<N D int64>[(_count(a._count)-change).to_int64() ?? return OutOfRange]
}
$check_constant _operand_error(q) "off the stored time grid"
__add__=<N D>(q:rational*Time a:_GridInstant<N D int64>):>_GridInstant<N D int64>|OffGrid|OutOfRange=>{
    let change=_on<N D>(_seconds(q)) or_throw
    _GridInstant<N D int64>[(change+_count(a._count)).to_int64() ?? return OutOfRange]
}

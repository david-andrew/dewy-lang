__add__=<N D>(a:_GridDuration<N D Duration> q:rational*Time):>_GridDuration<N D Duration>|OffGrid=>{
    let change=_on<N D>(_seconds(q)) or_throw
    _GridDuration<N D Duration>[_duration(_count(a._count)+change)]

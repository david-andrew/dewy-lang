# Clocks of docs/design/time.md: `now` as two samples, elapsed time and deadlines on the suspend-
# inclusive monotonic clock. A stopwatch reaches this file and the core, and no zone data.
from p"core.dewy" import (Instant Duration instant_word duration_word ns_count _of_int _of_rational _grid_error)
from p"core.dewy" import (_axis_to_utc _segment_of_day _SEGMENTS)

ClockReading:type=[nominal:Instant _mono:int64 _domain:uint32 _status:uint32]
MonoPoint:type=[_mono:int64]

# 1970-01-01T00:00 in axis nanoseconds before TAI-UTC: the days from J0 to there.
const _UNIX_ORIGIN:int64=-220924800000000000
# The first second the last table row holds for, and its offset: the common path is one add.
const _LAST_ROW_MJD:int64=57754
const _LAST_OFFSET:int64=37000000000
const _LAST_ROW_UNIX_NS:int64=(57754-40587)*86400000000000

# A POSIX reading as a nominal instant: the current segment's offset, added once.
_of_wall=(wall:int64):>Instant=>{
    if wall >=? _LAST_ROW_UNIX_NS {return instant_word(wall+_UNIX_ORIGIN+_LAST_OFFSET)}
    # (a clock set before 2017, say in a test: the table)
    let mjd=int(wall//86400000000000)+40587
    let row=_segment_of_day(mjd)
    if row <? 0 {return instant_word(wall+_UNIX_ORIGIN)}
    instant_word(wall+_UNIX_ORIGIN+_SEGMENTS[row].a*100)
}
now=():>ClockReading=>ClockReading[_of_wall(__wall_ns()) time_ns() 1 0]
monotonic=():>MonoPoint=>MonoPoint[time_ns()]

__sub__=(a:ClockReading b:ClockReading):>Duration=>duration_word(a._mono-b._mono)
__add__=(r:ClockReading d:Duration):>MonoPoint=>MonoPoint[r._mono+int64<overflow='saturate'>(ns_count(d))]
__add__=(r:ClockReading q:int*Time):>MonoPoint=>r+_of_int(q)
__lt__=(r:ClockReading p:MonoPoint):>bool=>r._mono <? p._mono
__lt__=(p:MonoPoint r:ClockReading):>bool=>p._mono <? r._mono
__eq__=(a:ClockReading b:ClockReading):>bool=>a.nominal =? b.nominal and a._mono =? b._mono
__sub__=(a:MonoPoint b:MonoPoint):>Duration=>duration_word(a._mono-b._mono)
__sub__=(a:MonoPoint r:ClockReading):>Duration=>duration_word(a._mono-r._mono)
__sub__=(r:ClockReading a:MonoPoint):>Duration=>duration_word(r._mono-a._mono)
__add__=(p:MonoPoint d:Duration):>MonoPoint=>MonoPoint[p._mono+int64<overflow='saturate'>(ns_count(d))]
__add__=(p:MonoPoint q:int*Time):>MonoPoint=>p+_of_int(q)
__lt__=(a:MonoPoint b:MonoPoint):>bool=>a._mono <? b._mono
__eq__=(a:MonoPoint b:MonoPoint):>bool=>a._mono =? b._mono
$check_constant _grid_error(q) "off the nanosecond grid"
__add__=(r:ClockReading q:rational*Time):>MonoPoint|OffGrid=>r+(_of_rational(q) or_throw)
$check_constant _grid_error(q) "off the nanosecond grid"
__add__=(p:MonoPoint q:rational*Time):>MonoPoint|OffGrid=>p+(_of_rational(q) or_throw)
__as__=(r:ClockReading):>string=>"~{r.nominal}"
__as__=(p:MonoPoint):>string=>"mono+{duration_word(p._mono)}"

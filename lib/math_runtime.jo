import 'bigint.dewy' as __bi

# A small integer is its signed value shifted left one bit. An odd word is
# an owned, immutable one-element BigInt array header, biased by one.
__mi_payload = (value: __dewy_int) -> *__bi.BigInt:
    (((value as int) - 1) as *u8 + 24) as *__bi.BigInt

__mi_word = (word: int) -> __dewy_int:
    if word >= -4611686018427387904 and word <= 4611686018427387903:
        return (word << 1) as __dewy_int
    __mi_pack(__bi.bigint(word))

__mi_pack = (value: __bi.BigInt) -> __dewy_int:
    if let word = __bi.to_int64(value):
        if word >= -4611686018427387904 and word <= 4611686018427387903:
            return (word << 1) as __dewy_int
    big = [value]
    p = big as *u8
    __rc_inc(p)
    ((p as int) | 1) as __dewy_int

__mi_big = (value: __dewy_int) -> __bi.BigInt:
    if (value as int) & 1 == 0: return __bi.bigint((value as int) >> 1)
    __mi_payload(value)[0]

__mi_unsigned = (value: u64) -> __dewy_int:
    if value <= u64(9223372036854775807): return __mi_word(int(value))
    __mi_pack(__bi.bigint(value))

__mi_ratio_int = (numerator: __bi.BigInt, denominator: __bi.BigInt) -> __dewy_int:
    parts = __bi.divmod(numerator, denominator)
    quotient = parts.quotient
    if parts.remainder._sign != 0 and numerator._sign != denominator._sign:
        quotient = __bi.__add__(quotient, __bi.bigint(1))
    __mi_pack(quotient)

__mi_slow = (a: __dewy_int, b: __dewy_int, operation: int) -> __dewy_int:
    x = __mi_big(a)
    y = __mi_big(b)
    if operation == 0: return __mi_pack(__bi.__add__(x, y))
    if operation == 1: return __mi_pack(__bi.__sub__(x, y))
    if operation == 2: return __mi_pack(__bi.__mul__(x, y))
    if operation == 3 or operation == 4:
        parts = __bi.divmod(x, y)
        if x._sign != y._sign and parts.remainder._sign != 0:
            parts.quotient = __bi.__add__(parts.quotient, __bi.bigint(1))
            parts.remainder = __bi.__sub__(parts.remainder, y)
        return __mi_pack(if operation == 3: parts.quotient else: parts.remainder)
    if operation == 5: return __mi_pack(__bi.__and__(x, y))
    if operation == 6: return __mi_pack(__bi.__or__(x, y))
    if operation == 7: return __mi_pack(__bi.__xor__(x, y))
    panic("invalid mathematical integer operation")

__mi_compare = (a: __dewy_int, b: __dewy_int) -> int:
    if (a as int) & 1 == 0 and (b as int) & 1 == 0:
        if ((a as int) >> 1) < ((b as int) >> 1): return -1
        return int(((a as int) >> 1) > ((b as int) >> 1))
    __bi._compare(__mi_big(a), __mi_big(b))

__mi_shift = (a: __dewy_int, count: int, right: bool) -> __dewy_int:
    if count < 0: panic("shift count must be nonnegative")
    if right: return __mi_pack(__bi.__rshift__(__mi_big(a), count))
    __mi_pack(__bi.__lshift__(__mi_big(a), count))

__mi_signed = (a: __dewy_int) -> int:
    if (a as int) & 1 == 0: return ((a as int) >> 1)
    if let value = __bi.to_int64(__mi_payload(a)[0]): return value
    __int_overflow()
    0

__mi_to_unsigned = (a: __dewy_int) -> u64:
    if (a as int) & 1 == 0:
        if ((a as int) >> 1) < 0: __int_overflow()
        return u64(((a as int) >> 1))
    if let value = __bi.to_uint64(__mi_payload(a)[0]): return value
    __int_overflow()
    0

__mi_float = (a: __dewy_int) -> f64:
    if (a as int) & 1 == 0: return f64(((a as int) >> 1))
    __bi.to_float64(__mi_payload(a)[0])

__mi_from_float = (x: f64) -> __dewy_int:
    if x != x or x - x != 0.0: __int_overflow()
    if x >= -9223372036854775808.0 and x < 9223372036854775808.0: return __mi_word(int(x))
    bits = f64_bits(x)
    exponent = int((bits >> 52) & 2047) - 1023 - 52
    mantissa = (bits & 4503599627370495) | 4503599627370496
    big = __bi.bigint(mantissa)
    if exponent >= 0: big = __bi.__lshift__(big, exponent)
    else: big = __bi.__rshift__(big, -exponent)
    if x < 0.0: big = __bi.__unary_sub__(big)
    __mi_pack(big)

__mi_format = (buf: mut u8[], a: __dewy_int):
    if (a as int) & 1 == 0: __fmt(buf, ((a as int) >> 1))
    else: __buf_append_str(buf, __bi.str(__mi_payload(a)[0]))


__mi_hash = (a: __dewy_int) -> int:
    if (a as int) & 1 == 0: return ((a as int) >> 1)
    value = __mi_payload(a)[0]
    h = value._sign
    loop limb in value._limbs: h = (h ^ int(limb)) * 1099511628211
    h

__mi_parse = (s: str) -> __dewy_int?:
    # The same 18-digit proof as to_int, returning directly into the exact
    # result. Avoid an intermediate optional-word result on ordinary input.
    p = data(s)
    n = len(s)
    i = 0
    if n > 0 and (p[0] == '-' or p[0] == '+'): i = 1
    if i < n and n - i <= 18:
        value = 0
        j = i
        loop j < n:
            digit = int(p[j]) - 48
            if u64(digit) > 9: break
            value = value * 10 + digit
            j += 1
        if j == n:
            if p[0] == '-': value = -value
            # At most 18 digits fits the signed 63-bit immediate payload.
            return (value << 1) as __dewy_int
    __mi_parse_slow(s)

__mi_parse_slow = (s: str) -> __dewy_int?:
    if let word = to_int(s): return word
    text = trim(s)
    p = data(text)
    n = len(text)
    if n == 0: return none
    i = 0
    negative = false
    if p[i] == '-' or p[i] == '+':
        negative = p[i] == '-'
        i += 1
    if i >= n: return none
    base = 10
    if i + 1 < n and p[i] == '0' and (p[i + 1] == 'x' or p[i + 1] == 'X'):
        base = 16
        i += 2
    value = __bi.bigint(0)
    radix = __bi.bigint(base)
    any = false
    loop i < n:
        c = p[i]
        digit = -1
        if c >= '0' and c <= '9': digit = int(c) - 48
        else if c >= 'a' and c <= 'f': digit = int(c) - 87
        else if c >= 'A' and c <= 'F': digit = int(c) - 55
        else if c == '_':
            i += 1
            continue
        if digit < 0 or digit >= base: return none
        value = __bi.__add__(__bi.__mul__(value, radix), __bi.bigint(digit))
        any = true
        i += 1
    if not any: return none
    if negative: value = __bi.__unary_sub__(value)
    result: __dewy_int = __mi_pack(value)
    result

__mi_format_spec = (buf: mut u8[], x: __dewy_int, spec: str):
    if (x as int) & 1 == 0:
        __fmt_spec(buf, ((x as int) >> 1), spec)
        return
    sp = __spec_parse(spec)
    start = len(buf)
    k = sp.kind
    if k == 'x' or k == 'X' or k == 'b' or k == 'o':
        value = __bi.abs(__mi_payload(x)[0])
        base = if k == 'b': 2 else if k == 'o': 8 else: 16
        radix = __bi.bigint(base)
        digits = if k == 'X': "0123456789ABCDEF" else: "0123456789abcdef"
        reversed: u8[]
        loop value._sign != 0:
            parts = __bi.divmod(value, radix)
            digit = __bi.to_int64(parts.remainder) ?? 0
            reversed.push(digits[digit])
            value = parts.quotient
        if __mi_payload(x)[0]._sign < 0: __buf_byte(buf, '-')
        if sp.alt: __radix_prefix(buf, k)
        i = reversed.len()
        loop i > 0:
            i -= 1
            __buf_byte(buf, reversed[i])
    else if sp.prec >= 0 or k == 'f' or k == '%':
        __fmt_spec(buf, __mi_float(x), spec)
        return
    else: __mi_format(buf, x)
    __spec_finish(buf, start, sp, true)

# Low two's-complement word, used only by masking proofs. This is not a
# numeric narrowing conversion: bits outside the mask are unobservable.
__mi_low_word = (a: __dewy_int) -> int:
    if (a as int) & 1 == 0: return ((a as int) >> 1)
    value = __mi_payload(a)[0]
    word = value._limbs[0]
    if value._limbs.len() > 1: word = word | (value._limbs[1] << 32)
    if value._sign < 0: word = 0 - word
    int(word)

__mi_count = (value: __dewy_int) -> int:
    if (value as int) & 1 == 0: return ((value as int) >> 1)
    if __mi_payload(value)[0]._sign < 0: __int_overflow()
    # Every realizable word or BigInt has fewer bits than this. Saturation
    # preserves right shifts and zero left shifts without narrowing the value.
    9223372036854775807

__mi_word_float = (a: int, b: int, operation: int) -> f64:
    __mi_float(__mi_slow(__mi_word(a), __mi_word(b), operation))

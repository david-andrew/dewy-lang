# Canonical SI units; dimensions are erased after checking.
const m:(int64 * Length) = (1 as int64) transmute (int64 * Length)
const metre = m
const meter = m
const km = 1000m
const cm = m/100
const mm = m/1000
const kg:(int64 * Mass) = (1 as int64) transmute (int64 * Mass)
const kilogram = kg
const g = kg/1000
const mg = g/1000
const A:(int64 * Current) = (1 as int64) transmute (int64 * Current)
const K:(int64 * Temperature) = (1 as int64) transmute (int64 * Temperature)
const mol:(int64 * Amount) = (1 as int64) transmute (int64 * Amount)
const cd:(int64 * Luminosity) = (1 as int64) transmute (int64 * Luminosity)
const turn:(int64 * Angle) = (1 as int64) transmute (int64 * Angle)
const ° = turn/360
const deg = °
const degree = deg
const degrees = deg
# The radian is 1/2π turn: irrational, so here a fraction within 1e-31 of it,
# which a float angle rounds once.
const rad = 908245524057187/5706674932067741 * turn
const radian = rad
const radians = rad
const Hz = 1/s
const N = kg*m/s^2
const Pa = N/m^2
const J = N*m
const W = J/s
const V = W/A
const inch = 127m/5000
const inches = inch
# Offset scales: one degree's size and where its zero sits. A temperature written in
# one is a point; written as an operand next to a point it is a difference
# (start + 20°C). A named difference says so: 20Δ°C (one degree between two points).
const °C = __offset_unit("°C" K 5463K/20)
const °F = __offset_unit("°F" 5K/9 45967K/180)
const _celsius_zero = 0°C
const _fahrenheit_zero = 0°F
const Δ°C = °C - _celsius_zero
const Δ°F = °F - _fahrenheit_zero

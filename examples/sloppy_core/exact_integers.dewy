from bigint import bigint

main=():>void=>{
    let factorial=bigint(1)
    loop n in [2..101) {factorial=factorial*n}
    printl"100! = {factorial}"

    let combinations=bigint(1)
    loop n in [1..51) {combinations=(combinations*(100-n+1))//n}
    printl"Ways to choose 50 of 100: {combinations}"

    let numerator=bigint("-123456789012345678901234567890")
    let denominator=bigint("9876543210987654321")
    let parts=numerator.divmod(denominator)
    printl"Floor quotient: {parts.quotient}; remainder: {parts.remainder}"
    printl"Reconstruction: {parts.quotient*denominator+parts.remainder =? numerator}"
    printl"2^256 = {bigint(2).pow(256)}"
}

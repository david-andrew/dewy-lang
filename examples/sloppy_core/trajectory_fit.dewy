# Fit height = c[0] + c[1]*time + c[2]*time*time from a few measurements.
# Run: tools/dewy examples/sloppy_core/trajectory_fit.dewy
# Test: tools/dewy test examples/sloppy_core/trajectory_fit.dewy

fit = (times:array<float64> heights:array<float64>):>array<float64> => {
    assert(times.length =? heights.length and times.length >=? 3)
    let design = zeros(times.length 3)
    loop i in [0..times.length) {
        let t = times[i]
        design[i 0] = 1.0
        design[i 1] = t
        design[i 2] = t*t
    }
    let transposed = transpose(design)
    # Normal equations are adequate for these small, well-scaled sample times.
    return solve(transposed*design transposed*heights)
}

predict = (c:array<float64> t:float64):>float64 => c[0] + c[1]*t + c[2]*t*t

test "recover a quadratic trajectory" {
    let times = [0.0 0.25 0.5 0.75 1.0 1.25]
    let heights = [loop t in times {1.5 + 8.0*t - 4.905*t*t}]
    let c = fit(times heights)
    assert(abs(c[0]-1.5) <? 1e-10)
    assert(abs(c[1]-8.0) <? 1e-10)
    assert(abs(c[2]+4.905) <? 1e-10)
    assert(abs(predict(c 0.6)-4.5342) <? 1e-10)
}

test "matrix and flattened copies are independent" {
    let matrix = reshape([1.0 2.0 3.0 4.0] 2 2)
    let saved = matrix
    let values = flatten(matrix)
    matrix[0 1] = 99.0
    values[0] = -1.0
    assert(saved.data =? [1.0 2.0 3.0 4.0])
    assert(matrix[0 0] =? 1.0 and matrix[0 1] =? 99.0)
}

main = () => {
    let times = [0.0 0.25 0.5 0.75 1.0 1.25]
    let heights = [1.50 3.20 4.27 4.75 4.60 3.84]
    let c = fit(times heights)
    printl("height = {format(c[0] ".3f")} + {format(c[1] ".3f")}*t + {format(c[2] ".3f")}*t*t")
    printl("height at 0.6 seconds: {format(predict(c 0.6) ".3f")}")
    return 0
}

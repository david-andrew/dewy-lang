# A bounded history, oldest entry first. Once full, push replaces the oldest
# entry in constant time. Construct with new_ring<T>(capacity).
# The types state the invariants: a positive capacity, a head inside it, and an
# index a caller has proven in bounds.
Ring:type = <T>[capacity:int64<capacity >? 0> values:array<T> head:int64<0 <=? head <? capacity>=0]

new_ring = <T>(capacity:int64<capacity >? 0>):>Ring<T> => Ring<T>[capacity=capacity values=[]]

length = <T>(ring:Ring<T>):>int64 => ring.values.length

push = <T>(@ring:Ring<T> value:T):>void => {
    if ring.values.length <? ring.capacity {
        ring.values.push(value)
    } else {
        ring.values[ring.head] = value
        ring.head = (ring.head+1)%ring.capacity
    }
}

__index__ = <T>(ring:Ring<T> index:int64<0 <=? index <? ring.values.length>):>T => ring.values[(ring.head+index)%ring.values.length]
__setindex__ = <T>(@ring:Ring<T> index:int64<0 <=? index <? ring.values.length> value:T):>void => {
    ring.values[(ring.head+index)%ring.values.length] = value
}

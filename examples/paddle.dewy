# Build with the experimental source core. The platform library supplies
# the window, input, font, renderer, frame loop, and native/web backends.
from p"paddle_model.dewy" import fresh, advance

let world=fresh()

update=(dt:float64):>void=>{
    advance(@world min(dt 0.05) mouse_pos().x)
}

draw=():>void=>{
    clear(rgb(0.025 0.045 0.08))
    rect(20.0 100.0 1240.0 2.0 rgb(0.15 0.25 0.35))
    rect(20.0 660.0 1240.0 2.0 rgb(0.15 0.25 0.35))
    circle(vec2(world.position.x world.position.y) 12.0 rgb(1.0 0.7 0.3))
    rect(world.paddle-80.0 632.0 160.0 12.0 rgb(0.3 0.9 0.8))
    text("DEWY / PADDLE" vec2(32.0 24.0) 32.0 rgb(0.85 0.95 1.0))
    text("Move the mouse to keep the ball in play" vec2(32.0 68.0) 18.0 rgb(0.5 0.65 0.75))
    text("Returns: {world.score}    Misses: {world.misses}" vec2(820.0 35.0) 22.0 rgb(0.3 0.9 0.8))
}

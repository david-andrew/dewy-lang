# Repeated entity updates through stable handles, while retaining a snapshot.
Entity:type = [inventory:array<int64 length=32>]

mutate_inventory = (@entities:Pool<Entity> handles:array<Handle length=64> count:int64):>void => {
    loop i in [0..count) {
        let entity = i%64 let slot = (i//64)%32 let delta = i%7
        let handle = handles[entity]
        if entities.has(handle) {entities[handle].inventory[slot] += delta+1}
    }
}

inventory_checksum = (entities:Pool<Entity>):>int64 => {
    let result:int64 = 3
    loop entity in entities.items {
        loop amount in entity.inventory { result = (result*31+amount)%1000000007 }
    }
    return result
}

main = (argv:array<string>):>void => {
    let count:int64 = 1000000
    if argv.length >? 1 {
        let parsed = to_int(argv[1])
        if parsed is? error panic("expected an update count")
        if parsed <? 0 or parsed >? int64.max panic("update count must fit an int64 and be nonnegative")
        count = parsed
    }
    let entities:Pool<Entity> = []
    let handles = [loop i in [0..64) entities.add(Entity[fill(0 32)])]
    let snapshot = entities
    let started = time_ns()
    mutate_inventory(@entities handles count)
    let finished = time_ns()
    printl"{inventory_checksum(entities)} {inventory_checksum(snapshot)} {finished-started}"
}

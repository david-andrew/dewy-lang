# ---------------- terrain ----------------
const WORLD = 360.0

dune_height=(x: float64 z: float64):>float64=>{
    # ridged dunes plus long swells; the beacon mountain rises far to the north
    let r = 1.0 - abs(fbm(x * 0.012 + 3.0 z * 0.018 3) * 2.0 - 1.0)
    let swell = fbm(x * 0.004 z * 0.004 2)
    let h = r * r * 14.0 + swell * 18.0
    let d = sqrt((x - 0.0) * (x - 0.0) + (z + 150.0) * (z + 150.0))
    h + max(0.0 60.0 - d * 0.9) * 1.4
}
sand_color=(_x: float64 _y: float64 _z: float64):>vec4=>vec4(1 1 1 1)

SandParams:type=[
    view_proj: mat4
    shadow_vp: mat4
    cam: vec3
    sun: vec3
    sun_color: vec3
    sky: vec3
    fog_color: vec3
    fog: vec2
    time: float32
    shadow_strength: float32
    shadow_map: Texture
    shadow_texel: float32 = 1.0 / 2048.0
    shadow_taps: float32 = 9.0
]
SandOut:type=[
    pos: vec4
    world: vec3
    normal: vec3
    shadow_pos: vec4
]
sand_vs=(v: Vertex3D u: SandParams):>SandOut=>{
    SandOut(u.view_proj * vec4(v.pos 1) v.pos v.normal u.shadow_vp * vec4(v.pos 1))
}
sand_fs=(i: SandOut u: SandParams):>vec4=>{
    let n = normalize(i.normal)
    # wind ripples (two scales, running across the prevailing wind) bend the normal
    let ph = i.world.x * 1.7 + i.world.z * 0.9 + sin(i.world.z * 0.35) * 2.0
    let ph2 = i.world.x * 4.1 - i.world.z * 2.3 + sin(i.world.x * 0.8) * 1.5
    let flat = clamp(n.y * 1.4 - 0.3 0.0 1.0)
    let rip = (cos(ph) * 0.24 + cos(ph2) * 0.08) * flat
    let nr = normalize(n + vec3(rip * 0.8 0 rip * 0.4))
    let l = normalize(u.sun)
    let v = normalize(u.cam - i.world)
    let sand = mix(vec3(0.72 0.38 0.24) vec3(0.98 0.76 0.52) clamp(n.y * 1.3 - 0.2 0.0 1.0))
    let wrap = clamp((dot(nr l) + 0.35) / 1.35 0.0 1.0)
    # shadows from the sun
    let sp = i.shadow_pos.xyz / i.shadow_pos.w * 0.5 + vec3(0.5 0.5 0.5)
    let sh: float32 = 1.0
    if sp.x >? 0.0 and sp.x <? 1.0 and sp.y >? 0.0 and sp.y <? 1.0 and sp.z <? 1.0 {
        # Match the real shadow map: four samples on the CPU, nine on a GPU.
        let lit: float32 = 0.0
        if u.shadow_taps <? 5.0 {
            loop k in [int32(0)..int32(4)) {
                let d = sample(u.shadow_map sp.xy + vec2(float32(k%2)-0.5 float32(k//2)-0.5) * u.shadow_texel).x
                if sp.z - 0.003 <=? d {lit = lit + 1.0}
            }
            lit /= 4.0
        } else {
            loop x in [int32(-1)..int32(2)) {
                loop y in [int32(-1)..int32(2)) {
                    let d = sample(u.shadow_map sp.xy + vec2(float32(x) float32(y)) * u.shadow_texel).x
                    if sp.z - 0.003 <=? d {lit = lit + 1.0}
                }
            }
            lit /= 9.0
        }
        sh = 1.0 - u.shadow_strength * (1.0 - lit)
    }
    let c = sand * (u.sky * 0.42 + u.sun_color * wrap * sh)
    # cool fill in the shade, warm bounce from lit sand
    c = c + vec3(0.06 0.08 0.14) * (1.0 - wrap)
    # ocean-like sheen, glittering grains and a bright rim on crests seen against the sun
    let h = normalize(l + v)
    c = c + u.sun_color * pow(max(dot(nr h) 0.0) 60.0) * 0.55 * sh
    let rim = pow(1.0 - max(dot(n v) 0.0) 4.0)
    c = c + u.sun_color * rim * 0.35 * clamp(dot(-v l) + 0.6 0.0 1.0)
    let cell = floor(i.world.xz * 22.0)
    let g = hash21(cell + vec2(floor(u.time * 0.5) 0))
    let glint = pow(max(dot(reflect(-l nr) v) 0.0) 8.0)
    if g >? 0.985 {c = c + vec3(1 0.95 0.85) * glint * (g - 0.985) * 120.0 * sh}
    let dist = length(i.world - u.cam)
    let fa = 1.0 - exp(-dist * u.fog.x * exp(-max(i.world.y 0.0) * u.fog.y))
    let haze = mix(u.fog_color u.fog_color * vec3(0.8 0.9 1.15) clamp(dist / 250.0 0.0 1.0))
    c = mix(c haze clamp(fa 0.0 1.0))
    vec4(aces(c) 1)
}

# ---------------- the traveler's cloth: robe and scarf meshes rebuilt every frame ----------------
const ROBE_SEG = 24
const ROBE_RINGS = 7

robe_indices=():>array<uint32>=>{
    let idx: array<uint32> = []
    loop r in [0..ROBE_RINGS - 1) {
        loop s in [0..ROBE_SEG) {
            let a = uint32(r * (ROBE_SEG + 1) + s)
            let b = a + uint32(ROBE_SEG + 1)
            idx.push(a)
            idx.push(b)
            idx.push(a + 1)
            idx.push(a + 1)
            idx.push(b)
            idx.push(b + 1)
        }
    }
    idx

# a bell-shaped robe whose hem ripples and trails behind when moving (local space, +z forward)
}
robe_vertices=(time: float64 speed: float64):>array<Vertex3D>=>{
    let vs: array<Vertex3D> = []
    loop r in [0..ROBE_RINGS) {
        let f = float64(r) / float64(ROBE_RINGS - 1) # 0 at the shoulders, 1 at the hem
        let y = 1.3 - f * 1.25
        let rad = 0.16 + 0.38 * pow(f 0.8)
        loop s in [0..ROBE_SEG + 1) {
            let a = float64(s) / float64(ROBE_SEG) * TAU
            let wave = sin(a * 3.0 + time * 5.0) * 0.035 + sin(a * 5.0 - time * 7.0) * 0.02
            let rr = rad + wave * f * (1.0 + speed * 0.15)
            let x = sin(a) * rr
            let z = cos(a) * rr - speed * 0.05 * f * f
            let n = normalize(vec3(float32(sin(a)) 0.35 float32(cos(a))))
            let shade = float32(0.75 + 0.25 * (1.0 - f))
            # deep red cloth with a gold band along the hem
            let col = vec4(0.58 * shade 0.1 * shade 0.08 * shade 1)
            if r =? ROBE_RINGS - 2 {col = vec4(0.9 0.62 0.25 1)}
            vs.push(Vertex3D(vec3(float32(x) float32(y + wave * f * 0.5) float32(z)) n vec2(float32(s) / float32(ROBE_SEG) float32(f)) col))
        }
    }
    vs

# a ribbon through the scarf's chain of points; brightness pulses along it like woven glyphs
}
ribbon_vertices=(pts: array<vec3> width: float32 time: float64):>array<Vertex3D>=>{
    let vs: array<Vertex3D> = []
    loop k in [0..pts.length) {
        let p = pts[k]
        let prev = if k >? 0 pts[k - 1] else p
        let next = if k + 1 <? pts.length pts[k + 1] else p
        let dir = normalize(next - prev + vec3(0 0.0001 0))
        let side = normalize(cross(dir vec3(0 1 0)) + vec3(0.0001 0 0))
        let n = normalize(cross(side dir))
        let taper = float32(1.0 - 0.6 * float64(k) / float64(max(pts.length - 1 1)))
        let glow = float32(0.65 + 0.35 * sin(float64(k) * 1.3 - time * 3.0))
        let c = vec4(glow glow glow 1)
        vs.push(Vertex3D(p + side * (width * taper) n vec2(0 float32(k)) c))
        vs.push(Vertex3D(p - side * (width * taper) n vec2(1 float32(k)) c))
    }
    vs

# both windings: cloth is seen from both sides
}
ribbon_indices=(n: int64<0 <=? n and n <=? 65536>):>array<uint32>=>{
    let idx: array<uint32> = []
    loop k in [0..n - 1) {
        let a = uint32(k * 2)
        loop t in [a a + 1 a + 2 a + 1 a + 3 a + 2 a a + 2 a + 1 a + 1 a + 2 a + 3] {idx.push(t)}
    }
    idx
}

# ---------------- the beacon's light: an additive beam that fades with height ----------------
BeamParams:type=[
    view_proj: mat4
    base: vec3
    cam: vec3
    strength: float32
    time: float32
]
BeamOut:type=[
    pos: vec4
    world: vec3
    normal: vec3
]
beam_vs=(v: Vertex3D u: BeamParams):>BeamOut=>{
    let w = v.pos + u.base
    BeamOut(u.view_proj * vec4(w 1) w v.normal)
}
beam_fs=(i: BeamOut u: BeamParams):>vec4=>{
    let h = i.world.y - u.base.y
    let fade = exp(-h * 0.006) * clamp(h * 0.2 0.0 1.0)
    # brighter where the beam is seen edge-on (a soft volumetric look)
    let v = normalize(u.cam - i.world)
    let edge = 1.0 - abs(dot(normalize(i.normal) v))
    let shimmer = 0.85 + 0.15 * sin(h * 0.15 - u.time * 2.0)
    let a = fade * (0.1 + 0.9 * pow(1.0 - edge 3.0)) * u.strength * shimmer
    vec4(vec3(1.0 0.92 0.75) clamp(a 0.0 1.0))
}

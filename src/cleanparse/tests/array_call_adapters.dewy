const words:array<int64> = [0 2]
const bytes:array<uint8> = 0x"2802"

let mutate = (items:array<int64 length=2>):>int64 => {
    items[0] = 40
    return items[0] + items[1]
}

let verify = (items:array<uint8 length=2>):>int64 => {
    if items[0] =? 40 and items[1] =? 2 { return 42 } else { return 1 }
}

let read_array = (items:array<int64 length=2>):>int64 =>
    items[0] + items[1]
let identity = (value:int64):>int64 => value
let selected = read_array & identity

let main = ():>int64 => {
    let local = [0 2]
    let alias = local
    let transitive = alias
    let local_result:int64 = mutate(transitive)
    let static_result:int64 = mutate(words)
    let bytes_result:int64 = verify(bytes)
    let selected_values = [40 2]
    let overload_result:int64 = selected(selected_values)
    if local_result =? 42 and local[0] =? 40
        and static_result =? 42 and bytes_result =? 42
        and overload_result =? 42 {
        return 42
    } else {
        return 1
    }
}

let main = ():>int64 => {
    let first = ():>int64 => {
        let nested = ():>int64 => {
            return second()
        }
        return nested()
    }
    let second = ():>int64 => {
        return 20
    }
    let double = (value:int64):>int64 => {
        return value * 2
    }
    let fn_ptr:<int64:>int64> = double
    return first() + (fn_ptr)(11)
}

let main = ():>int64 => {
    let total:int64 = 0
    loop a in 0..0 and b in 0..0 { total += 1 }
    loop a in 0..0 or b in 1..0 { total += 1 break }
    loop a in 0..0 xor b in 1..0 { total += 1 break }
    loop a in 0..0 nand b in 1..0 { total += 1 break }
    loop a in 1..0 nor b in 1..0 { total += 1 break }
    loop a in 0..0 xnor b in 0..0 { total += 1 break }
    return total + 36
}

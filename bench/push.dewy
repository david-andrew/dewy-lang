# Arrays grown one element at a time: records, integers and strings pushed
# onto empty arrays in one loop, then summed.
from p"harness.dewy" import size_argument, clock, mix

Particle:type = [x:int64 y:int64 dx:int64 dy:int64]

kernel = (count:int64):>int64 => {
    let particles:array<Particle>=[]
    let numbers:array<int64>=[]
    let names:array<string>=[]
    let seed:int64=777
    let i:int64=0
    loop i <? count {
        seed=(seed*1103515245+12345)%2147483648
        particles.push(Particle(x=seed%4096 y=i dx=seed%17-8 dy=(seed//32)%17-8))
        numbers.push(seed%1000)
        if seed%3 =? 0 {names.push("fizz")} else {names.push("buzz!")}
        i+=1
    }
    # (a sample of the elements, so the pushes dominate)
    let hash:int64=numbers.length+particles.length+names.length
    let j:int64=0
    loop j <? count {
        hash=mix(hash particles[j].x+particles[j].dy+numbers[j]+names[j].length)
        j+=61
    }
    return hash
}

main = (args:array<string>):>void => {
    let count=size_argument(args 1000000)
    let started=clock()
    let result=kernel(count)
    let finished=clock()
    printl"{result} {finished-started}"
}

$runtime_checks

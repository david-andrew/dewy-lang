from p"../harness.jo" import clock, size_argument
merge=(@a:array<int64> @tmp:array<int64> mid:int64):>void=>{
    let n=a.length
    assert(0 <=? mid and mid <=? n and n =? tmp.length)
    let i:int64=0 let j=mid let k:int64=0
    loop i <? mid and j <? n {
        if a[i] <=? a[j] {tmp[k]=a[i] i+=1} else {tmp[k]=a[j] j+=1}
        k+=1
    }
    loop i <? mid {tmp[k]=a[i] i+=1 k+=1}
    loop j <? n {tmp[k]=a[j] j+=1 k+=1}
    loop p in [0..n) {a[p]=tmp[p]}
}
sort=(@a:array<int64> @tmp:array<int64> threaded:bool):>void=>{
    let n=a.length
    if n <=? 1 return
    let mid=n//2
    if threaded {
        let _joined=parallel_range(2 ($capture @a $capture @tmp i:int64):>int64=>{
            if i =? 0 {sort(@a[..mid) @tmp[..mid) true)}
            else {sort(@a[mid..] @tmp[mid..] true)}
            return 0
        })
    } else {
        sort(@a[..mid) @tmp[..mid) false)
        sort(@a[mid..] @tmp[mid..] false)
    }
    merge(@a @tmp mid)
}
main=(args:array<string>):>void=>{
    let n=size_argument(args 262144)
    let a=[loop i in [0..n) (i*1103515245+12345)%2147483648]
    let tmp:array<int64>=[loop i in [0..n) 0 as int64]
    let start=clock()
    sort(@a @tmp args.length <=? 2)
    let elapsed=clock()-start
    let checksum:int64=0
    loop i in [0..n) {checksum=(checksum+a[i]*(i%97))%1000000007}
    printl"{checksum} {elapsed}"
}

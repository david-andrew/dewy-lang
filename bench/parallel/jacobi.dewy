from p"../harness.jo" import clock, size_argument
step=(a:array<float64> @out:array<float64> first:int64 n:int64 threaded:bool):>void=>{
    let rows=out.length//n
    if rows <=? 1 {
        if first =? 0 or first =? (n-1)*n {
            loop j in [0..n) {out[j]=a[first+j]}
        } else {
            out[0]=a[first]
            out[n-1]=a[first+n-1]
            loop j in [1..n-1) {let p=first+j out[j]=(a[p-n]+a[p+n]+a[p-1]+a[p+1])*0.25}
        }
        return
    }
    let mid=(rows//2)*n
    if threaded {
        let _joined=parallel_range(2 ($capture a $capture @out i:int64):>int64=>{
            if i =? 0 {step(a @out[..mid) first n true)}
            else {step(a @out[mid..] first+mid n true)}
            return 0
        })
    } else {
        step(a @out[..mid) first n false)
        step(a @out[mid..] first+mid n false)
    }
}
main=(args:array<string>)=>{
    let n=size_argument(args 1024)
    let a=[loop p in [0..n*n) (((p//n)+(p%n))%17) as float64]
    let tmp:array<float64>=[loop p in [0..n*n) 0.0]
    let threaded=args.length <=? 2
    let start=clock()
    loop round in [0..20) {
        step(a @tmp[..] 0 n threaded)
        let old=a a=tmp tmp=old
    }
    let elapsed=clock()-start
    let result:int64=0 loop v in a {result+=(v*1024.0) as int64}
    printl"{result} {elapsed}"
    return 0
}

# Read-only method calls use the same value parameters as free-function calls.
# Each call selects varying data; the complete loop contributes to the result.
from p"harness.dewy" import size_argument, clock
Row:type=[weights:array<int64> bias:int64]
weight=(values:array<int64> at:int64):>int64=>{
    $runtime_checks
    return values[at]
}
score=(row:Row at:int64):>int64=>row.weights.weight(at)+row.bias
kernel=(rows:array<Row> count:int64):>int64=>{
    let total:int64=0
    if rows.length <? 128 return 0
    loop i in [0..count) {total+=rows[i%128].score(i%4)}
    return total
}
main=(args:array<string>):>void=>{
    let count=size_argument(args 10000000)
    let rows:array<Row>=[]
    loop i in [0..128) {rows.push(Row[[i i+1 i+2 i+3] i*3])}
    let start=clock()
    let result=kernel(rows count)
    let stop=clock()
    printl"{result} {stop-start}"
}

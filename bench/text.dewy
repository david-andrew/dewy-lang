# Text scanning and parsing: split generated text into words and numbers.
from p"harness.dewy" import size_argument, clock, mix

# `count` tokens: words of lowercase letters and decimal numbers, separated
# by spaces and newlines.
generate = (count:int64):>array<uint8> => {
    let text:array<uint8>=[]
    let seed:int64=99
    let i:int64=0
    loop i <? count {
        seed=(seed*1103515245+12345)%2147483648
        let size=seed%7+1
        let digits=(seed//8)%3 =? 0
        let j:int64=0
        loop j <? size {
            seed=(seed*1103515245+12345)%2147483648
            if digits {text.push((48+seed%10) as uint8)} else {text.push((97+seed%26) as uint8)}
            j+=1
        }
        text.push(if i%12 =? 11 10 as uint8 else 32 as uint8)
        i+=1
    }
    return text
}

kernel = (text:array<uint8>):>int64 => {
    let words:int64=0
    let lines:int64=0
    let total:int64=0
    let hash:int64=5
    let i:addr=0
    loop i <? text.length {
        let byte=text[i] as int64
        if byte =? 10 {
            lines+=1
            i+=1
        } else if byte =? 32 {i+=1} else if byte >=? 48 and byte <=? 57 {
            let value:int64=0
            loop i <? text.length and text[i] >=? 48 and text[i] <=? 57 {
                value=value*10+(text[i] as int64)-48
                i+=1
            }
            total=(total+value)%1000000007
        } else {
            let word:int64=0
            loop i <? text.length and text[i] >=? 97 and text[i] <=? 122 {
                word=(word*131+(text[i] as int64))%1000000007
                i+=1
            }
            words+=1
            hash=mix(hash word)
        }
    }
    return mix(mix(mix(hash words) lines) total)
}

main = (args:array<string>):>int64 => {
    let count=size_argument(args 1000000)
    let text=generate(count)
    let started=clock()
    let result=kernel(text)
    let finished=clock()
    printl"{result} {finished-started}"
    return 0
}

# Binary min-heap priority queue (event scheduler workload).
$runtime_checks

from p"harness.dewy" import size_argument, clock, mix

Event:type=[priority:int64 payload:int64]

heap_push = (@h:array<Event> item:Event):>void => {
    h.push(item)
    let i:int64=h.length-1
    loop i >? 0 {
        let p:int64=(i-1)>>1
        if h[p].priority <=? item.priority {break}
        h[i]=h[p]
        i=p
    }
    h[i]=item
}

heap_pop = (@h:array<Event>):>Event => {
    let top=h[0]
    let last=h.pop()
    let n:int64=h.length
    if n >? 0 {
        let i:int64=0
        loop true {
            let left:int64=i*2+1
            if left >=? n {break}
            let best:int64=left
            let right:int64=left+1
            if right <? n and h[right].priority <? h[left].priority {best=right}
            if last.priority <=? h[best].priority {break}
            h[i]=h[best]
            i=best
        }
        h[i]=last
    }
    return top
}

kernel = (count:int64):>int64 => {
    let heap:array<Event>=[]
    let seed:int64=4242
    let hash:int64=13
    loop i in [0..count) {
        seed=(seed*1103515245+12345)%2147483648
        heap_push(@heap Event[seed%1000003 i])
        seed=(seed*1103515245+12345)%2147483648
        heap_push(@heap Event[seed%1000003 i+count])
        if heap.length >? 0 {
            let ev=heap_pop(@heap)
            hash=mix(hash (ev.priority+ev.payload)%1000003)
        }
    }
    loop heap.length >? 0 {
        let ev=heap_pop(@heap)
        hash=mix(hash (ev.priority+ev.payload)%1000003)
    }
    return hash
}

main = (args:array<string>):>void => {
    let count=size_argument(args 500000)
    let started=clock
    let result=kernel(count)
    let finished=clock
    printl"{result} {finished-started}"
}

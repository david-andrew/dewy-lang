# Many short-lived allocations per round, made in an arena and given back at once by
# its reset: each round builds a table of small rows and keeps one number from it.
from p"harness.dewy" import size_argument, clock, mix

const ROWS:int64=1000

round_total = (seed0:int64):>int64 => {
    let table:array<array<int64>>=[]
    let seed=seed0
    loop r in [0..ROWS) {
        let row:array<int64>=[]
        loop c in [0..8) {
            seed=(seed*1103515245+12345)%2147483648
            row.push(seed%1000)
        }
        table.push(row)
    }
    let total:int64=0
    loop row in table {
        let best:int64=0
        loop x in row {if x >? best best=x}
        total+=best
    }
    return total
}

kernel = (rounds:int64):>int64 => {
    let scratch=Arena[]
    let hash:int64=7
    loop k in [0..rounds) {
        let total=$allocator(@scratch) round_total(k)
        hash=mix(hash total)
        scratch.reset()
    }
    return hash
}

main = (args:array<string>):>void => {
    let rounds=size_argument(args 1000)
    let started=clock()
    let result=kernel(rounds)
    let finished=clock()
    printl"{result} {finished-started}"
}

$runtime_checks

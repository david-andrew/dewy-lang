{
    // Needs the repository's extension (editors/vscode) with dewy.core.path
    // set to this checkout's tools/dewy, and CodeLLDB.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "dewy-core",
            "request": "launch",
            "name": "Dewy core: current file",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
        }
    ]
}
